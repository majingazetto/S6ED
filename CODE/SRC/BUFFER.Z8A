;                                       ****************************************
;                                       * TEXT BUFFER                          *
;                                       ****************************************
;
; LINE DIRECTORY: FLAT ARRAY IN PLAIN TPA RAM AT DIRBASE, JUST ABOVE THE
;   PROGRAM'S VARIABLE BLOCK AND BELOW THE PAGE 2 WINDOW. NOT A MAPPER SEGMENT
;   AND NEVER BANKED -- SEE THE PLACEMENT NOTE IN CONST.Z8A.
;   DIRECT ACCESS: ENTRY N IS AT DIRBASE + N * DIRSIZ.
;   ENTRY LAYOUT: [1: SEG][2: WORD OFFSET WITHIN THAT TEXT SEGMENT]
;   CAPACITY: MAXLINES ENTRIES, DERIVED FROM ENDVARS AT ASSEMBLY TIME.
;
; TEXT SEGMENTS: ACCESSED VIA PAGE 2 WINDOW (TXPAGE = #8000).
;   PUTP2 TO SWITCH SEGMENT IN; COPY DATA; PUTP2 TO SWITCH NEXT AS NEEDED.
;   MULTIPLE SEGMENTS ALLOCATED AS FILE GROWS (ALLSEG).
;
; LINE RECORD (IN TEXT SEGMENT):
;   [1 BYTE : TEXT_LEN]   (0-80)
;   [N BYTES: TEXT]       RAW CHARS
;   [N BYTES: ATTR]       ONE ATTR BYTE PER CHAR
;   MAX: 1 + 80 + 80 = 161 BYTES (LINEREC)


; --- BUFINIT                   ----------------------------------------

; - BUFINIT ----------
; - INITIALIZE EMPTY BUFFER (ONE BLANK LINE)
; - CALL AFTER MAPINIT
; -

BUFINIT         LD      A, (DEFSEG2)
                LD      (TXSEG0), A     ; USE TPA PAGE 2 SEGMENT FOR FIRST 101 LINES
                ; FALL THROUGH INTO BUFRESET


; --- BUFRESET                  ----------------------------------------

; - BUFRESET ---------
; - EMPTY THE BUFFER BACK TO ONE BLANK LINE
; - REUSES THE SEGMENTS ALREADY HELD AND RETURNS ANY GROWN BEYOND THE FIRST,
; - SO LOADING A SECOND FILE DOES NOT LEAK MAPPER MEMORY.
; -

BUFRESET        CALL    SEGTRIM
                LD      A, (TXSEG0)
                LD      (APPSEG), A     ; APPEND CURSOR BACK TO THE FIRST SEGMENT
                CALL    APPBANK         ; MAP TO PAGE 2

                LD      HL, TXPAGE
                CALL    RECBLNK         ; EMPTY RECORD AT OFFSET 0

                ; WRITE DIR ENTRY 0: SEG=TXSEG0, OFF=0
                LD      HL, 0
                LD      A, (TXSEG0)
                LD      DE, 0
                CALL    DIRWRITE

                ; INITIALIZE VARS
                LD      HL, LINEREC     ; RECORD 0 IS TAKEN, NEXT ONE STARTS HERE
                LD      (LINEOFF), HL

                LD      HL, 1
                LD      (TOTLINES), HL
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                RET


; --- RECBLNK                   ----------------------------------------

; - RECBLNK ----------
; - WRITE AN EMPTY LINE RECORD
; - IN:  HL = RECORD ADDRESS INSIDE THE PAGE 2 WINDOW
; - OUT: HL = UNCHANGED
; - CLOBBERS: AF, BC, DE
; - LAYOUT: [1 LEN=0] [80 SPACES] [80 ATTRS=0]
; -

RECBLNK         PUSH    HL
                LD      (HL), 0         ; LEN = 0
                INC     HL
                LD      (HL), ' '
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, TEXTCOLS - 1
                LDIR                    ; SPACES ACROSS THE TEXT HALF
                EX      DE, HL          ; LDIR LEAVES DE ONE PAST THE TEXT HALF
                LD      (HL), 0         ; HL NOW AT THE ATTR HALF
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, TEXTCOLS - 1
                LDIR                    ; ZERO ACROSS THE ATTR HALF
                POP     HL
                RET


; --- DIRADR                    ----------------------------------------

; - DIRADR -----------
; - ADDRESS OF A LINE DIRECTORY ENTRY
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: HL = DIRBASE + LINE * DIRSIZ
; - CLOBBERS: AF, DE
; -

DIRADR          PUSH    HL
                ADD     HL, HL          ; * 2
                POP     DE
                ADD     HL, DE          ; * 3
                LD      DE, DIRBASE
                ADD     HL, DE
                RET


; --- DIRREAD                   ----------------------------------------

; - DIRREAD ----------
; - READ LINE DIRECTORY ENTRY (DIRECT — PAGE 1 ALWAYS MAPPED)
; - HL: LINE NUMBER (0-BASED)
; - OUTPUT:
; -     A:  SEGMENT NUMBER
; -     DE: BYTE OFFSET WITHIN SEGMENT
; -
; - USES: HL (ENTRY ADDRESS), DE (OFFSET), A (SEG)
; -

DIRREAD         CALL    DIRADR
                LD      A, (HL)         ; SEGMENT
                INC     HL
                LD      E, (HL)
                INC     HL
                LD      D, (HL)         ; DE = OFFSET
                RET


; --- DIRWRITE                  ----------------------------------------

; - DIRWRITE ---------
; - WRITE LINE DIRECTORY ENTRY (DIRECT — PAGE 1 ALWAYS MAPPED)
; - HL: LINE NUMBER
; - A:  SEGMENT
; - DE: BYTE OFFSET WITHIN SEGMENT
; -

DIRWRITE        PUSH    AF
                PUSH    DE
                CALL    DIRADR
                POP     DE              ; DE = OFFSET
                POP     AF              ; A = SEGMENT

                LD      (HL), A
                INC     HL
                LD      (HL), E
                INC     HL
                LD      (HL), D
                RET


; --- LINEREAD                  ----------------------------------------

; - LINEREAD ---------
; - LOAD LINE RECORD FROM TEXT SEGMENT INTO WORKBUF
; - HL: LINE NUMBER (0-BASED)
; -

LINEREAD        CALL    DIRREAD         ; A=SEG, DE=OFFSET
                LD      B, A
                LD      A, (TXSEG)
                CP      B
                JR      Z, .SAME
                LD      A, B
                LD      (TXSEG), A
                CALL    PUTP2
.SAME           LD      HL, TXPAGE
                ADD     HL, DE          ; HL = SOURCE
                LD      DE, WORKBUF
                LD      BC, WORKSIZ
                LDIR
                RET


; --- LINEWRT                   ----------------------------------------

; - LINEWRT ----------
; - WRITE WORKBUF BACK TO TEXT SEGMENT
; - HL: LINE NUMBER
; -

LINEWRT         ; TODO: IMPLEMENT REPACKING IF SIZE CHANGES
                ; FOR NOW, ASSUME FIXED SIZE OR SUFFICIENT SPACE
                CALL    DIRREAD
                LD      B, A
                LD      A, (TXSEG)
                CP      B
                JR      Z, .SAME
                LD      A, B
                LD      (TXSEG), A
                CALL    PUTP2
.SAME           EX      DE, HL
                LD      DE, TXPAGE
                ADD     HL, DE          ; HL = DEST
                EX      DE, HL
                LD      HL, WORKBUF
                LD      BC, WORKSIZ
                LDIR
                RET


; --- APPEND CURSOR             ----------------------------------------
;
; NEW RECORDS ARE APPENDED AT (APPSEG, LINEOFF), WHICH ONLY EVER MOVES FORWARD.
; SPACE BELONGING TO A DELETED LINE IS NOT RECLAIMED UNTIL THE FILE IS RELOADED
; -- A COMPACTOR IS FUTURE WORK. A 16KB SEGMENT HOLDS LINEPSEG (101) RECORDS.


; - APPBANK ----------
; - BANK THE APPEND SEGMENT INTO PAGE 2
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

APPBANK         LD      A, (APPSEG)
                LD      (TXSEG), A      ; PAGE 2 NOW HOLDS THE APPEND SEGMENT
                JP      PUTP2


; - NEWREC -----------
; - RESERVE SPACE FOR ONE NEW LINE RECORD
; - IN:  NONE
; - OUT: CY = 0  A  = SEGMENT NUMBER
; -              DE = OFFSET OF THE RESERVED RECORD
; -              PAGE 2 IS LEFT BANKED ON THAT SEGMENT
; -      CY = 1  THE MAPPER HAS NO SEGMENT LEFT. NOTHING WAS RESERVED AND
; -              NOTHING WAS MUTATED -- LINEOFF AND APPSEG ARE UNTOUCHED, SO
; -              THE CALLER CAN SIMPLY REFUSE THE EDIT.
; - CLOBBERS: AF, BC, DE, HL
; -
; - THIS USED TO ABORT THROUGH ERRMEM, WHICH EXITS TO DOS. ON A STOCK 128 KB
; - MACHINE THE MAPPER RUNS OUT AT 303 LINES, SO A SINGLE RETURN KEY THREW
; - THE WHOLE DOCUMENT AWAY. MEASURED ON PHILIPS NMS 8250.
; -
; - THAT WAS ERRMEM'S ONLY CALLER, SO ERRMEM NOW HAS NONE. IT IS KEPT
; - DELIBERATELY: IT IS THE RIGHT ANSWER FOR A FAILURE BEFORE THE DOCUMENT
; - EXISTS, AND BUFINIT MAY NEED IT AGAIN. THE EDIT PATHS REFUSE SILENTLY
; - FOR NOW, THE SAME WAY THEY ALREADY DO WHEN THE DIRECTORY IS FULL --
; - TELLING THE USER WHY IS A STATUS BAR JOB AND IS NOT WIRED UP YET.
; -

NEWREC          LD      HL, (LINEOFF)
                LD      DE, SEGLAST + 1
                CALL    CMPHLDE
                JR      C, .HAVE        ; A WHOLE RECORD STILL FITS

                CALL    SEGGET          ; SEGMENT FULL, CLAIM ANOTHER
                RET     C               ; NO MAPPER MEMORY -- CALLER DECIDES
                LD      (APPSEG), A
                LD      HL, 0
                LD      (LINEOFF), HL

.HAVE           CALL    APPBANK
                LD      HL, (LINEOFF)
                PUSH    HL
                LD      DE, LINEREC
                ADD     HL, DE
                LD      (LINEOFF), HL   ; ADVANCE PAST THE RESERVED RECORD
                POP     DE              ; DE = OFFSET
                LD      A, (APPSEG)
                OR      A               ; CY = 0: RESERVED
                RET


; --- LINEINS                   ----------------------------------------

; - LINEINS ----------
; - OPEN A SLOT IN THE LINE DIRECTORY AT LINE N
; - IN:  HL = LINE NUMBER TO OPEN (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; - SHIFTS ENTRIES N..TOTLINES-1 ONE SLOT UP. TOTLINES IS LEFT ALONE -- THE
; - CALLER FILLS THE SLOT WITH DIRWRITE AND BUMPS THE COUNT.
; -

LINEINS         LD      DE, (TOTLINES)
                EX      DE, HL          ; HL = TOTLINES, DE = N
                OR      A
                SBC     HL, DE          ; HL = ENTRIES TO SHIFT
                LD      A, H
                OR      L
                RET     Z               ; INSERTING PAST THE LAST LINE

                PUSH    HL
                ADD     HL, HL
                POP     DE
                ADD     HL, DE          ; HL = COUNT * DIRSIZ
                LD      B, H
                LD      C, L            ; BC = BYTES TO MOVE

                LD      HL, (TOTLINES)
                CALL    DIRADR
                DEC     HL              ; HL = LAST BYTE OF THE LAST ENTRY
                PUSH    HL
                LD      DE, DIRSIZ
                ADD     HL, DE
                EX      DE, HL          ; DE = LAST BYTE OF THE NEW LAST ENTRY
                POP     HL
                LDDR                    ; SHIFT BACKWARDS, SLOT N IS NOW FREE
                RET


; --- LINEDEL                   ----------------------------------------

; - LINEDEL ----------
; - CLOSE THE DIRECTORY SLOT OF LINE N
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; - SHIFTS ENTRIES N+1..TOTLINES-1 DOWN ONE SLOT. TOTLINES IS LEFT ALONE.
; - THE RECORD ITSELF IS NOT RECLAIMED -- SEE THE APPEND CURSOR NOTE ABOVE.
; -

LINEDEL         PUSH    HL              ; SAVE N
                LD      DE, (TOTLINES)
                EX      DE, HL          ; HL = TOTLINES, DE = N
                OR      A
                SBC     HL, DE
                DEC     HL              ; HL = ENTRIES AFTER N
                LD      A, H
                OR      L
                JR      Z, .NOMOVE      ; N IS THE LAST LINE, NOTHING FOLLOWS

                PUSH    HL
                ADD     HL, HL
                POP     DE
                ADD     HL, DE          ; HL = COUNT * DIRSIZ
                LD      B, H
                LD      C, L            ; BC = BYTES TO MOVE

                POP     HL              ; HL = N
                PUSH    HL
                CALL    DIRADR          ; HL = SLOT N
                PUSH    HL
                LD      DE, DIRSIZ
                ADD     HL, DE          ; HL = SLOT N+1, THE SOURCE
                POP     DE              ; DE = SLOT N, THE DESTINATION
                LDIR

.NOMOVE         POP     HL
                RET
