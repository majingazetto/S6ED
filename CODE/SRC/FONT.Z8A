;                                       ****************************************
;                                       * FONT                                 *
;                                       ****************************************
;
; 6X8 CHARSET (256 GLYPHS X 8 BYTES, 1BPP, INK IN BITS 7-2).
; EXPANDS INTO VRAM FONT TABLE AT VR_FNORM (FNORM_SY = 224).
; GLYPH N: SX = (N & 31) * 8, SY = FNORM_SY + (N >> 5) * 8.
;
; SOURCE: THE MSX ROM CHARSET, PULLED OUT OF THE MAIN BIOS AT STARTUP. IT IS
; THE NATIVE 6PX TEXT FACE -- NO GLYPH TOUCHES COLUMN 5, SO CHARACTERS KEEP A
; ONE PIXEL GAP AND THE BOLD TRANSFORM HAS ROOM TO GROW INTO.
;
; DEFINE _FONTBIN_ TO USE THE BUNDLED RES/FONT.BIN ASSET INSTEAD. THAT ASSET
; MUST FOLLOW THE SAME RULE: INK ONLY IN COLUMNS 0-4, COLUMN 5 ALWAYS EMPTY.


                IFNDEF  _FONTBIN_

; --- FONTROM                   ----------------------------------------


; - FONTROM ----------------------------
; - COPY THE MSX ROM 6X8 CHARSET INTO FONTRAM
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - THE CHARSET ADDRESS LIVES AT CGTABL (#0004) IN THE MAIN BIOS ROM. UNDER
; - MSX-DOS PAGE 0 IS RAM, SO BOTH THE POINTER AND THE GLYPH DATA HAVE TO BE
; - FETCHED THROUGH RDSLT. 2050 READS, ONCE, AT STARTUP.
; -

FONTROM         DI

                ; READ THE CHARSET POINTER OUT OF THE BIOS SLOT
                LD      HL, CGTABL
                CALL    RDBIOS
                LD      E, A
                LD      HL, CGTABL + 1
                CALL    RDBIOS
                LD      D, A            ; DE = CHARSET ADDRESS

                ; COPY THE GLYPH DATA INTO RAM
                EX      DE, HL          ; HL = SOURCE IN BIOS ROM
                LD      DE, FONTRAM
                LD      BC, FONTSIZ
.COPYLP         CALL    RDBIOS
                LD      (DE), A
                INC     HL
                INC     DE
                DEC     BC
                LD      A, B
                OR      C
                JR      NZ, .COPYLP
                EI
                RET


; - RDBIOS -----------------------------
; - READ ONE BYTE FROM THE MAIN BIOS SLOT
; - IN:  HL = ADDRESS
; - OUT: A  = BYTE READ
; - CLOBBERS: AF
; - NOTE: CALLER MUST HAVE INTERRUPTS DISABLED
; -

RDBIOS          PUSH    BC
                PUSH    DE
                PUSH    HL
                LD      A, (EXPTBL)     ; MAIN BIOS SLOT ID
                CALL    RDSLT
                POP     HL
                POP     DE
                POP     BC
                RET

                ENDIF


; --- FONTINIT                  ----------------------------------------


; - FONTINIT ---------------------------
; - EXPAND THE CHARSET TO VRAM
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

FONTINIT
                IFNDEF  _FONTBIN_
                CALL    FONTROM         ; PULL THE CHARSET OUT OF THE BIOS
                ENDIF

                LD      DE, FONTSRC     ; SOURCE 1BPP BYTES
                LD      C, 0            ; CHAR 0..255
.CHARLP         LD      B, 0            ; LINE 0..7
.LINELP         PUSH    BC
                PUSH    DE
                LD      A, C
                CALL    CALCVRAM        ; HL = VRAM ADDRESS
                CALL    SETWRT          ; SET VRAM POINTER
                POP     DE
                LD      A, (DE)         ; 1BPP ROW BYTE
                INC     DE
                PUSH    DE
                CALL    EXPNORM         ; D = BYTE 0, E = BYTE 1
                LD      A, D
                OUT     (VDPDR), A
                LD      A, E
                OUT     (VDPDR), A
                POP     DE
                POP     BC
                INC     B
                LD      A, B
                CP      8
                JR      NZ, .LINELP
                
                INC     C
                JR      NZ, .CHARLP
                RET


; - CALCVRAM ---------------------------
; - CALC VRAM ADDRESS FOR CHAR C, LINE B
; - IN:  A = CHAR (0..255), B = LINE (0..7)
; - OUT: HL = VRAM BYTE ADDRESS (#7000..#8FFF)
; - CLOBBERS: AF
; -

CALCVRAM        PUSH    BC
                AND     %11100000
                RRCA
                RRCA                    ; (C >> 5) * 8
                ADD     A, B            ; + LINE = Y_OFF (0..63)
                LD      H, A
                SRL     H               ; H = Y_OFF >> 1
                RRA                     ; BIT 0 OF Y_OFF INTO CARRY
                LD      A, 0
                RRA                     ; A = (Y_OFF & 1) << 7 (#00 OR #80)
                POP     BC
                LD      L, A
                LD      A, C
                AND     %00011111       ; C & 31
                ADD     A, A            ; * 2
                OR      L               ; COMBINE WITH LOW BYTE
                LD      L, A
                LD      A, H
                ADD     A, #70          ; VR_FNORM >> 8 = #70
                LD      H, A
                RET


; --- GLYPH EXPAND HELPERS      ----------------------------------------


; - EXPNORM ----------------------------
; - EXPAND 1BPP ROW BYTE TO 2-BYTE 2BPP (COLOR 1)
; - IN:  A = 1BPP ROM BYTE (BITS 7-2 = 6 PIXELS)
; - OUT: D = BYTE 0 (PIXELS 0-3), E = BYTE 1 (PIXELS 4-5)
; - CLOBBERS: AF, B, DE
; -

EXPNORM         LD      B, A
                LD      DE, 0
                BIT     7, B
                JR      Z, .P1
                SET     6, D
.P1             BIT     6, B
                JR      Z, .P2
                SET     4, D
.P2             BIT     5, B
                JR      Z, .P3
                SET     2, D
.P3             BIT     4, B
                JR      Z, .P4
                SET     0, D
.P4             BIT     3, B
                JR      Z, .P5
                SET     6, E
.P5             BIT     2, B
                JR      Z, .DONE
                SET     4, E
.DONE           RET


; --- ASSETS                    ----------------------------------------

                IFDEF   _FONTBIN_
FONTSRC         INCBIN  "FONT.BIN"
                ELSE
FONTSRC         EQU     FONTRAM         ; FILLED AT STARTUP BY FONTROM
                ENDIF


