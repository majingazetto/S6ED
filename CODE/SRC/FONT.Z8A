;                                       ****************************************
;                                       * FONT                                 *
;                                       ****************************************
;
; 6X8 CHARSET (256 GLYPHS X 8 BYTES, 1BPP, INK IN BITS 7-2).
; EXPANDS INTO THE VRAM FONT TABLE AT VR_FNORM (FNORM_SY = 256).
; GLYPH N: SX = (N & 31) * 8, SY = FNORM_SY + (N >> 5) * 8.
;
; SOURCE: THE MSX ROM CHARSET, PULLED OUT OF THE MAIN BIOS AT STARTUP. IT IS
; THE NATIVE 6PX TEXT FACE -- NO GLYPH TOUCHES COLUMN 5, SO CHARACTERS KEEP A
; ONE PIXEL GAP AND THE BOLD TRANSFORM HAS ROOM TO GROW INTO.
;
; DEFINE _FONTBIN_ TO USE THE BUNDLED RES/FONT.BIN ASSET INSTEAD. THAT ASSET
; MUST FOLLOW THE SAME RULE: INK ONLY IN COLUMNS 0-4, COLUMN 5 ALWAYS EMPTY.


                IFNDEF  _FONTBIN_

; --- FONTROM                   ----------------------------------------


; - FONTROM ----------------------------
; - COPY THE MSX ROM 6X8 CHARSET INTO FONTRAM
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - THE CHARSET ADDRESS LIVES AT CGTABL (#0004) IN THE MAIN BIOS ROM. UNDER
; - MSX-DOS PAGE 0 IS RAM, SO BOTH THE POINTER AND THE GLYPH DATA HAVE TO BE
; - FETCHED THROUGH RDSLT. 2050 READS, ONCE, AT STARTUP.
; -

FONTROM         DI

                ; READ THE CHARSET POINTER OUT OF THE BIOS SLOT
                LD      HL, CGTABL
                CALL    RDBIOS
                LD      E, A
                LD      HL, CGTABL + 1
                CALL    RDBIOS
                LD      D, A            ; DE = CHARSET ADDRESS

                ; COPY THE GLYPH DATA INTO RAM
                EX      DE, HL          ; HL = SOURCE IN BIOS ROM
                LD      DE, FONTRAM
                LD      BC, FONTSIZ
.COPYLP         CALL    RDBIOS
                LD      (DE), A
                INC     HL
                INC     DE
                DEC     BC
                LD      A, B
                OR      C
                JR      NZ, .COPYLP
                EI
                RET


; - RDBIOS -----------------------------
; - READ ONE BYTE FROM THE MAIN BIOS SLOT
; - IN:  HL = ADDRESS
; - OUT: A  = BYTE READ
; - CLOBBERS: AF
; - NOTE: CALLER MUST HAVE INTERRUPTS DISABLED
; -

RDBIOS          PUSH    BC
                PUSH    DE
                PUSH    HL
                LD      A, (EXPTBL)     ; MAIN BIOS SLOT ID
                CALL    RDSLT
                POP     HL
                POP     DE
                POP     BC
                RET

                ENDIF


; --- FONTINIT                  ----------------------------------------


; - FONTINIT ---------------------------
; - EXPAND THE 1BPP CHARSET INTO THE NORMAL FONT TABLE IN VRAM
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - THE TABLE IS WALKED BY VRAM LINE, NOT BY GLYPH. ONE VRAM LINE HOLDS THE
; - SAME SCANLINE OF 32 CONSECUTIVE GLYPHS (32 X 2 BYTES = 64 SEQUENTIAL
; - BYTES), SO THE WHOLE TABLE COSTS 64 SETWRT INSTEAD OF ONE PER GLYPH LINE.
; - SOURCE STRIDE INSIDE A LINE IS 8: GLYPH N ROW L LIVES AT FONTSRC + N*8 + L.
; -
; - THE SCREEN IS BLANKED FOR THE UPLOAD. VRAM TIMING IN GRAPHIC 5 DEMANDS A
; - WIDE GAP BETWEEN ACCESSES WHILE THE DISPLAY IS ACTIVE, AND THIS LOOP IS
; - TIGHTER THAN THAT.
; -

FONTINIT
                IFNDEF  _FONTBIN_
                CALL    FONTROM         ; PULL THE CHARSET OUT OF THE BIOS
                ENDIF

                LD      IX, DISSCR_B
                CALL    BIOSCALL

                LD      HL, VR_FNORM    ; RUNNING VRAM LINE ADDRESS
                LD      DE, FONTSRC     ; BASE OF THE CURRENT GLYPH ROW
                LD      C, 8            ; 8 GLYPH ROWS OF 32 GLYPHS

.ROWLP          PUSH    DE              ; KEEP THE GLYPH ROW BASE
                LD      B, 8            ; 8 SCANLINES PER GLYPH ROW

.LINELP         PUSH    BC
                PUSH    DE              ; SCANLINE SOURCE START
                PUSH    HL              ; VRAM LINE ADDRESS
                CALL    SETWRT
                DI                      ; SETWRT ENDS WITH AN UNCONDITIONAL EI;
                                        ; KEEP THE 64-BYTE BURST ATOMIC
                LD      B, 32           ; 32 GLYPHS SHARE THIS VRAM LINE
.GLYPHLP        LD      A, (DE)         ; 1BPP ROW BYTE
                CALL    EXPNORM         ; H = PIXELS 0-3, L = PIXELS 4-5
                LD      A, H
                OUT     (VDPDR), A
                LD      A, L
                OUT     (VDPDR), A
                LD      HL, 8           ; SAME SCANLINE OF THE NEXT GLYPH
                ADD     HL, DE
                EX      DE, HL
                DJNZ    .GLYPHLP
                EI

                POP     HL              ; VRAM LINE ADDRESS
                LD      DE, 128         ; NEXT VRAM LINE
                ADD     HL, DE
                POP     DE              ; SCANLINE SOURCE START
                INC     DE              ; NEXT SCANLINE OF THE SAME GLYPHS
                POP     BC
                DJNZ    .LINELP

                POP     DE              ; GLYPH ROW BASE
                INC     D               ; + 256 BYTES = NEXT GLYPH ROW
                DEC     C
                JR      NZ, .ROWLP

                LD      IX, ENASCR_B
                CALL    BIOSCALL
                RET


; --- GLYPH EXPAND HELPERS      ----------------------------------------


; - EXPNORM ----------------------------
; - EXPAND 1BPP ROW BYTE TO 2-BYTE 2BPP (COLOR 1)
; - IN:  A = 1BPP ROW BYTE (BITS 7-2 = 6 PIXELS)
; - OUT: H = BYTE 0 (PIXELS 0-3), L = BYTE 1 (PIXELS 4-5)
; - CLOBBERS: AF, HL
; -
; - GRAPHIC 5 PACKS 4 PIXELS OF 2 BITS PER BYTE, MSB FIRST, SO PIXEL K OF INK
; - COLOR 1 IS BIT (6 - 2*K). BITS 1-0 OF THE SOURCE ARE COLUMNS 6-7, WHICH ARE
; - NEVER BLITTED AND ARE IGNORED HERE. THE SOURCE BYTE IS WALKED WITH ADD A,A
; - SO NO SECOND REGISTER IS NEEDED -- FONTINIT KEEPS ITS SOURCE POINTER IN DE
; - AND ITS GLYPH COUNTER IN B ACROSS THE CALL.
; -

EXPNORM         LD      HL, 0
                ADD     A, A            ; BIT 7 -> CARRY
                JR      NC, .P1
                SET     6, H
.P1             ADD     A, A
                JR      NC, .P2
                SET     4, H
.P2             ADD     A, A
                JR      NC, .P3
                SET     2, H
.P3             ADD     A, A
                JR      NC, .P4
                SET     0, H
.P4             ADD     A, A
                JR      NC, .P5
                SET     6, L
.P5             ADD     A, A
                RET     NC
                SET     4, L
                RET


; --- ASSETS                    ----------------------------------------

                IFDEF   _FONTBIN_
FONTSRC         INCBIN  "FONT.BIN"
                ELSE
FONTSRC         EQU     FONTRAM         ; FILLED AT STARTUP BY FONTROM
                ENDIF


