;                                       ****************************************
;                                       * UNDO / REDO SUBSYSTEM                *
;                                       ****************************************
;
; TRANSACTIONAL LINE-DELTA RING BUFFER IN TPA RAM (PAGE 1):
;   LOCATED DYNAMICALLY AT UNDOBAS (= ENDVARS) UP TO UNDOBAS + UNDOSIZ (8 KB).
;   ASSERT GUARDS GUARANTEE IT NEVER OVERLAPS PAGE 2 (TXPAGE = #8000).
;   EACH RECORD CONTAINS A 10-BYTE TRANSACTION HEADER PLUS 161 BYTES PAYLOAD.
;   SYMMETRIC SWAPPING OF PAYLOAD ENABLES BIDIRECTIONAL UNDO AND REDO WITHOUT
;   ANY SECONDARY ALLOCATIONS.
;


; --- UNDOINIT                  ----------------------------------------


; - UNDOINIT ---------------------------
; - INITIALIZE UNDO RING BUFFER POINTERS
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

UNDOINIT        XOR     A
                LD      (UNDOPTR), A
                LD      (UNDOPTR + 1), A
                LD      (REDOPTR), A
                LD      (REDOPTR + 1), A
                LD      (UNDOTYP), A
                LD      HL, UNDOBAS
                LD      (UNDOBOT), HL
                LD      (UNDONXT), HL
                RET


; --- UNDOCLS                   ----------------------------------------


; - UNDOCLS ----------------------------
; - CLOSE ACTIVE TYPING COALESCING BURST
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

UNDOCLS         XOR     A
                LD      (UNDOTYP), A
                RET


; --- UNDOREC                   ----------------------------------------


; - UNDOREC ----------------------------
; - ALLOCATE RECORD IN RING BUFFER AND WRITE TRANSACTION HEADER & PAYLOAD
; - IN:  A = OP_TYPE (UNDOT_MOD OR UNDOT_DEL)
; -      WORKBUF HAS PRE-MUTATION RECORD
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

UNDOREC         LD      C, A            ; C = OP_TYPE
                LD      A, (UNDOHLD)
                OR      A
                RET     NZ              ; SUPPRESSED (DURING REDO)

                ; 1. COMPUTE ALLOCATION ADDRESS IN RING BUFFER
                LD      HL, (UNDONXT)
                LD      A, H
                OR      L
                JR      NZ, .HAVENX
                LD      HL, UNDOBAS
                LD      (UNDONXT), HL
                LD      (UNDOBOT), HL

.HAVENX         ; DOES IT FIT BEFORE END OF RING BUFFER?
                ; RANGE: [UNDOBAS, UNDOBAS + UNDOSIZ)
                PUSH    HL              ; SAVE CANDIDATE
                LD      DE, UNDOMOD_SZ
                ADD     HL, DE          ; HL = END OF CANDIDATE RECORD
                LD      DE, UNDOBAS + UNDOSIZ
                OR      A
                SBC     HL, DE          ; CY=1 OR Z=1 IF FITS BEFORE END
                POP     HL              ; RESTORE CANDIDATE
                JR      C, .FITS
                JR      Z, .FITS

                ; DOES NOT FIT AT END: WRAP TO START OF BUFFER
                LD      HL, UNDOBAS

.FITS           ; HL = WRITE ADDRESS FOR NEW RECORD
                ; 2. EVICT OLDEST TRANSACTIONS IF OVERLAPPING [HL, HL + UNDOMOD_SZ)
                LD      A, (UNDOPTR)
                LD      E, A
                LD      A, (UNDOPTR + 1)
                OR      E
                JR      Z, .NOEVCT      ; BUFFER EMPTY: NO EVICTION NEEDED

                PUSH    BC              ; PRESERVE C (OP_TYPE)
                PUSH    HL
                CALL    UNDOEVC
                POP     HL
                POP     BC

.NOEVCT         ; 3. WRITE TRANSACTION HEADER AT HL
                PUSH    HL              ; SAVE RECORD BASE

                ; PREV_TRN = (UNDOPTR)
                LD      DE, (UNDOPTR)
                LD      (HL), E
                INC     HL
                LD      (HL), D
                INC     HL

                ; NEXT_TRN = 0
                LD      (HL), 0
                INC     HL
                LD      (HL), 0
                INC     HL

                ; OP_TYPE
                LD      (HL), C
                INC     HL

                ; DOCLINE
                LD      DE, (DOCLINE)
                LD      (HL), E
                INC     HL
                LD      (HL), D
                INC     HL

                ; CURX
                LD      A, (CURX)
                LD      (HL), A
                INC     HL

                ; TOPLINE
                LD      DE, (TOPLINE)
                LD      (HL), E
                INC     HL
                LD      (HL), D
                INC     HL              ; HL = HL + 10 (PAYLOAD BASE)

                ; 4. COPY WORKBUF (161 BYTES) TO PAYLOAD
                EX      DE, HL          ; DE = DESTINATION (HL + 10)
                LD      HL, WORKBUF     ; HL = SOURCE
                LD      BC, LINEREC     ; 161 BYTES
                LDIR                    ; DE ADVANCES TO HL + 171

                POP     HL              ; HL = START OF THIS RECORD

                ; 5. LINK PREVIOUS RECORD'S NEXT_TRN TO THIS RECORD
                LD      BC, (UNDOPTR)
                LD      A, B
                OR      C
                JR      Z, .FIRST
                ; PREVIOUS RECORD EXISTS AT BC. ITS NEXT_TRN IS AT BC + 2
                INC     BC
                INC     BC
                LD      A, L
                LD      (BC), A
                INC     BC
                LD      A, H
                LD      (BC), A
                JR      .LNKDON

.FIRST          ; THIS IS THE FIRST/ONLY RECORD IN EMPTY BUFFER
                LD      (UNDOBOT), HL

.LNKDON         ; 6. UPDATE GLOBAL UNDO STATE
                LD      (UNDOPTR), HL   ; NEW HEAD OF UNDO CHAIN
                EX      DE, HL          ; HL = DE (END OF RECORD: BASE + 171)
                LD      (UNDONXT), HL   ; NEXT WRITE LOCATION
                XOR     A
                LD      (REDOPTR), A    ; NEW EDIT INVALIDATES REDO
                LD      (REDOPTR + 1), A
                RET


; --- UNDOBGN                   ----------------------------------------


; - UNDOBGN ----------------------------
; - START OR CONTINUE UNDO TRANSACTION FOR CURRENT LINE
; - IN:  WORKBUF HAS PRE-MUTATION RECORD
; - OUT: NONE
; - CLOBBERS: AF, HL (PRESERVES BC, DE, WORKBUF)
; -

UNDOBGN         PUSH    BC
                PUSH    DE

                ; 1. CHECK IF ALREADY COALESCING ON SAME LINE
                LD      A, (UNDOTYP)
                OR      A
                JR      Z, .NEWTRN      ; NOT COALESCING -> OPEN NEW

                ; ARE WE STILL ON THE SAME DOCLINE?
                LD      HL, (DOCLINE)
                LD      DE, (UNDOLIN)
                OR      A
                SBC     HL, DE
                JP      Z, .DONE        ; SAME LINE -> KEEP COALESCING!

                ; DIFFERENT LINE: CLOSE PREVIOUS
                CALL    UNDOCLS

.NEWTRN         LD      A, UNDOT_MOD
                CALL    UNDOREC

                ; SET COALESCING ACTIVE FOR THIS LINE
                LD      A, 1
                LD      (UNDOTYP), A
                LD      HL, (DOCLINE)
                LD      (UNDOLIN), HL

.DONE           POP     DE
                POP     BC
                RET


; --- UNDODEL                   ----------------------------------------


; - UNDODEL ----------------------------
; - RECORD DELETED LINE IN UNDO RING BUFFER
; - IN:  WORKBUF HAS PRE-MUTATION LINE RECORD
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDODEL         CALL    UNDOCLS
                LD      A, UNDOT_DEL
                JP      UNDOREC


; --- UNDOSPL                   ----------------------------------------


; - UNDOSPL ----------------------------
; - RECORD LINE SPLIT (ENTER) IN UNDO RING BUFFER
; - IN:  WORKBUF HAS PRE-SPLIT LINE RECORD
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOSPL         LD      A, (UNDOHLD)
                OR      A
                RET     NZ
                CALL    UNDOCLS
                LD      A, UNDOT_SPL
                JP      UNDOREC


; --- UNDOJON                   ----------------------------------------


; - UNDOJON ----------------------------
; - RECORD LINE JOIN IN UNDO RING BUFFER
; - IN:  WORKBUF2 HAS LINE B RECORD (DELETED LINE)
; -      JOINLA HAS LINE A NUMBER
; -      JOINCOL HAS SEAM COLUMN
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOJON         LD      A, (UNDOHLD)
                OR      A
                RET     NZ
                CALL    UNDOCLS
                LD      HL, WORKBUF2
                LD      DE, WORKBUF
                LD      BC, LINEREC
                LDIR
                LD      HL, (DOCLINE)
                PUSH    HL
                LD      A, (CURX)
                PUSH    AF
                LD      HL, (JOINLA)
                LD      (DOCLINE), HL
                LD      A, (JOINCOL)
                LD      (CURX), A
                LD      A, UNDOT_JON
                CALL    UNDOREC
                POP     AF
                LD      (CURX), A
                POP     HL
                LD      (DOCLINE), HL
                RET


; --- UNDOEVC                   ----------------------------------------


; - UNDOEVC ----------------------------
; - EVICT TRANSACTIONS AT (UNDOBOT) THAT COLLIDE WITH [HL, HL + UNDOMOD_SZ)
; - IN:  HL = WRITE BASE ADDRESS
; - OUT: NONE
; - CLOBBERS: AF, DE (PRESERVES BC, HL)
; -

UNDOEVC         ; EVICT TRANSACTIONS AT (UNDOBOT) THAT COLLIDE WITH [HL, HL + UNDOMOD_SZ)
.EVCLP          LD      DE, (UNDOBOT)
                LD      A, D
                OR      E
                RET     Z               ; NO MORE RECORDS: DONE

                ; CHECK IF DE IS INSIDE [HL, HL + UNDOMOD_SZ)
                ; IS DE < HL?
                PUSH    HL
                EX      DE, HL          ; HL = UNDOBOT, DE = WRITE BASE
                OR      A
                SBC     HL, DE          ; HL = UNDOBOT - WRITE_BASE
                POP     HL              ; HL = WRITE BASE
                JR      C, .EVCDON      ; UNDOBOT < WRITE_BASE -> NOT IN WINDOW

                ; IS (UNDOBOT - WRITE_BASE) < UNDOMOD_SZ?
                PUSH    HL
                EX      DE, HL
                OR      A
                SBC     HL, DE          ; HL = UNDOBOT - WRITE_BASE
                LD      DE, UNDOMOD_SZ
                OR      A
                SBC     HL, DE          ; CY=1 IF (UNDOBOT - BASE) < UNDOMOD_SZ
                POP     HL              ; HL = WRITE BASE
                JR      NC, .EVCDON     ; NOT IN COLLISION WINDOW -> DONE

                ; COLLISION DETECTED: EVICT RECORD AT (UNDOBOT)
                LD      IX, (UNDOBOT)
                LD      E, (IX + 2)     ; NEXT_TRN LOW
                LD      D, (IX + 3)     ; NEXT_TRN HIGH
                LD      A, D
                OR      E
                JR      NZ, .EVCNXT

                ; WAS THE ONLY RECORD: BUFFER NOW EMPTY
                XOR     A
                LD      (UNDOPTR), A
                LD      (UNDOPTR + 1), A
                LD      (UNDOBOT), A
                LD      (UNDOBOT + 1), A
                RET

.EVCNXT         ; ADVANCE UNDOBOT = NEXT_TRN AND CLEAR ITS PREV_TRN
                LD      (UNDOBOT), DE
                PUSH    HL
                EX      DE, HL          ; HL = NEW BOT RECORD
                LD      (HL), 0         ; PREV_TRN = 0
                INC     HL
                LD      (HL), 0
                POP     HL
                JR      .EVCLP          ; CHECK IF NEXT RECORD ALSO COLLIDES

.EVCDON         RET


; --- UNDOSWP                   ----------------------------------------


; - UNDOSWP ----------------------------
; - SWAP DOCUMENT LINE RECORD WITH UNDO PAYLOAD AND RESTORE CURSOR
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOSWP         ; 1. SET TARGET DOCLINE
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL

                ; 2. READ CURRENT DOCUMENT LINE INTO WORKBUF2
                CALL    LINEREAD        ; READS (DOCLINE) INTO WORKBUF
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, LINEREC
                LDIR                    ; WORKBUF2 NOW HOLDS CURRENT LINE

                ; 3. COPY UNDO PAYLOAD (IX + 10) INTO WORKBUF
                PUSH    IX
                POP     HL
                LD      DE, UNDOHDR_SZ
                ADD     HL, DE          ; HL = IX + 10 (PAYLOAD)
                LD      DE, WORKBUF
                LD      BC, LINEREC
                LDIR                    ; WORKBUF NOW HOLDS RESTORED LINE

                ; 4. WRITE RESTORED LINE TO DOCUMENT
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 5. COPY DISPLACED LINE (WORKBUF2) BACK INTO UNDO PAYLOAD (IX + 10)
                PUSH    IX
                POP     DE
                LD      HL, UNDOHDR_SZ
                ADD     HL, DE
                EX      DE, HL          ; DE = IX + 10
                LD      HL, WORKBUF2
                LD      BC, LINEREC
                LDIR                    ; PAYLOAD SWAPPED FOR REDO!

                ; 6. SWAP CURX IN RECORD (IX + 7) WITH CURRENT CURX
                LD      A, (CURX)
                LD      B, (IX + 7)
                LD      (IX + 7), A     ; RECORD GETS DISPLACED CURX
                LD      A, B
                LD      (CURX), A       ; CURX RESTORED!

                ; 7. RESTORE TOPLINE
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL

                ; 8. MARK BUFFER MODIFIED & UPDATE CURY
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    SETCURY

                ; 9. REDRAW SCREEN, STATUS AND CURSOR
                CALL    REDRAW
                CALL    DRWSTAT
                JP      DRWCUR


; --- ACTUNDO                   ----------------------------------------


; - ACTUNDO ----------------------------
; - UNDO LAST ACTION (CTRL+Z / VI U)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTUNDO         CALL    UNDOCLS
                LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                LD      HL, (UNDOPTR)
                LD      A, H
                OR      L
                RET     Z               ; NOTHING TO UNDO

                PUSH    HL
                POP     IX

                ; CHECK OP_TYPE (IX + 4)
                LD      A, (IX + 4)
                CP      UNDOT_MOD
                JR      Z, .DOMOD
                CP      UNDOT_DEL
                JR      Z, .DODEL
                CP      UNDOT_SPL
                JR      Z, .DOSPL
                CP      UNDOT_JON
                JR      Z, .DOJON
                RET

.DOMOD          ; RECORD BEING UNDONE BECOMES HEAD OF REDO
                LD      (REDOPTR), IX

                ; ADVANCE UNDOPTR BACKWARDS: UNDOPTR = PREV_TRN (IX + 0)
                LD      L, (IX + 0)
                LD      H, (IX + 1)
                LD      (UNDOPTR), HL

                ; SWAP DOCUMENT WITH PAYLOAD (RESTORING PRE-MUTATION STATE)
                JP      UNDOSWP

.DODEL          ; REVERSE DELETION: RE-INSERT LINE
                JP      UNDORST

.DOSPL          ; REVERSE SPLIT: MERGE LINES BACK TOGETHER
                JP      UNDOSPU

.DOJON          ; REVERSE JOIN: SEPARATE LINES BACK APART
                JP      UNDOJNU


; --- ACTREDO                   ----------------------------------------


; - ACTREDO ----------------------------
; - REDO LAST UNDONE ACTION (CTRL+Y / VI CTRL+R)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTREDO         CALL    UNDOCLS
                LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                LD      HL, (REDOPTR)
                LD      A, H
                OR      L
                RET     Z               ; NOTHING TO REDO

                PUSH    HL
                POP     IX

                ; CHECK OP_TYPE (IX + 4)
                LD      A, (IX + 4)
                CP      UNDOT_MOD
                JR      Z, .DOMOD
                CP      UNDOT_DEL
                JR      Z, .DODEL
                CP      UNDOT_SPL
                JR      Z, .DOSPL
                CP      UNDOT_JON
                JR      Z, .DOJON
                RET

.DOMOD          ; RECORD BEING REDONE BECOMES HEAD OF UNDO
                LD      (UNDOPTR), IX

                ; ADVANCE REDOPTR FORWARD: REDOPTR = NEXT_TRN (IX + 2)
                LD      L, (IX + 2)
                LD      H, (IX + 3)
                LD      (REDOPTR), HL

                ; SWAP DOCUMENT WITH PAYLOAD (RESTORES MUTATION STATE)
                JP      UNDOSWP

.DODEL          ; RE-APPLY DELETION: DELETE LINE AGAIN
                JP      UNDOKIL

.DOSPL          ; RE-APPLY SPLIT: SPLIT LINE AGAIN
                JP      REDOSPL

.DOJON          ; RE-APPLY JOIN: JOIN LINES AGAIN
                JP      REDOJON


; --- UNDORST                   ----------------------------------------


; - UNDORST ----------------------------
; - REVERSE LINE DELETION: RE-INSERT LINE INTO DOCUMENT
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDORST         ; 1. CHECK IF LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC              ; DIRECTORY FULL: REFUSE RESURRECTION

                ; 2. RESERVE SPACE IN MAPPER FOR RESTORED LINE
                CALL    NEWREC
                RET     C               ; OOM: CANNOT UNDO DELETION

                ; SAVE RETURNED SEGMENT AND OFFSET
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 3. UPDATE UNDOPTR AND REDOPTR
                LD      (REDOPTR), IX
                LD      L, (IX + 0)
                LD      H, (IX + 1)
                LD      (UNDOPTR), HL

                ; 4. COPY PAYLOAD (IX + 10) INTO TXPAGE + NROFF
                ; (PAGE 2 IS BANKED TO NRSEG BY NEWREC)
                LD      DE, (NROFF)
                LD      HL, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                PUSH    IX
                POP     HL
                LD      BC, UNDOHDR_SZ
                ADD     HL, BC          ; HL = SOURCE (IX + 10)
                LD      BC, LINEREC     ; 161 BYTES
                LDIR

                ; 5. OPEN DIRECTORY SLOT AT (IX + 5) AND FILL IT
                LD      L, (IX + 5)
                LD      H, (IX + 6)     ; HL = DOCLINE
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                ; 6. BUMP TOTLINES
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. RESTORE DOCLINE, CURX, TOPLINE
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                LD      A, (IX + 7)
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL

                ; 8. UPDATE CURY, MARK MODIFIED & REDRAW
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWSTAT
                JP      DRWCUR


; --- UNDOKIL                   ----------------------------------------


; - UNDOKIL ----------------------------
; - RE-APPLY LINE DELETION (REDO OF DELETED LINE)
; - IN:  IX = TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOKIL         ; 1. ADVANCE REDOPTR AND UPDATE UNDOPTR
                LD      (UNDOPTR), IX
                LD      L, (IX + 2)
                LD      H, (IX + 3)
                LD      (REDOPTR), HL

                ; 2. DELETE LINE AT (IX + 5)
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                CALL    LINEDEL

                ; 3. DECREMENT TOTLINES
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                ; 4. CLAMP DOCLINE IF DOCLINE >= TOTLINES
                LD      HL, (DOCLINE)
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .DKLOK
                DEC     HL
                LD      (DOCLINE), HL

.DKLOK          ; 5. CURSOR TO COL 0, RESTORE TOPLINE, CURY, REDRAW
                XOR     A
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWSTAT
                JP      DRWCUR


; --- UNDOSPU                   ----------------------------------------


; - UNDOSPU ----------------------------
; - REVERSE LINE SPLIT (MERGE LINES BACK TOGETHER)
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOSPU         ; 1. UPDATE UNDOPTR AND REDOPTR
                LD      (REDOPTR), IX
                LD      L, (IX + 0)
                LD      H, (IX + 1)
                LD      (UNDOPTR), HL

                ; 2. DELETE LINE (DOCLINE + 1) (THE TAIL LINE)
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                INC     HL              ; HL = DOCLINE + 1
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                ; 3. RESTORE PRE-SPLIT LINE AT (IX + 5) FROM PAYLOAD
                PUSH    IX
                POP     HL
                LD      DE, UNDOHDR_SZ
                ADD     HL, DE          ; HL = IX + 10 (PAYLOAD)
                LD      DE, WORKBUF
                LD      BC, LINEREC     ; 161 BYTES
                LDIR
                LD      L, (IX + 5)
                LD      H, (IX + 6)     ; HL = DOCLINE
                CALL    LINEWRT

                ; 4. RESTORE DOCLINE, CURX, TOPLINE
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                LD      A, (IX + 7)
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL

                ; 5. UPDATE CURY, MARK MODIFIED & REDRAW
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWSTAT
                JP      DRWCUR


; --- REDOSPL                   ----------------------------------------


; - REDOSPL ----------------------------
; - RE-APPLY LINE SPLIT (ENTER)
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

REDOSPL         ; 1. UPDATE UNDOPTR AND REDOPTR
                LD      (UNDOPTR), IX
                LD      L, (IX + 2)
                LD      H, (IX + 3)
                LD      (REDOPTR), HL

                ; 2. POSITION CURSOR AT THE SPLIT POINT
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                LD      A, (IX + 7)
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL
                CALL    SETCURY

                ; 3. EXECUTE EDNWLIN WITH UNDOHLD = 1
                LD      A, 1
                LD      (UNDOHLD), A
                CALL    EDNWLIN
                XOR     A
                LD      (UNDOHLD), A

                ; 4. UPDATE STATUS AND CURSOR
                CALL    DRWSTAT
                JP      DRWCUR


; --- UNDOJNU                   ----------------------------------------


; - UNDOJNU ----------------------------
; - REVERSE LINE JOIN: RESTORE DELETED LINE B AND TRUNCATE LINE A
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOJNU         ; 1. CHECK IF LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; 2. RESERVE SPACE IN MAPPER FOR RESTORED LINE B
                CALL    NEWREC
                RET     C
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 3. UPDATE UNDOPTR AND REDOPTR
                LD      (REDOPTR), IX
                LD      L, (IX + 0)
                LD      H, (IX + 1)
                LD      (UNDOPTR), HL

                ; 4. TRUNCATE LINE A AT (IX + 5) BACK TO JOINCOL (IX + 7)
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                CALL    LINEREAD        ; READS COMBINED LINE A INTO WORKBUF
                LD      A, (IX + 7)
                LD      (WORKBUF), A    ; TRUNCATE LENGTH TO SEAM
                CALL    RECBL80         ; BLANK TAIL TO SPACES
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                CALL    LINEWRT         ; WRITE TRUNCATED LINE A BACK

                ; 5. COPY PAYLOAD (IX + 10) INTO TXPAGE + NROFF (LINE B)
                LD      A, (NRSEG)
                CALL    RECBANK         ; BANK NRSEG BACK INTO PAGE 2
                LD      DE, (NROFF)
                LD      HL, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                PUSH    IX
                POP     HL
                LD      BC, UNDOHDR_SZ
                ADD     HL, BC          ; HL = SOURCE (IX + 10)
                LD      BC, LINEREC     ; 161 BYTES
                LDIR

                ; 6. OPEN DIRECTORY SLOT AT (IX + 5) + 1 (LINE B) AND FILL IT
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                INC     HL              ; HL = LINE A + 1 (LINE B)
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                ; 7. BUMP TOTLINES
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 8. RESTORE DOCLINE, CURX, TOPLINE
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                LD      A, (IX + 7)
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL

                ; 9. UPDATE CURY, MARK MODIFIED & REDRAW
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWSTAT
                JP      DRWCUR


; --- REDOJON                   ----------------------------------------


; - REDOJON ----------------------------
; - RE-APPLY LINE JOIN
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: NONE
; - CLOBBERS: ALL
; -

REDOJON         ; 1. UPDATE UNDOPTR AND REDOPTR
                LD      (UNDOPTR), IX
                LD      L, (IX + 2)
                LD      H, (IX + 3)
                LD      (REDOPTR), HL

                ; 2. JOIN LINE A AND LINE A + 1 WITH UNDOHLD = 1
                LD      A, 1
                LD      (UNDOHLD), A
                LD      L, (IX + 5)
                LD      H, (IX + 6)     ; HL = LINE A
                LD      E, L
                LD      D, H
                INC     DE              ; DE = LINE B (LINE A + 1)
                CALL    JOIN2L
                XOR     A
                LD      (UNDOHLD), A

                ; 3. RESTORE CURX AT SEAM
                LD      A, (IX + 7)
                LD      (CURX), A
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL

                ; 4. UPDATE CURY, MARK MODIFIED & REDRAW
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWSTAT
                JP      DRWCUR

