;                                       ****************************************
;                                       * ACTION                               *
;                                       ****************************************
;
; ATOMIC ACTION IMPLEMENTATIONS AND ACTION VECTOR TABLE (ACTTBL).
; ALL ACTIONS OPERATE ON SYSTEM AND EDITOR STATE (DOCLINE, CURX, WORKBUF, ETC.)


; --- ACTTBL                    ----------------------------------------


ACTTBL          DEFW    ACTNONE         ; 0
                DEFW    ACTMVL          ; 1
                DEFW    ACTMVR          ; 2
                DEFW    ACTMVU          ; 3
                DEFW    ACTMVD          ; 4
                DEFW    ACTBOL          ; 5
                DEFW    ACTEOL          ; 6
                DEFW    ACTTOP          ; 7
                DEFW    ACTBOT          ; 8
                DEFW    ACTWLFT         ; 9
                DEFW    ACTWRGT         ; 10
                DEFW    ACTDWLFT        ; 11
                DEFW    ACTPGUP         ; 12
                DEFW    ACTPGDN         ; 13
                DEFW    ACTDELBK        ; 14
                DEFW    ACTDELFW        ; 15
                DEFW    ACTDELLN        ; 16
                DEFW    ACTNWLIN        ; 17
                DEFW    ACTOPNBL        ; 18
                DEFW    ACTOPNAB        ; 19
                DEFW    ACTTGLIN        ; 20
                DEFW    ACTTGLWR        ; 21
                DEFW    ACTSAVE         ; 22
                DEFW    ACTQUIT         ; 23
                DEFW    ACTHELP         ; 24
                DEFW    ACTCYCKM        ; 25
                DEFW    ACTVIINS        ; 26
                DEFW    ACTVIAPP        ; 27
                DEFW    ACTVINRM        ; 28
                DEFW    ACTVILED        ; 29
                DEFW    ACTSLML         ; 30
                DEFW    ACTSLMR         ; 31
                DEFW    ACTSLMU         ; 32
                DEFW    ACTSLMD         ; 33
                DEFW    ACTSLBOL        ; 34
                DEFW    ACTSLEOL        ; 35
                DEFW    ACTSLTOP        ; 36
                DEFW    ACTSLBOT        ; 37
                DEFW    ACTSLWLF        ; 38
                DEFW    ACTSLWRT        ; 39
                DEFW    ACTSLPGU        ; 40
                DEFW    ACTSLPGD        ; 41
                DEFW    ACTSELAL        ; 42
                DEFW    ACTDSEL         ; 43
                DEFW    ACTDLS          ; 44
                DEFW    ACTCOPY         ; 45
                DEFW    ACTCUT          ; 46
                DEFW    ACTPAST         ; 47
                DEFW    ACTTGLBD        ; 48
                DEFW    ACTTGLIT        ; 49
                DEFW    ACTCYCMK        ; 50
                DEFW    ACTTAB          ; 51
                DEFW    ACTMENU         ; 52 (FILE)
                DEFW    ACTMNU1         ; 53 (EDIT)
                DEFW    ACTMNU2         ; 54 (VIEW)
                DEFW    ACTMNU3         ; 55 (OPTIONS)
                DEFW    ACTMNU4         ; 56 (HELP)
                DEFW    ACTUNDO         ; 57 (UNDO)
                DEFW    ACTREDO         ; 58 (REDO)
                DEFW    ACTGOTO         ; 59 (GO TO LINE)
                DEFW    ACTFIND         ; 60 (FIND & REPLACE)
                DEFW    ACTFNXT         ; 61 (FIND NEXT)
                DEFW    ACTFPRV         ; 62 (FIND PREV)
                DEFW    ACTEXMOD        ; 63 (VI ':' COMMAND CONSOLE)
                DEFW    ACTNEW          ; 64 (CTRL + N / FILE > NEW)
                DEFW    ACTOPEN         ; 65 (CTRL + O / FILE > OPEN)
                DEFW    ACTSAVAS        ; 66 (CTRL + SHIFT + S / FILE > SAVE AS)
                DEFW    ACTVIAPE        ; 67 (VI A / APPEND AT EOL)
                DEFW    ACTVIINB        ; 68 (VI I / INSERT AT BOL)
                DEFW    ACTVILEG        ; 69 (VI LEADER 'g')
                DEFW    ACTVIKIL        ; 70 (VI D / DELETE TO EOL)
                DEFW    ACTVIVIS        ; 71 (VI v / CHARACTER VISUAL MODE)
                DEFW    ACTVILIN        ; 72 (VI V / LINE VISUAL MODE)
                DEFW    ACTVICPY        ; 73 (VI y / YANK VISUAL SELECTION)
                DEFW    ACTVICUT        ; 74 (VI d/x / CUT VISUAL SELECTION)
                ASSERT  ($ - ACTTBL) / 2 == ACMAX


; --- ACTNONE                   ----------------------------------------


; - ACTNONE ----------------------------
; - NO OPERATION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

ACTNONE         RET


; --- CHKUNSEL                  ----------------------------------------


; - CHKUNSEL ---------------------------
; - CANCEL SELECTION IF SHIFT IS NOT HELD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CHKUNSEL        CALL    UNDOCLS
                LD      A, (MODKEYS)
                AND     MODSHFT
                RET     NZ              ; SHIFT PRESSED: PRESERVE SELECTION
                LD      A, (KMAPID)
                CP      KMVI
                RET     Z               ; IN VI MODE, SELECTION IS MODAL
                LD      A, (SELACT)
                OR      A
                RET     Z               ; NO SELECTION ACTIVE
                JP      ACTDSEL


; --- ACTMVL                    ----------------------------------------


; - ACTMVL -----------------------------
; - MOVE CURSOR LEFT ONE COLUMN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVL          CALL    CHKUNSEL
                LD      A, CLEFT
                JP      EDMOVCHR


; --- ACTMVR                    ----------------------------------------


; - ACTMVR -----------------------------
; - MOVE CURSOR RIGHT ONE COLUMN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVR          CALL    CHKUNSEL
                LD      A, CRIGHT
                JP      EDMOVCHR


; --- ACTMVU                    ----------------------------------------


; - ACTMVU -----------------------------
; - MOVE CURSOR UP ONE ROW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVU          CALL    CHKUNSEL
                LD      A, CUP
                CALL    EDMOVROW
                JP      EDCLMPX


; --- ACTMVD                    ----------------------------------------


; - ACTMVD -----------------------------
; - MOVE CURSOR DOWN ONE ROW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVD          CALL    CHKUNSEL
                LD      A, CDOWN
                CALL    EDMOVROW
                JP      EDCLMPX


; --- ACTBOL                    ----------------------------------------


; - ACTBOL -----------------------------
; - MOVE CURSOR TO BEGINNING OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTBOL          CALL    CHKUNSEL
                XOR     A
                LD      (CURX), A
                RET


; --- ACTEOL                    ----------------------------------------


; - ACTEOL -----------------------------
; - MOVE CURSOR TO END OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTEOL          CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                CALL    GETMAXC
                LD      (CURX), A
                ; VI VISUAL: $ GOES PAST THE LAST CHARACTER, ONTO THE LINE
                ; BREAK, AS IN VIM. THE (INCLUSIVE) SELECTION THEN COVERS THE
                ; BREAK AND COPY / CUT TAKE IT (SELEOL); V USES THIS TOO.
                LD      HL, (KMAPPTR)
                LD      DE, KMAPVIV
                CALL    CMPHLDE
                RET     NZ
                LD      A, (WORKBUF)
                CP      MAXCOLS
                RET     NC
                LD      (CURX), A
                RET


; --- ACTTOP                    ----------------------------------------


; - ACTTOP -----------------------------
; - MOVE CURSOR TO TOP OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTOP          CALL    CHKUNSEL
                LD      HL, 0
                LD      (DOCLINE), HL
                LD      (TOPLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                JP      REDRAW


; --- ACTBOT                    ----------------------------------------


; - ACTBOT -----------------------------
; - MOVE CURSOR TO BOTTOM OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTBOT          CALL    CHKUNSEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (DOCLINE), HL
                LD      DE, ROWSVIS
                CALL    CMPHLDE
                JR      C, .SHRTDOC
                LD      HL, (TOTLINES)
                LD      DE, ROWSVIS
                OR      A
                SBC     HL, DE
                LD      (TOPLINE), HL
                LD      A, ROWSVIS - 1
                LD      (CURY), A
                JR      .REDBOT
.SHRTDOC        LD      HL, 0
                LD      (TOPLINE), HL
                LD      A, (DOCLINE)
                LD      (CURY), A
.REDBOT         XOR     A
                LD      (CURX), A
                JP      REDRAW


; --- ADJLCOL                   ----------------------------------------


; - ADJLCOL ----------------------------
; - ADJUST HORIZONTAL VIEWPORT (LEFTCOL) ACCORDING TO CURX
; - IN:  NONE (USES CURX, LEFTCOL)
; - OUT: CY = 1  LEFTCOL CHANGED (REDRAW NEEDED)
; -      CY = 0  LEFTCOL UNCHANGED
; - CLOBBERS: AF, HL
; -

ADJLCOL         LD      A, (CURX)
                LD      HL, LEFTCOL
                CP      (HL)
                JR      C, .LEFTOVR

                SUB     (HL)            ; A = CURX - LEFTCOL
                CP      TEXTCOLS
                JR      NC, .RGHTOVR
                OR      A               ; CLEAR CARRY
                RET

.LEFTOVR        LD      A, (CURX)
                SUB     8
                JR      NC, .SETL
                XOR     A               ; CLAMP TO 0
.SETL           LD      (LEFTCOL), A
                SCF                     ; CARRY = 1 (CHANGED)
                RET

.RGHTOVR        LD      A, (CURX)
                SUB     TEXTCOLS
                ADD     A, 9            ; TARGET = CURX - TEXTCOLS + 1 + 8
                CP      MAXCOLS - TEXTCOLS
                JR      C, .ROK
                LD      A, MAXCOLS - TEXTCOLS
.ROK            LD      HL, LEFTCOL
                CP      (HL)
                JR      Z, .NOCHG
                LD      (HL), A
                SCF                     ; CARRY = 1 (CHANGED)
                RET

.NOCHG          OR      A               ; NO CHANGE: CLEAR CARRY
                RET


; --- ACTWLFT                   ----------------------------------------


; - ACTWLFT ----------------------------
; - MOVE CURSOR TO START OF PREV WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTWLFT         CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (CURX)
                OR      A
                RET     Z
                DEC     A
                LD      B, A            ; B = SCAN COLUMN

                ; 1. SKIP SPACES TO THE LEFT
.WLSKSPC        LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      NZ, .WLSKPW
                LD      A, B
                OR      A
                JR      Z, .WLBOL
                DEC     B
                JR      .WLSKSPC

                ; 2. SCAN WORD CHARACTERS TO FIND START
.WLSKPW         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WLFND
                LD      A, B
                OR      A
                JR      Z, .WLBOL
                DEC     B
                JR      .WLSKPW

.WLFND          INC     B
                LD      A, B
                LD      (CURX), A
                RET

.WLBOL          XOR     A
                LD      (CURX), A
                RET


; --- ACTWRGT                   ----------------------------------------


; - ACTWRGT ----------------------------
; - MOVE CURSOR TO START OF NEXT WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTWRGT         CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                LD      C, A            ; C = LENGTH
                LD      A, (CURX)
                CP      C
                RET     NC
.WRSKNON        INC     A
                CP      C
                JR      NC, .WREOL
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WRSKSPC
                LD      A, E
                JR      .WRSKNON
.WRSKSPC        INC     E
                LD      A, E
                CP      C
                JR      NC, .WREOL
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WRSKSPC
                LD      A, E
                LD      (CURX), A
                RET
.WREOL          LD      A, C
                CALL    GETMAXC
                LD      (CURX), A
                RET


; --- ACTDWLFT                  ----------------------------------------


; - ACTDWLFT ---------------------------
; - DELETE ENTIRE PREVIOUS WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDWLFT        LD      A, (CURX)
                OR      A
                RET     Z
                LD      (DWFROM), A
                CALL    ACTWLFT
                LD      A, (CURX)
                LD      (DWTO), A
                LD      A, (DWFROM)
                LD      (CURX), A       ; RESTORE CURX
                LD      HL, DWTO
                SUB     (HL)            ; A = DWFROM - DWTO = K
                RET     Z               ; DELTA IS ZERO, NOTHING TO DELETE
                LD      (DWK), A

                ; RECORD THE LINE BEFORE IT CHANGES; CURX IS DWFROM AGAIN, SO
                ; CTRL+Z PUTS THE CURSOR BACK AFTER THE WORD
                CALL    UNDOCLS
                LD      A, UNDOT_MOD
                CALL    UNDOREC

                ; DELETE COLUMNS DWTO..DWFROM-1 OF THE RECORD
                LD      A, (DWTO)
                LD      B, A
                LD      A, (DWFROM)
                LD      C, A
                CALL    WBDELN

.DONELEN        ; 6. SET CURX TO DWTO
                LD      A, (DWTO)
                LD      (CURX), A

                ; 7. WRITE TO MAPPER & RENDER ROW ONCE
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW

                LD      A, #FF
                LD      (MODIFIED), A
                JP      DRWSTAT


; --- ACTPGUP                   ----------------------------------------


; - ACTPGUP ----------------------------
; - SCROLL UP ONE PAGE (24 ROWS)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPGUP         CALL    CHKUNSEL
                LD      B, 200
                LD      C, CUP
                CALL    KEYRUN          ; QUEUED REPEATS: ONE REDRAW FOR THEM ALL
                INC     A
                LD      C, A            ; C = PAGES
                LD      B, 0            ; B = PAGES TURNED
.PAGE           LD      HL, (TOPLINE)
                LD      A, H
                OR      L
                JR      Z, .PGUTOP
                LD      DE, ROWSVIS
                OR      A
                SBC     HL, DE
                JR      NC, .PGUSET
                LD      HL, 0
.PGUSET         LD      (TOPLINE), HL
                LD      HL, (DOCLINE)
                OR      A
                SBC     HL, DE
                JR      NC, .PGUDOC
                LD      HL, 0
.PGUDOC         LD      (DOCLINE), HL
                INC     B
                DEC     C
                JR      NZ, .PAGE
                CALL    SETCURY
                CALL    EDCLMPX
                JP      REDRAW
.PGUTOP         XOR     A
                LD      (CURY), A
                LD      HL, 0
                LD      (DOCLINE), HL
                CALL    EDCLMPX
                LD      A, B
                OR      A
                RET     Z               ; ALREADY ON THE FIRST PAGE: CURSOR ONLY
                JP      REDRAW


; --- ACTPGDN                   ----------------------------------------


; - ACTPGDN ----------------------------
; - SCROLL DOWN ONE PAGE (24 ROWS)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPGDN         CALL    CHKUNSEL
                LD      B, 200
                LD      C, CDOWN
                CALL    KEYRUN          ; QUEUED REPEATS: ONE REDRAW FOR THEM ALL
                INC     A
                LD      C, A            ; C = PAGES
.PAGE           LD      HL, (TOPLINE)
                LD      DE, ROWSVIS
                ADD     HL, DE
                EX      DE, HL          ; DE = TARGET TOP
                LD      HL, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .PGDBOT
                JR      Z, .PGDBOT
                EX      DE, HL
                LD      (TOPLINE), HL
                LD      HL, (DOCLINE)
                LD      DE, ROWSVIS
                ADD     HL, DE
                LD      (DOCLINE), HL
                DEC     C
                JR      NZ, .PAGE
                ; THE CURSOR MAY HAVE PASSED THE LAST LINE WHILE THE TOP DID NOT
                LD      HL, (TOTLINES)
                DEC     HL
                LD      DE, (DOCLINE)
                CALL    CMPHLDE
                JR      NC, .PGDCUR
                LD      (DOCLINE), HL
.PGDCUR         CALL    SETCURY
                CALL    EDCLMPX
                JP      REDRAW
.PGDBOT         JP      ACTBOT


; --- ACTDELBK                  ----------------------------------------


; - ACTDELBK ---------------------------
; - DELETE CHARACTER BEFORE CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELBK        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTDLS
                CALL    EDDELBK
                JP      DRWSTAT


; --- ACTDELFW                  ----------------------------------------


; - ACTDELFW ---------------------------
; - DELETE CHARACTER AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELFW        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTDLS
                CALL    EDDELCHR
                JP      DRWSTAT


; --- ACTDELLN                  ----------------------------------------


; - ACTDELLN ---------------------------
; - DELETE ENTIRE CURRENT LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELLN        CALL    UNDOCLS
                LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                RET     Z
                LD      DE, 1
                CALL    CMPHLDE
                JR      NZ, .DLMULT
                ; SINGLE LINE LEFT: CLEAR RECORD TO SPACES
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                CALL    UNDOBGN
                LD      HL, WORKBUF
                CALL    RECBLNK
                LD      HL, (DOCLINE)
                CALL    LINEWRT
                CALL    UNDOCLS
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                XOR     A
                LD      (CURX), A
                LD      A, #FF
                LD      (MODIFIED), A
                RET
.DLMULT         LD      HL, (DOCLINE)
                CALL    LINEREAD
                CALL    UNDODEL
                LD      HL, (DOCLINE)
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      HL, (DOCLINE)
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .DLOK
                DEC     HL
                LD      (DOCLINE), HL
.DLOK           LD      HL, (DOCLINE)   ; DELETING THE LAST LINE FROM ROW 0
                CALL    SHOWLN          ; LEFT DOCLINE ABOVE TOPLINE: CURY #FF
                XOR     A
                LD      (CURX), A
                CALL    REDRAW
                LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- ACTNWLIN                  ----------------------------------------


; - ACTNWLIN ---------------------------
; - SPLIT LINE AND INSERT NEWLINE. WITH AUTOALIGN ACTIVE (CFG) AND THE
; - CURSOR AT OR PAST END OF LINE, THE CURSOR ON THE NEW LINE LANDS AT THE
; - COLUMN CALCALN DERIVES FROM THE LINE BEING SPLIT (THE MNEMONIC COLUMN IN
; - THE ASSEMBLY LAYOUT) INSTEAD OF COLUMN 0. MID-LINE ENTER, AN INACTIVE MODE
; - AND A REFUSED SPLIT ALL FALL BACK TO THE CLASSIC BEHAVIOR.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - THE ALIGN COLUMN IS A PROMISE OF INDENTATION, NOT INDENTATION: NOTHING IS
; - WRITTEN UNTIL SOMETHING IS TYPED THERE, AND WBINS THEN SETS THE LENGTH TO
; - COLUMN + 1 OVER THE SPACES THE RECORD IS BORN WITH. SO A LINE LEFT BLANK
; - MUST STAY GENUINELY BLANK.
; -
; - TWO RULES KEEP THAT TRUE, BOTH LEARNED FROM THE SAME MEASURED DEFECT --
; - ENTER TWICE USED TO LEAVE THE BLANK LINE HOLDING 13 SPACES:
; -   . THE CURSOR PARKED PAST THE END BY AN EARLIER AUTO-ALIGN STILL COUNTS
; -     AS END OF LINE, AND THE SPLIT IS TAKEN AT THE TRUE LENGTH. TAKING THE
; -     CLASSIC SPLIT AT THE PARKED COLUMN MADE SPLITLA'S .TRUNC STRETCH THE
; -     HEAD'S LENGTH OUT TO IT.
; -   . ON AN EMPTY LINE THE ALIGN COLUMN IS THE ONE THE CURSOR ALREADY SITS
; -     AT, NOT CALCALN'S ANSWER -- CALCALN REPORTS 0 FOR AN EMPTY LINE BY
; -     DESIGN, WHICH WOULD BREAK THE CHAIN ACROSS A BLANK SEPARATOR LINE.
; -

ACTNWLIN        LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDLS
                ; MODE CHECK: ALGN_ON ALWAYS, ALGN_DEV ONLY IN WRAP_DEV
                LD      A, (AUTOALGN)
                CP      ALGN_ON
                JR      Z, .ACTIVE
                CP      ALGN_DEV
                JR      NZ, .PLAIN
                LD      A, (WRAPMODE)
                OR      A               ; WRAP_DEV = 0
                JR      NZ, .PLAIN

.ACTIVE         ; LOAD THE LINE ABOUT TO BE SPLIT
                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; AUTO-ALIGN ONLY FROM END OF LINE: A MID-LINE ENTER IS A
                ; CLASSIC SPLIT, SO THE TAIL AT COLUMN 0 NEVER MEETS A
                ; CURSOR PARKED AT THE ALIGN COLUMN.
                LD      A, (CURX)
                LD      HL, WORKBUF
                CP      (HL)            ; CURX VS LINE LENGTH
                JR      C, .PLAIN       ; CURX < LENGTH: GENUINELY MID-LINE

                ; ALIGN COLUMN
                LD      A, (HL)         ; A = LINE LENGTH
                OR      A
                JR      Z, .KEEPCOL     ; EMPTY LINE: HOLD THE PARKED COLUMN
                CALL    CALCALN
                JR      .HAVECOL

.KEEPCOL        LD      A, (CURX)
.HAVECOL        LD      (ALGNTMP), A

                ; SPLIT AT THE TRUE END OF LINE, NEVER AT THE PARKED COLUMN.
                ; EDNWLIN REFUSES SILENTLY (DIRECTORY FULL OR NO MAPPER
                ; MEMORY), DETECTED THROUGH TOTLINES NOT MOVING.
                LD      A, (CURX)
                PUSH    AF              ; ENTRY COLUMN, PUT BACK IF REFUSED
                LD      A, (WORKBUF)
                LD      (CURX), A

                LD      HL, (TOTLINES)
                PUSH    HL
                CALL    EDNWLIN
                POP     HL
                LD      DE, (TOTLINES)
                OR      A
                SBC     HL, DE
                JR      Z, .REFUSED

                POP     AF              ; DROP THE ENTRY COLUMN
                LD      A, (ALGNTMP)
                LD      (CURX), A
                RET

.REFUSED        POP     AF              ; A = ENTRY COLUMN: LEAVE THE CURSOR
                LD      (CURX), A       ;   EXACTLY WHERE IT WAS
                RET

.PLAIN          JP      EDNWLIN


; --- ACTOPNBL                  ----------------------------------------


; - ACTOPNBL ---------------------------
; - OPEN NEW EMPTY LINE BELOW (VI LOWERCASE 'O')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPNBL        LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LINE LENGTH
                CP      MAXCOLS
                JR      C, .OPNNMC
                LD      A, MAXCOLS - 1
.OPNNMC         LD      (CURX), A
                CALL    EDNWLIN
                JP      ACTVIINS


; --- ACTOPNAB                  ----------------------------------------


; - ACTOPNAB ---------------------------
; - OPEN NEW EMPTY LINE ABOVE (VI O)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPNAB        CALL    ACTBOL
                CALL    EDNWLIN
                LD      A, CUP
                CALL    EDMOVROW
                JP      ACTVIINS


; --- ACTTGLIN                  ----------------------------------------


; - ACTTGLIN ---------------------------
; - TOGGLE INSERT / OVERWRITE MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTTGLIN        LD      A, (INSMODE)
                XOR     INS_MODE
                LD      (INSMODE), A
                JP      DRWSTAT


; --- ACTTGLWR                  ----------------------------------------


; - ACTTGLWR ---------------------------
; - TOGGLE DEVELOPER / TEXT WRAP MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLWR        CALL    EDTGLWRP
                JP      DRWSTAT


; --- ACTSAVE                   ----------------------------------------


; - ACTSAVE ----------------------------
; - SAVE DOCUMENT TO DISK
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSAVE         JP      FILESAVE


; --- ACTNEW                    ----------------------------------------


; - ACTNEW -----------------------------
; - START A NEW, EMPTY DOCUMENT (CTRL + N / FILE > NEW). A MODIFIED
; - DOCUMENT IS ONLY DISCARDED AFTER A YES IN DONEW (DEFAULT NO).
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTNEW          LD      A, (MODIFIED)
                OR      A
                JR      Z, .FRESH
                ; FTR-BUDGET: S6ED 9,744 B FREE, S2ED 4,374 B (2026-09-29)
                LD      A, (FTRSEG)
                LD      HL, DONEW
                CALL    FCALL
                LD      A, (WINRES)
                OR      A
                RET     Z               ; NO: KEEP THE DOCUMENT
.FRESH          LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                CALL    FILENEW
                XOR     A
                LD      (MODIFIED), A
                LD      (FILENAME), A
                LD      (STATMSG), A
                CALL    REDRAW
                CALL    DRWMENU
                JP      DRWSTAT


; --- ACTQUIT                   ----------------------------------------


; - ACTQUIT ----------------------------
; - EXIT EDITOR TO DOS, ASKING FOR CONFIRMATION FIRST (DOQIT DIALOG IN
; - FTRSEG). WITH AN ACTIVE SELECTION ESC JUST DROPS IT, AS BEFORE.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

                ; NO IFDEF HERE ANY MORE.  S2ED had a stub that went straight
                ; to TERM until DOQIT existed for it; both targets now open the
                ; same dialog through the same FCALL, so CORE stops forking.
ACTQUIT         LD      A, (SELACT)
                OR      A
                JR      Z, .ASKQ
                JP      ACTDSEL
.ASKQ           ; FTR-BUDGET: S6ED 11,501 B FREE, S2ED 1,688 B (2026-09-22)
                LD      A, (FTRSEG)
                LD      HL, DOQIT
                CALL    FCALL
                LD      A, (WINRES)
                OR      A
                RET     Z               ; CANCELLED: RESUME EDITING
                JP      TERM


; --- ACTHELP                   ----------------------------------------


; - ACTHELP ----------------------------
; - DISPLAY ABOUT DIALOG (F1)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTHELP         ; FTR-BUDGET: S6ED 11,501 B FREE, S2ED 1,688 B (2026-09-22)
                LD      A, (FTRSEG)
                LD      HL, DOABT
                JP      FCALL


; --- ACTGOTO                   ----------------------------------------


; - ACTGOTO ----------------------------
; - GO TO LINE (CTRL + G / EDIT MENU). THE DIALOG COLLECTS A NUMBER IN THE
; - FEATURE SEGMENT; THE JUMP ITSELF HAPPENS HERE, IN PAGE 1, BECAUSE
; - GOTOLN WRITES TOPLINE AND CALLS REDRAW AND THOSE NEED THE TEXT
; - SEGMENTS AT PAGE 2, NOT FTRSEG.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTGOTO         CALL    CHKUNSEL
                ; FTR-BUDGET: S6ED 11,501 B FREE, S2ED 1,688 B (2026-09-22)
                LD      A, (FTRSEG)
                LD      HL, DOGOTO
                CALL    FCALL
                RET     C               ; CANCELLED: RESUME EDITING
                CALL    GOTOLN
                CALL    REDRAW
                JP      DRWSTAT


; --- ACTFIND                   ----------------------------------------


; - ACTFIND ----------------------------
; - FIND & REPLACE (CTRL + F / EDIT MENU ITEM 9).
; - OPENS MODAL DIALOG IN FTRSEG VIA DOFIND, THEN DISPATCHES
; - THE REQUESTED ACTION (FIND NEXT, REPLACE, REPLACE ALL) IN PAGE 1.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTFIND         ; FTR-BUDGET: S6ED 10,846 B FREE, S2ED 5,312 B (2026-09-23)
                LD      A, (FTRSEG)
                LD      HL, DOFIND
                CALL    FCALL
                RET     C               ; CANCELLED: RESUME EDITING

                ; A = ACTION (SRCH_FND, SRCH_RPL, SRCH_ALL)
                OR      A
                JR      Z, ACTFNXT
                DEC     A
                JR      Z, .REPL
                CALL    DORPLAL
                RET

.REPL           CALL    DOREPL
                CALL    REDRAW
                JP      DRWSTAT


; --- ACTFNXT                   ----------------------------------------


; - ACTFNXT ----------------------------
; - FIND NEXT OCCURRENCE OF SEARCH PATTERN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTFNXT         LD      A, (SRCHLEN)
                OR      A
                JR      Z, ACTFIND      ; NO PATTERN YET: OPEN DIALOG
                CALL    SRCHFWD
                JR      C, .NOTFND
                RET                     ; SRCHFWD REPAINTS AND KEEPS THE MATCH SELECTED

.NOTFND         LD      E, BEL
                LD      C, _CONOUT
                JP      BDOS


; --- ACTFPRV                   ----------------------------------------


; - ACTFPRV ----------------------------
; - FIND PREVIOUS OCCURRENCE OF SEARCH PATTERN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTFPRV         LD      A, (SRCHLEN)
                OR      A
                JR      Z, ACTFIND      ; NO PATTERN YET: OPEN DIALOG
                CALL    SRCHBWD
                JR      C, .NOTFND
                RET                     ; SRCHBWD REPAINTS AND KEEPS THE MATCH SELECTED

.NOTFND         LD      E, BEL
                LD      C, _CONOUT
                JP      BDOS


; --- ACTEXMOD                  ----------------------------------------


; - ACTEXMOD ---------------------------
; - VI EX COMMAND CONSOLE (':')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTEXMOD        CALL    CHKUNSEL        ; CANCEL SELECTION IF ACTIVE

                ; ERASE DOCUMENT CURSOR IF VISIBLE
                LD      A, (BLNKPH)
                OR      A
                JR      Z, .INITEX
                CALL    DRWCUR
                XOR     A
                LD      (BLNKPH), A

.INITEX         ; INITIALISE STATMSG WITH ':'
                LD      HL, STATMSG
                LD      (HL), ':'
                INC     HL
                LD      (HL), 0
                CALL    DRWSTAT
                LD      A, 1
                LD      (INPLEN), A     ; (INPLEN) = CURRENT LENGTH IN STATMSG

.EXKLP          CALL    WINPOLL
                JR      Z, .EXKLP

                ; A = KEY CODE
                CP      ESC
                JR      Z, .EXESC
                CP      BS
                JR      Z, .EXBS
                CP      DEL
                JR      Z, .EXBS
                CP      CR
                JR      Z, .EXCR

                ; PRINTABLE CHARACTERS: ' ' (32) TO '~' (126)
                CP      ' '
                JR      C, .EXKLP
                CP      127
                JR      NC, .EXKLP

                ; LIMIT COMMAND LENGTH TO 26 CHARACTERS
                LD      C, A
                LD      A, (INPLEN)
                CP      26
                JR      NC, .EXKLP

                ; APPEND TO STATMSG
                LD      E, A
                LD      D, 0
                LD      HL, STATMSG
                ADD     HL, DE
                LD      (HL), C
                INC     HL
                LD      (HL), 0
                LD      A, (INPLEN)
                INC     A
                LD      (INPLEN), A
                CALL    DRWSTAT
                JR      .EXKLP

.EXBS           ; BACKSPACE: IF ONLY ':' (INPLEN == 1), CANCEL TO NORMAL MODE
                LD      A, (INPLEN)
                DEC     A
                JR      Z, .EXESC
                LD      (INPLEN), A
                LD      E, A
                LD      D, 0
                LD      HL, STATMSG
                ADD     HL, DE
                LD      (HL), 0
                CALL    DRWSTAT
                JR      .EXKLP

.EXESC          ; CANCEL AND RETURN TO NORMAL MODE
                XOR     A
                LD      (STATMSG), A
                JP      DRWSTAT

.EXCR           ; EXECUTE COMMAND IN STATMSG+1
                LD      HL, STATMSG + 1

                ; SKIP LEADING SPACES
.SKPSP          LD      A, (HL)
                CP      ' '
                JR      NZ, .CMDSTRT
                INC     HL
                JR      .SKPSP

.CMDSTRT        LD      A, (HL)
                OR      A
                JR      Z, .EXESC       ; EMPTY COMMAND -> CANCEL

                ; 1. CHECK IF NUMBER (DIGIT '0'..'9')
                SUB     '0'
                JR      C, .NOTNUM
                CP      10
                JR      C, .DONUM

.NOTNUM         ; 2. CHECK LETTER COMMANDS
                LD      A, (HL)
                CP      'w'
                JP      Z, .CMDW
                CP      'W'
                JP      Z, .CMDW
                CP      'q'
                JP      Z, .CMDQ
                CP      'Q'
                JP      Z, .CMDQ
                CP      'x'
                JP      Z, .CMDX
                CP      'X'
                JP      Z, .CMDX
                CP      'e'
                JP      Z, .CMDE
                CP      'E'
                JP      Z, .CMDE
                CP      's'
                JP      Z, .CMDSET
                CP      'S'
                JP      Z, .CMDSET

                ; UNKNOWN COMMAND
.BADCMD         LD      HL, .STRERRC
                CALL    .SETMSG
                JP      DRWSTAT

.DONUM          CALL    ATOI16          ; HL = TARGET LINE (1-BASED), SATURATED:
                                        ; THE OWN PARSER WRAPPED (:65537 -> LINE 1)
                XOR     A
                LD      (STATMSG), A
                CALL    GOTOLN
                CALL    REDRAW
                JP      DRWSTAT

.CMDW           INC     HL
                LD      A, (HL)
                CP      'q'
                JR      Z, .CMDWQ
                CP      'Q'
                JR      Z, .CMDWQ
                CP      ' '
                JR      Z, .WNAME
                OR      A
                JR      NZ, .BADCMD

                ; :w (SAVE CURRENT FILE)
.WSAVE          LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                JP      Z, .ERNOF
                CALL    FILESAVE
                RET

.WNAME          ; :w <NAME>
                INC     HL
                LD      A, (HL)
                CP      ' '
                JR      Z, .WNAME
                OR      A
                JR      Z, .WSAVE
                CALL    .CPYFNAM
                CALL    DRWMENU
                JR      .WSAVE

.CMDWQ          INC     HL
                LD      A, (HL)
                OR      A
                JR      Z, .WQDO
                CP      ' '
                JP      NZ, .BADCMD
.WQDO           LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                JP      Z, .ERNOF
                CALL    FILESAVE
                RET     C               ; NOT SAVED: STAY, THE STATUS BAR SAYS WHY
                JP      TERM

.CMDX           INC     HL
                LD      A, (HL)
                OR      A
                JR      Z, .WQDO
                CP      ' '
                JP      NZ, .BADCMD
                JR      .WQDO

.CMDQ           INC     HL
                LD      A, (HL)
                CP      '!'
                JR      Z, .QFORCE
                OR      A
                JR      Z, .QCHECK
                CP      ' '
                JP      NZ, .BADCMD
.QCHECK         LD      A, (MODIFIED)
                OR      A
                JP      NZ, .ERMOD
                JP      TERM
.QFORCE         JP      TERM

.CMDE           INC     HL
                LD      A, (HL)
                CP      '!'
                JR      Z, .EFORCE
                CP      ' '
                JR      Z, .ECHECK
                OR      A
                JP      Z, ACTOPEN      ; :e ALONE: THE FILE BROWSER
                JP      .BADCMD

.ECHECK         ; CHECK MODIFIED BEFORE LOADING
                LD      A, (MODIFIED)
                OR      A
                JP      NZ, .ERMOD
.ESKP1          INC     HL
                LD      A, (HL)
                CP      ' '
                JR      Z, .ESKP1
                OR      A
                JP      Z, .ERARG
                JR      .EARG

.EFORCE         INC     HL
.ESKP2          LD      A, (HL)
                CP      ' '
                JR      NZ, .EFDO
                INC     HL
                JR      .ESKP2
.EFDO           LD      A, (HL)
                OR      A
                JR      NZ, .EARG
                LD      HL, FILENAME    ; :e! ALONE: RELOAD THE CURRENT FILE
                LD      A, (HL)
                OR      A
                JP      Z, .ERNOF
                JR      .EOPEN

.EARG           ; THE NAME GOES TO LINBUF, NOT FILENAME: FILELOAD HANDS IT
                ; TO FILENAME ONLY IF THE LOAD SUCCEEDS, SO A FAILED :e
                ; LEAVES THE DOCUMENT UNDER ITS OWN NAME. LINBUF IS THE CFG
                ; LINE BUFFER, IDLE ONCE INIT HAS APPLIED THE CFG.
                LD      DE, LINBUF
                CALL    .CPYFN
                LD      HL, LINBUF

.EOPEN          JP      OPENDOC

.CMDSET         ; MUST MATCH "set " OR "SET "
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'e'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      't'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                CP      ' '
                JP      NZ, .BADCMD

.SETSKP         INC     HL
                LD      A, (HL)
                CP      ' '
                JR      Z, .SETSKP
                OR      A
                JP      Z, .BADCMD

                ; FIRST CHAR OF SETTING: 'w' (wrap), 'n' (nowrap), 't' (tw/textwidth)
                OR      #20
                CP      'w'
                JR      Z, .SETWRP
                CP      'n'
                JR      Z, .SETNOW
                CP      't'
                JP      Z, .SETTW
                JP      .BADCMD

.SETWRP         ; EXPECT "wrap"
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'r'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'a'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'p'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                CP      ' '
                JR      Z, .WPOK
                OR      A
                JP      NZ, .BADCMD
.WPOK           LD      A, WRAP_TXT
                LD      (WRAPMODE), A
                LD      A, (TXTWIDTH)
                OR      A
                JP      NZ, .SETOUT
                LD      A, (SAVETW)
                OR      A
                JR      NZ, .WPHSTW
                LD      A, TEXTCOLS
.WPHSTW         LD      (TXTWIDTH), A
                JP      .SETOUT

.SETNOW         ; EXPECT "nowrap"
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'o'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'w'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'r'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'a'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'p'
                JP      NZ, .BADCMD
                INC     HL
                LD      A, (HL)
                CP      ' '
                JR      Z, .NWPOK
                OR      A
                JP      NZ, .BADCMD
.NWPOK          LD      A, (TXTWIDTH)
                OR      A
                JR      Z, .NWPSAV
                LD      (SAVETW), A
.NWPSAV         XOR     A
                LD      (TXTWIDTH), A
                LD      (WRAPMODE), A
                JP      .SETOUT

.SETTW          ; EXPECT "tw=" OR "textwidth="
                INC     HL
                LD      A, (HL)
                OR      #20
                CP      'w'
                JR      Z, .CKTW
                CP      'e'
                JR      Z, .CKTXTW
                JP      .BADCMD

.CKTW           INC     HL
                JR      .TWEQLP

.CKTXTW         LD      DE, .STRTXTW    ; "xtwidth"
.TWMLP          LD      A, (DE)
                OR      A
                JR      Z, .TWEQLP
                INC     HL
                LD      C, A
                LD      A, (HL)
                OR      #20
                CP      C
                JP      NZ, .BADCMD
                INC     DE
                JR      .TWMLP

.TWEQLP         LD      A, (HL)
                CP      ' '
                JR      NZ, .TWEQCK
                INC     HL
                JR      .TWEQLP
.TWEQCK         CP      '='
                JP      NZ, .BADCMD
                INC     HL              ; PAST '='

.PARSTW         LD      A, (HL)
                CP      ' '
                JR      NZ, .PSTWVAL
                INC     HL
                JR      .PARSTW

.PSTWVAL        LD      A, (HL)
                SUB     '0'
                JP      C, .BADCMD
                CP      10
                JP      NC, .BADCMD
                CALL    ATOI16
                LD      A, H
                OR      A
                JR      Z, .TW8OK
                LD      L, 255
.TW8OK          LD      A, L
                LD      (TXTWIDTH), A
                OR      A
                JR      Z, .TWEXZ
                LD      (SAVETW), A
                LD      A, WRAP_TXT
                LD      (WRAPMODE), A
                JR      .SETOUT
.TWEXZ          LD      A, WRAP_DEV
                LD      (WRAPMODE), A

.SETOUT         XOR     A
                LD      (STATMSG), A
                CALL    REDRAW
                JP      DRWSTAT

.ERNOF          LD      HL, .STRNOF
                CALL    .SETMSG
                JP      DRWSTAT

.ERMOD          LD      HL, .STRMOD
                CALL    .SETMSG
                JP      DRWSTAT

.ERARG          LD      HL, .STRARG
                CALL    .SETMSG
                JP      DRWSTAT

.SETMSG         LD      DE, STATMSG
.SETMLP         LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                JR      .SETMLP

.CPYFNAM        LD      DE, FILENAME
.CPYFN          LD      B, FNAMLEN - 1
.CPYFLP         LD      A, (HL)
                OR      A
                JR      Z, .CPYFDN
                CP      ' '
                JR      Z, .CPYFDN
                CP      'a'
                JR      C, .NOUP
                CP      'z' + 1
                JR      NC, .NOUP
                SUB     32
.NOUP           LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .CPYFLP
.CPYFDN         XOR     A
                LD      (DE), A
                RET

.STRERRC        DEFM    "Not an editor command", 0
.STRNOF         DEFM    "No file name", 0
.STRMOD         DEFM    "No write since last change (! overrides)", 0
.STRARG         DEFM    "Argument required", 0
.STRTXTW        DEFM    "xtwidth", 0


; --- OPENDOC / ACTOPEN          ----------------------------------------


; - OPENDOC ----------------------------
; - LOAD A DOCUMENT BY NAME AND REPAINT: THE COMMON TAIL OF :e AND OF
; - FILE > OPEN. THE CALLER HAS ALREADY DEALT WITH A MODIFIED DOCUMENT.
; - IN:  HL = ASCIIZ NAME (NOT FILENAME ITSELF: FILELOAD COMMITS IT)
; - OUT: NONE. A MISSING FILE OPENS AN EMPTY DOCUMENT UNDER THAT NAME, AS
; -      VI DOES; ANY OTHER FAILURE KEEPS THE DOCUMENT AND SAYS SO.
; - CLOBBERS: ALL
; -

OPENDOC         PUSH    HL
                LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                XOR     A
                LD      (STATMSG), A
                POP     HL
                PUSH    HL
                CALL    FILELOAD
                POP     HL
                JR      NC, .EDRAW
                LD      B, A
                LD      A, (LOADERR)
                OR      A
                JR      NZ, .EDRAW      ; TOO LARGE: THE STATUS BAR SAYS SO
                LD      A, B
                CP      ENOFIL
                JR      NZ, .ECANT
                ; NOT FOUND: A NEW, EMPTY DOCUMENT UNDER THAT NAME, AS IN VI.
                ; :e WITHOUT ! ALREADY REFUSED A MODIFIED DOCUMENT.
                PUSH    HL
                CALL    FILENEW
                POP     HL
                CALL    FNAMSET
                XOR     A
                LD      (MODIFIED), A
                LD      HL, .STRNEWF
                JR      .EMSG
.ECANT          LD      HL, .STRCANT
.EMSG           CALL    ACTEXMOD.SETMSG
.EDRAW          CALL    REDRAW
                CALL    DRWMENU
                JP      DRWSTAT

.STRNEWF        DEFM    "[NEW FILE]", 0
.STRCANT        DEFM    "[CANNOT OPEN]", 0


; - ACTOPEN ----------------------------
; - FILE > OPEN (CTRL + O, VI :e WITH NO NAME): THE FILE BROWSER. A
; - MODIFIED DOCUMENT IS ONLY GIVEN UP AFTER A YES, BEFORE THE BROWSER
; - OPENS -- MODALS ARE SEQUENTIAL, NEVER NESTED.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPEN         LD      A, (MODIFIED)
                OR      A
                JR      Z, .BROWSE
                ; FTR-BUDGET: S6ED 9,711 B FREE, S2ED 4,341 B (2026-09-29)
                LD      A, (FTRSEG)
                LD      HL, DOOPN
                CALL    FCALL
                LD      A, (WINRES)
                OR      A
                RET     Z               ; NO: KEEP THE DOCUMENT
.BROWSE         XOR     A
                LD      (BRWMODE), A    ; BRW_OPEN
                ; FTR-BUDGET: S6ED 9,711 B FREE, S2ED 4,341 B (2026-09-29)
                LD      A, (FTRSEG)
                LD      HL, DOBRW
                CALL    FCALL
                JR      NC, .OK
                CALL    REDRAW
                CALL    DRWMENU
                LD      A, #FF
                LD      (STATPRV), A
                CALL    DRWSTAT
                RET
.OK             IFDEF   S2ED
                CALL    REDRAW          ; S2ED CLOSES THE BROWSER WITHOUT A
                                        ; BACKGROUND SAVE (WINNOSV): REPAINT
                                        ; BEFORE THE LOAD, OR THE WINDOW STAYS
                                        ; UP UNDER THE PROGRESS BAR
                ENDIF
                LD      HL, BRWOUT
                JP      OPENDOC


; --- ACTSAVAS                  ----------------------------------------


; - ACTSAVAS ---------------------------
; - FILE > SAVE AS (CTRL + SHIFT + S, VI :w WITH NO NAME): THE FILE BROWSER.
; - ASKS OVERWRITE CONFIRMATION IF THE FILE EXISTS; REOPENS BROWSER ON NO.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSAVAS        LD      A, BRW_SAVE
                LD      (BRWMODE), A
                ; FTR-BUDGET: S6ED 3,447 B FREE, S2ED 1,251 B (2026-10-02)
                LD      A, (FTRSEG)
                LD      HL, DOBRW
                CALL    FCALL
                JR      NC, .CHECK
.CANCEL         CALL    REDRAW
                CALL    DRWMENU
                LD      A, #FF
                LD      (STATPRV), A
                CALL    DRWSTAT
                RET

.REOPEN         ; REOPEN BROWSER AFTER "NO" TO OVERWRITE
                ; FTR-BUDGET: S6ED 3,447 B FREE, S2ED 1,251 B (2026-10-02)
                LD      A, (FTRSEG)
                LD      HL, DOBRWR
                CALL    FCALL
                JR      C, .CANCEL

.CHECK          ; DOES BRWOUT ALREADY EXIST?
                LD      DE, BRWOUT
                LD      B, ATR_ALL
                LD      IX, BRWFIB
                LD      C, _FFIRST
                CALL    BDOS
                JR      C, .SAVEIT      ; DOES NOT EXIST: SAVE DIRECTLY

                ; FILE EXISTS: ASK CONFIRMATION
                ; FTR-BUDGET: S6ED 3,447 B FREE, S2ED 1,251 B (2026-10-02)
                LD      A, (FTRSEG)
                LD      HL, DOOVR
                CALL    FCALL
                LD      A, (WINRES)
                OR      A
                JR      Z, .REOPEN      ; NO: REOPEN BROWSER

.SAVEIT         LD      HL, BRWOUT
                CALL    FNAMSET
                CALL    REDRAW
                CALL    DRWMENU
                JP      FILESAVE


; --- GOTOLN                    ----------------------------------------


; - GOTOLN -----------------------------
; - PLACE THE DOCUMENT AND THE VIEWPORT ON A LINE
; - IN:  HL = TARGET LINE, 1-BASED, UNCLAMPED
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - THE VIEWPORT IS BOUNDED BY ROWSVIS -- THE TEXT BAND -- AND CENTRED ON
; - ROWSVIS / 2. NEITHER MAY BE A LITERAL: THE BAND IS 24 ROWS ON S6ED AND
; - 22 ON S2ED, WHOSE SCRROWS IS STILL 24, SO A NUMBER WRITTEN HERE IS
; - WRONG ON ONE TARGET AND SCRROWS IS WRONG ON THE OTHER.
; -

GOTOLN          ; CLAMP INTO [1, TOTLINES]
                LD      A, H
                OR      L
                JR      NZ, .NOTZERO
                INC     HL              ; 0 -> 1
.NOTZERO        LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .INRANGE
                JR      Z, .INRANGE
                EX      DE, HL          ; PAST THE END: THE LAST LINE
.INRANGE        DEC     HL              ; 1-BASED -> DOCLINE
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                ; FALLS THROUGH INTO SHOWLN WITH HL = DOCLINE


; - SHOWLN -----------------------------
; - MAKE A DOCUMENT LINE VISIBLE: LEAVE THE VIEWPORT ALONE WHEN IT ALREADY
; - SHOWS THE LINE, OTHERWISE CENTRE ON IT, CLAMPED TO THE LAST FULL PAGE;
; - THEN SET CURY. SAME ROWSVIS RULE AS GOTOLN ABOVE.
; - IN:  HL = LINE, WHICH MUST BE DOCLINE (CURY IS DERIVED FROM IT)
; - OUT: TOPLINE, CURY
; - CLOBBERS: AF, DE, HL
; -

SHOWLN          ; ALREADY ON SCREEN? TOPLINE <= DOCLINE < TOPLINE + ROWSVIS
                LD      DE, (TOPLINE)
                CALL    CMPHLDE
                JR      C, .CENTRE      ; ABOVE THE VIEWPORT
                PUSH    HL
                LD      HL, (TOPLINE)
                LD      DE, ROWSVIS
                ADD     HL, DE
                EX      DE, HL          ; DE = TOPLINE + ROWSVIS
                POP     HL
                CALL    CMPHLDE
                JP      C, SETCURY      ; VISIBLE: DO NOT MOVE THE VIEWPORT

.CENTRE         ; TOPLINE = DOCLINE - ROWSVIS / 2, CLAMPED
                LD      DE, ROWSVIS / 2
                CALL    CMPHLDE
                JR      C, .ATTOP
                OR      A
                SBC     HL, DE          ; HL = DOCLINE - ROWSVIS / 2
                ; CLAMP AGAINST THE LAST FULL PAGE
                PUSH    HL
                LD      HL, (TOTLINES)
                LD      DE, ROWSVIS
                OR      A
                SBC     HL, DE          ; HL = TOTLINES - ROWSVIS
                JR      NC, .HAVEMAX
                LD      HL, 0           ; DOCUMENT SHORTER THAN THE BAND
.HAVEMAX        POP     DE              ; DE = WANTED TOPLINE
                CALL    CMPHLDE         ; MAX VS WANTED
                JR      C, .SETTOP      ; MAX < WANTED: USE MAX (IN HL)
                EX      DE, HL          ; WANTED FITS
.SETTOP         LD      (TOPLINE), HL
                JP      SETCURY

.ATTOP          LD      HL, 0
                LD      (TOPLINE), HL
                JP      SETCURY


; --- ACTCYCKM                  ----------------------------------------


; - ACTCYCKM ---------------------------
; - CYCLE ACTIVE KEYMAP PROFILE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTCYCKM        JP      KMAPCYC


; --- ACTVIINS                  ----------------------------------------


; - ACTVIINS ---------------------------
; - SWITCH VI TO INSERT MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIINS        LD      A, VIMINS
                LD      (VIMODE), A
                LD      HL, KMAPVII
                LD      (KMAPPTR), HL
                JP      DRWSTAT


; --- ACTVIAPP                  ----------------------------------------


; - ACTVIAPP ---------------------------
; - ADVANCE AND SWITCH VI TO INSERT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIAPP        LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LINE LENGTH (0..MAXCOLS)
                LD      B, A
                LD      A, (CURX)
                CP      B
                JR      NC, .APPOK      ; AT OR PAST END (E.G. EMPTY LINE)
                INC     A
                CP      MAXCOLS
                JR      C, .APPNMC
                LD      A, MAXCOLS - 1
.APPNMC         LD      (CURX), A
.APPOK          JP      ACTVIINS


; --- ACTVINRM                  ----------------------------------------


; - ACTVINRM ---------------------------
; - SWITCH VI TO NORMAL MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVINRM        LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                LD      A, (VIMODE)
                CP      VIMNORM
                JR      Z, .VINORM0     ; ALREADY NORMAL/VISUAL: DO NOT DEC CURX
                LD      A, VIMNORM
                LD      (VIMODE), A
                LD      A, (CURX)
                OR      A
                JR      Z, .VINORM0
                DEC     A
                LD      (CURX), A
.VINORM0        LD      HL, KMAPVIN
                LD      (KMAPPTR), HL
                CALL    DRWSTAT
                RET


; --- ACTVILED                  ----------------------------------------


; - ACTVILED ---------------------------
; - SET VI DELETE LEADER PENDING
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTVILED        LD      A, 'd'
                LD      (VILEAD), A
                RET


; --- ACTVIAPE                  ----------------------------------------


; - ACTVIAPE ---------------------------
; - APPEND AT END OF LINE (VI 'A')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIAPE        LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LINE LENGTH (0..MAXCOLS)
                CP      MAXCOLS
                JR      C, .APENMC
                LD      A, MAXCOLS - 1
.APENMC         LD      (CURX), A
                JP      ACTVIINS


; --- ACTVIINB                  ----------------------------------------


; - ACTVIINB ---------------------------
; - INSERT AT START OF LINE (VI 'I')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIINB        CALL    ACTBOL
                JP      ACTVIINS


; --- ACTVILEG                  ----------------------------------------


; - ACTVILEG ---------------------------
; - SET VI 'g' LEADER PENDING
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTVILEG        LD      A, 'g'
                LD      (VILEAD), A
                RET


; --- ACTVIKIL                  ----------------------------------------


; - ACTVIKIL ---------------------------
; - DELETE TO END OF LINE (VI 'D')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIKIL        CALL    EDKILCHR
                JP      DRWSTAT


; --- ACTVIVIS                  ----------------------------------------


; - ACTVIVIS ---------------------------
; - ENTER CHARACTER VISUAL MODE (VI 'v')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIVIS        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTVINRM
                LD      HL, KMAPVIV
                LD      (KMAPPTR), HL
                CALL    SELBEG
                CALL    SELPOST
                JP      DRWSTAT


; --- ACTVILIN                  ----------------------------------------


; - ACTVILIN ---------------------------
; - ENTER LINE VISUAL MODE (VI 'V')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVILIN        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTVINRM
                LD      HL, KMAPVIV
                LD      (KMAPPTR), HL
                CALL    ACTBOL
                CALL    SELBEG
                CALL    ACTEOL
                CALL    SELPOST
                JP      DRWSTAT


; --- ACTVICPY                  ----------------------------------------


; - ACTVICPY ---------------------------
; - YANK VISUAL SELECTION AND RETURN TO NORMAL MODE (VI 'y')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVICPY        CALL    ACTCOPY
                JP      ACTVINRM


; --- ACTVICUT                  ----------------------------------------


; - ACTVICUT ---------------------------
; - CUT VISUAL SELECTION AND RETURN TO NORMAL MODE (VI 'd'/'x')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVICUT        CALL    ACTCUT
                JP      ACTVINRM


; --- SELBEG                    ----------------------------------------


; - SELBEG -----------------------------
; - INITIALIZE SELECTION ANCHOR IF INACTIVE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

SELBEG          LD      A, (SELACT)
                OR      A
                RET     NZ              ; ALREADY ACTIVE
                LD      A, 1
                LD      (SELACT), A
                LD      A, (CURX)
                LD      (SELANCX), A
                LD      HL, (DOCLINE)
                LD      (SELANCL), HL
                RET


; --- SELPRE                    ----------------------------------------


; - SELPRE -----------------------------
; - UN-XOR CURRENTLY PAINTED SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPRE          LD      A, (SELDRAWN)
                OR      A
                RET     Z
                LD      HL, DRWSTRL
                LD      DE, SELSTRL
                LD      BC, 6
                LDIR
                CALL    SELPAIN         ; UN-XOR INVERT
                XOR     A
                LD      (SELDRAWN), A
                RET


; --- SELPOST                   ----------------------------------------


; - SELPOST ----------------------------
; - NORMALIZE AND XOR-PAINT NEW SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPOST         CALL    SELNORM
                LD      A, (SELDRAWN)
                OR      A
                JR      NZ, .UPDATE

                ; NOTHING PAINTED: PAINT THE NEW RANGE, IF IT IS NOT EMPTY
                CALL    SELEMPTY
                RET     Z
                CALL    SELPAIN
                JR      .RECORD

.UPDATE         ; SOMETHING PAINTED, AND STILL ON SCREEN: PAINT THE DIFFERENCE
                CALL    SELDIFF

.RECORD         LD      HL, SELSTRL
                LD      DE, DRWSTRL
                LD      BC, 6
                LDIR
                CALL    SELEMPTY
                LD      A, 1
                JR      NZ, .SETDRW
                XOR     A
.SETDRW         LD      (SELDRAWN), A
                JP      DRWSTAT


; - SELEMPTY ---------------------------
; - IS THE NORMALIZED SELECTION EMPTY (START == END)?
; - IN:  SELSTRL, SELSTRX, SELENDL, SELENDX
; - OUT: Z = EMPTY
; - CLOBBERS: AF, DE, HL
; -

SELEMPTY        LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                RET     NZ
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET


; --- SELNORM                   ----------------------------------------


; - SELNORM ----------------------------
; - NORMALIZE ANCHOR AND CURSOR TO START/END
; - IN:  NONE
; - OUT: SELSTRL, SELSTRX, SELENDL, SELENDX
; - CLOBBERS: AF, DE, HL
; -

SELNORM         LD      HL, (DOCLINE)
                LD      DE, (SELANCL)
                CALL    CMPHLDE
                JR      C, .NCURFST     ; DOCLINE < SELANCL
                JR      NZ, .NANCFST    ; DOCLINE > SELANCL
                LD      A, (CURX)
                LD      HL, SELANCX
                CP      (HL)
                JR      C, .NCURFST
.NANCFST        LD      HL, (SELANCL)
                LD      (SELSTRL), HL
                LD      A, (SELANCX)
                LD      (SELSTRX), A
                LD      HL, (DOCLINE)
                LD      (SELENDL), HL
                LD      A, (CURX)
                LD      (SELENDX), A
                JR      .CHKVI

.NCURFST        LD      HL, (DOCLINE)
                LD      (SELSTRL), HL
                LD      A, (CURX)
                LD      (SELSTRX), A
                LD      HL, (SELANCL)
                LD      (SELENDL), HL
                LD      A, (SELANCX)
                LD      (SELENDX), A

.CHKVI          LD      HL, (KMAPPTR)
                LD      DE, KMAPVIV
                CALL    CMPHLDE
                RET     NZ
                ; IN VI VISUAL MODE, SELECTION IS INCLUSIVE:
                ; INCLUDE THE FINAL CHARACTER IN THE RANGE
                LD      A, (SELENDX)
                CP      MAXCOLS
                RET     NC
                INC     A
                LD      (SELENDX), A
                RET


; - WBDELN -----------------------------
; - DELETE COLUMNS B..C-1 OF THE RECORD IN WORKBUF: TEXT AND ATTRIBUTES
; - SHIFTED LEFT, THE VACATED TAIL BLANKED, THE LENGTH FIXED
; - IN:  B = FIRST COLUMN, C = ONE PAST THE LAST (C > B)
; - OUT: WORKBUF; DWK = C - B
; - CLOBBERS: AF, BC, DE, HL
; -
; - ACTDWLFT (DELETE WORD LEFT) AND ACTDLS (A ONE-LINE SELECTION) CARRIED
; - TWO COPIES OF THIS.
; -

WBDELN          LD      A, C
                SUB     B
                LD      (DWK), A
                PUSH    BC
                LD      HL, WORKBUF + 1
                CALL    .SHIFT          ; THE TEXT
                POP     BC
                PUSH    BC
                LD      HL, WORKBUF + 1 + WORKATTR
                CALL    .SHIFT          ; THE ATTRIBUTES

                LD      A, (DWK)        ; BLANK THE LAST K COLUMNS OF BOTH
                LD      C, A
                LD      A, MAXCOLS
                SUB     C
                LD      E, A
                LD      D, 0            ; DE = MAXCOLS - K
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      B, C
.BLKTXT         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      B, C
.BLKATR         LD      (HL), 0
                INC     HL
                DJNZ    .BLKATR

                POP     BC              ; B = FIRST, C = ONE PAST THE LAST
                LD      HL, WORKBUF
                LD      A, (HL)         ; A = LENGTH
                CP      B
                RET     C
                RET     Z               ; ENDS BEFORE THE RANGE: UNCHANGED
                CP      C
                JR      C, .TOFIRST
                JR      Z, .TOFIRST     ; ENDS INSIDE IT: CUT AT THE FIRST
                SUB     C
                ADD     A, B            ; ENDS PAST IT: LENGTH - K
                LD      (HL), A
                RET
.TOFIRST        LD      (HL), B
                RET

                ; MOVE HL + C .. HL + MAXCOLS - 1 DOWN TO HL + B
.SHIFT          LD      E, B
                LD      D, 0
                PUSH    HL
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                POP     HL
                PUSH    BC
                LD      B, 0
                ADD     HL, BC          ; HL = SOURCE
                POP     BC
                LD      A, MAXCOLS
                SUB     C
                RET     Z
                LD      C, A
                LD      B, 0
                LDIR
                RET


; - LNEXT ------------------------------
; - THE COLUMNS OF ONE LINE A SELECTION COVERS
; - IN:  HL = LINE, WORKBUF = ITS RECORD, SELSTRL..SELENDX NORMALIZED
; - OUT: D = XA, E = XB (CLAMPED TO THE LENGTH), CY = 1 IF XA >= XB
; - CLOBBERS: AF, BC, DE
; -
; - ACTCOPY AND APPLSEL CARRIED TWO COPIES OF THIS.
; -

LNEXT           LD      C, 0            ; XA: 0 ON EVERY LINE BUT THE FIRST
                LD      DE, (SELSTRL)
                CALL    CMPHLDE
                JR      NZ, .MID
                LD      A, (SELSTRX)
                LD      C, A
.MID            LD      A, (WORKBUF)
                LD      B, A            ; XB: THE LENGTH, BUT ON THE LAST LINE
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .HAVEB
                LD      A, (SELENDX)    ; ITS END, CLAMPED TO THE LENGTH
                CP      B
                JR      NC, .HAVEB
                LD      B, A
.HAVEB          LD      D, C
                LD      E, B
                LD      A, C
                CP      B               ; CY: XA < XB
                CCF
                RET


; - SELEOL -----------------------------
; - A SELECTION THAT ENDS PAST THE LAST CHARACTER OF ITS END LINE COVERS
; - THE LINE BREAK: MAKE IT END AT COLUMN 0 OF THE NEXT LINE INSTEAD, WHICH
; - COPY AND DELETE ALREADY HANDLE (A CR LF COPIED, THE LINES JOINED).
; - IT PAINTED THE BREAK AS SELECTED AND THEN LEFT IT OUT. ONLY VI VISUAL
; - GETS PAST THE END (SELECTION INCLUSIVE, $ ONTO THE BREAK): SHIFT+END
; - ENDS AT THE LENGTH. NOTHING CHANGES ON THE LAST LINE.
; - IN:  SELSTRL..SELENDX NORMALIZED
; - OUT: SELENDL / SELENDX
; - CLOBBERS: AF, BC, DE, HL
; -

SELEOL          LD      HL, (SELENDL)
                PUSH    HL
                CALL    LINELEN         ; A = LENGTH OF THE END LINE
                POP     HL
                LD      C, A
                LD      A, (SELENDX)
                CP      C
                RET     Z
                RET     C               ; ENDS AT OR BEFORE THE LENGTH
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; THE LAST LINE: NO BREAK TO TAKE
                LD      (SELENDL), HL
                XOR     A
                LD      (SELENDX), A
                RET


; --- SELECTION PAINT          ----------------------------------------


; - SELEXT -----------------------------
; - COLUMN EXTENT OF A SELECTION RANGE ON ONE DOCUMENT LINE
; - IN:  HL = DOCUMENT LINE
; -      IX = RANGE BLOCK: STRL (2), STRX (1), ENDL (2), ENDX (1).
; -           SELSTRL.. AND DRWSTRL.. ARE BOTH LAID OUT THIS WAY.
; - OUT: CY = 1  THE LINE HAS NO SELECTED CELLS
; -      CY = 0  D = XA (FIRST COLUMN), E = XB (ONE PAST THE LAST), XB > XA.
; -              OFF THE END LINE XB = MIN(LEN + 1, TEXTCOLS), SO
; -              THE LINE BREAK SHOWS AS ONE CELL AND AN EMPTY LINE AS ONE TOO.
; - CLOBBERS: AF, BC, DE, HL
; -

SELEXT          LD      E, (IX + 0)
                LD      D, (IX + 1)     ; DE = START LINE
                CALL    CMPHLDE
                RET     C               ; LINE < START
                LD      E, (IX + 3)
                LD      D, (IX + 4)     ; DE = END LINE
                PUSH    HL
                CALL    CMPHLDE
                POP     HL
                JR      Z, .INSIDE
                JR      C, .INSIDE
                SCF                     ; LINE > END
                RET

.INSIDE         ; XA = STRX ON THE START LINE, ELSE 0
                LD      E, (IX + 0)
                LD      D, (IX + 1)
                PUSH    HL
                CALL    CMPHLDE
                POP     HL
                LD      B, 0
                JR      NZ, .XASET
                LD      B, (IX + 2)
.XASET          ; XB = ENDX ON THE END LINE, ELSE MIN(LEN + 1, TEXTCOLS)
                LD      E, (IX + 3)
                LD      D, (IX + 4)
                PUSH    HL
                CALL    CMPHLDE
                POP     HL
                JR      NZ, .XBLEN
                LD      C, (IX + 5)
                JR      .XBSET
.XBLEN          PUSH    BC
                CALL    LINELEN         ; A = LENGTH
                POP     BC
                INC     A
                JR      NZ, .LENOK
                DEC     A               ; CAP AT 255 IF 255 + 1 WRAPPED TO 0
.LENOK          LD      C, A
.XBSET          LD      A, C
                CP      B
                JR      Z, .NONE        ; XB == XA
                JR      C, .NONE        ; XB < XA

                ; CLIP LOGICAL [B, C) TO VIEWPORT [LEFTCOL, LEFTCOL + TEXTCOLS)
                LD      A, (LEFTCOL)
                LD      H, A            ; H = LEFTCOL
                CP      C
                JR      NC, .NONE       ; LEFTCOL >= C -> OFFSCREEN LEFT

                ADD     A, TEXTCOLS     ; A = LEFTCOL + TEXTCOLS
                LD      L, A            ; L = RIGHT BOUND
                LD      A, B
                CP      L
                JR      NC, .NONE       ; B >= RIGHT BOUND -> OFFSCREEN RIGHT

                ; COMPUTE D = VISIBLE SCREEN XA
                LD      A, B
                SUB     H               ; A = B - LEFTCOL
                JR      NC, .SAOK
                XOR     A               ; B < LEFTCOL -> CLAMP TO SCREEN COL 0
.SAOK           LD      D, A            ; D = SCREEN XA

                ; COMPUTE E = VISIBLE SCREEN XB
                LD      A, C
                CP      L
                JR      C, .SBIN        ; C < RIGHT BOUND -> SB = C - LEFTCOL
                LD      A, TEXTCOLS     ; C >= RIGHT BOUND -> CLAMP TO TEXTCOLS
                JR      .SBOK
.SBIN           SUB     H               ; A = C - LEFTCOL
.SBOK           LD      E, A            ; E = SCREEN XB

                ; CHECK IF VISIBLE INTERVAL IS NON-EMPTY: E > D
                LD      A, E
                CP      D
                JR      Z, .NONE
                JR      C, .NONE
                RET                     ; CY = 0 FROM CP (SINCE E > D)

.NONE           SCF
                RET


; - SELXOR -----------------------------
; - XOR-INVERT COLUMNS XA..XB-1 OF ONE SCREEN ROW
; - IN:  B = SCREEN ROW (0..23), D = XA, E = XB (XB > XA)
; - OUT: NONE
; - CLOBBERS: ALL
; -

                IFNDEF  S2ED
SELXOR          LD      A, E
                SUB     D
                LD      L, A
                LD      H, 0
                LD      C, D            ; C = XA
                LD      D, H
                LD      E, L
                IFDEF   S62ED
                ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                ADD     HL, HL          ; NX = CELLS * 8
                LD      (VDP_NX), HL
                LD      L, C
                LD      H, 0
                ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                ADD     HL, HL          ; XA * 8
                ELSE
                ADD     HL, HL
                ADD     HL, DE          ; * 3
                ADD     HL, HL          ; NX = CELLS * 6
                LD      (VDP_NX), HL
                LD      L, C
                LD      H, 0
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                ADD     HL, HL          ; XA * 6
                ENDIF
                LD      DE, TXORG_X
                ADD     HL, DE
                LD      (VDP_DX), HL
                LD      A, B
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; DY = (ROW + 1) * 8
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_FG       ; CLR = 1 (INVERSE VIDEO)
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_XOR
                JP      LMMV
                ENDIF


; - SELPAIN ----------------------------
; - XOR-INVERT THE VISIBLE PART OF THE SELECTION SELSTRL..SELENDL
; - IN:  SELSTRL, SELSTRX, SELENDL, SELENDX
; - OUT: NONE
; - CLOBBERS: ALL
; - IX IS RELOADED EVERY ROW: SELXOR CLOBBERS ALL, AND ON S2ED PATINV REALLY
; - DOES USE IX, SO A POINTER LOADED ONCE READ THE PATTERN SHADOW FROM ROW 1 ON.
; -

SELPAIN         LD      B, 0
.ROWLP          LD      IX, SELSTRL
                PUSH    BC
                LD      HL, (TOPLINE)
                LD      E, B
                LD      D, 0
                ADD     HL, DE
                CALL    SELEXT
                POP     BC
                JR      C, .NEXT
                PUSH    BC
                CALL    SELXOR
                POP     BC
.NEXT           INC     B
                LD      A, B
                CP      ROWSVIS
                JR      C, .ROWLP
                RET


; - SELDIFF ----------------------------
; - REPAINT ONLY WHAT CHANGED BETWEEN THE PAINTED RANGE (DRWSTRL..) AND THE
; - NEW ONE (SELSTRL..). XOR IS ITS OWN INVERSE, SO A ROW WHOSE EXTENT IS THE
; - SAME IN BOTH IS LEFT ALONE; A ROW WHOSE EXTENT MOVED AT ONE END ONLY GETS
; - ONE XOR OVER THE DIFFERENCE; ANYTHING ELSE GETS THE OLD EXTENT UN-XORED
; - AND THE NEW ONE XORED. EXTENDING BY A CHARACTER OR A ROW IS THEREBY ONE
; - OR TWO COMMANDS INSTEAD OF TWICE THE WHOLE SELECTION.
; - VALID ONLY WHILE THE PAINTED RANGE IS STILL ON SCREEN AS PAINTED: NO
; - SCROLL, NO ROW REPAINTED SINCE. THE CALLERS THAT SKIP SELPRE GUARANTEE IT.
; - IN:  DRWSTRL.., SELSTRL.., TOPLINE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELDIFF         LD      B, 0
.ROWLP          PUSH    BC
                LD      HL, (TOPLINE)
                LD      E, B
                LD      D, 0
                ADD     HL, DE
                PUSH    HL

                ; OLD EXTENT INTO SELTMPXA / SELTMPXB (0 / 0 WHEN NONE)
                LD      IX, DRWSTRL
                CALL    SELEXT
                LD      A, 0
                JR      C, .OLDSET
                LD      A, E
                LD      (SELTMPXB), A
                LD      A, D
.OLDSET         LD      (SELTMPXA), A
                JR      NC, .NEWEXT
                LD      (SELTMPXB), A

.NEWEXT         ; NEW EXTENT INTO D / E (0 / 0 WHEN NONE)
                POP     HL
                LD      IX, SELSTRL
                CALL    SELEXT
                JR      NC, .COMPARE
                LD      D, 0
                LD      E, 0

.COMPARE        POP     BC              ; B = SCREEN ROW
                LD      A, (SELTMPXA)
                CP      D
                JR      NZ, .DIFFXA
                LD      A, (SELTMPXB)
                CP      E
                JR      Z, .NEXT        ; IDENTICAL, OR NONE IN BOTH
                ; SAME XA: ONE XOR OVER MIN(XB)..MAX(XB)
                JR      C, .XBGREW
                LD      D, E            ; OLD XB > NEW XB: NEW XB .. OLD XB
                LD      E, A
                JR      .ONEXOR
.XBGREW         LD      D, A            ; OLD XB .. NEW XB
                JR      .ONEXOR

.DIFFXA         LD      A, (SELTMPXB)
                CP      E
                JR      NZ, .BOTH
                ; SAME XB: ONE XOR OVER MIN(XA)..MAX(XA)
                LD      A, (SELTMPXA)
                CP      D
                JR      C, .XASHRK
                LD      E, A            ; OLD XA > NEW XA: NEW XA .. OLD XA
                JR      .ONEXOR
.XASHRK         LD      E, D            ; OLD XA .. NEW XA
                LD      D, A
.ONEXOR         PUSH    BC
                CALL    SELXOR
                POP     BC
                JR      .NEXT

.BOTH           ; UN-XOR THE OLD EXTENT, XOR THE NEW ONE, EACH IF IT EXISTS
                PUSH    BC
                PUSH    DE
                LD      A, (SELTMPXA)
                LD      D, A
                LD      A, (SELTMPXB)
                LD      E, A
                CP      D
                JR      Z, .NOOLD
                JR      C, .NOOLD
                CALL    SELXOR
.NOOLD          POP     DE
                POP     BC
                LD      A, E
                CP      D
                JR      Z, .NEXT
                JR      C, .NEXT
                PUSH    BC
                CALL    SELXOR
                POP     BC

.NEXT           INC     B
                LD      A, B
                CP      ROWSVIS
                JP      C, .ROWLP
                RET


; --- ACTDSEL                   ----------------------------------------


; - ACTDSEL ----------------------------
; - CANCEL ACTIVE SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDSEL         LD      A, (SELACT)
                OR      A
                RET     Z
                CALL    SELPRE          ; UN-XOR IF DRAWN
                XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                JP      DRWSTAT


; --- ACTSELAL                  ----------------------------------------


; - ACTSELAL ---------------------------
; - SELECT ENTIRE DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSELAL        CALL    SELPRE          ; UN-XOR EXISTING IF DRAWN
                LD      HL, 0
                LD      (SELANCL), HL
                XOR     A
                LD      (SELANCX), A
                LD      A, 1
                LD      (SELACT), A

                ; MOVE CURSOR TO END OF LAST LINE
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (DOCLINE), HL
                CALL    LINEREAD
                LD      A, (WORKBUF)
                LD      (CURX), A

                CALL    SETCURY
                CALL    REDRAW
                JP      SELPOST


; --- ACTSLML                   ----------------------------------------


; - ACTSLML ----------------------------
; - EXTEND SELECTION ONE CHAR LEFT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLML         CALL    SELBEG
                LD      A, (CURY)
                LD      HL, CURX
                OR      (HL)
                CALL    Z, SELPRE       ; ROW 0, COLUMN 0: A WRAP (WRAP_TXT) SCROLLS
                CALL    ACTMVL          ; OTHERWISE NO SCROLL: SELPOST DIFFS
                JP      SELPOST


; --- ACTSLMR                   ----------------------------------------


; - ACTSLMR ----------------------------
; - EXTEND SELECTION ONE CHAR RIGHT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMR         CALL    SELBEG
                LD      A, (CURY)
                CP      ROWSVIS - 1
                JR      NZ, .MOVE       ; NOT THE BOTTOM ROW: NO SCROLL
                LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LENGTH
                LD      HL, CURX
                CP      (HL)            ; LENGTH - CURX
                JR      Z, .PRE
                JR      NC, .MOVE       ; NOT AT THE END: NO WRAP
.PRE            CALL    SELPRE          ; A WRAP (WRAP_TXT) SCROLLS: UN-XOR FIRST
.MOVE           CALL    ACTMVR          ; SELPOST DIFFS WHAT IS LEFT
                JP      SELPOST


; --- ACTSLMU                   ----------------------------------------


; - ACTSLMU ----------------------------
; - EXTEND SELECTION ONE ROW UP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMU         CALL    SELBEG
                LD      A, (CURY)
                OR      A
                CALL    Z, SELPRE       ; TOP ROW: THE MOVE SCROLLS, UN-XOR FIRST
                CALL    ACTMVU
                JP      SELPOST


; --- ACTSLMD                   ----------------------------------------


; - ACTSLMD ----------------------------
; - EXTEND SELECTION ONE ROW DOWN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMD         CALL    SELBEG
                LD      A, (CURY)
                CP      ROWSVIS - 1
                CALL    Z, SELPRE       ; BOTTOM ROW: THE MOVE SCROLLS, UN-XOR FIRST
                CALL    ACTMVD
                JP      SELPOST


; --- ACTSLBOL                  ----------------------------------------


; - ACTSLBOL ---------------------------
; - EXTEND SELECTION TO BEGINNING OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLBOL        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTBOL
                JP      SELPOST


; --- ACTSLEOL                  ----------------------------------------


; - ACTSLEOL ---------------------------
; - EXTEND SELECTION TO END OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLEOL        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTEOL
                JP      SELPOST


; --- ACTSLTOP                  ----------------------------------------


; - ACTSLTOP ---------------------------
; - EXTEND SELECTION TO TOP OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLTOP        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTTOP
                JP      SELPOST


; --- ACTSLBOT                  ----------------------------------------


; - ACTSLBOT ---------------------------
; - EXTEND SELECTION TO BOTTOM OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLBOT        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTBOT
                JP      SELPOST


; --- ACTSLWLF                  ----------------------------------------


; - ACTSLWLF ---------------------------
; - EXTEND SELECTION TO PREV WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLWLF        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTWLFT
                JP      SELPOST


; --- ACTSLWRT                  ----------------------------------------


; - ACTSLWRT ---------------------------
; - EXTEND SELECTION TO NEXT WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLWRT        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTWRGT
                JP      SELPOST


; --- ACTSLPGU                  ----------------------------------------


; - ACTSLPGU ---------------------------
; - EXTEND SELECTION ONE PAGE UP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLPGU        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTPGUP
                JP      SELPOST


; --- ACTSLPGD                  ----------------------------------------


; - ACTSLPGD ---------------------------
; - EXTEND SELECTION ONE PAGE DOWN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLPGD        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTPGDN
                JP      SELPOST


; --- ACTDLS                    ----------------------------------------


; - ACTDLS -----------------------------
; - DELETE ACTIVE SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDLS          LD      A, (SELACT)
                OR      A
                RET     Z               ; NOTHING SELECTED
                CALL    SELPRE          ; UN-XOR VISIBLE OVERLAY
                CALL    SELNORM         ; NORMALIZE RANGE
                CALL    SELEOL          ; A COVERED LINE BREAK GOES TOO
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .DLSNEMP
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                JP      Z, .DLSCLR      ; EMPTY RANGE: JUST CLEAR AND EXIT

.DLSNEMP        ; RECORD EVERY LINE THE DELETE TOUCHES, AS ONE UNDO GROUP
                LD      A, UNDOT_DEL
                CALL    UNDOSEL

                ; CHECK SINGLE-LINE VS MULTI-LINE
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JP      NZ, .DLSMULT

                ; --- SINGLE LINE DELETION -----------------------------
                LD      HL, (SELSTRL)
                CALL    LINEREAD        ; READ LINE INTO WORKBUF

                LD      A, (SELSTRX)
                LD      B, A            ; B = STARTX
                LD      A, (SELENDX)
                LD      C, A            ; C = ENDX
                SUB     B               ; A = ENDX - STARTX = K
                JP      Z, .DLSCLR
                LD      (DWK), A        ; DWK = K

                ; DELETE COLUMNS STARTX..ENDX-1 OF THE RECORD
                LD      A, (SELSTRX)
                LD      B, A
                LD      A, (SELENDX)
                LD      C, A
                CALL    WBDELN

.DLSSETC        ; 5. WRITE LINE TO MAPPER
                LD      HL, (SELSTRL)
                CALL    LINEWRT

                ; 6. SET CURSOR POSITION
                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                LD      (DOCLINE), HL
                CALL    SETCURY

                ; 7. RENDER ROW
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                JP      .DLSFIN

.DLSMULT        ; --- MULTI-LINE DELETION ------------------------------
                ; 1. READ END LINE INTO WORKBUF2
                LD      HL, (SELENDL)
                CALL    LINEREAD
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 2. READ START LINE INTO WORKBUF
                LD      HL, (SELSTRL)
                CALL    LINEREAD

                ; 3. SPLICE TAIL OF WORKBUF2 (FROM ENDX TO LEN2) ONTO WORKBUF AT STARTX
                LD      A, (WORKBUF2)   ; LEN2
                LD      HL, SELENDX
                CP      (HL)
                JR      C, .NOTAIL
                JR      Z, .NOTAIL
                SUB     (HL)            ; A = M
                LD      C, A            ; C = M
                LD      A, (SELSTRX)
                ADD     A, C
                JR      NC, .NOTRUNC
                LD      A, MAXCOLS
                LD      HL, SELSTRX
                SUB     (HL)
                LD      C, A            ; C = CLAMPED M
.NOTRUNC        ; COPY TEXT TAIL
                LD      A, (SELENDX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF2 + 1
                ADD     HL, DE          ; HL = SRC
                PUSH    HL              ; SAVE SRC
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST
                POP     HL              ; HL = SRC
                PUSH    BC              ; SAVE M IN C
                LD      B, 0
                LDIR

                ; COPY ATTR TAIL
                LD      A, (SELENDX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF2 + 1 + WORKATTR
                ADD     HL, DE          ; HL = SRC ATTR
                PUSH    HL              ; SAVE SRC ATTR
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST ATTR
                POP     HL              ; HL = SRC ATTR
                POP     BC              ; RESTORE M IN C
                PUSH    BC
                LD      B, 0
                LDIR
                POP     BC              ; C = M
                LD      A, (SELSTRX)
                ADD     A, C
                LD      (WORKBUF), A
                JR      .SAVESTR

.NOTAIL         LD      A, (SELSTRX)
                LD      (WORKBUF), A

.SAVESTR        ; CLEAR TAIL OF WORKBUF (FROM LEN TO THE END)
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, MAXCOLS
                SUB     E
                JR      Z, .NOTBLKT
                LD      B, A
.BLKTX3         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTX3

.NOTBLKT        LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      A, MAXCOLS
                SUB     E
                JR      Z, .WRTSTR
                LD      B, A
.BLKAT3         LD      (HL), 0
                INC     HL
                DJNZ    .BLKAT3

.WRTSTR         ; WRITE UPDATED START LINE TO MAPPER
                LD      HL, (SELSTRL)
                CALL    LINEWRT

                ; 4. DELETE INTERMEDIATE LINES AND END LINE
                LD      HL, (SELENDL)
                LD      DE, (SELSTRL)
                OR      A
                SBC     HL, DE          ; HL = COUNT TO DELETE
                LD      (SELTMPL), HL

.DELOOP         LD      HL, (SELTMPL)
                LD      A, H
                OR      L
                JR      Z, .DELDONE
                DEC     HL
                LD      (SELTMPL), HL

                LD      HL, (SELSTRL)
                INC     HL              ; LINE TO DELETE = SELSTRL + 1
                CALL    LINEDEL

                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                JR      .DELOOP

.DELDONE        ; 5. RE-POSITION CURSOR AT START, AND ON SCREEN: A SELECTION
                ;    MAY START ABOVE THE VIEWPORT (CTRL+A AFTER SCROLLING),
                ;    WHICH SETCURY ALONE TURNED INTO A NEGATIVE CURY
                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                LD      (DOCLINE), HL
                CALL    SHOWLN
                CALL    REDRAW

.DLSFIN         XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                LD      A, #FF
                LD      (MODIFIED), A
                JP      DRWSTAT

.DLSCLR         XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                JP      DRWSTAT


; --- ACTCOPY                   ----------------------------------------


; - ACTCOPY ----------------------------
; - COPY ACTIVE SELECTION TO CLIPBUF
; - IN:  NONE
; - OUT: (CLIPLEN) = BYTES WRITTEN
; - CLOBBERS: ALL
; -

ACTCOPY         LD      A, (SELACT)
                OR      A
                RET     Z               ; NO SELECTION ACTIVE
                CALL    SELNORM

                ; VERIFY SELECTION IS NOT EMPTY
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .CPYINIT
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET     Z               ; EMPTY: NOTHING TO COPY

.CPYINIT        CALL    SELEOL          ; A COVERED LINE BREAK IS COPIED TOO
                LD      HL, CLIPBUF
                LD      (CPYPTR), HL
                LD      HL, 0
                LD      (CPYCNT), HL
                LD      HL, (SELSTRL)
                LD      (SELTMPL), HL

.CPYLINE        ; CHECK IF TOTAL BYTES EXCEEDS CLIPMAX
                LD      HL, (CPYCNT)
                LD      DE, CLIPMAX
                CALL    CMPHLDE
                JP      NC, .CPYEXIT    ; CLIPBOARD FULL

                ; READ CURRENT LINE INTO WORKBUF
                LD      HL, (SELTMPL)
                CALL    LINEREAD

                ; THE COLUMNS [XA, XB) OF THIS LINE
                LD      HL, (SELTMPL)
                CALL    LNEXT
                LD      A, D
                LD      (SELTMPXA), A
                LD      A, E
                LD      (SELTMPXB), A
                JR      C, .CPYCHKN     ; NO CHARS ON THIS LINE
                LD      A, D
                LD      HL, SELTMPXB

                ; K = XB - XA
                SUB     (HL)
                NEG                     ; A = K
                LD      C, A            ; C = K (1..TEXTCOLS)

                ; CLAMP K TO REMAINING CLIPBOARD SPACE (CLIPMAX - CPYCNT)
                LD      HL, CLIPMAX
                LD      DE, (CPYCNT)
                OR      A
                SBC     HL, DE          ; HL = REMAINING
                LD      A, H
                OR      A
                JR      NZ, .CPYKOK     ; REMAINING > 255: K DEFINITELY FITS
                LD      A, C
                CP      L
                JR      C, .CPYKOK      ; K < REMAINING
                LD      C, L            ; CLAMP K = REMAINING
.CPYKOK         LD      A, C
                OR      A
                JR      Z, .CPYEXIT

                ; COPY K BYTES FROM WORKBUF + 1 + XA TO (CPYPTR)
                PUSH    BC              ; SAVE K IN C
                LD      A, (SELTMPXA)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; HL = SRC
                LD      DE, (CPYPTR)    ; DE = DEST
                LD      B, 0            ; BC = K
                LDIR
                LD      (CPYPTR), DE    ; UPDATE WRITE POINTER
                POP     BC              ; RESTORE K IN C

                ; CPYCNT += K
                LD      HL, (CPYCNT)
                LD      B, 0
                ADD     HL, BC
                LD      (CPYCNT), HL

.CPYCHKN        ; IF SELTMPL == SELENDL, WE ARE FINISHED
                LD      HL, (SELTMPL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      Z, .CPYEXIT

                ; NOT LAST LINE: APPEND CRLF (#0D, #0A) IF AT LEAST 2 BYTES REMAIN
                LD      HL, CLIPMAX
                LD      DE, (CPYCNT)
                OR      A
                SBC     HL, DE
                LD      A, H
                OR      A
                JR      NZ, .CPYCRLF
                LD      A, L
                CP      2
                JR      C, .CPYEXIT     ; NO ROOM FOR CRLF

.CPYCRLF        LD      HL, (CPYPTR)
                LD      (HL), #0D
                INC     HL
                LD      (HL), #0A
                INC     HL
                LD      (CPYPTR), HL
                LD      HL, (CPYCNT)
                INC     HL
                INC     HL
                LD      (CPYCNT), HL

                ; ADVANCE TO NEXT LINE
                LD      HL, (SELTMPL)
                INC     HL
                LD      (SELTMPL), HL
                JP      .CPYLINE

.CPYEXIT        LD      HL, (CPYCNT)
                LD      (CLIPLEN), HL
                RET


; --- ACTCUT                     ----------------------------------------


; - ACTCUT -----------------------------
; - CUT ACTIVE SELECTION TO CLIPBUF
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTCUT          CALL    ACTCOPY
                LD      HL, (CLIPLEN)
                LD      A, H
                OR      L
                RET     Z               ; NOTHING COPIED
                JP      ACTDLS          ; DELETE SELECTION FROM DOCUMENT


; --- ACTPAST                   ----------------------------------------


; - ACTPAST ----------------------------
; - PASTE CLIPBUF AT CURRENT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPAST         LD      HL, (CLIPLEN)
                LD      A, H
                OR      L
                RET     Z               ; CLIPBOARD EMPTY

                ; IF ACTIVE SELECTION, DELETE IT FIRST -- IT PAINTS ITSELF,
                ; SO THE SNAPSHOT BELOW HAS TO COME AFTER IT
                LD      A, (SELACT)
                OR      A
                JR      Z, .PSTINIT
                CALL    ACTDLS

.PSTINIT        LD      A, (CURY)
                LD      (PSTROW), A
                LD      HL, (TOPLINE)
                LD      (PSTTOP), HL
                LD      HL, (TOTLINES)
                LD      (PSTTOT), HL

                LD      HL, (CLIPLEN)
                LD      (CPYCNT), HL
                LD      HL, CLIPBUF
                LD      (CLIPRD), HL

                LD      A, #FF
                LD      (RNDHOLD), A    ; ONE REPAINT, AT THE END

.PSTLP          LD      HL, (CPYCNT)
                LD      A, H
                OR      L
                JP      Z, .PSTDONE

                LD      HL, (CLIPRD)
                LD      A, (HL)
                CP      #0D
                JR      Z, .PSTCR
                CP      #0A
                JR      Z, .PSTLF
                CALL    PSTOK
                JR      C, .PSTRUN

                ; IGNORED CONTROL BYTE: DROP IT AND CARRY ON
                CALL    PSTADV
                JR      .PSTLP

.PSTCR          CALL    PSTADV
                CALL    PSTNL
                JP      C, .PSTDONE     ; NO ROOM FOR ANOTHER LINE: STOP HERE

                ; A CRLF PAIR IS ONE BREAK: SWALLOW A FOLLOWING LF
                LD      HL, (CPYCNT)
                LD      A, H
                OR      L
                JP      Z, .PSTDONE
                LD      HL, (CLIPRD)
                LD      A, (HL)
                CP      #0A
                JR      NZ, .PSTLP
                CALL    PSTADV
                JR      .PSTLP

.PSTLF          CALL    PSTADV
                CALL    PSTNL
                JP      C, .PSTDONE
                JR      .PSTLP

.PSTRUN         ; MEASURE THE RUN: CONSECUTIVE INSERTABLE BYTES, NEVER MORE
                ; THAN ONE LINE'S WORTH
                LD      HL, (CLIPRD)
                LD      DE, (CPYCNT)
                LD      B, 0
.PSTSCAN        LD      A, D
                OR      E
                JR      Z, .PSTGOT      ; CLIPBOARD EXHAUSTED
                LD      A, B
                CP      TEXTCOLS
                JR      Z, .PSTGOT
                LD      A, (HL)
                CP      #09
                JR      Z, .PSTGOT      ; TAB EXPANSION HANDLED BY .PSTONE
                CALL    PSTOK
                JR      NC, .PSTGOT
                INC     HL
                DEC     DE
                INC     B
                JR      .PSTSCAN

.PSTGOT         LD      A, B
                LD      (PSTRUN), A
                LD      HL, (CLIPRD)
                CALL    EDINSRUN
                JR      C, .PSTSLOW     ; A NOW HOLDS THE ROOM, NOT THE RUN

                ; THE WHOLE RUN WENT IN: CONSUME IT
                LD      A, (PSTRUN)
                LD      C, A
                LD      B, 0
                LD      HL, (CLIPRD)
                ADD     HL, BC
                LD      (CLIPRD), HL
                LD      HL, (CPYCNT)
                OR      A
                SBC     HL, BC
                LD      (CPYCNT), HL
                JP      .PSTLP

.PSTSLOW        ; THE RUN OVERFLOWS THE LINE, AND A HOLDS HOW MUCH OF IT WOULD
                ; STILL GO IN. TAKE THAT MUCH AS A BATCH, THEN COME BACK ROUND
                ; FOR THE CHARACTER THAT WILL NOT FIT.
                OR      A
                JR      Z, .PSTONE      ; THE LINE IS ALREADY FULL
                LD      (PSTRUN), A
                LD      B, A
                LD      HL, (CLIPRD)
                CALL    EDINSRUN
                JR      C, .PSTONE      ; REFUSED AGAIN: FALL BACK
                LD      A, (PSTRUN)
                LD      C, A
                LD      B, 0
                LD      HL, (CLIPRD)
                ADD     HL, BC
                LD      (CLIPRD), HL
                LD      HL, (CPYCNT)
                OR      A
                SBC     HL, BC
                LD      (CPYCNT), HL
                JP      .PSTLP

.PSTONE         ; ONE CHARACTER THAT DOES NOT FIT, OR TAB TO EXPAND.
                ; WHAT HAPPENS TO IT IS THE WRAP MODE'S DECISION -- CLAMP IN
                ; WRAP_DEV, PUSH THE TRAILING WORD DOWN IN WRAP_TXT.
                LD      HL, (CLIPRD)
                LD      A, (HL)
                CP      #09
                JR      NZ, .PSTSCHR
                CALL    ACTTAB
                CALL    PSTADV
                JP      .PSTLP

.PSTSCHR        CALL    EDINSCHR
                CALL    PSTADV
                JP      .PSTLP

.PSTDONE        XOR     A
                LD      (RNDHOLD), A
                CALL    SETCURY         ; CURY = DOCLINE - TOPLINE, ALWAYS

                ; DID THE VIEWPORT MOVE? THEN EVERY ROW SHOWS SOMETHING ELSE
                LD      HL, (TOPLINE)
                LD      DE, (PSTTOP)
                OR      A
                SBC     HL, DE
                JR      NZ, .PSTALL

                ; HOW MANY LINES APPEARED?
                LD      HL, (TOTLINES)
                LD      DE, (PSTTOT)
                OR      A
                SBC     HL, DE
                LD      A, H
                OR      A
                JR      NZ, .PSTALL     ; MORE THAN 255: NOT WORTH BEING CLEVER
                LD      A, L
                OR      A
                JR      NZ, .PSTMANY

                ; NOTHING MOVED: EXACTLY ONE ROW CHANGED. THE LINE NUMBERS AND
                ; THE SCROLLBAR THUMB CANNOT HAVE MOVED EITHER.
                LD      A, (PSTROW)
                INC     A
                LD      B, A
                CALL    RENDEROW
                JP      DRWSTAT

.PSTMANY        ; L = LINES ADDED. THE UNTOUCHED TAIL OF THE SCREEN SLIDES DOWN
                ; BY THAT MANY ROWS IN ONE BLIT, THEN THE NEW ROWS ARE PAINTED.
                LD      A, (PSTROW)
                INC     A               ; A = FIRST ROW THAT CHANGED (1..24)
                LD      B, A
                LD      C, L            ; C = ROWS ADDED
                ADD     A, C            ; A = LAST ROW TO PAINT
                CP      TXRLAST
                JR      NC, .PSTTAIL    ; REACHES THE BOTTOM: NOTHING SURVIVES

                PUSH    AF              ; SAVE THE LAST ROW TO PAINT
                INC     B               ; FIRST ROW THAT ONLY MOVES DOWN
                CALL    SHIFTDNN
                POP     AF
                LD      C, A
                LD      A, (PSTROW)
                INC     A
                LD      B, A
                JR      .PSTPLP

.PSTTAIL        LD      C, TXRLAST
                LD      A, (PSTROW)
                INC     A
                LD      B, A

.PSTPLP         PUSH    BC
                CALL    RENDEROW
                POP     BC
                LD      A, B
                CP      C
                JR      NC, .PSTBARS
                INC     B
                JR      .PSTPLP

.PSTALL         CALL    REDRAW

.PSTBARS        JP      DRWSTAT


; --- PSTOK                     ----------------------------------------


; - PSTOK ------------------------------
; - IS THIS CLIPBOARD BYTE ONE THE EDITOR CAN INSERT?
; - TAB COUNTS: WBINSN AND THE SLOW PATH BOTH TURN IT INTO A SPACE.
; - IN:  A = BYTE
; - OUT: CY = 1  INSERTABLE
; - CLOBBERS: F
; -

PSTOK           CP      #09
                JR      Z, .POYES       ; TAB
                CP      #20
                JR      C, .PONO        ; CONTROL CODE
                CP      #7F
                JR      Z, .PONO        ; DEL
                CP      #FF
                JR      Z, .PONO        ; SENTINEL
.POYES          SCF
                RET

.PONO           OR      A               ; CY = 0
                RET


; --- PSTADV                    ----------------------------------------


; - PSTADV -----------------------------
; - STEP THE CLIPBOARD READ CURSOR ON BY ONE BYTE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: HL
; -

PSTADV          LD      HL, (CLIPRD)
                INC     HL
                LD      (CLIPRD), HL
                LD      HL, (CPYCNT)
                DEC     HL
                LD      (CPYCNT), HL
                RET


; --- PSTNL                     ----------------------------------------


; - PSTNL ------------------------------
; - BREAK THE LINE DURING A PASTE
; - EDNWLIN REFUSES SILENTLY WHEN THE DIRECTORY IS FULL OR THE MAPPER HAS
; - NOTHING LEFT, SO CHECK THE LINE COUNT AND STOP THE PASTE RATHER THAN
; - PILING THE REST OF THE CLIPBOARD ONTO ONE LINE.
; - IN:  NONE
; - OUT: CY = 1  THE BREAK DID NOT HAPPEN
; - CLOBBERS: ALL
; -

PSTNL           LD      HL, (TOTLINES)
                PUSH    HL
                CALL    EDNWLIN
                POP     DE
                LD      HL, (TOTLINES)
                LD      A, H
                CP      D
                JR      NZ, .PNOK
                LD      A, L
                CP      E
                JR      NZ, .PNOK
                SCF                     ; UNCHANGED: REFUSED
                RET

.PNOK           OR      A               ; CY = 0
                RET


; --- ACTTGLBD                  ----------------------------------------


; - ACTTGLBD ---------------------------
; - TOGGLE BOLD ATTRIBUTE ON SELECTION OR TYPING STATE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLBD        LD      A, (MKUPMD)
                OR      A
                JR      Z, .RAWBD       ; MKUP_OFF: RAW ATTRIBUTE TOGGLE
                ; MARKUP MODE (MD OR LITE)
                LD      A, (SELACT)
                OR      A
                JR      NZ, .WRPBD
                LD      A, 1            ; 1 = BOLD
                JP      INSDELIM
.WRPBD          LD      A, 1            ; 1 = BOLD
                JP      WRAPSEL

.RAWBD          LD      A, (SELACT)
                OR      A
                JR      NZ, .SELBD
                ; NO SELECTION: TOGGLE TYPING ATTRIBUTE
                LD      A, (TYPATTR)
                XOR     ATRBOLD
                LD      (TYPATTR), A
                JP      DRWSTAT
.SELBD          LD      A, ATRBOLD
                JP      APPLSEL


; --- ACTTGLIT                  ----------------------------------------


; - ACTTGLIT ---------------------------
; - TOGGLE ITALIC ATTRIBUTE ON SELECTION OR TYPING STATE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLIT        LD      A, (MKUPMD)
                OR      A
                JR      Z, .RAWIT       ; MKUP_OFF: RAW ATTRIBUTE TOGGLE
                ; MARKUP MODE (MD OR LITE)
                LD      A, (SELACT)
                OR      A
                JR      NZ, .WRPIT
                LD      A, 2            ; 2 = ITALIC
                JP      INSDELIM
.WRPIT          LD      A, 2            ; 2 = ITALIC
                JP      WRAPSEL

.RAWIT          LD      A, (SELACT)
                OR      A
                JR      NZ, .SELIT
                ; NO SELECTION: TOGGLE TYPING ATTRIBUTE
                LD      A, (TYPATTR)
                XOR     ATRITAL
                LD      (TYPATTR), A
                JP      DRWSTAT
.SELIT          LD      A, ATRITAL
                JP      APPLSEL


; --- APPLSEL                   ----------------------------------------


; - APPLSEL ----------------------------
; - TOGGLE ATTRIBUTE BITS ACROSS ACTIVE SELECTION
; - IN:  A = ATTRIBUTE MASK TO TOGGLE (ATRBOLD OR ATRITAL)
; - OUT: NONE
; - CLOBBERS: ALL
; -

APPLSEL         LD      (STYLMASK), A
                CALL    SELNORM

                ; VERIFY SELECTION IS NOT EMPTY
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .APLINIT
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET     Z               ; EMPTY: NOTHING TO STYLE

.APLINIT        CALL    SELPRE          ; THE ROWS ARE REPAINTED CLEAN BELOW: TAKE
                                        ; THE OVERLAY OFF FIRST, OR SELPOST FINDS IT
                                        ; "PAINTED" AND THE NEXT DESELECT XORS RESIDUE
                LD      A, UNDOT_MOD    ; EVERY SELECTED LINE, ONE UNDO GROUP
                CALL    UNDOSEL
                LD      HL, (SELSTRL)
                LD      (STYLLN), HL

.APLLINE        ; READ CURRENT LINE RECORD INTO WORKBUF
                LD      HL, (STYLLN)
                CALL    LINEREAD

                ; THE COLUMNS [XA, XB) OF THIS LINE
                LD      HL, (STYLLN)
                CALL    LNEXT
                LD      A, D
                LD      (STYLXA), A
                LD      A, E
                LD      (STYLXB), A
                JR      C, .APLCHKN     ; NO CHARS ON THIS LINE
                LD      A, D
                LD      HL, STYLXB

                ; COUNT = XB - XA
                SUB     (HL)
                NEG                     ; A = COUNT
                LD      B, A            ; B = COUNT (1..TEXTCOLS)

                LD      A, (STYLXA)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE          ; HL = WORKBUF + 1 + WORKATTR + XA
                LD      A, (STYLMASK)
                LD      C, A            ; C = MASK TO TOGGLE

.APLCELL        LD      A, (HL)
                XOR     C
                LD      (HL), A
                INC     HL
                DJNZ    .APLCELL

                ; WRITE LINE BACK TO MAPPER
                LD      HL, (STYLLN)
                CALL    LINEWRT

                ; IF ON SCREEN, RE-RENDER ROW
                LD      HL, (STYLLN)
                LD      DE, (TOPLINE)
                OR      A
                SBC     HL, DE
                JR      C, .APLCHKN     ; L < TOPLINE: OFF SCREEN ABOVE
                LD      A, H
                OR      A
                JR      NZ, .APLCHKN    ; L - TOPLINE >= 256
                LD      A, L
                CP      ROWSVIS
                JR      NC, .APLCHKN    ; OFF SCREEN BELOW
                INC     A               ; SCREEN ROW = A + 1 (1..24)
                LD      B, A
                CALL    RENDEROW

.APLCHKN        ; CHECK IF LAST LINE
                LD      HL, (STYLLN)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      Z, .APLDONE

                ; NEXT LINE
                LD      HL, (STYLLN)
                INC     HL
                LD      (STYLLN), HL
                JP      .APLLINE

.APLDONE        ; REDRAW SELECTION XOR HIGHLIGHT OVER UPDATED ROWS
                CALL    SELPOST
                LD      A, #FF
                LD      (MODIFIED), A
                JP      DRWSTAT


; --- ACTTAB                    ----------------------------------------


; - ACTTAB -----------------------------
; - INSERT SPACES UP TO NEXT TAB STOP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTAB          LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDLS      ; DELETE ACTIVE SELECTION FIRST

                ; CALCULATE SPACES: TABWIDTH - (CURX % TABWIDTH)
                LD      A, (CURX)
                LD      C, A
                LD      A, (TABWIDTH)
                LD      B, A            ; B = TABWIDTH
                LD      A, C
.TABMD          CP      B
                JR      C, .TABRM
                SUB     B
                JR      .TABMD
.TABRM          ; A = CURX % TABWIDTH
                LD      C, A
                LD      A, B
                SUB     C               ; A = TABWIDTH - (CURX % TABWIDTH)
                LD      B, A            ; B = SPACES TO INSERT (1..8)

                ; ONE RUN: ONE LINEREAD, ONE LINEWRT, ONE UNDO RECORD AND ONE
                ; REPAINT, INSTEAD OF UP TO EIGHT OF EACH THROUGH EDINSCHR
                PUSH    BC
                LD      HL, .SPACES
                CALL    EDINSRUN
                POP     BC
                JR      C, .TABLP       ; DOES NOT FIT: THE WRAP MODE DECIDES
                LD      A, (RNDHOLD)    ; A PASTE PAINTS ONCE AT THE END
                OR      A
                RET     NZ
                LD      A, (CURY)
                INC     A
                LD      B, A
                JP      RENDIFF

.TABLP          PUSH    BC
                LD      A, ' '
                CALL    EDINSCHR
                POP     BC
                DJNZ    .TABLP
                RET

.SPACES         DEFM    "        "      ; TABWIDTH IS AT MOST 8


; --- ACTMENU                   ----------------------------------------


; - ACTMENU ----------------------------
; - OPEN DROP-DOWN MENU (FILE MENU)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMENU         XOR     A
                LD      (MNUID), A
                JR      MNUENT


; - ACTMNU1 ----------------------------
; - OPEN DROP-DOWN MENU (EDIT MENU)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMNU1         LD      A, 1
                LD      (MNUID), A
                JR      MNUENT


; - ACTMNU2 ----------------------------
; - OPEN DROP-DOWN MENU (VIEW MENU)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMNU2         LD      A, 2
                LD      (MNUID), A
                JR      MNUENT


; - ACTMNU3 ----------------------------
; - OPEN DROP-DOWN MENU (HELP MENU)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMNU3         EQU     ACTMNU2         ; THREE MENUS: F3..F5 ALL OPEN HELP


; - ACTMNU4 ----------------------------
; - OPEN DROP-DOWN MENU (HELP MENU)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMNU4         EQU     ACTMNU2


; - MNUENT -----------------------------
; - COMMON ENTRY POINT FOR DROP-DOWN MENUS
; - IN:  NONE (USES MNUID)
; - OUT: NONE
; - CLOBBERS: ALL
; -

MNUENT          ; FTR-BUDGET: S6ED 11,501 B FREE, S2ED 1,688 B (2026-09-22)
                LD      A, (FTRSEG)
                LD      HL, DOMNU
                CALL    FCALL
                RET     C               ; CANCELLED: RETURN TO EDITING

                ; DISPATCH SELECTED ACTION BASED ON (MNUID)
                LD      A, (MNUID)
                OR      A
                JR      Z, .FILMNU
                DEC     A
                JR      Z, .EDIMNU
                JP      .HLPMNU

.FILMNU         LD      A, (MNUSEL)
                OR      A
                JR      Z, .FNEW
                CP      1
                JP      Z, ACTOPEN
                CP      2
                JR      Z, .FSAVE
                CP      3
                JP      Z, ACTSAVAS
                CP      5
                JR      Z, .FQUIT
                RET

.FNEW           JP      ACTNEW

.FSAVE          JP      FILESAVE

.FQUIT          JP      ACTQUIT

.EDIMNU         LD      A, (MNUSEL)
                OR      A
                JR      Z, .ECUT
                CP      1
                JR      Z, .ECPY
                CP      2
                JR      Z, .EPST
                CP      3
                JR      Z, .EDEL
                CP      5
                JR      Z, .EALL
                CP      6
                JR      Z, .EDSL
                CP      8
                JR      Z, .EGOTO
                CP      9
                JR      Z, .EFIND
                RET

                ; EVERY ONE OF THESE CALLS THE ROUTINE, NEVER THE ACTION ID.
                ; FIVE OF THE SIX USED TO NAME THE CONSTANT -- ACCUT IS EQU 46,
                ; SO CALL ACCUT ASSEMBLED TO CALL #002E, INTO THE DOS ZERO
                ; PAGE. IT ASSEMBLES CLEANLY AND NO GATE CASE HAD EVER PRESSED
                ; AN EDIT MENU ITEM, WHICH IS WHY IT SHIPPED ON BOTH TARGETS.

.ECUT           CALL    ACTCUT
                JP      DRWSTAT

.ECPY           CALL    ACTCOPY
                JP      DRWSTAT

.EPST           CALL    ACTPAST
                JP      DRWSTAT

.EDEL           CALL    ACTDELLN
                JP      DRWSTAT

.EALL           CALL    ACTSELAL
                JP      DRWSTAT

.EDSL           CALL    ACTDSEL
                JP      DRWSTAT

.EGOTO          JP      ACTGOTO

.EFIND          JP      ACTFIND

.HLPMNU         LD      A, (MNUSEL)
                OR      A
                JR      Z, .HSETT
                CP      3
                JR      Z, .HABT
                RET

.HSETT          CALL    ACTSETT
                JP      DRWSTAT

.HABT           JP      ACTHELP


; --- ACTSETT                   ----------------------------------------


; - ACTSETT ----------------------------
; - OPEN SETTINGS MODAL DIALOG
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSETT         ; FTR-BUDGET: S6ED 2,447 B FREE, S2ED 154 B (2026-10-02)
                LD      A, (FTRSEG)
                LD      HL, DOSETT
                CALL    FCALL
                CALL    DRWMENU
                CALL    DRWSTAT
                JP      REDRAW


