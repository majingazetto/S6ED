; **********************************************
; * CFG.Z8A - CONFIGURATION FILE (S6ED.CFG)    *
; * ACCEPTS KEY=VALUE WITH OPTIONAL WHITESPACE *
; * AROUND '=' (E.G. "TABWIDTH = 8").          *
; **********************************************


; --- CFGLOAD                   ----------------------------------------


; - CFGLOAD ----------------------------
; - LOAD S6ED.CFG IF PRESENT AND APPLY
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CFGLOAD         LD      HL, CFGNAME
                CALL    DSKOPEN
                RET     C               ; FILE NOT FOUND: USE DEFAULTS

                PUSH    AF              ; SAVE FILE HANDLE (DSKREAD CLOBBERS BC)
                LD      HL, 1024        ; READ UP TO 1024 BYTES INTO CLIPBUF
                LD      DE, CLIPBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      C, L
                LD      B, H            ; BC = BYTES READ
                POP     AF              ; A = FILE HANDLE
                PUSH    BC              ; KEEP BYTE COUNT ACROSS CLOSE
                CALL    DSKCLOSE
                POP     BC              ; BC = BYTES READ

                LD      A, B
                OR      C
                RET     Z               ; EMPTY FILE

                ; NULL-TERMINATE BUFFER
                LD      HL, CLIPBUF
                ADD     HL, BC
                LD      (HL), 0

                ; PARSE LINES FROM CLIPBUF
                LD      HL, CLIPBUF
.LINELP         LD      A, (HL)
                OR      A
                JP      Z, .CFGDON      ; END OF BUFFER: APPLY PALETTE IF DIRTY

                ; SKIP LEADING WHITESPACE / EMPTY LINES
                CP      ' '
                JR      Z, .NEXTCH
                CP      9               ; TAB
                JR      Z, .NEXTCH
                CP      13              ; CR
                JR      Z, .NEXTCH
                CP      10              ; LF
                JR      Z, .NEXTCH
                CP      ';'             ; COMMENT
                JP      Z, .SKPLIN
                CP      '#'             ; COMMENT
                JP      Z, .SKPLIN
                JR      .PARSLN

.NEXTCH         INC     HL
                JR      .LINELP

.PARSLN         ; CHECK "PROFILE"
                PUSH    HL
                LD      DE, KEYPROF
                CALL    STRPREF
                JR      NC, .NOTPRF
                CALL    CFGVAL          ; "PROFILE = ..." ALSO ACCEPTED
                JR      NC, .NOTPRF
                CALL    PARSPRF
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTPRF         POP     HL
                PUSH    HL
                LD      DE, KEYWRAP
                CALL    STRPREF
                JR      NC, .NOTWRP
                CALL    CFGVAL
                JR      NC, .NOTWRP
                CALL    PARSWRP
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTWRP         POP     HL
                PUSH    HL
                LD      DE, KEYMKUP
                CALL    STRPREF
                JR      NC, .NOTMKP
                CALL    CFGVAL
                JR      NC, .NOTMKP
                CALL    PARSMKP
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTMKP         POP     HL
                PUSH    HL
                LD      DE, KEYCLK
                CALL    STRPREF
                JR      NC, .NOTCLK
                CALL    CFGVAL
                JR      NC, .NOTCLK
                CALL    PARSCLK
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCLK         POP     HL
                PUSH    HL
                LD      DE, KEYTAB
                CALL    STRPREF
                JR      NC, .NOTTAB
                CALL    CFGVAL
                JR      NC, .NOTTAB
                CALL    PARSTAB
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTTAB         POP     HL
                PUSH    HL
                LD      DE, KEYEOL
                CALL    STRPREF
                JR      NC, .NOTEOL
                CALL    CFGVAL
                JR      NC, .NOTEOL
                CALL    PARSEOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTEOL         POP     HL
                PUSH    HL
                LD      DE, KEYALN
                CALL    STRPREF
                JR      NC, .NOTALN
                CALL    CFGVAL
                JR      NC, .NOTALN
                CALL    PARSALN
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTALN         POP     HL
                PUSH    HL
                LD      DE, KEYTHM
                CALL    STRPREF
                JR      NC, .NOTTHM
                CALL    CFGVAL
                JR      NC, .NOTTHM
                CALL    PARSTHM
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTTHM         POP     HL
                PUSH    HL
                LD      DE, KEYCBG
                CALL    STRPREF
                JR      NC, .NOTCBG
                CALL    CFGVAL
                JR      NC, .NOTCBG
                LD      C, 0            ; COLOR 0 = BG
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCBG         POP     HL
                PUSH    HL
                LD      DE, KEYCTX
                CALL    STRPREF
                JR      C, .ISCTX
                ; TRY ALIAS "COLOR_FG"
                POP     HL
                PUSH    HL
                LD      DE, KEYCFG
                CALL    STRPREF
                JR      NC, .NOTCTX
.ISCTX          CALL    CFGVAL
                JR      NC, .NOTCTX
                LD      C, 1            ; COLOR 1 = FG / TEXT
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCTX         POP     HL
                PUSH    HL
                LD      DE, KEYCUI
                CALL    STRPREF
                JR      NC, .NOTCUI
                CALL    CFGVAL
                JR      NC, .NOTCUI
                LD      C, 2            ; COLOR 2 = UI
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCUI         POP     HL
                PUSH    HL
                LD      DE, KEYCHI
                CALL    STRPREF
                JR      C, .ISCHI
                ; TRY ALIAS "COLOR_HI"
                POP     HL
                PUSH    HL
                LD      DE, KEYCHIS
                CALL    STRPREF
                JR      NC, .NOTCHI
.ISCHI          CALL    CFGVAL
                JR      NC, .NOTCHI
                LD      C, 3            ; COLOR 3 = HIGHLIGHT
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCHI         POP     HL

.SKPLIN         ; ADVANCE HL TO END OF CURRENT LINE (CR, LF, OR 0)
                LD      A, (HL)
                OR      A
                JR      Z, .CFGDON
                CP      13
                JR      Z, .EOLS
                CP      10
                JR      Z, .EOLS
                INC     HL
                JR      .SKPLIN

.EOLS           ; SKIP CR/LF CHARACTERS
                INC     HL
                LD      A, (HL)
                CP      10
                JR      Z, .EOLS
                CP      13
                JR      Z, .EOLS
                JP      .LINELP

.CFGDON         LD      A, (PALDIRT)
                OR      A
                RET     Z
                LD      HL, PALDATA
                JP      SETPAL


; --- STRPREF                   ----------------------------------------


; - STRPREF ----------------------------
; - MATCH NULL-TERMINATED PREFIX AT HL
; - IN:  HL = INPUT STRING
; -      DE = PREFIX STRING (ASCIIZ)
; - OUT: CY = 1 IF MATCH, HL ADVANCED PAST PREFIX
; -      CY = 0 IF NO MATCH
; - CLOBBERS: A, B, DE
; -

STRPREF         LD      A, (DE)
                OR      A
                JR      Z, .MATCH
                LD      B, A
                LD      A, (HL)
                CP      B
                JR      NZ, .NOMTCH
                INC     HL
                INC     DE
                JR      STRPREF
.MATCH          SCF
                RET
.NOMTCH         XOR     A
                RET


; --- CFGVAL                    ----------------------------------------


; - CFGVAL -----------------------------
; - AFTER A KEY PREFIX MATCH: SKIP
; - WHITESPACE, REQUIRE '=', THEN SKIP
; - WHITESPACE AGAIN
; - IN:  HL = POSITION AFTER KEY
; - OUT: CY = 1: HL = START OF VALUE
; -      CY = 0: NOT A KEY ASSIGNMENT
; - CLOBBERS: A, HL
; -

CFGVAL          ; SKIP WHITESPACE BEFORE '='
.PRE            LD      A, (HL)
                CP      ' '
                JR      Z, .PRE1
                CP      9               ; TAB
                JR      NZ, .EQ
.PRE1           INC     HL
                JR      .PRE

.EQ             CP      '='
                JR      NZ, .NO
                INC     HL

.POST           ; SKIP WHITESPACE AFTER '='
                LD      A, (HL)
                CP      ' '
                JR      Z, .POST1
                CP      9               ; TAB
                JR      NZ, .YES
.POST1          INC     HL
                JR      .POST

.YES            SCF
                RET
.NO             XOR     A
                RET


; --- UPCASE                    ----------------------------------------


; - UPCASE -----------------------------
; - CONVERT ASCII LOWERCASE TO UPPERCASE
; - IN:  A = CHARACTER
; - OUT: A = UPPERCASE CHARACTER (UNCHANGED IF NOT LOWERCASE)
; - CLOBBERS: F
; -

UPCASE          CP      #61             ; 'a'
                RET     C
                CP      #7B             ; 'z' + 1
                RET     NC
                SUB     #20             ; ASCII CASE DISTANCE
                RET


; --- PARSPRF                   ----------------------------------------


; - PARSPRF ----------------------------
; - PARSE PROFILE VALUE (STD, WS, EMC, VI)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSPRF         LD      A, (HL)
                CALL    UPCASE
                SUB     #45             ; 'E'
                RET     C
                CP      #13             ; 19 ENTRIES
                RET     NC
                LD      DE, PRFTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                LD      (KMAPID), A
                JP      KMAPSW


; --- PARSWRP                   ----------------------------------------


; - PARSWRP ----------------------------
; - PARSE WRAP VALUE (DEV, TXT)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSWRP         LD      A, (HL)
                CALL    UPCASE
                CP      #44             ; 'D'
                JR      Z, .SETDEV
                CP      #54             ; 'T'
                JR      Z, .SETTXT
                RET
.SETDEV         XOR     A
                LD      (WRAPMODE), A
                RET
.SETTXT         LD      A, 1
                LD      (WRAPMODE), A
                RET


; --- PARSMKP                   ----------------------------------------


; - PARSMKP ----------------------------
; - PARSE MARKUP VALUE (OFF, MD, LIT)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSMKP         LD      A, (HL)
                CALL    UPCASE
                SUB     #4C             ; 'L'
                RET     C
                CP      #04
                RET     NC
                LD      DE, MKPTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                LD      (MKUPMD), A
                RET


; --- PARSCLK                   ----------------------------------------


; - PARSCLK ----------------------------
; - PARSE CLOCK VALUE (0, 1)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSCLK         LD      A, (HL)
                SUB     #30             ; '0'
                RET     C
                CP      #02
                RET     NC
                LD      DE, CLKTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                LD      (SHOWCLK), A
                RET


; --- PARSTAB                   ----------------------------------------


; - PARSTAB ----------------------------
; - PARSE TABWIDTH VALUE (2, 4, 8)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSTAB         LD      A, (HL)
                SUB     #30             ; '0'
                RET     C
                CP      #0A             ; 10 ENTRIES
                RET     NC
                LD      DE, TABTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                LD      (TABWIDTH), A
                RET


; --- PARSEOL                   ----------------------------------------


; - PARSEOL ----------------------------
; - PARSE EOL VALUE (AUTO, DOS, UNIX)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSEOL         LD      A, (HL)
                CALL    UPCASE
                CP      #41             ; 'A'
                JR      Z, .EOLAUT
                CP      #44             ; 'D'
                JR      Z, .EOLDOS
                CP      #55             ; 'U'
                JR      Z, .EOLUNX
                RET
.EOLAUT         LD      A, 1
                LD      (AUTOLOD), A
                RET
.EOLDOS         XOR     A
                LD      (SAVEEOL), A
                LD      (AUTOLOD), A
                RET
.EOLUNX         LD      A, 1
                LD      (SAVEEOL), A
                XOR     A
                LD      (AUTOLOD), A
                RET


; --- PARSALN                   ----------------------------------------


; - PARSALN ----------------------------
; - PARSE AUTOALIGN VALUE (OFF, ON, DEV)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE. AN UNKNOWN VALUE LEAVES AUTOALGN AT ITS DEFAULT.
; - CLOBBERS: AF, HL (THE CALLER RESTORES HL FROM THE STACK)
; -

PARSALN         LD      A, (HL)
                CALL    UPCASE
                CP      'D'
                JR      Z, .ALNDEV

                ; OFF AND ON SHARE THEIR FIRST LETTER, SO THE ONE-LETTER
                ; TABLE THE OTHER KEYS USE CANNOT TELL THEM APART: IT SENT
                ; BOTH TO ITS 'O' SLOT AND AUTOALIGN=OFF TURNED AUTO-ALIGN
                ; ON.  THE SECOND LETTER DECIDES.
                CP      'O'
                RET     NZ              ; UNKNOWN VALUE: KEEP THE DEFAULT
                INC     HL
                LD      A, (HL)
                CALL    UPCASE
                CP      'N'
                JR      Z, .ALNON
                CP      'F'
                RET     NZ
                LD      A, ALGN_OFF
                JR      .ALNSET

.ALNON          LD      A, ALGN_ON
                JR      .ALNSET

.ALNDEV         LD      A, ALGN_DEV
.ALNSET         LD      (AUTOALGN), A
                RET


; --- PARSTHM                   ----------------------------------------


; - PARSTHM ----------------------------
; - PARSE THEME NAME AND LOAD THE THEME COLORS
; - S6ED: 8-BYTE V9938 PALETTE TABLES (4 COLORS, R/G/B) INTO PALDATA
; - S2ED: 7-BYTE TMS9918 COLOR TABLES (FG<<4|BG) INTO VCOLTXT..VCOLBG
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSTHM         LD      A, (HL)
                CALL    UPCASE
                SUB     #41             ; 'A'
                RET     C
                IFDEF   S2ED
                CP      #08             ; 8 ENTRIES (A-H)
                RET     NC
                LD      DE, S2TIDX
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                ADD     A, A
                LD      E, A
                LD      D, #00
                LD      HL, S2TPTR
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)
                EX      DE, HL
                ; FALL THROUGH TO .CPYTHM
.CPYTHM         LD      DE, VCOLTXT
                LD      BC, 7
                LDIR
                LD      A, #FF
                LD      (PALDIRT), A
                RET
                ELSE
                CP      #0D             ; 13 ENTRIES
                RET     NC
                LD      DE, THMIDX
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                CP      #04             ; 'M'?
                JR      NZ, .LOADPTR
                INC     HL
                LD      A, (HL)
                CALL    UPCASE
                CP      #4F             ; 'O'
                LD      A, #05          ; MONO
                JR      Z, .LOADPTR
                LD      A, #04          ; MSX
.LOADPTR        ADD     A, A
                LD      E, A
                LD      D, #00
                LD      HL, THMPTR
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)
                EX      DE, HL
                ; FALL THROUGH TO .CPYTHM
.CPYTHM         LD      DE, PALDATA
                LD      BC, 8
                LDIR
                LD      A, #FF
                LD      (PALDIRT), A
                RET
                ENDIF


; --- CFG PARSER TABLES         ----------------------------------------


PRFTBL          DEFB    #02, #FF, #FF, #FF, #FF, #FF, #FF, #FF
                DEFB    #FF, #FF, #FF, #FF, #FF, #FF, #00, #FF
                DEFB    #FF, #03, #01

MKPTBL          DEFB    #02, #01, #FF, #00

                IFDEF   S2ED
                ; A=AMBER, B=BLUE, D=DARK, G=GREEN (ELSE #FF = NO THEME)
S2TIDX          DEFB    #01, #03, #FF, #00, #FF, #FF, #02, #FF
S2TPTR          DEFW    S2THDKR, S2THMBR, S2THGRN, S2THBLU
                ELSE
THMIDX          DEFB    #01, #FF, #FF, #00, #FF, #FF, #02, #FF
                DEFB    #FF, #FF, #FF, #03, #04

THMPTR          DEFW    THMDEFT, THMAMBR, THMGRN, THMLGHT, THMMSX, THMMONO
                ENDIF

CLKTBL          DEFB    #00, #01

TABTBL          DEFB    #FF, #FF, #02, #FF, #04, #FF, #FF, #FF
                DEFB    #08, #FF


; --- PARSCOL                   ----------------------------------------


; - PARSCOL ----------------------------
; - PARSE R,G,B (0-7) AND STORE IN PALDATA
; - IN:  HL = POINTER TO "R,G,B" VALUE
; -      C  = COLOR INDEX (0-3)
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSCOL         PUSH    BC              ; SAVE COLOR INDEX IN C
                CALL    GETNUM          ; GET R (0-7)
                JR      NC, .POPABT
                LD      D, A            ; D = R
                CALL    SKPCOM          ; SKIP COMMA
                JR      NC, .POPABT
                CALL    GETNUM          ; GET G (0-7)
                JR      NC, .POPABT
                LD      E, A            ; E = G
                CALL    SKPCOM          ; SKIP COMMA
                JR      NC, .POPABT
                CALL    GETNUM          ; GET B (0-7)
                JR      NC, .POPABT
                ; D = R, E = G, A = B
                ; VDP FORMAT: BYTE 1 = (R << 4) | B, BYTE 2 = G
                SLA     D
                SLA     D
                SLA     D
                SLA     D               ; D = R << 4
                OR      D               ; A = (R << 4) | B
                POP     BC              ; C = COLOR INDEX
                PUSH    AF              ; SAVE BYTE 1
                LD      B, 0
                SLA     C               ; C = COLOR * 2
                LD      HL, PALDATA
                ADD     HL, BC          ; HL = PALDATA + COLOR * 2
                POP     AF              ; RESTORE BYTE 1
                LD      (HL), A         ; WRITE BYTE 1
                INC     HL
                LD      (HL), E         ; WRITE BYTE 2 (G)
                LD      A, #FF
                LD      (PALDIRT), A
                RET

.POPABT         POP     BC              ; RESTORE STACK ON ERROR
                RET


; --- GETNUM                    ----------------------------------------


; - GETNUM -----------------------------
; - SKIP SPACES, READ DIGIT 0-7, ADVANCE HL
; - IN:  HL = STRING POINTER
; - OUT: CY = 1: A = VALUE (0-7), HL ADVANCED PAST DIGIT
; -      CY = 0: INVALID
; - CLOBBERS: AF, HL
; -

GETNUM          LD      A, (HL)
                CP      ' '
                JR      Z, .SKP
                CP      9               ; TAB
                JR      NZ, .CHK
.SKP            INC     HL
                JR      GETNUM
.CHK            CP      '0'
                JR      C, .ERR
                CP      '8'
                JR      NC, .ERR
                SUB     '0'             ; A = 0..7
                INC     HL              ; ADVANCE PAST DIGIT
                SCF                     ; SUCCESS
                RET
.ERR            XOR     A               ; CY = 0 -> ERROR
                RET


; --- SKPCOM                    ----------------------------------------


; - SKPCOM -----------------------------
; - SKIP SPACES, EXPECT ',', SKIP SPACES
; - IN:  HL = STRING POINTER
; - OUT: CY = 1: SUCCESS, HL PAST COMMA AND SPACES
; -      CY = 0: COMMA NOT FOUND
; - CLOBBERS: AF, HL
; -

SKPCOM          LD      A, (HL)
                CP      ' '
                JR      Z, .S1
                CP      9               ; TAB
                JR      NZ, .CHK
.S1             INC     HL
                JR      SKPCOM
.CHK            CP      ','
                JR      NZ, .NOCOM
                INC     HL              ; PAST COMMA
.S2             LD      A, (HL)
                CP      ' '
                JR      Z, .S3
                CP      9               ; TAB
                JR      NZ, .OK
.S3             INC     HL
                JR      .S2
.OK             SCF
                RET
.NOCOM          XOR     A               ; CY = 0 -> NOT FOUND
                RET


; --- CFG DATA                  ----------------------------------------


                IFDEF   S2ED
CFGNAME         DEFM    "S2ED.CFG", 0
                ELSE
CFGNAME         DEFM    "S6ED.CFG", 0
                ENDIF
KEYPROF         DEFM    "PROFILE", 0
KEYWRAP         DEFM    "WRAP", 0
KEYMKUP         DEFM    "MARKUP", 0
KEYCLK          DEFM    "CLOCK", 0
KEYTAB          DEFM    "TABWIDTH", 0
KEYEOL          DEFM    "EOL", 0
KEYALN          DEFM    "AUTOALIGN", 0
KEYTHM          DEFM    "THEME", 0
KEYCBG          DEFM    "COLOR_BG", 0
KEYCTX          DEFM    "COLOR_TEXT", 0
KEYCFG          DEFM    "COLOR_FG", 0
KEYCUI          DEFM    "COLOR_UI", 0
KEYCHI          DEFM    "COLOR_HIGHLIGHT", 0
KEYCHIS         DEFM    "COLOR_HI", 0


; --- THEMES                    ----------------------------------------

                IFNDEF  S2ED
                ; 8 BYTES EACH: 4 COLORS * 2 BYTES (V9938 FORMAT)
                ; BYTE 1: (R << 4) | B,  BYTE 2: G
THMDEFT         DEFB    #00, #00, #77, #07, #17, #02, #70, #07
THMAMBR         DEFB    #00, #00, #70, #04, #20, #01, #70, #06
THMGRN          DEFB    #00, #00, #11, #07, #00, #02, #40, #07
THMMSX          DEFB    #15, #01, #77, #07, #27, #04, #70, #07
THMLGHT         DEFB    #77, #07, #00, #00, #55, #05, #06, #02
THMMONO         DEFB    #00, #00, #77, #07, #44, #04, #77, #07
                ENDIF
