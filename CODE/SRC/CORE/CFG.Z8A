; **********************************************
; * CFG.Z8A - CONFIGURATION FILE (S6ED.CFG)    *
; * ACCEPTS KEY=VALUE WITH OPTIONAL WHITESPACE *
; * AROUND '=' (E.G. "TABWIDTH = 8").          *
; **********************************************


; --- CFGLOAD                   ----------------------------------------


; - CFGLOAD ----------------------------
; - LOAD ONE CFG FILE IF PRESENT AND APPLY IT (CFGRUN CALLS IT ONCE FOR
; - THE GENERAL CFG NEXT TO THE PROGRAM AND ONCE FOR THE LOCAL ONE)
; - THE FILE IS STREAMED IN CLIPMAX-BYTE CHUNKS THROUGH CLIPBUF (IDLE
; - DURING INIT) AND EVERY COMPLETE LINE IS PARSED FROM LINBUF, SO THE
; - CFG SIZE IS NOT CAPPED BY ANY BUFFER: EOF IS A READ THAT RETURNS 0.
; - IN:  CFGFNP = ASCIIZ NAME OF THE FILE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CFGLOAD         LD      HL, (CFGFNP)
                CALL    DSKOPEN
                RET     C               ; FILE NOT FOUND: USE DEFAULTS
                LD      (CFGHAND), A

.RDCHNK         LD      A, (CFGHAND)
                LD      HL, CLIPMAX
                LD      DE, CLIPBUF
                CALL    DSKREAD         ; HL = BYTES READ (0 = EOF)
                LD      A, H
                OR      L
                JR      Z, .EOF
                LD      (CFGREM), HL
                LD      HL, CLIPBUF
                LD      (CFGPTR), HL

.CHR            LD      HL, (CFGREM)
                LD      A, H
                OR      L
                JR      Z, .RDCHNK      ; CHUNK EXHAUSTED: READ MORE
                DEC     HL
                LD      (CFGREM), HL
                LD      HL, (CFGPTR)
                LD      A, (HL)
                INC     HL
                LD      (CFGPTR), HL
                CP      13              ; CR
                JR      Z, .EOL
                CP      10              ; LF
                JR      Z, .EOL
                LD      C, A            ; KEEP THE CHARACTER
                LD      A, (CFGLEN)
                CP      LINMAX - 1
                JR      NC, .CHR        ; LINE FULL: DROP UNTIL EOL
                LD      E, A
                LD      D, 0
                LD      HL, LINBUF
                ADD     HL, DE
                LD      (HL), C
                INC     A
                LD      (CFGLEN), A
                JR      .CHR

.EOL            LD      A, (CFGLEN)
                OR      A
                JR      Z, .CHR         ; EMPTY LINE (INCL. THE LF OF CRLF)
                CALL    .TERMPRS
                JR      .CHR

.EOF            LD      A, (CFGHAND)
                CALL    DSKCLOSE
                LD      A, (CFGLEN)
                OR      A
                CALL    NZ, .TERMPRS    ; LAST LINE WITHOUT EOL

                LD      A, (PALDIRT)
                OR      A
                RET     Z
                ; S2ED'S SETPAL TAKES NO ARGUMENT: IT REAPPLIES THE ROLE
                ; VARIABLES A THEME= LINE JUST REWROTE. S6ED'S STREAMS THE
                ; V9938 PALETTE BLOCK AT HL.
                IFNDEF  S2ED
                LD      HL, PALDATA
                ENDIF
                JP      SETPAL

.TERMPRS        ; TERMINATE LINBUF, PARSE THE LINE, RESET THE LENGTH
                LD      A, (CFGLEN)
                LD      E, A
                LD      D, 0
                LD      HL, LINBUF
                ADD     HL, DE
                LD      (HL), 0
                XOR     A
                LD      (CFGLEN), A
                LD      HL, LINBUF
                JP      PRSLINE


; --- PRSLINE                   ----------------------------------------


; - PRSLINE ----------------------------
; - PARSE ONE NULL-TERMINATED CFG LINE
; - IN:  HL = LINE START (LINBUF)
; - OUT: NONE
; - CLOBBERS: ALL
; -

PRSLINE         LD      A, (HL)
                OR      A
                RET     Z               ; EMPTY LINE
                CP      ' '
                JR      Z, .NEXTCH
                CP      9               ; TAB
                JR      Z, .NEXTCH
                CP      ';'             ; COMMENT
                RET     Z
                CP      '#'             ; COMMENT
                RET     Z
                JR      .PARSLN

.NEXTCH         INC     HL
                JR      PRSLINE

.PARSLN         ; CHECK "PROFILE"
                PUSH    HL
                LD      DE, KEYPROF
                CALL    STRPREF
                JR      NC, .NOTPRF
                CALL    CFGVAL          ; "PROFILE = ..." ALSO ACCEPTED
                JR      NC, .NOTPRF
                CALL    PARSPRF
                POP     HL
                RET

.NOTPRF         POP     HL
                PUSH    HL
                LD      DE, KEYWRAP
                CALL    STRPREF
                JR      NC, .NOTWRP
                CALL    CFGVAL
                JR      NC, .NOTWRP
                CALL    PARSWRP
                POP     HL
                RET

.NOTWRP         POP     HL
                PUSH    HL
                LD      DE, KEYTW
                CALL    STRPREF
                JR      NC, .NOTTW1
                CALL    CFGVAL
                JR      NC, .NOTTW1
                CALL    PARSTW
                POP     HL
                RET

.NOTTW1         POP     HL
                PUSH    HL
                LD      DE, KEYTW2
                CALL    STRPREF
                JR      NC, .NOTTW2
                CALL    CFGVAL
                JR      NC, .NOTTW2
                CALL    PARSTW
                POP     HL
                RET

.NOTTW2         POP     HL
                PUSH    HL
                LD      DE, KEYMKUP
                CALL    STRPREF
                JR      NC, .NOTMKP
                CALL    CFGVAL
                JR      NC, .NOTMKP
                CALL    PARSMKP
                POP     HL
                RET

.NOTMKP         POP     HL
                PUSH    HL
                LD      DE, KEYCLK
                CALL    STRPREF
                JR      NC, .NOTCLK
                CALL    CFGVAL
                JR      NC, .NOTCLK
                CALL    PARSCLK
                POP     HL
                RET

.NOTCLK         POP     HL
                PUSH    HL
                LD      DE, KEYTAB
                CALL    STRPREF
                JR      NC, .NOTTAB
                CALL    CFGVAL
                JR      NC, .NOTTAB
                CALL    PARSTAB
                POP     HL
                RET

.NOTTAB         POP     HL
                PUSH    HL
                LD      DE, KEYEOL
                CALL    STRPREF
                JR      NC, .NOTEOL
                CALL    CFGVAL
                JR      NC, .NOTEOL
                CALL    PARSEOL
                POP     HL
                RET

.NOTEOL         POP     HL
                PUSH    HL
                LD      DE, KEYALN
                CALL    STRPREF
                JR      NC, .NOTALN
                CALL    CFGVAL
                JR      NC, .NOTALN
                CALL    PARSALN
                POP     HL
                RET

.NOTALN         POP     HL
                PUSH    HL
                LD      DE, KEYSHDW
                CALL    STRPREF
                JR      NC, .NOTSHD
                CALL    CFGVAL
                JR      NC, .NOTSHD
                CALL    PARSSHD
                POP     HL
                RET

.NOTSHD         POP     HL
                PUSH    HL
                LD      DE, KEYTHM
                CALL    STRPREF
                JR      NC, .NOTTHM
                CALL    CFGVAL
                JR      NC, .NOTTHM
                CALL    PARSTHM
                POP     HL
                RET

                IFDEF   S2ED
                ; NO COLOR_* KEYS ON S2ED. THE TMS9918 PALETTE IS FIXED, SO
                ; A ROLE IS A CHOICE OF WHICH OF THE 16 COLORS FILLS IT AND
                ; THAT CHOICE IS THE THEME. THE KEYS USED TO BE PARSED HERE
                ; AND WRITTEN INTO A PALDATA NO S2 CODE EVER READ -- ACCEPTED
                ; IN SILENCE AND DISCARDED. PARSCOL, GETNUM, SKPCOM AND THE
                ; SIX KEY STRINGS ARE EXCLUDED WITH THEM.
.NOTTHM
                ELSE
.NOTTHM         POP     HL
                PUSH    HL
                LD      DE, KEYCBG
                CALL    STRPREF
                JR      NC, .NOTCBG
                CALL    CFGVAL
                JR      NC, .NOTCBG
                LD      C, 0            ; COLOR 0 = BG
                CALL    PARSCOL
                POP     HL
                RET

.NOTCBG         POP     HL
                PUSH    HL
                LD      DE, KEYCTX
                CALL    STRPREF
                JR      C, .ISCTX
                ; TRY ALIAS "COLOR_FG"
                POP     HL
                PUSH    HL
                LD      DE, KEYCFG
                CALL    STRPREF
                JR      NC, .NOTCTX
.ISCTX          CALL    CFGVAL
                JR      NC, .NOTCTX
                LD      C, 1            ; COLOR 1 = FG / TEXT
                CALL    PARSCOL
                POP     HL
                RET

.NOTCTX         POP     HL
                PUSH    HL
                LD      DE, KEYCUI
                CALL    STRPREF
                JR      NC, .NOTCUI
                CALL    CFGVAL
                JR      NC, .NOTCUI
                LD      C, 2            ; COLOR 2 = UI
                CALL    PARSCOL
                POP     HL
                RET

.NOTCUI         POP     HL
                PUSH    HL
                LD      DE, KEYCHI
                CALL    STRPREF
                JR      C, .ISCHI
                ; TRY ALIAS "COLOR_HI"
                POP     HL
                PUSH    HL
                LD      DE, KEYCHIS
                CALL    STRPREF
                JR      NC, .NOTCHI
.ISCHI          CALL    CFGVAL
                JR      NC, .NOTCHI
                LD      C, 3            ; COLOR 3 = HIGHLIGHT
                CALL    PARSCOL
                POP     HL
                RET

                ENDIF

.NOTCHI         POP     HL
                RET


; --- STRPREF                   ----------------------------------------


; - STRPREF ----------------------------
; - MATCH NULL-TERMINATED PREFIX AT HL
; - IN:  HL = INPUT STRING
; -      DE = PREFIX STRING (ASCIIZ)
; - OUT: CY = 1 IF MATCH, HL ADVANCED PAST PREFIX
; -      CY = 0 IF NO MATCH
; - CLOBBERS: A, B, DE
; -

STRPREF         LD      A, (DE)
                OR      A
                JR      Z, .MATCH
                LD      B, A
                LD      A, (HL)
                CP      B
                JR      NZ, .NOMTCH
                INC     HL
                INC     DE
                JR      STRPREF
.MATCH          SCF
                RET
.NOMTCH         XOR     A
                RET


; --- CFGVAL                    ----------------------------------------


; - CFGVAL -----------------------------
; - AFTER A KEY PREFIX MATCH: SKIP
; - WHITESPACE, REQUIRE '=', THEN SKIP
; - WHITESPACE AGAIN
; - IN:  HL = POSITION AFTER KEY
; - OUT: CY = 1: HL = START OF VALUE
; -      CY = 0: NOT A KEY ASSIGNMENT
; - CLOBBERS: A, HL
; -

CFGVAL          ; SKIP WHITESPACE BEFORE '='
.PRE            LD      A, (HL)
                CP      ' '
                JR      Z, .PRE1
                CP      9               ; TAB
                JR      NZ, .EQ
.PRE1           INC     HL
                JR      .PRE

.EQ             CP      '='
                JR      NZ, .NO
                INC     HL

.POST           ; SKIP WHITESPACE AFTER '='
                LD      A, (HL)
                CP      ' '
                JR      Z, .POST1
                CP      9               ; TAB
                JR      NZ, .YES
.POST1          INC     HL
                JR      .POST

.YES            SCF
                RET
.NO             XOR     A
                RET


; --- UPCASE                    ----------------------------------------


; - UPCASE -----------------------------
; - CONVERT ASCII LOWERCASE TO UPPERCASE
; - IN:  A = CHARACTER
; - OUT: A = UPPERCASE CHARACTER (UNCHANGED IF NOT LOWERCASE)
; - CLOBBERS: F
; -

UPCASE          CP      #61             ; 'a'
                RET     C
                CP      #7B             ; 'z' + 1
                RET     NC
                SUB     #20             ; ASCII CASE DISTANCE
                RET


; --- PARSPRF                   ----------------------------------------


; - PARSPRF ----------------------------
; - PARSE PROFILE VALUE (STD, WS, EMC, VI)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSPRF         LD      A, (HL)
                CALL    UPCASE
                SUB     #45             ; 'E'
                RET     C
                CP      #13             ; 19 ENTRIES
                RET     NC
                LD      DE, PRFTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                LD      (KMAPID), A
                JP      KMAPSW


; --- PARSWRP                   ----------------------------------------


; - PARSWRP ----------------------------
; - PARSE WRAP VALUE (DEV, TXT)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSWRP         LD      A, (HL)
                CALL    UPCASE
                CP      #44             ; 'D'
                JR      Z, .SETDEV
                CP      #54             ; 'T'
                JR      Z, .SETTXT
                RET
.SETDEV         XOR     A
                LD      (WRAPMODE), A
                LD      (TXTWIDTH), A
                RET
.SETTXT         LD      A, 1
                LD      (WRAPMODE), A
                LD      A, (TXTWIDTH)
                OR      A
                RET     NZ
                LD      A, (SAVETW)
                OR      A
                JR      NZ, .HAVSTW
                LD      A, TEXTCOLS
.HAVSTW         LD      (TXTWIDTH), A
                RET


; --- PARSTW                    ----------------------------------------


; - PARSTW -----------------------------
; - PARSE TXTWIDTH VALUE (0..255)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSTW          CALL    ATOI16
                LD      A, H
                OR      A
                JR      Z, .WOK
                LD      L, 255
.WOK            LD      A, L
                LD      (TXTWIDTH), A
                OR      A
                JR      Z, .TWZERO
                LD      (SAVETW), A
                LD      A, WRAP_TXT
                LD      (WRAPMODE), A
                RET
.TWZERO         LD      A, WRAP_DEV
                LD      (WRAPMODE), A
                RET


; --- PARSMKP                   ----------------------------------------


; - PARSMKP ----------------------------
; - PARSE MARKUP VALUE (OFF, MD, LIT)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSMKP         LD      A, (HL)
                CALL    UPCASE
                SUB     #4C             ; 'L'
                RET     C
                CP      #04
                RET     NC
                LD      DE, MKPTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                LD      (MKUPMD), A
                RET


; --- PARSCLK                   ----------------------------------------


; - PARSCLK ----------------------------
; - PARSE CLOCK VALUE (0, 1)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSCLK         LD      A, (HL)
                SUB     #30             ; '0'
                RET     C
                CP      #02
                RET     NC
                LD      DE, CLKTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                LD      (SHOWCLK), A
                RET


; --- PARSTAB                   ----------------------------------------


; - PARSTAB ----------------------------
; - PARSE TABWIDTH VALUE (2, 4, 8)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF, DE
; -

PARSTAB         LD      A, (HL)
                SUB     #30             ; '0'
                RET     C
                CP      #0A             ; 10 ENTRIES
                RET     NC
                LD      DE, TABTBL
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                LD      (TABWIDTH), A
                RET


; --- PARSEOL                   ----------------------------------------


; - PARSEOL ----------------------------
; - PARSE EOL VALUE (AUTO, DOS, UNIX)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSEOL         LD      A, (HL)
                CALL    UPCASE
                CP      #41             ; 'A'
                JR      Z, .EOLAUT
                CP      #44             ; 'D'
                JR      Z, .EOLDOS
                CP      #55             ; 'U'
                JR      Z, .EOLUNX
                RET
.EOLAUT         LD      A, 1
                LD      (AUTOLOD), A
                RET
.EOLDOS         XOR     A
                LD      (SAVEEOL), A
                LD      (AUTOLOD), A
                RET
.EOLUNX         LD      A, 1
                LD      (SAVEEOL), A
                XOR     A
                LD      (AUTOLOD), A
                RET


; --- PARSALN                   ----------------------------------------


; - PARSALN ----------------------------
; - PARSE AUTOALIGN VALUE (OFF, ON, DEV)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE. AN UNKNOWN VALUE LEAVES AUTOALGN AT ITS DEFAULT.
; - CLOBBERS: AF, HL (THE CALLER RESTORES HL FROM THE STACK)
; -

PARSALN         LD      A, (HL)
                CALL    UPCASE
                CP      'D'
                JR      Z, .ALNDEV

                ; OFF AND ON SHARE THEIR FIRST LETTER, SO THE ONE-LETTER
                ; TABLE THE OTHER KEYS USE CANNOT TELL THEM APART: IT SENT
                ; BOTH TO ITS 'O' SLOT AND AUTOALIGN=OFF TURNED AUTO-ALIGN
                ; ON.  THE SECOND LETTER DECIDES.
                CP      'O'
                RET     NZ              ; UNKNOWN VALUE: KEEP THE DEFAULT
                INC     HL
                LD      A, (HL)
                CALL    UPCASE
                CP      'N'
                JR      Z, .ALNON
                CP      'F'
                RET     NZ
                LD      A, ALGN_OFF
                JR      .ALNSET

.ALNON          LD      A, ALGN_ON
                JR      .ALNSET

.ALNDEV         LD      A, ALGN_DEV
.ALNSET         LD      (AUTOALGN), A
                RET


; --- PARSSHD                   ----------------------------------------


; - PARSSHD ----------------------------
; - PARSE THE DROP SHADOW SETTING
; - S2ED: "OFF" OR ONE HEX DIGIT 0-F, A TMS9918 COLOR INDEX. THE CELL IS
; -   FLATTENED (N << 4 | N) BECAUSE A SHADOW CELL KEEPS THE DOCUMENT'S
; -   PATTERN AND ONLY REPLACES ITS COLOR. OFF SKIPS THE MARGIN ENTIRELY.
; - S6ED: "BG", "FG", "UI" OR "HI" -- SCREEN 6 HAS FOUR COLORS ON SCREEN
; -   AND ALL FOUR ARE SPOKEN FOR, SO THE SHADOW CAN ONLY BORROW ONE.
; -   "OFF" IS AN ALIAS OF "BG": THE BARS MUST STILL BE PAINTED OR THE
; -   COMPOSITION BUFFER BLITS STALE DATA, AND CLR_BG IS WHAT "NO SHADOW"
; -   LOOKS LIKE THERE.
; - TWO CHARACTERS DECIDE, NEVER ONE: AUTOALIGN=OFF/ON COST A SPRINT.
; - AN UNKNOWN VALUE LEAVES THE DEFAULT ALONE.
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSSHD         LD      A, (HL)
                CALL    UPCASE
                LD      C, A            ; C = FIRST CHARACTER
                INC     HL
                LD      A, (HL)
                CALL    UPCASE
                LD      B, A            ; B = SECOND CHARACTER

                IFDEF   S2ED
                LD      A, C
                CP      'O'
                JR      NZ, .S2COL
                LD      A, B
                CP      'F'
                RET     NZ              ; NOT "OF..." -- LEAVE THE DEFAULT
                LD      A, #FF
                LD      (SHDWOFF), A
                RET

.S2COL          LD      A, C            ; A HEX DIGIT: 0-9 OR A-F
                CP      '0'
                RET     C
                CP      '9' + 1
                JR      C, .S2DIG
                CP      'A'
                RET     C
                CP      'F' + 1
                RET     NC
                SUB     'A' - 10
                JR      .S2SET
.S2DIG          SUB     '0'
.S2SET          LD      C, A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; A = N << 4
                OR      C               ; FLATTEN: N << 4 | N
                LD      (VCOLSHDW), A
                XOR     A
                LD      (SHDWOFF), A
                RET
                ELSE
                LD      A, B
                CP      'G'             ; "BG" / "FG"
                JR      NZ, .S6ALT
                LD      A, C
                CP      'B'
                JR      NZ, .S6FG
                LD      A, CLR_BG
                JR      .S6SET
.S6FG           CP      'F'
                RET     NZ
                LD      A, CLR_FG
                JR      .S6SET
.S6ALT          LD      A, C
                CP      'U'             ; "UI"
                JR      NZ, .S6HI
                LD      A, B
                CP      'I'
                RET     NZ
                LD      A, CLR_UI
                JR      .S6SET
.S6HI           CP      'H'             ; "HI"
                JR      NZ, .S6OFF
                LD      A, B
                CP      'I'
                RET     NZ
                LD      A, CLR_HI
                JR      .S6SET
.S6OFF          CP      'O'             ; "OFF" == "BG" ON FOUR COLORS
                RET     NZ
                LD      A, B
                CP      'F'
                RET     NZ
                LD      A, CLR_BG
.S6SET          LD      (SHDWCLR), A
                RET
                ENDIF


; --- PARSTHM                   ----------------------------------------


; - PARSTHM ----------------------------
; - PARSE THEME NAME AND LOAD THE THEME COLORS
; - S6ED: 8-BYTE V9938 PALETTE TABLES (4 COLORS, R/G/B) INTO PALDATA
; - S2ED: VCOLNUM-BYTE TMS9918 COLOR TABLES (FG<<4|BG) INTO VCOLTXT..
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSTHM         LD      A, (HL)
                CALL    UPCASE
                SUB     #41             ; 'A'
                RET     C
                IFDEF   S2ED
                CP      #0D             ; 13 ENTRIES (A-M): MSX IS INDEX 12
                RET     NC
                LD      DE, S2TIDX
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                JP      APPLYTHM
                ELSE
                CP      #0D             ; 13 ENTRIES
                RET     NC
                LD      DE, THMIDX
                ADD     A, E
                LD      E, A
                ADC     A, D
                SUB     E
                LD      D, A
                LD      A, (DE)
                CP      #FF
                RET     Z
                CP      #04             ; 'M'?
                JR      NZ, .LOADPTR
                INC     HL
                LD      A, (HL)
                CALL    UPCASE
                CP      #4F             ; 'O'
                LD      A, #05          ; MONO
                JR      Z, .LOADPTR
                LD      A, #04          ; MSX
.LOADPTR        JP      APPLYTHM
                ENDIF


; --- APPLYTHM                  ----------------------------------------


; - APPLYTHM ---------------------------
; - APPLY THEME BY NUMERIC ID (0..3 FOR S2ED, 0..5 FOR S6ED)
; - IN:  A = THEME ID
; - OUT: NONE
; - CLOBBERS: ALL
; -

APPLYTHM        LD      (THEMEID), A
                IFDEF   S2ED
                CP      4
                RET     NC
                ADD     A, A
                LD      E, A
                LD      D, 0
                LD      HL, S2TPTR
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)
                EX      DE, HL
                LD      DE, VCOLTXT
                LD      BC, VCOLNUM
                LDIR
                LD      A, #FF
                LD      (PALDIRT), A
                JP      SETPAL
                ELSE
                CP      6
                RET     NC
                ADD     A, A
                LD      E, A
                LD      D, 0
                LD      HL, THMPTR
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)
                EX      DE, HL
                LD      DE, PALDATA
                LD      BC, 8
                LDIR
                LD      A, #FF
                LD      (PALDIRT), A
                LD      HL, PALDATA
                JP      SETPAL
                ENDIF


; --- CFGSAVE                   ----------------------------------------


; - CFGSAVE ----------------------------
; - SERIALIZE ACTIVE SETTINGS TO LOADED .CFG FILE
; - IN:  NONE (USES CFGLOC, HOMEFN, ACTIVE SETTING VARIABLES)
; - OUT: CY = 0: SUCCESS, CY = 1: DISK ERROR
; - CLOBBERS: ALL
; -

CFGSAVE         LD      A, (CFGLOC)
                OR      A
                JR      NZ, .LOCAL
                LD      HL, CFGNAME
                CALL    HOMEFN
                JR      .DOWR
.LOCAL          LD      HL, CFGNAME
.DOWR           CALL    DSKCREAT
                RET     C
                LD      (CFGHAND), A

                ; 1. PROFILE
                LD      DE, KEYPROF
                LD      A, (KMAPID)
                AND     3
                LD      HL, .PRFV
                CALL    .WRLIST

                ; 2. WRAP
                LD      DE, KEYWRAP
                LD      A, (WRAPMODE)
                AND     1
                LD      HL, .WRPV
                CALL    .WRLIST

                ; 3. AUTOALIGN
                LD      DE, KEYALN
                LD      A, (AUTOALGN)
                CP      3
                JR      C, .ALNOK
                XOR     A
.ALNOK          LD      HL, .ALNV
                CALL    .WRLIST

                ; 4. CLOCK
                LD      DE, KEYCLK
                LD      A, (SHOWCLK)
                AND     1
                LD      HL, .CLKV
                CALL    .WRLIST

                ; 5. TABWIDTH
                LD      DE, KEYTAB
                LD      A, (TABWIDTH)
                SRL     A
                SRL     A               ; 2->0, 4->1, 8->2
                LD      HL, .TABV
                CALL    .WRLIST

                ; 6. EOL
                LD      DE, KEYEOL
                XOR     A
                LD      HL, AUTOLOD
                OR      (HL)
                JR      NZ, .ELOK       ; A = 0 (AUTO)
                LD      A, (SAVEEOL)
                INC     A               ; DOS(0)->1, UNIX(1)->2
.ELOK           LD      HL, .EOLV
                CALL    .WRLIST

                ; 7. MARKUP
                LD      DE, KEYMKUP
                LD      A, (MKUPMD)
                CP      3
                JR      C, .MKPOK
                XOR     A
.MKPOK          LD      HL, .MKPV
                CALL    .WRLIST

                ; 8. THEME
                LD      DE, KEYTHM
                LD      A, (THEMEID)
                IFDEF   S2ED
                AND     3
                LD      HL, .S2THMV
                ELSE
                CP      6
                JR      C, .THMOK
                XOR     A
.THMOK          LD      HL, .S6THMV
                ENDIF
                CALL    .WRLIST

                ; CLOSE FILE
                LD      A, (CFGHAND)
                CALL    DSKCLOSE
                OR      A
                RET

.WRLIST         ; IN: DE = KEY STRING, HL = VALUE TABLE, A = INDEX
                ADD     A, A
                PUSH    DE
                LD      E, A
                LD      D, 0
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)         ; DE = VALUE STRING
                POP     HL              ; HL = KEY STRING
                ; FALL THROUGH TO .WRPAR

.WRPAR          ; IN: HL = KEY STRING, DE = VALUE STRING
                PUSH    DE
                CALL    .WRS            ; WRITE KEY
                LD      HL, 1
                LD      DE, .STREQ
                LD      A, (CFGHAND)
                CALL    DSKWRITE        ; WRITE '='
                POP     HL
                CALL    .WRS            ; WRITE VALUE
                LD      HL, 2
                LD      DE, .CRLF
                LD      A, (CFGHAND)
                JP      DSKWRITE        ; WRITE CRLF

.WRS            ; IN: HL = ASCIIZ STRING
                PUSH    HL
                LD      BC, 0
.SLEN           LD      A, (HL)
                OR      A
                JR      Z, .SOK
                INC     HL
                INC     BC
                JR      .SLEN
.SOK            LD      H, B
                LD      L, C
                POP     DE              ; DE = STRING, HL = LEN
                LD      A, (CFGHAND)
                JP      DSKWRITE

.STREQ          DEFM    "="
.CRLF           DEFB    13, 10

.PRFV           DEFW    .SVP0, .SVP1, .SVP2, .SVP3
.SVP0           DEFM    "STD", 0
.SVP1           DEFM    "WS", 0
.SVP2           DEFM    "EMC", 0
.SVP3           DEFM    "VI", 0

.WRPV           DEFW    .SVW0, .SVW1
.SVW0           DEFM    "DEV", 0
.SVW1           DEFM    "TXT", 0

.ALNV           DEFW    .SVA0, .SVA1, .SVA2
.SVA0           DEFM    "OFF", 0
.SVA1           DEFM    "ON", 0
.SVA2           DEFM    "DEV", 0

.CLKV           DEFW    .SVC0, .SVC1
.SVC0           DEFM    "0", 0
.SVC1           DEFM    "1", 0

.TABV           DEFW    .SVT0, .SVT1, .SVT2
.SVT0           DEFM    "2", 0
.SVT1           DEFM    "4", 0
.SVT2           DEFM    "8", 0

.EOLV           DEFW    .SVE0, .SVE1, .SVE2
.SVE0           DEFM    "AUTO", 0
.SVE1           DEFM    "DOS", 0
.SVE2           DEFM    "UNIX", 0

.MKPV           DEFW    .SVM0, .SVM1, .SVM2
.SVM0           DEFM    "OFF", 0
.SVM1           DEFM    "MD", 0
.SVM2           DEFM    "LIT", 0

                IFDEF   S2ED
.S2THMV         DEFW    .S2TD, .S2TA, .S2TG, .S2TM
.S2TD           DEFM    "DARK", 0
.S2TA           DEFM    "AMBER", 0
.S2TG           DEFM    "GREEN", 0
.S2TM           DEFM    "MSX", 0
                ELSE
.S6THMV         DEFW    .S6TD, .S6TA, .S6TG, .S6TL, .S6TM, .S6TO
.S6TD           DEFM    "DEFAULT", 0
.S6TA           DEFM    "AMBER", 0
.S6TG           DEFM    "GREEN", 0
.S6TL           DEFM    "LIGHT", 0
.S6TM           DEFM    "MSX", 0
.S6TO           DEFM    "MONO", 0
                ENDIF


; --- CFG PARSER TABLES         ----------------------------------------


PRFTBL          DEFB    #02, #FF, #FF, #FF, #FF, #FF, #FF, #FF
                DEFB    #FF, #FF, #FF, #FF, #FF, #FF, #00, #FF
                DEFB    #FF, #03, #01

MKPTBL          DEFB    #02, #01, #FF, #00

                IFDEF   S2ED
                ; A=AMBER, B=BLUE, D=DARK, G=GREEN (ELSE #FF = NO THEME)
                ; ONE ENTRY PER LETTER A..M, SO THE DISPATCH ON THE FIRST
                ; LETTER REACHES MSX. #FF = NO THEME WITH THAT INITIAL.
S2TIDX          DEFB    #01, #FF, #FF, #00, #FF, #FF, #02, #FF
                DEFB    #FF, #FF, #FF, #FF, #03
S2TPTR          DEFW    S2THDKR, S2THMBR, S2THGRN, S2THMSX
                ELSE
THMIDX          DEFB    #01, #FF, #FF, #00, #FF, #FF, #02, #FF
                DEFB    #FF, #FF, #FF, #03, #04

THMPTR          DEFW    THMDEFT, THMAMBR, THMGRN, THMLGHT, THMMSX, THMMONO
                ENDIF

CLKTBL          DEFB    #00, #01

TABTBL          DEFB    #FF, #FF, #02, #FF, #04, #FF, #FF, #FF
                DEFB    #08, #FF


                IFNDEF  S2ED
; --- PARSCOL                   ----------------------------------------


; - PARSCOL ----------------------------
; - PARSE R,G,B (0-7) AND STORE IN PALDATA
; - IN:  HL = POINTER TO "R,G,B" VALUE
; -      C  = COLOR INDEX (0-3)
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSCOL         PUSH    BC              ; SAVE COLOR INDEX IN C
                CALL    GETNUM          ; GET R (0-7)
                JR      NC, .POPABT
                LD      D, A            ; D = R
                CALL    SKPCOM          ; SKIP COMMA
                JR      NC, .POPABT
                CALL    GETNUM          ; GET G (0-7)
                JR      NC, .POPABT
                LD      E, A            ; E = G
                CALL    SKPCOM          ; SKIP COMMA
                JR      NC, .POPABT
                CALL    GETNUM          ; GET B (0-7)
                JR      NC, .POPABT
                ; D = R, E = G, A = B
                ; VDP FORMAT: BYTE 1 = (R << 4) | B, BYTE 2 = G
                SLA     D
                SLA     D
                SLA     D
                SLA     D               ; D = R << 4
                OR      D               ; A = (R << 4) | B
                POP     BC              ; C = COLOR INDEX
                PUSH    AF              ; SAVE BYTE 1
                LD      B, 0
                SLA     C               ; C = COLOR * 2
                LD      HL, PALDATA
                ADD     HL, BC          ; HL = PALDATA + COLOR * 2
                POP     AF              ; RESTORE BYTE 1
                LD      (HL), A         ; WRITE BYTE 1
                INC     HL
                LD      (HL), E         ; WRITE BYTE 2 (G)
                LD      A, #FF
                LD      (PALDIRT), A
                RET

.POPABT         POP     BC              ; RESTORE STACK ON ERROR
                RET


; --- GETNUM                    ----------------------------------------


; - GETNUM -----------------------------
; - SKIP SPACES, READ DIGIT 0-7, ADVANCE HL
; - IN:  HL = STRING POINTER
; - OUT: CY = 1: A = VALUE (0-7), HL ADVANCED PAST DIGIT
; -      CY = 0: INVALID
; - CLOBBERS: AF, HL
; -

GETNUM          LD      A, (HL)
                CP      ' '
                JR      Z, .SKP
                CP      9               ; TAB
                JR      NZ, .CHK
.SKP            INC     HL
                JR      GETNUM
.CHK            CP      '0'
                JR      C, .ERR
                CP      '8'
                JR      NC, .ERR
                SUB     '0'             ; A = 0..7
                INC     HL              ; ADVANCE PAST DIGIT
                SCF                     ; SUCCESS
                RET
.ERR            XOR     A               ; CY = 0 -> ERROR
                RET


; --- SKPCOM                    ----------------------------------------


; - SKPCOM -----------------------------
; - SKIP SPACES, EXPECT ',', SKIP SPACES
; - IN:  HL = STRING POINTER
; - OUT: CY = 1: SUCCESS, HL PAST COMMA AND SPACES
; -      CY = 0: COMMA NOT FOUND
; - CLOBBERS: AF, HL
; -

SKPCOM          LD      A, (HL)
                CP      ' '
                JR      Z, .S1
                CP      9               ; TAB
                JR      NZ, .CHK
.S1             INC     HL
                JR      SKPCOM
.CHK            CP      ','
                JR      NZ, .NOCOM
                INC     HL              ; PAST COMMA
.S2             LD      A, (HL)
                CP      ' '
                JR      Z, .S3
                CP      9               ; TAB
                JR      NZ, .OK
.S3             INC     HL
                JR      .S2
.OK             SCF
                RET
.NOCOM          XOR     A               ; CY = 0 -> NOT FOUND
                RET


                ENDIF


; --- CFG DATA                  ----------------------------------------


KEYPROF         DEFM    "PROFILE", 0
KEYWRAP         DEFM    "WRAP", 0
KEYTW           DEFM    "TEXTWIDTH", 0
KEYTW2          DEFM    "TW", 0
KEYMKUP         DEFM    "MARKUP", 0
KEYCLK          DEFM    "CLOCK", 0
KEYTAB          DEFM    "TABWIDTH", 0
KEYEOL          DEFM    "EOL", 0
KEYALN          DEFM    "AUTOALIGN", 0
KEYSHDW         DEFM    "SHADOW", 0
KEYTHM          DEFM    "THEME", 0
                IFNDEF  S2ED
KEYCBG          DEFM    "COLOR_BG", 0
KEYCTX          DEFM    "COLOR_TEXT", 0
KEYCFG          DEFM    "COLOR_FG", 0
KEYCUI          DEFM    "COLOR_UI", 0
KEYCHI          DEFM    "COLOR_HIGHLIGHT", 0
KEYCHIS         DEFM    "COLOR_HI", 0
                ENDIF


; --- THEMES                    ----------------------------------------

                IFNDEF  S2ED
                ; 8 BYTES EACH: 4 COLORS * 2 BYTES (V9938 FORMAT)
                ; BYTE 1: (R << 4) | B,  BYTE 2: G
THMDEFT         DEFB    #00, #00, #77, #07, #17, #02, #70, #07
THMAMBR         DEFB    #00, #00, #70, #04, #20, #01, #70, #06
THMGRN          DEFB    #00, #00, #11, #07, #00, #02, #40, #07
THMMSX          DEFB    #15, #01, #77, #07, #27, #04, #70, #07
THMLGHT         DEFB    #77, #07, #00, #00, #55, #05, #06, #02
THMMONO         DEFB    #00, #00, #77, #07, #44, #04, #77, #07
                ENDIF
