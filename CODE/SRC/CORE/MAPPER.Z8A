;                                       ****************************************
;                                       * MAPPER MANAGER                       *
;                                       ****************************************
;
; USES DOS2/NEXTOR MAPPER SUPPORT ROUTINES FOUND VIA EXTBIO.
; NEVER USE OUT (#0FE) DIRECTLY — ALWAYS GO THROUGH MPUTP2.
;
; INIT: CALL MAPINIT AT STARTUP. STORES ENTRY ADDRESSES IN VARS.
; AFTER INIT: CALL ALLSEG, FRESEG, PUTP1, GETP1, PUTP2, GETP2 -- OR SEGGET /
; SEGFREE / SEGTRIM, WHICH TRACK WHAT THEY HAND OUT AND ARE WHAT THE EDITOR
; ACTUALLY USES.
;
; RD_SEG / WR_SEG ARE NOT RESOLVED. THE WRAPPERS EXISTED AND WERE NEVER CALLED,
; SO THEY WENT WITH THE REST OF THE DEAD CODE; MJRDSEG / MJWRSEG ARE STILL IN
; HARD.Z8A AND EACH TABLE ENTRY IS COMPUTED INDEPENDENTLY FROM THE BASE, SO
; BRINGING THEM BACK FOR THE .DAT LOADER IS FOUR LINES.


; --- MAPINIT                   ----------------------------------------

; - MAPINIT ----------
; - LOCATE MAPPER MANAGER VIA EXTBIO
; - FILL MAP_XXX JUMP TABLE ENTRIES IN VARS
; - OUTPUT:
; -     CY = 1  NO MAPPER MANAGER (NO EXTENDED BIOS OR DEVICE NOT PRESENT)
; -

MAPINIT         DBG     "MAPINIT: ENTER"
                LD      A, (HOKVLD)
                DBG     "MAPINIT: HOKVLD READ"
                RRA
                JR      C, .HOKOK
                DBG     "MAPINIT: NO HOKVLD"
                SCF
                RET                     ; CY = 1: NO EXTENDED BIOS

.HOKOK          DBG     "MAPINIT: HOKOK"
                XOR     A               ; A=0
                LD      D, MAP_DEV
                LD      E, MAPFNTBL
                DBG     "MAPINIT: BEFORE EXTBIO"
                CALL    EXTBIO          ; HL = JUMP TABLE BASE
                DBG     "MAPINIT: AFTER EXTBIO"
                OR      A
                JR      NZ, .MAPOK
                DBG     "MAPINIT: EXTBIO A=0"
                SCF
                RET                     ; CY = 1: NO MAPPER MANAGER

.MAPOK          DBG     "MAPINIT: MAPOK"
                LD      (SEGTOT), A     ; SAVE TOTAL MAPPER SEGMENTS (EXTBIO)
                PUSH    HL
                LD      DE, MJALLSEG
                ADD     HL, DE
                LD      (MALLSEG), HL

                POP     HL
                PUSH    HL
                LD      DE, MJFRESEG
                ADD     HL, DE
                LD      (MFRESEG), HL

                POP     HL
                PUSH    HL
                LD      DE, MJPUTP1
                ADD     HL, DE
                LD      (MPUTP1), HL

                POP     HL
                PUSH    HL
                LD      DE, MJGETP1
                ADD     HL, DE
                LD      (MGETP1), HL

                POP     HL
                PUSH    HL
                LD      DE, MJPUTP2
                ADD     HL, DE
                LD      (MPUTP2), HL

                POP     HL
                LD      DE, MJGETP2
                ADD     HL, DE
                LD      (MGETP2), HL

                LD      A, #FF
                LD      (MAPRDY), A    ; FLAG: MAPPER MANAGER FOUND
                AND     A               ; CARRY CLEAR = SUCCESS
                RET


; --- ALLSEG                    ----------------------------------------

; - ALLSEG -----------
; - ALLOCATE ONE 16KB USER SEGMENT (PRIMARY MAPPER)
; - OUTPUT:
; -     A  = SEGMENT NUMBER (FC = 0)
; -     FC = 1  NO FREE SEGMENTS
; -

ALLSEG          XOR     A               ; A=0: USER SEGMENT, B=0: PRIMARY MAPPER
                LD      B, A
                LD      HL, (MALLSEG)
                JP      CALHL


; --- FRESEG                    ----------------------------------------

; - FRESEG -----------
; - FREE A PREVIOUSLY ALLOCATED SEGMENT
; - A: SEGMENT NUMBER
; - OUTPUT:
; -     FC = 1  ERROR (INVALID OR ALREADY FREE)
; -

FRESEG          LD      B, 0            ; B=0: PRIMARY MAPPER
                LD      HL, (MFRESEG)
                JP      CALHL


; --- PUTP1                     ----------------------------------------

; - PUTP1 ------------
; - BANK SEGMENT INTO PAGE 1 (#4000-#7FFF)
; - A: SEGMENT NUMBER
; - CLOBBERS: HL ONLY (SEE THE NOTE IN PUTP2)
; -
; - ONLY TERM USES THIS, TO HAND DEFSEG1 BACK TO DOS. PAGE 1 IS NOT A
; - USABLE WINDOW: THE RUNNING CODE LIVES THERE, AND THE DISK ROM BANKS
; - ITSELF OVER IT WHENEVER DISK CODE RUNS, SO NOTHING MAY BE STORED IN
; - PAGE 1 BEHIND AN INTERRUPT AND NO INTERRUPT HOOK MAY POINT INTO IT.
; - MEASURED ON PHILIPS NMS 8250: H.TIMI FIRED WITH THE FDC ROM IN PAGE 1
; - 3 TIMES IN 2174 CALLS ON AN IDLE EDITOR.

PUTP1           LD      HL, (MPUTP1)
                JP      CALHL


; --- GETP1                     ----------------------------------------

; - GETP1 ------------
; - GET CURRENTLY BANKED SEGMENT AT PAGE 1
; - OUTPUT:
; -     A: SEGMENT NUMBER
; - CLOBBERS: AF, HL (SEE THE NOTE IN PUTP2)
; -

GETP1           LD      HL, (MGETP1)
                JP      CALHL


; --- PUTP2                     ----------------------------------------

; - PUTP2 ------------
; - BANK SEGMENT INTO PAGE 2 (#8000-#BFFF) — TEXT WINDOW
; - A: SEGMENT NUMBER
; - CLOBBERS: HL ONLY
; -
; - THE MAPPER MANAGER ROUTINE ITSELF PRESERVES EVERY REGISTER, WHICH IS WHY
; - BC AND DE SURVIVE A BANK IN THE MIDDLE OF A BLOCK MOVE SETUP (LINEINS).
; - THIS WRAPPER DOES NOT: IT LOADS THE ROUTINE ADDRESS INTO HL TO REACH IT.
; - THE HEADER USED TO CLAIM "ALL REGISTERS PRESERVED" AND THAT COST A LIVE
; - BUG -- DIRBANK CALLED PUTP2 WITH THE LINE NUMBER IN HL, SO EVERY DIRECTORY
; - ENTRY WAS READ AND WRITTEN AT A GARBAGE ADDRESS AND THE WHOLE DOCUMENT
; - RENDERED AS THE LAST RECORD.
; -

PUTP2           LD      HL, (MPUTP2)
                JP      CALHL


; --- GETP2                     ----------------------------------------

; - GETP2 ------------
; - GET CURRENTLY BANKED SEGMENT AT PAGE 2
; - OUTPUT:
; -     A: SEGMENT NUMBER
; - CLOBBERS: AF, HL (SEE THE NOTE IN PUTP2)
; -

GETP2           LD      HL, (MGETP2)
                JP      CALHL


; --- TRACKED ALLOCATION        ----------------------------------------
;
; ALL_SEG REPORTS EXHAUSTION IN THE CARRY FLAG AND LEAVES A UNDEFINED. PASSING
; THAT UNDEFINED VALUE TO PUT_P1 / PUT_P2 BANKS A SEGMENT THAT DOES NOT EXIST
; AND SILENTLY DESTROYS THE BUFFER -- ON A STOCK 128KB MSX2 THAT IS NOT A
; CORNER CASE, IT IS THE NORMAL OUTCOME. EVERY ALLOCATION IN THE EDITOR GOES
; THROUGH SEGGET, WHICH CHECKS THE FLAG AND RECORDS THE SEGMENT SO IT CAN BE
; RETURNED LATER.


; - SEGGET -----------------------------
; - ALLOCATE ONE SEGMENT AND RECORD IT IN SEGTBL
; - IN:  NONE
; - OUT: A  = SEGMENT NUMBER
; -      CY = 1  NO MAPPER MEMORY LEFT (A UNDEFINED)
; - CLOBBERS: AF, BC, DE, HL
; -

SEGGET          CALL    ALLSEG
                RET     C               ; NO FREE SEGMENTS

                LD      E, A            ; E = SEGMENT NUMBER
                LD      A, (SEGCNT)
                CP      MAXSEGS
                JR      NC, .FULL

                LD      C, A            ; C = INDEX
                LD      B, 0
                LD      HL, SEGTBL
                ADD     HL, BC
                LD      (HL), E
                INC     A
                LD      (SEGCNT), A

                LD      A, E
                AND     A               ; CY = 0
                RET

                ; TABLE FULL: HAND THE SEGMENT BACK RATHER THAN LEAK IT
.FULL           LD      A, E
                CALL    FRESEG
                SCF
                RET


; - SEGFREE ----------------------------
; - RETURN EVERY TRACKED SEGMENT TO THE MAPPER MANAGER
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

SEGFREE         LD      A, (SEGCNT)
                AND     A
                RET     Z
                LD      B, A
                LD      C, 0
.LOOP           PUSH    BC
                LD      B, 0
                LD      HL, SEGTBL
                ADD     HL, BC
                LD      A, (HL)
                CALL    FRESEG
                POP     BC
                INC     C
                DJNZ    .LOOP
                XOR     A
                LD      (SEGCNT), A
                RET


; - SEGTRIM ----------------------------
; - FREE EVERY TEXT SEGMENT GROWN DYNAMICALLY
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; - FREES ALL SEGMENTS IN SEGTBL ABOVE ENTRY 1 (INITIAL SEGMENTS ARE IN TPA)
; -
; - THE FLOOR OF TWO IS DIRSEG + FTRSEG: SEGRESV CLAIMS THEM FIRST, SO
; - SEGTBL[0] IS THE DIRECTORY SEGMENT AND SEGTBL[1] THE FEATURE SEGMENT,
; - AND BOTH MUST SURVIVE EVERY BUFRESET -- FREEING THEM WOULD HAND THE LIVE
; - DIRECTORY AND THE RESIDENT FEATURE CODE BACK TO DOS MID-SESSION.
; - SEGFREE (EXIT PATH) STILL FREES THEM, BECAUSE THERE THE WHOLE EDITOR IS
; - GOING AWAY.
; -

SEGTRIM         LD      A, (SEGCNT)
                CP      2
                RET     C               ; DEFENSIVE: NEVER BELOW THE FLOOR
                RET     Z               ; SEGTBL[0..1] = DIRSEG, FTRSEG
                DEC     A
                LD      (SEGCNT), A
                LD      C, A
                LD      B, 0
                LD      HL, SEGTBL
                ADD     HL, BC
                LD      A, (HL)
                CALL    FRESEG
                JR      SEGTRIM


; --- SEGRESV                   ----------------------------------------

; - SEGRESV ----------------------------
; - CLAIM THE TWO MANDATORY SEGMENTS AND REPORT THE TEXT CEILING
; - IN:  NONE (CALL AFTER MAPINIT, BEFORE SCRINIT: RUNS IN TEXT MODE)
; - OUT: NEVER RETURNS ON FAILURE (ERRMEM / ERRMSG)
; - CLOBBERS: ALL
; -
; - MINIMUM CONFIGURATION (DIRECTIVE 2026-09-16): 2 FREE MAPPER SEGMENTS
; - OR THE EDITOR DOES NOT START. DIRSEG HOLDS THE LINE DIRECTORY, FTRSEG
; - THE RESIDENT FEATURE CODE (FASE 1B). TEXT NEEDS NO CLAIM HERE: TXSEG0
; - = DEFSEG2 HOLDS THE FIRST LINEPSEG LINES AND GROWTH IS ON DEMAND VIA
; - NEWREC. THE PROBE BELOW KNOWS, IT DOES NOT HOLD: EVERY SPARE SEGMENT
; - IT COUNTS IS HANDED STRAIGHT BACK.
; -
; - MEASURED 2026-09-16 (PROBE.COM, VALIDATED AGAINST REAL HARDWARE):
; - DOS 2 RESERVES 6 SEGMENTS, NEXTOR 7 (112KB), CONSTANT ACROSS MAPPER
; - SIZES. A STOCK 128KB MACHINE THEREFORE HAS 2 FREE UNDER DOS 2 AND 1
; - UNDER NEXTOR -- THE MINIMUM MAKES 128KB+NEXTOR UNSUPPORTED, AND ON
; - 128KB+DOS2 THE TEXT CEILING IS DEFSEG2 ALONE (101 LINES).
; -

SEGRESV         CALL    SEGGET          ; 1: DIRECTORY SEGMENT
                JP      C, ERRMEM
                LD      (DIRSEG), A
                CALL    SEGGET          ; 2: FEATURE SEGMENT
                JP      C, .NOFTR
                LD      (FTRSEG), A

                ; COUNT WHAT WOULD BE LEFT. EVERY SPARE IS CLAIMED FIRST AND
                ; FREED AFTERWARDS, NEVER INTERLEAVED: A FREED SEGMENT IS THE
                ; NEXT ONE ALL_SEG HANDS OUT, SO ALLOC/FREE/ALLOC LOOPS ON THE
                ; SAME SEGMENT FOREVER (MEASURED 2026-09-16 ON A 2MB MACHINE:
                ; SEGAVL PAST 200 AND COUNTING). CLIPBUF IS FREE DURING INIT.
                XOR     A
                LD      (SEGAVL), A
.PROBE          CALL    ALLSEG
                JR      C, .PROBED
                LD      E, A            ; E = ALLOCATED SEGMENT NUMBER
                LD      A, (SEGAVL)
                LD      C, A
                LD      B, 0
                LD      HL, CLIPBUF
                ADD     HL, BC
                LD      (HL), E
                INC     A
                LD      (SEGAVL), A
                JR      .PROBE

.PROBED         LD      A, (SEGAVL)     ; HAND THEM ALL BACK
                LD      B, A
                OR      A
                JR      Z, .COUNTED
                LD      HL, CLIPBUF
.RELEASE        LD      A, (HL)
                PUSH    HL
                PUSH    BC
                CALL    FRESEG
                POP     BC
                POP     HL
                INC     HL
                DJNZ    .RELEASE
.COUNTED        ; TEXT CEILING = (SEGAVL + 1) * LINEPSEG -- DEFSEG2 JOINS
                ; THE TEXT POOL WITHOUT BEING CLAIMED
                LD      A, (SEGAVL)
                INC     A
                LD      B, A
                LD      HL, 0
                LD      DE, LINEPSEG
.CEIL           ADD     HL, DE
                DJNZ    .CEIL
                LD      (SEGLNS), HL

                ; IF /V IS NOT SET, NORMAL BOOT IS 100% QUIET AND INSTANT
                LD      A, (SWTVERB)
                AND     A
                RET     Z

                ; VERBOSE BOOT INFORMATION (/V)
                LD      DE, TXTVTIT
                CALL    STROUT

                ; TOTAL MAPPER MEMORY: "Total mapper:   NN segments (NNNN KB)"
                LD      DE, SEGMSG
                LD      HL, TXTVTOT
                CALL    .APPZ
                PUSH    DE
                LD      A, (SEGTOT)
                CALL    B2D8
                POP     DE
                CALL    .APPB
                LD      HL, TXTVSEG
                CALL    .APPZ
                PUSH    DE
                LD      A, (SEGTOT)
                LD      L, A
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; * 16 KB
                CALL    B2D16
                POP     DE
                CALL    .APPB
                LD      HL, TXTVKB
                CALL    .APPZ
                LD      A, '$'
                LD      (DE), A
                LD      DE, SEGMSG
                CALL    STROUT

                ; AVAILABLE MAPPER: "Available:      NN segments (NNNN KB)"
                LD      DE, SEGMSG
                LD      HL, TXTVAVL
                CALL    .APPZ
                PUSH    DE
                LD      A, (SEGAVL)
                ADD     A, 2            ; 2 RESERVED ARE INCLUDED IN FREE AT BOOT
                CALL    B2D8
                POP     DE
                CALL    .APPB
                LD      HL, TXTVSEG
                CALL    .APPZ
                PUSH    DE
                LD      A, (SEGAVL)
                ADD     A, 2
                LD      L, A
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; * 16 KB
                CALL    B2D16
                POP     DE
                CALL    .APPB
                LD      HL, TXTVKB
                CALL    .APPZ
                LD      A, '$'
                LD      (DE), A
                LD      DE, SEGMSG
                CALL    STROUT

                ; RESERVED SEGMENTS: "Reserved:       2 segments (Directory, Features)"
                LD      DE, TXTVRES
                CALL    STROUT

                ; TEXT CAPACITY: "Text capacity:  NNNNN lines"
                LD      DE, SEGMSG
                LD      HL, TXTVCAP
                CALL    .APPZ
                PUSH    DE
                LD      HL, (SEGLNS)
                CALL    B2D16
                POP     DE
                CALL    .APPB
                LD      HL, TXTVLNS
                CALL    .APPZ
                LD      A, '$'
                LD      (DE), A
                LD      DE, SEGMSG
                CALL    STROUT

                ; LOW MEMORY WARNING IF CAPACITY IS AT FLOOR
                LD      HL, (SEGLNS)
                LD      DE, WARNLNS
                CALL    CMPHLDE
                JR      NC, .NOWARN
                LD      DE, TXTVLOW
                CALL    STROUT

.NOWARN         ; SHOW TARGET FILE IF GIVEN ON COMMAND LINE
                LD      A, (FILENAME)
                AND     A
                JR      Z, .NOFILE
                LD      DE, SEGMSG
                LD      HL, TXTVFIL
                CALL    .APPZ
                LD      HL, FILENAME
                CALL    .APPZ
                LD      HL, TXTVCR
                CALL    .APPZ
                LD      A, '$'
                LD      (DE), A
                LD      DE, SEGMSG
                CALL    STROUT

.NOFILE         ; PROMPT AND WAIT FOR KEYPRESS
                LD      DE, TXTVKEY
                CALL    STROUT

.KEYWAIT        LD      IX, CHGET
                CALL    BIOSCALL
                LD      IX, KILBUF
                CALL    BIOSCALL
                RET

.NOFTR          LD      DE, ENO2SEG
                JP      ERRMSG

.APPZ           LD      A, (HL)         ; APPEND NUL-TERMINATED STRING AT DE
                AND     A
                RET     Z
                LD      (DE), A
                INC     HL
                INC     DE
                JR      .APPZ

.APPB           LD      A, (HL)         ; APPEND C BYTES FROM HL AT DE
                LD      (DE), A
                INC     HL
                INC     DE
                DEC     C
                JR      NZ, .APPB
                RET

TXTVTIT         DEFM    "S6ED v"
                DEFB    VERSION.MAJOR, '.', VERSION.MINOR
                DEFM    " - Screen 6 text editor for MSX2", 13, 10
                DEFM    "(c) 2024-2026 Armando Perez Abad", 13, 10, 13, 10, "$"
TXTVTOT         DEFM    "Total mapper:   ", 0
TXTVAVL         DEFM    "Available:      ", 0
TXTVSEG         DEFM    " segments (", 0
TXTVKB          DEFM    " KB)", 13, 10, 0
TXTVRES         DEFM    "Reserved:       2 segments (Directory, Features)", 13, 10, "$"
TXTVCAP         DEFM    "Text capacity:  ", 0
TXTVLNS         DEFM    " lines", 13, 10, 0
TXTVLOW         DEFM    "Low mapper memory: text capacity limited to 101 lines.", 13, 10, "$"
TXTVFIL         DEFM    "File:           ", 0
TXTVCR          DEFM    13, 10, 0
TXTVKEY         DEFM    13, 10, "Press any key to continue...", 13, 10, "$"
