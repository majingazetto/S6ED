;                                       ****************************************
;                                       * SEGMENT COMPACTION ENGINE            *
;                                       ****************************************
;
; LINEAR SEGMENT COMPACTOR: SLIDES ACTIVE RECORDS DOWNWARD IN PLACE,
; ELIMINATING TOMBSTONED (#FFFF) RECORDS AND CONSOLIDATING FREE SPACE
; AT THE TAIL OF THE SEGMENT. UPDATES DIRSEG ENTRIES ACCORDINGLY.
;


; --- SEGCOMP                   ----------------------------------------


; - SEGCOMP ----------------------------
; - COMPACT A 16KB TEXT SEGMENT IN PLACE
; - IN:  A = SEGMENT NUMBER TO COMPACT
; - OUT: CY = 0 SUCCESS
; - CLOBBERS: AF, BC, DE, HL (IX AND IY ARE KEPT)
; -
; - IX AND IY ARE SAVED BECAUSE THE "Compacting..." MESSAGE GOES THROUGH
; - DRWSTAT, WHICH ZEROES IX (B2D16) AND ON S2ED COMPOSES WITH IX AND IY,
; - AND SEGCOMP RUNS INSIDE NEWREC: UNDOSWP / UNDORST HOLD THEIR UNDO
; - RECORD IN IX ACROSS IT. WITH IX = 0 THEY WROTE THE RECORD OVER PAGE 0.
; -
SEGCOMP         PUSH    IX
                PUSH    IY
                LD      (CMPSEG), A

                ; DISPLAY "Compacting..." ON STATUS BAR
                LD      HL, .STRCMP
                CALL    .SETMSG
                CALL    DRWSTAT

                ; DETERMINE HIGH-WATER BOUND FOR SCAN
                ; IF CMPSEG == APPSEG, BOUND IS (LINEOFF).
                ; IF CMPSEG != APPSEG, BOUND IS SEGSIZE (16384).
                LD      A, (CMPSEG)
                LD      HL, APPSEG
                CP      (HL)
                JR      NZ, .NOTAPP
                LD      HL, (LINEOFF)
                JR      .HAVBND
.NOTAPP         LD      HL, SEGSIZE
.HAVBND         LD      (CMPEND), HL    ; CMPEND = SCAN LIMIT

                ; THREE PASSES, NOT A DIRECTORY SEARCH PER MOVED RECORD (THAT
                ; WAS O(MOVED x TOTLINES): 4.2 S FOR A FULL 128 KB SEGMENT).
                ; 1. WALK THE RECORDS AND WORK OUT WHERE EACH LIVE ONE WILL GO,
                ;    PARKING THAT OFFSET IN ITS OWN HEADER (.TAG).
                ; 2. WALK THE DIRECTORY ONCE: EVERY ENTRY IN THIS SEGMENT READS
                ;    ITS RECORD'S NEW OFFSET FROM THERE.
                ; 3. WALK THE RECORDS AGAIN: CLEAR THE TAGS AND SLIDE.
                ; THE TAG: THE NEW OFFSET IS A MULTIPLE OF 4 (A RECORD IS 4 + A
                ; MULTIPLE OF 32), SO /4 IS 12 BITS -- THE LOW 5 IN RECCAP'S
                ; BITS 0-4 (ALWAYS 0: THE PAYLOAD IS A MULTIPLE OF 32) AND THE
                ; HIGH 7 IN RECLEN'S HIGH BYTE (ALWAYS 0: A LINE IS AT MOST 255
                ; LONG). THAT BYTE STAYS BELOW #80, SO NO LIVE RECORD READS AS
                ; A TOMBSTONE (#FFFF). A RECORD THE DIRECTORY DOES NOT NAME (ONE
                ; NEWREC JUST RESERVED) IS TAGGED, MOVED AND CLEARED ALL THE
                ; SAME, AS IT WAS MOVED BEFORE.
                LD      A, (CMPSEG)
                CALL    RECBANK
                LD      HL, 0
                LD      (CMPSRC), HL
                LD      (CMPDST), HL
.P1LP           LD      HL, (CMPSRC)
                LD      DE, (CMPEND)
                CALL    CMPHLDE
                JR      NC, .P2
                CALL    .HEAD           ; HL = RECORD, BC = SIZE, CY = DEAD
                JR      C, .P1NXT
                PUSH    BC
                LD      DE, (CMPDST)
                SRL     D
                RR      E
                SRL     D
                RR      E               ; DE = NEW OFFSET / 4 (0..4095)
                LD      A, E
                AND     #1F
                LD      C, A
                LD      A, (HL)
                AND     #E0
                OR      C
                LD      (HL), A         ; RECCAP LOW: PAYLOAD | LOW 5 BITS
                LD      A, E
                RLCA
                RLCA
                RLCA
                AND     #07             ; E >> 5
                LD      C, A
                LD      A, D
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; D << 3
                OR      C               ; THE HIGH 7 BITS
                INC     HL
                INC     HL
                INC     HL
                LD      (HL), A         ; RECLEN HIGH
                POP     BC
                LD      HL, (CMPDST)
                ADD     HL, BC
                LD      (CMPDST), HL
.P1NXT          LD      HL, (CMPSRC)
                ADD     HL, BC
                LD      (CMPSRC), HL
                JR      .P1LP

.P2             LD      HL, 0
                LD      (CMPSRC), HL    ; NOW THE LINE INDEX
.P2LP           LD      HL, (CMPSRC)
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      NC, .P3
                CALL    DIRREAD         ; A = SEG, DE = OFFSET, HL = ITS HIGH BYTE
                LD      C, A
                LD      A, (CMPSEG)
                CP      C
                JR      NZ, .P2NXT
                PUSH    HL              ; THE ENTRY'S OFFSET HIGH BYTE
                PUSH    DE
                CALL    RECBANK         ; A = CMPSEG
                POP     DE
                LD      HL, TXPAGE
                ADD     HL, DE          ; THE RECORD
                LD      A, (HL)
                AND     #1F
                LD      E, A            ; LOW 5 BITS
                INC     HL
                INC     HL
                INC     HL
                LD      H, (HL)
                LD      L, 0
                SRL     H
                RR      L               ; HL = HIGH 7 BITS << 7
                LD      A, E
                ADD     A, A
                ADD     A, A
                OR      L
                LD      L, A            ; HL = NEW OFFSET
                EX      DE, HL
                PUSH    DE
                CALL    DIRBANK
                POP     DE
                POP     HL
                LD      (HL), D         ; THE ENTRY TAKES IT
                DEC     HL
                LD      (HL), E
.P2NXT          LD      HL, (CMPSRC)
                INC     HL
                LD      (CMPSRC), HL
                JR      .P2LP

.P3             LD      A, (CMPSEG)
                CALL    RECBANK
                LD      HL, 0
                LD      (CMPSRC), HL
                LD      (CMPDST), HL
.P3LP           LD      HL, (CMPSRC)
                LD      DE, (CMPEND)
                CALL    CMPHLDE
                JR      NC, .SCANDON
                CALL    .HEAD
                JR      C, .P3NXT
                LD      A, (HL)         ; CLEAR THE TAG
                AND     #E0
                LD      (HL), A
                INC     HL
                INC     HL
                INC     HL
                LD      (HL), 0
                PUSH    BC              ; SLIDE [SRC, SRC + SIZE) DOWN TO DST
                LD      HL, (CMPDST)
                LD      DE, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, (CMPSRC)
                LD      BC, TXPAGE
                ADD     HL, BC          ; HL = SOURCE
                POP     BC
                PUSH    BC
                LDIR                    ; DST <= SRC: A FORWARD COPY IS SAFE
                POP     BC
                LD      HL, (CMPDST)
                ADD     HL, BC
                LD      (CMPDST), HL
.P3NXT          LD      HL, (CMPSRC)
                ADD     HL, BC
                LD      (CMPSRC), HL
                JR      .P3LP

                ; .HEAD: THE RECORD AT CMPSRC. OUT: HL = ITS BASE IN PAGE 2,
                ; BC = ITS SIZE (4 + PAYLOAD, TAG BITS MASKED), CY = 1 DEAD
.HEAD           LD      HL, (CMPSRC)
                LD      DE, TXPAGE
                ADD     HL, DE
                PUSH    HL
                LD      A, (HL)
                AND     #E0
                LD      C, A
                INC     HL
                LD      A, (HL)
                AND     #03
                LD      B, A            ; BC = PAYLOAD (32..512)
                INC     HL
                LD      A, (HL)
                INC     HL
                AND     (HL)
                INC     A               ; Z: RECLEN = #FFFF, A TOMBSTONE
                LD      HL, RECHDR_SZ
                ADD     HL, BC          ; (ADD HL KEEPS Z)
                LD      B, H
                LD      C, L
                POP     HL
                SCF
                RET     Z
                OR      A
                RET

.SCANDON        ; COMPACTION FINISHED!
                ; IF CMPSEG == APPSEG, UPDATE LINEOFF = CMPDST
                LD      A, (CMPSEG)
                LD      HL, APPSEG
                CP      (HL)
                JR      NZ, .NOTAPP2
                LD      HL, (CMPDST)
                LD      (LINEOFF), HL

.NOTAPP2        ; DROP THE FREE LIST. ITS RECORDS ARE TOMBSTONES, SO THIS
                ; SEGMENT'S HAVE JUST BEEN SQUEEZED OUT, AND AN ENTRY ANYWHERE
                ; IN THE LIST MAY POINT INTO IT -- DRAINING ONLY A HEAD THAT
                ; LIVED HERE LEFT DEEPER ENTRIES ON SLID RECORDS. THE LIST IS
                ; ONLY AN OPTIMISATION: RECORDS IN OTHER SEGMENTS STAY
                ; TOMBSTONES AND ARE RECLAIMED IF THEIR SEGMENT IS COMPACTED.
                LD      A, FREENIL
                LD      (FREEHD), A

                ; CLEAR STATUS MESSAGE AND REDRAW
                XOR     A
                LD      (STATMSG), A
                CALL    DRWSTAT
                POP     IY
                POP     IX
                OR      A               ; CY = 0: SUCCESS
                RET

.SETMSG         LD      DE, STATMSG
.SETMLP         LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                JR      .SETMLP

.STRCMP         DEFM    "Compacting...", 0
