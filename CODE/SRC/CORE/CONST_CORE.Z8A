;                                       ****************************************
;                                       * CORE CONSTANTS                       *
;                                       ****************************************


; --- VERSION                   ----------------------------------------


VERSION
.MAJOR          EQU     '0'
.MINOR          EQU     '1'


; --- CHARACTER ATTRIBUTES      ----------------------------------------


                ; ATTR BYTE BIT DEFINITIONS (PER CELL, STORED ALONGSIDE TEXT)
ATRBOLD         EQU     #01             ; BIT 0
ATRITAL         EQU     #02             ; BIT 1
ATRUNDR         EQU     #04             ; BIT 2
ATRINV          EQU     #08             ; BIT 3  (INVERSE VIDEO)
ATRMARK         EQU     #10             ; BIT 4  (MARKUP DELIMITER CHARACTER)
ATRFMSK         EQU     #03             ; BITS 0-1 -> FONT VARIANT INDEX


; --- TEXT BUFFER / MAPPER      ----------------------------------------


DIRSIZ          EQU     3               ; BYTES PER LINE DIRECTORY ENTRY
                                        ;   [1: SEGMENT] [2: WORD OFFSET]
MAXCOLS         EQU     255             ; MAX EDITABLE LINE COLUMNS IN WORKBUF
WORKATTR        EQU     256             ; ATTRIBUTE OFFSET IN WORKBUF
WORKSIZ         EQU     512             ; WORK BUFFER SIZE IN PAGE 3 UNBANKED RAM
CLIPMAX         EQU     2048            ; MAX CLIPBOARD BUFFER CAPACITY
LINMAX          EQU     128             ; MAX CFG LINE LENGTH INCLUDING NUL

                ; PROGRAM HOME DIRECTORY (HOMEINIT IN BDOS.Z8A). HOMEPTH HOLDS
                ; THE PROGRAM ENVIRONMENT STRING AND IS THEN REUSED TO BUILD
                ; HOME-RELATIVE NAMES: THE PREFIX IS KEPT AND AN 8.3 NAME PLUS
                ; ITS NUL (HOMENAM BYTES) IS WRITTEN AFTER IT, SO THE PREFIX
                ; MAY BE AT MOST HOMEMAX - HOMENAM BYTES LONG.
FNAMLEN         EQU     64              ; FILENAME: A DOS 2 PATH, 63 + NUL
HOMEMAX         EQU     80              ; PROGRAM STRING BUFFER (DOS 2 PATHS: 63 + NUL)
HOMENAM         EQU     13              ; LONGEST 8.3 NAME PLUS NUL
INPSIZ          EQU     40              ; INPBUF: 39 CHARACTERS + NUL
                ; A BROWSER ENTRY: THE 8.3 NAME SPACE-PADDED, FLAGS, AND WHAT
                ; THE INFORMATION LINE SHOWS -- TAKEN FROM THE FILE INFO BLOCK
                ; DURING THE SCAN. READING IT AGAIN PER SELECTION WITH _FFIRST
                ; WAS MEASURED AT 0.12-1.34 S ON A 170-ENTRY FLOPPY DIRECTORY,
                ; WITH THE KEYBOARD DEAF WHILE THE DISK ROM READ.
BRENAM          EQU     11              ; NAME BYTES
BREFLG          EQU     11              ; FLAGS
BRESIZ          EQU     12              ; SIZE, 24 BITS (FIB BYTES 21..23)
BREDAT          EQU     15              ; DOS DATE WORD
BRETIM          EQU     17              ; DOS TIME WORD
BRWESZ          EQU     19              ; BYTES PER ENTRY
BRW_OPEN        EQU     0               ; BRWMODE VALUES
BRW_SAVE        EQU     1
BRFDIR          EQU     %10000000       ; ENTRY FLAGS (BYTE 11): DIRECTORY
BRFDRV          EQU     %01000000       ;   DRIVE ("A:")
BRFUP           EQU     %00100000       ;   PARENT ("..\")
BRFARC          EQU     %00001000       ;   ARCHIVE (DOS BIT 5, MOVED HERE)
BRFATR          EQU     %00000111       ;   DOS ATTRIBUTES KEPT IN PLACE: R, H, S
BRF_LIST        EQU     0               ; BRWFOC VALUES: THE GRID...
BRF_FLD         EQU     1               ;   THE NAME FIELD
BRF_OK          EQU     2               ;   OPEN / SAVE
BRF_CANC        EQU     3               ;   CANCEL
BRFOCN          EQU     4               ;   HOW MANY
ATR_ALL         EQU     #16             ; _FFIRST: DIRECTORIES, HIDDEN, SYSTEM

                ; PAGE 3 SCRATCH, ABOVE EACH TARGET'S OWN PAGE 3 BUFFERS
                ; (P3BASE, FROM CONST_S6 / CONST_S2). PAGE 3 IS NEVER BANKED,
                ; BDOS TAKES BUFFERS THERE, AND IT COSTS NO PAGE 1 TPA -- WHICH
                ; ON S2ED IS DOWN TO A FEW HUNDRED BYTES. INIT ZEROES THE BLOCK.
                ; TP3MIN KEEPS 1 KB OF STACK BETWEEN ITS TOP AND (#0006).
HOMEPTH         EQU     P3BASE          ; PROGRAM STRING, THEN HOME-RELATIVE NAMES
LINBUF          EQU     HOMEPTH + HOMEMAX ; ONE CFG LINE (ALSO :e NAME SCRATCH)
FILENAME        EQU     LINBUF + LINMAX ; CURRENT FILENAME: A FULL PATH (ASCIIZ)
INPBUF          EQU     FILENAME + FNAMLEN ; INPUT FIELD CONTENTS, ASCIIZ
BRWOUT          EQU     INPBUF + INPSIZ ; FILE BROWSER: THE PATH CHOSEN
BRWMODE         EQU     BRWOUT + FNAMLEN ; FILE BROWSER: BRW_OPEN / BRW_SAVE
P3TOP           EQU     BRWMODE + 1     ; FIRST BYTE PAST THE SCRATCH BLOCK

                ; THE FILE BROWSER'S LISTING, ONLY ON A TARGET THAT DEFINES
                ; BROWSER (AND ITS BRWMAX, THE ENTRY CAPACITY). NOT ZEROED BY
                ; INIT: DOBRW BUILDS ALL OF IT EVERY TIME IT OPENS.
                IFDEF   BROWSER
BRWPATH         EQU     P3TOP           ; DIRECTORY BEING BROWSED, "D:\PATH\"
BRWMASK         EQU     BRWPATH + FNAMLEN ; FILE MASK, "*.*" BY DEFAULT
BRWNAME         EQU     BRWMASK + HOMENAM ; SCRATCH: PATH + NAME / MASK
BRWFIB          EQU     BRWNAME + FNAMLEN + HOMENAM ; DOS 2 FILE INFO BLOCK
BRWTTL          EQU     BRWFIB + 64     ; WINDOW TITLE: MODE + PATH + MASK
BRWINF          EQU     BRWTTL + 80     ; INFORMATION LINE TEXT
BRWCNT          EQU     BRWINF + 72     ; ENTRIES LISTED
BRWTOP          EQU     BRWCNT + 1      ; FIRST GRID ROW ON SCREEN
BRWSEL          EQU     BRWTOP + 1      ; SELECTED ENTRY (SORTED POSITION)
BRWFOC          EQU     BRWSEL + 1      ; FOCUS: BRF_LIST .. BRF_CANC
BRWMORE         EQU     BRWFOC + 1      ; 1 = MORE ENTRIES THAN BRWMAX
BRWDORD         EQU     BRWMORE + 1     ; DATE FIELD ORDER, 3 LETTERS Y/M/D
BRWT24          EQU     BRWDORD + 3     ; 1 = 24-HOUR CLOCK (TIME=24)
BRWPREV         EQU     BRWT24 + 1      ; PADDED NAME TO RESELECT AFTER A SCAN
BRWPAT          EQU     BRWPREV + BRENAM ; BRWMASK AS A PADDED 8.3 PATTERN
BRWLO           EQU     BRWPAT + BRENAM ; BRWADD'S BINARY SEARCH: LOW...
BRWHI           EQU     BRWLO + 1       ; ...HIGH (EXCLUSIVE)...
BRWMID          EQU     BRWHI + 1       ; ...AND THE PROBE
                ; BRWIDX (SORTED ORDER) AND BRWENT (THE ENTRIES) ARE WHERE THE
                ; TARGET PUTS THEM (CONST_S6: THE TOP OF THE FEATURE CONTAINER)
P3END           EQU     BRWMID + 1
                ELSE
P3END           EQU     P3TOP
                ENDIF
TP3MIN          EQU     P3END + 1024    ; MINIMUM SAFE PAGE 3 TPA CEILING

WORKBUF         EQU     #C000           ; CURRENT LINE RECORD IN PAGE 3 UNBANKED RAM
WORKBUF2        EQU     #C200           ; SECOND LINE RECORD (SPLIT/JOIN/UNDO)
PREVBUF         EQU     #C400           ; RENDIFF CACHED ROW RECORD

TXPAGE          EQU     #8000           ; PAGE 2 - TEXT WINDOW (SWITCHED)

                ; LINE DIRECTORY PLACEMENT.
                ;
                ; THE DIRECTORY LIVES IN ITS OWN MAPPER SEGMENT (DIRSEG), BANKED
                ; INTO THE PAGE 2 WINDOW ON DEMAND -- SEE DIRBANK IN BUFFER.Z8A.
                ; ITS CAPACITY IS FIXED AT ONE SEGMENT AND NO LONGER SHRINKS AS
                ; THE IMAGE GROWS.

DIRWIN          EQU     TXPAGE          ; PAGE-2 WINDOW THE DIRECTORY BANKS INTO
MAXLINES        EQU     16384 / DIRSIZ  ; 5461 ENTRIES INSIDE ONE MAPPER SEGMENT

                ; SEGMENT ALLOCATION TYPE (FOR ALL_SEG)
SEG_USER        EQU     0               ; A=0: ALLOCATE USER SEGMENT
SEG_SYS         EQU     1               ; A=1: ALLOCATE SYSTEM SEGMENT

MAXSEGS         EQU     32              ; SEGMENTS THE EDITOR WILL TRACK
                                        ;   1 DIRECTORY + 1 FEATURE + 30 TEXT = 496KB
WARNLNS         EQU     500             ; BOOT WARNS WHEN THE TEXT CEILING FALLS
                                        ;   BELOW THIS (IN LINES)
FREENIL         EQU     #FF             ; FREEHD VALUE MEANING "NO FREE RECORD"
                                        ;   NO REAL MAPPER SEGMENT EVER TAKES IT
LINEPSEG        EQU     16384 / LINEREC ; 101 LINE RECORDS PER SEGMENT
SEGLAST         EQU     (LINEPSEG - 1) * LINEREC
                                        ; OFFSET OF THE LAST RECORD THAT STILL
                                        ; FITS WHOLE INSIDE A 16KB SEGMENT

SEGSIZE         EQU     16384           ; 16KB MAPPER SEGMENT SPAN

                ; VARIABLE LINE RECORD HEADER (IN MAPPED TEXT SEGMENT)
RECHDR_SZ       EQU     4               ; 4 BYTES: [RECCAP: 2B][RECLEN: 2B]
RECCAP          EQU     0               ; OFFSET 0: ALLOCATED CAPACITY FOR TEXT
RECLEN          EQU     2               ; OFFSET 2: ACTIVE TEXT LENGTH (OR TOMBVAL)
RECTXT          EQU     4               ; OFFSET 4: START OF ASCII TEXT
TOMBVAL         EQU     #FFFF           ; RECLEN INDICATING DEAD/TOMBSTONED RECORD
QUANTUM         EQU     16              ; ALLOCATION QUANTUM (16 CHARACTERS)
DEF_CAP         EQU     16              ; DEFAULT CHAR CAPACITY FOR NEW RECORD
DEF_PAY         EQU     DEF_CAP * 2     ; DEFAULT PAYLOAD BYTES (16 TEXT + 16 ATTR = 32B)
RECDEF_SZ       EQU     RECHDR_SZ + DEF_PAY ; 36 BYTES PER DEFAULT NEW RECORD



; --- UNDO SUBSYSTEM            ----------------------------------------


UNDOSIZ         EQU     4096            ; 4 KB UNDO RING BUFFER IN TPA RAM (S6ED & S2ED)
UNDOT_MOD       EQU     1               ; OP TYPE: SINGLE-LINE MODIFICATION
UNDOT_DEL       EQU     2               ; OP TYPE: DELETED LINE
UNDOT_SPL       EQU     3               ; OP TYPE: LINE SPLIT (ENTER)
UNDOT_JON       EQU     4               ; OP TYPE: LINE JOIN (BACKSPACE/DEL)
UNDOHDR_SZ      EQU     10              ; TRANSACTION HEADER SIZE
UNDOMOD_SZ      EQU     UNDOHDR_SZ + LINEREC ; 171 BYTES PER RECORD (S6), 139 (S2)
UNDOF_CHN       EQU     #80             ; OP FLAG: SAME USER ACTION AS THE PREVIOUS RECORD
UNDOT_MSK       EQU     #7F             ; OP TYPE WITHOUT ITS FLAG
; THE LARGEST GROUP THE RING HOLDS WHOLE WHATEVER ITS FILL LEVEL: A WRAP
; WASTES UP TO UNDOMOD_SZ - 1 BYTES AT THE TOP, SO A GROUP OF THIS MANY
; RECORDS CAN NEVER REACH BACK AND EVICT ITS OWN FIRST RECORD.
; 22 ON S6ED (171-BYTE RECORDS, 4KB RING), 28 ON S2ED (139-BYTE RECORDS, 4KB RING).
UNDOGMAX        EQU     (UNDOSIZ - UNDOMOD_SZ + 1) / UNDOMOD_SZ


; --- S6ED.DAT CONTAINER        ----------------------------------------


DATMAX          EQU     8               ; MAX BLOCKS THE CONTAINER TABLE HOLDS
DATBLEN         EQU     FTRTOP - FTRBASE ; HARD LENGTH CAP: THE CONTAINER WINDOW
BLK_FTR         EQU     1               ; BLOCK ID OF THE FEATURE SEGMENT


; --- LANGUAGE MODES            ----------------------------------------


LGNONE          EQU     0
LANG_Z80        EQU     1
LGBASIC         EQU     2
LANG_C          EQU     3
LGPYTHN         EQU     4


; --- MISC                      ----------------------------------------


INS_MODE        EQU     1               ; INSERT
OVR_MODE        EQU     0               ; OVERWRITE


; --- WRAP MODES                ----------------------------------------


WRAP_DEV        EQU     0               ; DEVELOPER MODE: CLAMP AT COL 79 (NO AUTO-WRAP)
WRAP_TXT        EQU     1               ; TEXT MODE: SMART WORD-WRAP


; --- AUTOALIGN MODES           ----------------------------------------


ALGN_OFF        EQU     0               ; ENTER ALWAYS LANDS AT COLUMN 0
ALGN_ON         EQU     1               ; AUTO-ALIGN ON ENTER, ANY WRAP MODE
ALGN_DEV        EQU     2               ; AUTO-ALIGN ONLY IN WRAP_DEV


; --- MODIFIERS BITMASK         ----------------------------------------


MODNONE         EQU     %00000000
MODSHFT         EQU     %00000001       ; SHIFT (ROW 6 BIT 0)
MODCTRL         EQU     %00000010       ; CTRL  (ROW 6 BIT 1)
MODGRPH         EQU     %00000100       ; GRAPH (ROW 6 BIT 2)
MODANY          EQU     %11111111       ; MATCH ANY MODIFIER STATE


; --- ACTION CATALOG IDS        ----------------------------------------


ACNONE          EQU     0
ACMVL           EQU     1
ACMVR           EQU     2
ACMVU           EQU     3
ACMVD           EQU     4
ACBOL           EQU     5               ; CTRL + <
ACEOL           EQU     6               ; CTRL + >
ACTOP           EQU     7               ; CTRL + UP
ACBOT           EQU     8               ; CTRL + DOWN
ACWLFT          EQU     9               ; GRAPH + <
ACWRGT          EQU     10              ; GRAPH + >
ACDWLFT         EQU     11              ; GRAPH + BS
ACPGUP          EQU     12              ; GRAPH + UP
ACPGDN          EQU     13              ; GRAPH + DOWN
ACDELBK         EQU     14              ; BS
ACDELFW         EQU     15              ; DEL
ACDELLN         EQU     16              ; CTRL + Y (OR dd IN VI)
ACNWLIN         EQU     17              ; CR
ACOPNBL         EQU     18              ; VI o
ACOPNAB         EQU     19              ; VI O
ACTGLIN         EQU     20              ; INS
ACTGLWR         EQU     21              ; CTRL + W
ACSAVE          EQU     22              ; F2 / CTRL + S
ACQUIT          EQU     23              ; ESC / CTRL + Q
ACHELP          EQU     24              ; F1
ACCYCKM         EQU     25              ; F5 / CTRL + K
ACVIINS         EQU     26              ; VI i
ACVIAPP         EQU     27              ; VI a
ACVINRM         EQU     28              ; VI ESC
ACVILED         EQU     29              ; VI LEADER 'd'
ACSLML          EQU     30              ; SHIFT + <
ACSLMR          EQU     31              ; SHIFT + >
ACSLMU          EQU     32              ; SHIFT + UP
ACSLMD          EQU     33              ; SHIFT + DOWN
ACSLBOL         EQU     34              ; SHIFT + CTRL + <
ACSLEOL         EQU     35              ; SHIFT + CTRL + >
ACSLTOP         EQU     36              ; SHIFT + CTRL + UP
ACSLBOT         EQU     37              ; SHIFT + CTRL + DOWN
ACSLWLF         EQU     38              ; SHIFT + GRAPH + <
ACSLWRT         EQU     39              ; SHIFT + GRAPH + >
ACSLPGU         EQU     40              ; SHIFT + GRAPH + UP
ACSLPGD         EQU     41              ; SHIFT + GRAPH + DOWN
ACSELAL         EQU     42              ; CTRL + A (SELECT ALL)
ACDSEL          EQU     43              ; DESELECT
ACDLS           EQU     44              ; DELETE SELECTION
ACCOPY          EQU     45              ; CTRL + C / VI y (COPY)
ACCUT           EQU     46              ; CTRL + X / VI x (CUT)
ACPAST          EQU     47              ; CTRL + V / VI p (PASTE)
ACTGLBD         EQU     48              ; CTRL + B (TOGGLE BOLD)
ACTGLIT         EQU     49              ; CTRL + I (TOGGLE ITALIC)
ACCYCMK         EQU     50              ; F3 / CTRL + T (CYCLE MARKUP MODE)
ACTABS          EQU     51              ; TAB (INSERT SPACES TO NEXT TAB STOP)
ACMENU          EQU     52              ; DROP-DOWN MENU FILE (F1 / SELECT / F10)
ACMNU1          EQU     53              ; DROP-DOWN MENU EDIT (F2)
ACMNU2          EQU     54              ; DROP-DOWN MENU VIEW (F3)
ACMNU3          EQU     55              ; DROP-DOWN MENU OPTIONS (F4)
ACMNU4          EQU     56              ; DROP-DOWN MENU HELP (F5)
ACUNDO          EQU     57              ; CTRL + Z / VI u (UNDO)
ACREDO          EQU     58              ; CTRL + Y / VI CTRL+R (REDO)
ACGOTOL         EQU     59              ; CTRL + G / EDIT MENU (GO TO LINE)
ACFIND          EQU     60              ; CTRL + F / EDIT MENU (FIND & REPLACE)
ACFNXT          EQU     61              ; CTRL + L / F3 (FIND NEXT)
ACFPRV          EQU     62              ; CTRL + R / SHIFT + F3 (FIND PREV)
ACEXMOD         EQU     63              ; VI ':' COMMAND LINE CONSOLE
ACNEW           EQU     64              ; CTRL + N / FILE > NEW
ACOPEN          EQU     65              ; CTRL + O / FILE > OPEN / VI :e
ACSAVAS         EQU     66              ; CTRL + SHIFT + S / FILE > SAVE AS
ACMAX           EQU     67

SRCHMAX         EQU     18              ; MAX SEARCH / REPLACE PATTERN LENGTH
SRCH_FND        EQU     0               ; ACTION: FIND NEXT
SRCH_RPL        EQU     1               ; ACTION: REPLACE
SRCH_ALL        EQU     2               ; ACTION: REPLACE ALL

MNUCOUNT        EQU     3               ; TOTAL TOP-LEVEL MENUS (FILE, EDIT, HELP)


; --- MODAL TEXT INPUT (WINEDIT) ---------------------------------------


                ; THE FIELD IS A CONTROL LIKE THE BUTTONS ARE, WHICH IS WHY
                ; THE FOCUS HAS THREE POSITIONS AND NOT TWO: SPACE MAY ONLY
                ; ACTIVATE THE FOCUSED CONTROL, SO IT CANNOT MEAN "ACCEPT"
                ; WHILE THE FIELD HAS IT -- THE DAY ED_TEXT EXISTS A SPACE IS
                ; A CHARACTER SOMEBODY IS TYPING.
INPMAX          EQU     5               ; LONGEST FIELD THE BUFFER HOLDS
ED_DIGIT        EQU     0               ; CHARACTER CLASS: '0'..'9'
ED_FILE         EQU     1               ; DECLARED, NOT IMPLEMENTED
ED_TEXT         EQU     2               ; DECLARED, NOT IMPLEMENTED
ED_FFLD         EQU     0               ; FOCUS: THE FIELD (DEFAULT)
ED_FOK          EQU     1               ; FOCUS: THE OK BUTTON
ED_FCAN         EQU     2               ; FOCUS: THE CANCEL BUTTON


; --- KEYMAP PROFILES           ----------------------------------------


KMSTD           EQU     0               ; STANDARD / CUA (DEFAULT)
KMWS            EQU     1               ; WORDSTAR / TURBO PASCAL
KMEMACS         EQU     2               ; EMACS
KMVI            EQU     3               ; VI MODAL

VIMNORM         EQU     0               ; VI NORMAL MODE
VIMINS          EQU     1               ; VI INSERT MODE


; --- MARKUP MODES              ----------------------------------------


MKUP_OFF        EQU     0               ; PLAIN TEXT / CODE (NO MARKUP)
MKUP_MD         EQU     1               ; COMMONMARK (**BOLD**, *ITALIC*, _ITALIC_)
MKUP_LIT        EQU     2               ; LITE / CHAT (*BOLD*, _ITALIC_)
MKUP_MAX        EQU     3


; --- DEAD KEY STATES           ----------------------------------------


DEDNONE         EQU     0               ; NO DEAD KEY PENDING
DEDACUT         EQU     1               ; ACUTE ACCENT PENDING
DEDDIAR         EQU     2               ; DIAERESIS PENDING
