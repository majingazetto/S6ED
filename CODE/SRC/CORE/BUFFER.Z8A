;                                       ****************************************
;                                       * TEXT BUFFER                          *
;                                       ****************************************
;
; LINE DIRECTORY: FLAT ARRAY IN ITS OWN MAPPER SEGMENT (DIRSEG), BANKED INTO
;   THE PAGE 2 WINDOW (DIRWIN = TXPAGE) ON DEMAND -- SEE DIRBANK BELOW.
;   WINDOW ACCESS: ENTRY N IS AT DIRWIN + N * DIRSIZ, AND THE ADDRESS IS ONLY
;   VALID WHILE DIRSEG IS BANKED -- EVERY READER AND WRITER BANKS FIRST.
;   ENTRY LAYOUT: [1: SEG][2: WORD OFFSET WITHIN THAT TEXT SEGMENT]
;   CAPACITY: MAXLINES ENTRIES = ONE FULL SEGMENT, INDEPENDENT OF IMAGE SIZE.
;
; TEXT SEGMENTS: ACCESSED VIA PAGE 2 WINDOW (TXPAGE = #8000).
;   PUTP2 TO SWITCH SEGMENT IN; COPY DATA; PUTP2 TO SWITCH NEXT AS NEEDED.
;   MULTIPLE SEGMENTS ALLOCATED AS FILE GROWS (ALLSEG).
;
; LINE RECORD (IN TEXT SEGMENT):
;   [1 BYTE : TEXT_LEN]   (0-80)
;   [N BYTES: TEXT]       RAW CHARS
;   [N BYTES: ATTR]       ONE ATTR BYTE PER CHAR
;   MAX: 1 + 80 + 80 = 161 BYTES (LINEREC)


; --- BUFINIT                   ----------------------------------------

; - BUFINIT ----------
; - INITIALIZE EMPTY BUFFER (ONE BLANK LINE)
; - CALL AFTER MAPINIT
; -
; - DIRSEG IS ALREADY CLAIMED: SEGRESV (MAPPER.Z8A) DID IT AT BOOT, ALONG
; - WITH FTRSEG. NOTHING IS CLAIMED HERE.
; -

BUFINIT         LD      A, (DEFSEG2)
                LD      (TXSEG0), A     ; USE TPA PAGE 2 SEGMENT FOR FIRST 101 LINES
                ; FALL THROUGH INTO BUFRESET


; --- BUFRESET                  ----------------------------------------

; - BUFRESET ---------
; - EMPTY THE BUFFER BACK TO ONE BLANK LINE
; - REUSES THE SEGMENTS ALREADY HELD AND RETURNS ANY GROWN BEYOND THE FIRST,
; - SO LOADING A SECOND FILE DOES NOT LEAK MAPPER MEMORY.
; -

BUFRESET        CALL    SEGTRIM
                LD      A, (TXSEG0)
                LD      (APPSEG), A     ; APPEND CURSOR BACK TO THE FIRST SEGMENT
                CALL    APPBANK         ; MAP TO PAGE 2

                LD      HL, TXPAGE
                CALL    RECBLNK0        ; EMPTY RECORD AT OFFSET 0

                ; WRITE DIR ENTRY 0: SEG=TXSEG0, OFF=0
                LD      HL, 0
                LD      A, (TXSEG0)
                LD      DE, 0
                CALL    DIRWRITE

                ; INITIALIZE VARS
                LD      A, FREENIL
                LD      (FREEHD), A     ; SEGTRIM JUST DROPPED THE GROWN
                                        ; SEGMENTS; ANY LINK INTO THEM IS DEAD
                LD      HL, RECDEF_SZ   ; RECORD 0 IS TAKEN, NEXT ONE STARTS HERE
                LD      (LINEOFF), HL

                LD      HL, 1
                LD      (TOTLINES), HL
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                JP      UNDOINIT


; --- RECBLNK0                  ----------------------------------------

; - RECBLNK0 ---------------------------
; - WRITE DEFAULT EMPTY RECORD AT TXPAGE (MAPPER)
; - IN:  HL = RECORD BASE IN TXPAGE
; - OUT: HL = UNCHANGED
; - CLOBBERS: AF
; -
RECBLNK0        PUSH    HL
                LD      (HL), DEF_PAY   ; RECCAP LOW (32)
                INC     HL
                LD      (HL), 0         ; RECCAP HIGH (0)
                INC     HL
                LD      (HL), 0         ; RECLEN LOW (0)
                INC     HL
                LD      (HL), 0         ; RECLEN HIGH (0)
                POP     HL
                RET


; --- RECBLNK                   ----------------------------------------

; - RECBLNK ----------
; - WRITE AN EMPTY LINE RECORD
; - IN:  HL = RECORD ADDRESS INSIDE THE PAGE 2 WINDOW
; - OUT: HL = UNCHANGED
; - CLOBBERS: AF, BC, DE
; - LAYOUT: [1 LEN=0] [80 SPACES] [80 ATTRS=0]
; -

RECBLNK         PUSH    HL
                LD      (HL), 0         ; LEN = 0
                INC     HL
                LD      (HL), ' '
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, TEXTCOLS - 1
                LDIR                    ; SPACES ACROSS THE TEXT HALF
                EX      DE, HL          ; LDIR LEAVES DE ONE PAST THE TEXT HALF
                LD      (HL), 0         ; HL NOW AT THE ATTR HALF
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, TEXTCOLS - 1
                LDIR                    ; ZERO ACROSS THE ATTR HALF
                POP     HL
                RET


; --- DIRADR                    ----------------------------------------

; - DIRADR -----------
; - ADDRESS OF A LINE DIRECTORY ENTRY
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: HL = DIRWIN + LINE * DIRSIZ
; - CLOBBERS: AF, DE
; - NOTE: RETURNS A WINDOW ADDRESS, ONLY VALID WHILE DIRSEG IS BANKED
; -

DIRADR          PUSH    HL
                ADD     HL, HL          ; * 2
                POP     DE
                ADD     HL, DE          ; * 3
                LD      DE, DIRWIN
                ADD     HL, DE
                RET


; --- DIRREAD                   ----------------------------------------

; - DIRREAD ----------
; - READ LINE DIRECTORY ENTRY
; - HL: LINE NUMBER (0-BASED)
; - OUTPUT:
; -     A:  SEGMENT NUMBER
; -     DE: BYTE OFFSET WITHIN SEGMENT
; -     PAGE 2 IS LEFT BANKED ON DIRSEG
; -
; - USES: HL (ENTRY ADDRESS), DE (OFFSET), A (SEG)
; -

DIRREAD         CALL    DIRBANK
                CALL    DIRADR
                LD      A, (HL)         ; SEGMENT
                INC     HL
                LD      E, (HL)
                INC     HL
                LD      D, (HL)         ; DE = OFFSET
                RET


; --- DIRWRITE                  ----------------------------------------

; - DIRWRITE ---------
; - WRITE LINE DIRECTORY ENTRY
; - HL: LINE NUMBER
; - A:  SEGMENT
; - DE: BYTE OFFSET WITHIN SEGMENT
; -     PAGE 2 IS LEFT BANKED ON DIRSEG
; -

DIRWRITE        PUSH    AF
                PUSH    DE
                CALL    DIRBANK
                CALL    DIRADR
                POP     DE              ; DE = OFFSET
                POP     AF              ; A = SEGMENT

                LD      (HL), A
                INC     HL
                LD      (HL), E
                INC     HL
                LD      (HL), D
                RET


; --- DIRBANK                   ----------------------------------------

; - DIRBANK ----------------------------
; - BANK THE DIRECTORY SEGMENT INTO PAGE 2
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF ONLY (HL IS PRESERVED -- PUTP2'S WRAPPER DESTROYS HL WITH
; - THE MAPPER ROUTINE ADDRESS, AND EVERY CALLER HERE CARRIES THE LINE NUMBER
; - IN HL FOR DIRADR)
; -
; - TXSEG FOLLOWS THE BANK, SO IT ALWAYS NAMES WHAT IS REALLY IN THE WINDOW.
; - NOTHING READS IT TO DECIDE WHETHER TO RE-BANK ANY MORE -- LINEREAD /
; - LINELEN / LINEWRT BANK UNCONDITIONALLY -- BUT FREEPOP READS IT BACK TO
; - REPORT THE SEGMENT IT HANDED OUT, AND IT IS THE ONE PLACE A STALE VALUE
; - WOULD STILL DO DAMAGE.
; -

DIRBANK         PUSH    HL
                LD      A, (DIRSEG)
                LD      (TXSEG), A
                CALL    PUTP2
                POP     HL
                RET


; --- LINEREAD                  ----------------------------------------

; - LINEREAD ---------------------------
; - LOAD LINE RECORD FROM TEXT SEGMENT INTO WORKBUF
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: WORKBUF POPULATED (LEN + TEXT PADDED TO TEXTCOLS + ATTRS 0)
; - CLOBBERS: ALL
; -
LINEREAD        CALL    DIRREAD         ; A=SEG, DE=OFFSET (PAGE 2 = DIRSEG)
                LD      (TXSEG), A
                CALL    PUTP2           ; PAGE 2 = RECORD SEGMENT
                LD      HL, TXPAGE
                ADD     HL, DE          ; HL = RECORD BASE IN TXPAGE

                ; RECORD HEADER: [RECCAP: 2B][RECLEN: 2B]
                LD      A, (HL)         ; A = RECCAP LOW (PAYLOAD BYTES)
                SRL     A               ; A = C (CHARACTER CAPACITY)
                LD      C, A            ; C = C
                INC     HL
                INC     HL              ; HL = TXPAGE + DE + RECLEN
                LD      E, (HL)
                INC     HL
                LD      D, (HL)         ; DE = RECLEN (E = L)
                INC     HL              ; HL = TXPAGE + DE + RECTXT (START OF TEXT)

                ; WORKBUF: [0] = LEN
                LD      A, E            ; LENGTH L (0..TEXTCOLS)
                LD      (WORKBUF), A
                OR      A
                JR      Z, .EMPTY

                ; L > 0:
                PUSH    BC              ; [SP] = C
                PUSH    HL              ; [SP] = TEXT SOURCE

                ; COPY L BYTES OF TEXT: HL -> WORKBUF + 1
                LD      DE, WORKBUF + 1
                LD      A, (WORKBUF)
                LD      C, A
                LD      B, 0            ; BC = L
                LDIR                    ; COPIES TEXT TO WORKBUF + 1..L

                ; PAD REMAINING CHARACTERS UP TO TEXTCOLS WITH SPACES
                LD      A, TEXTCOLS
                LD      HL, WORKBUF
                SUB     (HL)            ; A = TEXTCOLS - L
                JR      Z, .NOTXPAD     ; L == TEXTCOLS: NO PADDING
                LD      B, A            ; B = SPACES COUNT
                EX      DE, HL          ; HL = DE (WORKBUF + 1 + L)
.SPCLP          LD      (HL), ' '
                INC     HL
                DJNZ    .SPCLP

.NOTXPAD        ; NOW COPY ATTRIBUTES!
                POP     HL              ; HL = TEXT SOURCE
                POP     BC              ; C = CAPACITY C
                LD      B, 0
                ADD     HL, BC          ; HL = ATTR SOURCE (TEXT SOURCE + C)

                ; COPY L BYTES OF ATTRS: HL -> WORKBUF + 1 + TEXTCOLS
                LD      DE, WORKBUF + 1 + TEXTCOLS
                LD      A, (WORKBUF)    ; A = L
                LD      C, A
                LD      B, 0            ; BC = L
                LDIR                    ; COPIES ATTRS

                ; ZERO REMAINING ATTRIBUTES UP TO TEXTCOLS
                LD      A, TEXTCOLS
                LD      HL, WORKBUF
                SUB     (HL)            ; A = TEXTCOLS - L
                RET     Z               ; L == TEXTCOLS: ALL DONE!

                LD      B, A            ; B = COUNT OF REMAINING ATTRS
                EX      DE, HL          ; HL = DE (WORKBUF + 1 + TEXTCOLS + L)
.ATRZLP         LD      (HL), 0
                INC     HL
                DJNZ    .ATRZLP
                RET

.EMPTY          ; L == 0:
                ; PAD TEXTCOLS SPACES AT WORKBUF + 1
                LD      HL, WORKBUF + 1
                LD      B, TEXTCOLS
.EMPSPC         LD      (HL), ' '
                INC     HL
                DJNZ    .EMPSPC

                ; ZERO TEXTCOLS ATTRS AT WORKBUF + 1 + TEXTCOLS
                ; HL IS ALREADY AT WORKBUF + 1 + TEXTCOLS!
                LD      B, TEXTCOLS
.EMPATR         LD      (HL), 0
                INC     HL
                DJNZ    .EMPATR
                RET


; --- LINELEN                   ----------------------------------------


; - LINELEN ----------------------------
; - LENGTH OF A LINE WITHOUT COPYING ITS RECORD
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: A = LENGTH (0..80)
; - CLOBBERS: AF, BC, DE, HL
; -

LINELEN         CALL    DIRREAD         ; A = SEG, DE = OFFSET (PAGE 2 = DIRSEG)
                LD      (TXSEG), A
                CALL    PUTP2           ; PAGE 2 = RECORD SEGMENT
                LD      HL, TXPAGE + RECLEN
                ADD     HL, DE          ; HL = TXPAGE + DE + RECLEN
                LD      A, (HL)         ; A = RECLEN LOW (0..TEXTCOLS)
                RET


; --- PUTREC                    ----------------------------------------


; - PUTREC -----------------------------
; - WRITE RECORD INTO MAPPED RAM
; - IN:  A  = SEGMENT
; -      DE = OFFSET IN SEGMENT
; -      HL = SOURCE BUFFER ([HL]=LEN, [HL+1]=TEXT, [HL+1+TEXTCOLS]=ATTR)
; - OUT: NONE (PAGE 2 LEFT BANKED ON SEGMENT A)
; - CLOBBERS: AF, BC, DE, HL
; -
PUTREC          PUSH    IX
                PUSH    HL              ; SAVE SOURCE BUFFER PTR
                PUSH    DE              ; SAVE OFFSET
                CALL    RECBANK         ; BANK PAGE 2
                POP     DE              ; DE = OFFSET
                POP     IX              ; IX = SOURCE BUFFER

                ; HL = RECORD BASE IN TXPAGE
                LD      HL, TXPAGE
                ADD     HL, DE          ; HL = TXPAGE + DE

                ; GET C = RECCAP / 2
                LD      A, (HL)         ; A = RECCAP LOW (PAYLOAD BYTES)
                SRL     A               ; A = C
                LD      C, A            ; C = CAPACITY C

                ; GET L = SOURCE LENGTH
                LD      A, (IX + 0)     ; A = L

                ; WRITE RECLEN AT HL + RECLEN (HL + 2)
                INC     HL
                INC     HL              ; HL = RECORD BASE + 2 (RECLEN)
                LD      (HL), A         ; RECLEN LOW = L
                INC     HL
                LD      (HL), 0         ; RECLEN HIGH = 0
                INC     HL              ; HL = RECORD BASE + 4 (DEST TEXT)

                ; IF L == 0, NO PAYLOAD TO COPY
                OR      A
                JR      NZ, .HASPAY
                POP     IX
                RET

.HASPAY         ; L > 0:
                PUSH    BC              ; [SP] = C
                PUSH    HL              ; [SP] = DEST TEXT
                PUSH    AF              ; [SP] = L

                ; COPY TEXT: SOURCE (IX + 1) -> DEST (HL)
                EX      DE, HL          ; DE = DEST TEXT
                PUSH    IX
                POP     HL
                INC     HL              ; HL = SOURCE BUFFER + 1 (SOURCE TEXT)
                LD      C, A
                LD      B, 0            ; BC = L
                LDIR                    ; COPIES L BYTES TEXT

                ; COPY ATTRIBUTES: SOURCE (IX + 1 + TEXTCOLS) -> DEST (DEST TEXT + C)
                POP     AF              ; A = L
                POP     DE              ; DE = DEST TEXT
                POP     BC              ; C = CAPACITY C
                LD      B, 0
                EX      DE, HL
                ADD     HL, BC          ; HL = DEST TEXT + C (DEST ATTR)
                EX      DE, HL          ; DE = DEST ATTR

                PUSH    IX
                POP     HL
                LD      BC, 1 + TEXTCOLS
                ADD     HL, BC          ; HL = SOURCE BUFFER + 1 + TEXTCOLS (SOURCE ATTR)

                LD      C, A
                LD      B, 0            ; BC = L
                LDIR                    ; COPIES L BYTES ATTRS
                POP     IX
                RET


; --- LINEWRT                   ----------------------------------------


; - LINEWRT ----------------------------
; - WRITE WORKBUF BACK TO TEXT SEGMENT
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: CY = 0 SUCCESS, CY = 1 OOM (ON CAPACITY EXPANSION)
; - CLOBBERS: ALL
; -
LINEWRT         PUSH    HL              ; SAVE LINE NUMBER
                CALL    DIRREAD         ; A = SEG, DE = OFFSET (PAGE 2 = DIRSEG)
                CALL    RECBANK         ; PAGE 2 = RECORD SEGMENT
                LD      HL, TXPAGE
                ADD     HL, DE          ; HL = RECORD BASE IN TXPAGE
                LD      A, (HL)         ; A = RECCAP LOW (PAYLOAD BYTES)
                SRL     A               ; A = C (CHARACTER CAPACITY)
                LD      C, A            ; C = C
                EX      DE, HL          ; DE = RECORD BASE, HL = OFFSET (NOT NEEDED)

                ; COMPARE WORKBUF[0] WITH C
                LD      A, (WORKBUF)    ; A = NEW LEN (L)
                CP      C
                JR      C, .INPLAC      ; L < C: FITS IN PLACE
                JR      Z, .INPLAC      ; L == C: FITS IN PLACE

                ; L > C: CANNOT FIT IN PLACE, MUST RELOCATE!
                ; 1. TOMBSTONE OLD RECORD: SET RECLEN = TOMBVAL (#FFFF)
                EX      DE, HL          ; HL = RECORD BASE
                INC     HL
                INC     HL              ; HL = RECORD BASE + RECLEN
                LD      (HL), #FF
                INC     HL
                LD      (HL), #FF

                ; 2. ALLOCATE NEW RECORD WITH CAPACITY FOR WORKBUF[0]
                LD      A, (WORKBUF)
                LD      C, A            ; C = REQUIRED CAPACITY
                CALL    NEWREC
                JR      C, .OOM         ; CY = 1: OUT OF MEMORY

                ; NEWREC RETURNED: A = NEW SEG, DE = NEW OFFSET
                ; 3. WRITE WORKBUF TO NEW RECORD VIA PUTREC
                PUSH    AF
                PUSH    DE
                LD      HL, WORKBUF
                CALL    PUTREC          ; COPIES WORKBUF TEXT + ATTRS TO (A, DE)
                POP     DE              ; DE = NEW OFFSET
                POP     AF              ; A = NEW SEG

                ; 4. UPDATE DIRECTORY ENTRY FOR LINE
                POP     HL              ; RESTORE LINE NUMBER
                CALL    DIRWRITE        ; WRITE (A, DE) AT LINE HL
                OR      A               ; CY = 0: SUCCESS
                RET

.OOM            POP     HL              ; BALANCE PUSH HL
                SCF                     ; CY = 1: OOM
                RET

.INPLAC         ; FITS IN PLACE!
                ; DE = RECORD BASE (TXPAGE + OFFSET)
                ; C  = CAPACITY C
                ; A  = NEW LEN L
                EX      DE, HL          ; HL = RECORD BASE
                INC     HL
                INC     HL              ; HL = RECORD BASE + RECLEN
                LD      (HL), A         ; RECLEN LOW = L
                INC     HL
                LD      (HL), 0         ; RECLEN HIGH = 0
                INC     HL              ; HL = RECORD BASE + 4 (DEST TEXT)

                OR      A
                JR      Z, .DONE        ; L == 0: NO PAYLOAD TO COPY

                ; L > 0:
                ; HL = DEST TEXT
                ; C  = CAPACITY C
                ; A  = L
                PUSH    BC              ; [SP] = C
                PUSH    HL              ; [SP] = DEST TEXT
                PUSH    AF              ; [SP] = L

                ; COPY TEXT: WORKBUF + 1 -> DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF + 1
                LD      C, A
                LD      B, 0            ; BC = L
                LDIR                    ; COPIES TEXT

                ; COPY ATTRIBUTES: WORKBUF + 1 + TEXTCOLS -> DEST ATTR (DEST TEXT + C)
                POP     AF              ; A = L
                POP     DE              ; DE = DEST TEXT
                POP     BC              ; C = CAPACITY C
                LD      B, 0
                EX      DE, HL
                ADD     HL, BC          ; HL = DEST TEXT + C (DEST ATTR)
                EX      DE, HL          ; DE = DEST ATTR

                LD      HL, WORKBUF + 1 + TEXTCOLS
                LD      C, A
                LD      B, 0            ; BC = L
                LDIR                    ; COPIES ATTRS

.DONE           POP     HL              ; BALANCE PUSH HL (RESTORE LINE NUMBER)
                OR      A               ; CY = 0: SUCCESS
                RET


; --- APPEND CURSOR             ----------------------------------------
;
; NEW RECORDS ARE APPENDED AT (APPSEG, LINEOFF), WHICH ONLY EVER MOVES FORWARD.
; A 16KB SEGMENT HOLDS LINEPSEG (101) RECORDS.
;
; DELETED RECORDS GO ON A FREE LIST INSTEAD OF BEING ABANDONED. THEY ARE ALL
; THE SAME SIZE, SO NO COMPACTOR IS NEEDED -- LINEDEL PUSHES THE RECORD AND
; NEWREC POPS IT BEFORE EXTENDING LINEOFF. WITHOUT THIS, EVERY JOIN, REFLOW
; AND MULTI-LINE DELETE BURNED 161 BYTES FOR GOOD, AND ALTERNATING ENTER AND
; BACKSPACE WALKED THE APPEND CURSOR THROUGH THE WHOLE MAPPER WHILE THE
; DOCUMENT STAYED THE SAME SIZE. ON A STOCK 128KB MSX2 THAT IS ~300 KEYSTROKE
; PAIRS BEFORE ENTER STARTS BEING REFUSED.
;
; A RECORD IS ON THE FREE LIST OR IN THE DIRECTORY, NEVER BOTH: LINEINS
; DUPLICATES A DIRECTORY ENTRY ONLY FOR THE INSTANT BEFORE ITS CALLER FILLS
; THE NEW SLOT WITH A FRESHLY RESERVED RECORD, AND NO LINEDEL CAN RUN IN
; BETWEEN.


; - APPBANK ----------
; - BANK THE APPEND SEGMENT INTO PAGE 2
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

APPBANK         LD      A, (APPSEG)
                ; FALL THROUGH INTO RECBANK


; - RECBANK ----------------------------
; - BANK AN ARBITRARY TEXT SEGMENT INTO PAGE 2, KEEPING TXSEG IN STEP
; - IN:  A = SEGMENT NUMBER
; - OUT: NONE
; - CLOBBERS: AF, HL
; -
; - TXSEG MUST FOLLOW EVERY BANK SO IT ALWAYS NAMES WHAT IS REALLY IN THE
; - WINDOW. IT USED TO GATE A .SAME SHORT-CIRCUIT IN LINEREAD / LINEWRT /
; - LINELEN, WHICH IS GONE (A RECORD NEVER LIVES IN DIRSEG, SO THE CHECK
; - ALWAYS MISSED); ITS ONE REMAINING READER IS FREEPOP.
; -

RECBANK         LD      (TXSEG), A
                JP      PUTP2


; - FREEPSH ----------------------------
; - PUSH A RECORD ONTO THE FREE LIST
; - IN:  A  = SEGMENT NUMBER
; -      DE = BYTE OFFSET WITHIN THAT SEGMENT
; - OUT: NONE (PAGE 2 IS LEFT BANKED ON THAT SEGMENT)
; - CLOBBERS: AF, DE, HL
; -

FREEPSH         PUSH    AF
                PUSH    DE
                CALL    RECBANK
                POP     DE
                PUSH    DE
                LD      HL, TXPAGE
                ADD     HL, DE          ; HL = THE RECORD BEING FREED
                LD      A, (FREEHD)
                LD      (HL), A         ; LINK: SEGMENT
                INC     HL
                LD      A, (FREEOF)
                LD      (HL), A         ; LINK: OFFSET LOW
                INC     HL
                LD      A, (FREEOF + 1)
                LD      (HL), A         ; LINK: OFFSET HIGH
                POP     DE
                LD      (FREEOF), DE
                POP     AF
                LD      (FREEHD), A
                RET


; - FREEPOP ----------------------------
; - TAKE THE FIRST RECORD OFF THE FREE LIST
; - IN:  NONE
; - OUT: CY = 0  A  = SEGMENT NUMBER
; -              DE = BYTE OFFSET, PAGE 2 BANKED ON THAT SEGMENT
; -      CY = 1  THE LIST IS EMPTY, NOTHING WAS TOUCHED
; - CLOBBERS: AF, DE, HL
; -

FREEPOP         LD      A, (FREEHD)
                CP      FREENIL
                JR      Z, .NOFREE

                CALL    RECBANK
                LD      DE, (FREEOF)    ; DE = THE RECORD WE ARE HANDING OUT
                LD      HL, TXPAGE
                ADD     HL, DE
                LD      A, (HL)
                LD      (FREEHD), A     ; LINK: SEGMENT -> NEW HEAD
                INC     HL
                LD      A, (HL)
                LD      (FREEOF), A     ; LINK: OFFSET LOW
                INC     HL
                LD      A, (HL)
                LD      (FREEOF + 1), A ; LINK: OFFSET HIGH
                LD      A, (TXSEG)      ; THE SEGMENT RECBANK JUST SELECTED
                OR      A               ; CY = 0: RECORD HANDED OUT
                RET

.NOFREE         SCF
                RET


; --- NEWREC                    ----------------------------------------

; - NEWREC -----------------------------
; - RESERVE SPACE FOR ONE NEW LINE RECORD
; - IN:  C = MINIMUM TEXT CAPACITY NEEDED (0 = DEF_CAP)
; - OUT: CY = 0  A  = SEGMENT NUMBER
; -              DE = OFFSET OF THE RESERVED RECORD
; -              PAGE 2 IS LEFT BANKED ON THAT SEGMENT
; -      CY = 1  OOM (NO MAPPER MEMORY)
; - CLOBBERS: AF, BC, DE, HL
; -
NEWREC          LD      A, C
                CP      DEF_CAP + 1
                JR      NC, .GROW       ; C > DEF_CAP: CANNOT USE 36-BYTE FREE LIST

                ; C <= DEF_CAP: TRY 36-BYTE FREE LIST FIRST
                CALL    FREEPOP
                JR      C, .GROW        ; LIST EMPTY: ALLOCATE FROM APPSEG

                ; FREEPOP RETURNED A = SEG, DE = OFFSET (PAGE 2 BANKED)
                ; INITIALIZE DEFAULT HEADER AT TXPAGE + DE
                LD      HL, TXPAGE
                ADD     HL, DE
                LD      (HL), DEF_PAY   ; RECCAP LOW (32)
                INC     HL
                LD      (HL), 0         ; RECCAP HIGH (0)
                INC     HL
                LD      (HL), 0         ; RECLEN LOW (0)
                INC     HL
                LD      (HL), 0         ; RECLEN HIGH (0)
                LD      A, (TXSEG)
                OR      A               ; CY = 0: SUCCESS
                RET

.GROW           ; COMPUTE CAPACITY: ROUND UP TO QUANTUM (16), MIN DEF_CAP (16)
                LD      A, C
                ADD     A, QUANTUM - 1
                AND     ~(QUANTUM - 1)
                CP      DEF_CAP
                JR      NC, .CAPOK
                LD      A, DEF_CAP
.CAPOK          ; A = CHARACTER CAPACITY (16, 32, 48, 64, 80)
                ; PAYLOAD P = 2 * CAPACITY (32, 64, 96, 128, 160)
                RLCA                    ; A = P (PAYLOAD BYTES)
                LD      C, A            ; C = P
                ; TOTAL RECORD SIZE = RECHDR_SZ (4) + P
                ADD     A, RECHDR_SZ
                LD      E, A
                LD      D, 0            ; DE = TOTAL RECORD SIZE
                PUSH    BC              ; [SP] = P IN C
                LD      B, D
                LD      C, E            ; BC = TOTAL RECORD SIZE
                CALL    RECGET
                POP     BC              ; RESTORE P IN C
                RET     C               ; OOM

                ; RECGET RETURNED: A = SEG, DE = OFFSET (PAGE 2 BANKED)
                ; INITIALIZE HEADER AT TXPAGE + DE
                PUSH    AF
                PUSH    DE
                LD      HL, TXPAGE
                ADD     HL, DE
                LD      (HL), C         ; RECCAP LOW = P
                INC     HL
                LD      (HL), 0         ; RECCAP HIGH = 0
                INC     HL
                LD      (HL), 0         ; RECLEN LOW (0)
                INC     HL
                LD      (HL), 0         ; RECLEN HIGH (0)
                POP     DE
                POP     AF
                OR      A               ; CY = 0: SUCCESS
                RET


; --- RECGET                    ----------------------------------------

; - RECGET -----------------------------
; - ALLOCATE BC BYTES IN APPSEG (WITH COMPACTION OR EXPANSION)
; - IN:  BC = TOTAL RECORD SIZE IN BYTES
; - OUT: CY = 0  A  = APPSEG
; -              DE = OFFSET IN APPSEG
; -              PAGE 2 BANKED ON APPSEG
; -      CY = 1  OOM
; - CLOBBERS: ALL
; -
RECGET          ; 1. CHECK IF RECORD FITS IN APPSEG AT (LINEOFF)
                LD      HL, (LINEOFF)
                LD      DE, SEGSIZE
                EX      DE, HL
                OR      A
                SBC     HL, DE          ; HL = SEGSIZE - LINEOFF
                LD      D, B
                LD      E, C            ; DE = NEEDED BYTES
                CALL    CMPHLDE
                JR      NC, .ALLOC      ; FITS!

                ; 2. DOES NOT FIT: TRY COMPACTING APPSEG
                PUSH    BC
                LD      A, (APPSEG)
                CALL    SEGCOMP
                POP     BC

                ; CHECK AGAIN AFTER COMPACTION
                LD      HL, (LINEOFF)
                LD      DE, SEGSIZE
                EX      DE, HL
                OR      A
                SBC     HL, DE
                LD      D, B
                LD      E, C
                CALL    CMPHLDE
                JR      NC, .ALLOC      ; FITS AFTER COMPACTION!

                ; 3. STILL DOES NOT FIT: CLAIM A FRESH SEGMENT
                PUSH    BC
                CALL    SEGGET
                POP     BC
                RET     C               ; OOM

                ; NEW SEGMENT CLAIMED: A = NEW SEGMENT
                LD      (APPSEG), A
                LD      HL, 0
                LD      (LINEOFF), HL

.ALLOC          CALL    APPBANK
                LD      HL, (LINEOFF)
                PUSH    HL
                LD      D, B
                LD      E, C
                ADD     HL, DE
                LD      (LINEOFF), HL
                POP     DE              ; DE = ALLOCATED OFFSET
                LD      A, (APPSEG)
                OR      A               ; CY = 0: SUCCESS
                RET


; --- LINEINS                   ----------------------------------------

; - LINEINS ----------
; - OPEN A SLOT IN THE LINE DIRECTORY AT LINE N
; - IN:  HL = LINE NUMBER TO OPEN (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; - SHIFTS ENTRIES N..TOTLINES-1 ONE SLOT UP. TOTLINES IS LEFT ALONE -- THE
; - CALLER FILLS THE SLOT WITH DIRWRITE AND BUMPS THE COUNT.
; -

LINEINS         LD      DE, (TOTLINES)
                EX      DE, HL          ; HL = TOTLINES, DE = N
                OR      A
                SBC     HL, DE          ; HL = ENTRIES TO SHIFT
                LD      A, H
                OR      L
                RET     Z               ; INSERTING PAST THE LAST LINE

                PUSH    HL
                ADD     HL, HL
                POP     DE
                ADD     HL, DE          ; HL = COUNT * DIRSIZ
                LD      B, H
                LD      C, L            ; BC = BYTES TO MOVE

                CALL    DIRBANK         ; THE SHIFT RUNS INSIDE THE DIRECTORY WINDOW
                LD      HL, (TOTLINES)
                CALL    DIRADR
                DEC     HL              ; HL = LAST BYTE OF THE LAST ENTRY
                PUSH    HL
                LD      DE, DIRSIZ
                ADD     HL, DE
                EX      DE, HL          ; DE = LAST BYTE OF THE NEW LAST ENTRY
                POP     HL
                LDDR                    ; SHIFT BACKWARDS, SLOT N IS NOW FREE
                RET


; --- LINEDEL                   ----------------------------------------

; - LINEDEL ----------------------------
; - CLOSE THE DIRECTORY SLOT OF LINE N
; - IN:  HL = LINE NUMBER (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; - SHIFTS ENTRIES N+1..TOTLINES-1 DOWN ONE SLOT. TOTLINES IS LEFT ALONE.
; -
LINEDEL         PUSH    HL              ; SAVE N
                CALL    DIRREAD         ; A = SEGMENT, DE = OFFSET OF RECORD
                CALL    RECBANK         ; BANK RECORD SEGMENT INTO PAGE 2

                ; CHECK RECCAP AT TXPAGE + DE
                LD      HL, TXPAGE
                ADD     HL, DE          ; HL = RECORD BASE
                LD      A, (HL)         ; A = RECCAP LOW
                LD      C, A            ; C = RECCAP LOW

                ; TOMBSTONE RECORD: SET RECLEN = TOMBVAL (#FFFF)
                INC     HL
                INC     HL              ; HL = TXPAGE + DE + RECLEN
                LD      (HL), #FF
                INC     HL
                LD      (HL), #FF

                ; IF RECCAP == DEF_PAY (32), PUSH ONTO FREE LIST FOR REUSE
                LD      A, C
                CP      DEF_PAY
                JR      NZ, .NOFREE
                LD      A, (TXSEG)      ; A = SEGMENT
                CALL    FREEPSH

.NOFREE         POP     HL              ; RESTORE N
                PUSH    HL              ; SAVE N

                ; SHIFT DIRECTORY ENTRIES N+1..TOTLINES-1 DOWN ONE SLOT
                CALL    DIRBANK

                LD      DE, (TOTLINES)
                EX      DE, HL          ; HL = TOTLINES, DE = N
                OR      A
                SBC     HL, DE
                DEC     HL              ; HL = ENTRIES AFTER N
                LD      A, H
                OR      L
                JR      Z, .NOMOVE      ; N IS THE LAST LINE, NOTHING FOLLOWS

                PUSH    HL
                ADD     HL, HL
                POP     DE
                ADD     HL, DE          ; HL = COUNT * DIRSIZ
                LD      B, H
                LD      C, L            ; BC = BYTES TO MOVE

                POP     HL              ; HL = N
                PUSH    HL
                CALL    DIRADR          ; HL = SLOT N
                PUSH    HL
                LD      DE, DIRSIZ
                ADD     HL, DE          ; HL = SLOT N+1 (SOURCE)
                POP     DE              ; DE = SLOT N (DEST)
                LDIR

.NOMOVE         POP     HL
                RET
