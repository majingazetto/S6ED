;                                       ****************************************
;                                       * GENERIC HELP ROUTINES                *
;                                       ****************************************


; --- BIOS RELATED                      ----------------------------------------


; - BIOSCALL ---------------------------
; - CALL MAIN BIOS ROUTINE VIA CALSLT
; - IN:  IX = BIOS ROUTINE ADDRESS
; -      REGISTERS AS EXPECTED BY BIOS ROUTINE
; - OUT: REGISTERS AS RETURNED BY BIOS ROUTINE
; - CLOBBERS: IY
; -

BIOSCALL        PUSH    AF
                LD      A, (EXPTBL)
                LD      IYH, A
                POP     AF
                CALL    CALSLT
                EI
                RET


; --- READROW                   ----------------------------------------


; - READROW ----------------------------
; - READ A KEYBOARD MATRIX ROW VIA BIOS SNSMAT
; - IN:  A = ROW NUMBER (0..11)
; - OUT: A = ROW DATA (ACTIVE LOW: 0=PRESSED, 1=RELEASED)
; - CLOBBERS: AF, IX
; -

READROW         PUSH    BC
                LD      IX, SNSMAT
                CALL    BIOSCALL
                POP     BC
                RET


; - DBGMSG -----------------------------
; - OUTPUT INLINE STRING TO OPENMSX DEBUGDEVICE (PORTS #2E/#2F)
; - USAGE: CALL DBGMSG; DEFM "TEXT", 10, 0
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; - ONLY ASSEMBLED IN A  make DEBUG=1  BUILD (SEE THE DBG MACRO)
; -

                IFDEF   DEBUG

DBGMSG          EX      (SP), HL
                PUSH    AF
                LD      A, #63
                OUT     (#2E), A
.LOOP           LD      A, (HL)
                INC     HL
                AND     A
                JR      Z, .DONE
                OUT     (#2F), A
                JR      .LOOP
.DONE           POP     AF
                EX      (SP), HL
                RET

                ENDIF


; - CMPHLDE ----------
; - COMPARE HL WITH DE
; - (RST 20)
; -

CMPHLDE         LD      A,H
                SUB     D
                RET     NZ
                LD      A,L
                SUB     E
                RET     

; --- STRING                           ----------------------------------------


; COMBINED ROUTINE FOR CONVERSION OF DIFFERENT SIZED BINARY NUMBERS INTO
; DIRECTLY PRINTABLE ASCII(Z)-STRING
; INPUT VALUE IN REGISTERS, NUMBER SIZE AND -RELATED TO THAT- REGISTERS TO FILL
; IS SELECTED BY CALLING THE CORRECT ENTRY:
;
;  ENTRY  INPUTREGISTER(S)  DECIMAL VALUE 0 TO:
;   B2D8             A                    255  (3 DIGITS)
;   B2D16           HL                  65535   5   "
;   B2D24         E:HL               16777215   8   "
;   B2D32        DE:HL             4294967295  10   "
;   B2D48     BC:DE:HL        281474976710655  15   "
;   B2D64  IX:BC:DE:HL   18446744073709551615  20   "
;
; THE RESULTING STRING IS PLACED INTO A SMALL BUFFER ATTACHED TO THIS ROUTINE,
; THIS BUFFER NEEDS NO INITIALIZATION AND CAN BE MODIFIED AS DESIRED.
; THE NUMBER IS ALIGNED TO THE RIGHT, AND LEADING 0'S ARE REPLACED WITH SPACES.
; ON EXIT HL POINTS TO THE FIRST DIGIT, (B)C = NUMBER OF DECIMALS
; THIS WAY ANY RE-ALIGNMENT / POSTPROCESSING IS MADE EASY.
; CHANGES: AF,BC,DE,HL,IX
; P.S. SOME EXAMPLES BELOW

; BY ALWIN HENSELER


B2D8            LD      H,0
                LD      L,A
B2D16           LD      E,0
B2D24           LD      D,0
B2D32           LD      BC,0
B2D48           LD      IX,0            ; ZERO ALL NON-USED BITS
B2D64           LD      (B2DINV),HL
                LD      (B2DINV + 2),DE
                LD      (B2DINV + 4),BC
                LD      (B2DINV + 6),IX ; PLACE FULL 64-BIT INPUT VALUE IN BUFFER
                LD      HL,B2DBUF
                LD      DE,B2DBUF + 1
                LD      (HL)," "
B2DFILC         EQU     $ - 1           ; ADDRESS OF FILL-CHARACTER
                LD      BC,18
                LDIR                    ; FILL 1ST 19 BYTES OF BUFFER WITH SPACES
                LD      (B2DEND-1),BC   ; SET BCD VALUE TO "0" & PLACE TERMINATING 0
                LD      E,1             ; NO. OF BYTES IN BCD VALUE
                LD      HL,B2DINV + 8   ; (ADDRESS MSB INPUT)+1
                LD      BC,#0909
                XOR     A
B2DSKP0         DEC     B
                JR      Z,B2DSIZ        ; ALL 0: CONTINUE WITH POSTPROCESSING
                DEC     HL
                OR      (HL)            ; FIND FIRST BYTE <>0
                JR      Z,B2DSKP0
B2DFND1         DEC     C
                RLA
                JR      NC,B2DFND1      ; DETERMINE NO. OF MOST SIGNIFICANT 1-BIT
                RRA
                LD      D,A             ; BYTE FROM BINARY INPUT VALUE
B2DLUS2         PUSH    HL
                PUSH    BC
B2DLUS1         LD      HL,B2DEND - 1   ; ADDRESS LSB OF BCD VALUE
                LD      B,E             ; CURRENT LENGTH OF BCD VALUE IN BYTES
                RL      D               ; HIGHEST BIT FROM INPUT VALUE -> CARRY
B2DLUS0         LD      A,(HL)
                ADC     A,A
                DAA
                LD      (HL),A          ; DOUBLE 1 BCD BYTE FROM INTERMEDIATE RESULT
                DEC     HL
                DJNZ    B2DLUS0         ; AND GO ON TO DOUBLE ENTIRE BCD VALUE (+CARRY!)
                JR      NC,B2DNXT
                INC     E               ; CARRY AT MSB -> BCD VALUE GREW 1 BYTE LARGER
                LD      (HL),1          ; INITIALIZE NEW MSB OF BCD VALUE
B2DNXT          DEC     C
                JR      NZ,B2DLUS1      ; REPEAT FOR REMAINING BITS FROM 1 INPUT BYTE
                POP     BC              ; NO. OF REMAINING BYTES IN INPUT VALUE
                LD      C,8             ; RESET BIT-COUNTER
                POP     HL              ; POINTER TO BYTE FROM INPUT VALUE
                DEC     HL
                LD      D,(HL)          ; GET NEXT GROUP OF 8 BITS
                DJNZ    B2DLUS2         ; AND REPEAT UNTIL LAST BYTE FROM INPUT VALUE
B2DSIZ          LD      HL,B2DEND       ; ADDRESS OF TERMINATING 0
                LD      C,E             ; SIZE OF BCD VALUE IN BYTES
                OR      A
                SBC     HL,BC           ; CALCULATE ADDRESS OF MSB BCD
                LD      D,H
                LD      E,L
                SBC     HL,BC
                EX      DE,HL           ; HL=ADDRESS BCD VALUE, DE=START OF DECIMAL VALUE
                LD      B,C             ; NO. OF BYTES BCD
                SLA     C               ; NO. OF BYTES DECIMAL (POSSIBLY 1 TOO HIGH)
                LD      A,'0'
                RLD                     ; SHIFT BITS 4-7 OF (HL) INTO BIT 0-3 OF A
                CP      '0'             ; (HL) WAS > #9?
                JR      NZ,B2DEXPH      ; IF YES, START WITH RECORDING HIGH DIGIT
                DEC     C               ; CORRECT NUMBER OF DECIMALS
                INC     DE              ; CORRECT START ADDRESS
                JR      B2DEXPL         ; CONTINUE WITH CONVERTING LOW DIGIT
B2DEXP          RLD                     ; SHIFT HIGH DIGIT (HL) INTO LOW DIGIT OF A
B2DEXPH         LD      (DE),A          ; RECORD RESULTING ASCII-CODE
                INC     DE
B2DEXPL         RLD
                LD      (DE),A
                INC     DE
                INC     HL              ; NEXT BCD-BYTE
                DJNZ    B2DEXP          ; AND GO ON TO CONVERT #EAC BCD-BYTE INTO 2 ASCII
                SBC     HL,BC           ; RETURN WITH HL POINTING TO 1ST DECIMAL
                RET


; --- HL                                ----------------------------------------


; - ADDHLA -----------
; - HL = HL + A
; - 

ADDHLA          ADD     A,L
                LD      L,A
                RET     NC
                INC     H
                RET

                
; - ADDHLPNT ---------
; - A * 2
; - HL + = A
; - HL = (HL)
; - A = (HL)
; - 

ADDHLPNT        ADD     A,A
                CALL    ADDHLA


; - PNTHL ------------
; - HL = (HL) 
; - A = (HL)  
; -

PNTHL           LD      A,(HL)
                INC     HL
                LD      H,(HL)
                LD      L,A
                ;LD     A,(HL)
                RET


; - CALHL ---------------
; - CALL HL
; -

CALHL           JP   (HL) 


; - CALFUN --------------     
; - HL: POINTER 
; - A * 2       
; - HL + = A    
; - HL = (HL)   
; - JP (HL)     
; -

CALFUN          CALL ADDHLPNT
                JP   (HL)


; --- FUNCTION KEYS             -----------------------------------------


; - SETFNKY -----------------------------
; - PROGRAM THE FUNCTION KEYS TO DELIVER ONE CODE EACH
; - THE BIOS EXPANDS F1-F10 TO THE STRINGS IN FNKSTR, WHICH UNDER DOS ARE
; - STILL BASIC'S ("goto " FOR F3), SO THE KEYMAP ENTRIES F1KEY.. COULD
; - NEVER FIRE AND F3 TYPED "goto " INTO THE DOCUMENT. EACH 16-BYTE SLOT
; - BECOMES [F1KEY + N, 0]; THE TWO BYTES OVERWRITTEN ARE SAVED IN FNKBUF
; - FOR REFNKEY.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

SETFNKY         LD      HL, FNKSTR
                LD      DE, FNKBUF
                LD      BC, 10 * 256 + F1KEY
.LOOP           LD      A, (HL)
                LD      (DE), A
                INC     DE
                INC     HL
                LD      A, (HL)
                LD      (DE), A
                INC     DE
                LD      (HL), 0
                DEC     HL
                LD      (HL), C
                INC     C
                PUSH    BC
                LD      BC, 16
                ADD     HL, BC
                POP     BC
                DJNZ    .LOOP
                RET


; - REFNKEY ------------------------------
; - RESTORE THE FUNCTION KEY STRINGS SAVED BY SETFNKY
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

REFNKEY         LD      HL, FNKSTR
                LD      DE, FNKBUF
                LD      B, 10
.LOOP           LD      A, (DE)
                INC     DE
                LD      (HL), A
                INC     HL
                LD      A, (DE)
                INC     DE
                LD      (HL), A
                PUSH    BC
                LD      BC, 15
                ADD     HL, BC
                POP     BC
                DJNZ    .LOOP
                RET




; --- ATOI16                    ----------------------------------------


; - ATOI16 -----------------------------
; - PARSE AN ASCIIZ DECIMAL STRING INTO A 16-BIT VALUE, SATURATING
; - IN:  HL = ASCIIZ STRING
; - OUT: HL = VALUE, SATURATED AT 65535. A NON-DIGIT ENDS THE SCAN
; - CLOBBERS: AF, BC, DE, HL
; -
; - CFG.Z8A'S GETNUM CANNOT SERVE HERE: IT IS IFNDEF S2ED AND IT LIVES IN
; - THE FEATURE CONTAINER, WHILE THIS RUNS IN PAGE 1 ON BOTH TARGETS.
; -

ATOI16          LD      DE, 0           ; DE = ACCUMULATOR
.LOOP           LD      A, (HL)
                SUB     '0'
                JR      C, .DONE        ; BELOW '0': DONE
                CP      10
                JR      NC, .DONE       ; ABOVE '9': DONE
                INC     HL
                PUSH    HL
                LD      B, A            ; B = DIGIT
                ; DE = DE * 10, SATURATING
                LD      H, D
                LD      L, E
                ADD     HL, HL
                JR      C, .SAT
                ADD     HL, HL
                JR      C, .SAT
                ADD     HL, DE
                JR      C, .SAT
                ADD     HL, HL
                JR      C, .SAT
                LD      E, B
                LD      D, 0
                ADD     HL, DE          ; + DIGIT
                JR      C, .SAT
                EX      DE, HL          ; DE = NEW ACCUMULATOR
                POP     HL
                JR      .LOOP
.SAT            POP     HL
                LD      DE, #FFFF
                ; SKIP WHAT IS LEFT SO THE SCAN STILL ENDS CLEANLY
.SATLP          LD      A, (HL)
                SUB     '0'
                JR      C, .DONE
                CP      10
                JR      NC, .DONE
                INC     HL
                JR      .SATLP
.DONE           EX      DE, HL
                RET
