;                                       ****************************************
;                                       * FILE I/O                             *
;                                       ****************************************
;
; USES HIGH-LEVEL DSK* WRAPPERS FROM BDOS.Z8A (DOS1/DOS2 TRANSPARENT).


; --- FILENEW                   ----------------------------------------

FILENEW         JP      BUFRESET


; --- CHKFLEN                   ----------------------------------------


; - CHKFLEN ----------------------------
; - CHECK IF FILE SIZE EXCEEDS MAXIMUM AVAILABLE DOCUMENT CAPACITY
; - IN:  DE:HL = FILE SIZE IN BYTES (FROM DSKOPEN)
; - OUT: CY = 0: FILE MAY FIT IN MEMORY
; -      CY = 1: FILE DEFINITELY EXCEEDS MAXIMUM CAPACITY
; - CLOBBERS: AF, BC, DE, HL
; -

CHKFLEN         PUSH    DE              ; [SP+2] = FILE SIZE HIGH
                PUSH    HL              ; [SP]   = FILE SIZE LOW

                ; COMPUTE SEGLNS * (TEXTCOLS + 2) -> 24-BIT RESULT IN D:HL
                LD      BC, (SEGLNS)
                LD      E, TEXTCOLS + 2
                LD      HL, 0
                LD      D, 0
                LD      A, 8
.MULLP          ADD     HL, HL
                RL      D
                RLC     E
                JR      NC, .NOADD
                ADD     HL, BC
                JR      NC, .NOADD
                INC     D
.NOADD          DEC     A
                JR      NZ, .MULLP

                ; D = MAX HIGH BYTE, HL = MAX LOW WORD
                LD      A, D            ; A = MAX HIGH BYTE
                EX      DE, HL          ; DE = MAX LOW WORD
                POP     HL              ; HL = FILE SIZE LOW WORD
                EX      (SP), HL        ; [SP] = FILE SIZE LOW WORD, HL = FILE SIZE HIGH WORD

                LD      B, A            ; B = MAX HIGH BYTE
                LD      A, H
                OR      A
                JR      NZ, .TOOBIG     ; FILE SIZE >= 16 MB -> DEFINITELY TOOBIG
                LD      A, L            ; A = FILE SIZE HIGH BYTE
                CP      B               ; COMPARE WITH MAX HIGH BYTE
                JR      C, .FITS        ; FILE HIGH < MAX HIGH -> FITS
                JR      NZ, .TOOBIG     ; FILE HIGH > MAX HIGH -> TOOBIG

                ; HIGH BYTES EQUAL: COMPARE LOW WORDS (FILE LOW IN [SP] VS MAX LOW IN DE)
                POP     HL              ; HL = FILE SIZE LOW WORD
                CALL    CMPHLDE         ; CY=1 IF HL < DE, Z=1 IF HL == DE
                JR      Z, .OK
                JR      C, .OK
                SCF
                RET

.FITS           POP     HL              ; CLEAN STACK
.OK             AND     A               ; CY = 0
                RET

.TOOBIG         POP     HL              ; CLEAN STACK
                SCF                     ; CY = 1
                RET


; --- FILELOAD                  ----------------------------------------


; - FILELOAD ---------------------------
; - LOAD A FILE, SAYING SO ON THE STATUS BAR WHILE IT HAPPENS
; - IN:  HL: FILENAME (ASCIIZ), AS LOADDOC
; - OUT: AS LOADDOC, AND STATMSG EMPTY ON EVERY EXIT
; - CLOBBERS: ALL
; -
; - A LARGE FILE TAKES SECONDS ON A FLOPPY (THE 990-LINE MANUAL, 15 S ON
; - THE 2 MB MACHINE) AND THE SCREEN USED TO STAY UNCHANGED THROUGHOUT,
; - WHICH READS AS A HANG. "Loading..." GOES UP BEFORE THE OPEN AND
; - LOADDOC TURNS IT INTO A BAR OVER THE FILE SIZE (PRGBEG / PRGADV).
; - THE LINE COUNT IS NOT REPEATED THERE: THE RIGHT CHANNEL ALREADY
; - SHOWS TOTLINES GROWING. IT IS CLEARED ON EVERY EXIT SO THE
; - CALLER'S OWN VERDICT ([CANNOT OPEN], [NEW FILE]) OR LOADERR'S
; - [FILE TOO LARGE], WHICH BLDSTAT SHOWS ONLY WITH STATMSG EMPTY, WINS.
; - THE CALLER MUST HAVE THE CHROME UP: AT BOOT IT IS DRAWN FIRST.
; -

FILELOAD        PUSH    HL
                LD      HL, STRLDG
                CALL    SETMSG
                CALL    DRWSTAT
                POP     HL
                CALL    LOADDOC
                PUSH    AF
                XOR     A
                LD      (STATMSG), A
                POP     AF
                RET


; - LOADDOC ----------------------------
; - LOAD FILE FROM DISK INTO BUFFER
; - IN:  HL: FILENAME (ASCIIZ). MAY BE FILENAME ITSELF (BOOT) OR ANY
; -      OTHER BUFFER (:e); FILENAME TAKES THE NAME ONLY ON SUCCESS.
; - OUT: CY = 0: LOADED, FILENAME = THE NAME, MODIFIED = 0
; -      CY = 1: NOT LOADED. LOADERR = 1: TOO LARGE; OTHERWISE THE FILE
; -      COULD NOT BE OPENED AND A = THE DOS ERROR (ENOFIL = NOT FOUND)
; - CLOBBERS: ALL
; -
; - THE DOCUMENT IS RESET ONLY ONCE THE FILE IS OPEN AND KNOWN TO FIT:
; - A FAILED OPEN OR A REFUSED SIZE LEAVES THE DOCUMENT, FILENAME AND
; - MODIFIED EXACTLY AS THEY WERE. IT USED TO RESET FIRST, SO :e ON A
; - MISSING OR OVERSIZED FILE HAD ALREADY THROWN THE DOCUMENT AWAY.
; - ONLY A CAPACITY FAILURE HALFWAY THROUGH THE READ (.OOMNL) CAN STILL
; - LOSE IT, AND THAT PATH CLEARS FILENAME SO CTRL+S CANNOT OVERWRITE
; - THE FILE WITH THE REMAINS.
; -

LOADDOC         XOR     A
                LD      (LOADERR), A
                PUSH    HL              ; [SP] = NAME

                CALL    DSKOPEN         ; A=HANDLE, DEHL=SIZE
                JR      C, .NOOPEN
                LD      (FILEHAND), A
                LD      (PRGTOT), HL    ; THE BAR'S 100%: THE FILE SIZE
                LD      A, E
                LD      (PRGTOT + 2), A

                ; PRE-CHECK FILE SIZE: REJECT IMMEDIATELY IF FILE CANNOT FIT
                CALL    CHKFLEN
                JR      NC, .FITOK

                ; FILE EXCEEDS MAXIMUM THEORETICAL CAPACITY. AT BOOT THE NAME
                ; IS FILENAME ITSELF, WHICH MUST NOT KEEP POINTING AT A FILE
                ; THE EMPTY DOCUMENT WOULD OVERWRITE; FROM :e IT IS ANOTHER
                ; BUFFER AND THE CURRENT DOCUMENT KEEPS ITS OWN NAME.
                LD      A, (FILEHAND)
                CALL    DSKCLOSE
                POP     HL
                LD      DE, FILENAME
                OR      A
                SBC     HL, DE
                JR      NZ, .BIGSET
                XOR     A
                LD      (FILENAME), A   ; PROTECT THE DISK FILE
.BIGSET         LD      A, 1
                LD      (LOADERR), A    ; SIGNAL ERROR
                SCF
                RET

.NOOPEN         POP     HL
                RET                     ; CY = 1, A = DOS ERROR

.FITOK          CALL    FILENEW         ; ONLY NOW DOES THE DOCUMENT GO
                POP     HL
                CALL    FNAMSET         ; THE NAME BECOMES THE DOCUMENT'S
                XOR     A
                LD      (MODIFIED), A

                LD      HL, 0
                LD      (TOTLINES), HL
                LD      (LINEOFF), HL
                XOR     A
                LD      (CURLLEN), A
                LD      (WASCR), A
                LD      (EOLARED), A
                LD      HL, STRLDG
                CALL    PRGBEG

.READBLK        LD      A, (FILEHAND)
                LD      HL, 256
                LD      DE, FILEBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      A, H
                OR      L
                JP      Z, .EOF
                PUSH    HL
                CALL    PRGADV          ; NO PAGE 2 STATE IS LIVE BETWEEN
                POP     HL              ; BLOCKS: STORLINE BANKS ITS OWN
                
                LD      B, H
                LD      C, L            ; BC = BYTES TO PROCESS
                LD      HL, FILEBUF
.PROCLP         PUSH    BC
                PUSH    HL
                
                LD      A, (HL)
                CP      13              ; CR
                JR      Z, .ISCR
                CP      10              ; LF
                JP      Z, .ISLF
                CP      9               ; TAB
                JR      Z, .ISTAB
                
                ; REGULAR CHARACTER: CLEAR WASCR
                PUSH    AF
                XOR     A
                LD      (WASCR), A
                POP     AF
                
                ; APPEND TO WORKBUF IN TPA RAM
                LD      B, A
                LD      A, (CURLLEN)
                CP      MAXCOLS
                JP      NC, .SKIP       ; TRUNCATE AT MAX LINE WIDTH

                LD      HL, WORKBUF + 1
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = WORKBUF + 1 + CURLLEN
                LD      (HL), B

                INC     A
                LD      (CURLLEN), A
                JP      .SKIP

.ISTAB          ; TAB EXPANSION: INSERT SPACES UP TO NEXT TAB STOP
                XOR     A
                LD      (WASCR), A

                LD      A, (TABWIDTH)
                LD      D, A            ; D = TABWIDTH
                LD      A, (CURLLEN)
.TABMD          CP      D
                JR      C, .TABRM
                SUB     D
                JR      .TABMD
.TABRM          ; A = CURLLEN % TABWIDTH
                LD      E, A
                LD      A, D
                SUB     E               ; A = SPACES TO ADD (1..TABWIDTH)
                LD      E, A            ; E = COUNT OF SPACES

.TABSP          LD      A, (CURLLEN)
                CP      MAXCOLS
                JP      NC, .SKIP       ; TRUNCATE AT MAX LINE WIDTH

                LD      HL, WORKBUF + 1
                LD      C, A
                LD      B, 0
                ADD     HL, BC
                LD      (HL), ' '

                LD      A, (CURLLEN)
                INC     A
                LD      (CURLLEN), A

                DEC     E
                JR      NZ, .TABSP
                JP      .SKIP

.ISCR           LD      A, 1
                LD      (WASCR), A
                ; EOL AUTO-DETECT: DOS CRLF
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORCR
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORCR
                XOR     A
                LD      (SAVEEOL), A    ; DETECTED DOS (CRLF)
                INC     A
                LD      (EOLARED), A
.STORCR         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP

.ISLF           LD      A, (WASCR)
                AND     A
                JR      NZ, .SKIPLF     ; IF CRLF, SKIP THE LF
                ; STANDALONE LF: UNIX EOL
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORLF
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORLF
                LD      A, 1
                LD      (SAVEEOL), A    ; DETECTED UNIX (LF)
                LD      (EOLARED), A
.STORLF         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP
.SKIPLF         XOR     A
                LD      (WASCR), A
                JP      .SKIP

.OOM            POP     HL              ; BALANCE PUSH HL IN .PROCLP
                POP     BC              ; BALANCE PUSH BC IN .PROCLP
.OOMNL          ; ROLLBACK DUE TO CAPACITY EXHAUSTION DURING LOAD
                LD      A, (FILEHAND)
                CALL    DSKCLOSE
                CALL    SEGTRIM         ; FREE ANY ALLOCATED MAPPER SEGMENTS
                CALL    BUFRESET        ; RESET BUFFER TO 1 CLEAN EMPTY LINE
                XOR     A
                LD      (FILENAME), A   ; PROTECT DISK FILE AGAINST OVERWRITE
                INC     A
                LD      (LOADERR), A    ; SIGNAL LOAD ERROR
                SCF                     ; RETURN ERROR
                RET

.SKIP           POP     HL
                INC     HL
                POP     BC
                DEC     BC
                LD      A, B
                OR      C
                JP      NZ, .PROCLP
                JP      .READBLK

.EOF            LD      A, (CURLLEN)
                AND     A
                JR      Z, .CHKTOT
                CALL    STORLINE        ; STORE FINAL PENDING LINE
                JR      C, .OOMNL
                JR      .CLSFIL
.CHKTOT         LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                JR      NZ, .CLSFIL
                CALL    STORLINE        ; ENSURE AT LEAST 1 LINE IF FILE WAS EMPTY
                JR      C, .OOMNL
.CLSFIL         LD      A, (FILEHAND)
                CALL    DSKCLOSE
                
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                LD      (LEFTCOL), A
                AND     A               ; CY = 0: SUCCESSFUL LOAD
                RET

; - FNAMSET ----------------------------
; - MAKE A NAME THE DOCUMENT'S FILENAME
; - IN:  HL = ASCIIZ NAME (FILENAME ITSELF IS A NO-OP)
; - OUT: FILENAME = THE NAME, TRUNCATED TO FNAMLEN - 1 CHARACTERS
; - CLOBBERS: AF, BC, DE, HL
; -

FNAMSET         LD      DE, FILENAME
                OR      A
                SBC     HL, DE
                ADD     HL, DE
                RET     Z               ; ALREADY THERE
                LD      B, FNAMLEN - 1
.CPY            LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                DJNZ    .CPY
                XOR     A
                LD      (DE), A
                RET


; - FNBASE -----------------------------
; - THE LAST ITEM OF FILENAME: WHAT FOLLOWS ITS LAST '\' OR ':'
; - IN:  NONE
; - OUT: HL = FIRST CHARACTER OF THE NAME PROPER (FILENAME ITSELF WHEN
; -      IT CARRIES NO PATH)
; - CLOBBERS: AF, DE
; -

FNBASE          LD      HL, FILENAME
                LD      D, H
                LD      E, L            ; DE = START OF THE CURRENT ITEM
.SCAN           LD      A, (HL)
                INC     HL
                OR      A
                JR      Z, .DONE
                CP      #5C             ; '\'
                JR      Z, .ITEM
                CP      ':'
                JR      NZ, .SCAN
.ITEM           LD      D, H
                LD      E, L            ; A NEW ITEM STARTS AFTER IT
                JR      .SCAN
.DONE           EX      DE, HL
                RET


; - STORLINE ---------------------------
; - FINISH CURRENT LINE, ADD TO DIRECTORY, PREPARE NEXT
; - IN:  NONE (USES CURLLEN, TOTLINES)
; - OUT: CY = 1  NO ROOM LEFT (DIRECTORY FULL, OR NO MAPPER SEGMENT LEFT)
; - CLOBBERS: ALL
; -

STORLINE        ; 1. CHECK IF LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                JR      C, .HAVDIR
                SCF
                RET                     ; DIRECTORY FULL

.HAVDIR         ; 2. SET LENGTH IN WORKBUF[0] AND ZERO ATTRIBUTES
                LD      A, (CURLLEN)
                LD      (WORKBUF), A

                LD      HL, WORKBUF + 1 + WORKATTR
                LD      (HL), 0
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, MAXCOLS - 1
                LDIR

                ; 3. ALLOCATE RECORD IN MAPPER VIA NEWREC
                LD      C, A            ; C = CAPACITY NEEDED
                CALL    NEWREC
                RET     C               ; OOM: NO MAPPER MEMORY

                ; NEWREC RETURNED: A = SEG, DE = OFFSET (PAGE 2 BANKED)
                ; 4. WRITE WORKBUF INTO (A, DE) IN MAPPER
                PUSH    AF
                PUSH    DE
                LD      HL, WORKBUF
                CALL    PUTREC
                POP     DE              ; DE = OFFSET
                POP     AF              ; A = SEG

                ; 5. ADD TO DIRECTORY
                LD      HL, (TOTLINES)
                CALL    DIRWRITE

                ; 6. INCREMENT TOTLINES
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. RESET CURLLEN
                XOR     A
                LD      (CURLLEN), A
                AND     A               ; CY = 0: SUCCESS
                RET


; --- FILESAVE                  ----------------------------------------


; - FILESAVE ---------------------------
; - SAVE BUFFER LINES TO DISK FILE
; - IN:  NONE (USES FILENAME)
; - OUT: NONE
; - CLOBBERS: ALL
; -

FILESAVE        LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                JR      NZ, .DOFSAV
                ; NO FILENAME: SAY SO INSTEAD OF RETURNING IN SILENCE (A NEW
                ; DOCUMENT HAS NONE UNTIL SAVE AS EXISTS; :w NAME GIVES ONE)
                LD      HL, .STRNONM
                CALL    SETMSG
                CALL    DRWSTAT
                SCF
                RET

.DOFSAV         ; DISPLAY "Saving..." ON STATUS BAR BEFORE DISK OPERATION
                LD      HL, STRSAVG
                CALL    SETMSG
                CALL    DRWSTAT

                LD      HL, FILENAME
                CALL    DSKCREAT
                JR      NC, .OPNOK
                ; ERROR CREATING FILE
                LD      HL, STRSERR
                CALL    SETMSG
                CALL    DRWSTAT
                SCF
                RET

.OPNOK          LD      (SAVHAND), A
                LD      HL, (TOTLINES)  ; THE BAR'S 100%: THE LINE COUNT
                LD      (PRGTOT), HL
                XOR     A
                LD      (PRGTOT + 2), A
                LD      HL, STRSAVG
                CALL    PRGBEG
                
                LD      BC, 0           ; BC = DOCLINE (0..TOTLINES-1)
.LINELP         PUSH    BC
                LD      H, B
                LD      L, C
                CALL    LINEREAD        ; LOAD INTO WORKBUF
                
                ; WRITE LINE CHARACTERS: WORKBUF[0] BYTES
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .WREOL
                
                LD      L, A
                LD      H, 0
                LD      DE, WORKBUF + 1
                LD      A, (SAVHAND)
                CALL    DSKWRITE
                JR      C, .WRERR
                
.WREOL          ; WRITE CR, LF (DOS) OR LF ONLY (UNIX)
                LD      HL, 2
                LD      DE, CRLFSTR
                LD      A, (SAVEEOL)
                OR      A
                JR      Z, .WREOL2
                ; UNIX EOL: WRITE LF ONLY
                LD      HL, 1
                INC     DE
.WREOL2         LD      A, (SAVHAND)
                CALL    DSKWRITE
                JR      C, .WRERR
                
                POP     BC
                INC     BC
                PUSH    BC
                LD      HL, 1
                CALL    PRGADV          ; ONE MORE LINE OF TOTLINES
                POP     BC
                LD      H, B
                LD      L, C
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .LINELP
                
                LD      A, (SAVHAND)
                CALL    DSKCLOSE
                
                XOR     A
                LD      (MODIFIED), A

                ; DISPLAY "[SAVED]" ON STATUS BAR
                LD      HL, STRSAVD
                CALL    SETMSG
                CALL    DRWSTAT
                OR      A               ; CLEAR CARRY
                RET

.WRERR          POP     BC
                LD      A, (SAVHAND)
                CALL    DSKCLOSE
                LD      HL, STRSERR
                CALL    SETMSG
                CALL    DRWSTAT
                SCF
                RET

.STRNONM        DEFM    "[NO FILE NAME]", 0
CRLFSTR         DEFB    CR, LF


; --- SETMSG                    ----------------------------------------


; - SETMSG -----------------------------
; - COPY ASCIIZ STRING AT HL TO STATMSG
; - IN:  HL = ASCIIZ STRING POINTER
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

SETMSG          LD      DE, STATMSG
.SETMLP         LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                JR      .SETMLP


; - PRGBEG -----------------------------
; - START A PROGRESS BAR ON THE STATUS BAR, AT 0%
; - IN:  HL = ASCIIZ VERB ("Loading..." / "Saving..."), PRGTOT = 100%
; - OUT: NONE
; - CLOBBERS: ALL (IX TOO: B2D8)
; -
; - THE BAR IS TEN CELLS, ONE PER 10%, IN THE STATUS BAR'S LEFT CHANNEL:
; - "Loading... " + #DB / #D7 + " NNN%", 26 CHARACTERS, WHICH FITS THE
; - NARROWEST CHANNEL (S2ED, 28). #DB AND #D7 ARE THE FULL BLOCK AND
; - THE CHECKER IN ALL THREE FONTS.
; -

PRGBEG          LD      (PRGVRB), HL
                XOR     A
                LD      (PRGPCT), A
                LD      (PRGACC + 2), A
                LD      H, A
                LD      L, A
                LD      (PRGACC), HL
                JR      PRGSHOW


; - PRGADV -----------------------------
; - ADVANCE THE BAR BY SOME UNITS OF PRGTOT, REPAINT IF THE % CHANGED
; - IN:  HL = UNITS JUST DONE (0..655: BYTES OF ONE READ, OR ONE LINE)
; - OUT: NONE
; - CLOBBERS: ALL (IX TOO: B2D8)
; -
; - NO DIVISION: PRGACC COLLECTS UNITS * 100 AND EVERY TIME IT REACHES
; - PRGTOT ONE PERCENT IS COUNTED AND PRGTOT TAKEN OFF. THE PERCENT
; - STOPS AT 100, WHICH ALSO ENDS THE LOOP FOR A ZERO-BYTE FILE.
; -

PRGADV          ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                LD      D, H
                LD      E, L            ; DE = * 4
                ADD     HL, HL          ; * 8
                ADD     HL, HL          ; * 16
                ADD     HL, HL          ; * 32
                LD      B, H
                LD      C, L            ; BC = * 32
                ADD     HL, HL          ; * 64
                ADD     HL, BC          ; * 96
                ADD     HL, DE          ; * 100
                EX      DE, HL
                LD      HL, (PRGACC)
                ADD     HL, DE
                LD      (PRGACC), HL
                LD      A, (PRGACC + 2)
                ADC     A, 0
                LD      (PRGACC + 2), A
                LD      A, (PRGPCT)
                LD      C, A            ; C = PERCENT ON SCREEN
.LOOP           LD      A, (PRGPCT)
                CP      100
                JR      NC, .DONE
                LD      HL, (PRGACC)    ; PRGACC - PRGTOT, 24 BITS
                LD      DE, (PRGTOT)
                OR      A
                SBC     HL, DE
                PUSH    HL
                LD      A, (PRGACC + 2)
                LD      HL, PRGTOT + 2
                SBC     A, (HL)
                POP     HL
                JR      C, .DONE        ; NOT A WHOLE PERCENT YET
                LD      (PRGACC), HL
                LD      (PRGACC + 2), A
                LD      HL, PRGPCT
                INC     (HL)
                JR      .LOOP
.DONE           LD      A, (PRGPCT)
                CP      C
                RET     Z               ; SAME PERCENT: NOTHING TO REPAINT


; - PRGSHOW ----------------------------
; - FORMAT THE BAR INTO STATMSG AND PAINT THE STATUS BAR
; - IN:  NONE (USES PRGVRB, PRGPCT)
; - OUT: NONE
; - CLOBBERS: ALL (IX TOO: B2D8)
; -

PRGSHOW         LD      HL, (PRGVRB)
                CALL    SETMSG          ; DE = THE NUL AFTER THE VERB
                LD      A, ' '
                LD      (DE), A
                INC     DE
                LD      A, (PRGPCT)
                LD      C, 0            ; C = FULL CELLS = PERCENT / 10
.TENS           SUB     10
                JR      C, .BAR
                INC     C
                JR      .TENS
.BAR            LD      B, 10
.CELL           LD      A, C
                OR      A
                LD      A, #D7          ; TO DO
                JR      Z, .PUT
                DEC     C
                LD      A, #DB          ; DONE
.PUT            LD      (DE), A
                INC     DE
                DJNZ    .CELL
                LD      A, ' '
                LD      (DE), A
                INC     DE
                PUSH    DE
                LD      A, (PRGPCT)
                CALL    B2D8            ; HL = FIRST DIGIT, C = DIGITS
                POP     DE
                LD      A, 3            ; RIGHT-ALIGN IN THREE COLUMNS
                SUB     C
                JR      Z, .DIGITS
                LD      B, A
                LD      A, ' '
.PAD            LD      (DE), A
                INC     DE
                DJNZ    .PAD
.DIGITS         LD      A, (HL)
                OR      A
                JR      Z, .PCT
                LD      (DE), A
                INC     HL
                INC     DE
                JR      .DIGITS
.PCT            LD      A, '%'
                LD      (DE), A
                INC     DE
                XOR     A
                LD      (DE), A
                JP      DRWSTAT


                IFDEF   BROWSER
; - BRWSCNM ----------------------------
; - SCAN THE BROWSED DIRECTORY, SAYING SO ON THE STATUS BAR
; - IN:  AS BRWSCAN
; - OUT: NONE; STATMSG EMPTY AGAIN
; - CLOBBERS: ALL
; -
; - THE FIRST SCAN RUNS BEFORE THE WINDOW OPENS, SO WITHOUT THIS CTRL+O
; - LEFT THE SCREEN UNCHANGED FOR AS LONG AS THE DIRECTORY TOOK TO READ.
; - THE MESSAGE IS CLEARED BEFORE RETURNING: THE WINDOW SAVES WHAT IT
; - COVERS, AND ON S6ED ITS SHADOW REACHES THE STATUS BAR. RESIDENT
; - BECAUSE S2ED'S FEATURE CONTAINER HAS NO ROOM; CALLED FROM DOBRW,
; - WHERE PAGE 2 IS FTRSEG AND BRWSCAN IS REACHABLE.
; -

BRWSCNM         LD      HL, STRRDIR
                CALL    SETMSG
                CALL    DRWSTAT
.SCAN           CALL    BRWSCAN
                XOR     A
                LD      (STATMSG), A
                JP      DRWSTAT


; - BRWBUSY ----------------------------
; - PUT "Reading directory..." IN THE BROWSER'S INFORMATION LINE
; - IN:  NONE
; - OUT: BRWINF = THE MESSAGE, SPACE PADDED TO BICLEN + NUL
; - CLOBBERS: AF, B, DE, HL
; -
; - A RESCAN (ANOTHER DIRECTORY, DRIVE OR MASK) HAPPENS WITH THE WINDOW
; - UP, SO THE WINDOW'S OWN STATUS LINE CARRIES THE NOTICE.
; -

BRWBUSY         LD      HL, BRWINF
                LD      B, BICLEN
.CLR            LD      (HL), ' '
                INC     HL
                DJNZ    .CLR
                LD      (HL), 0
                LD      HL, STRRDIR
                LD      DE, BRWINF
.COPY           LD      A, (HL)
                OR      A
                JR      Z, .DONE
                LD      (DE), A
                INC     HL
                INC     DE
                JR      .COPY
.DONE           RET


STRRDIR         DEFM    "Reading directory...", 0
                ENDIF

STRLDG          DEFM    "Loading...", 0
STRSAVG         DEFM    "Saving...", 0
STRSAVD         DEFM    "[SAVED]", 0
STRSERR         DEFM    "[SAVE ERROR]", 0
