;                                       ****************************************
;                                       * FILE I/O                             *
;                                       ****************************************
;
; USES HIGH-LEVEL DSK* WRAPPERS FROM BDOS.Z8A (DOS1/DOS2 TRANSPARENT).


; --- FILENEW                   ----------------------------------------

FILENEW         JP      BUFRESET


; --- CHKFLEN                   ----------------------------------------


; - CHKFLEN ----------------------------
; - CHECK IF FILE SIZE EXCEEDS MAXIMUM AVAILABLE DOCUMENT CAPACITY
; - IN:  DE:HL = FILE SIZE IN BYTES (FROM DSKOPEN)
; - OUT: CY = 0: FILE MAY FIT IN MEMORY
; -      CY = 1: FILE DEFINITELY EXCEEDS MAXIMUM CAPACITY
; - CLOBBERS: AF, BC, DE, HL
; -

CHKFLEN         PUSH    DE              ; [SP+2] = FILE SIZE HIGH
                PUSH    HL              ; [SP]   = FILE SIZE LOW

                ; COMPUTE SEGLNS * (TEXTCOLS + 2) -> 24-BIT RESULT IN D:HL
                LD      BC, (SEGLNS)
                LD      A, TEXTCOLS + 2
                LD      E, A
                LD      HL, 0
                LD      D, 0
                LD      A, 8
.MULLP          SRL     E
                JR      NC, .NOADD
                ADD     HL, BC
                JR      NC, .NOADD
                INC     D
.NOADD          SLA     C
                RL      B
                DEC     A
                JR      NZ, .MULLP

                ; D = MAX HIGH BYTE, HL = MAX LOW WORD
                LD      A, D            ; A = MAX HIGH BYTE
                EX      DE, HL          ; DE = MAX LOW WORD
                POP     HL              ; HL = FILE SIZE LOW WORD
                EX      (SP), HL        ; [SP] = FILE SIZE LOW WORD, HL = FILE SIZE HIGH WORD

                LD      B, A            ; B = MAX HIGH BYTE
                LD      A, H
                OR      A
                JR      NZ, .TOOBIG     ; FILE SIZE >= 16 MB -> DEFINITELY TOOBIG
                LD      A, L            ; A = FILE SIZE HIGH BYTE
                CP      B               ; COMPARE WITH MAX HIGH BYTE
                JR      C, .FITS        ; FILE HIGH < MAX HIGH -> FITS
                JR      NZ, .TOOBIG     ; FILE HIGH > MAX HIGH -> TOOBIG

                ; HIGH BYTES EQUAL: COMPARE LOW WORDS (FILE LOW IN [SP] VS MAX LOW IN DE)
                POP     HL              ; HL = FILE SIZE LOW WORD
                CALL    CMPHLDE         ; CY=1 IF HL < DE, Z=1 IF HL == DE
                JR      Z, .OK
                JR      C, .OK
                SCF
                RET

.FITS           POP     HL              ; CLEAN STACK
.OK             AND     A               ; CY = 0
                RET

.TOOBIG         POP     HL              ; CLEAN STACK
                SCF                     ; CY = 1
                RET


; --- FILELOAD                  ----------------------------------------


; - FILELOAD ---------------------------
; - LOAD FILE FROM DISK INTO BUFFER
; - IN:  HL: FILENAME (ASCIIZ)
; - OUT: CY = 0: SUCCESS
; -      CY = 1: ERROR OR NEW FILE (LOADERR = 1 IF FILE TOO LARGE)
; - CLOBBERS: ALL
; -

FILELOAD        PUSH    HL
                CALL    FILENEW         ; RESET BUFFER AND ALLOCATE INITIAL SEGS
                POP     HL

                XOR     A
                LD      (LOADERR), A

                CALL    DSKOPEN         ; A=HANDLE, DEHL=SIZE
                RET     C
                LD      (FILEHAND), A

                ; PRE-CHECK FILE SIZE: REJECT IMMEDIATELY IF FILE CANNOT FIT
                CALL    CHKFLEN
                JR      NC, .LENOK

                ; FILE EXCEEDS MAXIMUM THEORETICAL CAPACITY
                LD      A, (FILEHAND)
                CALL    DSKCLOSE
                XOR     A
                LD      (FILENAME), A   ; PROTECT DISK FILE AGAINST OVERWRITE
                INC     A
                LD      (LOADERR), A    ; SIGNAL ERROR
                SCF
                RET

.LENOK          LD      HL, 0
                LD      (TOTLINES), HL
                LD      (LINEOFF), HL
                XOR     A
                LD      (CURLLEN), A
                LD      (WASCR), A
                LD      (EOLARED), A

.READBLK        LD      A, (FILEHAND)
                LD      HL, 256
                LD      DE, FILEBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      A, H
                OR      L
                JP      Z, .EOF
                
                LD      B, H
                LD      C, L            ; BC = BYTES TO PROCESS
                LD      HL, FILEBUF
.PROCLP         PUSH    BC
                PUSH    HL
                
                LD      A, (HL)
                CP      13              ; CR
                JR      Z, .ISCR
                CP      10              ; LF
                JP      Z, .ISLF
                CP      9               ; TAB
                JR      Z, .ISTAB
                
                ; REGULAR CHARACTER: CLEAR WASCR
                PUSH    AF
                XOR     A
                LD      (WASCR), A
                POP     AF
                
                ; APPEND TO CURRENT LINE IN TXPAGE. THE LOADER *IS* THE APPEND
                ; CURSOR WHILE IT RUNS, SO IT BANKS APPSEG EXPLICITLY -- TXSEG
                ; MAY HOLD DIRSEG AFTER ANY DIRECTORY WRITE (BUFRESET'S ENTRY 0
                ; WRITE INCLUDED), AND BANKING THAT HERE WOULD LAND THE RECORD
                ; INSIDE THE DIRECTORY.
                LD      B, A
                LD      A, (APPSEG)
                CALL    RECBANK
                
                LD      A, (CURLLEN)
                CP      TEXTCOLS
                JP      NC, .SKIP       ; TRUNCATE AT THE RECORD'S TEXT WIDTH
                
                LD      HL, TXPAGE + 1  ; SKIP LEN BYTE
                LD      DE, (LINEOFF)
                ADD     HL, DE
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = TXPAGE + LINEOFF + 1 + CURLLEN
                LD      (HL), B
                
                INC     A
                LD      (CURLLEN), A
                JP      .SKIP

.ISTAB          ; TAB EXPANSION: INSERT SPACES UP TO NEXT TAB STOP
                XOR     A
                LD      (WASCR), A

                LD      A, (TABWIDTH)
                LD      D, A            ; D = TABWIDTH
                LD      A, (CURLLEN)
.TABMD          CP      D
                JR      C, .TABRM
                SUB     D
                JR      .TABMD
.TABRM          ; A = CURLLEN % TABWIDTH
                LD      E, A
                LD      A, D
                SUB     E               ; A = SPACES TO ADD (1..TABWIDTH)
                LD      E, A            ; E = COUNT OF SPACES

.TABSP          LD      A, (CURLLEN)
                CP      TEXTCOLS
                JP      NC, .SKIP       ; TRUNCATE AT THE RECORD'S TEXT WIDTH

                LD      A, (APPSEG)
                CALL    RECBANK

                LD      HL, TXPAGE + 1
                LD      BC, (LINEOFF)
                ADD     HL, BC
                LD      A, (CURLLEN)
                LD      C, A
                LD      B, 0
                ADD     HL, BC
                LD      (HL), ' '

                LD      A, (CURLLEN)
                INC     A
                LD      (CURLLEN), A

                DEC     E
                JR      NZ, .TABSP
                JP      .SKIP

.ISCR           LD      A, 1
                LD      (WASCR), A
                ; EOL AUTO-DETECT: DOS CRLF
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORCR
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORCR
                XOR     A
                LD      (SAVEEOL), A    ; DETECTED DOS (CRLF)
                INC     A
                LD      (EOLARED), A
.STORCR         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP

.ISLF           LD      A, (WASCR)
                AND     A
                JR      NZ, .SKIPLF     ; IF CRLF, SKIP THE LF
                ; STANDALONE LF: UNIX EOL
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORLF
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORLF
                LD      A, 1
                LD      (SAVEEOL), A    ; DETECTED UNIX (LF)
                LD      (EOLARED), A
.STORLF         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP
.SKIPLF         XOR     A
                LD      (WASCR), A
                JP      .SKIP

.OOM            POP     HL              ; BALANCE PUSH HL IN .PROCLP
                POP     BC              ; BALANCE PUSH BC IN .PROCLP
.OOMNL          ; ROLLBACK DUE TO CAPACITY EXHAUSTION DURING LOAD
                LD      A, (FILEHAND)
                CALL    DSKCLOSE
                CALL    SEGTRIM         ; FREE ANY ALLOCATED MAPPER SEGMENTS
                CALL    BUFRESET        ; RESET BUFFER TO 1 CLEAN EMPTY LINE
                XOR     A
                LD      (FILENAME), A   ; PROTECT DISK FILE AGAINST OVERWRITE
                INC     A
                LD      (LOADERR), A    ; SIGNAL LOAD ERROR
                SCF                     ; RETURN ERROR
                RET

.SKIP           POP     HL
                INC     HL
                POP     BC
                DEC     BC
                LD      A, B
                OR      C
                JP      NZ, .PROCLP
                JP      .READBLK

.EOF            LD      A, (CURLLEN)
                AND     A
                JR      Z, .CHKTOT
                CALL    STORLINE        ; STORE FINAL PENDING LINE
                JR      C, .OOMNL
                JR      .CLSFIL
.CHKTOT         LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                JR      NZ, .CLSFIL
                CALL    STORLINE        ; ENSURE AT LEAST 1 LINE IF FILE WAS EMPTY
                JR      C, .OOMNL
.CLSFIL         LD      A, (FILEHAND)
                CALL    DSKCLOSE
                
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                AND     A               ; CY = 0: SUCCESSFUL LOAD
                RET

; - STORLINE ---------------------------
; - FINISH CURRENT LINE, ADD TO DIRECTORY, PREPARE NEXT
; - IN:  NONE (USES CURLLEN, LINEOFF, TXSEG, TOTLINES)
; - OUT: CY = 1  NO ROOM LEFT (DIRECTORY FULL, OR NO MAPPER SEGMENT LEFT)
; - CLOBBERS: ALL
; -

STORLINE        ; REFUSE IF THE LINE DIRECTORY IS FULL. EDNWLIN AND EDPSHWR
                ; ALREADY GUARD THEIR OWN INSERTS; THE LOADER DID NOT, AND A
                ; LONG ENOUGH FILE WOULD HAVE WALKED PAST THE END OF THE
                ; DIRECTORY. THE CALLER'S .OOM PATH SHOWS WHAT LOADED.
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                JR      C, .HAVROOM
                SCF
                RET

.HAVROOM        LD      A, (APPSEG)
                CALL    RECBANK         ; THE RECORD GOES TO THE APPEND SEGMENT,
                                        ; NOT WHATEVER TXSEG HOLDS (DIRSEG AFTER
                                        ; ANY DIRECTORY WRITE)
                LD      HL, TXPAGE
                LD      DE, (LINEOFF)
                ADD     HL, DE          ; HL = START OF RECORD
                
                LD      A, (CURLLEN)
                LD      (HL), A         ; WRITE LEN
                
                ; PAD UNUSED CHARS (CURLLEN..TEXTCOLS-1) WITH SPACE (#20)
                PUSH    HL
                INC     HL              ; HL = TXPAGE + LINEOFF + 1
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = TXPAGE + LINEOFF + 1 + CURLLEN
                LD      A, TEXTCOLS
                SUB     E
                JR      Z, .PADEND
                LD      B, A
.PADLP          LD      (HL), ' '
                INC     HL
                DJNZ    .PADLP
.PADEND         POP     HL

                ; CLEAR THE ATTRIBUTE HALF. THESE THREE FIGURES ARE THE
                ; RECORD LAYOUT AND MUST COME FROM TEXTCOLS: AS LITERAL
                ; 81 / 79 THEY LEFT THE FIRST 16 ATTRIBUTE BYTES OF EVERY
                ; S2 RECORD UNCLEARED -- WHICH RENDERED AS RANDOM BOLD --
                ; AND RAN 32 BYTES PAST THE END OF THE RECORD.
                PUSH    HL
                LD      DE, 1 + TEXTCOLS
                ADD     HL, DE          ; HL = ATTR START
                LD      (HL), 0
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, TEXTCOLS - 1
                LDIR
                POP     HL

                ; ADD TO DIRECTORY
                LD      HL, (TOTLINES)
                LD      A, (APPSEG)     ; THE RECORD WAS JUST WRITTEN THERE
                LD      DE, (LINEOFF)
                CALL    DIRWRITE
                
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; PREPARE NEXT LINE RECORD OFFSET
                LD      HL, (LINEOFF)
                LD      DE, WORKSIZ
                ADD     HL, DE
                LD      (LINEOFF), HL
                
                ; CHECK IF THE SEGMENT IS FULL (101 RECORDS OF 161 BYTES)
                LD      DE, SEGLAST + 1
                CALL    CMPHLDE
                JR      C, .NOTFULL

                CALL    SEGGET
                RET     C               ; CY = 1: OUT OF MEMORY FOR NEXT SEGMENT
                LD      (TXSEG), A
                ; THE LOADER *IS* THE APPEND CURSOR WHILE IT RUNS, SO APPSEG
                ; HAS TO FOLLOW. WITHOUT THIS IT KEPT THE VALUE BUFRESET LEFT
                ; -- THE FIRST SEGMENT -- WHILE LINEOFF WALKED INTO THE SECOND,
                ; AND THE FIRST NEWLINE AFTER LOADING RESERVED A RECORD AT
                ; (FIRST SEGMENT, OFFSET INSIDE THE LAST ONE), LANDING ON TOP
                ; OF A LINE ALREADY THERE. MEASURED ON A 200 LINE DOCUMENT:
                ; LINEOFF 15939 = RECORD 99 OF SEGMENT 0, SO ONE RETURN KEY
                ; OVERWROTE LINE 99 WITH THE TEXT BEING SPLIT OFF LINE 0.
                LD      (APPSEG), A
                CALL    PUTP2
                LD      HL, 0
                LD      (LINEOFF), HL

.NOTFULL        XOR     A
                LD      (CURLLEN), A
                AND     A               ; CY = 0: SUCCESS
                RET


; --- FILESAVE                  ----------------------------------------


; - FILESAVE ---------------------------
; - SAVE BUFFER LINES TO DISK FILE
; - IN:  NONE (USES FILENAME)
; - OUT: NONE
; - CLOBBERS: ALL
; -

FILESAVE        LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                JR      NZ, .DOFSAV
                SCF
                RET                     ; NO FILENAME TO SAVE

.DOFSAV         ; DISPLAY "Saving..." ON STATUS BAR BEFORE DISK OPERATION
                LD      HL, .STRSAVG
                CALL    .SETMSG
                CALL    DRWSTAT

                LD      HL, FILENAME
                CALL    DSKCREAT
                JR      NC, .OPNOK
                ; ERROR CREATING FILE
                LD      HL, .STRSERR
                CALL    .SETMSG
                CALL    DRWSTAT
                SCF
                RET

.OPNOK          LD      (SAVHAND), A
                
                LD      BC, 0           ; BC = DOCLINE (0..TOTLINES-1)
.LINELP         PUSH    BC
                LD      H, B
                LD      L, C
                CALL    LINEREAD        ; LOAD INTO WORKBUF
                
                ; WRITE LINE CHARACTERS: WORKBUF[0] BYTES
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .WREOL
                
                LD      L, A
                LD      H, 0
                LD      DE, WORKBUF + 1
                LD      A, (SAVHAND)
                CALL    DSKWRITE
                
.WREOL          ; WRITE CR, LF (DOS) OR LF ONLY (UNIX)
                LD      HL, 2
                LD      DE, CRLFSTR
                LD      A, (SAVEEOL)
                OR      A
                JR      Z, .WREOL2
                ; UNIX EOL: WRITE LF ONLY
                LD      HL, 1
                INC     DE
.WREOL2         LD      A, (SAVHAND)
                CALL    DSKWRITE
                
                POP     BC
                INC     BC
                LD      H, B
                LD      L, C
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .LINELP
                
                LD      A, (SAVHAND)
                CALL    DSKCLOSE
                
                XOR     A
                LD      (MODIFIED), A

                ; DISPLAY "[SAVED]" ON STATUS BAR
                LD      HL, .STRSAVD
                CALL    .SETMSG
                CALL    DRWSTAT
                OR      A               ; CLEAR CARRY
                RET

.SETMSG         LD      DE, STATMSG
.SETMLP         LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                JR      .SETMLP

.STRSAVG        DEFM    "Saving...", 0
.STRSAVD        DEFM    "[SAVED]", 0
.STRSERR        DEFM    "[SAVE ERROR]", 0

CRLFSTR         DEFB    CR, LF
