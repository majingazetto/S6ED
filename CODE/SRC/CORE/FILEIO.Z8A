;                                       ****************************************
;                                       * FILE I/O                             *
;                                       ****************************************
;
; USES HIGH-LEVEL DSK* WRAPPERS FROM BDOS.Z8A (DOS1/DOS2 TRANSPARENT).


; --- FILENEW                   ----------------------------------------

FILENEW         JP      BUFRESET


; --- CHKFLEN                   ----------------------------------------


; - CHKFLEN ----------------------------
; - CHECK IF FILE SIZE EXCEEDS MAXIMUM AVAILABLE DOCUMENT CAPACITY
; - IN:  DE:HL = FILE SIZE IN BYTES (FROM DSKOPEN)
; - OUT: CY = 0: FILE MAY FIT IN MEMORY
; -      CY = 1: FILE DEFINITELY EXCEEDS MAXIMUM CAPACITY
; - CLOBBERS: AF, BC, DE, HL
; -

CHKFLEN         PUSH    DE              ; [SP+2] = FILE SIZE HIGH
                PUSH    HL              ; [SP]   = FILE SIZE LOW

                ; COMPUTE SEGLNS * (TEXTCOLS + 2) -> 24-BIT RESULT IN D:HL
                LD      BC, (SEGLNS)
                LD      E, TEXTCOLS + 2
                LD      HL, 0
                LD      D, 0
                LD      A, 8
.MULLP          ADD     HL, HL
                RL      D
                RLC     E
                JR      NC, .NOADD
                ADD     HL, BC
                JR      NC, .NOADD
                INC     D
.NOADD          DEC     A
                JR      NZ, .MULLP

                ; D = MAX HIGH BYTE, HL = MAX LOW WORD
                LD      A, D            ; A = MAX HIGH BYTE
                EX      DE, HL          ; DE = MAX LOW WORD
                POP     HL              ; HL = FILE SIZE LOW WORD
                EX      (SP), HL        ; [SP] = FILE SIZE LOW WORD, HL = FILE SIZE HIGH WORD

                LD      B, A            ; B = MAX HIGH BYTE
                LD      A, H
                OR      A
                JR      NZ, .TOOBIG     ; FILE SIZE >= 16 MB -> DEFINITELY TOOBIG
                LD      A, L            ; A = FILE SIZE HIGH BYTE
                CP      B               ; COMPARE WITH MAX HIGH BYTE
                JR      C, .FITS        ; FILE HIGH < MAX HIGH -> FITS
                JR      NZ, .TOOBIG     ; FILE HIGH > MAX HIGH -> TOOBIG

                ; HIGH BYTES EQUAL: COMPARE LOW WORDS (FILE LOW IN [SP] VS MAX LOW IN DE)
                POP     HL              ; HL = FILE SIZE LOW WORD
                CALL    CMPHLDE         ; CY=1 IF HL < DE, Z=1 IF HL == DE
                JR      Z, .OK
                JR      C, .OK
                SCF
                RET

.FITS           POP     HL              ; CLEAN STACK
.OK             AND     A               ; CY = 0
                RET

.TOOBIG         POP     HL              ; CLEAN STACK
                SCF                     ; CY = 1
                RET


; --- FILELOAD                  ----------------------------------------


; - FILELOAD ---------------------------
; - LOAD FILE FROM DISK INTO BUFFER
; - IN:  HL: FILENAME (ASCIIZ). MAY BE FILENAME ITSELF (BOOT) OR ANY
; -      OTHER BUFFER (:e); FILENAME TAKES THE NAME ONLY ON SUCCESS.
; - OUT: CY = 0: LOADED, FILENAME = THE NAME, MODIFIED = 0
; -      CY = 1: NOT LOADED. LOADERR = 1: TOO LARGE; OTHERWISE THE FILE
; -      COULD NOT BE OPENED AND A = THE DOS ERROR (ENOFIL = NOT FOUND)
; - CLOBBERS: ALL
; -
; - THE DOCUMENT IS RESET ONLY ONCE THE FILE IS OPEN AND KNOWN TO FIT:
; - A FAILED OPEN OR A REFUSED SIZE LEAVES THE DOCUMENT, FILENAME AND
; - MODIFIED EXACTLY AS THEY WERE. IT USED TO RESET FIRST, SO :e ON A
; - MISSING OR OVERSIZED FILE HAD ALREADY THROWN THE DOCUMENT AWAY.
; - ONLY A CAPACITY FAILURE HALFWAY THROUGH THE READ (.OOMNL) CAN STILL
; - LOSE IT, AND THAT PATH CLEARS FILENAME SO CTRL+S CANNOT OVERWRITE
; - THE FILE WITH THE REMAINS.
; -

FILELOAD        XOR     A
                LD      (LOADERR), A
                PUSH    HL              ; [SP] = NAME

                CALL    DSKOPEN         ; A=HANDLE, DEHL=SIZE
                JR      C, .NOOPEN
                LD      (FILEHAND), A

                ; PRE-CHECK FILE SIZE: REJECT IMMEDIATELY IF FILE CANNOT FIT
                CALL    CHKFLEN
                JR      NC, .FITOK

                ; FILE EXCEEDS MAXIMUM THEORETICAL CAPACITY. AT BOOT THE NAME
                ; IS FILENAME ITSELF, WHICH MUST NOT KEEP POINTING AT A FILE
                ; THE EMPTY DOCUMENT WOULD OVERWRITE; FROM :e IT IS ANOTHER
                ; BUFFER AND THE CURRENT DOCUMENT KEEPS ITS OWN NAME.
                LD      A, (FILEHAND)
                CALL    DSKCLOSE
                POP     HL
                LD      DE, FILENAME
                OR      A
                SBC     HL, DE
                JR      NZ, .BIGSET
                XOR     A
                LD      (FILENAME), A   ; PROTECT THE DISK FILE
.BIGSET         LD      A, 1
                LD      (LOADERR), A    ; SIGNAL ERROR
                SCF
                RET

.NOOPEN         POP     HL
                RET                     ; CY = 1, A = DOS ERROR

.FITOK          CALL    FILENEW         ; ONLY NOW DOES THE DOCUMENT GO
                POP     HL
                CALL    FNAMSET         ; THE NAME BECOMES THE DOCUMENT'S
                XOR     A
                LD      (MODIFIED), A

                LD      HL, 0
                LD      (TOTLINES), HL
                LD      (LINEOFF), HL
                XOR     A
                LD      (CURLLEN), A
                LD      (WASCR), A
                LD      (EOLARED), A

.READBLK        LD      A, (FILEHAND)
                LD      HL, 256
                LD      DE, FILEBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      A, H
                OR      L
                JP      Z, .EOF
                
                LD      B, H
                LD      C, L            ; BC = BYTES TO PROCESS
                LD      HL, FILEBUF
.PROCLP         PUSH    BC
                PUSH    HL
                
                LD      A, (HL)
                CP      13              ; CR
                JR      Z, .ISCR
                CP      10              ; LF
                JP      Z, .ISLF
                CP      9               ; TAB
                JR      Z, .ISTAB
                
                ; REGULAR CHARACTER: CLEAR WASCR
                PUSH    AF
                XOR     A
                LD      (WASCR), A
                POP     AF
                
                ; APPEND TO WORKBUF IN TPA RAM
                LD      B, A
                LD      A, (CURLLEN)
                CP      MAXCOLS
                JP      NC, .SKIP       ; TRUNCATE AT MAX LINE WIDTH

                LD      HL, WORKBUF + 1
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = WORKBUF + 1 + CURLLEN
                LD      (HL), B

                INC     A
                LD      (CURLLEN), A
                JP      .SKIP

.ISTAB          ; TAB EXPANSION: INSERT SPACES UP TO NEXT TAB STOP
                XOR     A
                LD      (WASCR), A

                LD      A, (TABWIDTH)
                LD      D, A            ; D = TABWIDTH
                LD      A, (CURLLEN)
.TABMD          CP      D
                JR      C, .TABRM
                SUB     D
                JR      .TABMD
.TABRM          ; A = CURLLEN % TABWIDTH
                LD      E, A
                LD      A, D
                SUB     E               ; A = SPACES TO ADD (1..TABWIDTH)
                LD      E, A            ; E = COUNT OF SPACES

.TABSP          LD      A, (CURLLEN)
                CP      MAXCOLS
                JP      NC, .SKIP       ; TRUNCATE AT MAX LINE WIDTH

                LD      HL, WORKBUF + 1
                LD      C, A
                LD      B, 0
                ADD     HL, BC
                LD      (HL), ' '

                LD      A, (CURLLEN)
                INC     A
                LD      (CURLLEN), A

                DEC     E
                JR      NZ, .TABSP
                JP      .SKIP

.ISCR           LD      A, 1
                LD      (WASCR), A
                ; EOL AUTO-DETECT: DOS CRLF
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORCR
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORCR
                XOR     A
                LD      (SAVEEOL), A    ; DETECTED DOS (CRLF)
                INC     A
                LD      (EOLARED), A
.STORCR         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP

.ISLF           LD      A, (WASCR)
                AND     A
                JR      NZ, .SKIPLF     ; IF CRLF, SKIP THE LF
                ; STANDALONE LF: UNIX EOL
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORLF
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORLF
                LD      A, 1
                LD      (SAVEEOL), A    ; DETECTED UNIX (LF)
                LD      (EOLARED), A
.STORLF         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP
.SKIPLF         XOR     A
                LD      (WASCR), A
                JP      .SKIP

.OOM            POP     HL              ; BALANCE PUSH HL IN .PROCLP
                POP     BC              ; BALANCE PUSH BC IN .PROCLP
.OOMNL          ; ROLLBACK DUE TO CAPACITY EXHAUSTION DURING LOAD
                LD      A, (FILEHAND)
                CALL    DSKCLOSE
                CALL    SEGTRIM         ; FREE ANY ALLOCATED MAPPER SEGMENTS
                CALL    BUFRESET        ; RESET BUFFER TO 1 CLEAN EMPTY LINE
                XOR     A
                LD      (FILENAME), A   ; PROTECT DISK FILE AGAINST OVERWRITE
                INC     A
                LD      (LOADERR), A    ; SIGNAL LOAD ERROR
                SCF                     ; RETURN ERROR
                RET

.SKIP           POP     HL
                INC     HL
                POP     BC
                DEC     BC
                LD      A, B
                OR      C
                JP      NZ, .PROCLP
                JP      .READBLK

.EOF            LD      A, (CURLLEN)
                AND     A
                JR      Z, .CHKTOT
                CALL    STORLINE        ; STORE FINAL PENDING LINE
                JR      C, .OOMNL
                JR      .CLSFIL
.CHKTOT         LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                JR      NZ, .CLSFIL
                CALL    STORLINE        ; ENSURE AT LEAST 1 LINE IF FILE WAS EMPTY
                JR      C, .OOMNL
.CLSFIL         LD      A, (FILEHAND)
                CALL    DSKCLOSE
                
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                LD      (LEFTCOL), A
                AND     A               ; CY = 0: SUCCESSFUL LOAD
                RET

; - FNAMSET ----------------------------
; - MAKE A NAME THE DOCUMENT'S FILENAME
; - IN:  HL = ASCIIZ NAME (FILENAME ITSELF IS A NO-OP)
; - OUT: FILENAME = THE NAME, TRUNCATED TO FNAMLEN - 1 CHARACTERS
; - CLOBBERS: AF, BC, DE, HL
; -

FNAMSET         LD      DE, FILENAME
                OR      A
                SBC     HL, DE
                ADD     HL, DE
                RET     Z               ; ALREADY THERE
                LD      B, FNAMLEN - 1
.CPY            LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                DJNZ    .CPY
                XOR     A
                LD      (DE), A
                RET


; - FNBASE -----------------------------
; - THE LAST ITEM OF FILENAME: WHAT FOLLOWS ITS LAST '\' OR ':'
; - IN:  NONE
; - OUT: HL = FIRST CHARACTER OF THE NAME PROPER (FILENAME ITSELF WHEN
; -      IT CARRIES NO PATH)
; - CLOBBERS: AF, DE
; -

FNBASE          LD      HL, FILENAME
                LD      D, H
                LD      E, L            ; DE = START OF THE CURRENT ITEM
.SCAN           LD      A, (HL)
                INC     HL
                OR      A
                JR      Z, .DONE
                CP      #5C             ; '\'
                JR      Z, .ITEM
                CP      ':'
                JR      NZ, .SCAN
.ITEM           LD      D, H
                LD      E, L            ; A NEW ITEM STARTS AFTER IT
                JR      .SCAN
.DONE           EX      DE, HL
                RET


; - STORLINE ---------------------------
; - FINISH CURRENT LINE, ADD TO DIRECTORY, PREPARE NEXT
; - IN:  NONE (USES CURLLEN, TOTLINES)
; - OUT: CY = 1  NO ROOM LEFT (DIRECTORY FULL, OR NO MAPPER SEGMENT LEFT)
; - CLOBBERS: ALL
; -

STORLINE        ; 1. CHECK IF LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                JR      C, .HAVDIR
                SCF
                RET                     ; DIRECTORY FULL

.HAVDIR         ; 2. SET LENGTH IN WORKBUF[0] AND ZERO ATTRIBUTES
                LD      A, (CURLLEN)
                LD      (WORKBUF), A

                LD      HL, WORKBUF + 1 + WORKATTR
                LD      (HL), 0
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, MAXCOLS - 1
                LDIR

                ; 3. ALLOCATE RECORD IN MAPPER VIA NEWREC
                LD      C, A            ; C = CAPACITY NEEDED
                CALL    NEWREC
                RET     C               ; OOM: NO MAPPER MEMORY

                ; NEWREC RETURNED: A = SEG, DE = OFFSET (PAGE 2 BANKED)
                ; 4. WRITE WORKBUF INTO (A, DE) IN MAPPER
                PUSH    AF
                PUSH    DE
                LD      HL, WORKBUF
                CALL    PUTREC
                POP     DE              ; DE = OFFSET
                POP     AF              ; A = SEG

                ; 5. ADD TO DIRECTORY
                LD      HL, (TOTLINES)
                CALL    DIRWRITE

                ; 6. INCREMENT TOTLINES
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. RESET CURLLEN
                XOR     A
                LD      (CURLLEN), A
                AND     A               ; CY = 0: SUCCESS
                RET


; --- FILESAVE                  ----------------------------------------


; - FILESAVE ---------------------------
; - SAVE BUFFER LINES TO DISK FILE
; - IN:  NONE (USES FILENAME)
; - OUT: NONE
; - CLOBBERS: ALL
; -

FILESAVE        LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                JR      NZ, .DOFSAV
                ; NO FILENAME: SAY SO INSTEAD OF RETURNING IN SILENCE (A NEW
                ; DOCUMENT HAS NONE UNTIL SAVE AS EXISTS; :w NAME GIVES ONE)
                LD      HL, .STRNONM
                CALL    SETMSG
                CALL    DRWSTAT
                SCF
                RET

.DOFSAV         ; DISPLAY "Saving..." ON STATUS BAR BEFORE DISK OPERATION
                LD      HL, STRSAVG
                CALL    SETMSG
                CALL    DRWSTAT

                LD      HL, FILENAME
                CALL    DSKCREAT
                JR      NC, .OPNOK
                ; ERROR CREATING FILE
                LD      HL, STRSERR
                CALL    SETMSG
                CALL    DRWSTAT
                SCF
                RET

.OPNOK          LD      (SAVHAND), A
                
                LD      BC, 0           ; BC = DOCLINE (0..TOTLINES-1)
.LINELP         PUSH    BC
                LD      H, B
                LD      L, C
                CALL    LINEREAD        ; LOAD INTO WORKBUF
                
                ; WRITE LINE CHARACTERS: WORKBUF[0] BYTES
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .WREOL
                
                LD      L, A
                LD      H, 0
                LD      DE, WORKBUF + 1
                LD      A, (SAVHAND)
                CALL    DSKWRITE
                
.WREOL          ; WRITE CR, LF (DOS) OR LF ONLY (UNIX)
                LD      HL, 2
                LD      DE, CRLFSTR
                LD      A, (SAVEEOL)
                OR      A
                JR      Z, .WREOL2
                ; UNIX EOL: WRITE LF ONLY
                LD      HL, 1
                INC     DE
.WREOL2         LD      A, (SAVHAND)
                CALL    DSKWRITE
                
                POP     BC
                INC     BC
                LD      H, B
                LD      L, C
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .LINELP
                
                LD      A, (SAVHAND)
                CALL    DSKCLOSE
                
                XOR     A
                LD      (MODIFIED), A

                ; DISPLAY "[SAVED]" ON STATUS BAR
                LD      HL, STRSAVD
                CALL    SETMSG
                CALL    DRWSTAT
                OR      A               ; CLEAR CARRY
                RET

.STRNONM        DEFM    "[NO FILE NAME]", 0
CRLFSTR         DEFB    CR, LF


; --- SETMSG                    ----------------------------------------


; - SETMSG -----------------------------
; - COPY ASCIIZ STRING AT HL TO STATMSG
; - IN:  HL = ASCIIZ STRING POINTER
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

SETMSG          LD      DE, STATMSG
.SETMLP         LD      A, (HL)
                LD      (DE), A
                OR      A
                RET     Z
                INC     HL
                INC     DE
                JR      .SETMLP

STRSAVG         DEFM    "Saving...", 0
STRSAVD         DEFM    "[SAVED]", 0
STRSERR         DEFM    "[SAVE ERROR]", 0
