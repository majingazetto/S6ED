;                                       ****************************************
;                                       * DISPATCHER                           *
;                                       ****************************************
;
; KEYBOARD INPUT DISPATCH ENGINE AND MODAL VI STATE MACHINE.
; SCANS KEYMAP TABLES AND DISPATCHES TO ATOMIC ACTION VECTORS.


; --- READMOD                   ----------------------------------------


; - READMOD ----------------------------
; - READ MODIFIER KEYS VIA BIOS SNSMAT
; - IN:  NONE
; - OUT: A = MODIFIER BITS (BIT 0=SHIFT, BIT 1=CTRL, BIT 2=GRAPH)
; - CLOBBERS: AF, C
; -

READMOD         LD      A, 6
                CALL    READROW
                CPL
                AND     %00000111
                LD      (MODKEYS), A
                RET


; --- DISPKEY                   ----------------------------------------


; - DISPKEY ----------------------------
; - DISPATCH A KEYPRESS THROUGH ACTIVE KEYMAP
; - IN:  A = KEYCODE FROM CHGET
; - OUT: NONE
; - CLOBBERS: ALL
; -

DISPKEY         PUSH    AF              ; PRESERVE KEYCODE ACROSS READMOD
                CALL    READMOD
                LD      A, (MODKEYS)
                LD      B, A            ; B = MODIFIERS
                POP     AF              ; RESTORE KEYCODE
                LD      C, A            ; C = KEYCODE
                CALL    TRNGRPH         ; TRANSLATE GRAPH ACCENTS IF GRAPH HELD
                RET     C               ; CHKACNT ALREADY DELIVERED THIS PRESS
                CALL    TRNDEAD         ; TRANSLATE DEAD KEY IF PENDING

                ; NORMALIZE BIOS GRAVE ACCENT (#85 = à) TO SPANISH ACUTE (#A0 = á)
                LD      A, C
                CP      #85
                JR      NZ, .NOA85
                LD      C, #A0
.NOA85


                ; CHECK VI LEADER KEY
                LD      A, (VILEAD)
                OR      A
                JR      Z, .NOLEAD
                XOR     A
                LD      (VILEAD), A
                LD      A, C
                CP      'd'
                JP      Z, ACTDELLN

.NOLEAD         ; SCAN ACTIVE KEYMAP TABLE
                LD      HL, (KMAPPTR)
.KSCAN          LD      A, (HL)
                CP      #FF             ; END OF TABLE SENTINEL
                JR      Z, .NOTMAPP
                CP      C
                JR      NZ, .KNEXT
                INC     HL
                LD      A, (HL)         ; MODIFIER MASK IN TABLE
                CP      MODANY
                JR      Z, .KMATCH
                CP      B
                JR      Z, .KMATCH
                DEC     HL              ; MISMATCH: RESTORE AND ADVANCE
.KNEXT          INC     HL
                INC     HL
                INC     HL
                JR      .KSCAN

.KMATCH         INC     HL
                LD      A, (HL)         ; A = ACTION ID
                JP      EXECACT

.NOTMAPP        ; UNMAPPED: CHECK PRINTABLE RANGE (#20..#FE)
                LD      A, (KMAPID)
                CP      KMVI
                JR      NZ, .DOPRINT
                ; IN VI NORMAL MODE, UNMAPPED CHARACTERS DO NOT TYPE
                LD      A, (VIMODE)
                CP      VIMNORM
                RET     Z

.DOPRINT        LD      A, C
                CP      #20
                RET     C               ; REJECT CONTROL CODES (#00..#1F)
                CP      #7F
                RET     Z               ; REJECT DEL (#7F)
                CP      #FF
                RET     Z               ; REJECT SENTINEL / BLANK (#FF)

                LD      A, (SELACT)
                OR      A
                JR      Z, .NOSELDL
                PUSH    BC
                CALL    ACTDLS          ; DELETE ACTIVE SELECTION FIRST
                POP     BC

.NOSELDL        LD      A, (INSMODE)
                CP      INS_MODE
                LD      A, C
                JP      Z, EDINSCHR
                JP      EDOVRCHR


; --- EXECACT                   ----------------------------------------


; - EXECACT ----------------------------
; - EXECUTE AN ACTION BY ACTION ID
; - IN:  A = ACTION ID
; - OUT: NONE
; - CLOBBERS: ALL
; -

EXECACT         CP      ACMAX
                RET     NC
                LD      L, A
                LD      H, 0
                ADD     HL, HL
                LD      DE, ACTTBL
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)
                EX      DE, HL
                JP      CALHL


; --- KMAPCYC                   ----------------------------------------


; - KMAPCYC ----------------------------
; - CYCLE ACTIVE KEYMAP PROFILE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

KMAPCYC         LD      A, (KMAPID)
                INC     A
                CP      4
                JR      C, .KCYCOK
                XOR     A
.KCYCOK         LD      (KMAPID), A
                CALL    KMAPSW
                JP      DRWSTAT


; --- KMAPSW                    ----------------------------------------


; - KMAPSW -----------------------------
; - REPOINT KMAPPTR ACCORDING TO KMAPID
; - IN:  NONE (USES KMAPID)
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

KMAPSW          LD      A, (KMAPID)
                OR      A
                JR      NZ, .NOTSTD
                LD      HL, KMAPSTD
                LD      (KMAPPTR), HL
                RET

.NOTSTD         CP      KMWS
                JR      NZ, .NOTWS
                LD      HL, KMAPWS
                LD      (KMAPPTR), HL
                RET

.NOTWS          CP      KMEMACS
                JR      NZ, .NOTEMAC
                LD      HL, KMAPEMAC
                LD      (KMAPPTR), HL
                RET

.NOTEMAC        ; KMVI
                XOR     A
                LD      (VIMODE), A
                LD      (VILEAD), A
                LD      HL, KMAPVIN
                LD      (KMAPPTR), HL
                RET


; --- TRNGRPH                   ----------------------------------------


; - TRNGRPH ----------------------------
; - TRANSLATE A GRAPH COMBINATION THE BIOS QUEUED, ONCE PER KEYPRESS
; - CHKACNT SCANS THESE SAME COMBINATIONS OFF THE MATRIX, SO ONE KEYPRESS
; - HAS TWO DELIVERY PATHS. THE BIOS KEYBOARD ISR CAN QUEUE ITS OWN GRAPH
; - CODE IN THE WINDOW BETWEEN THE CHKACNT POLL AND THE CHSNS POLL OF THE
; - SAME MAINLOOP PASS, WHERE NO KILBUF EVER RUNS, AND ON AN INTERNATIONAL
; - BIOS THAT CODE TRANSLATES TO THE SAME ACCENT: MEASURED ON A PHILIPS NMS
; - 8250, ONE ACCENT IN NINE CAME OUT TWICE. WHICHEVER PATH ARRIVES FIRST
; - NOW CLAIMS THE KEY IN (LASTGRP) / (GRPTIM) -- CHKACNT'S OWN REPEAT
; - STATE -- AND THE OTHER STAYS QUIET UNTIL THE KEY IS RELEASED.
; - IN:  C = KEYCODE, (MODKEYS) = MODIFIER BITS
; - OUT: CARRY RESET: C = TRANSLATED KEYCODE (OR UNCHANGED)
; -      CARRY SET:   DROP THE KEYSTROKE, THE MATRIX ALREADY DELIVERED IT
; - CLOBBERS: AF, HL
; -

TRNGRPH         LD      A, (MODKEYS)
                AND     MODGRPH
                RET     Z               ; GRAPH NOT PRESSED

                LD      HL, .GRPTBL
.GRLOOP         LD      A, (HL)
                OR      A
                RET     Z               ; END OF TABLE: LEAVE C UNCHANGED
                CP      C
                JR      Z, .GRFND
                INC     HL
                INC     HL
                INC     HL
                JR      .GRLOOP

.GRFND          INC     HL
                LD      A, (HL)         ; A = TRANSLATED ACCENTED CHAR
                INC     HL
                PUSH    AF
                LD      A, (HL)         ; A = KEY CHKACNT SCANS FOR
                LD      HL, LASTGRP
                CP      (HL)
                JR      Z, .GRDROP      ; THIS PRESS IS ALREADY DELIVERED

                LD      (HL), A         ; CLAIM IT SO CHKACNT STAYS QUIET
                LD      A, (JIFFY)
                ADD     A, 25           ; SAME INITIAL DELAY AS .GRPINIT
                LD      (GRPTIM), A
                POP     AF
                LD      C, A            ; C = TRANSLATED ACCENTED CHAR
                OR      A               ; RESET CARRY: KEEP THE KEYSTROKE
                RET

.GRDROP         POP     AF
                SCF                     ; SET CARRY: DROP THE KEYSTROKE
                RET

.GRPTBL         ; TRIPLES: [INPUT KEYCODE, OUTPUT ACCENTED CODE, MATRIX KEY]
                ; SUPPORTS BOTH RAW ASCII AND MSX BIOS GRAPH CODES. THE THIRD
                ; BYTE IS WHAT CHKACNT KEEPS IN (LASTGRP) FOR THAT PHYSICAL
                ; KEY, SHIFTED OR NOT, SO A CLAIM HERE SILENCES THE MATRIX.
                ; #CF IS GRAPH+W ON THE NMS 8250: IT WAS MISSING FROM THE
                ; TABLE AND THE BIOS REPEAT TYPED IT RAW ON A HELD KEY.
                DEFB    #61, #A0, #61, #C4, #A0, #61
                DEFB    #41, #A0, #61, #65, #82, #65
                DEFB    #CD, #82, #65, #45, #90, #65
                DEFB    #69, #A1, #69, #DC, #A1, #69
                DEFB    #49, #A1, #69, #6F, #A2, #6F
                DEFB    #C2, #A2, #6F, #4F, #A2, #6F
                DEFB    #75, #A3, #75, #C0, #A3, #75
                DEFB    #55, #A3, #75, #6E, #A4, #6E
                DEFB    #5B, #A4, #6E, #4E, #A5, #6E
                DEFB    #D3, #A5, #6E, #3F, #A8, #3F
                DEFB    #2F, #A8, #3F, #F6, #A8, #3F
                DEFB    #21, #AD, #31, #31, #AD, #31
                DEFB    #AC, #AD, #31, #77, #81, #77
                DEFB    #CF, #81, #77, #57, #9A, #77
                DEFB    #00


; --- TRNDEAD                   ----------------------------------------


; - TRNDEAD ----------------------------
; - COMBINE PENDING DEAD KEY WITH VOWEL
; - IN:  C = KEYCODE
; - OUT: C = TRANSLATED KEYCODE (OR UNCHANGED)
; - CLOBBERS: AF, HL
; -

TRNDEAD         LD      A, (DEADST)
                OR      A
                RET     Z               ; NO DEAD KEY PENDING

                PUSH    AF              ; PRESERVE DEAD STATE (1=ACUTE, 2=DIAERESIS)
                XOR     A
                LD      (DEADST), A     ; RESET DEAD STATE

                ; IF KEY IS ESC OR BS, CANCEL DEAD KEY AND LEAVE C UNCHANGED
                LD      A, C
                CP      #1B             ; ESC
                JR      Z, .DEDQUIT
                CP      #08             ; BS
                JR      Z, .DEDQUIT

                POP     AF              ; RESTORE DEAD STATE
                CP      DEDDIAR
                JR      Z, .DODIAER

                ; ACUTE ACCENT: LOOK UP IN .ACTTBL
                LD      HL, .ACTTBL
.ACTLP          LD      A, (HL)
                OR      A
                RET     Z               ; NOT FOUND: LEAVE C UNCHANGED
                CP      C
                JR      Z, .ACTFND
                INC     HL
                INC     HL
                JR      .ACTLP

.ACTFND         INC     HL
                LD      C, (HL)         ; C = ACCENTED CHAR CODE
                RET

.DODIAER        ; DIAERESIS: LOOK UP IN .DIATBL
                LD      HL, .DIATBL
.DIALP          LD      A, (HL)
                OR      A
                RET     Z               ; NOT FOUND: LEAVE C UNCHANGED
                CP      C
                JR      Z, .DIAFND
                INC     HL
                INC     HL
                JR      .DIALP

.DIAFND         INC     HL
                LD      C, (HL)         ; C = DIAERESIS CHAR CODE
                RET

.DEDQUIT        POP     AF              ; CLEANUP STACK
                RET

.ACTTBL         ; PAIRS: [INPUT KEYCODE, OUTPUT ACCENTED CODE]
                DEFB    #61, #A0, #41, #A0, #65, #82, #45, #90
                DEFB    #69, #A1, #49, #A1, #6F, #A2, #4F, #A2
                DEFB    #75, #A3, #55, #A3, #6E, #A4, #4E, #A5
                DEFB    #85, #A0, #20, #27, #27, #27, #00

.DIATBL         ; PAIRS FOR DIAERESIS: [INPUT KEYCODE, OUTPUT CODE]
                DEFB    #75, #81, #55, #9A, #20, #22, #22, #22
                DEFB    #00

