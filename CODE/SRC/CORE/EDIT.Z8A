;                                       ****************************************
;                                       * EDIT OPERATIONS                      *
;                                       ****************************************
;
; ALL EDITING OPERATIONS WORK ON WORKBUF (CURRENT LINE LOADED BY LINEREAD).
; AFTER EACH EDIT: LINEWRT TO PERSIST, RENDEROW TO RE-RENDER.


; --- EDINSCHR                  ----------------------------------------


; - EDINSCHR ---------------------------
; - INSERT CHARACTER AT CURSOR POSITION
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDINSCHR        PUSH    AF
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                POP     AF

                LD      C, A            ; C = CHAR TO INSERT
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JR      Z, .WRTXT

                ; WRAP_DEV:
                LD      A, (CURX)
                CP      MAXCOLS
                RET     NC              ; AT/PAST MAXCOLS (255), NO INSERT
                LD      A, (WORKBUF)
                CP      MAXCOLS
                RET     NC              ; LINE AT MAXCOLS, CANNOT INSERT
                JR      .DOINS

.WRTXT          ; WRAP_TXT:
                LD      A, (CURX)
                CP      TEXTCOLS
                RET     NC              ; PAST THE LAST COLUMN, NO INSERT

                ; LAST COLUMN STILL FREE? THEN SHIFT-AND-INSERT IS SAFE AND THE
                ; CURSOR COLUMN DOES NOT MATTER -- NOTHING FALLS OFF THE EDGE.
                LD      A, (WORKBUF + TEXTCOLS)
                CP      ' '
                JR      Z, .DOINS

                ; THE LAST COLUMN IS OCCUPIED: INSERTING WOULD PUSH TEXT OUT
                ; OF THE RECORD. WHAT FOLLOWS IS THE WRAP MODE'S DECISION.
                LD      A, (CURX)
                CP      TEXTCOLS - 1
                JP      NZ, EDPSHWR
                LD      A, C
                CP      ' '
                JP      Z, EDNWLIN
                JP      EDPSHWR

.DOINS          ; ROOM AT THE LAST COLUMN: PLAIN INSERT ON THIS LINE
                CALL    UNDOBGN
                LD      HL, WORKBUF
                LD      A, (CURX)
                CALL    WBINS           ; TEXT + ATTRS SHIFTED, LENGTH UPDATED

                ; WRITE LINE TO MAPPER
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; RE-RENDER CURRENT ROW, UNLESS A BATCH EDIT IS RUNNING
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .NOREND
                LD      A, (CURY)
                INC     A
                LD      B, A            ; B = SCREEN ROW
                CALL    RENDIFF         ; ONLY THE CELLS THAT CHANGED

.NOREND         ; ADVANCE CURSOR
                LD      A, (CURX)
                INC     A
                LD      B, A            ; B = NEW CURX
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JR      Z, .CKWTXT
                ; WRAP_DEV: CAN ADVANCE UP TO MAXCOLS - 1
                LD      A, B
                CP      MAXCOLS
                JR      NC, .NOMOV
                LD      (CURX), A
                JR      .NOMOV
.CKWTXT         LD      A, B
                CP      TEXTCOLS
                JR      NC, .NOMOV
                LD      (CURX), A
.NOMOV          LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EDINSRUN                  ----------------------------------------


; - EDINSRUN ---------------------------
; - INSERT A RUN OF CHARACTERS ON THE CURRENT LINE IN ONE PASS
; - ONE LINEREAD AND ONE LINEWRT FOR THE WHOLE RUN INSTEAD OF A PAIR PER
; - CHARACTER, AND NO PAINTING AT ALL -- THE CALLER PAINTS WHEN IT IS DONE.
; - IT REFUSES RATHER THAN TRUNCATE: A RUN THAT DOES NOT FIT IS THE WRAP
; - MODE'S BUSINESS, AND ONLY EDINSCHR KNOWS THOSE RULES.
; - IN:  HL = SOURCE, B = COUNT (1..TEXTCOLS)
; - OUT: CY = 0  THE WHOLE RUN WENT IN
; -      CY = 1  IT DOES NOT FIT; NOTHING WAS WRITTEN AND A HOLDS HOW MANY
; -              CHARACTERS WOULD HAVE FITTED, SO THE CALLER CAN PUT
; -              THAT MUCH IN AS A BATCH AND ONLY THEN GO CHARACTER BY
; -              CHARACTER
; - CLOBBERS: ALL
; -

EDINSRUN        LD      (WBSRC), HL     ; SURVIVES LINEREAD
                LD      A, B
                LD      (WBRUN), A
                OR      A
                RET     Z               ; EMPTY RUN, CY = 0

                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; ROOM ON THIS LINE = MAXCOLS (or TEXTCOLS) - MAX(LENGTH, COLUMN).
                LD      A, (WORKBUF)    ; LENGTH
                LD      C, A
                LD      A, (CURX)
                CP      C
                JR      NC, .IRHAVE     ; COLUMN >= LENGTH: MEASURE FROM IT
                LD      A, C
.IRHAVE         LD      C, A
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JR      Z, .IRWTXT
                ; WRAP_DEV: MAXCOLS
                LD      A, MAXCOLS
                SUB     C
                JR      .IRGOTRM
.IRWTXT         LD      A, TEXTCOLS
                SUB     C
.IRGOTRM        LD      C, A            ; C = ROOM
                LD      A, (WBRUN)
                CP      C
                JR      Z, .IRFITS
                JR      C, .IRFITS
                LD      A, C            ; TOO LONG: HAND BACK THE ROOM
                SCF
                RET

.IRFITS         ; ONE LINE CHANGES: RECORD IT AS IT STANDS IN WORKBUF
                CALL    UNDOCLS
                LD      A, UNDOT_MOD
                CALL    UNDOREC

                LD      HL, WORKBUF
                LD      DE, (WBSRC)
                LD      A, (WBRUN)
                LD      B, A
                LD      A, (CURX)
                CALL    WBINSN

                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; THE CURSOR ADVANCES BY THE WHOLE RUN, CLAMPED THE WAY
                ; EDINSCHR CLAMPS ITS STEP
                LD      A, (CURX)
                LD      C, A
                LD      A, (WBRUN)
                ADD     A, C
                LD      B, A
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JR      Z, .IRCLTXT
                ; WRAP_DEV: CLAMP TO MAXCOLS - 1
                LD      A, B
                CP      MAXCOLS
                JR      C, .IRSETX
                LD      A, MAXCOLS - 1
                JR      .IRSETX
.IRCLTXT        ; WRAP_TXT: CLAMP TO TEXTCOLS - 1
                LD      A, B
                CP      TEXTCOLS
                JR      C, .IRSETX
                LD      A, TEXTCOLS - 1
.IRSETX         LD      (CURX), A

                LD      A, #FF
                LD      (MODIFIED), A
                OR      A               ; CY = 0: THE RUN IS IN
                RET


; --- EDPSHWR                   ----------------------------------------


; - EDPSHWR ----------------------------
; - PUSH-WRAP: THE LINE IS FULL AND A CHARACTER HAS TO GO IN ANYWAY.
; - MOVE THE TRAILING WORD DOWN TO A NEW LINE, THEN INSERT THE CHARACTER
; - ON WHICHEVER HALF THE CURSOR ENDED UP ON.
; - ORDER IS THE WHOLE POINT: SPLIT, INSERT, PERSIST, ONLY THEN RENDER.
; - RENDERING EARLIER WOULD RUN LINEREAD OVER WORKBUF AND LOSE THE HEAD.
; - IN:  C = CHAR TO INSERT, WORKBUF = LINE (DOCLINE), CURX = COLUMN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDPSHWR         CALL    UNDOCLS
                ; REFUSE IF THE LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; RESERVE THE RECORD FOR THE WORD THAT IS ABOUT TO MOVE DOWN
                ; BEFORE TOUCHING ANYTHING -- SAME REASON AS IN EDNWLIN. POP
                ; DOES NOT TOUCH THE FLAGS, SO NEWREC'S CARRY SURVIVES IT.
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      C, TEXTCOLS
                CALL    NEWREC
                POP     BC
                RET     C               ; NO MAPPER MEMORY: LEAVE THE LINE ALONE
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; THE PUSH MOVES TEXT ACROSS LINES AND IS NOT RECORDED, SO THE
                ; HISTORY WOULD NAME LINES IT IS ABOUT TO SHIFT: DROP IT
                ; (UNDOINIT KEEPS BC AND DE)
                CALL    UNDOINIT

                ; 1. SPLIT COLUMN = START OF THE TRAILING WORD
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      B, TEXTCOLS - 2 ; SCAN BACK FROM COLUMN 78
.PWSCAN         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .PWFND
                DEC     B
                LD      A, B
                INC     A               ; B WRAPPED PAST 0 (#FF) -> A = 0
                JR      NZ, .PWSCAN

                ; NO SPACE AT ALL: ONE LONG WORD, HARD BREAK AT THE LAST COLUMN
                LD      A, TEXTCOLS - 1
                JR      .PWSPL

.PWFND          LD      A, B
                INC     A               ; THE WORD STARTS ONE PAST THE SPACE

.PWSPL          POP     BC              ; RESTORE C (CHAR TO INSERT)
                LD      B, A            ; B = SPLIT COLUMN

                ; 2. DECIDE WHICH HALF KEEPS THE CURSOR **BEFORE** SPLITTING,
                ;    WHILE THE WHOLE LINE IS STILL COHERENT IN WORKBUF.
                ;    EFFCURX, NOT CURX: THE LINE IS FULL BY DEFINITION HERE,
                ;    SO THE CURSOR IS PARKED ON ITS LAST COLUMN AND THE EDIT
                ;    IS AN APPEND.
                CALL    EFFCURX
                CP      B
                JR      NC, .PWTAIL     ; CURX >= SPLIT: CURSOR RIDES THE WORD

                LD      (PWCOL), A      ; CURSOR STAYS ON THE HEAD, SAME COLUMN
                XOR     A
                LD      (PWTAIL), A
                JR      .PWDOSPL

.PWTAIL         SUB     B               ; COLUMN MEASURED INSIDE THE MOVED WORD
                LD      (PWCOL), A
                LD      A, #FF
                LD      (PWTAIL), A

.PWDOSPL        ; 3. SPLIT: HEAD KEEPS 0..SPLIT-1, TAIL GOES TO WORKBUF2
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      A, B
                CALL    SPLITLA
                POP     BC              ; RESTORE C

                ; 4. INSERT WHILE BOTH HALVES ARE STILL IN RAM
                LD      HL, WORKBUF
                LD      A, (PWTAIL)
                OR      A
                JR      Z, .PWINS
                LD      HL, WORKBUF2
.PWINS          LD      A, (PWCOL)
                CALL    WBINS

                ; 5. PERSIST THE HEAD BEFORE ANYTHING CAN RENDER
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 6. PUT THE TAIL IN THE RECORD RESERVED AT THE TOP
                LD      A, (NRSEG)
                LD      DE, (NROFF)
                LD      HL, WORKBUF2
                CALL    PUTREC

                ; 7. OPEN A DIRECTORY SLOT AFTER THE CURRENT LINE AND FILL IT
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 8. CURSOR LANDS ONE PAST THE CHARACTER JUST TYPED
                LD      A, (PWCOL)
                INC     A
                CP      TEXTCOLS
                JR      C, .PWSETX
                LD      A, TEXTCOLS - 1
.PWSETX         LD      (CURX), A

                LD      A, (PWTAIL)
                OR      A
                JR      Z, .PWMOD
                LD      HL, (DOCLINE)   ; THE CURSOR FOLLOWED THE WORD DOWN
                INC     HL
                LD      (DOCLINE), HL

.PWMOD          LD      A, #FF
                LD      (MODIFIED), A

                ; 9. UPDATE THE DISPLAY. CURY STILL HOLDS THE HEAD'S ROW --
                ;    SETCURY RECOMPUTES IT FROM DOCLINE AND TOPLINE AT THE END.
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .PWHOLD

                LD      A, (CURY)
                CP      ROWSVIS - 1
                JR      Z, .PWBOT

                INC     A
                INC     A
                LD      B, A            ; B = SCREEN ROW OF THE NEW LINE (2..24)
                PUSH    BC
                CALL    SHIFTDN
                POP     BC

                DEC     B
                CALL    RENDEROW        ; SHORTENED HEAD
                INC     B
                CALL    RENDEROW        ; THE WORD THAT MOVED DOWN
                JP      SETCURY

.PWBOT          ; AT THE BOTTOM THE NEW LINE ONLY FITS IF THE VIEW SCROLLS
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                CALL    SCROLLDN        ; RENDERS ROW 24

                LD      B, TXRLAST - 1  ; ROW 23 NOW HOLDS THE SHORTENED HEAD
                CALL    RENDEROW
                JP      SETCURY

.PWHOLD         ; PAINTING IS DEFERRED, BUT THE VIEWPORT STILL HAS TO FOLLOW
                ; THE NEW LINE WHEN IT LANDS BELOW THE LAST ROW.
                LD      A, (CURY)
                CP      ROWSVIS - 1
                JP      NZ, SETCURY
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                JP      SETCURY


; --- WBINS                     ----------------------------------------


; - WBINS ------------------------------
; - INSERT A CHARACTER INTO A LINE RECORD AT A COLUMN
; - IN:  HL = RECORD BASE, A = COLUMN (0..MAXCOLS-1), C = CHAR CODE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WBINS           LD      (WBBASE), HL
                LD      (WBCOL), A

                ; CHECK IF COLUMN < LENGTH
                LD      A, (HL)         ; A = CURRENT LENGTH L
                LD      B, A            ; B = L
                LD      A, (WBCOL)
                CP      B
                JR      NC, .WBNOSH     ; COLUMN >= LENGTH: NOTHING SHIFTS

                ; COLUMN < LENGTH: SHIFT CHARACTERS FROM COLUMN UP TO L - 1 RIGHT BY 1
                ; COUNT = L - COLUMN
                LD      A, B
                LD      HL, WBCOL
                SUB     (HL)            ; A = L - COLUMN
                LD      (WBCNT), A

                ; TEXT HALF: SOURCE END = BASE + L, DEST END = BASE + L + 1
                LD      HL, (WBBASE)
                LD      E, B
                LD      D, 0
                ADD     HL, DE          ; HL = BASE + L
                LD      D, H
                LD      E, L
                INC     DE              ; DE = BASE + L + 1
                LD      A, (WBCNT)
                PUSH    BC              ; SAVE B=L, C=CHAR
                LD      C, A
                LD      B, 0
                LDDR
                POP     BC

                ; ATTRIBUTE HALF: SOURCE END = BASE + WORKATTR + L, DEST END = + 1
                LD      HL, (WBBASE)
                LD      DE, WORKATTR
                ADD     HL, DE
                LD      E, B
                LD      D, 0
                ADD     HL, DE          ; HL = BASE + WORKATTR + L
                LD      D, H
                LD      E, L
                INC     DE              ; DE = BASE + WORKATTR + L + 1
                LD      A, (WBCNT)
                PUSH    BC
                LD      C, A
                LD      B, 0
                LDDR
                POP     BC

.WBNOSH         ; PLACE THE CHARACTER AND ATTRIBUTE
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                INC     HL
                ADD     HL, DE          ; HL = BASE + 1 + COLUMN
                LD      (HL), C
                LD      DE, WORKATTR
                ADD     HL, DE          ; HL = BASE + 1 + WORKATTR + COLUMN
                LD      A, (TYPATTR)
                LD      (HL), A

                ; UPDATE LENGTH
                ; IF COLUMN < LENGTH: NEW LENGTH = LENGTH + 1 (UP TO MAXCOLS)
                ; IF COLUMN >= LENGTH: NEW LENGTH = COLUMN + 1
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                CP      (HL)
                JR      C, .WBGROW
                INC     A               ; COLUMN >= LENGTH -> NEW LENGTH = COLUMN + 1
                LD      (HL), A
                RET

.WBGROW         LD      A, (HL)
                CP      MAXCOLS
                RET     NC              ; ALREADY AT MAXCOLS
                INC     A
                LD      (HL), A
                RET


; --- WBINSN                    ----------------------------------------


; - WBINSN -----------------------------
; - INSERT A RUN OF CHARACTERS INTO A LINE RECORD AT A COLUMN
; - IN:  HL = BASE, A = COLUMN, DE = SOURCE, B = COUNT (1..MAXCOLS)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WBINSN          LD      (WBBASE), HL
                LD      (WBCOL), A
                LD      (WBSRC), DE
                LD      A, B
                OR      A
                RET     Z               ; EMPTY RUN
                LD      (WBRUN), A

                ; CHECK IF COLUMN < LENGTH
                LD      HL, (WBBASE)
                LD      A, (HL)         ; A = CURRENT LENGTH L
                LD      C, A            ; C = L
                LD      A, (WBCOL)
                CP      C
                JR      NC, .WNFILL     ; COLUMN >= LENGTH: NOTHING SHIFTS

                ; COLUMN < LENGTH: SHIFT CHARACTERS RIGHT BY N (WBRUN)
                ; COUNT = L - COLUMN
                LD      A, C            ; A = L
                LD      HL, WBCOL
                SUB     (HL)            ; A = L - COLUMN
                LD      (WBCNT), A

                ; TEXT HALF:
                ; SOURCE END = BASE + L
                ; DEST END   = BASE + L + N
                LD      HL, (WBBASE)
                LD      E, C            ; E = L
                LD      D, 0
                ADD     HL, DE          ; HL = BASE + L (SRC END)
                LD      A, (WBRUN)
                LD      E, A
                LD      D, 0
                PUSH    HL
                ADD     HL, DE
                EX      DE, HL          ; DE = BASE + L + N (DEST END)
                POP     HL              ; HL = SRC END
                LD      A, (WBCNT)
                LD      C, A
                LD      B, 0
                LDDR

                ; ATTRIBUTE HALF:
                ; SOURCE END = BASE + WORKATTR + L
                ; DEST END   = BASE + WORKATTR + L + N
                LD      HL, (WBBASE)
                LD      A, (HL)         ; A = L
                LD      E, A
                LD      D, 0
                LD      BC, WORKATTR
                ADD     HL, BC
                ADD     HL, DE          ; HL = BASE + WORKATTR + L
                LD      A, (WBRUN)
                LD      E, A
                LD      D, 0
                PUSH    HL
                ADD     HL, DE
                EX      DE, HL          ; DE = BASE + WORKATTR + L + N
                POP     HL
                LD      A, (WBCNT)
                LD      C, A
                LD      B, 0
                LDDR

.WNFILL         ; TEXT: COPY THE RUN IN, TRANSLATING TAB TO A SPACE
                LD      HL, (WBBASE)
                INC     HL
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = BASE + 1 + COLUMN
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, (WBSRC)
                LD      A, (WBRUN)
                LD      B, A
.WNCOPY         LD      A, (HL)
                CP      #09
                JR      NZ, .WNPUT
                LD      A, ' '
.WNPUT          LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .WNCOPY

                ; ATTRIBUTES: N CELLS OF THE CURRENT TYPING ATTRIBUTE
                LD      HL, (WBBASE)
                LD      DE, 1 + WORKATTR
                ADD     HL, DE          ; HL = BASE + 1 + WORKATTR
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = BASE + 1 + WORKATTR + COLUMN
                LD      A, (WBRUN)
                LD      B, A
                LD      A, (TYPATTR)
.WNATTR         LD      (HL), A
                INC     HL
                DJNZ    .WNATTR

                ; UPDATE LENGTH:
                ; IF COLUMN < LENGTH: NEW LENGTH = LENGTH + N
                ; IF COLUMN >= LENGTH: NEW LENGTH = COLUMN + N
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                CP      (HL)
                JR      C, .WNGROW
                LD      C, A
                LD      A, (WBRUN)
                ADD     A, C
                CP      MAXCOLS
                JR      C, .WNSET
                LD      A, MAXCOLS
.WNSET          LD      (HL), A
                RET

.WNGROW         LD      A, (HL)
                LD      C, A
                LD      A, (WBRUN)
                ADD     A, C
                CP      MAXCOLS
                JR      C, .WNGSET
                LD      A, MAXCOLS
.WNGSET         LD      (HL), A
                RET


; --- SETCURY                   ----------------------------------------


; - SETCURY ----------------------------
; - RECOMPUTE THE VIEWPORT ROW FROM THE DOCUMENT POSITION
; - CURY = DOCLINE - TOPLINE IS AN INVARIANT. EVERY CHANGE TO EITHER SIDE
; - COMES BACK THROUGH HERE; NEVER ADJUST CURY BY HAND.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

SETCURY         LD      HL, (DOCLINE)
                LD      DE, (TOPLINE)
                OR      A
                SBC     HL, DE
                LD      A, L
                LD      (CURY), A
                RET


; --- EDTGLWRP                  ----------------------------------------


; - EDTGLWRP ---------------------------
; - TOGGLE WRAP MODE (WRAP_DEV <-> WRAP_TXT)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

EDTGLWRP        LD      A, (WRAPMODE)
                XOR     1
                LD      (WRAPMODE), A
                RET


; --- EDOVRCHR                  ----------------------------------------


; - EDOVRCHR ---------------------------
; - OVERWRITE CHARACTER AT CURSOR
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDOVRCHR        CALL    EDINSCHR        ; FOR NOW, ROUTE TO INSERT
                RET


; --- REFLOW                    ----------------------------------------


; - REFLOW -----------------------------
; - CASCADE PARAGRAPH REFLOW STARTING AT LINE HL
; - PULLS WORDS UPWARDS ACROSS SUBSEQUENT LINES UNTIL AN EMPTY LINE OR EOF
; - IN:  HL = START LINE NUMBER (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; -

REFLOW          LD      (RFLINE), HL

.RFLOOP         ; 1. CHECK IF NEXT LINE EXISTS (L + 1 < TOTLINES)
                LD      HL, (RFLINE)
                INC     HL              ; HL = L + 1
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; L + 1 >= TOTLINES: EOF REACHED, DONE!

                ; 2. LOAD LINE L + 1 INTO WORKBUF2
                CALL    LINEREAD        ; READS LINE L+1 INTO WORKBUF
                LD      A, (WORKBUF)
                OR      A
                JR      NZ, .NOTEMP

                ; LINE L+1 IS EMPTY (LEN == 0):
                ; DELETE THE EMPTY LINE AND STOP (PARAGRAPH BOUNDARY).
                ; A REFLOW MOVES TEXT ACROSS LINES AND IS NOT RECORDED: EACH
                ; BRANCH THAT WRITES DROPS THE HISTORY FIRST, WHICH WOULD
                ; OTHERWISE NAME LINES THIS IS ABOUT TO SHIFT
                CALL    UNDOINIT
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      A, #FF
                LD      (MODIFIED), A
                RET

.NOTEMP         ; COPY LINE L+1 RECORD TO WORKBUF2
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 3. LOAD LINE L INTO WORKBUF
                LD      HL, (RFLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                CP      TEXTCOLS
                JP      NC, .RFNEXT     ; LINE L IS FULL, ADVANCE TO L+1

                ; 4. CALCULATE AVAILABLE SPACE ON LINE L
                LD      E, A            ; E = LEN_A
                LD      A, TEXTCOLS
                SUB     E               ; A = TEXTCOLS - LEN_A
                LD      (RFSPACE), A
                XOR     A
                LD      (RFSEP), A

                ; DOES LINE L NEED A SEPARATOR SPACE?
                ; ONLY IF LEN_A > 0 AND LAST CHAR IS NOT ' '
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .CHECKAL

                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF
                ADD     HL, DE          ; HL = WORKBUF + LEN_A (LAST CHAR)
                LD      A, (HL)
                CP      ' '
                JR      Z, .CHECKAL

                ; NEED SEPARATOR SPACE
                LD      A, 1
                LD      (RFSEP), A
                LD      A, (RFSPACE)
                DEC     A
                JP      Z, .RFNEXT      ; ONLY 1 SPACE LEFT, CANNOT FIT ANY WORD
                LD      (RFSPACE), A

.CHECKAL        ; 5. CAN ENTIRE LINE L+1 FIT?
                LD      A, (WORKBUF2)   ; LEN_B
                LD      HL, RFSPACE
                CP      (HL)
                JP      Z, .RFALL       ; EXACT FIT
                JP      C, .RFALL       ; FITS ENTIRELY

                ; 6. PARTIAL FIT: FIND LONGEST WORD BOUNDARY <= RFSPACE
                ; SCAN WORKBUF2 BACKWARDS FROM (RFSPACE) DOWN TO 1
                LD      A, (RFSPACE)
                LD      B, A            ; B = OFFSET IN LINE B (1..RFSPACE)
.RFPART         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE          ; HL = WORKBUF2 + B
                LD      A, (HL)
                CP      ' '
                JR      Z, .RFFND       ; FOUND SPACE!
                DJNZ    .RFPART

                ; NO WORD BOUNDARY FOUND WITHIN RFSPACE: STOP REFLOW
                RET

.RFFND          ; B = INDEX IN LINE B WHERE SPACE WAS FOUND
                CALL    UNDOINIT        ; KEEPS B
                LD      A, B
                LD      (RFCNT), A

                ; APPEND SEPARATOR SPACE TO LINE L IF NEEDED
                LD      A, (RFSEP)
                OR      A
                JR      Z, .NOPSEP

                LD      A, (WORKBUF)    ; LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), ' '
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      (HL), 0
                LD      A, (WORKBUF)
                INC     A
                LD      (WORKBUF), A

.NOPSEP         ; APPEND RFCNT BYTES FROM WORKBUF2 TO WORKBUF
                LD      A, (WORKBUF)    ; CURRENT LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF2 + 1 ; HL = SOURCE TEXT
                LD      A, (RFCNT)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE          ; DEST ATTR
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + WORKATTR
                LDIR

                ; UPDATE LINE L LENGTH: LEN_A + RFCNT
                LD      A, (WORKBUF)
                LD      HL, RFCNT
                ADD     A, (HL)
                LD      (WORKBUF), A

                CALL    RECBL80

                ; PERSIST UPDATED LINE L
                LD      HL, (RFLINE)
                CALL    LINEWRT

                ; 7. UPDATE LINE L+1 FROM WORKBUF2 (SHIFT REMAINDER LEFT)
                ; REMAINDER STARTS AFTER RFCNT IN WORKBUF2
                LD      A, (WORKBUF2)   ; OLD LEN_B
                LD      HL, RFCNT
                SUB     (HL)
                LD      B, A            ; B = INITIAL REMAINING CHARS
                LD      A, (RFCNT)
                INC     A               ; SKIP THE SPACE WE SPLIT AT
                LD      C, A            ; C = 1-BASED SOURCE OFFSET IN WORKBUF2

                ; SKIP ANY CONSECUTIVE LEADING SPACES IN THE REMAINDER
.SKPPRE         LD      A, B
                OR      A
                JR      Z, .REMZERO
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      NZ, .SKPDONE
                INC     C
                DEC     B
                JR      .SKPPRE

.SKPDONE        ; B = REMAINING CHAR COUNT (1..TEXTCOLS)
                ; C = 1-BASED SOURCE OFFSET IN WORKBUF2
                ; CONSTRUCT SHORTENED LINE L+1 IN WORKBUF
                LD      A, B
                LD      (WORKBUF), A    ; NEW LENGTH

                ; COPY REMAINING TEXT FROM WORKBUF2 TO WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE          ; HL = WORKBUF2 + C
                LD      DE, WORKBUF + 1
                LD      C, B
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; COPY REMAINING ATTRIBUTES FROM WORKBUF2 TO WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2 + WORKATTR
                ADD     HL, DE          ; HL = WORKBUF2 + WORKATTR + C
                LD      DE, WORKBUF + 1 + WORKATTR
                LD      A, (WORKBUF)
                LD      C, A
                LD      B, 0
                LDIR

                CALL    RECBL80

                ; PERSIST SHORTENED LINE L+1
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEWRT

                LD      A, #FF
                LD      (MODIFIED), A

                ; ADVANCE RFLINE TO L + 1 AND CONTINUE CASCADE
                JP      .RFNEXT

.REMZERO        ; REMAINDER WAS EMPTY: DELETE LINE L+1
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      A, #FF
                LD      (MODIFIED), A
                JP      .RFLOOP

.RFALL          ; ENTIRE LINE L+1 FITS ON LINE L!
                CALL    UNDOINIT
                LD      A, (RFSEP)
                OR      A
                JR      Z, .NOPSEP2

                LD      A, (WORKBUF)    ; LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), ' '
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      (HL), 0
                LD      A, (WORKBUF)
                INC     A
                LD      (WORKBUF), A

.NOPSEP2        LD      A, (WORKBUF2)   ; LEN_B
                OR      A
                JR      Z, .DELL1

                LD      A, (WORKBUF)    ; CURRENT LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF2 + 1 ; HL = SOURCE TEXT
                LD      A, (WORKBUF2)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE          ; DEST ATTR
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + WORKATTR
                LDIR

                ; UPDATE LINE L LENGTH: LEN_A + LEN_B
                LD      A, (WORKBUF)
                LD      HL, WORKBUF2
                ADD     A, (HL)
                LD      (WORKBUF), A

.DELL1          CALL    RECBL80

                ; PERSIST UPDATED LINE L
                LD      HL, (RFLINE)
                CALL    LINEWRT

                ; DELETE LINE L+1 FROM DIRECTORY
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL

                ; DECREMENT TOTLINES
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                LD      A, #FF
                LD      (MODIFIED), A

                ; DO NOT INCREMENT RFLINE; REPEAT FOR SAME RFLINE
                JP      .RFLOOP

.RFNEXT         ; ADVANCE TO NEXT LINE (L = L + 1)
                LD      HL, (RFLINE)
                INC     HL
                LD      (RFLINE), HL
                JP      .RFLOOP

; --- RECBL80                   ----------------------------------------


; - RECBL80 ----------------------------
; - BLANK THE TAIL OF THE RECORD HELD IN WORKBUF: SPACES IN THE TEXT HALF
; - AND ZERO ATTRIBUTES, FROM THE LENGTH BYTE UP TO THE LAST COLUMN.
; - IN:  WORKBUF HOLDS A LINE RECORD, (WORKBUF) = LENGTH
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

RECBL80         LD      A, (WORKBUF)
                CP      MAXCOLS
                RET     NC              ; ALREADY FULL

                LD      E, A
                LD      D, 0
                LD      A, MAXCOLS
                SUB     E
                LD      B, A            ; B = MAXCOLS - LEN

                LD      HL, WORKBUF + 1
                ADD     HL, DE
                PUSH    BC
                PUSH    HL
.BLKTXT         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT
                POP     HL
                POP     BC

                LD      DE, WORKATTR
                ADD     HL, DE
.BLKATT         LD      (HL), 0
                INC     HL
                DJNZ    .BLKATT
                RET


; --- JOIN2L                    ----------------------------------------


; - JOIN2L -----------------------------
; - JOIN TWO ADJACENT LINES IN DEV MODE (LINE B APPENDED TO A, B DELETED)
; - IN:  HL = LINE A (TARGET LINE NUMBER)
; -      DE = LINE B (SOURCE TO DELETE)
; - OUT: CY = 0 : SUCCESS, JOINCOL = LEN A
; -      CY = 1 : FAILED (> MAXCOLS)
; - CLOBBERS: ALL
; -

JOIN2L          LD      (JOINLA), HL
                LD      (JOINLB), DE

                ; READ LINE B (SOURCE) INTO WORKBUF2
                EX      DE, HL          ; HL = LINE B
                CALL    LINEREAD
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; READ LINE A (TARGET) INTO WORKBUF
                LD      HL, (JOINLA)
                CALL    LINEREAD

                ; SAVE ORIGINAL LENGTH OF LINE A
                LD      A, (WORKBUF)
                LD      (JOINCOL), A

                ; CHECK IF COMBINED LENGTH EXCEEDS THE LINE WIDTH
                LD      B, A            ; B = LEN_A
                LD      A, (WORKBUF2)   ; A = LEN_B
                ADD     A, B            ; A = LEN_A + LEN_B
                JR      C, .JNBIG       ; 8-BIT OVERFLOW > 255: REJECT

                ; RECORD JOIN IN UNDO RING BUFFER
                CALL    UNDOJON
                LD      HL, (JOINLA)
                CALL    LINEREAD        ; RESTORE WORKBUF = LINE A

                ; APPEND LINE B TEXT & ATTRS IF LEN_B > 0
                LD      A, (WORKBUF2)
                OR      A
                JR      Z, .JNDEL

                ; APPEND TEXT
                LD      A, (JOINCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST TEXT (WORKBUF + 1 + LEN_A)
                LD      HL, WORKBUF2 + 1 ; HL = SRC TEXT
                LD      A, (WORKBUF2)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (JOINCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + WORKATTR ; HL = SRC ATTR
                LDIR

                ; UPDATE LINE A LENGTH
                LD      A, (JOINCOL)
                LD      HL, WORKBUF2
                ADD     A, (HL)
                LD      (WORKBUF), A

                ; BLANK UNUSED TAIL CELLS UP TO THE LAST COLUMN
                CALL    RECBL80

                ; WRITE UPDATED LINE A BACK
                LD      HL, (JOINLA)
                CALL    LINEWRT

.JNDEL          ; DELETE LINE B FROM DIRECTORY
                LD      HL, (JOINLB)
                CALL    LINEDEL

                ; DECREMENT TOTAL LINE COUNT
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                LD      A, #FF
                LD      (MODIFIED), A
                OR      A               ; CLEAR CARRY (CY = 0: SUCCESS)
                RET

.JNBIG          SCF                     ; SET CARRY (CY = 1: FAILED)
                RET


; --- EDJNDEV                   ----------------------------------------


; - EDJNDEV ----------------------------
; - BACKSPACE AT COL 0 IN WRAP_DEV: JOIN CURRENT LINE INTO PREVIOUS LINE
; - IN:  NONE (DOCLINE > 0)
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDJNDEV         LD      HL, (DOCLINE)
                DEC     HL              ; LINE A = DOCLINE - 1
                LD      DE, (DOCLINE)   ; LINE B = DOCLINE
                CALL    JOIN2L
                RET     C               ; FAILED (TOO WIDE)

                ; POSITION CURSOR AT SEAM ON LINE A
                LD      A, (JOINCOL)
                LD      (CURX), A

                ; MOVE DOCLINE UP
                LD      HL, (DOCLINE)
                DEC     HL
                LD      (DOCLINE), HL

                ; IF AT TOP OF VIEWPORT (CURY == 0), SCROLL TOPLINE UP
                LD      A, (CURY)
                OR      A
                JR      NZ, .JNTOP
                LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL

.JNTOP          CALL    SETCURY
                JP      REDRAW


; --- EDDELDV                   ----------------------------------------


; - EDDELDV ----------------------------
; - DELETE AT EOL IN WRAP_DEV: PULL NEXT LINE UP INTO CURRENT LINE
; - IN:  NONE (DOCLINE + 1 < TOTLINES)
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELDV         LD      HL, (DOCLINE)   ; LINE A = DOCLINE
                LD      DE, (DOCLINE)
                INC     DE              ; LINE B = DOCLINE + 1
                CALL    JOIN2L
                RET     C               ; FAILED (TOO WIDE)

                ; CURSOR STAYS AT SEAM ON LINE A
                LD      A, (JOINCOL)
                LD      (CURX), A

                ; DOCLINE, TOPLINE, CURY DO NOT CHANGE
                JP      REDRAW


; --- EDDELBK                 ----------------------------------------


; - EDDELBK ----------------------------
; - DELETE CHARACTER BEFORE CURSOR (BACKSPACE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELBK         LD      A, (CURX)
                OR      A
                JR      Z, .ATCOL0

                ; IN-LINE BACKSPACE (CURX > 0)
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                CALL    UNDOBGN

                LD      A, (CURX)
                DEC     A
                LD      (CURX), A

                ; DELETE CHAR AT CURX: SHIFT LEFT FROM CURX+1 UP TO L-1
                LD      A, (WORKBUF)    ; A = L
                OR      A
                JR      Z, .DELWRT      ; LENGTH 0: NOTHING TO DO
                LD      B, A            ; B = L
                LD      A, (CURX)       ; A = CURX
                INC     A               ; A = CURX + 1
                CP      B
                JR      NC, .BKLAST     ; CURX + 1 >= L: WE DELETED THE LAST CHAR, NO SHIFT

                ; COUNT = L - (CURX + 1)
                LD      A, B
                LD      HL, CURX
                SUB     (HL)
                DEC     A               ; A = L - 1 - CURX
                LD      C, A
                LD      B, 0            ; BC = COUNT

                ; SHIFT TEXT: SOURCE = WORKBUF + 2 + CURX, DEST = WORKBUF + 1 + CURX
                LD      A, (CURX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; HL = DEST (WORKBUF + 1 + CURX)
                LD      D, H
                LD      E, L            ; DE = DEST TEXT
                INC     HL              ; HL = SRC TEXT (WORKBUF + 2 + CURX)
                PUSH    BC              ; SAVE BC = COUNT
                PUSH    DE              ; SAVE DE = DEST TEXT
                LDIR

                POP     DE              ; DE = DEST TEXT
                POP     BC              ; BC = COUNT
                LD      HL, WORKATTR
                ADD     HL, DE          ; HL = DEST ATTR (DEST TEXT + WORKATTR)
                LD      D, H
                LD      E, L            ; DE = DEST ATTR
                INC     HL              ; HL = SRC ATTR (DEST ATTR + 1)
                LDIR

.BKLAST         ; BLANK THE VACATED LAST CELL (AT FORMER LENGTH L - 1)
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF
                ADD     HL, DE          ; HL = WORKBUF + L (LAST CHAR)
                LD      (HL), ' '
                LD      BC, WORKATTR
                ADD     HL, BC          ; HL = WORKBUF + L + WORKATTR
                LD      (HL), 0

                ; DECREASE LINE LENGTH
                LD      A, (WORKBUF)
                DEC     A
                LD      (WORKBUF), A

.DELWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDIFF         ; ONLY THE CELLS THAT CHANGED

                LD      A, #FF
                LD      (MODIFIED), A
                RET

.ATCOL0         ; BACKSPACE AT COLUMN 0
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT DOCLINE 0: TOP OF DOC, DO NOTHING

                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JP      NZ, EDJNDEV     ; IN WRAP_DEV: DEV LINE JOIN / LINE DELETE

                ; READ PREVIOUS LINE (DOCLINE - 1) TO FIND SEAM COLUMN
                DEC     HL
                CALL    LINEREAD
                LD      A, (WORKBUF)    ; FORMER LENGTH OF LINE L-1
                LD      (CURX), A       ; CURSOR SITS AT THE SEAM

                ; DOCLINE DECREMENTS TO LINE L-1
                LD      HL, (DOCLINE)
                DEC     HL
                LD      (DOCLINE), HL

                ; IF WE WERE AT THE TOP ROW OF VIEWPORT (CURY == 0), SCROLL TOPLINE UP
                LD      A, (CURY)
                OR      A
                JR      NZ, .NOTOP
                LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL

.NOTOP          CALL    SETCURY         ; RECOMPUTE CURY = DOCLINE - TOPLINE

                ; CASCADE REFLOW STARTING AT DOCLINE
                LD      HL, (DOCLINE)
                CALL    REFLOW

                JP      REDRAW          ; TAIL CALL: FULL REDRAW


; --- EDDELCHR                  ----------------------------------------


; - EDDELCHR ---------------------------
; - DELETE CHARACTER AT CURSOR (DEL KEY)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELCHR        LD      HL, (DOCLINE)
                CALL    LINEREAD

                LD      A, (WORKBUF)    ; LINE LENGTH
                LD      B, A
                LD      A, (CURX)
                CP      B
                JR      NC, .ATEOL      ; CURX >= LENGTH: AT OR PAST END OF LINE

                ; IN-LINE DELETE (CURX < LENGTH)
                CALL    UNDOBGN
                LD      A, (WORKBUF)
                LD      B, A            ; B = L
                LD      A, (CURX)
                INC     A               ; A = CURX + 1
                CP      B
                JR      NC, .DCHLAST    ; CURX + 1 >= L: DELETING LAST CHAR

                ; COUNT = L - 1 - CURX
                LD      A, B
                LD      HL, CURX
                SUB     (HL)
                DEC     A               ; A = COUNT
                LD      C, A
                LD      B, 0            ; BC = COUNT

                ; SHIFT TEXT: DEST = WORKBUF + 1 + CURX, SRC = WORKBUF + 2 + CURX
                LD      A, (CURX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; HL = DEST (WORKBUF + 1 + CURX)
                LD      D, H
                LD      E, L            ; DE = DEST TEXT
                INC     HL              ; HL = SRC TEXT (WORKBUF + 2 + CURX)
                PUSH    BC              ; SAVE BC = COUNT
                PUSH    DE              ; SAVE DE = DEST TEXT
                LDIR

                POP     DE              ; DE = DEST TEXT
                POP     BC              ; BC = COUNT
                LD      HL, WORKATTR
                ADD     HL, DE          ; HL = DEST ATTR (DEST TEXT + WORKATTR)
                LD      D, H
                LD      E, L            ; DE = DEST ATTR
                INC     HL              ; HL = SRC ATTR (DEST ATTR + 1)
                LDIR

.DCHLAST        ; BLANK THE VACATED LAST CELL (AT FORMER LENGTH L - 1)
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF
                ADD     HL, DE          ; HL = WORKBUF + L (LAST CHAR)
                LD      (HL), ' '
                LD      BC, WORKATTR
                ADD     HL, BC
                LD      (HL), 0

                ; DECREASE LINE LENGTH
                LD      A, (WORKBUF)
                DEC     A
                LD      (WORKBUF), A

.DCHWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDIFF         ; ONLY THE CELLS THAT CHANGED

                LD      A, #FF
                LD      (MODIFIED), A
                RET

.ATEOL          ; CURX >= LENGTH: AT OR PAST END OF LINE
                ; CHECK IF NEXT LINE EXISTS (DOCLINE + 1 < TOTLINES)
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; NO NEXT LINE: BOTTOM OF DOCUMENT

                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JP      NZ, EDDELDV     ; IN WRAP_DEV: DEV LINE JOIN / LINE DELETE BELOW

                ; CLAMP CURX TO CURRENT LENGTH (THE JOIN SEAM)
                LD      A, (WORKBUF)
                LD      (CURX), A

                ; CASCADE REFLOW STARTING AT DOCLINE
                LD      HL, (DOCLINE)
                CALL    REFLOW

                JP      REDRAW          ; TAIL CALL


; --- CALCALN                   ----------------------------------------


; - CALCALN ----------------------------
; - COMPUTE THE AUTO-ALIGN COLUMN FOR A LINE RECORD IN WORKBUF.
; - ASSEMBLY LAYOUT RULES:
; -   EMPTY LINE                       -> 0
; -   FIRST CHAR ';' (FULL COMMENT)    -> 0
; -   FIRST CHAR SPACE (NO LABEL,      -> COLUMN OF THE FIRST TOKEN
; -     LINE ALREADY INDENTED)
; -   OTHERWISE (LABEL AT COLUMN 0)    -> COLUMN OF THE TOKEN AFTER THE
; -                                       LABEL, OR 0 ON A LABEL-ONLY LINE
; - IN:  WORKBUF = LINE RECORD
; - OUT: A = TARGET COLUMN (0..TEXTCOLS-1)
; - CLOBBERS: ALL
; -

CALCALN         LD      A, (WORKBUF)
                OR      A
                RET     Z               ; EMPTY LINE -> 0
                LD      C, A            ; C = LENGTH

                LD      A, (WORKBUF + 1)
                CP      ';'
                JR      NZ, .NOTCMT
                XOR     A
                RET                     ; FULL-LINE COMMENT -> 0

.NOTCMT         CP      ' '
                JR      Z, .FIRTOK      ; INDENTED LINE: OPCODE IS FIRST TOKEN

                LD      B, 0            ; SKIP THE LABEL TOKEN AT COLUMN 0
.LBLLP          LD      A, B
                CP      C
                JR      NC, .EOL        ; LABEL ONLY -> 0
                LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .GAP         ; END OF LABEL
                CP      9               ; TAB: LOADED FILES MAY HOLD RAW ONES
                JR      Z, .GAP
                INC     B
                JR      .LBLLP

.GAP            LD      A, B            ; SKIP WHITESPACE BETWEEN LABEL AND MNEMONIC
                CP      C
                JR      NC, .EOL
                LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .GAPSKP
                CP      9
                JR      NZ, .GOT
.GAPSKP         INC     B
                JR      .GAP

.FIRTOK         LD      B, 0            ; SKIP LEADING SPACES
.FSKLP          LD      A, B
                CP      C
                JR      NC, .EOL        ; ALL-SPACES LINE -> 0
                LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .FSSKP
                CP      9
                JR      NZ, .GOT
.FSSKP          INC     B
                JR      .FSKLP

.GOT            LD      A, B            ; A = TARGET COLUMN
                RET

.EOL            XOR     A
                RET


; --- EDNWLIN                 ----------------------------------------


; - EDNWLIN ----------------------------
; - INSERT LINE BREAK / NEWLINE AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDNWLIN         CALL    UNDOCLS
                ; REFUSE IF THE LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; 1. RESERVE THE RECORD FOR THE TAIL FIRST
                LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LINE LENGTH
                LD      HL, CURX
                SUB     (HL)            ; A = MAX(0, LEN - CURX)
                JR      NC, .HAVTLN
                XOR     A
.HAVTLN         LD      C, A            ; C = TAIL LENGTH
                CALL    NEWREC
                RET     C               ; NO MAPPER MEMORY: LEAVE THE LINE ALONE
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 2. LOAD THE LINE THAT IS ABOUT TO BE SPLIT
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                CALL    UNDOSPL

                ; 3. TAIL -> WORKBUF2, HEAD TRUNCATED IN PLACE
                CALL    SPLITL

                ; 4. WRITE THE SHORTENED HEAD BACK
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 5. PUT THE TAIL IN THE RESERVED RECORD
                LD      A, (NRSEG)
                LD      DE, (NROFF)
                LD      HL, WORKBUF2
                CALL    PUTREC

                ; 6. OPEN A DIRECTORY SLOT AFTER THE CURRENT LINE AND FILL IT
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. ADVANCE TO NEW LINE
                XOR     A
                LD      (CURX), A

                LD      HL, (DOCLINE)
                INC     HL
                LD      (DOCLINE), HL

                LD      A, (CURY)
                CP      ROWSVIS - 1
                JR      Z, .NWATBOT

                ; NOT AT BOTTOM: CURY INCREMENTS
                INC     A
                LD      (CURY), A
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .NWDONE
                LD      A, (CURY)
                INC     A
                LD      B, A            ; B = SCREEN ROW OF NEW LINE
                PUSH    BC
                CALL    SHIFTDN
                POP     BC

                ; RENDER SHORTENED HEAD (ROW B - 1)
                DEC     B
                CALL    RENDEROW

                ; RENDER NEW LINE (ROW B)
                INC     B
                CALL    RENDEROW
                JR      .NWDONE

.NWATBOT        ; AT BOTTOM OF SCREEN: THE VIEWPORT FOLLOWS THE NEW LINE. THE
                ; MOVE ITSELF IS BOOKKEEPING AND HAPPENS EVEN WHEN PAINTING IS
                ; HELD -- OTHERWISE THE DEFERRED REPAINT WOULD DRAW THE WRONG
                ; PART OF THE DOCUMENT.
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .NWDONE
                CALL    SCROLLDN

                ; RENDER SHORTENED HEAD (THE ROW ABOVE THE LAST VISIBLE ONE)
                LD      B, ROWSVIS - 1
                CALL    RENDEROW

.NWDONE         LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EFFCURX                   ----------------------------------------


; - EFFCURX ----------------------------
; - THE COLUMN THE CURSOR REALLY MEANS, FOR AN EDIT TAKEN AT THE CURSOR.
; - ON EVERY LINE BUT A FULL ONE, "AT THE END" IS CURX == LENGTH -- GETMAXC
; - LETS THE CURSOR PARK ONE PAST THE LAST CHARACTER.  A FULL LINE HAS NO
; - SUCH COLUMN, SO GETMAXC CLAMPS TO TEXTCOLS - 1 AND "AT THE END" AND "ON
; - THE LAST CHARACTER" BECOME THE SAME POSITION.  AN EDIT TAKEN AT THE
; - CLAMPED COLUMN THEREFORE LANDS ONE PLACE TOO EARLY: MEASURED, TYPING X
; - AT THE END OF A FULL LINE ENDING IN "HELLO" WRAPPED IT AS "HELLxO", AND
; - A SPACE AT THE MARGIN CARRIED THE "O" DOWN INSTEAD OF BREAKING AFTER IT.
; - IN:  WORKBUF = THE LINE THE EDIT IS TAKEN ON
; - OUT: A = CURX, OR TEXTCOLS WHEN THE LINE IS FULL AND THE CURSOR IS
; -      PARKED ON ITS LAST COLUMN
; - CLOBBERS: AF
; -

EFFCURX         LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JR      Z, .EFWTXT
                ; WRAP_DEV: THE CURSOR ALWAYS MEANS ITS EXACT COLUMN
                LD      A, (CURX)
                RET

.EFWTXT         LD      A, (WORKBUF)    ; LINE LENGTH
                CP      TEXTCOLS
                LD      A, (CURX)       ; DOES NOT TOUCH THE FLAGS
                RET     C               ; NOT FULL: THE CURSOR MEANS ITSELF
                CP      TEXTCOLS - 1
                RET     NZ              ; NOT PARKED AT THE MARGIN
                INC     A               ; A = TEXTCOLS: PAST THE LAST COLUMN
                RET


; --- SPLITL                    ----------------------------------------


; - SPLITL -----------------------------
; - SPLIT WORKBUF AT THE COLUMN THE CURSOR MEANS (SEE EFFCURX)
; - OUT: WORKBUF2 = THE TAIL AS A COMPLETE LINE RECORD
; -      WORKBUF  = TRUNCATED TO THAT MANY CHARACTERS
; - CLOBBERS: ALL
; -

SPLITL          CALL    EFFCURX


; - SPLITLA ----------------------------
; - SPLIT WORKBUF AT AN EXPLICIT COLUMN
; - IN:  A = SPLIT COLUMN (0..MAXCOLS)
; - OUT: WORKBUF2 = THE TAIL AS A COMPLETE LINE RECORD
; -      WORKBUF  = TRUNCATED TO A CHARACTERS
; - CLOBBERS: ALL
; -

SPLITLA         LD      (SPLCOL), A
                LD      HL, WORKBUF2
                CALL    RECBLNK         ; BLANK RECORD: LEN 0, SPACES, ATTRS 0

                ; TAIL LENGTH = MAX(LEN - SPLIT COLUMN, 0)
                LD      A, (WORKBUF)
                LD      HL, SPLCOL
                SUB     (HL)
                JR      NC, .LENOK
                XOR     A               ; THE SPLIT SITS PAST THE END OF THE TEXT
.LENOK          LD      (WORKBUF2), A
                LD      B, A
                AND     A
                JR      Z, .TRUNC       ; NOTHING TO CARRY OVER

                LD      C, B
                LD      B, 0            ; BC = BYTES TO MOVE

                ; TEXT HALF
                LD      A, (SPLCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      DE, WORKBUF2 + 1
                PUSH    BC
                LDIR
                POP     BC

                ; ATTRIBUTE HALF
                LD      A, (SPLCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      DE, WORKBUF2 + 1 + WORKATTR
                LDIR

.TRUNC          ; HEAD KEEPS SPLCOL CHARACTERS; BLANK WHAT IS LEFT OF IT
                LD      A, (SPLCOL)
                LD      (WORKBUF), A
                LD      E, A
                LD      D, 0
                LD      A, MAXCOLS
                SUB     E
                RET     Z               ; THE SPLIT WAS AT THE RECORD END
                LD      B, A

                PUSH    BC
                PUSH    DE
                LD      HL, WORKBUF + 1
                ADD     HL, DE
.BLNKLP         LD      (HL), ' '
                INC     HL
                DJNZ    .BLNKLP
                POP     DE
                POP     BC

                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
.ZATTLP         LD      (HL), 0
                INC     HL
                DJNZ    .ZATTLP
                RET


; --- EDMOVCHR                  ----------------------------------------


; - EDMOVCHR ---------------------------
; - MOVE CURSOR LEFT OR RIGHT ONE CHAR
; - IN:  A = CRIGHT OR CLEFT
; - OUT: NONE
; - CLOBBERS: AF
; -

EDMOVCHR        CP      CRIGHT
                JR      Z, .RIGHT
                
                ; CLEFT:
                LD      A, (CURX)
                OR      A
                JR      Z, .LEFT0
                DEC     A
                LD      (CURX), A
                RET

.LEFT0          LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; WRAP_DEV: STAY AT COL 0
                ; WRAP_TXT: WRAP TO PREVIOUS LINE
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; ALREADY AT LINE 0, CANNOT WRAP UP
                DEC     HL
                CALL    LINELEN         ; A = PREV LINE LENGTH (0..MAXCOLS)
                CALL    GETMAXC
                LD      (CURX), A
                LD      A, CUP
                JP      EDMOVROW
                
.RIGHT          LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LINE LENGTH (0..MAXCOLS)
                CALL    GETMAXC         ; A = MAX ALLOWED CURX
                LD      B, A            ; B = MAX CURX
                LD      A, (CURX)
                CP      B
                JR      NC, .RGTWRAP    ; AT OR BEYOND MAX COLUMN
                INC     A
                LD      (CURX), A
                RET

.RGTWRAP        LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; WRAP_DEV: STAY AT MAX COLUMN
                ; WRAP_TXT: WRAP TO NEXT LINE
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; AT LAST LINE, CANNOT WRAP DOWN
                XOR     A
                LD      (CURX), A
                LD      A, CDOWN
                JP      EDMOVROW


; --- GETMAXC                   ----------------------------------------


; - GETMAXC ----------------------------
; - CALCULATE MAXIMUM ALLOWED CURX FOR LINE
; - IN:  A = LINE LENGTH (0..MAXCOLS)
; - OUT: A = MAX CURX (0..MAXCOLS-1)
; - CLOBBERS: B
; -

GETMAXC         LD      B, A
                LD      A, (KMAPID)
                CP      3               ; 3 = VI PROFILE
                JR      NZ, .NOTVI
                LD      A, (VIMODE)
                OR      A
                JR      NZ, .NOTVI      ; 1 = VI INSERT MODE -> CAN APPEND AT LEN
                ; VI NORMAL MODE: CANNOT ADVANCE PAST LAST CHAR (LEN - 1)
                LD      A, B
                OR      A
                RET     Z               ; EMPTY LINE -> COL 0
                DEC     A
                JR      .CLAMP
.NOTVI          LD      A, B
.CLAMP          LD      B, A            ; B = CANDIDATE CURX
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JR      Z, .CLTXT
                ; WRAP_DEV: CLAMP TO MAXCOLS - 1
                LD      A, B
                CP      MAXCOLS
                RET     C
                LD      A, MAXCOLS - 1
                RET
.CLTXT          ; WRAP_TXT: CLAMP TO TEXTCOLS - 1
                LD      A, B
                CP      TEXTCOLS
                RET     C
                LD      A, TEXTCOLS - 1
                RET


; --- EDCLMPX                   ----------------------------------------


; - EDCLMPX ----------------------------
; - CLAMP CURX TO CURRENT DOCLINE LENGTH
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

EDCLMPX         LD      HL, (DOCLINE)
                CALL    LINELEN
                CALL    GETMAXC
                LD      B, A
                LD      A, (CURX)
                CP      B
                RET     C               ; CURX < MAX -> OK
                LD      A, B
                LD      (CURX), A
                RET


; --- EDMOVROW                  ----------------------------------------


; - EDMOVROW ---------------------------
; - MOVE CURSOR UP OR DOWN ONE ROW
; - IN:  A = CUP OR CDOWN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDMOVROW        CP      CDOWN
                JR      Z, .DOWN
                
                ; CUP:
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT TOP OF DOCUMENT
                DEC     HL
                LD      (DOCLINE), HL
                LD      A, (CURY)
                OR      A
                JR      Z, .SCRLUP
                DEC     A
                LD      (CURY), A
                RET
                
.SCRLUP         ; TOP ROW: THE MOVE SCROLLS. TAKE THE QUEUED REPEATS OF THE KEY
                ; (KEYRUN) AND SCROLL ONCE BY THE WHOLE COUNT. DOCLINE IS ALREADY
                ; ONE BACK, SO AT MOST DOCLINE MORE, CAPPED AT 200.
                LD      HL, (DOCLINE)
                LD      B, 200
                LD      A, H
                OR      A
                JR      NZ, .UPCAP
                LD      A, L
                CP      200
                JR      NC, .UPCAP
                LD      B, L
.UPCAP          LD      C, CUP
                CALL    KEYRUN          ; A = EXTRA ROWS
                LD      E, A
                LD      D, 0
                LD      HL, (DOCLINE)
                OR      A
                SBC     HL, DE
                LD      (DOCLINE), HL
                INC     E               ; E = ROWS IN ALL
                LD      HL, (TOPLINE)
                OR      A
                SBC     HL, DE
                LD      (TOPLINE), HL
                LD      A, E
                CP      ROWSVIS
                JP      NC, REDRAW      ; A PAGE OR MORE: NOTHING ON SCREEN SURVIVES
                LD      C, A
                JP      SCRLUPN
                
.DOWN           ; CDOWN:
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; AT BOTTOM OF DOCUMENT
                LD      (DOCLINE), HL
                LD      A, (CURY)
                CP      ROWSVIS - 1
                JR      Z, .SCRLDN
                INC     A
                LD      (CURY), A
                RET
                
.SCRLDN         ; BOTTOM ROW: THE MOVE SCROLLS. SAME AS .SCRLUP, DOWNWARDS.
                ; DOCLINE IS ALREADY ONE ON, SO AT MOST TOTLINES - 1 - DOCLINE MORE.
                LD      HL, (TOTLINES)
                DEC     HL
                LD      DE, (DOCLINE)
                OR      A
                SBC     HL, DE
                LD      B, 200
                LD      A, H
                OR      A
                JR      NZ, .DNCAP
                LD      A, L
                CP      200
                JR      NC, .DNCAP
                LD      B, L
.DNCAP          LD      C, CDOWN
                CALL    KEYRUN          ; A = EXTRA ROWS
                LD      E, A
                LD      D, 0
                LD      HL, (DOCLINE)
                ADD     HL, DE
                LD      (DOCLINE), HL
                INC     E               ; E = ROWS IN ALL
                LD      HL, (TOPLINE)
                ADD     HL, DE
                LD      (TOPLINE), HL
                LD      A, E
                CP      ROWSVIS
                JP      NC, REDRAW
                LD      C, A
                JP      SCRLDNN

