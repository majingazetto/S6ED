; **********************************************
; * CFG.Z8A - CONFIGURATION FILE (S6ED.CFG)    *
; * ACCEPTS KEY=VALUE WITH OPTIONAL WHITESPACE *
; * AROUND '=' (E.G. "TABWIDTH = 8").          *
; **********************************************


; --- CFGLOAD                   ----------------------------------------


; - CFGLOAD ----------------------------
; - LOAD S6ED.CFG IF PRESENT AND APPLY
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CFGLOAD         LD      HL, CFGNAME
                CALL    DSKOPEN
                RET     C               ; FILE NOT FOUND: USE DEFAULTS

                PUSH    AF              ; SAVE FILE HANDLE (DSKREAD CLOBBERS BC)
                LD      HL, 1024        ; READ UP TO 1024 BYTES INTO CLIPBUF
                LD      DE, CLIPBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      C, L
                LD      B, H            ; BC = BYTES READ
                POP     AF              ; A = FILE HANDLE
                PUSH    BC              ; KEEP BYTE COUNT ACROSS CLOSE
                CALL    DSKCLOSE
                POP     BC              ; BC = BYTES READ

                LD      A, B
                OR      C
                RET     Z               ; EMPTY FILE

                ; NULL-TERMINATE BUFFER
                LD      HL, CLIPBUF
                ADD     HL, BC
                LD      (HL), 0

                ; PARSE LINES FROM CLIPBUF
                LD      HL, CLIPBUF
.LINELP         LD      A, (HL)
                OR      A
                JP      Z, .CFGDON      ; END OF BUFFER: APPLY PALETTE IF DIRTY

                ; SKIP LEADING WHITESPACE / EMPTY LINES
                CP      ' '
                JR      Z, .NEXTCH
                CP      9               ; TAB
                JR      Z, .NEXTCH
                CP      13              ; CR
                JR      Z, .NEXTCH
                CP      10              ; LF
                JR      Z, .NEXTCH
                CP      ';'             ; COMMENT
                JP      Z, .SKPLIN
                CP      '#'             ; COMMENT
                JP      Z, .SKPLIN
                JR      .PARSLN

.NEXTCH         INC     HL
                JR      .LINELP

.PARSLN         ; CHECK "PROFILE"
                PUSH    HL
                LD      DE, KEYPROF
                CALL    STRPREF
                JR      NC, .NOTPRF
                CALL    CFGVAL          ; "PROFILE = ..." ALSO ACCEPTED
                JR      NC, .NOTPRF
                CALL    PARSPRF
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTPRF         POP     HL
                PUSH    HL
                LD      DE, KEYWRAP
                CALL    STRPREF
                JR      NC, .NOTWRP
                CALL    CFGVAL
                JR      NC, .NOTWRP
                CALL    PARSWRP
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTWRP         POP     HL
                PUSH    HL
                LD      DE, KEYMKUP
                CALL    STRPREF
                JR      NC, .NOTMKP
                CALL    CFGVAL
                JR      NC, .NOTMKP
                CALL    PARSMKP
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTMKP         POP     HL
                PUSH    HL
                LD      DE, KEYCLK
                CALL    STRPREF
                JR      NC, .NOTCLK
                CALL    CFGVAL
                JR      NC, .NOTCLK
                CALL    PARSCLK
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCLK         POP     HL
                PUSH    HL
                LD      DE, KEYTAB
                CALL    STRPREF
                JR      NC, .NOTTAB
                CALL    CFGVAL
                JR      NC, .NOTTAB
                CALL    PARSTAB
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTTAB         POP     HL
                PUSH    HL
                LD      DE, KEYEOL
                CALL    STRPREF
                JR      NC, .NOTEOL
                CALL    CFGVAL
                JR      NC, .NOTEOL
                CALL    PARSEOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTEOL         POP     HL
                PUSH    HL
                LD      DE, KEYALN
                CALL    STRPREF
                JR      NC, .NOTALN
                CALL    CFGVAL
                JR      NC, .NOTALN
                CALL    PARSALN
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTALN         POP     HL
                PUSH    HL
                LD      DE, KEYTHM
                CALL    STRPREF
                JR      NC, .NOTTHM
                CALL    CFGVAL
                JR      NC, .NOTTHM
                CALL    PARSTHM
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTTHM         POP     HL
                PUSH    HL
                LD      DE, KEYCBG
                CALL    STRPREF
                JR      NC, .NOTCBG
                CALL    CFGVAL
                JR      NC, .NOTCBG
                LD      C, 0            ; COLOR 0 = BG
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCBG         POP     HL
                PUSH    HL
                LD      DE, KEYCTX
                CALL    STRPREF
                JR      C, .ISCTX
                ; TRY ALIAS "COLOR_FG"
                POP     HL
                PUSH    HL
                LD      DE, KEYCFG
                CALL    STRPREF
                JR      NC, .NOTCTX
.ISCTX          CALL    CFGVAL
                JR      NC, .NOTCTX
                LD      C, 1            ; COLOR 1 = FG / TEXT
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCTX         POP     HL
                PUSH    HL
                LD      DE, KEYCUI
                CALL    STRPREF
                JR      NC, .NOTCUI
                CALL    CFGVAL
                JR      NC, .NOTCUI
                LD      C, 2            ; COLOR 2 = UI
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCUI         POP     HL
                PUSH    HL
                LD      DE, KEYCHI
                CALL    STRPREF
                JR      C, .ISCHI
                ; TRY ALIAS "COLOR_HI"
                POP     HL
                PUSH    HL
                LD      DE, KEYCHIS
                CALL    STRPREF
                JR      NC, .NOTCHI
.ISCHI          CALL    CFGVAL
                JR      NC, .NOTCHI
                LD      C, 3            ; COLOR 3 = HIGHLIGHT
                CALL    PARSCOL
                POP     HL              ; RESTORE HL TO START OF LINE
                JP      .SKPLIN

.NOTCHI         POP     HL

.SKPLIN         ; ADVANCE HL TO END OF CURRENT LINE (CR, LF, OR 0)
                LD      A, (HL)
                OR      A
                JR      Z, .CFGDON
                CP      13
                JR      Z, .EOLS
                CP      10
                JR      Z, .EOLS
                INC     HL
                JR      .SKPLIN

.EOLS           ; SKIP CR/LF CHARACTERS
                INC     HL
                LD      A, (HL)
                CP      10
                JR      Z, .EOLS
                CP      13
                JR      Z, .EOLS
                JP      .LINELP

.CFGDON         LD      A, (PALDIRT)
                OR      A
                RET     Z
                LD      HL, PALDATA
                JP      SETPAL


; --- STRPREF                   ----------------------------------------


; - STRPREF ----------------------------
; - MATCH NULL-TERMINATED PREFIX AT HL
; - IN:  HL = INPUT STRING
; -      DE = PREFIX STRING (ASCIIZ)
; - OUT: CY = 1 IF MATCH, HL ADVANCED PAST PREFIX
; -      CY = 0 IF NO MATCH
; - CLOBBERS: A, B, DE
; -

STRPREF         LD      A, (DE)
                OR      A
                JR      Z, .MATCH
                LD      B, A
                LD      A, (HL)
                CP      B
                JR      NZ, .NOMTCH
                INC     HL
                INC     DE
                JR      STRPREF
.MATCH          SCF
                RET
.NOMTCH         XOR     A
                RET


; --- CFGVAL                    ----------------------------------------


; - CFGVAL -----------------------------
; - AFTER A KEY PREFIX MATCH: SKIP
; - WHITESPACE, REQUIRE '=', THEN SKIP
; - WHITESPACE AGAIN
; - IN:  HL = POSITION AFTER KEY
; - OUT: CY = 1: HL = START OF VALUE
; -      CY = 0: NOT A KEY ASSIGNMENT
; - CLOBBERS: A, HL
; -

CFGVAL          ; SKIP WHITESPACE BEFORE '='
.PRE            LD      A, (HL)
                CP      ' '
                JR      Z, .PRE1
                CP      9               ; TAB
                JR      NZ, .EQ
.PRE1           INC     HL
                JR      .PRE

.EQ             CP      '='
                JR      NZ, .NO
                INC     HL

.POST           ; SKIP WHITESPACE AFTER '='
                LD      A, (HL)
                CP      ' '
                JR      Z, .POST1
                CP      9               ; TAB
                JR      NZ, .YES
.POST1          INC     HL
                JR      .POST

.YES            SCF
                RET
.NO             XOR     A
                RET


; --- PARSPRF                   ----------------------------------------


; - PARSPRF ----------------------------
; - PARSE PROFILE VALUE (STD, WS, EMC, VI)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSPRF         LD      A, (HL)
                CP      'S'             ; STD
                JR      Z, .SETSTD
                CP      's'
                JR      Z, .SETSTD
                CP      'W'             ; WS
                JR      Z, .SETWS
                CP      'w'
                JR      Z, .SETWS
                CP      'E'             ; EMC
                JR      Z, .SETEMC
                CP      'e'
                JR      Z, .SETEMC
                CP      'V'             ; VI
                JR      Z, .SETVI
                CP      'v'
                JR      Z, .SETVI
                RET
.SETSTD         XOR     A
                JR      .SETPRF
.SETWS          LD      A, 1
                JR      .SETPRF
.SETEMC         LD      A, 2
                JR      .SETPRF
.SETVI          LD      A, 3
.SETPRF         LD      (KMAPID), A
                JP      KMAPSW


; --- PARSWRP                   ----------------------------------------


; - PARSWRP ----------------------------
; - PARSE WRAP VALUE (DEV, TXT)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSWRP         LD      A, (HL)
                CP      'D'             ; DEV
                JR      Z, .SETDEV
                CP      'd'
                JR      Z, .SETDEV
                CP      'T'             ; TXT
                JR      Z, .SETTXT
                CP      't'
                JR      Z, .SETTXT
                RET
.SETDEV         XOR     A
                LD      (WRAPMODE), A
                RET
.SETTXT         LD      A, 1
                LD      (WRAPMODE), A
                RET


; --- PARSMKP                   ----------------------------------------


; - PARSMKP ----------------------------
; - PARSE MARKUP VALUE (OFF, MD, LIT)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSMKP         LD      A, (HL)
                CP      'O'             ; OFF
                JR      Z, .SETOFF
                CP      'o'
                JR      Z, .SETOFF
                CP      'M'             ; MD
                JR      Z, .SETMD
                CP      'm'
                JR      Z, .SETMD
                CP      'L'             ; LIT
                JR      Z, .SETLIT
                CP      'l'
                JR      Z, .SETLIT
                RET
.SETOFF         XOR     A
                LD      (MKUPMD), A
                RET
.SETMD          LD      A, 1
                LD      (MKUPMD), A
                RET
.SETLIT         LD      A, 2
                LD      (MKUPMD), A
                RET


; --- PARSCLK                   ----------------------------------------


; - PARSCLK ----------------------------
; - PARSE CLOCK VALUE (0, 1)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSCLK         LD      A, (HL)
                CP      '1'
                JR      Z, .CLKON
                CP      '0'
                JR      Z, .CLKOFF
                RET
.CLKON          LD      A, 1
                LD      (SHOWCLK), A
                RET
.CLKOFF         XOR     A
                LD      (SHOWCLK), A
                RET


; --- PARSTAB                   ----------------------------------------


; - PARSTAB ----------------------------
; - PARSE TABWIDTH VALUE (2, 4, 8)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSTAB         LD      A, (HL)
                CP      '2'
                JR      Z, .TAB2
                CP      '4'
                JR      Z, .TAB4
                CP      '8'
                JR      Z, .TAB8
                RET
.TAB2           LD      A, 2
                LD      (TABWIDTH), A
                RET
.TAB4           LD      A, 4
                LD      (TABWIDTH), A
                RET
.TAB8           LD      A, 8
                LD      (TABWIDTH), A
                RET


; --- PARSEOL                   ----------------------------------------


; - PARSEOL ----------------------------
; - PARSE EOL VALUE (AUTO, DOS, UNIX)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSEOL         LD      A, (HL)
                CP      'A'             ; AUTO
                JR      Z, .EOLAUT
                CP      'a'
                JR      Z, .EOLAUT
                CP      'D'             ; DOS
                JR      Z, .EOLDOS
                CP      'd'
                JR      Z, .EOLDOS
                CP      'U'             ; UNIX
                JR      Z, .EOLUNX
                CP      'u'
                JR      Z, .EOLUNX
                RET
.EOLAUT         LD      A, 1
                LD      (AUTOLOD), A
                RET
.EOLDOS         XOR     A
                LD      (SAVEEOL), A
                LD      (AUTOLOD), A    ; FIXED DOS
                RET
.EOLUNX         LD      A, 1
                LD      (SAVEEOL), A
                XOR     A
                LD      (AUTOLOD), A    ; FIXED UNIX
                RET


; --- PARSALN                   ----------------------------------------


; - PARSALN ----------------------------
; - PARSE AUTOALIGN VALUE (OFF, ON, DEV)
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: AF
; -

PARSALN         LD      A, (HL)
                CP      'O'             ; ON
                JR      Z, .SETON
                CP      'o'
                JR      Z, .SETON
                CP      'F'             ; OFF
                JR      Z, .SETOFF
                CP      'f'
                JR      Z, .SETOFF
                CP      'D'             ; DEV
                JR      Z, .SETDEV
                CP      'd'
                JR      Z, .SETDEV
                RET
.SETOFF         XOR     A               ; ALGN_OFF = 0
                LD      (AUTOALIGN), A
                RET
.SETON          LD      A, ALGN_ON
                LD      (AUTOALIGN), A
                RET
.SETDEV         LD      A, ALGN_DEV
                LD      (AUTOALIGN), A
                RET


; --- PARSTHM                   ----------------------------------------


; - PARSTHM ----------------------------
; - PARSE THEME NAME AND LOAD PALDATA
; - IN:  HL = POINTER TO VALUE
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSTHM         LD      A, (HL)
                CP      'D'             ; DEFAULT
                JR      Z, .THMDEF
                CP      'd'
                JR      Z, .THMDEF
                CP      'A'             ; AMBER
                JR      Z, .THMAMB
                CP      'a'
                JR      Z, .THMAMB
                CP      'G'             ; GREEN
                JR      Z, .THMGRN
                CP      'g'
                JR      Z, .THMGRN
                CP      'L'             ; LIGHT
                JR      Z, .THMLGT
                CP      'l'
                JR      Z, .THMLGT
                CP      'M'             ; MSX OR MONO
                JR      Z, .CHKM
                CP      'm'
                JR      Z, .CHKM
                RET

.CHKM           INC     HL
                LD      A, (HL)
                CP      'O'             ; MONO
                JR      Z, .THMMON
                CP      'o'
                JR      Z, .THMMON
                JR      .THMMSX         ; DEFAULT 'M' TO MSX

.THMDEF         LD      HL, THMDEFT
                JR      .CPYTHM
.THMAMB         LD      HL, THMAMBR
                JR      .CPYTHM
.THMGRN         LD      HL, THMGRN
                JR      .CPYTHM
.THMLGT         LD      HL, THMLGHT
                JR      .CPYTHM
.THMMON         LD      HL, THMMONO
                JR      .CPYTHM
.THMMSX         LD      HL, THMMSX

.CPYTHM         LD      DE, PALDATA
                LD      BC, 8
                LDIR
                LD      A, #FF
                LD      (PALDIRT), A
                RET


; --- PARSCOL                   ----------------------------------------


; - PARSCOL ----------------------------
; - PARSE R,G,B (0-7) AND STORE IN PALDATA
; - IN:  HL = POINTER TO "R,G,B" VALUE
; -      C  = COLOR INDEX (0-3)
; - OUT: NONE
; - CLOBBERS: ALL
; -

PARSCOL         PUSH    BC              ; SAVE COLOR INDEX IN C
                CALL    GETNUM          ; GET R (0-7)
                JR      NC, .POPABT
                LD      D, A            ; D = R
                CALL    SKPCOM          ; SKIP COMMA
                JR      NC, .POPABT
                CALL    GETNUM          ; GET G (0-7)
                JR      NC, .POPABT
                LD      E, A            ; E = G
                CALL    SKPCOM          ; SKIP COMMA
                JR      NC, .POPABT
                CALL    GETNUM          ; GET B (0-7)
                JR      NC, .POPABT
                ; D = R, E = G, A = B
                ; VDP FORMAT: BYTE 1 = (R << 4) | B, BYTE 2 = G
                SLA     D
                SLA     D
                SLA     D
                SLA     D               ; D = R << 4
                OR      D               ; A = (R << 4) | B
                POP     BC              ; C = COLOR INDEX
                PUSH    AF              ; SAVE BYTE 1
                LD      B, 0
                SLA     C               ; C = COLOR * 2
                LD      HL, PALDATA
                ADD     HL, BC          ; HL = PALDATA + COLOR * 2
                POP     AF              ; RESTORE BYTE 1
                LD      (HL), A         ; WRITE BYTE 1
                INC     HL
                LD      (HL), E         ; WRITE BYTE 2 (G)
                LD      A, #FF
                LD      (PALDIRT), A
                RET

.POPABT         POP     BC              ; RESTORE STACK ON ERROR
                RET


; --- GETNUM                    ----------------------------------------


; - GETNUM -----------------------------
; - SKIP SPACES, READ DIGIT 0-7, ADVANCE HL
; - IN:  HL = STRING POINTER
; - OUT: CY = 1: A = VALUE (0-7), HL ADVANCED PAST DIGIT
; -      CY = 0: INVALID
; - CLOBBERS: AF, HL
; -

GETNUM          LD      A, (HL)
                CP      ' '
                JR      Z, .SKP
                CP      9               ; TAB
                JR      NZ, .CHK
.SKP            INC     HL
                JR      GETNUM
.CHK            CP      '0'
                JR      C, .ERR
                CP      '8'
                JR      NC, .ERR
                SUB     '0'             ; A = 0..7
                INC     HL              ; ADVANCE PAST DIGIT
                SCF                     ; SUCCESS
                RET
.ERR            XOR     A               ; CY = 0 -> ERROR
                RET


; --- SKPCOM                    ----------------------------------------


; - SKPCOM -----------------------------
; - SKIP SPACES, EXPECT ',', SKIP SPACES
; - IN:  HL = STRING POINTER
; - OUT: CY = 1: SUCCESS, HL PAST COMMA AND SPACES
; -      CY = 0: COMMA NOT FOUND
; - CLOBBERS: AF, HL
; -

SKPCOM          LD      A, (HL)
                CP      ' '
                JR      Z, .S1
                CP      9               ; TAB
                JR      NZ, .CHK
.S1             INC     HL
                JR      SKPCOM
.CHK            CP      ','
                JR      NZ, .NOCOM
                INC     HL              ; PAST COMMA
.S2             LD      A, (HL)
                CP      ' '
                JR      Z, .S3
                CP      9               ; TAB
                JR      NZ, .OK
.S3             INC     HL
                JR      .S2
.OK             SCF
                RET
.NOCOM          XOR     A               ; CY = 0 -> NOT FOUND
                RET


; --- CFG DATA                  ----------------------------------------


CFGNAME         DEFM    "S6ED.CFG", 0
KEYPROF         DEFM    "PROFILE", 0
KEYWRAP         DEFM    "WRAP", 0
KEYMKUP         DEFM    "MARKUP", 0
KEYCLK          DEFM    "CLOCK", 0
KEYTAB          DEFM    "TABWIDTH", 0
KEYEOL          DEFM    "EOL", 0
KEYALN          DEFM    "AUTOALIGN", 0
KEYTHM          DEFM    "THEME", 0
KEYCBG          DEFM    "COLOR_BG", 0
KEYCTX          DEFM    "COLOR_TEXT", 0
KEYCFG          DEFM    "COLOR_FG", 0
KEYCUI          DEFM    "COLOR_UI", 0
KEYCHI          DEFM    "COLOR_HIGHLIGHT", 0
KEYCHIS         DEFM    "COLOR_HI", 0


; --- THEMES                    ----------------------------------------

                ; 8 BYTES EACH: 4 COLORS * 2 BYTES (V9938 FORMAT)
                ; BYTE 1: (R << 4) | B,  BYTE 2: G
THMDEFT         DEFB    #00, #00, #77, #07, #17, #02, #70, #07
THMAMBR         DEFB    #00, #00, #70, #04, #20, #01, #70, #06
THMGRN          DEFB    #00, #00, #11, #07, #00, #02, #40, #07
THMMSX          DEFB    #15, #01, #77, #07, #27, #04, #70, #07
THMLGHT         DEFB    #77, #07, #00, #00, #55, #05, #06, #02
THMMONO         DEFB    #00, #00, #77, #07, #44, #04, #77, #07
