;                                       ****************************************
;                                       * RENDERER                             *
;                                       ****************************************


; --- REDRAW                    ----------------------------------------

; - REDRAW -----------
; - REDRAW ALL TEXT ROWS (TXRFIRST TO TXRLAST)
; -

REDRAW          LD      B, TXRFIRST
.ROWLOOP        PUSH    BC
                CALL    RENDEROW
                POP     BC
                INC     B
                LD      A, B
                CP      TXRLAST + 1
                JR      NZ, .ROWLOOP
                RET


; --- RENDEROW                  ----------------------------------------

; - RENDEROW ---------
; - RENDER A SINGLE ROW (1-24) TO VRAM
; - B: ROW NUMBER (SCREEN SPACE)
; -

RENDEROW        PUSH    BC
                
                ; 1. CALC DOC LINE: HL = TOPLINE + B - 1
                LD      HL, (TOPLINE)
                LD      A, B
                SUB     TXRFIRST
                LD      E, A
                LD      D, 0
                ADD     HL, DE
                
                ; CHECK IF HL < TOTLINES
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .VALID
                
                ; IF NOT VALID (BEYOND EOF), CLEAR ROW
                CALL    CLRROW
                POP     BC
                RET

.VALID          CALL    LINEREAD        ; LOAD RECORD INTO WORKBUF
                CALL    SCANMKUP        ; DYNAMICALLY HIGHLIGHT MARKUP ON LINE
                POP     BC
                PUSH    BC

                ; 2. CALC SCREEN DY (ROW * 8)
                LD      A, B
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL

                ; 3. RENDER COLS 0-79
                LD      C, 0            ; COL COUNTER (0..79)
.COLLOOP        PUSH    BC              ; PRESERVE B=ROW, C=COL
                
                ; 4. CALC SCREEN DX (GUTL_PX + COL * 6)
                LD      A, C
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                LD      D, H
                LD      E, L
                ADD     HL, HL          ; * 4
                ADD     HL, DE          ; * 6
                LD      DE, GUTL_PX
                ADD     HL, DE
                LD      (VDP_DX), HL

                ; 5. GET CHAR AND ATTR FROM WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)         ; A = CHARCODE
                PUSH    AF

                ; GET ATTRIBUTE & VARIANT BASE SY
                LD      DE, TEXTCOLS
                ADD     HL, DE          ; HL = WORKBUF + 1 + TEXTCOLS + C
                LD      A, (HL)
                AND     ATRFMSK         ; 0=NORM, 1=BOLD, 2=ITAL, 3=BI
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                LD      DE, .SYTBL
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)         ; DE = BASE SY (256, 320, 384, 448)

                ; 6. CALC FONT SX/SY
                ; SX = (CHAR & 31) * 8
                POP     AF              ; RESTORE CHARCODE
                PUSH    AF
                AND     %00011111       ; CHAR & 31
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                ADD     HL, HL          ; * 8
                LD      (VDP_SX), HL

                ; SY = BASE_SY + (CHAR >> 5) * 8
                POP     AF
                SRL     A
                SRL     A
                SRL     A
                SRL     A
                SRL     A               ; CHAR >> 5 (0..7)
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; * 8
                LD      L, A
                LD      H, 0
                ADD     HL, DE          ; + BASE SY
                LD      (VDP_SY), HL

                ; 7. ISSUE LMMM
                LD      HL, 6           ; NX = 6 DOTS
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8 DOTS (16-BIT)
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A
                
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMM | VDP_IMP
                CALL    LMMM

                POP     BC              ; RESTORE B=ROW, C=COL
                INC     C
                LD      A, C
                CP      TEXTCOLS        ; 80
                JR      NZ, .COLLOOP
                
                POP     BC
                RET

.SYTBL          DEFW    FNORM_SY        ; 256 (NORMAL)
                DEFW    FBOLD_SY        ; 320 (BOLD)
                DEFW    FITAL_SY        ; 384 (ITALIC)
                DEFW    FBI_SY          ; 448 (BOLD+ITALIC)


; --- CLRROW                    ----------------------------------------


; - CLRROW -----------------------------
; - CLEAR ROW B WITH BACKGROUND COLOR
; - IN:  B = SCREEN ROW (1..24)
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

CLRROW          LD      A, B
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL
                
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                
                LD      HL, GUTL_PX
                LD      (VDP_DX), HL
                
                LD      HL, TXAREAPX
                LD      (VDP_NX), HL
                
                LD      HL, 8           ; NY = 8 (16-BIT)
                LD      (VDP_NY), HL
                
                LD      A, CLR_BG
                LD      (VDP_CLR), A
                
                XOR     A
                LD      (VDP_ARG), A
                
                LD      HL, VDPCMBLK
                CALL    HMMV
                RET

