;                                       ****************************************
;                                       * UI — STATUS BAR / GUTTERS / CURSOR  *
;                                       ****************************************


; --- DRWSTAT                ----------------------------------------

; - DRWSTAT -------
; - DRAW / REFRESH STATUS BAR (ROW 25)
; - FORMAT: " LANG | INS | LN:NNNNN/NNNNN  COL:NNN | FILENAME"
; -

; --- DRWSTAT                ----------------------------------------


; --- DRWSTAT                ----------------------------------------


; - DRWSTAT ----------------------------
; - DRAW / REFRESH STATUS BAR (ROW 25)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWSTAT         LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      HL, 200         ; DY = ROW 25 * 8
                LD      (VDP_DY), HL
                LD      HL, 512         ; NX
                LD      (VDP_NX), HL
                LD      HL, 12          ; NY
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                ; FORMAT STATUS STRING IN STATBUF
                CALL    BLDSTAT

                ; PRINT STATUS TEXT
                LD      HL, STATBUF
                LD      DE, 6           ; DX = 6
                LD      BC, 202         ; DY = 202
                CALL    BLTSTR
                RET


; - BLDSTAT ----------------------------
; - BUILD DYNAMIC STATUS BAR TEXT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLDSTAT         LD      DE, STATBUF

                ; 1. PROFILE TAG: [STD], [WS ], [EMC], [VI-N], [VI-I]
                LD      A, (KMAPID)
                OR      A
                JR      NZ, .NOTSTDP
                LD      HL, .STRSTD
                CALL    .CPYSTR
                JR      .DONEKMAP
.NOTSTDP        CP      KMWS
                JR      NZ, .NOTWSP
                LD      HL, .STRWS
                CALL    .CPYSTR
                JR      .DONEKMAP
.NOTWSP         CP      KMEMACS
                JR      NZ, .NOTEMCP
                LD      HL, .STREMC
                CALL    .CPYSTR
                JR      .DONEKMAP
.NOTEMCP        ; VI PROFILE
                LD      A, (VIMODE)
                CP      VIMNORM
                JR      NZ, .VIINSP
                LD      HL, .STRVIN
                CALL    .CPYSTR
                JR      .DONEKMAP
.VIINSP         LD      HL, .STRVII
                CALL    .CPYSTR

.DONEKMAP       ; 2. WRAP MODE
                LD      A, (WRAPMODE)
                CP      WRAP_DEV
                JR      NZ, .WRTXT
                LD      HL, .STRWDEV
                CALL    .CPYSTR
                JR      .DONEWRAP
.WRTXT          LD      HL, .STRWTXT
                CALL    .CPYSTR

.DONEWRAP       ; 3. INSERT / OVERWRITE
                LD      A, (INSMODE)
                CP      INS_MODE
                JR      NZ, .OVRP
                LD      HL, .STRINS
                CALL    .CPYSTR
                JR      .DONEINS
.OVRP           LD      HL, .STROVR
                CALL    .CPYSTR

.DONEINS        ; 4. TYPING STYLE INDICATOR
                LD      A, (TYPATTR)
                AND     ATRFMSK
                JR      Z, .NOTSTYL
                CP      1
                JR      NZ, .NOTB
                LD      HL, .STRBD
                CALL    .CPYSTR
                JR      .NOTSTYL
.NOTB           CP      2
                JR      NZ, .NOTIT
                LD      HL, .STRIT
                CALL    .CPYSTR
                JR      .NOTSTYL
.NOTIT          LD      HL, .STRBI
                CALL    .CPYSTR

.NOTSTYL        ; 5. MARKUP MODE INDICATOR
                LD      A, (MKUPMD)
                OR      A
                JR      Z, .NOTMKUP
                CP      MKUP_MD
                JR      NZ, .ISLIT
                LD      HL, .STRMD
                CALL    .CPYSTR
                JR      .NOTMKUP
.ISLIT          LD      HL, .STRLIT
                CALL    .CPYSTR

.NOTMKUP        ; 6. SELECTION INDICATOR
                LD      A, (SELACT)
                OR      A
                JR      Z, .NOTSEL
                LD      HL, .STRSEL
                CALL    .CPYSTR
.NOTSEL         ; 7. MODIFIED INDICATOR
                LD      A, (MODIFIED)
                OR      A
                JR      Z, .NOTMOD
                LD      A, '*'
                LD      (DE), A
                INC     DE
                LD      A, ' '
                LD      (DE), A
                INC     DE
                JR      .DONEMOD
.NOTMOD         LD      A, ' '
                LD      (DE), A
                INC     DE
                LD      (DE), A
                INC     DE

.DONEMOD        ; 6. "Ln " + (DOCLINE + 1)
                LD      HL, .STRLN
                CALL    .CPYSTR
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    DE
                CALL    B2D16
                EX      DE, HL          ; HL = STRING
                POP     DE
                CALL    .CPYSTR

                ; " Col " + (CURX + 1)
                LD      HL, .STRCOL
                CALL    .CPYSTR
                LD      A, (CURX)
                INC     A
                PUSH    DE
                CALL    B2D8
                EX      DE, HL
                POP     DE
                CALL    .CPYSTR

                ; " | "
                LD      HL, .STRSEP
                CALL    .CPYSTR

                ; FILENAME
                LD      HL, FILENAME
                CALL    .CPYSTR

                ; TERMINATING NULL
                XOR     A
                LD      (DE), A
                RET

.CPYSTR         LD      A, (HL)
                OR      A
                RET     Z
                LD      (DE), A
                INC     HL
                INC     DE
                JR      .CPYSTR

.STRSTD         DEFM    "[STD] ", 0
.STRWS          DEFM    "[WS]  ", 0
.STREMC         DEFM    "[EMC] ", 0
.STRVIN         DEFM    "[VI-N]", 0
.STRVII         DEFM    "[VI-I]", 0
.STRWDEV        DEFM    " [DEV]", 0
.STRWTXT        DEFM    " [TXT]", 0
.STRINS         DEFM    " [INS] ", 0
.STROVR         DEFM    " [OVR] ", 0
.STRBD          DEFM    "[B] ", 0
.STRIT          DEFM    "[I] ", 0
.STRBI          DEFM    "[BI] ", 0
.STRMD          DEFM    "[MD] ", 0
.STRLIT         DEFM    "[LIT] ", 0
.STRSEL         DEFM    "[SEL] ", 0
.STRLN          DEFM    "Ln ", 0
.STRCOL         DEFM    " Col ", 0
.STRSEP         DEFM    " | ", 0


; --- DRWMENU               ----------------------------------------


; - DRWMENU ----------------------------
; - DRAW MENU BAR (ROW 0, ALWAYS VISIBLE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWMENU         LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      (VDP_DY), HL    ; DY = 0
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                ; PRINT MENU TEXT
                LD      HL, MNUTEXT
                LD      DE, 6           ; DX = 6
                LD      BC, 0           ; DY = 0
                CALL    BLTSTR
                RET

MNUTEXT         DEFM    "S6ED v0.1 | [F1] Help  [F2] Save  [ESC] Quit", 0


; --- DRWGUT                ----------------------------------------


; - DRWGUT -----------------------------
; - REDRAW LEFT AND RIGHT GUTTERS
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWGUT          ; LEFT GUTTER (LINE NUMBERS BACKGROUND)
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL    ; DX = 0
                LD      HL, 8
                LD      (VDP_DY), HL    ; DY = 8 (SKIP MENU ROW)
                LD      HL, GUTL_PX     ; NX = 24
                LD      (VDP_NX), HL
                LD      HL, 192         ; NY = 24 ROWS * 8 = 192
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                ; RIGHT GUTTER (SCROLLBAR TRACK)
                LD      HL, 512 - GUTR_PX ; DX = 504
                LD      (VDP_DX), HL
                LD      HL, 8
                LD      (VDP_DY), HL    ; DY = 8
                LD      HL, GUTR_PX     ; NX = 8
                LD      (VDP_NX), HL
                LD      HL, 192         ; NY = 192
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                CALL    DRWLNUM

                ; THE FILL ABOVE WIPED THE THUMB, SO THE CACHE IS STALE
                XOR     A
                LD      (THMBY), A
                CALL    DRWSCRL
                RET



; --- DRWLNUM               ----------------------------------------


; - DRWLNUM ----------------------------
; - DRAW LINE NUMBERS IN LEFT GUTTER
; - IN:  NONE (USES TOPLINE, TOTLINES)
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWLNUM         LD      B, TXRFIRST     ; ROW 1
.LNUMLP         PUSH    BC
                CALL    DRWLNRW
                POP     BC
                INC     B
                LD      A, B
                CP      TXRLAST + 1
                JR      NZ, .LNUMLP
                RET


; - DRWLN1 -----------------------------
; - CLEAR ONE GUTTER CELL AND DRAW ITS LINE NUMBER
; - IN:  B = SCREEN ROW (1..24)
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - THE SCROLL PATH NEEDS THIS ONE AND ONLY THIS ONE: THE SCROLL HMMM CARRIES
; - THE OTHER 23 NUMBERS WITH IT. THE CELL HAS TO BE CLEARED FIRST BECAUSE
; - BLTCHTR BLITS TRANSPARENTLY AND WOULD OTHERWISE OVERPRINT THE OLD DIGITS.
; - BEYOND EOF THE CLEARED CELL IS THE CORRECT RESULT, SO DRWLNRW DRAWS
; - NOTHING AND THE CELL STAYS BLANK.
; -

DRWLN1          PUSH    BC
                LD      A, B
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; DY = ROW * 8
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL    ; DX = 0
                LD      HL, GUTL_PX     ; NX = 24
                LD      (VDP_NX), HL
                LD      HL, CELLH       ; NY = 8
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV
                POP     BC
                JP      DRWLNRW         ; TAIL CALL


; - DRWLNRW ----------------------------
; - DRAW THE LINE NUMBER FOR ONE SCREEN ROW, WITHOUT CLEARING
; - IN:  B = SCREEN ROW (1..24)
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWLNRW         PUSH    BC
                ; CALC LINE = TOPLINE + B - 1
                LD      HL, (TOPLINE)
                LD      A, B
                SUB     TXRFIRST
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = DOCLINE (0-BASED)

                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      NC, .DONE       ; BEYOND EOF: DO NOT DRAW

                ; 1-BASED LINE NUMBER: HL = HL + 1
                INC     HL
                LD      DE, NUMBUF
                CALL    NUM2STR4        ; FILLS NUMBUF WITH 4 CHARACTERS

                ; BLIT DIGITS AT DX = 0, 6, 12, 18, DY = B * 8
                POP     BC
                PUSH    BC
                LD      A, B
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; B * 8
                LD      E, A
                LD      D, 0            ; DE = DY

                LD      A, (NUMBUF + 0)
                CP      ' '
                JR      NZ, .F4DIG

                ; 3 DIGITS OR LESS: DRAW AT DX = 0, 6, 12 LEAVING 18..23 AS BLUE MARGIN
                LD      A, (NUMBUF + 1)
                CP      ' '
                JR      Z, .D2
                LD      HL, 0
                CALL    BLTCHTR
.D2             LD      A, (NUMBUF + 2)
                CP      ' '
                JR      Z, .D3
                LD      HL, 6
                CALL    BLTCHTR
.D3             LD      A, (NUMBUF + 3)
                LD      HL, 12
                CALL    BLTCHTR
                JR      .DONE

.F4DIG          LD      HL, 0
                CALL    BLTCHTR
                LD      A, (NUMBUF + 1)
                LD      HL, 6
                CALL    BLTCHTR
                LD      A, (NUMBUF + 2)
                LD      HL, 12
                CALL    BLTCHTR
                LD      A, (NUMBUF + 3)
                LD      HL, 18
                CALL    BLTCHTR

.DONE           POP     BC
                RET


NUMBUF          DEFS    4


; - NUM2STR4 ---------------------------
; - CONVERT HL (0..9999) TO 4-CHAR RIGHT-ALIGNED STRING AT DE
; - IN:  HL = NUMBER
; -      DE = 4-BYTE BUFFER
; - OUT: BUFFER AT DE FILLED
; - CLOBBERS: AF, BC, DE, HL
; -

NUM2STR4        LD      BC, 1000
                CALL    .DIVDIG
                LD      BC, 100
                CALL    .DIVDIG
                LD      BC, 10
                CALL    .DIVDIG
                LD      A, L
                ADD     A, '0'
                LD      (DE), A
                ; REPLACE LEADING '0' WITH ' ' (UP TO 3 DIGITS)
                DEC     DE
                DEC     DE
                DEC     DE              ; DE -> DIGIT 0
                LD      A, (DE)
                CP      '0'
                RET     NZ
                LD      A, ' '
                LD      (DE), A
                INC     DE
                LD      A, (DE)
                CP      '0'
                RET     NZ
                LD      A, ' '
                LD      (DE), A
                INC     DE
                LD      A, (DE)
                CP      '0'
                RET     NZ
                LD      A, ' '
                LD      (DE), A
                RET

.DIVDIG         LD      A, '0' - 1
.SUBP           INC     A
                OR      A
                SBC     HL, BC
                JR      NC, .SUBP
                ADD     HL, BC
                LD      (DE), A
                INC     DE
                RET


; - BLTCHTR ----------------------------
; - BLIT CHARACTER WITH TIMP TRANSPARENCY
; - IN:  A  = ASCII CHAR
; -      HL = DX
; -      DE = DY
; - OUT: NONE
; - CLOBBERS: NONE
; -

BLTCHTR         PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                LD      (VDP_DX), HL
                EX      DE, HL
                LD      (VDP_DY), HL

                ; CALC FONT SX/SY
                LD      B, A            ; B = CHAR
                AND     %00011111       ; CHAR & 31
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                ADD     HL, HL          ; * 8
                LD      (VDP_SX), HL

                LD      A, B
                SRL     A
                SRL     A
                SRL     A
                SRL     A
                SRL     A               ; CHAR >> 5 (0..7)
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; * 8
                LD      L, A
                LD      H, 0
                LD      DE, FNORM_SY    ; 256
                ADD     HL, DE
                LD      (VDP_SY), HL

                LD      HL, 6           ; NX = 6
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMM | VDP_TIMP
                CALL    LMMM

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; - BLTSTR -----------------------------
; - BLIT ASCIIZ STRING WITH TIMP
; - IN:  HL = POINTER TO ASCIIZ STRING
; -      DE = DX
; -      BC = DY
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLTSTR          LD      A, (HL)
                OR      A
                RET     Z
                PUSH    HL
                PUSH    DE
                PUSH    BC
                EX      DE, HL          ; HL = DX
                LD      D, B
                LD      E, C            ; DE = DY
                CALL    BLTCHTR
                POP     BC
                POP     DE
                POP     HL
                INC     HL
                LD      A, 6
                ADD     A, E
                LD      E, A
                JR      NC, BLTSTR
                INC     D
                JR      BLTSTR


; --- DRWSCRL             ----------------------------------------


; - SCRLPOS ----------------------------
; - THUMB TOP Y FOR THE CURRENT VIEWPORT
; - IN:  NONE (USES TOPLINE, TOTLINES)
; - OUT: A = TOP Y IN PIXELS (THMTOP .. THMTOP + THMTRAV)
; - CLOBBERS: AF, BC, DE, HL
; -
; - Y = THMTOP + TOPLINE * THMTRAV / (TOTLINES - SCRROWS). THE DIVISOR IS
; - NORMALISED DOWN TO ONE BYTE FIRST, SHIFTING BOTH TERMS RIGHT TOGETHER:
; - THAT KEEPS THMTRAV * R INSIDE 16 BITS FOR MULT12 AND KEEPS DIV16 INSIDE
; - ITS SAFE RANGE. MEASURED COST OF THE SHIFT: AT MOST 2 PX OF THE 168 PX
; - TRAVEL, A QUARTER OF A CHARACTER.
; -

SCRLPOS         LD      HL, (TOTLINES)
                LD      DE, SCRROWS
                OR      A
                SBC     HL, DE
                JR      Z, .TOP         ; DOCUMENT FITS EXACTLY
                JR      C, .TOP         ; DOCUMENT IS SHORTER THAN THE VIEWPORT

                EX      DE, HL          ; DE = DIVISOR
                LD      HL, (TOPLINE)
                CALL    CMPHLDE         ; CY IF TOPLINE < DIVISOR
                JR      C, .NORM
                LD      A, THMTOP + THMTRAV
                RET                     ; AT OR PAST THE LAST PAGE: BOTTOM STOP

.NORM           LD      A, D            ; NORMALISE WHILE THE DIVISOR > 255
                OR      A
                JR      Z, .SCALE
                SRL     D
                RR      E
                SRL     H
                RR      L
                JR      .NORM

.SCALE          PUSH    DE              ; KEEP THE DIVISOR
                EX      DE, HL          ; DE = NUMERATOR
                LD      A, THMTRAV
                CALL    MULT12          ; HL = THMTRAV * NUMERATOR
                POP     DE
                CALL    DIV16           ; BC = QUOTIENT (0..THMTRAV)
                LD      A, C
                ADD     A, THMTOP
                RET

.TOP            LD      A, THMTOP
                RET


; - BARFILL ----------------------------
; - FILL ONE THUMB-SIZED CELL OF THE SCROLLBAR TRACK
; - IN:  A = TOP Y IN PIXELS
; -      C = FILL BYTE (CLR_UI ERASES, CLR_HI PAINTS)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

BARFILL         LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      HL, 512 - GUTR_PX ; DX = 504
                LD      (VDP_DX), HL
                LD      HL, GUTR_PX     ; NX = 8
                LD      (VDP_NX), HL
                LD      HL, THMH        ; NY = 24
                LD      (VDP_NY), HL
                LD      A, C
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                JP      HMMV            ; TAIL CALL


; - DRWSCRL ----------------------------
; - REFRESH THE SCROLLBAR THUMB IF IT HAS MOVED
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - COSTS NOTHING WHEN THE THUMB HAS NOT MOVED, WHICH IS THE COMMON CASE ON A
; - ONE LINE SCROLL OF A LONG DOCUMENT. DRWGUT ZEROES THMBY BEFORE CALLING,
; - BECAUSE ITS OWN GUTTER FILL ERASES THE THUMB.
; -

DRWSCRL         CALL    SCRLPOS         ; A = WANTED TOP Y
                LD      HL, THMBY
                CP      (HL)
                RET     Z               ; UNCHANGED: NOTHING TO REPAINT

                PUSH    AF              ; KEEP THE NEW POSITION
                LD      A, (HL)
                OR      A
                JR      Z, .PAINT       ; NOTHING ON SCREEN YET
                LD      C, CLR_UI       ; ERASE THE OLD THUMB
                CALL    BARFILL

.PAINT          POP     AF
                LD      (THMBY), A
                LD      C, CLR_HI
                JP      BARFILL         ; TAIL CALL


; --- DRWCUR                ----------------------------------------


; - DRWCUR -----------------------------
; - TOGGLE CURSOR XOR OVERLAY AT (CURX, CURY)
; - IN:  NONE (USES CURX, CURY)
; - OUT: NONE
; - CLOBBERS: NONE
; -

DRWCUR          PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                ; DX = GUTL_PX + CURX * 6
                LD      A, (CURX)
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                LD      D, H
                LD      E, L
                ADD     HL, HL          ; * 4
                ADD     HL, DE          ; * 6
                LD      DE, GUTL_PX
                ADD     HL, DE
                LD      (VDP_DX), HL

                ; DY = (CURY + 1) * 8
                LD      A, (CURY)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL

                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL

                LD      HL, CELLW       ; NX = 6
                LD      (VDP_NX), HL
                LD      HL, CELLH       ; NY = 8
                LD      (VDP_NY), HL

                LD      A, COL_HI       ; CLR = 3
                LD      (VDP_CLR), A

                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_XOR
                CALL    LMMV

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; --- TIMI HOOK (BLINK)         ----------------------------------------


; - BLNKTICK ---------------------------
; - BLINK TIMER HOOK STUB
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

BLNKTICK        RET

