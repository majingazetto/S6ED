;                                       ****************************************
;                                       * UI — STATUS BAR / GUTTERS / CURSOR  *
;                                       ****************************************


; --- DRWSTAT                   ----------------------------------------


; - DRWSTAT ----------------------------
; - DRAW / REFRESH THE STATUS BAR (ROW 25)
; - BUILDS THE TEXT (BLDSTAT) AND REPAINTS ONLY THE CELLS THAT DIFFER FROM
; - WHAT IS ON SCREEN (STATPRV), TWO COMMANDS EACH. A CURSOR MOVE THAT
; - CHANGES ONE DIGIT COSTS ~1 MS INSTEAD OF THE ~31 MS OF A FULL REBUILD,
; - WHICH IS WHAT LETS MAINLOOP CALL THIS AFTER EVERY KEY.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWSTAT         CALL    BLDSTAT         ; STATBUF = THE TEXT THE BAR SHOULD SHOW
                LD      A, (STATPRV)
                OR      A
                JR      Z, .FULL        ; NEVER PAINTED: FILL AND WRITE IT ALL

                ; DIFF AGAINST STATPRV, CELL BY CELL. DE = NEW TEXT (ASCIIZ),
                ; HL = OLD CELLS (80, SPACE PADDED), C = COLUMN, B = PAST THE END
                LD      DE, STATBUF
                LD      HL, STATPRV
                LD      BC, 0
.DLOOP          LD      A, B
                OR      A
                LD      A, ' '
                JR      NZ, .HAVE       ; PAST THE TERMINATOR: SPACES
                LD      A, (DE)
                OR      A
                JR      NZ, .HAVE
                INC     B               ; THE TERMINATOR: SPACES FROM HERE ON
                LD      A, ' '
.HAVE           CP      (HL)
                JR      Z, .SAME
                LD      (HL), A         ; THE CACHE FOLLOWS THE SCREEN
                PUSH    BC
                PUSH    DE
                PUSH    HL
                CALL    STATCEL
                POP     HL
                POP     DE
                POP     BC
.SAME           INC     HL
                INC     DE
                INC     C
                LD      A, C
                CP      TEXTCOLS
                JR      NZ, .DLOOP
                RET

.FULL           LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      HL, STBROW * CELLH ; DY = 200
                LD      (VDP_DY), HL
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 12
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                LD      HL, STATBUF
                LD      DE, STBTX_X
                LD      BC, STBTX_Y
                CALL    BLTSTR

                ; CACHE = STATBUF, SPACE PADDED TO 80 CELLS
                LD      HL, STATBUF
                LD      DE, STATPRV
                LD      BC, TEXTCOLS * 256 ; B = 80, C = 0 (PAST THE END FLAG)
.CLOOP          LD      A, C
                OR      A
                LD      A, ' '
                JR      NZ, .CPUT
                LD      A, (HL)
                OR      A
                JR      NZ, .CPUT
                INC     C
                LD      A, ' '
.CPUT           LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .CLOOP
                RET


; - STATCEL ----------------------------
; - REPAINT ONE STATUS BAR CELL: UI BACKGROUND, THEN THE GLYPH ON TOP
; - IN:  A = CHARACTER, C = COLUMN (0..79)
; - OUT: NONE
; - CLOBBERS: ALL
; -

STATCEL         PUSH    AF
                LD      L, C
                LD      H, 0
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                ADD     HL, HL          ; COLUMN * 6
                LD      DE, STBTX_X
                ADD     HL, DE
                LD      (VDP_DX), HL
                PUSH    HL
                LD      HL, STBTX_Y
                LD      (VDP_DY), HL
                LD      HL, CELLW
                LD      (VDP_NX), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV
                POP     HL              ; DX
                POP     AF
                CP      ' '
                RET     Z
                LD      DE, STBTX_Y
                JP      BLTCHTR         ; A = CHAR, HL = DX, DE = DY


; - BLDSTAT ----------------------------
; - BUILD DYNAMIC STATUS BAR TEXT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLDSTAT         LD      DE, STATBUF

                ; 1. PROFILE TAG: [STD], [WS ], [EMC], [VI-N], [VI-I]
                LD      A, (KMAPID)
                OR      A
                JR      NZ, .NOTSTDP
                LD      HL, .STRSTD
                CALL    .CPYSTR
                JR      .DONKMAP
.NOTSTDP        CP      KMWS
                JR      NZ, .NOTWSP
                LD      HL, .STRWS
                CALL    .CPYSTR
                JR      .DONKMAP
.NOTWSP         CP      KMEMACS
                JR      NZ, .NOTEMCP
                LD      HL, .STREMC
                CALL    .CPYSTR
                JR      .DONKMAP
.NOTEMCP        ; VI PROFILE
                LD      A, (VIMODE)
                CP      VIMNORM
                JR      NZ, .VIINSP
                LD      HL, .STRVIN
                CALL    .CPYSTR
                JR      .DONKMAP
.VIINSP         LD      HL, .STRVII
                CALL    .CPYSTR

.DONKMAP        ; 2. WRAP MODE
                LD      A, (WRAPMODE)
                CP      WRAP_DEV
                JR      NZ, .WRTXT
                LD      HL, .STRWDEV
                CALL    .CPYSTR
                JR      .DONWRAP
.WRTXT          LD      HL, .STRWTXT
                CALL    .CPYSTR

.DONWRAP        ; 3. INSERT / OVERWRITE
                LD      A, (INSMODE)
                CP      INS_MODE
                JR      NZ, .OVRP
                LD      HL, .STRINS
                CALL    .CPYSTR
                JR      .DONEINS
.OVRP           LD      HL, .STROVR
                CALL    .CPYSTR

.DONEINS        ; 4. TYPING STYLE INDICATOR
                LD      A, (TYPATTR)
                AND     ATRFMSK
                LD      HL, .STRNOST
                JR      Z, .PUTSTYL
                CP      1
                LD      HL, .STRBD
                JR      Z, .PUTSTYL
                CP      2
                LD      HL, .STRIT
                JR      Z, .PUTSTYL
                LD      HL, .STRBI
.PUTSTYL        CALL    .CPYSTR

                ; 5. MARKUP MODE INDICATOR
                LD      A, (MKUPMD)
                OR      A
                LD      HL, .STRNOMK
                JR      Z, .PUTMKUP
                CP      MKUP_MD
                LD      HL, .STRMD
                JR      Z, .PUTMKUP
                LD      HL, .STRLIT
.PUTMKUP        CALL    .CPYSTR

                ; 6. SELECTION INDICATOR
                LD      A, (SELACT)
                OR      A
                LD      HL, .STRNOSL
                JR      Z, .PUTSEL
                LD      HL, .STRSEL
.PUTSEL         CALL    .CPYSTR

                ; 7. MODIFIED INDICATOR
                LD      A, (MODIFIED)
                OR      A
                JR      Z, .NOTMOD
                LD      A, '*'
                LD      (DE), A
                INC     DE
                LD      A, ' '
                LD      (DE), A
                INC     DE
                JR      .DONEMOD
.NOTMOD         LD      A, ' '
                LD      (DE), A
                INC     DE
                LD      (DE), A
                INC     DE

.DONEMOD        ; 8. "Ln " LINE/TOTAL, 5 DIGITS EACH, " Col " COLUMN, 3 DIGITS.
                ; EVERY FIELD OF THE BAR HAS A FIXED WIDTH SO THAT A FLAG THAT
                ; APPEARS OR A NUMBER THAT GROWS A DIGIT DOES NOT SHIFT WHAT
                ; FOLLOWS: DRWSTAT REPAINTS ONLY THE CELLS THAT CHANGE.
                LD      HL, .STRLN
                CALL    .CPYSTR
                LD      HL, (DOCLINE)
                INC     HL
                LD      B, 5
                CALL    .CPYNUM
                LD      A, '/'
                LD      (DE), A
                INC     DE
                LD      HL, (TOTLINES)
                LD      B, 5
                CALL    .CPYNUM
                LD      HL, .STRCOL
                CALL    .CPYSTR
                LD      A, (CURX)
                INC     A
                LD      L, A
                LD      H, 0
                LD      B, 3
                CALL    .CPYNUM

                ; " | "
                LD      HL, .STRSEP
                CALL    .CPYSTR

                ; FILENAME
                LD      HL, FILENAME
                CALL    .CPYSTR

                ; TERMINATING NULL
                XOR     A
                LD      (DE), A
                RET

.CPYSTR         LD      A, (HL)
                OR      A
                RET     Z
                LD      (DE), A
                INC     HL
                INC     DE
                JR      .CPYSTR

                ; HL = VALUE, B = WIDTH: APPEND THE LOW B DIGITS, ZERO PADDED.
                ; B2D16 RIGHT-ALIGNS AT B2DEND WITH SPACES FOR LEADING ZEROS.
.CPYNUM         PUSH    DE
                PUSH    BC
                CALL    B2D16
                POP     BC
                POP     DE
                LD      HL, B2DEND
                LD      A, L
                SUB     B
                LD      L, A
                JR      NC, .CPYNUM2
                DEC     H
.CPYNUM2        LD      A, (HL)
                CP      ' '
                JR      NZ, .CPYNUM3
                LD      A, '0'
.CPYNUM3        LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .CPYNUM2
                RET

.STRSTD         DEFM    "[STD] ", 0
.STRWS          DEFM    "[WS]  ", 0
.STREMC         DEFM    "[EMC] ", 0
.STRVIN         DEFM    "[VI-N]", 0
.STRVII         DEFM    "[VI-I]", 0
.STRWDEV        DEFM    " [DEV]", 0
.STRWTXT        DEFM    " [TXT]", 0
.STRINS         DEFM    " [INS] ", 0
.STROVR         DEFM    " [OVR] ", 0
.STRNOST        DEFM    "     ", 0
.STRBD          DEFM    "[B]  ", 0
.STRIT          DEFM    "[I]  ", 0
.STRBI          DEFM    "[BI] ", 0
.STRNOMK        DEFM    "      ", 0
.STRMD          DEFM    "[MD]  ", 0
.STRLIT         DEFM    "[LIT] ", 0
.STRNOSL        DEFM    "      ", 0
.STRSEL         DEFM    "[SEL] ", 0
.STRLN          DEFM    "Ln ", 0
.STRCOL         DEFM    " Col ", 0
.STRSEP         DEFM    " | ", 0


; --- DRWMENU               ----------------------------------------


; - DRWMENU ----------------------------
; - DRAW MENU BAR (ROW 0, ALWAYS VISIBLE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWMENU         LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      (VDP_DY), HL    ; DY = 0
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                ; PRINT MENU TEXT
                LD      HL, MNUTEXT
                LD      DE, 6           ; DX = 6
                LD      BC, 0           ; DY = 0
                CALL    BLTSTR
                RET

MNUTEXT         DEFM    "S6ED v0.1 | [F1] Help  [F2] Save  [ESC] Quit", 0


; --- BLTCHTR                  ----------------------------------------


; - BLTCHTR ----------------------------
; - BLIT CHARACTER WITH TIMP TRANSPARENCY
; - IN:  A  = ASCII CHAR
; -      HL = DX
; -      DE = DY
; - OUT: NONE
; - CLOBBERS: NONE
; -

BLTCHTR         PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                LD      (VDP_DX), HL
                EX      DE, HL
                LD      (VDP_DY), HL

                ; CALC FONT SX/SY
                LD      B, A            ; B = CHAR
                AND     %00011111       ; CHAR & 31
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                ADD     HL, HL          ; * 8
                LD      (VDP_SX), HL

                LD      A, B
                SRL     A
                SRL     A
                SRL     A
                SRL     A
                SRL     A               ; CHAR >> 5 (0..7)
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; * 8
                LD      L, A
                LD      H, 0
                LD      DE, FNORM_SY    ; 256
                ADD     HL, DE
                LD      (VDP_SY), HL

                LD      HL, 6           ; NX = 6
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMM | VDP_TIMP
                CALL    LMMM

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; - BLTSTR -----------------------------
; - BLIT ASCIIZ STRING WITH TIMP
; - IN:  HL = POINTER TO ASCIIZ STRING
; -      DE = DX
; -      BC = DY
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLTSTR          LD      A, (HL)
                OR      A
                RET     Z
                PUSH    HL
                PUSH    DE
                PUSH    BC
                EX      DE, HL          ; HL = DX
                LD      D, B
                LD      E, C            ; DE = DY
                CALL    BLTCHTR
                POP     BC
                POP     DE
                POP     HL
                INC     HL
                LD      A, 6
                ADD     A, E
                LD      E, A
                JR      NC, BLTSTR
                INC     D
                JR      BLTSTR


; --- DRWCUR                ----------------------------------------


; - DRWCUR -----------------------------
; - TOGGLE CURSOR XOR OVERLAY AT (CURX, CURY)
; - IN:  NONE (USES CURX, CURY)
; - OUT: NONE
; - CLOBBERS: NONE
; -

DRWCUR          PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                ; DX = TXORG_X + CURX * 6
                LD      A, (CURX)
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                LD      D, H
                LD      E, L
                ADD     HL, HL          ; * 4
                ADD     HL, DE          ; * 6
                LD      DE, TXORG_X
                ADD     HL, DE
                LD      (VDP_DX), HL

                ; DY = (CURY + 1) * 8
                LD      A, (CURY)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL

                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL

                LD      HL, CELLW       ; NX = 6
                LD      (VDP_NX), HL
                LD      HL, CELLH       ; NY = 8
                LD      (VDP_NY), HL

                LD      A, COL_HI       ; CLR = 3
                LD      (VDP_CLR), A

                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_XOR
                CALL    LMMV

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; --- TIMI HOOK (BLINK)         ----------------------------------------


; - BLNKTICK ---------------------------
; - BLINK TIMER HOOK STUB
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

BLNKTICK        RET

