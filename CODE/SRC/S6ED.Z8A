; **********************************************
; * S6ED                                       *
; * MSX2 SCREEN 6 TEXT EDITOR                  *
; * 80 COLS X 24 ROWS, 6X8 FONT, DOS2/NEXTOR  *
; * 2024 - 2025 CODED BY ARMANDO PEREZ         *
; **********************************************

                OUTPUT  S6ED.COM

; --- MACROS                    ----------------------------------------


                ; INFINITE LOOP / BREAKPOINT
                MACRO   BRK
                DI
                JP      $
                ENDM

                ; ORG WITH PADDING (DOES NOT DISCARD CODE)
                MACRO PADORG ADDR
                IF $ < ADDR
                BLOCK ADDR-$
                ENDIF
                ORG ADDR
                ENDM

                ; DEBUG LOG TO OPENMSX DEBUGDEVICE
                MACRO   DBG MSG
                CALL    DBGMSG
                DEFM    MSG, 10, 0
                ENDM


; --- CONST / INCLUDES          ----------------------------------------


                INCLUDE HARD.Z8A
                INCLUDE CONST.Z8A


; --- DOS PROGRAM               ----------------------------------------


                ORG     #100
                JP      INIT


; --- STRINGS                   ----------------------------------------


ENODOS2      DEFM    "Requires MSX-DOS 2 or Nextor.$"
ENOMAP       DEFM    "No mapper manager found.$"


; --- MODULE INCLUDES           ----------------------------------------


                INCLUDE BDOS.Z8A
                INCLUDE GENERIC.Z8A
                INCLUDE VDP.Z8A
                INCLUDE FONT.Z8A
                INCLUDE MAPPER.Z8A
                INCLUDE BUFFER.Z8A
                INCLUDE RENDER.Z8A
                INCLUDE SCROLL.Z8A
                INCLUDE EDIT.Z8A
                INCLUDE INPUT.Z8A
                INCLUDE UI.Z8A
                INCLUDE FILEIO.Z8A
                INCLUDE PARAMS.Z8A


; --- INIT                      ----------------------------------------


; - INIT -------------
; - PROGRAM ENTRY POINT
; -

INIT            DBG     "1: INIT START"
                LD      (SAVESP), SP    ; PRESERVE ORIGINAL DOS STACK

                ; DETECT DOS VERSION
                DBG     "2: DOSVER"
                CALL    DOSVER
                JP      C, .NODOS2      ; CARRY = DOS1 ONLY

                ; LOCATE MAPPER MANAGER
                DBG     "3: MAPINIT"
                CALL    MAPINIT
                JP      C, .NOMAP

                ; SAVE ORIGINAL MAPPER SEGMENTS
                DBG     "4: GETP1/GETP2"
                CALL    GETP1
                LD      (DEFSEG1), A
                CALL    GETP2
                LD      (DEFSEG2), A

                ; INITIALIZE SCREEN
                DBG     "5: SCRINIT"
                CALL    SCRINIT

                ; INITIALIZE FONT TABLES IN VRAM
                DBG     "6: FONTINIT"
                CALL    FONTINIT

                ; INITIALIZE EMPTY TEXT BUFFER
                DBG     "7: BUFINIT"
                CALL    BUFINIT

                ; CHECK COMMAND-LINE PARAMS: OPTIONAL FILENAME TO LOAD
                DBG     "8: PARAMS"
                CALL    PARAMS
                JR      C, .NOARG       ; CY=1 → NO FILENAME GIVEN
                DBG     "9: FILELOAD"
                LD      HL, FILENAME
                CALL    FILELOAD
                CALL    REDRAW          ; RENDER LOADED DOCUMENT
                JR      .READY

.NOARG          ; DRAW INITIAL SCREEN (EMPTY BUFFER)
                DBG     "9b: REDRAW NOARG"
                CALL    REDRAW

.READY          ; DRAW CHROME AND INITIAL CURSOR
                DBG     "10: CHROME"
                CALL    DRWMENU
                CALL    DRWGUT
                CALL    DRWSCRL
                CALL    DRWSTAT
                CALL    DRWCUR
                LD      A, 1
                LD      (BLNKPH), A
                LD      A, (JIFFY)
                LD      (BLNKCNT), A

                ; ENTER MAIN EDITOR LOOP
                DBG     "11: ENTER MAINLOOP"
                JP      MAINLOOP

.NODOS2         LD      DE, ENODOS2
                CALL    STROUT
                JP      TERM

.NOMAP          LD      DE, ENOMAP
                CALL    STROUT
                JP      TERM


; --- SCRINIT                ----------------------------------------


; - SCRINIT ----------------------------
; - SET SCREEN 6, PALETTE, CLEAR VRAM
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SCRINIT         LD      A, 6
                LD      IX, CHGMOD
                CALL    BIOSCALL
                LD      A, #FF
                LD      (SCRRDY), A

                ; SET BORDER TO SOLID BLACK (R#7 = 0) VIA RG7SAV
                LD      A, (RG7SAV)
                AND     #F0             ; BORDER COLOR 0 (BLACK)
                LD      B, A
                LD      C, 7
                LD      IX, WRTVDP_B
                CALL    BIOSCALL

                ; SET MODE REG 2 (R#8): DISABLE SPRITES (SPD=1), TP=1, VR=1 VIA RG8SAV
                LD      A, (RG8SAV)
                OR      #2A             ; SPD=1, VR=1, TP=1
                LD      B, A
                LD      C, 8
                LD      IX, WRTVDP_B
                CALL    BIOSCALL

                ; SET PALETTE (R#16 = 0, THEN 8 BYTES TO PORT #9A)
                XOR     A
                OUT     (VDPCT), A      ; PALETTE 0
                LD      A, #90          ; REG 16 | #80
                OUT     (VDPCT), A
                LD      HL, PALDATA
                LD      B, 8            ; 4 COLORS * 2 BYTES
                LD      C, VDPPAL       ; PORT #9A
                OTIR
                EI

                ; CLEAR VRAM (HMMV 512x212)
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      (VDP_DY), HL
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 212
                LD      (VDP_NY), HL
                LD      A, CLR_BG
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV
                CALL    VDPWAIT

                ; DISABLE KEY CLICK
                XOR     A
                LD      (CLIKSW), A
                
                ; ERASE FUNCTION KEYS
                LD      IX, ERAFNK
                CALL    BIOSCALL

                ; FLUSH KEYBOARD BUFFER
                LD      IX, KILBUF
                CALL    BIOSCALL
                RET

PALDATA         DEFB    #00, #00        ; 0: BLACK
                DEFB    #77, #07        ; 1: WHITE FG
                DEFB    #17, #02        ; 2: BLUE UI (R=1, B=7, G=2)
                DEFB    #70, #07        ; 3: YELLOW HI (R=7, B=0, G=7)


; --- HOOKS                     ----------------------------------------


; - HKBLINK ----------------------------
; - CURSOR BLINK HOOK STUB
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

HKBLINK         RET


; - UNBLINK ----------------------------
; - UNHOOK CURSOR BLINK STUB
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

UNBLINK         RET


; --- VARS                      ----------------------------------------


                OUTEND

                INCLUDE VARS.Z8A
