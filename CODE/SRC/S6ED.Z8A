; **********************************************
; * S6ED                                       *
; * MSX2 SCREEN 6 TEXT EDITOR                  *
; * 80 COLS X 24 ROWS, 6X8 FONT, DOS2/NEXTOR  *
; * 2024 - 2025 CODED BY ARMANDO PEREZ         *
; **********************************************

                OUTPUT  S6ED.COM

; --- MACROS                    ----------------------------------------


                ; INFINITE LOOP / BREAKPOINT
                MACRO   BRK
                DI
                JP      $
                ENDM

                ; ORG WITH PADDING (DOES NOT DISCARD CODE)
                MACRO PADORG ADDR
                IF $ < ADDR
                BLOCK ADDR-$
                ENDIF
                ORG ADDR
                ENDM

                ; DEBUG LOG TO OPENMSX DEBUGDEVICE (PORTS #2E / #2F)
                ; BUILD WITH  make DEBUG=1  AND CAPTURE WITH:
                ;   m2d2 S6ED.DSK -ext debugdevice
                ; ASSEMBLES TO NOTHING IN A NORMAL BUILD.
                MACRO   DBG MSG
                IFDEF   DEBUG
                CALL    DBGMSG
                DEFM    MSG, 10, 0
                ENDIF
                ENDM


; --- CONST / INCLUDES          ----------------------------------------


                INCLUDE HARD.Z8A
                INCLUDE CONST.Z8A


; --- DOS PROGRAM               ----------------------------------------


                ORG     #100
                JP      INIT


; --- STRINGS                   ----------------------------------------


ENODOS2      DEFM    "Requires MSX-DOS 2 or Nextor.$"
ENOMAP       DEFM    "No mapper manager found.$"
ENOMEM       DEFM    "Out of mapper memory.$"


; --- MODULE INCLUDES           ----------------------------------------


                INCLUDE BDOS.Z8A
                INCLUDE GENERIC.Z8A
                INCLUDE VDP.Z8A
                INCLUDE FONT.Z8A
                INCLUDE MAPPER.Z8A
                INCLUDE BUFFER.Z8A
                INCLUDE RENDER.Z8A
                INCLUDE SCROLL.Z8A
                INCLUDE EDIT.Z8A
                INCLUDE MARKUP.Z8A
                INCLUDE ACTION.Z8A
                INCLUDE KEYMAP.Z8A
                INCLUDE DISP.Z8A
                INCLUDE INPUT.Z8A
                INCLUDE UI.Z8A
                INCLUDE FILEIO.Z8A
                INCLUDE PARAMS.Z8A
                INCLUDE CFG.Z8A


; --- INIT                      ----------------------------------------


; - INIT -------------
; - PROGRAM ENTRY POINT
; -

INIT            DBG     "1: INIT START"

                ; CLEAR THE VARIABLE BLOCK.
                ; VARS.Z8A IS INCLUDED AFTER OUTEND, SO NONE OF ITS DEFB / DEFW
                ; INITIALISERS REACH THE .COM FILE -- THEY ONLY RESERVE
                ; ADDRESSES. AT RUNTIME THE WHOLE BLOCK HOLDS WHATEVER THE
                ; PREVIOUS PROGRAM LEFT IN THE TPA, SO EVERY VARIABLE READ
                ; BEFORE IT IS WRITTEN (SEGCNT, INSMODE, MODIFIED, MAPRDY,
                ; FILENAME) STARTS OUT AS GARBAGE. ZERO IT, THEN SET THE FEW
                ; NON-ZERO DEFAULTS BY HAND.
                LD      HL, VARS
                LD      DE, VARS + 1
                LD      BC, ENDVARS - VARS - 1
                LD      (HL), 0
                LDIR

                LD      A, INS_MODE
                LD      (INSMODE), A
                LD      A, WRAP_DEV
                LD      (WRAPMODE), A
                LD      A, MKUP_MD
                LD      (MKUPMD), A
                LD      A, 1
                LD      (SHOWCLK), A
                LD      A, 4
                LD      (TABWIDTH), A
                LD      A, 1
                LD      (AUTOLOD), A
                ; DETECT VDP VERTICAL FREQUENCY (50HZ PAL VS 60HZ NTSC)
                LD      A, (RG9SAV)     ; #FFE8 (VDP R#9 SHADOW)
                AND     %00000010       ; BIT 1: 0 = 60HZ, 1 = 50HZ
                LD      A, 60
                JR      Z, .ISNTSC
                LD      A, 50
.ISNTSC         LD      (CLKHZ), A
                LD      HL, (JIFFY)
                LD      (CLKJIF), HL
                XOR     A
                LD      (CLKPH), A
                DEC     A               ; A = #FF
                LD      (CLKMIN), A
                XOR     A
                LD      (KMAPID), A
                CALL    KMAPSW          ; INITIALIZE KMAPPTR TO KMAPSTD
                CALL    KANARST         ; ENSURE KANA LED IS OFF AT STARTUP

                LD      (SAVESP), SP    ; PRESERVE ORIGINAL DOS STACK

                ; DETECT DOS VERSION
                DBG     "2: DOSVER"
                CALL    DOSVER
                JP      C, .NODOS2      ; CARRY = DOS1 ONLY

                ; LOCATE MAPPER MANAGER
                DBG     "3: MAPINIT"
                CALL    MAPINIT
                JP      C, .NOMAP

                ; SAVE ORIGINAL MAPPER SEGMENTS
                DBG     "4: GETP1/GETP2"
                CALL    GETP1
                LD      (DEFSEG1), A
                CALL    GETP2
                LD      (DEFSEG2), A

                ; INITIALIZE SCREEN
                DBG     "5: SCRINIT"
                CALL    SCRINIT

                ; INITIALIZE FONT TABLES IN VRAM
                DBG     "6: FONTINIT"
                CALL    FONTINIT

                ; INITIALIZE EMPTY TEXT BUFFER
                DBG     "7: BUFINIT"
                CALL    BUFINIT

                ; LOAD CONFIGURATION FROM S6ED.CFG (IF PRESENT)
                DBG     "7b: CFGLOAD"
                CALL    CFGLOAD

                ; CHECK COMMAND-LINE PARAMS: OPTIONAL FILENAME TO LOAD
                DBG     "8: PARAMS"
                CALL    PARAMS
                JR      C, .NOARG       ; CY=1 → NO FILENAME GIVEN
                DBG     "9: FILELOAD"
                LD      HL, FILENAME
                CALL    FILELOAD
                CALL    REDRAW          ; RENDER LOADED DOCUMENT
                JR      .READY

.NOARG          ; DRAW INITIAL SCREEN (EMPTY BUFFER)
                DBG     "9b: REDRAW NOARG"
                CALL    REDRAW

.READY          ; DRAW CHROME AND INITIAL CURSOR
                DBG     "10: CHROME"
                CALL    DRWMENU
                CALL    DRWSTAT
                CALL    DRWCUR
                LD      A, 1
                LD      (BLNKPH), A
                LD      A, (JIFFY)
                LD      (BLNKCNT), A

                ; ENTER MAIN EDITOR LOOP
                DBG     "11: ENTER MAINLOOP"
                JP      MAINLOOP

.NODOS2         LD      DE, ENODOS2
                CALL    STROUT
                JP      TERM

.NOMAP          LD      DE, ENOMAP
                CALL    STROUT
                JP      TERM


; --- ERRMEM                    ----------------------------------------


; - ERRMEM -----------------------------
; - ABORT: THE MAPPER MANAGER HAS NO FREE SEGMENTS LEFT
; - IN:  NONE
; - OUT: DOES NOT RETURN
; - CLOBBERS: ALL
; -
; - REACHED FROM BUFINIT WHEN THE DIRECTORY SEGMENT CANNOT BE CLAIMED: THE
; - MAPPER EXISTS BUT HAS NO FREE SEGMENT, AND WITHOUT A DIRECTORY THERE IS NO
; - EDITOR. DROPS BACK TO TEXT MODE FIRST -- OTHERWISE THE MESSAGE WOULD BE
; - WRITTEN INTO THE SCREEN 6 BITMAP AND NEVER SEEN. TERM THEN RETURNS THE
; - SEGMENTS AND THE ORIGINAL STACK TO DOS.
; -

ERRMEM          LD      A, (SCRRDY)
                AND     A
                JR      Z, .SAY
                XOR     A               ; SCREEN 0
                LD      IX, CHGMOD
                CALL    BIOSCALL
                XOR     A
                LD      (SCRRDY), A     ; TELL TERM THE SCREEN IS ALREADY BACK

.SAY            LD      DE, ENOMEM
                CALL    STROUT
                JP      TERM


; --- SETPAL                    ----------------------------------------


; - SETPAL -----------------------------
; - UPLOAD 4-COLOR PALETTE TO V9938
; - IN:  HL = POINTER TO 8-BYTE PALETTE TABLE
; - OUT: NONE
; - CLOBBERS: A, BC, HL
; -

SETPAL          DI
                XOR     A
                OUT     (VDPCT), A      ; PALETTE 0
                LD      A, #90          ; REG 16 | #80
                OUT     (VDPCT), A
                LD      B, 8            ; 4 COLORS * 2 BYTES
                LD      C, VDPPAL       ; PORT #9A
                OTIR
                EI
                RET


; --- SCRINIT                   ----------------------------------------


; - SCRINIT ----------------------------
; - SET SCREEN 6, PALETTE, CLEAR VRAM
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SCRINIT         LD      A, 6
                LD      IX, CHGMOD
                CALL    BIOSCALL
                LD      A, #FF
                LD      (SCRRDY), A

                ; SET BORDER TO SOLID BLACK (R#7 = 0) VIA RG7SAV
                LD      A, (RG7SAV)
                AND     #F0             ; BORDER COLOR 0 (BLACK)
                LD      B, A
                LD      C, 7
                LD      IX, WRTVDP_B
                CALL    BIOSCALL

                ; SET MODE REG 2 (R#8): DISABLE SPRITES (SPD=1), TP=1, VR=1 VIA RG8SAV
                LD      A, (RG8SAV)
                OR      #2A             ; SPD=1, VR=1, TP=1
                LD      B, A
                LD      C, 8
                LD      IX, WRTVDP_B
                CALL    BIOSCALL

                ; SET PALETTE
                LD      HL, PALDATA
                CALL    SETPAL

                ; CLEAR VRAM (HMMV 512x256 = #00000-#07FFF)
                ; 256 LINES, NOT 212: LINES 212-255 ARE #06A00-#07FFF, WHICH AN
                ; R#23 HARDWARE SCROLL WOULD PUT ON SCREEN. THEY COME UP HOLDING
                ; WHATEVER DOS LEFT THERE. THE FONT TABLES START AT LINE 256
                ; (VR_FNORM = #08000) AND ARE UPLOADED AFTERWARDS BY FONTINIT,
                ; SO THIS FILL NEVER REACHES THEM.
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      (VDP_DY), HL
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 256
                LD      (VDP_NY), HL
                LD      A, CLR_BG
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV
                CALL    VDPWAIT

                ; DISABLE KEY CLICK
                XOR     A
                LD      (CLIKSW), A
                
                ; ERASE FUNCTION KEYS, THEN MAKE THEM DELIVER F1KEY.. TO THE KEYMAP
                LD      IX, ERAFNK
                CALL    BIOSCALL
                CALL    SETFNKY

                ; FLUSH KEYBOARD BUFFER
                LD      IX, KILBUF
                CALL    BIOSCALL
                RET

PALDATA         DEFB    #00, #00, #77, #07, #17, #02, #70, #07  ; 0:BG, 1:FG, 2:UI, 3:HI


; --- VARS                      ----------------------------------------


                OUTEND

                INCLUDE VARS.Z8A
