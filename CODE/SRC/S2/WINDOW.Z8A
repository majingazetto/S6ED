;                                       ****************************************
;                                       * WINDOW ENGINE (SCREEN 2 / TMS9918)   *
;                                       ****************************************
;
; WINDOWS COMPOSE DIRECTLY IN THE RAM SHADOWS (PATSHAD + COLMAP): THE TMS9918
; HAS NO COMMAND ENGINE AND NO OFF-SCREEN VRAM, SO THE S6ED BLIT ARCHITECTURE
; IS REPLACED BY SHADOW WRITES PLUS ROW DUMPS. THE BACKGROUND UNDER THE WINDOW
; IS SAVED TO WSVBUF AND RESTORED ON CLOSE. WSVBUF IS PLAIN TPA RAM IN PAGE 1
; (THE CHAIN AT THE FOOT OF VARS.Z8A), NOT CONTAINER SPACE: PAGE 1 IS OURS
; WHILE THIS CODE RUNS, AND THE CONTAINER IS THE SCARCE RESOURCE ON S2.
;
; GEOMETRY IS IN CELL UNITS: WINR/WINC ARE THE TOP-LEFT CORNER, WINNR/WINNC
; THE SIZE. THE WINDOW OCCUPIES WINNR ROWS X WINNC CELLS; THE DROP SHADOW
; ADDS ONE COLUMN ON THE RIGHT AND ONE ROW AT THE BOTTOM, SO SAVE, RESTORE
; AND DUMP ALL SPAN (WINNR+1) X (WINNC+1).
;
; ALL ROUTINES RUN PHASED IN FTRBASE (PAGE 2) VIA FCALL. FTRSEG AND VIDSEG
; ARE THE SAME SEGMENT ON S2ED, SO THE SHADOWS AND THE FONT TABLES ARE
; DIRECTLY ADDRESSABLE, AND THE PAGE-1 PRIMITIVES (VDPDUMP, COLDMPC,
; WINPOLL, WINKIL) CALL AS USUAL. THE CODE MUST NEVER BANK: NO VIDBANK,
; NO TXTBANK, NO PUTP2.


; --- WINOPEN                   ----------------------------------------


; - WINOPEN ----------------------------
; - OPEN WINDOW: CLAMP GEOMETRY, SAVE BACKGROUND, DRAW BOX + TITLE, DUMP
; - IN:  HL = ASCIIZ TITLE STRING (0 = NONE)
; -      USES WINR, WINC, WINNR, WINNC
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINOPEN         PUSH    HL              ; TITLE

                ; FLUSH KEYBOARD BUFFER
                CALL    WINKIL

                ; MARK MODAL WINDOW ACTIVE
                LD      A, 1
                LD      (WINACTV), A

                ; ERASE CURSOR IF CURRENTLY VISIBLE. DRWCUR BANKS VIDSEG
                ; AND THEN TXSEG; UNDER FCALL TXSEG IS FTRSEG, WHICH IS
                ; VIDSEG, SO PAGE 2 NEVER MOVES.
                LD      A, (BLNKPH)
                AND     A
                JR      Z, .NOCUR
                CALL    DRWCUR
                XOR     A
                LD      (BLNKPH), A

.NOCUR          ; CLAMP WINC <= CELLROW-3: WINNC >= 2 AND THE SHADOW
                ; COLUMN MUST FIT (WINC + WINNC <= CELLROW - 1)
                LD      A, (WINC)
                CP      CELLROW - 2
                JR      C, .WCOK
                LD      A, CELLROW - 3
                LD      (WINC), A
.WCOK           ; CLAMP WINNC: MIN 2, MAX CELLROW-1-WINC
                LD      A, (WINNC)
                CP      2
                JR      NC, .WCMIN
                LD      A, 2
.WCMIN          LD      B, A
                LD      A, CELLROW - 1
                LD      HL, WINC
                SUB     (HL)            ; A = MAX WIDTH
                CP      B
                JR      NC, .WCMAX
                LD      B, A
.WCMAX          LD      A, B
                LD      (WINNC), A

                ; CLAMP WINR <= SCRROWS-3: WINNR >= 2 AND THE SHADOW
                ; ROW MUST FIT (WINR + WINNR <= SCRROWS - 1)
                LD      A, (WINR)
                CP      SCRROWS - 2
                JR      C, .WROK
                LD      A, SCRROWS - 3
                LD      (WINR), A
.WROK           ; CLAMP WINNR: MIN 2, MAX SCRROWS-1-WINR
                LD      A, (WINNR)
                CP      2
                JR      NC, .WRMIN
                LD      A, 2
.WRMIN          LD      B, A
                LD      A, SCRROWS - 1
                LD      HL, WINR
                SUB     (HL)            ; A = MAX HEIGHT
                CP      B
                JR      NC, .WRMAX
                LD      B, A
.WRMAX          LD      A, B
                LD      (WINNR), A

                ; CLAMP SIZE: (WINNR+1)*(WINNC+1)*9 <= WSVMAX, SHRINKING
                ; THE LARGER DIMENSION UNTIL THE SAVE BUFFER HOLDS IT
.SZLP           LD      A, (WINNR)
                INC     A
                LD      B, A            ; B = ROWS (SHADOW INCLUDED)
                LD      A, (WINNC)
                INC     A               ; A = CELLS (SHADOW INCLUDED)
                LD      HL, 0
                LD      D, 0
                LD      E, A
.MULLP          ADD     HL, DE
                DJNZ    .MULLP          ; HL = ROWS * CELLS
                LD      DE, WSVMAX / 9
                OR      A
                SBC     HL, DE
                JR      C, .SZOK        ; FITS THE SAVE BUFFER
                LD      A, (WINNR)
                LD      B, A
                LD      A, (WINNC)
                CP      B               ; WINNC VS WINNR
                LD      HL, WINNC
                JR      NC, .SHR        ; WINNC >= WINNR: SHRINK WIDTH
                LD      HL, WINNR
.SHR            DEC     (HL)
                JR      .SZLP

.SZOK           ; TEXT CLIP: GLYPHS END LEFT OF THE RIGHT BORDER
                LD      A, (WINC)
                LD      B, A
                LD      A, (WINNC)
                ADD     A, B
                DEC     A
                ADD     A, A
                LD      (WINCLIM), A    ; (WINC+WINNC-1)*2, EXCLUSIVE

                ; SAVE BACKGROUND, SHADOW MARGIN INCLUDED
                CALL    WSAVE

                ; DRAW WINDOW BOX AND TITLE INTO THE SHADOWS
                POP     HL
                CALL    WBOX

                ; DARKEN THE SHADOW MARGIN IN THE COLOR MAP
                CALL    WSHDW

                ; PUSH THE REGION TO VRAM
                JP      WDUMP


; --- WINCLOS                   ----------------------------------------


; - WINCLOS ----------------------------
; - CLOSE WINDOW: RESTORE BACKGROUND FROM WSVBUF AND REDUMP THE REGION
; - IN:  NONE (USES WINR, WINC, WINNR, WINNC)
; - OUT: NONE
; - CLOBBERS: ALL
; - NOTE: THE CURSOR IS NOT REDRAWN HERE; MAINLOOP'S .DRAWCUR DOES IT
; -       WHEN THE DISPATCHED KEY RETURNS.
; -

WINCLOS         XOR     A
                LD      (WINACTV), A
                CALL    WRSTOR
                JP      WDUMP


; --- WSAVE                     ----------------------------------------


; - WSAVE ------------------------------
; - SAVE THE WINDOW REGION (SHADOW MARGIN INCLUDED) TO WSVBUF:
; - FIRST THE PATTERN SLICES, THEN THE COLOR SLICES
; - IN:  NONE (USES WINR, WINC, WINNR, WINNC)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WSAVE           LD      DE, WSVBUF
                LD      A, (WINR)
                LD      B, A            ; B = ROW
                LD      A, (WINNR)
                INC     A
                LD      C, A            ; C = ROWS LEFT
.SVPLP          PUSH    BC
                LD      A, #80          ; HIGH(PATSHAD)
                ADD     A, B
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A            ; HL = PATSHAD + ROW*256 + WINC*8
                LD      A, (WINNC)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      C, A
                LD      B, 0            ; BC = (WINNC+1)*8
                LDIR                    ; DE ADVANCES THROUGH WSVBUF
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .SVPLP

                ; COLOR SLICES FOLLOW THE PATTERNS
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                INC     A
                LD      C, A
.SVCLP          PUSH    BC
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW*32
                LD      A, (WINC)
                ADD     A, L
                LD      L, A
                JR      NC, .SVCNC
                INC     H
.SVCNC          PUSH    DE
                LD      DE, COLMAP
                ADD     HL, DE          ; HL = COLMAP + ROW*32 + WINC
                POP     DE
                LD      A, (WINNC)
                INC     A
                LD      C, A
                LD      B, 0            ; BC = WINNC+1
                LDIR
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .SVCLP
                RET


; --- WRSTOR                    ----------------------------------------


; - WRSTOR -----------------------------
; - RESTORE THE WINDOW REGION FROM WSVBUF INTO THE SHADOWS (NO VRAM)
; - IN:  NONE (USES WINR, WINC, WINNR, WINNC)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WRSTOR          LD      HL, WSVBUF
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                INC     A
                LD      C, A
.RSPLP          PUSH    BC
                LD      A, #80          ; HIGH(PATSHAD)
                ADD     A, B
                LD      D, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      E, A            ; DE = DST PATTERN SLICE
                LD      A, (WINNC)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      C, A
                LD      B, 0
                LDIR                    ; HL ADVANCES THROUGH WSVBUF
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .RSPLP

                ; COLOR SLICES
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                INC     A
                LD      C, A
.RSCLP          PUSH    BC
                PUSH    HL              ; SAVE RUNNING SOURCE
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW*32
                LD      A, (WINC)
                ADD     A, L
                LD      L, A
                JR      NC, .RSCNC
                INC     H
.RSCNC          LD      DE, COLMAP
                ADD     HL, DE          ; HL = DST
                EX      DE, HL          ; DE = DST
                POP     HL              ; HL = SRC
                LD      A, (WINNC)
                INC     A
                LD      C, A
                LD      B, 0
                LDIR
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .RSCLP
                RET


; --- WBOX                      ----------------------------------------


; - WBOX -------------------------------
; - DRAW THE WINDOW FRAME, BODY FILL AND TITLE INTO THE SHADOWS
; - THE FRAME IS RAW PATTERNS: TOP/BOTTOM EDGES ARE #FF ON SCANLINE 0/7,
; - SIDE BORDERS #C0 / #03, CORNERS THE UNION OF BOTH. EVERY WINDOW CELL
; - CARRIES VCOLWIN, EXCEPT THE TOP ROW, WHICH IS THE TITLE BAR AND
; - CARRIES VCOLHI. THE FILL IS DARK AND THE FRAME PATTERNS ARE DRAWN
; - IN INK, SO THEY READ AS LIGHT LINES. THE TITLE CUTS THE TOP EDGE:
; - ITS CELLS ARE CLEARED BEFORE THE TEXT GOES IN, AND A SEPARATOR LINE
; - CLOSES THE BAR ALONG SCANLINE 7 OF THAT ROW.
; - IN:  HL = ASCIIZ TITLE STRING (0 = NONE)
; - OUT: NONE
; - CLOBBERS: ALL
; -

WBOX            PUSH    HL              ; TITLE

                ; 1. COLORS: VCOLWIN, TOP ROW VCOLHI (TITLE BAR)
                LD      A, (WINR)
                LD      B, A            ; B = ROW
                LD      A, (WINNR)
                LD      C, A            ; C = ROWS LEFT
.CRLP           PUSH    BC
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW*32
                LD      A, (WINC)
                ADD     A, L
                LD      L, A
                JR      NC, .CRNC
                INC     H
.CRNC           LD      DE, COLMAP
                ADD     HL, DE
                LD      A, (WINR)
                CP      B               ; B IS STILL THE ROW HERE
                LD      A, (VCOLWIN)
                JR      NZ, .CFILS
                LD      A, (VCOLHI)     ; TOP ROW: TITLE BAR
.CFILS          LD      C, A            ; HOLD IT WHILE B TAKES WINNC
                LD      A, (WINNC)
                LD      B, A
                LD      A, C
.CFILL          LD      (HL), A
                INC     HL
                DJNZ    .CFILL
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .CRLP

                ; 2. PATTERNS: CLEAR THE RECT
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                LD      C, A
.PRLP           PUSH    BC
                LD      A, #80          ; HIGH(PATSHAD)
                ADD     A, B
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A            ; HL = FIRST CELL OF THE ROW
                LD      A, (WINNC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      B, A            ; B = WINNC*8 BYTES
                XOR     A
.PFILL          LD      (HL), A
                INC     HL
                DJNZ    .PFILL
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .PRLP

                ; 3. VERTICAL BORDERS: LEFT #C0, RIGHT #03, EVERY ROW.
                ;    THE EDGES BELOW FIX THE CORNERS' SCANLINE 0 AND 7.
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                LD      C, A
.VRLP           PUSH    BC
                LD      A, #80          ; HIGH(PATSHAD)
                ADD     A, B
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A            ; LEFT CELL
                LD      B, 8
                LD      A, #C0
.LBOR           LD      (HL), A
                INC     HL
                DJNZ    .LBOR
                LD      A, (WINNC)
                SUB     2
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; RIGHT CELL: (WINNC-2)*8 PAST WINC+1
                LD      B, 8
                LD      A, #03
.RBOR           LD      (HL), A
                INC     HL
                DJNZ    .RBOR
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .VRLP

                ; 4. TOP EDGE: SCANLINE 0 OF EVERY CELL
                LD      A, (WINR)
                ADD     A, #80          ; HIGH(PATSHAD)
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      A, (WINNC)
                LD      B, A
                LD      DE, 8
                LD      A, #FF
.TEDG           LD      (HL), A
                ADD     HL, DE
                DJNZ    .TEDG

                ; 5. BOTTOM EDGE: SCANLINE 7 OF EVERY CELL
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                ADD     A, B
                DEC     A               ; LAST WINDOW ROW
                ADD     A, #80          ; HIGH(PATSHAD)
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                ADD     A, 7            ; SCANLINE 7 OF THE FIRST CELL
                LD      L, A
                LD      A, (WINNC)
                LD      B, A
                LD      A, #FF
.BEDG           LD      (HL), A
                ADD     HL, DE
                DJNZ    .BEDG

                ; 6. TITLE OVER THE TOP EDGE, ONE CELL IN: ONLY THE CELLS
                ;    THE TITLE OCCUPIES ARE CLEARED OFF THE EDGE
                POP     HL              ; TITLE
                LD      A, H
                OR      L
                JR      Z, .SEP         ; NO TITLE, BUT STILL A TITLE BAR
                PUSH    HL
                ; SPAN: THE TITLE STARTS AT CHAR COLUMN (WINC+1)*2 AND
                ; WINPUTS CLIPS IT AT WINCLIM (OR THE RIGHT SCREEN EDGE
                ; WHEN WINCLIM IS 0), TWO CHARACTERS PER CELL
                LD      A, (WINC)
                INC     A
                ADD     A, A
                LD      C, A            ; C = START CHAR COLUMN
                LD      A, (WINCLIM)
                OR      A
                JR      NZ, .TLIM
                LD      A, SCRCOLS
.TLIM           SUB     C               ; A = COLUMNS BEFORE THE CLIP
                LD      B, A
                LD      C, 0            ; C = CHARACTERS DRAWN
                JR      Z, .TSPAN       ; NO ROOM: NOTHING TO CLEAR
.TLEN           LD      A, (HL)
                OR      A
                JR      Z, .TSPAN
                INC     HL
                INC     C
                DJNZ    .TLEN
.TSPAN          LD      A, C
                OR      A
                JR      Z, .TDRAW       ; EMPTY TITLE: NOTHING TO CLEAR
                INC     A
                SRL     A               ; CELLS = (CHARS+1)/2
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      B, A            ; B = CELLS*8 BYTES
                LD      A, (WINR)
                ADD     A, #80          ; HIGH(PATSHAD)
                LD      H, A
                LD      A, (WINC)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A            ; CELL WINC+1 OF THE TOP ROW
                XOR     A
.TCLR           LD      (HL), A
                INC     HL
                DJNZ    .TCLR
.TDRAW          POP     HL
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINC)
                INC     A
                ADD     A, A
                LD      C, A            ; CHAR COL = (WINC+1)*2
                LD      A, (VCOLHI)
                CALL    WINPUTS

                ; 7. SEPARATOR UNDER THE TITLE BAR: SCANLINE 7 OF EVERY CELL
                ;    OF THE TOP ROW. IT GOES IN *AFTER* THE TITLE, BECAUSE
                ;    WINPUTC OVERWRITES ALL EIGHT SCANLINES OF A CELL RATHER
                ;    THAN OR-ING INTO IT, SO A LINE DRAWN FIRST WOULD BE
                ;    WIPED EXACTLY WHERE THE TITLE SITS. IT SPANS THE BORDER
                ;    CELLS TOO, AS S6ED'S COL_HI SEPARATOR DOES.
.SEP            LD      A, (WINR)
                ADD     A, #80          ; HIGH(PATSHAD)
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                ADD     A, 7            ; SCANLINE 7 OF CELL WINC
                LD      L, A
                LD      DE, 8
                LD      A, (WINNC)
                LD      B, A
                LD      A, #FF
.SEPLP          LD      (HL), A
                ADD     HL, DE
                DJNZ    .SEPLP
                RET


; --- WSHDW                     ----------------------------------------


; - WSHDW ------------------------------
; - DARKEN THE SHADOW MARGIN: THE COLUMN RIGHT OF THE WINDOW AND THE ROW
; - BELOW IT GET VCOLSHDW IN THE COLOR MAP. THE PATTERNS UNDERNEATH ARE
; - UNTOUCHED -- BLACK INK ON BLACK HIDES THEM, WHICH IS ALL A SHADOW IS.
; - IN:  NONE (USES WINR, WINC, WINNR, WINNC)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WSHDW           LD      A, (SHDWOFF)
                OR      A
                RET     NZ              ; SHADOW=OFF: LEAVE THE MARGIN ALONE

                ; RIGHT COLUMN: ROWS WINR+1..WINR+WINNR, CELL WINC+WINNC
                LD      A, (WINR)
                INC     A
                LD      B, A            ; B = ROW
                LD      A, (WINNR)
                LD      C, A            ; C = ROWS LEFT
.RSLP           PUSH    BC
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW*32
                LD      A, (WINC)
                LD      E, A
                LD      A, (WINNC)
                ADD     A, E            ; A = WINC+WINNC
                ADD     A, L
                LD      L, A
                JR      NC, .RSNC
                INC     H
.RSNC           LD      DE, COLMAP
                ADD     HL, DE
                LD      A, (VCOLSHDW)
                LD      (HL), A
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .RSLP

                ; BOTTOM ROW: ROW WINR+WINNR, CELLS WINC+1..WINC+WINNC
                LD      A, (WINR)
                LD      B, A
                LD      A, (WINNR)
                ADD     A, B            ; A = SHADOW ROW
                LD      L, A
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                LD      A, (WINC)
                INC     A
                ADD     A, L
                LD      L, A
                JR      NC, .BSNC
                INC     H
.BSNC           LD      DE, COLMAP
                ADD     HL, DE
                LD      A, (WINNC)
                LD      B, A            ; B = WINNC CELLS
                LD      A, (VCOLSHDW)
.BSLP           LD      (HL), A
                INC     HL
                DJNZ    .BSLP
                RET


; --- WDUMP                     ----------------------------------------


; - WDUMP ------------------------------
; - PUSH THE WINDOW REGION (SHADOW MARGIN INCLUDED) FROM THE SHADOWS TO
; - VRAM, ONE ROW AT A TIME: PATTERN SLICE VIA VDPDUMP, COLOR SLICE VIA
; - COLDMPC
; - IN:  NONE (USES WINR, WINC, WINNR, WINNC)
; - OUT: NONE
; - CLOBBERS: ALL
; -

WDUMP           LD      A, (WINR)
                LD      B, A            ; B = ROW
                LD      A, (WINNR)
                INC     A
                LD      C, A            ; C = ROWS LEFT
.DROW           PUSH    BC
                LD      A, B
                CALL    WDUMPR
                POP     BC
                INC     B
                DEC     C
                JR      NZ, .DROW
                RET


; - WDUMPR -----------------------------
; - PUSH ONE ROW OF THE WINDOW REGION, SHADOW COLUMN INCLUDED. THIS IS
; - WDUMP'S BODY: A DIALOG THAT REPAINTS ONE FIELD PAYS FOR ONE ROW
; - INSTEAD OF THE WHOLE WINDOW -- MEASURED 7.4 MS AGAINST ~60 MS ON A
; - 15-CELL WINDOW, WHICH IS THE DIFFERENCE BETWEEN TYPING AND WAITING.
; - IN:  A = SCREEN ROW
; - OUT: NONE
; - CLOBBERS: ALL
; -

WDUMPR          LD      B, A            ; B = ROW
                PUSH    BC
                ; PATTERN SLICE
                LD      A, #80          ; HIGH(PATSHAD)
                ADD     A, B
                LD      H, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A            ; HL = SRC
                LD      D, B
                LD      E, L            ; DE = VRAM DEST (PGBASE = #0000)
                LD      A, (WINNC)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      C, A
                LD      B, 0            ; BC = (WINNC+1)*8
                CALL    VDPDUMP
                ; COLOR SLICE
                POP     BC
                PUSH    BC
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW*32
                LD      A, (WINC)
                ADD     A, L
                LD      L, A
                JR      NC, .DNC
                INC     H
.DNC            LD      DE, COLMAP
                ADD     HL, DE          ; HL = SRC IN COLMAP
                LD      A, B
                ADD     A, #20          ; HIGH(CTBASE)
                LD      D, A
                LD      A, (WINC)
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      E, A            ; DE = CTBASE + ROW*256 + WINC*8
                LD      A, (WINNC)
                INC     A
                LD      B, A            ; B = WINNC+1 CELLS
                CALL    COLDMPC
                POP     BC
                RET


; --- WINPUTC / WINPUTS         ----------------------------------------


; - WINPUTC ----------------------------
; - COMPOSE ONE 4X8 CHARACTER INTO A WINDOW CELL: THE GLYPH REPLACES ITS
; - OWN NIBBLE OF EVERY SCANLINE (THE OTHER HALF OF THE CELL SURVIVES),
; - AND THE CELL'S COLOR MAP BYTE IS SET
; - IN:  B = SCREEN ROW (0..23), C = CHAR COLUMN (0..63)
; -      A = CHARACTER, E = COLOR BYTE
; - OUT: NONE
; - CLOBBERS: AF, DE, HL, IX (BC PRESERVED)
; -

WINPUTC         PUSH    BC              ; ROW/COL FOR THE CALLER
                LD      D, E            ; D = COLOR
                LD      E, A            ; E = CHAR

                ; CELL PATTERN ADDRESS -> IX
                LD      A, #80          ; HIGH(PATSHAD)
                ADD     A, B
                LD      H, A
                LD      L, 0            ; HL = PATSHAD + ROW*256
                LD      A, C
                SRL     A               ; A = CELL, CF = 1 IF RIGHT COLUMN
                PUSH    AF              ; SAVE THE HALF
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A            ; HL = PATSHAD + ROW*256 + CELL*8
                PUSH    HL
                POP     IX

                ; COLOR BYTE: COLMAP + ROW*32 + CELL
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW*32
                LD      A, C
                SRL     A
                ADD     A, L
                LD      L, A
                JR      NC, .CNC
                INC     H
.CNC            LD      A, H
                ADD     A, #98          ; HIGH(COLMAP)
                LD      H, A
                LD      A, D
                LD      (HL), A         ; COLOR BYTE

                ; GLYPH ADDRESS -> HL
                LD      L, E
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = CHAR*8
                POP     AF              ; CF = HALF
                JR      C, .RGHT
                LD      A, H
                ADD     A, HIGH(FONT4H)
                LD      H, A            ; HL = FONT4H + CHAR*8
                LD      D, #0F          ; KEEP THE RIGHT GLYPH OF THE CELL
                JR      .MRGE
.RGHT           LD      A, H
                ADD     A, HIGH(FONT4L)
                LD      H, A            ; HL = FONT4L + CHAR*8
                LD      D, #F0          ; KEEP THE LEFT GLYPH
.MRGE           LD      B, 8
.MRLP           LD      A, (IX+0)
                AND     D
                OR      (HL)
                LD      (IX+0), A
                INC     HL
                INC     IX
                DJNZ    .MRLP
                POP     BC
                RET


; - WINPUTS ----------------------------
; - WRITE AN ASCIIZ STRING INTO THE SHADOWS AT (ROW, COL), CLIPPED AT
; - WINCLIM (EXCLUSIVE, SET BY WINOPEN) OR AT THE RIGHT SCREEN EDGE
; - IN:  B = SCREEN ROW, C = CHAR COLUMN, HL = ASCIIZ, A = COLOR BYTE
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINPUTS         LD      E, A            ; E = COLOR
.WSLP           LD      A, (HL)
                OR      A
                RET     Z
                PUSH    HL
                PUSH    DE              ; KEEP THE COLOR ACROSS WINPUTC
                CALL    WINPUTC         ; KEEPS BC
                POP     DE
                POP     HL
                INC     HL
                INC     C
                LD      A, (WINCLIM)
                OR      A
                JR      NZ, .LIM
                LD      A, SCRCOLS
.LIM            CP      C               ; LIMIT VS NEXT COLUMN
                RET     C
                RET     Z
                JR      .WSLP


; --- DIALOGS                   ----------------------------------------


; - DOABT ------------------------------
; - DISPLAY THE ABOUT S2ED MODAL DIALOG
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DOABT           LD      A, 6
                LD      (WINR), A
                LD      A, 9
                LD      (WINC), A
                LD      A, 11
                LD      (WINNR), A
                LD      A, 13
                LD      (WINNC), A
                LD      HL, .TITABT
                CALL    WINOPEN

                LD      B, 8
                LD      C, 20
                LD      HL, .STRHDR
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      B, 9
                LD      C, 20
                LD      HL, .STRSUB
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                ; VERSION FROM THE ONE PLACE THAT HOLDS IT: CORE/CONST_CORE
                ; DEFINES VERSION.MAJOR/.MINOR AND S6ED'S ABOUT READS THE SAME
                ; PAIR, SO THE TWO EDITORS CANNOT DRIFT APART.
                LD      B, 10
                LD      C, 20
                LD      HL, .STRVER
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      B, 11
                LD      C, 20
                LD      HL, .STRDSP
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      B, 12
                LD      C, 20
                LD      HL, .STRFNT
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      B, 13
                LD      C, 20
                LD      HL, .STRMEM
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      B, 15
                LD      C, 27
                LD      HL, .BTNOK
                LD      A, (VCOLBSEL)   ; THE FOCUSED BUTTON: INVERSE ACCENT
                CALL    WINPUTS

                ; REDUMP THE WINDOW ROWS WITH THE TEXT IN
                CALL    WDUMP

                ; MODAL KEY LOOP
.KEYLP          CALL    WINPOLL
                JR      Z, .KEYLP
                CP      13              ; ENTER
                JR      Z, .DONE
                CP      ' '             ; SPACE
                JR      Z, .DONE
                CP      27              ; ESC
                JR      Z, .DONE
                JR      .KEYLP

.DONE           JP      WINCLOS

.TITABT         DEFM    "About S2ED", 0
.STRHDR         DEFM    "S2ED - MSX1 64-Col", 0
.STRSUB         DEFM    "Text Editor", 0
.STRVER         DEFB    "Version ", VERSION.MAJOR, '.', VERSION.MINOR, 0
.STRDSP         DEFM    "Display: 64x24", 0
.STRFNT         DEFM    "Font: 4x8 custom", 0
.STRMEM         DEFM    "Memory: DOS2/Nextor", 0
.BTNOK          DEFM    "[  OK  ]", 0


; --- DOQIT                     ----------------------------------------


; - DOQIT ------------------------------
; - QUIT CONFIRMATION DIALOG. TWO OPTIONS, DEFAULT NO, SO A STRAY ESC
; - CANNOT THROW THE DOCUMENT AWAY -- WHICH IS EXACTLY WHAT S2ED DID
; - UNTIL THIS EXISTED: ACTQUIT WENT STRAIGHT TO TERM.
; -
; - BUTTON GEOMETRY IS CELL-ALIGNED ON PURPOSE. A COLOR BYTE COVERS A
; - WHOLE CELL, SO AN 8-CHARACTER BUTTON STARTING ON AN EVEN COLUMN
; - OWNS EXACTLY FOUR CELLS AND ITS BAR HAS NO HALF CELL HANGING OFF
; - EITHER END.
; -
; - IN:  NONE
; - OUT: (WINRES) = 0 CANCELLED, 1 CONFIRMED
; - CLOBBERS: ALL
; -

DOQIT           LD      A, 8
                LD      (WINR), A
                LD      A, 9
                LD      (WINC), A
                LD      A, 8
                LD      (WINNR), A
                LD      A, 13
                LD      (WINNC), A
                LD      HL, .TITQIT
                CALL    WINOPEN

                ; DEFAULT: NO SELECTED, RESULT CANCELLED
                LD      A, 1
                LD      (WINSEL), A
                XOR     A
                LD      (WINRES), A

                ; MESSAGE LINE
                LD      B, 10
                LD      C, 20
                LD      HL, .STRQIT
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                ; WARNING LINE, ONLY WITH A DIRTY BUFFER
                LD      A, (MODIFIED)
                OR      A
                JR      Z, .NOWRN
                LD      B, 11
                LD      C, 20
                LD      HL, .STRWRN
                LD      A, (VCOLHI)
                CALL    WINPUTS

.NOWRN          CALL    .BTNS
                CALL    WDUMP

                ; MODAL KEY LOOP
.KEYLP          CALL    WINPOLL
                JR      Z, .KEYLP
                CP      ESC
                JR      Z, .DONE        ; CANCEL: WINRES IS ALREADY 0
                CP      CR
                JR      Z, .ACCEPT
                CP      ' '
                JR      Z, .ACCEPT
                CP      CLEFT
                JR      Z, .TOYES
                CP      CRIGHT
                JR      Z, .TONO
                CP      'Y'
                JR      Z, .YES
                CP      'y'
                JR      Z, .YES
                CP      'N'
                JR      Z, .DONE
                CP      'n'
                JR      Z, .DONE
                JR      .KEYLP

.TOYES          XOR     A
                JR      .NAV
.TONO           LD      A, 1
.NAV            LD      HL, WINSEL
                CP      (HL)
                JR      Z, .KEYLP       ; ALREADY THERE: NOTHING TO REPAINT
                LD      (HL), A
                CALL    .BTNS
                CALL    WDUMP
                JR      .KEYLP

.ACCEPT         LD      A, (WINSEL)
                XOR     1               ; YES (0) CONFIRMS, NO (1) CANCELS
                LD      (WINRES), A
                JR      .DONE

.YES            LD      A, 1
                LD      (WINRES), A

.DONE           JP      WINCLOS


; - .BTNS: BOTH BUTTONS, EACH IN THE ROLE ITS SELECTION STATE ASKS FOR.
; - THE SELECTED ONE WEARS VCOLBSEL (THE INVERSE ACCENT), THE OTHER
; - VCOLHI -- ON A TMS9918 A CELL IS ONE FG|BG BYTE, SO FOCUS CANNOT BE
; - A BORDER DRAWN INSIDE ONE WITHOUT CLIPPING THE GLYPH.

.BTNS           LD      A, (WINSEL)
                OR      A
                CALL    .ROLE           ; Z = YES IS SELECTED
                LD      B, 13
                LD      C, 22
                LD      HL, .BTNYES
                CALL    WINPUTS

                LD      A, (WINSEL)
                DEC     A
                CALL    .ROLE           ; Z = NO IS SELECTED
                LD      B, 13
                LD      C, 34
                LD      HL, .BTNNO
                JP      WINPUTS

; - .ROLE: A = COLOR FOR A BUTTON, GIVEN Z SET WHEN IT IS THE SELECTED ONE
.ROLE           JR      Z, .ROLSEL
                LD      A, (VCOLHI)
                RET
.ROLSEL         LD      A, (VCOLBSEL)
                RET

.TITQIT         DEFM    "Quit S2ED", 0
.STRQIT         DEFM    "Exit to MSX-DOS?", 0
.STRWRN         DEFM    "Unsaved changes!", 0
.BTNYES         DEFM    "[  YES ]", 0
.BTNNO          DEFM    "[  NO  ]", 0


; --- WINEDIT                   ----------------------------------------


; - WINEDIT ----------------------------
; - MODAL TEXT INPUT FIELD. RUNS ITS OWN KEY LOOP AND RETURNS WHEN THE
; - USER ACCEPTS OR CANCELS. THE CALLER HAS ALREADY OPENED THE WINDOW.
; - IN:  B = FIELD SCREEN ROW, C = FIELD CHAR COLUMN
; -      D = FIELD WIDTH IN CHARACTERS (1..INPMAX)
; -      E = CHARACTER CLASS (ED_DIGIT ONLY, FOR NOW)
; - OUT: CY = 1: CANCELLED.  CY = 0: ACCEPTED, (INPBUF) IS ASCIIZ AND
; -      (INPLEN) ITS LENGTH
; - CLOBBERS: ALL
; -
; - THE FOCUS HAS THREE POSITIONS -- THE FIELD, OK, CANCEL -- BECAUSE
; - SPACE MAY ONLY ACTIVATE THE FOCUSED CONTROL AND THE FIELD IS ONE. WITH
; - TWO POSITIONS SPACE WOULD HAVE TO MEAN "ACCEPT" WHILE SOMEBODY IS
; - TYPING INTO THE FIELD, WHICH IS FINE FOR DIGITS AND WRONG THE DAY A
; - CLASS ACCEPTS A SPACE.
; -
; - THE BUTTONS BELONG TO THE CALLER AND ARE PAINTED BY EDBTNS, WHICH
; - READS (WINSEL). THERE IS ONE DIALOG WITH A FIELD PER TARGET TODAY; THE
; - DAY THERE ARE TWO, EDBTNS BECOMES A POINTER PARAMETER.
; -

WINEDIT         LD      A, B
                LD      (EDROW), A
                LD      A, C
                LD      (EDCOL), A
                LD      A, D
                LD      (EDWID), A
                LD      A, E
                CP      ED_DIGIT
                SCF
                RET     NZ              ; CLASS NOT IMPLEMENTED: REFUSE

                XOR     A
                LD      (INPLEN), A
                LD      (INPBUF), A     ; ASCIIZ, EMPTY
                LD      (WINSEL), A     ; ED_FFLD
                CALL    EDFLD
                CALL    EDBTNS
                CALL    WDUMP

.KEYLP          CALL    WINPOLL
                JR      Z, .KEYLP

                CP      ESC
                JP      Z, .CANCEL
                CP      CR
                JP      Z, .ACCEPT
                CP      ' '
                JP      Z, .SPACE
                CP      TAB
                JR      Z, .NEXT
                CP      CRIGHT
                JR      Z, .NEXT
                CP      CLEFT
                JR      Z, .PREV

                ; FIELD KEYS ONLY REACH THE FIELD WHEN IT HAS THE FOCUS
                LD      C, A
                LD      A, (WINSEL)
                OR      A
                JR      NZ, .KEYLP
                LD      A, C
                CP      BS
                JR      Z, .BS
                CP      '0'
                JR      C, .KEYLP
                CP      '9' + 1
                JR      NC, .KEYLP

                ; APPEND, IF THERE IS ROOM
                LD      B, A            ; B = DIGIT
                LD      A, (INPLEN)
                LD      C, A
                LD      A, (EDWID)
                CP      C
                JR      Z, .KEYLP       ; FULL: IGNORED, SILENTLY
                LD      HL, INPBUF
                LD      E, C
                LD      D, 0
                ADD     HL, DE
                LD      (HL), B
                INC     HL
                LD      (HL), 0
                LD      A, C
                INC     A
                LD      (INPLEN), A
                JR      .REFLD

.BS             LD      A, (INPLEN)
                OR      A
                JR      Z, .KEYLP
                DEC     A
                LD      (INPLEN), A
                LD      E, A
                LD      D, 0
                LD      HL, INPBUF
                ADD     HL, DE
                LD      (HL), 0

.REFLD          CALL    EDFLD           ; ONE ROW, NOT THE WHOLE WINDOW
                LD      A, (EDROW)
                CALL    WDUMPR
                JR      .KEYLP

.NEXT           LD      A, (WINSEL)
                INC     A
                CP      3
                JR      C, .SETFOC
                XOR     A
                JR      .SETFOC
.PREV           LD      A, (WINSEL)
                OR      A
                JR      NZ, .PREVD
                LD      A, 3
.PREVD          DEC     A
.SETFOC         LD      (WINSEL), A
                CALL    EDFLD           ; THE CARET COMES AND GOES WITH FOCUS
                CALL    EDBTNS
                CALL    WDUMP
                JP      .KEYLP

.SPACE          LD      A, (WINSEL)
                OR      A
                JP      Z, .KEYLP       ; THE FIELD HAS IT: SPACE IS NOT A KEY

.ACCEPT         LD      A, (WINSEL)
                CP      ED_FCAN
                JR      Z, .CANCEL
                LD      A, (INPLEN)
                OR      A
                JR      Z, .CANCEL      ; AN EMPTY FIELD CANCELS
                RET                     ; CY = 0 FROM THE OR

.CANCEL         SCF
                RET


; - EDFLD ------------------------------
; - PAINT THE FIELD: WHAT HAS BEEN TYPED, THE CARET AT THE INSERTION POINT
; - WHEN THE FIELD HAS THE FOCUS, AND SPACES FOR THE REST. IT SPANS
; - EDWID + 1 COLUMNS, THE EXTRA ONE BEING WHERE THE CARET STANDS WHEN THE
; - FIELD IS FULL.
; - IN:  NONE (USES EDROW, EDCOL, EDWID, INPBUF, INPLEN, WINSEL)
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDFLD           LD      A, (EDWID)
                INC     A
                LD      B, A            ; B = COLUMNS TO PAINT
                LD      C, 0            ; C = INDEX
.LOOP           PUSH    BC
                LD      A, (INPLEN)
                CP      C
                JR      Z, .CARET
                JR      C, .BLANK
                ; A TYPED CHARACTER
                LD      HL, INPBUF
                LD      E, C
                LD      D, 0
                ADD     HL, DE
                LD      A, (HL)
                JR      .PUT
.CARET          LD      A, (WINSEL)
                OR      A
                LD      A, '_'
                JR      Z, .PUT         ; ONLY WHEN THE FIELD HAS THE FOCUS
.BLANK          LD      A, ' '
.PUT            PUSH    AF
                LD      A, (EDROW)
                LD      B, A
                LD      A, (EDCOL)
                ADD     A, C
                LD      C, A            ; C = SCREEN COLUMN
                LD      A, (VCOLTXT)
                LD      E, A
                POP     AF
                CALL    WINPUTC
                POP     BC
                INC     C
                DJNZ    .LOOP
                RET


; --- DOGOTO                    ----------------------------------------


; - DOGOTO -----------------------------
; - GO TO LINE. COLLECTS A LINE NUMBER; IT DOES NOT JUMP. THE JUMP IS
; - GOTOLN'S, IN PAGE 1, BECAUSE IT WRITES TOPLINE AND CALLS REDRAW.
; - IN:  NONE
; - OUT: CY = 1: CANCELLED.  CY = 0: HL = THE LINE TYPED, 1-BASED AND
; -      UNCLAMPED -- CLAMPING NEEDS TOTLINES AND BELONGS WITH THE JUMP
; - CLOBBERS: ALL
; -

DOGOTO          LD      A, 8
                LD      (WINR), A
                LD      A, 8
                LD      (WINC), A
                LD      A, 7
                LD      (WINNR), A
                LD      A, 15
                LD      (WINNC), A
                LD      HL, .TITGO
                CALL    WINOPEN

                ; "Line number (1-NNNN):" IN THREE PIECES. B2D16 HANDS BACK
                ; HL AT THE FIRST DIGIT AND C THE COUNT, SO NO PROMPT BUFFER
                ; IS NEEDED -- ONLY A TERMINATOR WRITTEN INTO ITS OWN BUFFER,
                ; WHICH IT DOCUMENTS AS FREE TO MODIFY.
                LD      B, 10
                LD      C, 18
                LD      HL, .STRPR1
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      HL, (TOTLINES)
                CALL    B2D16
                LD      B, 0
                PUSH    HL
                PUSH    BC
                ADD     HL, BC
                LD      (HL), 0
                POP     BC
                POP     HL
                PUSH    BC              ; KEEP THE DIGIT COUNT
                LD      B, 10
                LD      C, 33
                LD      A, (VCOLWIN)
                CALL    WINPUTS
                POP     BC
                LD      A, C
                ADD     A, 33
                LD      C, A            ; RIGHT AFTER THE DIGITS
                LD      B, 10
                LD      HL, .STRPR2
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      B, 11
                LD      C, 20
                LD      D, INPMAX
                LD      E, ED_DIGIT
                CALL    WINEDIT

                PUSH    AF
                CALL    WINCLOS
                POP     AF
                RET     C               ; CANCELLED

                LD      HL, INPBUF
                CALL    ATOI16
                OR      A               ; CY = 0: ACCEPTED
                RET

.TITGO          DEFM    "Go to Line", 0
.STRPR1         DEFM    "Line number (1-", 0
.STRPR2         DEFM    "):", 0


; - EDBTNS -----------------------------
; - PAINT THE TWO BUTTONS IN THE ROLE (WINSEL) ASKS FOR. THE WIDGET CALLS
; - THIS BY NAME: THERE IS ONE DIALOG WITH A FIELD PER TARGET TODAY.
; - IN:  NONE (USES WINSEL)
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDBTNS          LD      A, (WINSEL)
                CP      ED_FOK
                CALL    .ROLE
                LD      B, 13
                LD      C, 20
                LD      HL, .BTNOK
                CALL    WINPUTS

                LD      A, (WINSEL)
                CP      ED_FCAN
                CALL    .ROLE
                LD      B, 13
                LD      C, 32
                LD      HL, .BTNCAN
                JP      WINPUTS

; - .ROLE: A = COLOR FOR A BUTTON, GIVEN Z SET WHEN IT IS THE FOCUSED ONE
.ROLE           JR      Z, .ROLSEL
                LD      A, (VCOLHI)
                RET
.ROLSEL         LD      A, (VCOLBSEL)
                RET

.BTNOK          DEFM    "[  OK  ]", 0
.BTNCAN         DEFM    "[CANCEL]", 0


; --- DOFIND                    ----------------------------------------


; - DOFIND -----------------------------
; - FIND & REPLACE DIALOG (PHASED IN FTRBASE VIA FCALL).
; - COLLECTS SEARCH PATTERN, REPLACE PATTERN, OPTIONS AND ACTION.
; - IN:  NONE
; - OUT: CY = 1: CANCELLED
; -      CY = 0: A = ACTION (SRCH_FND, SRCH_RPL, SRCH_ALL)
; - CLOBBERS: ALL
; -

DOFIND          LD      A, 8
                LD      (WINR), A
                LD      A, 7
                LD      (WINC), A
                LD      A, 7
                LD      (WINNR), A
                LD      A, 18
                LD      (WINNC), A
                LD      HL, .TITFND
                CALL    WINOPEN

                XOR     A
                LD      (FNDFOC), A     ; DEFAULT FOCUS: FIND FIELD
                CALL    .DRWUI
                CALL    WDUMP

.KEYLP          CALL    WINPOLL
                JR      Z, .KEYLP

                CP      ESC
                JP      Z, .CANCEL
                CP      TAB
                JR      Z, .NEXT
                CP      CDOWN
                JR      Z, .NEXT
                CP      CUP
                JR      Z, .PREV
                CP      CRIGHT
                JR      Z, .RGTKEY
                CP      CLEFT
                JR      Z, .LFTKEY

                ; ROUTE KEYS ACCORDING TO FOCUSED CONTROL
                LD      B, A            ; B = KEY
                LD      A, (FNDFOC)
                OR      A
                JP      Z, .FOCFND      ; 0: FIND FIELD
                DEC     A
                JP      Z, .FOCRPL      ; 1: REPLACE FIELD
                DEC     A
                JP      Z, .FOCCAS      ; 2: CASE OPTION
                ; 3..6: BUTTONS
                JP      .FOCBTN

.NEXT           LD      A, (FNDFOC)
                INC     A
                CP      7
                JR      C, .SETFOC
                XOR     A
                JR      .SETFOC

.PREV           LD      A, (FNDFOC)
                OR      A
                JR      NZ, .PREVD
                LD      A, 7
.PREVD          DEC     A
.SETFOC         LD      (FNDFOC), A
                CALL    .DRWUI
                CALL    WDUMP
                JP      .KEYLP

.RGTKEY         LD      A, (FNDFOC)
                CP      3
                JP      C, .KEYLP       ; ONLY ON BUTTONS
                INC     A
                CP      7
                JR      C, .SETFOC
                LD      A, 3
                JR      .SETFOC

.LFTKEY         LD      A, (FNDFOC)
                CP      3
                JP      C, .KEYLP       ; ONLY ON BUTTONS
                DEC     A
                CP      3
                JR      NC, .SETFOC
                LD      A, 6
                JR      .SETFOC

.FOCFND         ; FIELD 0: FIND FIELD
                LD      A, B
                CP      CR
                JP      Z, .DOACT0      ; ENTER ON FIND: IMMEDIATE FIND NEXT
                CP      BS
                JR      Z, .BS0
                ; PRINTABLE CHAR
                CP      ' '
                JP      C, .KEYLP
                LD      A, (SRCHLEN)
                CP      SRCHMAX
                JP      NC, .KEYLP      ; FULL
                LD      E, A
                LD      D, 0
                LD      HL, SRCHPAT
                ADD     HL, DE
                LD      (HL), B
                INC     HL
                LD      (HL), 0
                INC     A
                LD      (SRCHLEN), A
                CALL    .DRWUI
                CALL    WDUMP
                JP      .KEYLP

.BS0            LD      A, (SRCHLEN)
                OR      A
                JP      Z, .KEYLP
                DEC     A
                LD      (SRCHLEN), A
                LD      E, A
                LD      D, 0
                LD      HL, SRCHPAT
                ADD     HL, DE
                LD      (HL), 0
                CALL    .DRWUI
                CALL    WDUMP
                JP      .KEYLP

.FOCRPL         ; FIELD 1: REPLACE FIELD
                LD      A, B
                CP      CR
                JP      Z, .DOACT0      ; ENTER ON REPLACE: FIND NEXT
                CP      BS
                JR      Z, .BS1
                CP      ' '
                JP      C, .KEYLP
                LD      A, (RPLCLEN)
                CP      SRCHMAX
                JP      NC, .KEYLP
                LD      E, A
                LD      D, 0
                LD      HL, RPLCPAT
                ADD     HL, DE
                LD      (HL), B
                INC     HL
                LD      (HL), 0
                INC     A
                LD      (RPLCLEN), A
                CALL    .DRWUI
                CALL    WDUMP
                JP      .KEYLP

.BS1            LD      A, (RPLCLEN)
                OR      A
                JP      Z, .KEYLP
                DEC     A
                LD      (RPLCLEN), A
                LD      E, A
                LD      D, 0
                LD      HL, RPLCPAT
                ADD     HL, DE
                LD      (HL), 0
                CALL    .DRWUI
                CALL    WDUMP
                JP      .KEYLP

.FOCCAS         ; CONTROL 2: CASE OPTION
                LD      A, B
                CP      ' '
                JR      Z, .TOGCAS
                CP      CR
                JP      NZ, .KEYLP
.TOGCAS         LD      A, (SRCHOPT)
                XOR     1
                LD      (SRCHOPT), A
                CALL    .DRWUI
                CALL    WDUMP
                JP      .KEYLP

.FOCBTN         ; CONTROLS 3..6: BUTTONS
                LD      A, B
                CP      ' '
                JR      Z, .ACTBTN
                CP      CR
                JP      NZ, .KEYLP
.ACTBTN         LD      A, (FNDFOC)
                CP      3
                JP      Z, .DOACT0      ; [Find]
                CP      4
                JP      Z, .DOACT1      ; [Repl]
                CP      5
                JP      Z, .DOACT2      ; [All]
                ; 6: [Cancel]
.CANCEL         CALL    WINCLOS
                SCF
                RET

.DOACT0         ; ACCEPT: FIND NEXT
                CALL    WINCLOS
                LD      A, (SRCHLEN)
                OR      A
                SCF
                RET     Z               ; EMPTY SEARCH PATTERN: CANCEL
                LD      A, SRCH_FND
                AND     A               ; CY = 0
                RET

.DOACT1         ; ACCEPT: REPLACE
                CALL    WINCLOS
                LD      A, (SRCHLEN)
                OR      A
                SCF
                RET     Z
                LD      A, SRCH_RPL
                AND     A
                RET

.DOACT2         ; ACCEPT: REPLACE ALL
                CALL    WINCLOS
                LD      A, (SRCHLEN)
                OR      A
                SCF
                RET     Z
                LD      A, SRCH_ALL
                AND     A
                RET

.DRWUI          ; DUMP ALL LABELS, FIELDS AND BUTTONS INTO SHADOW
                ; 1. FIND LABEL (ROW 9, COL 16)
                LD      A, (FNDFOC)
                OR      A
                LD      A, (VCOLWIN)
                JR      NZ, .FNDNLB
                LD      A, (VCOLHI)     ; HIGHLIGHT LABEL WHEN FOCUSED
.FNDNLB         LD      B, 9
                LD      C, 16
                LD      HL, .LBLFND
                CALL    WINPUTS

                ; 2. DRAW FIELD 0 (FIND)
                LD      A, 9
                LD      (FNDROW), A
                LD      HL, SRCHPAT
                LD      (FNDBUF), HL
                LD      A, (SRCHLEN)
                LD      (FNDLEN), A
                LD      A, (FNDFOC)
                OR      A
                LD      A, 0
                JR      NZ, .FNDNFA
                INC     A               ; FNDACT = 1 IF FOCUSED
.FNDNFA         LD      (FNDACT), A
                CALL    .DRWFLD

                ; 3. REPLACE LABEL (ROW 10, COL 16)
                LD      A, (FNDFOC)
                DEC     A
                LD      A, (VCOLWIN)
                JR      NZ, .RPLNLB
                LD      A, (VCOLHI)     ; HIGHLIGHT LABEL WHEN FOCUSED
.RPLNLB         LD      B, 10
                LD      C, 16
                LD      HL, .LBLRPL
                CALL    WINPUTS

                ; 4. DRAW FIELD 1 (REPLACE)
                LD      A, 10
                LD      (FNDROW), A
                LD      HL, RPLCPAT
                LD      (FNDBUF), HL
                LD      A, (RPLCLEN)
                LD      (FNDLEN), A
                LD      A, (FNDFOC)
                DEC     A
                LD      A, 0
                JR      NZ, .RPLNFA
                INC     A               ; FNDACT = 1 IF FOCUSED
.RPLNFA         LD      (FNDACT), A
                CALL    .DRWFLD

                ; 5. DRAW CASE OPTION (ROW 11, COL 16)
                LD      B, 11
                LD      C, 16
                LD      HL, .LBLCAS
                LD      A, (VCOLWIN)
                CALL    WINPUTS

                LD      A, (SRCHOPT)
                BIT     0, A
                LD      A, ' '
                JR      Z, .NOCAS
                LD      A, 'X'
.NOCAS          PUSH    AF
                LD      A, (FNDFOC)
                CP      2
                LD      A, (VCOLHI)
                JR      NZ, .CASNSEL
                LD      A, (VCOLBSEL)
.CASNSEL        LD      E, A
                POP     AF
                LD      B, 11
                LD      C, 29
                CALL    WINPUTC
                LD      A, (VCOLWIN)
                LD      E, A
                LD      A, ']'
                LD      B, 11
                LD      C, 30
                CALL    WINPUTC

                ; 6. DRAW BUTTONS AT ROW 12
                LD      B, 12
                LD      C, 16
                LD      HL, .BTNFND
                LD      A, (FNDFOC)
                CP      3
                CALL    .ROLE
                CALL    WINPUTS

                LD      B, 12
                LD      C, 24
                LD      HL, .BTNRPL
                LD      A, (FNDFOC)
                CP      4
                CALL    .ROLE
                CALL    WINPUTS

                LD      B, 12
                LD      C, 32
                LD      HL, .BTNALL
                LD      A, (FNDFOC)
                CP      5
                CALL    .ROLE
                CALL    WINPUTS

                LD      B, 12
                LD      C, 39
                LD      HL, .BTNCAN
                LD      A, (FNDFOC)
                CP      6
                CALL    .ROLE
                JP      WINPUTS

.DRWFLD         ; DRAW 18-CHAR FIELD AT (FNDROW), COLS 24..41
                ; USES FNDROW, FNDBUF, FNDLEN, FNDACT, FNDCOL
                LD      A, (FNDACT)
                OR      A
                LD      A, (VCOLWIN)
                JR      Z, .SETCOL
                LD      A, (VCOLTXT)
.SETCOL         LD      (FNDCOL), A     ; COLOR FOR THE FIELD CELLS

                LD      A, (FNDROW)
                LD      B, A            ; B = ROW
                LD      C, 24           ; C = START COL (24)

.FLOOP          ; COMPUTE INDEX = C - 24
                LD      A, C
                SUB     24              ; A = INDEX (0..17)
                LD      D, A            ; D = INDEX
                LD      A, (FNDLEN)
                CP      D
                JR      C, .ISPAC       ; INDEX > FNDLEN: SPACE
                JR      Z, .ISCRT       ; INDEX == FNDLEN: CARET OR SPACE
                ; INDEX < FNDLEN: CHAR FROM BUFFER
                LD      HL, (FNDBUF)
                LD      E, D
                LD      D, 0
                ADD     HL, DE
                LD      A, (HL)
                JR      .IDRAW

.ISCRT          LD      A, (FNDACT)
                OR      A
                LD      A, ' '
                JR      Z, .IDRAW
                LD      A, #DB          ; SOLID BLOCK CARET
                JR      .IDRAW

.ISPAC          LD      A, ' '

.IDRAW          PUSH    AF              ; SAVE CHAR ON STACK
                LD      A, (FNDCOL)
                LD      E, A            ; E = COLOR
                POP     AF              ; RESTORE CHAR
                CALL    WINPUTC         ; PRESERVES BC!
                INC     C               ; NEXT COLUMN
                LD      A, C
                CP      42              ; 24 + 18 = 42
                JR      NZ, .FLOOP
                RET

.ROLE           JR      Z, .ROLSEL
                LD      A, (VCOLHI)
                RET
.ROLSEL         LD      A, (VCOLBSEL)
                RET

.TITFND         DEFM    "Find & Replace", 0
.LBLFND         DEFM    "Find:   ", 0
.LBLRPL         DEFM    "Replace:", 0
.LBLCAS         DEFM    "Match case: [", 0
.BTNFND         DEFM    "[Find]", 0
.BTNRPL         DEFM    "[Repl]", 0
.BTNALL         DEFM    "[All]", 0
.BTNCAN         DEFM    "[Cancel]", 0
