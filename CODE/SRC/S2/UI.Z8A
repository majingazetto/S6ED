;                                       ****************************************
;                                       * UI DRIVER (SCREEN 2 / TMS9918)       *
;                                       ****************************************
;
; STATUS BAR ON ROW 23, MENU BAR ON ROW 0.
; CURSOR AND SELECTION HIGHLIGHTS GO THROUGH PATINV, WHICH XORS THE FOUR
; PIXEL COLUMNS A TEXT COLUMN OWNS INSIDE ITS CELL. THEY USED TO SWAP THE
; CELL'S COLOR NIBBLES INSTEAD, BUT THE COLOR TABLE ADDRESSES 8X1 SLICES AND
; CANNOT INVERT HALF A CELL: THE CURSOR COVERED TWO CHARACTERS, AND SELDIFF'S
; ONE-COLUMN DELTAS LANDED ON THE SAME CELL TWICE AND CANCELLED EACH OTHER.


; --- DRWSTAT                   ----------------------------------------


; - DRWSTAT ----------------------------
; - DRAW / REFRESH STATUS BAR (ROW 23)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWSTAT         LD      A, (MODIFIED)
                LD      HL, MODPRV
                CP      (HL)
                JR      Z, .MODSAM
                LD      (HL), A
                PUSH    AF
                CALL    DRWMENU
                POP     AF
.MODSAM         CALL    BLDSTAT         ; BUILD STRING IN STATBUF

                ; PAD STATBUF WITH SPACES TO 64 CHARACTERS
                LD      HL, STATBUF
                LD      B, 0
.FNDEND         LD      A, (HL)
                OR      A
                JR      Z, .PADLP
                INC     HL
                INC     B
                LD      A, B
                CP      SCRCOLS
                JR      C, .FNDEND
                JR      .COMSTAT

                ; RELOAD THE SPACE EVERY PASS: THE BOUND CHECK BELOW
                ; NEEDS A, SO THE LOOP MUST RE-ENTER AT .PADLP
.PADLP          LD      A, ' '
                LD      (HL), A
                INC     HL
                INC     B
                LD      A, B
                CP      SCRCOLS
                JR      C, .PADLP

.COMSTAT        CALL    VIDBANK

                ; COMPOSE 32 CELLS INTO PATSHAD + 23 * 256
                LD      HL, PATSHAD + STBROW * ROWLEN
                PUSH    HL
                POP     IX
                LD      HL, COLMAP + STBROW * CELLROW
                PUSH    HL
                POP     IY

                LD      HL, STATBUF
                LD      B, 32           ; 32 CELLS
.STATLP         PUSH    BC
                LD      A, (HL)         ; LEFT CHAR
                INC     HL
                LD      C, (HL)         ; RIGHT CHAR
                INC     HL
                PUSH    HL

                CALL    CELLPAT         ; THE TWO GLYPHS INTO PATSHAD

                ; STATUS BAR HAS ITS OWN ROLE, DISTINCT FROM THE MENU BAR
                LD      A, (VCOLSTAT)
                LD      (IY+0), A
                INC     IY

                POP     HL
                POP     BC
                DJNZ    .STATLP

                ; DUMP STATUS BAR PATTERNS AND COLORS TO VRAM
                LD      HL, PATSHAD + STBROW * ROWLEN
                LD      DE, PGBASE + STBROW * ROWLEN
                LD      BC, ROWLEN
                CALL    VDPDUMP

                LD      B, STBROW
                CALL    COLDUMP

                JP      TXTBANK




; --- BLDSTAT                   ----------------------------------------


; - BLDSTAT ----------------------------
; - BUILD DYNAMIC STATUS BAR TEXT IN STATBUF (64 COLS)
; - LEFT CHANNEL (COLS 0..27): SYSTEM/VI MESSAGES, FILENAME
; - RIGHT CHANNEL (COLS 28..63): COMPACT FLAGS, VI MODE, LN/COL TELEMETRY
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLDSTAT         ; 1. PRE-FILL STATBUF WITH 64 SPACES, FOLLOWED BY NULL TERMINATOR
                LD      HL, STATBUF
                LD      (HL), ' '
                LD      DE, STATBUF + 1
                LD      BC, SCRCOLS - 1
                LDIR
                XOR     A
                LD      (STATBUF + SCRCOLS), A ; NULL TERMINATOR AT 64

                ; 2. LEFT CHANNEL: COLS 0..34 (MAX 35 CHARACTERS)
                LD      DE, STATBUF
                LD      A, (STATMSG)
                OR      A
                JR      Z, .NOSTMSG
                LD      HL, STATMSG
                LD      B, 35
                CALL    .CPYMAX
                JR      .DOLEFT

.NOSTMSG        LD      A, (LOADERR)
                OR      A
                JR      Z, .DOLEFT
                LD      HL, .STROOM     ; "[FILE TOO LARGE]"
                LD      B, 35
                CALL    .CPYMAX
                JR      .DOLEFT

.DOLEFT         ; 3. RIGHT CHANNEL AT FIXED OFFSET 35 (COLS 35..62 = 28 CHARS)
                LD      DE, STATBUF + 35

                ; A. MODE INDICATOR: 6 CHARS (COLS 35..40)
                LD      A, (KMAPID)
                CP      KMVI
                JR      NZ, .NOTVI
                LD      A, (SELACT)
                OR      A
                LD      HL, .STRVIV     ; "[VIS] "
                JR      NZ, .PUTVI
                LD      A, (VIMODE)
                CP      VIMNORM
                LD      HL, .STRVIN     ; "[NORM]"
                JR      Z, .PUTVI
                LD      HL, .STRVII     ; "[INS] "
.PUTVI          CALL    .CPY6
                JR      .DONEMOD

.NOTVI          LD      A, (SELACT)
                OR      A
                LD      HL, .STRSEL     ; "[SEL] "
                JR      NZ, .PUTNVI
                LD      A, (INSMODE)
                OR      A
                LD      HL, .STROVR     ; "[OVR] "
                JR      Z, .PUTNVI
                LD      HL, .STRVII     ; "[INS] "
.PUTNVI         CALL    .CPY6
.DONEMOD
                ; B. 1 SPACE SEPARATOR (COL 41)
                LD      A, ' '
                LD      (DE), A
                INC     DE

                ; C. CURSOR POSITION: 21 CHARS (COLS 42..62)
                LD      HL, .STRLN      ; "Ln "
                CALL    .CPY3
                LD      HL, (DOCLINE)
                INC     HL
                LD      B, 5
                CALL    .CPYNUM
                LD      A, '/'
                LD      (DE), A
                INC     DE
                LD      HL, (TOTLINES)
                LD      B, 5
                CALL    .CPYNUM
                LD      HL, .STRCOL     ; " Col "
                CALL    .CPY5
                LD      A, (CURX)
                INC     A
                LD      L, A
                LD      H, 0
                LD      B, 2
                CALL    .CPYNUM
                RET

.CPY6           LDI
.CPY5           LDI
.CPY4           LDI
.CPY3           LDI
                LDI
                LDI
                RET

.CPYMAX         LD      A, B
                OR      A
                RET     Z
                LD      A, (HL)
                OR      A
                RET     Z
                LD      (DE), A
                INC     HL
                INC     DE
                DEC     B
                JR      .CPYMAX

.CPYNUM         PUSH    DE
                PUSH    BC
                CALL    B2D16
                POP     BC
                POP     DE
                LD      HL, B2DEND
                LD      A, L
                SUB     B
                LD      L, A
                JR      NC, .CPYNUM2
                DEC     H
.CPYNUM2        LD      A, (HL)
                CP      ' '
                JR      NZ, .CPYNUM3
                LD      A, '0'
.CPYNUM3        LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .CPYNUM2
                RET

.STRVIN         DEFM    "[NORM]"
.STRVII         DEFM    "[INS] "
.STRVIV         DEFM    "[VIS] "
.STROVR         DEFM    "[OVR] "
.STRSEL         DEFM    "[SEL] "
.STRLN          DEFM    "Ln "
.STRCOL         DEFM    " Col "
.STROOM         DEFM    "[FILE TOO LARGE]", 0




; --- DRWFNAM                   ----------------------------------------


; - DRWFNAM ----------------------------
; - DRAW FILENAME REGION IN ROW 0 (ALIAS TO DRWMENU ON S2)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWFNAM         JP      DRWMENU




; --- DRWMENU                   ----------------------------------------


; - DRWMENU ----------------------------
; - DRAW MENU BAR (ROW 0)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWMENU         ; 1. BLANK STATBUF, THEN LAY THE MENU TITLES OVER IT. THE
                ; TEMPLATE CARRIES ONLY THE TITLES: ITS 41 TRAILING SPACES COST
                ; MORE BYTES AS DATA THAN THE FILL COSTS AS CODE.
                LD      HL, STATBUF
                LD      (HL), ' '
                LD      DE, STATBUF + 1
                LD      BC, SCRCOLS - 1
                LDIR
                LD      HL, .MNUTXT
                LD      DE, STATBUF
                LD      BC, .MNUEND - .MNUTXT
                LDIR

                ; 2. FORMAT CLOCK AT COLS 58..62 IF SHOWCLK ENABLED
                LD      A, (SHOWCLK)
                OR      A
                JR      Z, .NOCLK
                LD      C, _GTIME       ; #2C
                CALL    DOS             ; H = HOURS, L = MINUTES, D = SECONDS
                LD      A, H
                CALL    DECDIG2
                LD      A, D
                LD      (STATBUF + 58), A
                LD      A, E
                LD      (STATBUF + 59), A
                LD      A, (CLKPH)
                OR      A
                LD      A, ':'
                JR      Z, .SETCOL
                LD      A, ' '
.SETCOL         LD      (STATBUF + 60), A
                LD      A, L
                CALL    DECDIG2
                LD      A, D
                LD      (STATBUF + 61), A
                LD      A, E
                LD      (STATBUF + 62), A

.NOCLK          ; 3. POPULATE FNAMBUF. DE MUST HOLD FNAMBUF BEFORE THE
                ; EMPTY-NAME EXIT: .CHKEND MEASURES THE STRING AS DE - FNAMBUF
                LD      DE, FNAMBUF
                LD      A, (FILENAME)
                OR      A
                JR      NZ, .HAVEFN
                ; NO FILENAME: IF MODIFIED, USE "Untitled"
                LD      A, (MODIFIED)
                OR      A
                JR      Z, .CHKEND      ; EMPTY FNAMBUF, LENGTH 0
                LD      HL, .STRUNT     ; "Untitled"
                CALL    .CPYSTR
                JR      .CHKMOD

.HAVEFN         ; EXTRACT BASENAME (CAPPED AT 20 CHARS)
                CALL    FNBASE          ; HL = BASENAME, CLOBBERS AF, DE
                LD      DE, FNAMBUF
                LD      B, 20
.FNBLP          LD      A, (HL)
                OR      A
                JR      Z, .CHKMOD
                LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .FNBLP

.CHKMOD         ; APPEND " *" IF MODIFIED
                LD      A, (MODIFIED)
                OR      A
                JR      Z, .CHKCLK
                LD      HL, .STRMOD     ; " *"
                CALL    .CPYSTR

.CHKCLK         ; APPEND " | " IF SHOWCLK
                LD      A, (SHOWCLK)
                OR      A
                JR      Z, .TERMFN
                LD      HL, .STRCLK     ; " | "
                CALL    .CPYSTR

.TERMFN         XOR     A
                LD      (DE), A         ; NULL TERMINATOR

.CHKEND         ; 4. COMPUTE LENGTH OF STRING IN FNAMBUF: DE - FNAMBUF
                EX      DE, HL
                LD      DE, FNAMBUF
                OR      A
                SBC     HL, DE          ; HL = LENGTH
                LD      A, L
                OR      A
                JR      Z, .NODRAW      ; NOTHING TO DRAW FROM FNAMBUF
                LD      B, A            ; B = LENGTH (1..35)

                ; END COL: 58 (IF SHOWCLK) OR 63 (IF NO CLK)
                LD      A, 63
                LD      HL, SHOWCLK
                BIT     0, (HL)
                JR      Z, .HAVEND
                LD      A, 58
.HAVEND         SUB     B               ; A = START COLUMN IN STATBUF
                LD      E, A
                LD      D, 0
                LD      HL, STATBUF
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION IN STATBUF
                LD      HL, FNAMBUF     ; HL = SOURCE
                LD      C, B
                LD      B, 0
                LDIR

.NODRAW         CALL    VIDBANK

                ; 5. FILL ROW 0 PATTERNS AND COLORS FROM STATBUF
                LD      HL, STATBUF
                LD      DE, PATSHAD
                PUSH    DE
                POP     IX
                LD      DE, COLMAP
                PUSH    DE
                POP     IY

                LD      B, 32
.MNULP          PUSH    BC
                LD      A, (HL)
                INC     HL
                LD      C, (HL)
                INC     HL
                PUSH    HL

                CALL    CELLPAT         ; THE TWO GLYPHS INTO PATSHAD

                ; ROW 0 USES THE UI THEME COLOR
                LD      A, (VCOLUI)
                LD      (IY+0), A
                INC     IY

                POP     HL
                POP     BC
                DJNZ    .MNULP

                ; DUMP ROW 0 TO VRAM
                LD      HL, PATSHAD
                LD      DE, PGBASE
                LD      BC, ROWLEN
                CALL    VDPDUMP

                LD      B, MNUROW
                CALL    COLDUMP

                LD      A, (MODIFIED)
                LD      (MODPRV), A

                JP      TXTBANK

.CPYSTR         LD      A, (HL)
                OR      A
                RET     Z
                LD      (DE), A
                INC     HL
                INC     DE
                JR      .CPYSTR

.STRUNT         DEFM    "Untitled", 0
.STRMOD         DEFM    " *", 0
.STRCLK         DEFM    " | ", 0
.MNUTXT         DEFM    "S2ED | File  Edit  Help"
.MNUEND




; --- DRWCUR                    ----------------------------------------


; - DRWCUR -----------------------------
; - TOGGLE CURSOR COLOR NIBBLES AT (CURX, CURY)
; - IN:  NONE (USES CURX, CURY)
; - OUT: NONE
; - CLOBBERS: NONE
; -

DRWCUR          PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL
                PUSH    IX

                LD      A, (CURX)
                LD      HL, LEFTCOL
                SUB     (HL)            ; A = CURX - LEFTCOL
                JR      C, .OFFSCR      ; CURX < LEFTCOL
                CP      TEXTCOLS
                JR      NC, .OFFSCR     ; CURX >= LEFTCOL + TEXTCOLS
                LD      C, A            ; C = SCREEN_X

                CALL    VIDBANK

                ; ONE COLUMN AT (SCREEN_X, CURY + 1)
                LD      A, (CURY)
                INC     A
                LD      H, A            ; H = SCREEN ROW (1..22)
                LD      B, 1
                CALL    PATINV

                CALL    TXTBANK

.OFFSCR         POP     IX
                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET




; --- SELXOR                    ----------------------------------------


; - SELXOR -----------------------------
; - INVERT SELECTION RANGE ON SCREEN ROW B
; - IN:  B = SCREEN ROW (0..21 RELATIVE TO VIEWPORT), D = XA, E = XB
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELXOR          LD      A, E
                SUB     D               ; A = COLUMN COUNT
                RET     Z               ; EMPTY RANGE
                RET     C

                PUSH    AF              ; SAVE COLUMN COUNT
                CALL    VIDBANK

                LD      A, B
                INC     A               ; SCREEN ROW = B + 1 (1..22)
                LD      C, D            ; C = FIRST COLUMN
                LD      H, A            ; H = SCREEN ROW
                POP     AF
                LD      B, A            ; B = COLUMN COUNT
                CALL    PATINV

                JP      TXTBANK




; --- CHKCLK                    ----------------------------------------


; - CHKCLK -----------------------------
; - TEST IF CLOCK / COLON NEEDS REDRAW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

CHKCLK          LD      A, (SHOWCLK)
                OR      A
                RET     Z

                LD      A, (WINACTV)
                OR      A
                RET     NZ

                LD      HL, (JIFFY)
                LD      DE, (CLKJIF)
                OR      A
                SBC     HL, DE          ; HL = FRAMES SINCE THE LAST TOGGLE
                LD      A, (CLKHZ)
                LD      E, A
                LD      D, 0
                OR      A
                SBC     HL, DE
                RET     C               ; LESS THAN ONE SECOND

                ; 1 SECOND ELAPSED: RESTAMP
                LD      HL, (JIFFY)
                LD      (CLKJIF), HL

                ; TOGGLE COLON PHASE (0 = ON, 1 = OFF)
                LD      A, (CLKPH)
                XOR     1
                LD      (CLKPH), A

                JP      DRWMENU




; --- DECDIG2                   ----------------------------------------


; - DECDIG2 ----------------------------
; - CONVERT 8-BIT INT (0..59) TO 2 ASCII DIGITS
; - IN:  A = VALUE (0..59)
; - OUT: D = TENS ASCII, E = UNITS ASCII
; - CLOBBERS: A, D, E
; -

DECDIG2         LD      D, '0'
.DECLP          CP      10
                JR      C, .DECDON
                SUB     10
                INC     D
                JR      .DECLP
.DECDON         ADD     A, '0'
                LD      E, A
                RET




; --- WINPOLL / WINKIL          ----------------------------------------


; - WINPOLL ----------------------------
; - POLL KEYBOARD FOR MODAL DIALOGS
; - IN:  NONE
; - OUT: Z  = NO KEY PRESSED, NZ = KEY PRESSED (A = ASCII CODE)
; - CLOBBERS: ALL
; -

WINPOLL         CALL    CHKCLK
                LD      IX, CHSNS
                CALL    BIOSCALL
                RET     Z
                LD      IX, CHGET
                CALL    BIOSCALL
                ; CHGET RETURNS THE KEY IN A AND NO FLAG AT ALL: WHEN ITS
                ; POINTER WRAPS FROM THE END OF THE 40-BYTE KEYBOARD BUFFER
                ; ITS LAST COMPARE LEAVES Z SET, AND A CALLER TESTING Z FOR
                ; "NO KEY" DROPPED ONE KEYSTROKE IN FORTY -- IN EVERY DIALOG.
                ; MEASURED IN THE FILE BROWSER, 2026-09-29.
                LD      C, A
                XOR     A
                INC     A               ; NZ: A KEY
                LD      A, C
                RET




; - WINKIL -----------------------------
; - FLUSH KEYBOARD BUFFER VIA BIOS KILBUF
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINKIL          LD      IX, KILBUF
                JP      BIOSCALL
