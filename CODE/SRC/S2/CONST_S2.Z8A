;                                       ****************************************
;                                       * SCREEN 2 CONSTANTS (TMS9918)         *
;                                       ****************************************


; --- SCREEN LAYOUT             ----------------------------------------


                ; CHARACTER GRID: 64 COLS X 24 ROWS (2 CHARS PER 8X8 CELL),
                ; OF WHICH THE TEXT USES 61 (TXCOL0 .. 62)
                ; SCRROWS IS THE PHYSICAL SCREEN, ROWSVIS THE TEXT BAND
                ; INSIDE IT. ON S6ED THEY ARE THE SAME NUMBER; HERE THEY
                ; ARE NOT, AND CORE MUST BOUND THE CURSOR WITH ROWSVIS --
                ; WITH SCRROWS THE CURSOR REACHES TWO ROWS BELOW THE BAND
                ; AND DRWCUR WRITES PAST THE COLOR TABLE.
SCRCOLS         EQU     64              ; SCREEN COLUMNS (MENU, STATUS, WINDOWS)
SCRROWS         EQU     24              ; PHYSICAL SCREEN ROWS (0-23)
CELLW           EQU     4               ; CELL WIDTH IN PIXELS
CELLH           EQU     8               ; CELL HEIGHT IN PIXELS
TEXTCOLS        EQU     61              ; TEXT VIEWPORT COLUMNS FOR S2
LINEREC         EQU     1 + TEXTCOLS + TEXTCOLS ; MAX LINE RECORD FOR S2 (123 BYTES)

                ; THE TEXT STARTS ONE CELL IN: THE FIRST CELL OF EVERY TEXT
                ; ROW IS A GUTTER, KEPT FOR LINE MARKS AND NUMBERS -- A WHOLE
                ; CELL, SO WHATEVER GOES THERE OWNS ITS COLOR (A COLOR BYTE
                ; COVERS ONE CELL, TWO CHARACTERS). CELL ALIGNED, SO TEXT
                ; COLUMN C STAYS IN THE SAME HALF OF ITS CELL AS ON A 64-COLUMN
                ; ROW. ON THE RIGHT ONE 4 PX COLUMN STAYS BLANK, SO THE TEXT
                ; ENDS ON COLUMN 62 WITH THE CLOCK AND THE STATUS BAR (THE
                ; EDGE OF A CRT EATS COLUMN 63). THE LAST CELL IS THEREFORE
                ; HALF TEXT, HALF MARGIN: COMROW BLANKS ITS RIGHT HALF BY
                ; POSITION, NOT BY LINE LENGTH. S6ED KEEPS 2 COLUMNS LEFT AND
                ; 1 RIGHT, S62ED 1 AND 1.
TXCOL0          EQU     2               ; SCREEN COLUMN OF TEXT COLUMN 0
TXCELL0         EQU     TXCOL0 / 2      ; GUTTER CELLS AHEAD OF THE TEXT
TXCELLS         EQU     (TEXTCOLS + 1) / 2 ; CELLS THE TEXT TOUCHES (31)
                ASSERT  TXCOL0 + TEXTCOLS + 1 == SCRCOLS
                ASSERT  (TXCOL0 & 1) == 0
                ASSERT  (TEXTCOLS & 1) == 1
                ASSERT  TXCELL0 + TXCELLS == CELLROW

                ; STATUS BAR RIGHT CHANNEL: MODE (6), SPACE, "Ln NNNNN/NNNNN" (14),
                ; " Col " (5), NNN (3). IT ENDS ON COLUMN 62, UNDER THE CLOCK, SO
                ; THE LAST 4 PX COLUMN STAYS BLANK
STBRCOL         EQU     34
                ASSERT  STBRCOL + 6 + 1 + 14 + 5 + 3 == SCRCOLS - 1

ROWLEN          EQU     256             ; ONE ROW: 32 CELLS X 8 BYTES = 256 B
PATLEN          EQU     6144            ; TOTAL SCREEN PATTERN BYTES: 24 X 256 B
ROWSVIS         EQU     22              ; VISIBLE EDITING ROWS (1..22)

                ; ROWS (IN CHARACTER UNITS)
MNUROW          EQU     0               ; MENU BAR ROW
TXRFIRST        EQU     1               ; FIRST TEXT ROW
TXRLAST         EQU     22              ; LAST TEXT ROW
STBROW          EQU     23              ; STATUS BAR ROW
STATCOLS        EQU     64              ; STATUS BAR COLUMNS (COLS 0..63)


; --- VRAM MAP (SCREEN 2)       ----------------------------------------


PGBASE          EQU     #0000           ; PATTERN GENERATOR TABLE (#0000-#17FF, 6144 B)
NTBASE          EQU     #1800           ; NAME TABLE (#1800-#1AFF, 768 B)
CTBASE          EQU     #2000           ; COLOR TABLE (#2000-#37FF, 6144 B)
SATBASE         EQU     #1B00           ; SPRITE ATTRIBUTE TABLE (#1B00-#1B7F)
SPGBASE         EQU     #3800           ; SPRITE GENERATOR TABLE (#3800-#3FFF)


; --- COLOR DEFINITIONS         ----------------------------------------

                ; TMS9918 16-COLOR PALETTE INDICES:
                ; 0:TRANSPARENT, 1:BLACK, 2:MED-GREEN, 3:LT-GREEN, 4:DARK-BLUE
                ; 5:LT-BLUE, 6:DARK-RED, 7:CYAN, 8:MED-RED, 9:LT-RED
                ; 10:DARK-YELLOW, 11:LT-YELLOW, 12:DARK-GREEN, 13:MAGENTA
                ; 14:GRAY, 15:WHITE

COL_BG          EQU     1               ; DEFAULT BACKGROUND: BLACK
COL_FG          EQU     15              ; DEFAULT FOREGROUND: WHITE

                ; SEMANTIC COLORS (BYTE = FG NIBBLE << 4 | BG NIBBLE)
                ; DOCUMENTATION OF THE DARK THEME ONLY: THE THEME TABLES IN
                ; S2/VDP.Z8A AND THE VCOLTXT..VCOLSHDW VARIABLES IN VARS.Z8A
                ; ARE WHAT THE CODE READS. NOTHING REFERENCES THESE EQUS.
COLTXT          EQU     #F1             ; DOCUMENT TEXT: WHITE ON BLACK
COLUI           EQU     #F4             ; MENU BAR: WHITE ON DARK BLUE
COLBOLD         EQU     #B1             ; BOLD / HEADERS: LIGHT YELLOW ON BLACK
COLITAL         EQU     #71             ; ITALIC: CYAN ON BLACK
COLUNDR         EQU     #31             ; CODE / UNDERLINE: LIGHT GREEN ON BLACK
COLMARK         EQU     #E1             ; MARKUP DELIMITERS: GRAY ON BLACK
COLSTAT         EQU     #F4             ; STATUS BAR: WHITE ON DARK BLUE
COLWIN          EQU     #F4             ; WINDOW BODY: WHITE ON DARK BLUE
COLHI           EQU     #B4             ; ACCENT: LIGHT YELLOW ON DARK BLUE
COLBSEL         EQU     #4B             ; FOCUSED BUTTON: DARK BLUE ON LIGHT YELLOW

                ; CHROME FOLLOWS S6ED: THE MENU BAR, THE STATUS BAR AND THE
                ; WINDOW BODY ARE ONE SURFACE (S6ED FILLS EVERY CHROME CELL
                ; WITH COL_UI BEFORE BLITTING THE GLYPH), AND THE ACCENT
                ; CARRIES THE WINDOW TITLE AND THE BUTTONS (COL_HI THERE).
                ; ON A TMS9918 A CELL IS ONE FG|BG BYTE, SO "ACCENT TEXT ON
                ; THE CHROME SURFACE" IS NOT A SEPARATE INK: IT IS THE CELL.
                ; FOR THE SAME REASON FOCUS CANNOT BE A BORDER DRAWN INSIDE A
                ; CELL -- THE GLYPH OWNS ALL EIGHT SCANLINES -- SO A FOCUSED
                ; CONTROL WEARS THE ACCENT INVERTED (COLBSEL).

                ; HOW MANY ROLE BYTES A THEME CARRIES. THMLOAD AND PARSTHM
                ; COPY EXACTLY THIS MANY FROM THE TABLE INTO VCOLTXT.
VCOLNUM         EQU     12

                ; A THEME IS THE ROLE BLOCK: APPLYTHM COPIES THMSIZ BYTES OF
                ; THE THEME TABLE TO THMDST
THMDST          EQU     VCOLTXT
THMSIZ          EQU     VCOLNUM


; --- PAGE 2 VIDEO SHADOW MAP   ----------------------------------------

                ; VIDSEG AND FTRSEG ARE THE SAME 16 KB SEGMENT: ON A STOCK
                ; 128 KB MSX-DOS 2 MACHINE THERE IS NO THIRD ONE TO CLAIM
                ; (MEASURED 2026-09-20 ON A PHILIPS NMS 8250: SEGAVL = 0
                ; AFTER DIRSEG AND FTRSEG). SO THE COLOR SHADOW HOLDS ONE
                ; BYTE PER CELL INSTEAD OF THE EIGHT THE COLOR TABLE WANTS
                ; -- COMCELL WRITES THE SAME BYTE EIGHT TIMES ANYWAY -- AND
                ; THE 5,376 BYTES THAT FREES HOST THE FEATURE PASSENGER.
                ;
                ; WHEN VIDSEG IS BANKED AT PAGE 2 (#8000-#BFFF, 16 KB):
                ;   #8000  PATSHAD  6144  PATTERN SHADOW, 256 B PER ROW
                ;   #9800  COLMAP    768  COLOR MAP, 1 BYTE PER CELL
                ;   #9B00  COLEXP    256  ONE ROW OF COLMAP EXPANDED X8
                ;   #9C00  FTRBASE  9216  FEATURE PASSENGER CONTAINER
                ;   #C000  FTRTOP
PATSHAD         EQU     #8000           ; PATTERN SHADOW (#8000-#97FF, 6144 B)
COLMAP          EQU     #9800           ; COLOR MAP      (#9800-#9AFF, 768 B)
COLEXP          EQU     #9B00           ; ROW COLOR STAGER (#9B00-#9BFF, 256 B)
FTRBASE         EQU     #9C00           ; FEATURE CONTAINER BASE
FTRTOP          EQU     #C000           ; FIRST BYTE PAST THE CONTAINER (PAGE 3)

CELLROW         EQU     SCRCOLS / 2     ; 32 CELLS PER SCREEN ROW
CMAPLEN         EQU     CELLROW * SCRROWS ; 768 BYTES OF COLOR MAP

FNTLEN          EQU     2048            ; 256 GLYPHS X 8 BYTES
FNTFSIZ         EQU     2048            ; S2ED.FNT FILE SIZE


; --- WINDOW ENGINE             ----------------------------------------

                ; S2/WINDOW.Z8A. WSVBUF LIVES IN PAGE 3 (#C000) UNBANKED RAM,
                ; OUTSIDE PAGE 1 TPA RAM AND OUTSIDE THE FEATURE CONTAINER.
                ; ENDS AT #C600, LEAVING OVER 4.3 KB OF HEADROOM BEFORE (0006H)
                ; AND THE Z80 STACK AT #D6FE.
                ; DOCUMENTATION OF THE DARK THEME; WSHDW READS (VCOLSHDW).
                ; A SHADOW CELL KEEPS THE DOCUMENT'S PATTERN AND FLATTENS ITS
                ; COLOR, SO IT ONLY READS AS A SHADOW WHERE IT DIFFERS FROM
                ; THE DOCUMENT BACKGROUND -- A BLACK SHADOW IS INVISIBLE ON
                ; THE THREE THEMES WHOSE DOCUMENT IS BLACK. EACH THEME PICKS
                ; ITS OWN QUIET COLOR INSTEAD.
COLSHDW         EQU     #44             ; DROP SHADOW: FLAT DARK BLUE
WSVMAX          EQU     1536            ; SAVE BUFFER CAPACITY IN BYTES
WSVBUF          EQU     #C600           ; WINDOW BACKUP IN PAGE 3 UNBANKED RAM (AFTER PREVBUF)
WSVTOP          EQU     WSVBUF + WSVMAX ; #CC00
P3BASE          EQU     WSVTOP          ; FIRST FREE PAGE 3 BYTE PAST WSVBUF


; --- FILE BROWSER (SCREEN 2)   ----------------------------------------


                DEFINE  BROWSER 1       ; THIS TARGET HAS THE FILE BROWSER
BRWMAX          EQU     64              ; FILE BROWSER ENTRY CAPACITY
BRWCOLS         EQU     4               ; FILE BROWSER GRID: COLUMNS...
BRWROWS         EQU     12              ; ...AND ROWS ON SCREEN
BRWSLOT         EQU     14              ; CHARACTERS PER GRID SLOT (7 CELLS)
BRWRLST         EQU     3               ; FIRST GRID ROW ON SCREEN (ROWS 3..14)
BRWSEPR         EQU     15              ; SEPARATOR SCREEN ROW
BRWINFR         EQU     16              ; INFORMATION LINE SCREEN ROW
BRWFLDR         EQU     17              ; NAME FIELD SCREEN ROW
BRWBTNR         EQU     18              ; BUTTONS SCREEN ROW

                ; INFORMATION LINE COLUMNS (56 CHARACTERS ON S2ED)
BICSIZE         EQU     14              ; SIZE, RIGHT-ALIGNED IN BICSZW
BICSZW          EQU     7
BICDATE         EQU     23              ; DATE, AS DIR PRINTS IT
BICTIME         EQU     32              ; TIME, AS DIR PRINTS IT
BICATTR         EQU     41              ; RHSA
BICCNTE         EQU     56              ; COUNT, RIGHT-ALIGNED, ENDS HERE
BICLEN          EQU     56              ; LINE LENGTH

                ; THE LISTING LIVES IN WSVBUF IN PAGE 3 UNBANKED RAM:
                ; WSVBUF IS IDLE WHILE DOBRW RUNS UNDER WINNOSV (NO BACKGROUND
                ; SAVE), SO IT COSTS NO EXTRA PAGE 3 RAM.
BRWIDX          EQU     WSVBUF          ; SORTED ORDER
BRWENT          EQU     BRWIDX + BRWMAX ; ENTRIES, BRWESZ BYTES EACH
                ASSERT  BRWENT + BRWMAX * BRWESZ <= WSVTOP
