;                                       ****************************************
;                                       * BDOS                                 *
;                                       ****************************************


; --- BDOS ENTRY  / VERSION             ----------------------------------------


; - BDOS -------------
; - CALL BDOS ENTRY
; - CY = 1 ERROR
; - 

BDOS            PUSH    AF
                XOR     A
                LD      (UNAPISET),A
                POP     AF
                CALL    DOS
                AND     A
                RET     Z
                SCF
                RET
                

; - DOSVER -----------
; - GET DOS VERSION
; -     

DOSVER          XOR     A
                LD      (DOS2),A
                LD      C,_DOSVER
                CALL    BDOS
                LD      A,B
                CP      2
                RET     C
                LD      A,#FF
                LD      (DOS2),A
                RET

                
; --- FILE (OPEN / READ / WRITE)        ----------------------------------------


                ; -
                ; - DOS 1
                ; -


; - BUILDFCB ---------
; - CLEAN FCB
; - AND COPY FILENAME
; - HL: FILENAME

BUILDFCB        PUSH    HL 
                LD      HL,FCB
                LD      DE,FCB + 1
                LD      BC,36
                LD      (HL),0
                LDIR
                LD     HL,FCB + FFILNAME
                LD     DE,FCB + FFILNAME + 1
                LD     BC,10
                LD     (HL),' '
                LDIR
                POP     HL

                LD      DE,FCB + FFILNAME

.NAME           LD      A,(HL)
                INC     HL
                AND     A
                JR      Z,.END
                CP      '.'
                JR      Z,.PEXT
                LD      (DE),A
                INC     DE
                JR      .NAME

.PEXT           LD      DE,FCB + FFILEXT
.EXT            LD      A,(HL)
                INC     HL
                AND     A
                JR      Z,.END
                LD      (DE),A
                INC     DE
                JR      .EXT


.END            RET


; - FOPEN ------------
; - FILE FCB OPEN
; - OUTPUT: 
; -     DEHL: FILE SIZE
; - 

FOPEN           LD      DE,FCB
                LD      C,_FOPEN
                CALL    BDOS
                RET     C
                LD      IX,FCB
                LD      A,1
                LD      (IX + 14),A
                XOR     A
                LD      (IX + 15),A
                LD      (IX + 33),A
                LD      (IX + 34),A
                LD      (IX + 35),A
                LD      (IX + 36),A
                LD      HL,(FCB + FFILSIZ)
                LD      DE,(FCB + FFILSIZ + 2)
                RET        


; - FMAKE ------------
; - FILE MAKE
; - CREATES FCB FILE
; - 


FMAKE           LD      DE,FCB
                LD      C,_FMAKE
                CALL    BDOS
                RET     C
                LD      IX,FCB
                LD      A,1
                LD      (IX + 14),A
                XOR     A
                LD      (IX + 15),A
                LD      (IX + 33),A
                LD      (IX + 34),A
                LD      (IX + 35),A
                LD      (IX + 36),A
                RET     


; - RDBLK ------------
; - READ FCB BLOCK BYTES
; - TO DMA
; - HL: BYTES TO READ
; - 


RDBLK           LD      DE,FCB
                LD      C,_RDBLK
                JP      BDOS


; - WRBLK ------------
; - WRITE FCB BLOCK BYTES
; - FROM DMA
; - HL: BYTES TO WRITE
; - 


WRBLK           LD      DE,FCB
                LD      C,_WRBLK
                JP      BDOS


; - FCLOSE -----------
; - FCB CLOSE FILE
; - 

FCLOSE          LD      DE,FCB
                LD      C,_FCLOSE
                JP      BDOS


; - SETDMA -----------
; - DE: DMA
; -

SETDMA          LD      C,_SETDTA
                JP      BDOS


; - GETREM -----------
; - GET REMAINING SIZE
; - OPENED FCB
; - OUTPUT:
; -     DE:HL REM. SIZE
; - 

GETREM          LD      HL,(FCB + FFILSIZ)
                LD      DE,(FCB + FRNDREC)
                AND     A
                SBC     HL,DE
                EX      DE,HL
                LD      HL,(FCB + FFILSIZ + 2)
                LD      BC,(FCB + FRNDREC + 2)
                SBC     HL,BC
                EX      DE,HL
                RET


; - GETMAXSZ ------------
; - HL: SIZE TO READ
; - OUTPUT: MAX SIZE
; - 

GETMAXSZ        PUSH    HL
                CALL    GETREM
.GEN            LD      A,D
                OR      E
                EX      DE,HL
                POP     HL
                RET     NZ                      ; > 64K
                
                ; HL SIZE
                ; DE LOW CURRENT

                EX      DE,HL

                ; HL CURRENT (LOW)
                ; DE SIZE

                CALL    CMPHLDE
                RET     C                       ; SIZE > CURRENT 
                                                ; RETURN CURRENT
                EX      DE,HL                   ; ELSE RETURN SIZE                                                        
                RET


                ; -
                ; - DOS 2
                ; - 


; - DSEEK ------------
; - DOS 2 SEEK 
; - B: FILE HANDLE
; - DEHL: OFFSET
; - 

DSEEK           XOR     A
.GEN            LD      C,_SEEK
                JP      BDOS


; - DOPEN ------------
; - DOS 2 OPEN FILE
; - HL: FILENAME (ASCIIZ)
; - OUTPUT: 
; -     A: FILE HANDLE
; -     DEHL: FILE SIZE
; -

DOPEN           EX      DE,HL
                XOR     A
                LD      C,_OPEN
                CALL    BDOS
                RET     C
                PUSH    BC
                LD      HL,0
                LD      DE,0
                LD      A,2             ; RELATIVE END OF FILE
                CALL    DSEEK.GEN
                POP     BC
                PUSH    BC
                PUSH    HL
                PUSH    DE
                LD      HL,0
                LD      DE,0
                CALL    DSEEK
                POP     DE
                POP     HL
                POP     AF
                AND     A
                RET
                

; - DCLOSE  ----------
; - DOS2 CLOSE #F
; - B: #F
; - 

DCLOSE          LD      C,_CLOSE
                JP      BDOS


; - DREAD ------------
; - DOS2 READ BYTES FROM #F
; - B: #F
; - HL: BYTES TO READ
; - DE: BUFFER ADDRESS
; - 

DREAD           LD      C,_READ
                JP      BDOS

                
; - DWRITE -----------
; - DOS2 WRITE BYTES TO #F
; - B: #F
; - HL: BYTES TO WRITE
; - DE: FROM BUFFER ADDRESS
; - 

DWRITE          LD      C,_WRITE
                JP      BDOS


; - DCREATE ----------
; - DOS2 CREATE FILE
; - HL: FILENAME ASCIIZ
; - OUTPUT: 
; -     A: #F
; -     CY: 0 = SUCCESS, 1 = ERROR
; - 

DCREATE         EX      DE,HL
                XOR     A               ; A = 0: OPEN MODE READ/WRITE
                LD      B, 0            ; B = 0: NORMAL FILE, OVERWRITE EXISTING (B7=0)
                LD      C,_CREATE
                CALL    BDOS
                RET     C               ; IF ERROR, RETURN CY=1
                LD      A,B             ; A = FILE HANDLE
                RET     
                

                ; -
                ; - COMPATIBLE DOS 1 / DOS 2
                ; - "HIGH" LEVEL ROUTINES
                ; - 

; - DSKCREAT ---------
; - CREATE FILE
; - HL: FILENAMEZ
; - OUTPUT:
; -     A: FILEHANDLE
; -

DSKCREAT       LD      A,(DOS2)
                AND     A
                JP      NZ,DCREATE

                ; DOS 1

                CALL    BUILDFCB
                CALL    FMAKE
                RET     C
                LD      A,1 ; FAKE #F
                RET


; - DSKOPEN ----------
; - OPEN FILE
; - HL: FILENAME (ASCIIZ)
; - OUTPUT: 
; -    A: FILEHANDLE
; -    DEHL: FILE SIZE
; - 

DSKOPEN         LD      A,(DOS2)
                AND     A
                JP      NZ,DOPEN

                ; DOS 1

                CALL    BUILDFCB
                CALL    FOPEN
                RET     C
                LD      A,1 ; FAKE #F
                RET


; - DSKCLOSE ---------
; - FCB/#F FILE CLOSE
; - A: #F
; -

DSKCLOSE        LD      B,A
                LD      A,(DOS2)
                AND     A
                JP      NZ,DCLOSE
                JP      FCLOSE


; - DSKREAD -----------
; - A: #F
; - HL: BYTES TO READ
; - DE: BUFFER ADDRESS
; - (FROM LAST POINTER)
; - OUTPUT:
; -     HL: BYTES READ
; - 

DSKREAD         LD      B,A
                LD      A,(DOS2)
                AND     A
                JP      NZ,DREAD
                PUSH    HL
                CALL    SETDMA
                POP     HL
                CALL    GETMAXSZ
                JP      RDBLK


; - DSKSEEK -----------
; - SEEK TO ABSOLUTE BYTE OFFSET IN AN OPEN FILE
; - A: FILE HANDLE
; - HL: BYTE OFFSET (LOW 16 BITS; THE CONTAINER IS < 64 KB)
; - OUTPUT:
; -     CY = 1 ERROR
; -
; - DOS 2 USES _SEEK DIRECTLY. THE DOS 1 PATH WRITES THE FCB RANDOM
; - RECORD FIELD: FOPEN FIXED THE RECORD SIZE AT 1 BYTE, SO THE RECORD
; - NUMBER IS THE BYTE OFFSET. DOS 1 NEVER REACHES THIS TODAY (INIT
; - REJECTS IT IN DOSVER), BUT THE PATH KEEPS DSKREAD'S CONTRACT ALIVE.

DSKSEEK         LD      B,A
                LD      A,(DOS2)
                AND     A
                JR      Z,.DOS1
                LD      DE,0
                XOR     A               ; A = 0: ABSOLUTE OFFSET FROM START
                JP      DSEEK.GEN

.DOS1           LD      (FCB + FRNDREC),HL
                XOR     A
                LD      (FCB + FRNDREC + 2),A
                LD      (FCB + FRNDREC + 3),A
                RET                     ; CY = 0


; - DSKWRITE -----------
; - A: #F
; - HL: BYTES TO WRITE
; - DE: FROM BUFFER ADRESS
; - (TO LAST POINTER)
; -

DSKWRITE        LD      B,A
                LD      A,(DOS2)
                AND     A
                JP      NZ,DWRITE
                PUSH    HL
                CALL    SETDMA
                POP     HL
                JP      WRBLK


; --- PRINT / OUTPUT                    ----------------------------------------


; - STROUT -----------
; - DE: POINTER TO $-FINISHED STRING
; -

STROUT          LD      C,_STROUT
                JP      DOS


; - TERM -------------
; - TERMINATE PROGRAM
; - 

TERM            ; RESTORE MAPPER SEGMENTS IF INITIALIZED
                LD      A, (MAPRDY)
                AND     A
                JR      Z, .NOMAPRS
                LD      A, (DEFSEG1)
                CALL    PUTP1
                LD      A, (DEFSEG2)
                CALL    PUTP2
                CALL    SEGFREE         ; HAND BACK EVERY SEGMENT WE CLAIMED

.NOMAPRS        ; RESTORE SCREEN IF INITIALIZED
                LD      A, (SCRRDY)
                AND     A
                JR      Z, .NOSCRRS

                ; 1. RESTORE ORIGINAL SCREEN COLORS
                LD      A, (SAVFORC)
                LD      (FORCLR), A
                LD      A, (SAVBAKC)
                LD      (BAKCLR), A
                LD      A, (SAVBDRC)
                LD      (BDRCLR), A

                ; 2. RESTORE ORIGINAL SCREEN WIDTH
                LD      A, (SAVL40)
                LD      (LINL40), A
                LD      A, (SAVLLEN)
                LD      (LINLEN), A

                ; 3. RESTORE ORIGINAL SCREEN MODE
                LD      A, (SAVSCRMD)
                LD      IX, CHGMOD
                CALL    BIOSCALL

                ; 4. APPLY RESTORED COLORS TO VDP
                LD      IX, CHGCLR
                CALL    BIOSCALL

                ; 5. RESTORE VDP PALETTE (ALL 16 REGISTERS)
                CALL    RSTPAL

                ; 6. RESTORE FUNCTION KEYS, KEY CLICK, KANA
                LD      IX, ERAFNK
                CALL    BIOSCALL
                CALL    REFNKEY         ; GIVE DOS ITS FUNCTION KEY STRINGS BACK
                LD      A, 1
                LD      (CLIKSW), A
                CALL    KANARST         ; RESET KANA STATUS AND TURN OFF LED

.TERMDON        ; HOOK/BREAKPOINT LABEL FOR VERIFICATION HARNESS

.NOSCRRS        ; RESTORE ORIGINAL STACK POINTER
                LD      HL, (SAVESP)
                LD      A, H
                OR      L
                JR      Z, .NOSTKRS
                LD      SP, HL

.NOSTKRS        LD      A, (DOS2) 
                AND     A
                JR      Z, .TERM0
                LD      B, 0
                LD      C, _TERM 
                JP      DOS

.TERM0          LD      C, _TERM0
                JP      DOS


; --- PARAMS                            ---------------------------------------


; - EXTPARM ----------
; - EXTRACT PARAMS
; - CY = 1 NO PARAMS
; - HL: BUFFER 
; - OUTPUT STRUCT:
;       + 0 : PARAMS SIZE
;       + 1 : PNT PARAM 0
;       + 4 : PNT PARAM 1
;       ...

EXTPARM         LD      A,(#80)
                AND     A
                SCF     
                RET     Z

                ; IX COUNTER

                PUSH    HL
                POP     IX      
                INC     IX
                EXX

                ; MARK END


                LD      C,A
                LD      B,0
                LD      HL,#81
                ADD     HL,BC
                LD      (HL),0

                ; COUNT PARAMS POINT PARAMS
                
                LD      HL,#81
                LD      C,0
.COUNT          LD      A,(HL)
                AND     A
                JR      Z,.CNTEND
                CP      ' ' 
                JR      NZ,.ADDPAR
                INC     HL
                JR      .COUNT
                
.ADDPAR         LD      (IX + 0),L
                LD      (IX + 1),H
                INC     IX
                INC     IX
                INC     C

                ; INC UNTIL NEXT PARAM (OR END)

.NEXT           LD      A,(HL)
                CP      ' '
                JR      Z,.COUNT
                AND     A
                JR      Z,.CNTEND
                INC     HL
                JR      .NEXT

.CNTEND         LD      A,C 
                EXX
                LD      (HL),A
                AND     A
                RET     NZ
                SCF
                RET


; - GETPARAM ---------
; - GET PARAMETER FROM BUFFER
; - A: NUMBER (0 1ST, 1 2ND..)
; - HL: BUFFER
; - DE: DEST 
; - OUTPUT: 
; - CY = 1 ERROR
; -     DE: COPY OF PARAM (IF DE != 0)
; -     HL: POINTER TO PARAM 
; -     C: SIZE
; -

GETPARAM        CP      (HL)
                RET     Z
                CCF
                RET     C
                INC     HL
                CALL    ADDHLPNT

                ; CHECK MOVE OR COUNT

                LD      A,D
                OR      E
                LD      C,0
                JR      NZ,.MOVE

                ; JUST COUNT

                PUSH    HL
.COUNT          LD      A,(HL)
                INC     HL
                AND     A
                JR      Z,.ENDCNT
                CP      ' '
                JR      Z,.ENDCNT
                INC     C
                JR      .COUNT

                ; MOVE DATA

.MOVE           PUSH    HL
.COPY           LD      A,(HL)
                INC     HL
                AND     A
                JR      Z,.END
                CP      ' '
                JR      Z,.END
                LD      (DE),A
                INC     DE
                INC     C
                JR      .COPY


                ; ASCIIZ END

.END            XOR     A
                LD      (DE),A

.ENDCNT         POP     HL
                RET     


