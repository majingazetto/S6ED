;                                       ****************************************
;                                       * WINDOW ENGINE                        *
;                                       ****************************************
;
; WINDOW AND DIALOG SUBSYSTEM FOR SCREEN 6 (512X212, 4 COLORS).
; RUNS IN RESIDENT FEATURE SEGMENT (PAGE 2, PHASED AT #8000).
; PROVIDES OFF-SCREEN VRAM COMPOSITION BUFFER (Y = 768..979) AND
; VRAM BACKGROUND SAVE / RESTORE BUFFER (Y = 512..723) IN BANK 1.
; POP-UP APPEARANCE AND RESTORE BOTH TAKE ~3.2 MS VIA HARDWARE HMMM.


; --- VRAM BUFFER & DISPLAY     ----------------------------------------


; - WINSAV -----------------------------
; - SAVE VISIBLE BACKGROUND TO VRAM BANK 1
; - IN:  NONE (USES WINX, WINY, WINW, WINH)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WINSAV          LD      HL, (WINX)
                LD      (VDP_SX), HL
                LD      (VDP_DX), HL
                LD      HL, (WINY)
                LD      (VDP_SY), HL
                LD      DE, WINBUF_Y
                ADD     HL, DE
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                LD      (VDP_NX), HL
                LD      HL, (WINH)
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                JP      HMMM


; - WINSHOW ----------------------------
; - COPY COMPOSED WINDOW FROM OFF-SCREEN BUFFER (Y=768) TO SCREEN
; - IN:  NONE (USES WINX, WINY, WINW, WINH)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WINSHOW         LD      HL, (WINX)
                LD      (VDP_SX), HL
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y
                LD      (VDP_SY), HL
                LD      HL, (WINY)
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                LD      (VDP_NX), HL
                LD      HL, (WINH)
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMM
                JP      VDPWAIT


; - WINRST -----------------------------
; - RESTORE BACKGROUND FROM VRAM BANK 1 TO SCREEN
; - IN:  NONE (USES WINX, WINY, WINW, WINH)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WINRST          LD      HL, (WINX)
                LD      (VDP_SX), HL
                LD      (VDP_DX), HL
                LD      HL, (WINY)
                LD      (VDP_DY), HL
                LD      DE, WINBUF_Y
                ADD     HL, DE
                LD      (VDP_SY), HL
                LD      HL, (WINW)
                LD      (VDP_NX), HL
                LD      HL, (WINH)
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMM
                JP      VDPWAIT


; --- GLYPH & STRING BLITTING   ----------------------------------------


; - WINCHTR ----------------------------
; - BLIT SINGLE GLYPH WITH FONT WEIGHT AND LOGOP
; - IN:  A  = ASCII CHAR
; -      HL = DX
; -      DE = DY
; -      B  = FONT VARIANT (0=NORM, 1=BOLD, 2=ITAL, 3=BI)
; -      C  = LOGOP (VDP_TIMP OR VDP_TOR)
; - OUT: NONE
; - CLOBBERS: NONE
; -

WINCHTR         PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                LD      (VDP_DX), HL
                EX      DE, HL
                LD      (VDP_DY), HL

                ; CALC SX = (CHAR & 31) * 8
                LD      E, A
                AND     %00011111
                LD      L, A
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                LD      (VDP_SX), HL

                ; CALC SY = (CHAR >> 5) * 8 + VARIANT BASE SY
                LD      A, E
                SRL     A
                SRL     A
                SRL     A
                SRL     A
                SRL     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0

                ; LOOKUP VARIANT BASE (256, 320, 384, 448)
                LD      A, B
                AND     3
                ADD     A, A
                LD      E, A
                LD      D, 0
                PUSH    HL
                LD      HL, .SYTBL
                ADD     HL, DE
                LD      E, (HL)
                INC     HL
                LD      D, (HL)
                POP     HL
                ADD     HL, DE
                LD      (VDP_SY), HL

                LD      HL, CELLW
                LD      (VDP_NX), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A
                LD      A, VDP_LMMM
                OR      C
                LD      (VDP_CMD), A
                LD      HL, VDPCMBLK
                CALL    VDPCMD

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET

.SYTBL          DEFW    FNORM_SY        ; 256
                DEFW    FBOLD_SY        ; 320
                DEFW    FITAL_SY        ; 384
                DEFW    FBI_SY          ; 448


; - WINSTR3 ----------------------------
; - BLIT ASCIIZ STRING WITH COLOR 3 HIGHLIGHT (TOR)
; - IN:  HL = POINTER TO ASCIIZ STRING
; -      DE = DX
; -      BC = DY
; -      A  = FONT VARIANT (0..3)
; - OUT: DE = DX ADVANCED PAST LAST CHAR
; - CLOBBERS: AF, BC, DE, HL
; -

WINSTR3         PUSH    AF
                LD      A, VDP_TOR
                LD      (WINOP), A
                POP     AF
                JR      WINSTR.DOSTR


; - WINSTR -----------------------------
; - BLIT ASCIIZ STRING WITH FONT VARIANT (TIMP)
; - IN:  HL = POINTER TO ASCIIZ STRING
; -      DE = DX
; -      BC = DY
; -      A  = FONT VARIANT (0..3)
; - OUT: DE = DX ADVANCED PAST LAST CHAR
; - CLOBBERS: AF, BC, DE, HL
; -

WINSTR          PUSH    AF
                LD      A, VDP_TIMP
                LD      (WINOP), A
                POP     AF

.DOSTR          LD      (WINVAR), A
.LOOP           LD      A, (HL)
                OR      A
                RET     Z
                PUSH    HL
                PUSH    BC
                PUSH    DE
                EX      DE, HL          ; HL = DX
                LD      D, B
                LD      E, C            ; DE = DY
                PUSH    AF
                LD      A, (WINVAR)
                LD      B, A
                LD      A, (WINOP)
                LD      C, A
                POP     AF
                CALL    WINCHTR
                POP     DE
                POP     BC
                POP     HL
                INC     HL
                LD      A, CELLW
                ADD     A, E
                LD      E, A
                JR      NC, .LOOP
                INC     D
                JR      .LOOP


; - WINPRN -----------------------------
; - PRINT TEXT LINE INSIDE WINDOW COMPOSITION BUFFER (TIMP)
; - IN:  HL = ASCIIZ STRING
; -      C  = COLUMN (0-BASED CHAR UNITS)
; -      B  = ROW    (0-BASED ROW UNITS)
; -      A  = FONT VARIANT (0..3)
; - OUT: DE = DX ADVANCED PAST LAST CHAR
; - CLOBBERS: ALL
; -

WINPRN          PUSH    HL
                PUSH    AF

                ; DX = WINX + 6 + C * 6
                LD      L, C
                LD      H, 0
                ADD     HL, HL
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                LD      DE, 6
                ADD     HL, DE
                LD      DE, (WINX)
                ADD     HL, DE
                PUSH    HL

                ; DY = WINCOMP_Y + 16 + B * 8
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                LD      DE, 16
                ADD     HL, DE
                LD      DE, WINCOMP_Y
                ADD     HL, DE
                LD      B, H
                LD      C, L

                POP     DE
                POP     AF
                POP     HL
                JP      WINSTR


; --- WINDOW DRAWING            ----------------------------------------


; - WINBOX -----------------------------
; - DRAW WINDOW FRAME, FILLS, ACCENTS, AND TITLE INTO COMPOSITION BUFFER
; - IN:  HL = ASCIIZ TITLE STRING (0 = NONE)
; -      USES WINX, WINW, WINH
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINBOX          PUSH    HL

                ; 1. OUTER BORDER (COL_UI) AT (WINX, WINCOMP_Y)
                LD      HL, (WINX)
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                LD      (VDP_NX), HL
                LD      HL, (WINH)
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; 2. TOP ACCENT HIGHLIGHT LINE (COL_HI)
                LD      HL, (WINX)
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                LD      (VDP_NX), HL
                LD      HL, 1
                LD      (VDP_NY), HL
                LD      A, COL_HI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; 3. INNER FILL (COL_BG)
                LD      HL, (WINX)
                INC     HL
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y + 1
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                DEC     HL
                DEC     HL
                LD      (VDP_NX), HL
                LD      HL, (WINH)
                DEC     HL
                DEC     HL
                LD      (VDP_NY), HL
                LD      A, COL_BG
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; 4. TITLE BAR
                POP     HL
                LD      A, H
                OR      L
                RET     Z
                LD      A, (HL)
                OR      A
                RET     Z

                PUSH    HL

                ; TITLE BAR FILL (COL_UI, HEIGHT 10)
                LD      HL, (WINX)
                INC     HL
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y + 1
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                DEC     HL
                DEC     HL
                LD      (VDP_NX), HL
                LD      HL, 10
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; TITLE SEPARATOR LINE IN COLOR 3 (COL_HI)
                LD      HL, (WINX)
                INC     HL
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y + 11
                LD      (VDP_DY), HL
                LD      HL, (WINW)
                DEC     HL
                DEC     HL
                LD      (VDP_NX), HL
                LD      HL, 1
                LD      (VDP_NY), HL
                LD      A, COL_HI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; TITLE TEXT IN BOLD + COLOR 3 (TOR) AT (WINX + 6, WINCOMP_Y + 2)
                LD      HL, (WINX)
                LD      DE, 6
                ADD     HL, DE
                EX      DE, HL          ; DE = DX
                LD      BC, WINCOMP_Y + 2
                POP     HL              ; HL = TITLE STRING
                LD      A, 1            ; BOLD (VARIANT 1)
                JP      WINSTR3


; - WINBTN -----------------------------
; - DRAW BUTTON, NORMAL STYLE (SEE WINBTS FOR THE STYLE LAYOUT)
; - IN:  HL = ASCIIZ BUTTON TEXT
; -      DE = RELATIVE X (PIXELS)
; -      BC = RELATIVE Y (PIXELS)
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - WINBTS -----------------------------
; - SAME, WITH EXPLICIT STYLE FOR OPTION SELECTION:
; - STYLE 0 (NORMAL):   COL_HI BORDER, COL_UI BODY, BOLD TEXT IN TOR
; - STYLE 1 (SELECTED): COL_HI BORDER, COL_HI BODY, BOLD TEXT IN TIMP
; - IN:  A  = STYLE (0 = NORMAL, 1 = SELECTED)
; -      HL, DE, BC AS ABOVE
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINBTN          XOR     A               ; STYLE NORMAL
WINBTS          LD      (WINBST), A
                PUSH    HL
                PUSH    DE
                PUSH    BC

                ; 1. OUTER BORDER (COL_HI) 58 X 14
                LD      HL, (WINX)
                ADD     HL, DE
                DEC     HL
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y
                ADD     HL, BC
                DEC     HL
                LD      (VDP_DY), HL
                LD      HL, 58
                LD      (VDP_NX), HL
                LD      HL, 14
                LD      (VDP_NY), HL
                LD      A, COL_HI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; 2. BUTTON BODY 56 X 12: COL_UI NORMAL, COL_HI SELECTED
                POP     BC
                POP     DE
                PUSH    DE
                PUSH    BC
                LD      HL, (WINX)
                ADD     HL, DE
                LD      (VDP_DX), HL
                LD      HL, WINCOMP_Y
                ADD     HL, BC
                LD      (VDP_DY), HL
                LD      HL, 56
                LD      (VDP_NX), HL
                LD      HL, 12
                LD      (VDP_NY), HL
                LD      A, (WINBST)
                OR      A
                JR      Z, .BODYN
                LD      A, COL_HI
                JR      .BODYGO
.BODYN          LD      A, COL_UI
.BODYGO         LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; 3. BUTTON TEXT IN BOLD: TOR NORMAL, TIMP SELECTED
                POP     BC
                POP     DE
                LD      HL, (WINX)
                ADD     HL, DE
                INC     HL
                INC     HL
                INC     HL
                INC     HL
                EX      DE, HL          ; DE = DX = WINX + REL X + 4
                LD      HL, WINCOMP_Y + 2
                ADD     HL, BC
                LD      B, H
                LD      C, L            ; BC = DY = WINCOMP_Y + REL Y + 2
                POP     HL              ; HL = TEXT
                LD      A, (WINBST)
                OR      A
                JR      NZ, .TXTSEL
                LD      A, 1            ; BOLD (VARIANT 1)
                JP      WINSTR3
.TXTSEL         LD      A, 1            ; BOLD (VARIANT 1)
                JP      WINSTR


; --- WINDOW MANAGEMENT         ----------------------------------------


; - WINOPEN ----------------------------
; - OPEN WINDOW (ALIGN, SAVE BACKGROUND, DRAW BOX INTO COMPOSITION BUFFER)
; - IN:  HL = ASCIIZ TITLE STRING (0 = NONE)
; -      USES WINX, WINY, WINW, WINH
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINOPEN         PUSH    HL

                ; FLUSH KEYBOARD BUFFER
                CALL    WINKIL

                ; MARK MODAL WINDOW ACTIVE TO INHIBIT CLOCK BLINK
                LD      A, 1
                LD      (WINACTV), A

                ; ERASE CURSOR IF CURRENTLY VISIBLE
                LD      A, (BLNKPH)
                AND     A
                JR      Z, .NOCUR
                CALL    DRWCUR
                XOR     A
                LD      (BLNKPH), A

.NOCUR          ; ALIGN WINX DOWN TO MULTIPLE OF 4
                LD      HL, (WINX)
                LD      A, L
                AND     %11111100
                LD      L, A
                LD      (WINX), HL

                ; ALIGN WINW UP TO MULTIPLE OF 4 (PRESERVE CARRY)
                LD      HL, (WINW)
                LD      A, L
                ADD     A, 3
                LD      L, A
                JR      NC, .NOWINC
                INC     H
.NOWINC         LD      A, L
                AND     %11111100
                LD      L, A
                LD      (WINW), HL

                ; CLAMP WINX <= 508
                LD      HL, (WINX)
                LD      DE, 508
                OR      A
                SBC     HL, DE
                JR      C, .XOK
                LD      HL, 508
                LD      (WINX), HL
                JR      .XDON
.XOK            ADD     HL, DE
                LD      (WINX), HL
.XDON           ; CLAMP WINW: MIN 4, WINX + WINW <= 512
                LD      HL, (WINW)
                LD      A, H
                OR      L
                JR      NZ, .WNOT0
                LD      HL, 4
                LD      (WINW), HL
.WNOT0          LD      DE, (WINX)
                LD      HL, 512
                OR      A
                SBC     HL, DE          ; HL = 512 - WINX (MULTIPLE OF 4)
                EX      DE, HL          ; DE = MAXW
                LD      HL, (WINW)
                OR      A
                SBC     HL, DE          ; WINW - MAXW
                JR      C, .WOK
                LD      (WINW), DE
                JR      .WDON
.WOK            ADD     HL, DE
                LD      (WINW), HL
.WDON           ; CLAMP WINY <= 211
                LD      HL, (WINY)
                LD      DE, 211
                OR      A
                SBC     HL, DE
                JR      C, .YOK
                LD      HL, 211
                LD      (WINY), HL
                JR      .YDON
.YOK            ADD     HL, DE
                LD      (WINY), HL
.YDON           ; CLAMP WINH: MIN 1, WINY + WINH <= 212
                LD      HL, (WINH)
                LD      A, H
                OR      L
                JR      NZ, .HNOT0
                LD      HL, 1
                LD      (WINH), HL
.HNOT0          LD      DE, (WINY)
                LD      HL, 212
                OR      A
                SBC     HL, DE          ; HL = 212 - WINY
                EX      DE, HL          ; DE = MAXH
                LD      HL, (WINH)
                OR      A
                SBC     HL, DE          ; WINH - MAXH
                JR      C, .HOK
                LD      (WINH), DE
                JR      .HDON
.HOK            ADD     HL, DE
                LD      (WINH), HL
.HDON
                ; SAVE VISIBLE BACKGROUND TO VRAM BUFFER (Y + 512)
                CALL    WINSAV

                ; DRAW WINDOW BOX AND TITLE INTO COMPOSITION BUFFER (Y = 768)
                POP     HL
                JP      WINBOX


; - WINCLOS ----------------------------
; - CLOSE WINDOW (RESTORE BACKGROUND FROM VRAM BUFFER)
; - IN:  NONE (USES WINX, WINY, WINW, WINH)
; - OUT: NONE
; - CLOBBERS: ALL
; - NOTE: RESTORES SAVED VRAM BACKGROUND PIXELS. CURSOR IS NOT RE-DRAWN
; -       HERE; MAINLOOP RE-DRAWS CURSOR UPON EDITING RESUMPTION.
; -

WINCLOS         XOR     A
                LD      (WINACTV), A
                JP      WINRST


; --- DIALOGS                   ----------------------------------------


; - DOABT ------------------------------
; - DISPLAY ABOUT S6ED MODAL DIALOG WITH MULTI-WEIGHT FONTS & HIGHLIGHTS
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DOABT           LD      HL, 112
                LD      (WINX), HL
                LD      HL, 52
                LD      (WINY), HL
                LD      HL, 288
                LD      (WINW), HL
                LD      HL, 104
                LD      (WINH), HL

                LD      HL, .TITABT
                CALL    WINOPEN

                ; LINE 0: "S6ED" (BI) + " - MSX2 Screen 6 Text Editor" (NORM)
                LD      HL, .S6ED
                LD      C, 7
                LD      B, 0
                LD      A, 3            ; BOLD+ITALIC
                CALL    WINPRN
                LD      HL, .STRSUB
                LD      BC, WINCOMP_Y + 16
                XOR     A               ; NORMAL
                CALL    WINSTR

                ; LINE 1: "Version 0.1 " (BOLD) + "(Experimental)" (ITALIC)
                LD      HL, .STRVER
                LD      C, 10
                LD      B, 1
                LD      A, 1            ; BOLD
                CALL    WINPRN
                LD      HL, .STREXP
                LD      BC, WINCOMP_Y + 24
                LD      A, 2            ; ITALIC
                CALL    WINSTR

                ; LINE 3: "Display: " (BOLD) + "80x24 Columns (512x212, 4 Colors)" (NORM)
                LD      HL, .LBDSP
                LD      C, 2
                LD      B, 3
                LD      A, 1            ; BOLD
                CALL    WINPRN
                LD      HL, .VALDSP
                LD      BC, WINCOMP_Y + 40
                XOR     A               ; NORMAL
                CALL    WINSTR

                ; LINE 4: "Fonts:   " (BOLD) + "4 Typographic Weights (B, I, BI)" (NORM)
                LD      HL, .LBFNT
                LD      C, 2
                LD      B, 4
                LD      A, 1            ; BOLD
                CALL    WINPRN
                LD      HL, .VALFNT
                LD      BC, WINCOMP_Y + 48
                XOR     A               ; NORMAL
                CALL    WINSTR

                ; LINE 5: "Memory:  " (BOLD) + "DOS 2 / Nextor Mapper Manager" (NORM)
                LD      HL, .LBMEM
                LD      C, 2
                LD      B, 5
                LD      A, 1            ; BOLD
                CALL    WINPRN
                LD      HL, .VALMEM
                LD      BC, WINCOMP_Y + 56
                XOR     A               ; NORMAL
                CALL    WINSTR

                ; LINE 7: "Press ENTER, SPACE or ESC to close"
                LD      HL, .STRINS
                LD      C, 6
                LD      B, 7
                XOR     A               ; NORMAL
                CALL    WINPRN

                ; BUTTON [  OK  ] (REL X = 116, REL Y = 84)
                LD      HL, .BTNOK
                LD      DE, 116
                LD      BC, 84
                CALL    WINBTN

                ; POP-UP COMPOSED WINDOW INSTANTLY (~3.2 MS)
                CALL    WINSHOW

                ; MODAL KEY LOOP
.KEYLP          CALL    WINPOLL
                JR      Z, .KEYLP
                CP      13              ; ENTER
                JR      Z, .DONE
                CP      ' '             ; SPACE
                JR      Z, .DONE
                CP      27              ; ESC
                JR      Z, .DONE
                JR      .KEYLP

.DONE           JP      WINCLOS

.TITABT         DEFM    "About S6ED", 0
.S6ED           DEFM    "S6ED", 0
.STRSUB         DEFM    " - MSX2 Screen 6 Text Editor", 0
.STRVER         DEFB    "Version ", VERSION.MAJOR, '.', VERSION.MINOR, " ", 0
.STREXP         DEFM    "(Experimental)", 0
.LBDSP          DEFM    "Display: ", 0
.VALDSP         DEFM    "80x24 Columns (512x212, 4 Colors)", 0
.LBFNT          DEFM    "Fonts:   ", 0
.VALFNT         DEFM    "4 Typographic Weights (B, I, BI)", 0
.LBMEM          DEFM    "Memory:  ", 0
.VALMEM         DEFM    "DOS 2 / Nextor Mapper Manager", 0
.STRINS         DEFM    "Press ENTER, SPACE or ESC to close", 0
.BTNOK          DEFM    "[  OK  ]", 0


; - DOQIT ------------------------------
; - CONFIRM EXIT TO DOS: TWO SELECTABLE OPTIONS (YES / NO)
; - IN:  NONE (READS MODIFIED FOR THE UNSAVED-CHANGES WARNING)
; - OUT: WINRES = 1: QUIT CONFIRMED, 0: CANCELLED
; - CLOBBERS: ALL
; -
; - LEFT/RIGHT MOVE THE SELECTION, ENTER/SPACE ACTIVATE IT, Y/N ARE
; - ACCELERATORS AND ESC CANCELS. THE DEFAULT IS NO: AN ACCIDENTAL ESC
; - NEVER DROPS THE DOCUMENT. A SELECTION CHANGE REPAINTS ONLY THE TWO
; - BUTTONS IN THE COMPOSITION BUFFER AND RE-BLITS WITH WINSHOW, SO THE
; - DIALOG NEVER TEARS.

DOQIT           LD      HL, 156
                LD      (WINX), HL
                LD      HL, 74
                LD      (WINY), HL
                LD      HL, 200
                LD      (WINW), HL
                LD      HL, 64
                LD      (WINH), HL

                LD      HL, .TITQIT
                CALL    WINOPEN

                ; DEFAULT: NO SELECTED, RESULT CANCELLED
                LD      A, 1
                LD      (WINSEL), A
                XOR     A
                LD      (WINRES), A

                ; MESSAGE LINE
                LD      HL, .STRQIT
                LD      C, 7
                LD      B, 1
                XOR     A               ; NORMAL
                CALL    WINPRN

                ; WARNING LINE, ONLY WITH A DIRTY BUFFER
                LD      A, (MODIFIED)
                OR      A
                JR      Z, .NOWRN
                LD      HL, .STRWRN
                LD      C, 7
                LD      B, 2
                LD      A, 1            ; BOLD
                CALL    WINPRN

.NOWRN          CALL    .BTNS
                CALL    WINSHOW

                ; MODAL KEY LOOP
.KEYLP          CALL    WINPOLL
                JR      Z, .KEYLP
                CP      ESC
                JR      Z, .DONE        ; CANCEL (WINRES ALREADY 0)
                CP      CR
                JR      Z, .ACCEPT
                CP      ' '
                JR      Z, .ACCEPT
                CP      CLEFT
                JR      Z, .TOYES
                CP      CRIGHT
                JR      Z, .TONO
                CP      'Y'
                JR      Z, .YES
                CP      'y'
                JR      Z, .YES
                CP      'N'
                JR      Z, .DONE
                CP      'n'
                JR      Z, .DONE
                JR      .KEYLP

.TOYES          XOR     A
                JR      .NAV
.TONO           LD      A, 1
.NAV            LD      HL, WINSEL
                CP      (HL)
                JR      Z, .KEYLP       ; ALREADY THERE: NOTHING TO REPAINT
                LD      (HL), A
                CALL    .BTNS
                CALL    WINSHOW
                JR      .KEYLP

.ACCEPT         LD      A, (WINSEL)
                XOR     1               ; YES (0) CONFIRMS, NO (1) CANCELS
                LD      (WINRES), A
                JR      .DONE

.YES            LD      A, 1
                LD      (WINRES), A

.DONE           JP      WINCLOS

; .BTNS: PAINT BOTH BUTTONS WITH THE STYLE THEIR SELECTION STATE DICTATES
.BTNS           LD      A, (WINSEL)
                OR      A
                JR      Z, .YSSEL
                XOR     A               ; YES NORMAL
                JR      .YSGO
.YSSEL          LD      A, 1            ; YES SELECTED
.YSGO           LD      HL, .BTNYES
                LD      DE, 36
                LD      BC, 44
                CALL    WINBTS
                LD      A, (WINSEL)
                CP      1
                JR      Z, .NSSEL
                XOR     A               ; NO NORMAL
                JR      .NSGO
.NSSEL          LD      A, 1            ; NO SELECTED
.NSGO           LD      HL, .BTNNO
                LD      DE, 106
                LD      BC, 44
                JP      WINBTS

.TITQIT         DEFM    "Quit S6ED", 0
.STRQIT         DEFM    "Exit to MSX-DOS?", 0
.STRWRN         DEFM    "Unsaved changes!", 0
.BTNYES         DEFM    "[  YES  ]", 0
.BTNNO          DEFM    "[  NO  ]", 0
