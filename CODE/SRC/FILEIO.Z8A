;                                       ****************************************
;                                       * FILE I/O                             *
;                                       ****************************************
;
; USES HIGH-LEVEL DSK* WRAPPERS FROM BDOS.Z8A (DOS1/DOS2 TRANSPARENT).


; --- FILENEW                   ----------------------------------------

FILENEW         CALL    BUFINIT
                RET


; --- FILELOAD                  ----------------------------------------

; - FILELOAD ---------
; - LOAD FILE FROM DISK INTO BUFFER
; - HL: FILENAME (ASCIIZ)
; -

FILELOAD        PUSH    HL
                CALL    FILENEW         ; RESET BUFFER AND ALLOCATE INITIAL SEGS
                POP     HL

                CALL    DSKOPEN         ; A=HANDLE, DEHL=SIZE
                RET     C
                LD      (FILEHAND), A

                LD      HL, 0
                LD      (TOTLINES), HL
                LD      (LINEOFF), HL
                XOR     A
                LD      (CURLLEN), A
                LD      (WASCR), A

.READBLK        LD      A, (FILEHAND)
                LD      HL, 256
                LD      DE, FILEBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      A, H
                OR      L
                JR      Z, .EOF
                
                LD      B, H
                LD      C, L            ; BC = BYTES TO PROCESS
                LD      HL, FILEBUF
.PROCLP         PUSH    BC
                PUSH    HL
                
                LD      A, (HL)
                CP      13              ; CR
                JR      Z, .ISCR
                CP      10              ; LF
                JR      Z, .ISLF
                
                ; REGULAR CHARACTER: CLEAR WASCR
                PUSH    AF
                XOR     A
                LD      (WASCR), A
                POP     AF
                
                ; APPEND TO CURRENT LINE IN TXPAGE
                LD      B, A
                LD      A, (TXSEG)
                CALL    PUTP2
                
                LD      A, (CURLLEN)
                CP      80
                JR      NC, .SKIP       ; TRUNCATE
                
                LD      HL, TXPAGE + 1  ; SKIP LEN BYTE
                LD      DE, (LINEOFF)
                ADD     HL, DE
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = TXPAGE + LINEOFF + 1 + CURLLEN
                LD      (HL), B
                
                INC     A
                LD      (CURLLEN), A
                JR      .SKIP

.ISCR           LD      A, 1
                LD      (WASCR), A
                CALL    STORELINE
                JR      .SKIP

.ISLF           LD      A, (WASCR)
                AND     A
                JR      NZ, .SKIPLF     ; IF CRLF, SKIP THE LF
                CALL    STORELINE
                JR      .SKIP
.SKIPLF         XOR     A
                LD      (WASCR), A
                JR      .SKIP

.SKIP           POP     HL
                INC     HL
                POP     BC
                DEC     BC
                LD      A, B
                OR      C
                JR      NZ, .PROCLP
                JR      .READBLK

.EOF            LD      A, (CURLLEN)
                AND     A
                JR      Z, .CHKTOT
                CALL    STORELINE       ; STORE FINAL PENDING LINE
                JR      .CLSFIL
.CHKTOT         LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                JR      NZ, .CLSFIL
                CALL    STORELINE       ; ENSURE AT LEAST 1 LINE IF FILE WAS EMPTY
.CLSFIL         LD      A, (FILEHAND)
                CALL    DSKCLOSE
                
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                RET

; - STORELINE --------
; - FINISH CURRENT LINE, ADD TO DIRECTORY, PREPARE NEXT
; -

STORELINE       LD      A, (TXSEG)
                CALL    PUTP2
                
                LD      HL, TXPAGE
                LD      DE, (LINEOFF)
                ADD     HL, DE          ; HL = START OF RECORD
                
                LD      A, (CURLLEN)
                LD      (HL), A         ; WRITE LEN
                
                ; PAD UNUSED CHARS (CURLLEN..79) WITH SPACE (#20)
                PUSH    HL
                INC     HL              ; HL = TXPAGE + LINEOFF + 1
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = TXPAGE + LINEOFF + 1 + CURLLEN
                LD      A, TEXTCOLS     ; 80
                SUB     E
                JR      Z, .PADEND
                LD      B, A
.PADLP          LD      (HL), ' '
                INC     HL
                DJNZ    .PADLP
.PADEND         POP     HL

                ; CLEAR ATTRS (80 BYTES AT TXPAGE + LINEOFF + 81)
                PUSH    HL
                LD      DE, 81          ; 1 (LEN) + 80 (TEXT)
                ADD     HL, DE          ; HL = ATTR START
                LD      (HL), 0
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, 79
                LDIR
                POP     HL

                ; ADD TO DIRECTORY
                LD      HL, (TOTLINES)
                LD      A, (TXSEG)
                LD      DE, (LINEOFF)
                CALL    DIRWRITE
                
                ; PREPARE NEXT LINE RECORD OFFSET
                LD      HL, (LINEOFF)
                LD      DE, WORKSIZ
                ADD     HL, DE
                LD      (LINEOFF), HL
                
                ; CHECK IF SEGMENT FULL (16KB / 161 ~= 101 LINES)
                ; 16384 - 161 = 16223 (#3F5F)
                LD      DE, #3F5F
                CALL    CMPHLDE
                JR      C, .NOTFULL
                
                CALL    ALLSEG
                LD      (TXSEG), A
                CALL    PUTP2
                LD      HL, 0
                LD      (LINEOFF), HL

.NOTFULL        XOR     A
                LD      (CURLLEN), A
                
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL
                RET


; --- FILESAVE                  ----------------------------------------


; - FILESAVE ---------------------------
; - SAVE BUFFER LINES TO DISK FILE
; - IN:  NONE (USES FILENAME)
; - OUT: NONE
; - CLOBBERS: ALL
; -

FILESAVE        LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                RET     Z               ; NO FILENAME TO SAVE
                
                CALL    DSKCREAT
                RET     C               ; ERROR CREATING FILE
                LD      (SAVHAND), A
                
                LD      BC, 0           ; BC = DOCLINE (0..TOTLINES-1)
.LINELP         PUSH    BC
                LD      H, B
                LD      L, C
                CALL    LINEREAD        ; LOAD INTO WORKBUF
                
                ; WRITE LINE CHARACTERS: WORKBUF[0] BYTES
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .WREOL
                
                LD      L, A
                LD      H, 0
                LD      DE, WORKBUF + 1
                LD      A, (SAVHAND)
                CALL    DSKWRITE
                
.WREOL          ; WRITE CR, LF
                LD      HL, 2
                LD      DE, CRLFSTR
                LD      A, (SAVHAND)
                CALL    DSKWRITE
                
                POP     BC
                INC     BC
                LD      H, B
                LD      L, C
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .LINELP
                
                LD      A, (SAVHAND)
                CALL    DSKCLOSE
                
                XOR     A
                LD      (MODIFIED), A
                RET

CRLFSTR         DEFB    CR, LF
SAVHAND         DEFB    0


; --- FSAVEAS                ----------------------------------------

FSAVEAS      RET


; --- TEMP VARS FOR LOADER      ----------------------------------------

LINEOFF         DEFW    0               ; START OF CURRENT LINE RECORD
CURLLEN         DEFB    0               ; CURRENT LINE LENGTH
