;                                       ****************************************
;                                       * FILE I/O                             *
;                                       ****************************************
;
; USES HIGH-LEVEL DSK* WRAPPERS FROM BDOS.Z8A (DOS1/DOS2 TRANSPARENT).


; --- FILENEW                   ----------------------------------------

FILENEW         JP      BUFRESET


; --- FILELOAD                  ----------------------------------------

; - FILELOAD ---------
; - LOAD FILE FROM DISK INTO BUFFER
; - HL: FILENAME (ASCIIZ)
; -

FILELOAD        PUSH    HL
                CALL    FILENEW         ; RESET BUFFER AND ALLOCATE INITIAL SEGS
                POP     HL

                CALL    DSKOPEN         ; A=HANDLE, DEHL=SIZE
                RET     C
                LD      (FILEHAND), A

                LD      HL, 0
                LD      (TOTLINES), HL
                LD      (LINEOFF), HL
                XOR     A
                LD      (CURLLEN), A
                LD      (WASCR), A
                LD      (EOLARED), A

.READBLK        LD      A, (FILEHAND)
                LD      HL, 256
                LD      DE, FILEBUF
                CALL    DSKREAD         ; HL = BYTES READ
                LD      A, H
                OR      L
                JP      Z, .EOF
                
                LD      B, H
                LD      C, L            ; BC = BYTES TO PROCESS
                LD      HL, FILEBUF
.PROCLP         PUSH    BC
                PUSH    HL
                
                LD      A, (HL)
                CP      13              ; CR
                JR      Z, .ISCR
                CP      10              ; LF
                JP      Z, .ISLF
                CP      9               ; TAB
                JR      Z, .ISTAB
                
                ; REGULAR CHARACTER: CLEAR WASCR
                PUSH    AF
                XOR     A
                LD      (WASCR), A
                POP     AF
                
                ; APPEND TO CURRENT LINE IN TXPAGE
                LD      B, A
                LD      A, (TXSEG)
                CALL    PUTP2
                
                LD      A, (CURLLEN)
                CP      80
                JP      NC, .SKIP       ; TRUNCATE
                
                LD      HL, TXPAGE + 1  ; SKIP LEN BYTE
                LD      DE, (LINEOFF)
                ADD     HL, DE
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = TXPAGE + LINEOFF + 1 + CURLLEN
                LD      (HL), B
                
                INC     A
                LD      (CURLLEN), A
                JP      .SKIP

.ISTAB          ; TAB EXPANSION: INSERT SPACES UP TO NEXT TAB STOP
                XOR     A
                LD      (WASCR), A

                LD      A, (TABWIDTH)
                LD      D, A            ; D = TABWIDTH
                LD      A, (CURLLEN)
.TABMD          CP      D
                JR      C, .TABRM
                SUB     D
                JR      .TABMD
.TABRM          ; A = CURLLEN % TABWIDTH
                LD      E, A
                LD      A, D
                SUB     E               ; A = SPACES TO ADD (1..TABWIDTH)
                LD      E, A            ; E = COUNT OF SPACES

.TABSP          LD      A, (CURLLEN)
                CP      80
                JR      NC, .SKIP       ; TRUNCATE AT 80 COLS

                LD      A, (TXSEG)
                CALL    PUTP2

                LD      HL, TXPAGE + 1
                LD      BC, (LINEOFF)
                ADD     HL, BC
                LD      A, (CURLLEN)
                LD      C, A
                LD      B, 0
                ADD     HL, BC
                LD      (HL), ' '

                LD      A, (CURLLEN)
                INC     A
                LD      (CURLLEN), A

                DEC     E
                JR      NZ, .TABSP
                JP      .SKIP

.ISCR           LD      A, 1
                LD      (WASCR), A
                ; EOL AUTO-DETECT: DOS CRLF
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORCR
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORCR
                XOR     A
                LD      (SAVEEOL), A    ; DETECTED DOS (CRLF)
                INC     A
                LD      (EOLARED), A
.STORCR         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP

.ISLF           LD      A, (WASCR)
                AND     A
                JR      NZ, .SKIPLF     ; IF CRLF, SKIP THE LF
                ; STANDALONE LF: UNIX EOL
                LD      A, (AUTOLOD)
                OR      A
                JR      Z, .STORLF
                LD      A, (EOLARED)
                OR      A
                JR      NZ, .STORLF
                LD      A, 1
                LD      (SAVEEOL), A    ; DETECTED UNIX (LF)
                LD      (EOLARED), A
.STORLF         CALL    STORLINE
                JR      C, .OOM
                JP      .SKIP
.SKIPLF         XOR     A
                LD      (WASCR), A
                JP      .SKIP

.OOM            POP     HL              ; BALANCE PUSH HL IN .PROCLP
                POP     BC              ; BALANCE PUSH BC IN .PROCLP
                JR      .CLSFIL

.SKIP           POP     HL
                INC     HL
                POP     BC
                DEC     BC
                LD      A, B
                OR      C
                JP      NZ, .PROCLP
                JP      .READBLK

.EOF            LD      A, (CURLLEN)
                AND     A
                JR      Z, .CHKTOT
                CALL    STORLINE        ; STORE FINAL PENDING LINE
                JR      .CLSFIL
.CHKTOT         LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                JR      NZ, .CLSFIL
                CALL    STORLINE        ; ENSURE AT LEAST 1 LINE IF FILE WAS EMPTY
.CLSFIL         LD      A, (FILEHAND)
                CALL    DSKCLOSE
                
                LD      HL, 0
                LD      (TOPLINE), HL
                LD      (DOCLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                RET

; - STORLINE ---------------------------
; - FINISH CURRENT LINE, ADD TO DIRECTORY, PREPARE NEXT
; - IN:  NONE (USES CURLLEN, LINEOFF, TXSEG, TOTLINES)
; - OUT: CY = 1  NO ROOM LEFT (DIRECTORY FULL, OR NO MAPPER SEGMENT LEFT)
; - CLOBBERS: ALL
; -

STORLINE        ; REFUSE IF THE LINE DIRECTORY IS FULL. EDNWLIN AND EDPSHWR
                ; ALREADY GUARD THEIR OWN INSERTS; THE LOADER DID NOT, AND A
                ; LONG ENOUGH FILE WOULD HAVE WALKED PAST THE END OF THE
                ; DIRECTORY. THE CALLER'S .OOM PATH SHOWS WHAT LOADED.
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                JR      C, .HAVROOM
                SCF
                RET

.HAVROOM        LD      A, (TXSEG)
                CALL    PUTP2
                
                LD      HL, TXPAGE
                LD      DE, (LINEOFF)
                ADD     HL, DE          ; HL = START OF RECORD
                
                LD      A, (CURLLEN)
                LD      (HL), A         ; WRITE LEN
                
                ; PAD UNUSED CHARS (CURLLEN..79) WITH SPACE (#20)
                PUSH    HL
                INC     HL              ; HL = TXPAGE + LINEOFF + 1
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = TXPAGE + LINEOFF + 1 + CURLLEN
                LD      A, TEXTCOLS     ; 80
                SUB     E
                JR      Z, .PADEND
                LD      B, A
.PADLP          LD      (HL), ' '
                INC     HL
                DJNZ    .PADLP
.PADEND         POP     HL

                ; CLEAR ATTRS (80 BYTES AT TXPAGE + LINEOFF + 81)
                PUSH    HL
                LD      DE, 81          ; 1 (LEN) + 80 (TEXT)
                ADD     HL, DE          ; HL = ATTR START
                LD      (HL), 0
                LD      D, H
                LD      E, L
                INC     DE
                LD      BC, 79
                LDIR
                POP     HL

                ; ADD TO DIRECTORY
                LD      HL, (TOTLINES)
                LD      A, (TXSEG)
                LD      DE, (LINEOFF)
                CALL    DIRWRITE
                
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; PREPARE NEXT LINE RECORD OFFSET
                LD      HL, (LINEOFF)
                LD      DE, WORKSIZ
                ADD     HL, DE
                LD      (LINEOFF), HL
                
                ; CHECK IF THE SEGMENT IS FULL (101 RECORDS OF 161 BYTES)
                LD      DE, SEGLAST + 1
                CALL    CMPHLDE
                JR      C, .NOTFULL

                CALL    SEGGET
                RET     C               ; CY = 1: OUT OF MEMORY FOR NEXT SEGMENT
                LD      (TXSEG), A
                ; THE LOADER *IS* THE APPEND CURSOR WHILE IT RUNS, SO APPSEG
                ; HAS TO FOLLOW. WITHOUT THIS IT KEPT THE VALUE BUFRESET LEFT
                ; -- THE FIRST SEGMENT -- WHILE LINEOFF WALKED INTO THE SECOND,
                ; AND THE FIRST NEWLINE AFTER LOADING RESERVED A RECORD AT
                ; (FIRST SEGMENT, OFFSET INSIDE THE LAST ONE), LANDING ON TOP
                ; OF A LINE ALREADY THERE. MEASURED ON A 200 LINE DOCUMENT:
                ; LINEOFF 15939 = RECORD 99 OF SEGMENT 0, SO ONE RETURN KEY
                ; OVERWROTE LINE 99 WITH THE TEXT BEING SPLIT OFF LINE 0.
                LD      (APPSEG), A
                CALL    PUTP2
                LD      HL, 0
                LD      (LINEOFF), HL

.NOTFULL        XOR     A
                LD      (CURLLEN), A
                AND     A               ; CY = 0: SUCCESS
                RET


; --- FILESAVE                  ----------------------------------------


; - FILESAVE ---------------------------
; - SAVE BUFFER LINES TO DISK FILE
; - IN:  NONE (USES FILENAME)
; - OUT: NONE
; - CLOBBERS: ALL
; -

FILESAVE        LD      HL, FILENAME
                LD      A, (HL)
                OR      A
                RET     Z               ; NO FILENAME TO SAVE
                
                CALL    DSKCREAT
                RET     C               ; ERROR CREATING FILE
                LD      (SAVHAND), A
                
                LD      BC, 0           ; BC = DOCLINE (0..TOTLINES-1)
.LINELP         PUSH    BC
                LD      H, B
                LD      L, C
                CALL    LINEREAD        ; LOAD INTO WORKBUF
                
                ; WRITE LINE CHARACTERS: WORKBUF[0] BYTES
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .WREOL
                
                LD      L, A
                LD      H, 0
                LD      DE, WORKBUF + 1
                LD      A, (SAVHAND)
                CALL    DSKWRITE
                
.WREOL          ; WRITE CR, LF (DOS) OR LF ONLY (UNIX)
                LD      HL, 2
                LD      DE, CRLFSTR
                LD      A, (SAVEEOL)
                OR      A
                JR      Z, .WREOL2
                ; UNIX EOL: WRITE LF ONLY
                LD      HL, 1
                INC     DE
.WREOL2         LD      A, (SAVHAND)
                CALL    DSKWRITE
                
                POP     BC
                INC     BC
                LD      H, B
                LD      L, C
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .LINELP
                
                LD      A, (SAVHAND)
                CALL    DSKCLOSE
                
                XOR     A
                LD      (MODIFIED), A
                RET

CRLFSTR         DEFB    CR, LF
SAVHAND         DEFB    0


; --- FSAVEAS                ----------------------------------------

FSAVEAS      RET


; --- TEMP VARS FOR LOADER      ----------------------------------------

LINEOFF         DEFW    0               ; START OF CURRENT LINE RECORD
CURLLEN         DEFB    0               ; CURRENT LINE LENGTH
