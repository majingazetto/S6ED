; **********************************************
; * XSEG.Z8A - INTER-SEGMENT CALL MACHINERY    *
; * CORE (PAGES 0+1) <-> FEATURE (PAGE 2)      *
; **********************************************


; --- FCALL                     ----------------------------------------


; - FCALL ------------------------------
; - CALL ROUTINE IN FEATURE SEGMENT AT PAGE 2
; - IN:  A  = TARGET FEATURE SEGMENT
; -      HL = ENTRY ADDRESS (#8000-#BFFF)
; - OUT: PRESERVES TARGET RETURN VALUES (AF, BC, DE, HL)
; - CLOBBERS: NONE (BEYOND TARGET REGISTERS)
; -

FCALL           PUSH    BC
                PUSH    DE
                LD      C, A            ; C = TARGET FEATURE SEGMENT
                PUSH    HL              ; SAVE ENTRY ADDRESS

                ; PUSH CURRENT STATE TO SEGSTK (TXSEG, HOMESEG)
                LD      HL, SEGSP
                LD      E, (HL)
                INC     (HL)
                INC     (HL)            ; SEGSP += 2
                LD      D, 0
                LD      HL, SEGSTK
                ADD     HL, DE          ; HL = POINTER TO FRAME
                LD      A, (TXSEG)
                LD      (HL), A         ; FRAME[0] = PREV TXSEG
                INC     HL
                LD      A, (HOMESEG)
                LD      (HL), A         ; FRAME[1] = PREV HOMESEG

                ; BANK TARGET SEGMENT INTO PAGE 2
                LD      A, C
                LD      (HOMESEG), A
                LD      (TXSEG), A
                CALL    PUTP2

                POP     HL              ; HL = TARGET ENTRY ADDRESS
                POP     DE
                POP     BC

                ; CALL TARGET ROUTINE IN PAGE 2
                CALL    CALHL

                ; PRESERVE RETURN REGISTERS AND FLAGS
                PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                ; RESTORE PREVIOUS STATE FROM SEGSTK
                LD      HL, SEGSP
                DEC     (HL)
                DEC     (HL)            ; SEGSP -= 2
                LD      E, (HL)
                LD      D, 0
                LD      HL, SEGSTK
                ADD     HL, DE
                LD      A, (HL)         ; A = PREV TXSEG
                INC     HL
                LD      B, (HL)         ; B = PREV HOMESEG
                LD      HL, HOMESEG
                LD      (HL), B
                LD      (TXSEG), A
                CALL    PUTP2           ; RESTORE PAGE 2 MAPPING (CLOBBERS HL)

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; --- CHKDAT                    ----------------------------------------


; - CHKDAT -----------------------------
; - VERIFY S6ED.DAT EXISTS BEFORE ENTERING GRAPHICS MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

CHKDAT          LD      HL, DATNAME
                CALL    DSKOPEN
                JR      C, .ERRDAT
                CALL    DSKCLOSE
                RET

.ERRDAT         LD      DE, ENODAT
                JP      ERRMSG


; --- DATLOAD                   ----------------------------------------


; - DATLOAD ----------------------------
; - LOAD S6ED.DAT CONTAINER INTO MAPPER FEATURE SEGMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DATLOAD         LD      HL, DATNAME
                CALL    DSKOPEN
                JP      C, .ERRDAT
                LD      (DATHAND), A

                LD      HL, 16          ; READ 16-BYTE FILE HEADER
                LD      DE, DATHDR
                CALL    DSKREAD         ; HL = BYTES READ

                ; VERIFY 16 BYTES READ
                LD      DE, 16
                OR      A
                SBC     HL, DE
                JP      NZ, .ERRCOR

                ; VERIFY MAGIC: "S6ED"
                LD      HL, DATHDR
                LD      A, (HL)
                CP      'S'
                JP      NZ, .ERRCOR
                INC     HL
                LD      A, (HL)
                CP      '6'
                JP      NZ, .ERRCOR
                INC     HL
                LD      A, (HL)
                CP      'E'
                JP      NZ, .ERRCOR
                INC     HL
                LD      A, (HL)
                CP      'D'
                JP      NZ, .ERRCOR

                ; VERIFY VERSION: 1 (16-BIT LE: #01, #00)
                INC     HL
                LD      A, (HL)
                CP      1
                JP      NZ, .ERRCOR
                INC     HL
                LD      A, (HL)
                OR      A
                JP      NZ, .ERRCOR

                ; VERIFY AT LEAST 1 BLOCK (OFFSET 7: NUMBLKS)
                LD      A, (DATHDR + 7)
                OR      A
                JP      Z, .ERRCOR

                ; READ FIRST BLOCK DESCRIPTOR (8 BYTES) INTO DATBLK
                LD      A, (DATHAND)
                LD      HL, 8
                LD      DE, DATBLK
                CALL    DSKREAD

                ; VERIFY 8 BYTES READ
                LD      DE, 8
                OR      A
                SBC     HL, DE
                JP      NZ, .ERRCOR

                ; GET BLOCK 0 LENGTH: (DATBLK + 4)
                LD      HL, (DATBLK + 4)
                LD      A, H
                OR      L
                JP      Z, .ERRCOR

                PUSH    HL              ; SAVE PAYLOAD LENGTH

                ; MAP FTRSEG INTO PAGE 2 (#8000-#BFFF)
                LD      A, (FTRSEG)
                LD      (TXSEG), A
                CALL    PUTP2

                ; READ PAYLOAD DIRECTLY INTO #8000
                POP     HL              ; HL = BYTES TO READ
                PUSH    HL              ; SAVE EXPECTED BYTES
                LD      A, (DATHAND)
                LD      DE, #8000
                CALL    DSKREAD

                ; VERIFY PAYLOAD BYTES READ
                POP     DE              ; DE = EXPECTED BYTES
                OR      A
                SBC     HL, DE
                JP      NZ, .ERRCOR

                ; CLOSE FILE
                LD      A, (DATHAND)
                CALL    DSKCLOSE

                ; RESTORE PAGE 2 TO DEFSEG2
                LD      A, (DEFSEG2)
                LD      (TXSEG), A
                CALL    PUTP2
                RET

.ERRDAT         LD      DE, ENODAT
                JP      ERRMSG

.ERRCOR         LD      A, (DATHAND)
                CALL    DSKCLOSE
                LD      DE, ENODCOR
                JP      ERRMSG


; --- CFGRUN                    ----------------------------------------


; - CFGRUN -----------------------------
; - LOAD S6ED.CFG VIA RESIDENT FEATURE SEGMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CFGRUN          CALL    DATLOAD
                LD      A, (FTRSEG)
                LD      HL, CFGLOAD
                JP      FCALL

DATNAME         DEFM    "S6ED.DAT", 0
ENODAT          DEFM    "S6ED.DAT not found.", 13, 10, "$"
ENODCOR         DEFM    "S6ED.DAT corrupt.", 13, 10, "$"
