;                                       ****************************************
;                                       * INPUT                                *
;                                       ****************************************
;
; KEYBOARD INPUT AND MAIN DISPATCH LOOP.
; USES BDOS _DIRIO (#06) FOR NON-BLOCKING CONSOLE INPUT.
; CURSOR BLINKING TIMED VIA SYSTEM JIFFY (#FC9E).


; --- MAINLOOP                  ----------------------------------------


; - MAINLOOP ---------------------------
; - MAIN EDITOR EVENT LOOP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

MAINLOOP        ; POLL KEYBOARD VIA BIOS CHSNS (#009C)
                LD      IX, CHSNS
                CALL    BIOSCALL
                JR      NZ, .KEYHIT

                ; NO KEY: UPDATE CURSOR BLINK USING JIFFY
                LD      A, (JIFFY)
                LD      HL, BLNKCNT
                SUB     (HL)
                CP      20              ; ~1/3 SECOND (20 TICKS AT 50/60HZ)
                JR      C, MAINLOOP

                ; TOGGLE CURSOR BLINK PHASE
                LD      A, (JIFFY)
                LD      (BLNKCNT), A
                CALL    DRWCUR          ; TOGGLES XOR OVERLAY
                LD      A, (BLNKPH)
                XOR     1
                LD      (BLNKPH), A
                JR      MAINLOOP

.KEYHIT         ; IF CURSOR IS VISIBLE, ERASE BEFORE EDITING/MOVING
                LD      A, (BLNKPH)
                AND     A
                JR      Z, .NOERASE
                CALL    DRWCUR
                XOR     A
                LD      (BLNKPH), A
.NOERASE        ; READ KEY FROM KEYBOARD BUFFER VIA BIOS CHGET (#009F)
                LD      IX, CHGET
                CALL    BIOSCALL

                ; DISPATCH KEYPRESS THROUGH ACTIVE KEYMAP AND ACTION CATALOG
                CALL    DISPKEY

.DRAWCUR        ; REDRAW CURSOR AT CURRENT POSITION & RESET BLINK
                CALL    DRWCUR
                LD      A, 1
                LD      (BLNKPH), A
                LD      A, (JIFFY)
                LD      (BLNKCNT), A
                JP      MAINLOOP
