;                                       ****************************************
;                                       * CONSTANTS                            *
;                                       ****************************************


; --- VERSION                   ----------------------------------------


VERSION
.MAJOR          EQU     "0"
.MINOR          EQU     "1"


; --- SCREEN LAYOUT             ----------------------------------------


                ; CHARACTER GRID
SCRCOLS         EQU     80              ; TEXT AREA COLUMNS
SCRROWS         EQU     24              ; TEXT AREA ROWS (ROWS 1-24)
CELLW           EQU     6               ; CELL WIDTH IN PIXELS
CELLH           EQU     8               ; CELL HEIGHT IN PIXELS

                ; PIXEL LAYOUT
GUTL_PX         EQU     24              ; LEFT GUTTER WIDTH (4 CHARS × 6PX)
GUTR_PX         EQU     8               ; RIGHT GUTTER WIDTH (SCROLLBAR)
TXAREAPX       EQU     480             ; TEXT AREA WIDTH (80 × 6PX)
TXORG_X         EQU     GUTL_PX         ; TEXT AREA X ORIGIN
TXORG_Y         EQU     CELLH           ; TEXT AREA Y ORIGIN (SKIP MENU ROW 0)
SCRTOTY      EQU     212             ; TOTAL SCREEN HEIGHT IN PIXELS

                ; ROWS (IN CHARACTER UNITS)
MNUROW          EQU     0               ; MENU BAR ROW
TXRFIRST    EQU     1               ; FIRST TEXT ROW
TXRLAST     EQU     24              ; LAST TEXT ROW
STBROW          EQU     25              ; STATUS BAR ROW

                ; SCROLL RECTANGLE. THE VERTICAL SCROLL HMMM COVERS THE LINE
                ; NUMBER GUTTER AS WELL AS THE TEXT, SO THE NUMBERS TRAVEL IN
                ; HARDWARE AND ONLY THE ONE NEW ROW HAS TO BE DRAWN. THE
                ; SCROLLBAR AT X 504-511 STAYS OUTSIDE IT.
SCRLWPX         EQU     GUTL_PX + TXAREAPX      ; 504

                ; SCROLLBAR THUMB GEOMETRY
THMTOP          EQU     TXORG_Y                 ; 8: TOP OF THE TRACK
THMTRK          EQU     SCRROWS * CELLH         ; 192: TRACK HEIGHT
THMH            EQU     24                      ; THUMB HEIGHT
THMTRAV         EQU     THMTRK - THMH           ; 168: TRAVEL RANGE


; --- VRAM MAP                  ----------------------------------------


                ; EACH FONT TABLE NEEDS 8 KB OF ADDRESS SPAN, NOT 4 KB: A
                ; GLYPH ROW IS 8 SCANLINES AND A VRAM LINE IS 128 BYTES, SO ONE
                ; TABLE COVERS 64 VRAM LINES. THE OLD #7000 / #8000 / #9000 /
                ; #A000 MAP PUT THE BASES 4 KB APART AND EVERY TABLE RAN OVER
                ; THE NEXT ONE.

VR_DISP         EQU     #00000          ; DISPLAY BITMAP (128 B/LINE X 212 LINES)

                ; #06A00-#07FFF IS FREE AND MUST STAY CLEAR: THOSE ARE DISPLAY
                ; LINES 212-255, NOT VISIBLE TODAY BUT EXPOSED BY AN R#23
                ; HARDWARE SCROLL. THE BIOS SCREEN 6 SPRITE TABLES STILL SIT IN
                ; THAT BAND; THEY ARE NEVER FETCHED BECAUSE SCRINIT DISABLES
                ; SPRITES (R#8 SPD=1), AND MOVING THEM ABOVE #10000 BELONGS TO
                ; THE R#23 WORK, NOT HERE.

VR_FNORM        EQU     #08000          ; FONT: NORMAL       SY 256
VR_FBOLD        EQU     #0A000          ; FONT: BOLD         SY 320
VR_FITAL        EQU     #0C000          ; FONT: ITALIC       SY 384
VR_FBI          EQU     #0E000          ; FONT: BOLD+ITALIC  SY 448

FONTSIZ         EQU     2048            ; 256 GLYPHS X 8 BYTES, 1BPP (SOURCE)

                ; FONT TABLE GEOMETRY (ALL TABLES IDENTICAL STRUCTURE)
                ;   32 GLYPHS PER ROW -> 8 ROWS (256 TOTAL)
                ;   GLYPH N: SX = (N % 32) * 8,  SY = TABLE_SY + (N / 32) * 8
                ;   TABLE_SY = (VR_FXXX - VR_DISP) / 128
                ;   ONE TABLE = 64 VRAM LINES X 128 BYTES = 8 KB OF SPAN; THE
                ;   32 GLYPHS OF A ROW LIVE IN THE LEFT 64 BYTES OF EACH LINE.
FNORM_SY        EQU     (VR_FNORM - VR_DISP) / 128     ; = 256
FBOLD_SY        EQU     (VR_FBOLD - VR_DISP) / 128     ; = 320
FITAL_SY        EQU     (VR_FITAL - VR_DISP) / 128     ; = 384
FBI_SY          EQU     (VR_FBI   - VR_DISP) / 128     ; = 448


; --- PALETTE                   ----------------------------------------


                ; COLOR INDICES (SCREEN 6, 4 COLORS)
COL_BG          EQU     0               ; BACKGROUND
COL_FG          EQU     1               ; NORMAL TEXT / FOREGROUND
COL_UI          EQU     2               ; UI CHROME (GUTTERS, MENU, STATUS)
COL_HI          EQU     3               ; CURSOR / HIGHLIGHT / ACCENT

                ; BYTE PATTERNS (SCREEN 6, 4 PIXELS PER BYTE FOR HMMV)
CLR_BG          EQU     #00             ; 4 PIXELS OF COLOR 0 (%00000000)
CLR_FG          EQU     #55             ; 4 PIXELS OF COLOR 1 (%01010101)
CLR_UI          EQU     #AA             ; 4 PIXELS OF COLOR 2 (%10101010)
CLR_HI          EQU     #FF             ; 4 PIXELS OF COLOR 3 (%11111111)


; --- CHARACTER ATTRIBUTES      ----------------------------------------


                ; ATTR BYTE BIT DEFINITIONS (PER CELL, STORED ALONGSIDE TEXT)
ATRBOLD       EQU     #01             ; BIT 0
ATRITAL       EQU     #02             ; BIT 1
ATRUNDR       EQU     #04             ; BIT 2
ATRINV        EQU     #08             ; BIT 3  (INVERSE VIDEO)
ATRFMSK   EQU     #03             ; BITS 0-1 → FONT VARIANT INDEX


; --- TEXT BUFFER / MAPPER      ----------------------------------------


MAXLINES        EQU     5460            ; MAX DOCUMENT LINES
                                        ;   16384 / DIRSIZ = 5461; USE 5460
DIRSIZ          EQU     3               ; BYTES PER LINE DIRECTORY ENTRY
                                        ;   [1: SEGMENT] [2: WORD OFFSET]
LINEREC         EQU     161             ; MAX LINE RECORD: 1 + 80 + 80
TEXTCOLS        EQU     80              ; MAX CHARS PER LINE
WORKSIZ         EQU     LINEREC         ; WORK BUFFER SIZE (= MAX RECORD)

DIRPAGE         EQU     #4000           ; PAGE 1 — LINE DIRECTORY (FIXED SEGMENT)
TXPAGE          EQU     #8000           ; PAGE 2 — TEXT WINDOW (SWITCHED)

                ; SEGMENT ALLOCATION TYPE (FOR ALL_SEG)
SEG_USER        EQU     0               ; A=0: ALLOCATE USER SEGMENT
SEG_SYS         EQU     1               ; A=1: ALLOCATE SYSTEM SEGMENT

MAXSEGS         EQU     32              ; SEGMENTS THE EDITOR WILL TRACK
                                        ;   1 DIRECTORY + 31 TEXT = 496KB
LINEPSEG        EQU     16384 / LINEREC ; 101 LINE RECORDS PER SEGMENT
SEGLAST         EQU     (LINEPSEG - 1) * LINEREC
                                        ; OFFSET OF THE LAST RECORD THAT STILL
                                        ; FITS WHOLE INSIDE A 16KB SEGMENT


; --- LANGUAGE MODES            ----------------------------------------


LGNONE       EQU     0
LANG_Z80        EQU     1
LGBASIC      EQU     2
LANG_C          EQU     3
LGPYTHN     EQU     4


; --- MISC                      ----------------------------------------



INS_MODE        EQU     1               ; INSERT
OVR_MODE        EQU     0               ; OVERWRITE


; --- WRAP MODES                ----------------------------------------


WRAP_DEV        EQU     0               ; DEVELOPER MODE: CLAMP AT COL 79 (NO AUTO-WRAP)
WRAP_TXT        EQU     1               ; TEXT MODE: SMART WORD-WRAP


; --- MODIFIERS BITMASK         ----------------------------------------


MODNONE         EQU     %00000000
MODSHFT         EQU     %00000001       ; SHIFT (ROW 6 BIT 0)
MODCTRL         EQU     %00000010       ; CTRL  (ROW 6 BIT 1)
MODGRPH         EQU     %00000100       ; GRAPH (ROW 6 BIT 2)
MODANY          EQU     %11111111       ; MATCH ANY MODIFIER STATE


; --- ACTION CATALOG IDS        ----------------------------------------


ACNONE          EQU     0
ACMVL           EQU     1
ACMVR           EQU     2
ACMVU           EQU     3
ACMVD           EQU     4
ACBOL           EQU     5               ; CTRL + <
ACEOL           EQU     6               ; CTRL + >
ACTOP           EQU     7               ; CTRL + UP
ACBOT           EQU     8               ; CTRL + DOWN
ACWLFT          EQU     9               ; GRAPH + <
ACWRGT          EQU     10              ; GRAPH + >
ACDWLFT         EQU     11              ; GRAPH + BS
ACPGUP          EQU     12              ; GRAPH + UP
ACPGDN          EQU     13              ; GRAPH + DOWN
ACDELBK         EQU     14              ; BS
ACDELFW         EQU     15              ; DEL
ACDELLN         EQU     16              ; CTRL + Y (OR dd IN VI)
ACNWLIN         EQU     17              ; CR
ACOPNBL         EQU     18              ; VI o
ACOPNAB         EQU     19              ; VI O
ACTGLIN         EQU     20              ; INS
ACTGLWR         EQU     21              ; CTRL + W
ACSAVE          EQU     22              ; F2 / CTRL + S
ACQUIT          EQU     23              ; ESC / CTRL + Q
ACHELP          EQU     24              ; F1
ACCYCKM         EQU     25              ; F5 / CTRL + K
ACVIINS         EQU     26              ; VI i
ACVIAPP         EQU     27              ; VI a
ACVINRM         EQU     28              ; VI ESC
ACVILED         EQU     29              ; VI LEADER 'd'
ACMAX           EQU     30


; --- KEYMAP PROFILES           ----------------------------------------


KMSTD           EQU     0               ; STANDARD / CUA (DEFAULT)
KMWS            EQU     1               ; WORDSTAR / TURBO PASCAL
KMEMACS         EQU     2               ; EMACS
KMVI            EQU     3               ; VI MODAL

VIMNORM         EQU     0               ; VI NORMAL MODE
VIMINS          EQU     1               ; VI INSERT MODE
