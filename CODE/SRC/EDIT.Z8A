;                                       ****************************************
;                                       * EDIT OPERATIONS                      *
;                                       ****************************************
;
; ALL EDITING OPERATIONS WORK ON WORKBUF (CURRENT LINE LOADED BY LINEREAD).
; AFTER EACH EDIT: LINEWRT TO PERSIST, RENDEROW TO RE-RENDER.


; --- EDINSCHR                  ----------------------------------------


; - EDINSCHR ---------------------------
; - INSERT CHARACTER AT CURSOR POSITION
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDINSCHR        PUSH    AF
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                POP     AF

                LD      C, A            ; C = CHAR TO INSERT
                LD      A, (CURX)
                CP      TEXTCOLS        ; 80
                RET     NC              ; CURX >= 80, CANNOT INSERT

                ; COLUMN 79 STILL FREE? THEN SHIFT-AND-INSERT IS SAFE AND THE
                ; CURSOR COLUMN DOES NOT MATTER -- NOTHING FALLS OFF THE EDGE.
                LD      A, (WORKBUF + TEXTCOLS)
                CP      ' '
                JR      Z, .DOINS

                ; COLUMN 79 IS OCCUPIED: INSERTING WOULD PUSH TEXT OUT OF THE
                ; RECORD. WHAT HAPPENS NEXT IS THE WRAP MODE'S DECISION.
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; WRAP_DEV: CLAMP, NEVER LOSE CODE

                ; WRAP_TXT: A SPACE TYPED AT THE MARGIN IS JUST A LINE BREAK;
                ; ANYTHING ELSE PUSHES THE TRAILING WORD DOWN A LINE.
                LD      A, (CURX)
                CP      TEXTCOLS - 1
                JP      NZ, EDPSHWR
                LD      A, C
                CP      ' '
                JP      Z, EDNWLIN
                JP      EDPSHWR

.DOINS          ; ROOM EXISTS AT COLUMN 79: PLAIN INSERT ON THIS LINE
                LD      HL, WORKBUF
                LD      A, (CURX)
                CALL    WBINS           ; TEXT + ATTRS SHIFTED, LENGTH UPDATED

                ; WRITE LINE TO MAPPER
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; RE-RENDER CURRENT ROW, UNLESS A BATCH EDIT IS RUNNING
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .NOREND
                LD      A, (CURY)
                INC     A
                LD      B, A            ; B = SCREEN ROW (1..24)
                CALL    RENDIFF         ; ONLY THE CELLS THAT CHANGED

.NOREND         ; ADVANCE CURSOR
                LD      A, (CURX)
                INC     A
                CP      TEXTCOLS
                JR      NC, .NOMOV
                LD      (CURX), A
.NOMOV          LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EDINSRUN                  ----------------------------------------


; - EDINSRUN ---------------------------
; - INSERT A RUN OF CHARACTERS ON THE CURRENT LINE IN ONE PASS
; - ONE LINEREAD AND ONE LINEWRT FOR THE WHOLE RUN INSTEAD OF A PAIR PER
; - CHARACTER, AND NO PAINTING AT ALL -- THE CALLER PAINTS WHEN IT IS DONE.
; - IT REFUSES RATHER THAN TRUNCATE: A RUN THAT DOES NOT FIT IS THE WRAP
; - MODE'S BUSINESS, AND ONLY EDINSCHR KNOWS THOSE RULES.
; - IN:  HL = SOURCE, B = COUNT (1-80)
; - OUT: CY = 0  THE WHOLE RUN WENT IN
; -      CY = 1  IT DOES NOT FIT; NOTHING WAS WRITTEN AND A HOLDS HOW MANY
; -              CHARACTERS WOULD HAVE FITTED (0-79), SO THE CALLER CAN PUT
; -              THAT MUCH IN AS A BATCH AND ONLY THEN GO CHARACTER BY
; -              CHARACTER
; - CLOBBERS: ALL
; -

EDINSRUN        LD      (WBSRC), HL     ; SURVIVES LINEREAD
                LD      A, B
                LD      (WBRUN), A
                OR      A
                RET     Z               ; EMPTY RUN, CY = 0

                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; ROOM ON THIS LINE = TEXTCOLS - MAX(LENGTH, COLUMN).
                ; MEASURING FROM THE LENGTH NEVER OVERSTATES IT: A RECORD IS
                ; SPACE PADDED, SO COLUMNS LENGTH..79 ARE ALWAYS FREE.
                LD      A, (WORKBUF)    ; LENGTH
                LD      C, A
                LD      A, (CURX)
                CP      C
                JR      NC, .IRHAVE     ; COLUMN >= LENGTH: MEASURE FROM IT
                LD      A, C
.IRHAVE         LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      C, A            ; C = ROOM
                LD      A, (WBRUN)
                CP      C
                JR      Z, .IRFITS
                JR      C, .IRFITS
                LD      A, C            ; TOO LONG: HAND BACK THE ROOM
                SCF
                RET

.IRFITS         LD      HL, WORKBUF
                LD      DE, (WBSRC)
                LD      A, (WBRUN)
                LD      B, A
                LD      A, (CURX)
                CALL    WBINSN

                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; THE CURSOR ADVANCES BY THE WHOLE RUN, CLAMPED THE WAY
                ; EDINSCHR CLAMPS ITS SINGLE STEP
                LD      A, (CURX)
                LD      C, A
                LD      A, (WBRUN)
                ADD     A, C
                CP      TEXTCOLS
                JR      C, .IRSETX
                LD      A, TEXTCOLS - 1
.IRSETX         LD      (CURX), A

                LD      A, #FF
                LD      (MODIFIED), A
                OR      A               ; CY = 0: THE RUN IS IN
                RET


; --- EDPSHWR                   ----------------------------------------


; - EDPSHWR ----------------------------
; - PUSH-WRAP: THE LINE IS FULL AND A CHARACTER HAS TO GO IN ANYWAY.
; - MOVE THE TRAILING WORD DOWN TO A NEW LINE, THEN INSERT THE CHARACTER
; - ON WHICHEVER HALF THE CURSOR ENDED UP ON.
; - ORDER IS THE WHOLE POINT: SPLIT, INSERT, PERSIST, ONLY THEN RENDER.
; - RENDERING EARLIER WOULD RUN LINEREAD OVER WORKBUF AND LOSE THE HEAD.
; - IN:  C = CHAR TO INSERT, WORKBUF = LINE (DOCLINE), CURX = COLUMN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDPSHWR         ; REFUSE IF THE LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; RESERVE THE RECORD FOR THE WORD THAT IS ABOUT TO MOVE DOWN
                ; BEFORE TOUCHING ANYTHING -- SAME REASON AS IN EDNWLIN. POP
                ; DOES NOT TOUCH THE FLAGS, SO NEWREC'S CARRY SURVIVES IT.
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                CALL    NEWREC
                POP     BC
                RET     C               ; NO MAPPER MEMORY: LEAVE THE LINE ALONE
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 1. SPLIT COLUMN = START OF THE TRAILING WORD
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      B, TEXTCOLS - 2 ; SCAN BACK FROM COLUMN 78
.PWSCAN         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .PWFND
                DEC     B
                LD      A, B
                INC     A               ; B WRAPPED PAST 0 (#FF) -> A = 0
                JR      NZ, .PWSCAN

                ; NO SPACE AT ALL: ONE LONG WORD, HARD BREAK AT THE LAST COLUMN
                LD      A, TEXTCOLS - 1
                JR      .PWSPL

.PWFND          LD      A, B
                INC     A               ; THE WORD STARTS ONE PAST THE SPACE

.PWSPL          POP     BC              ; RESTORE C (CHAR TO INSERT)
                LD      B, A            ; B = SPLIT COLUMN

                ; 2. DECIDE WHICH HALF KEEPS THE CURSOR **BEFORE** SPLITTING,
                ;    WHILE THE WHOLE LINE IS STILL COHERENT IN WORKBUF.
                LD      A, (CURX)
                CP      B
                JR      NC, .PWTAIL     ; CURX >= SPLIT: CURSOR RIDES THE WORD

                LD      (PWCOL), A      ; CURSOR STAYS ON THE HEAD, SAME COLUMN
                XOR     A
                LD      (PWTAIL), A
                JR      .PWDOSPL

.PWTAIL         SUB     B               ; COLUMN MEASURED INSIDE THE MOVED WORD
                LD      (PWCOL), A
                LD      A, #FF
                LD      (PWTAIL), A

.PWDOSPL        ; 3. SPLIT: HEAD KEEPS 0..SPLIT-1, TAIL GOES TO WORKBUF2
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      A, B
                CALL    SPLITLA
                POP     BC              ; RESTORE C

                ; 4. INSERT WHILE BOTH HALVES ARE STILL IN RAM
                LD      HL, WORKBUF
                LD      A, (PWTAIL)
                OR      A
                JR      Z, .PWINS
                LD      HL, WORKBUF2
.PWINS          LD      A, (PWCOL)
                CALL    WBINS

                ; 5. PERSIST THE HEAD BEFORE ANYTHING CAN RENDER
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 6. PUT THE TAIL IN THE RECORD RESERVED AT THE TOP. LINEWRT
                ;    HAS RE-BANKED PAGE 2 SINCE NEWREC, SO BANK IT BACK.
                CALL    APPBANK
                LD      DE, (NROFF)
                LD      HL, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 7. OPEN A DIRECTORY SLOT AFTER THE CURRENT LINE AND FILL IT
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 8. CURSOR LANDS ONE PAST THE CHARACTER JUST TYPED
                LD      A, (PWCOL)
                INC     A
                CP      TEXTCOLS
                JR      C, .PWSETX
                LD      A, TEXTCOLS - 1
.PWSETX         LD      (CURX), A

                LD      A, (PWTAIL)
                OR      A
                JR      Z, .PWMOD
                LD      HL, (DOCLINE)   ; THE CURSOR FOLLOWED THE WORD DOWN
                INC     HL
                LD      (DOCLINE), HL

.PWMOD          LD      A, #FF
                LD      (MODIFIED), A

                ; 9. UPDATE THE DISPLAY. CURY STILL HOLDS THE HEAD'S ROW --
                ;    SETCURY RECOMPUTES IT FROM DOCLINE AND TOPLINE AT THE END.
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .PWHOLD

                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .PWBOT

                INC     A
                INC     A
                LD      B, A            ; B = SCREEN ROW OF THE NEW LINE (2..24)
                PUSH    BC
                CALL    SHIFTDN
                POP     BC

                DEC     B
                CALL    RENDEROW        ; SHORTENED HEAD
                INC     B
                CALL    RENDEROW        ; THE WORD THAT MOVED DOWN
                JP      SETCURY

.PWBOT          ; AT THE BOTTOM THE NEW LINE ONLY FITS IF THE VIEW SCROLLS
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                CALL    SCROLLDN        ; RENDERS ROW 24

                LD      B, TXRLAST - 1  ; ROW 23 NOW HOLDS THE SHORTENED HEAD
                CALL    RENDEROW
                JP      SETCURY

.PWHOLD         ; PAINTING IS DEFERRED, BUT THE VIEWPORT STILL HAS TO FOLLOW
                ; THE NEW LINE WHEN IT LANDS BELOW THE LAST ROW.
                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JP      NZ, SETCURY
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                JP      SETCURY


; --- WBINS                     ----------------------------------------


; - WBINS ------------------------------
; - INSERT A CHARACTER INTO A LINE RECORD AT A COLUMN
; - TEXT AND ATTRIBUTES BOTH SHIFT RIGHT AND THE CELL AT COLUMN 79 FALLS
; - OFF, SO THE CALLER MUST HAVE MADE ROOM THERE FIRST. THE NEW CHARACTER
; - INHERITS THE ATTRIBUTE OF THE CELL IT DISPLACED (THE SHIFT LEAVES THAT
; - BYTE IN PLACE, SO IT COSTS NOTHING).
; - IN:  HL = RECORD BASE, A = COLUMN (0-79), C = CHAR CODE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WBINS           LD      (WBBASE), HL
                LD      (WBCOL), A

                ; BYTES TO SHIFT RIGHT = 79 - COLUMN
                LD      E, A
                LD      A, TEXTCOLS - 1
                SUB     E
                JR      Z, .WBPUT       ; INSERTING AT COLUMN 79: NOTHING MOVES
                LD      (WBCNT), A

                ; TEXT HALF: COLUMNS COL..78 MOVE UP TO COL+1..79
                LD      DE, TEXTCOLS - 1
                ADD     HL, DE          ; HL = BASE + 79 (TEXT OF COLUMN 78)
                LD      D, H
                LD      E, L
                INC     DE              ; DE = BASE + 80 (TEXT OF COLUMN 79)
                LD      A, (WBCNT)
                PUSH    BC              ; SAVE C (CHAR)
                LD      C, A
                LD      B, 0
                LDDR
                POP     BC

                ; ATTRIBUTE HALF, EXACTLY THE SAME SHIFT
                LD      HL, (WBBASE)
                LD      DE, TEXTCOLS + TEXTCOLS - 1
                ADD     HL, DE          ; HL = BASE + 159 (ATTR OF COLUMN 78)
                LD      D, H
                LD      E, L
                INC     DE              ; DE = BASE + 160 (ATTR OF COLUMN 79)
                LD      A, (WBCNT)
                PUSH    BC
                LD      C, A
                LD      B, 0
                LDDR
                POP     BC

.WBPUT          ; PLACE THE CHARACTER AND ATTRIBUTE
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                INC     HL
                ADD     HL, DE          ; HL = BASE + 1 + COLUMN
                LD      (HL), C
                LD      DE, TEXTCOLS
                ADD     HL, DE          ; HL = BASE + 1 + TEXTCOLS + COLUMN
                LD      A, (TYPATTR)
                LD      (HL), A

                ; LENGTH. TWO CASES, AND THEY ARE NOT THE SAME:
                ;   COLUMN >= LENGTH -- WRITING PAST THE END, NOTHING SHIFTED,
                ;                       SO THE LINE NOW REACHES COLUMN + 1.
                ;   COLUMN <  LENGTH -- A REAL CHARACTER WAS PUSHED RIGHT, SO
                ;                       THE LINE IS ONE LONGER (CAPPED AT 80).
                ; COMPARING COLUMN + 1 AGAINST THE LENGTH INSTEAD OF COLUMN
                ; MERGES THE TWO AND SILENTLY DROPS THE DISPLACED CHARACTER
                ; WHEN INSERTING ON THE LAST OCCUPIED COLUMN.
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                CP      (HL)
                JR      C, .WBGROW      ; COLUMN < LENGTH
                INC     A               ; COLUMN >= LENGTH
                LD      (HL), A
                RET

.WBGROW         LD      A, (HL)
                CP      TEXTCOLS
                RET     NC              ; ALREADY 80, CANNOT GROW
                INC     A
                LD      (HL), A
                RET


; --- WBINSN                    ----------------------------------------


; - WBINSN -----------------------------
; - INSERT A RUN OF CHARACTERS INTO A LINE RECORD AT A COLUMN
; - THE BATCH FORM OF WBINS: TEXT AND ATTRIBUTES SHIFT RIGHT BY N IN TWO
; - LDDR INSTEAD OF N PAIRS, AND THE RUN IS COPIED IN AS A BLOCK. WHATEVER
; - PASSES COLUMN 79 IS LOST, SO THE CALLER MUST HAVE MADE ROOM FIRST:
; -     MAX(LENGTH, COLUMN) + N <= TEXTCOLS
; - TAB BECOMES A SPACE ON THE WAY IN. EVERY INSERTED CELL TAKES TYPATTR,
; - EXACTLY AS WBINS DOES FOR ONE CHARACTER.
; - IN:  HL = RECORD BASE, A = COLUMN (0-79), DE = SOURCE, B = COUNT (1-80)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WBINSN          LD      (WBBASE), HL
                LD      (WBCOL), A
                LD      (WBSRC), DE
                LD      A, B
                OR      A
                RET     Z               ; EMPTY RUN
                LD      (WBRUN), A

                ; BYTES TO SHIFT RIGHT = TEXTCOLS - COLUMN - N
                LD      C, A
                LD      A, (WBCOL)
                ADD     A, C            ; COLUMN + N, AT MOST 159
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                JR      Z, .WNFILL      ; THE RUN REACHES THE EDGE: NO SHIFT
                JR      C, .WNFILL      ; PRECONDITION BROKEN; DO NOT WRAP BC
                LD      (WBCNT), A

                ; TEXT HALF: COLUMNS COL..(79-N) MOVE UP TO COL+N..79
                LD      HL, (WBBASE)
                LD      DE, TEXTCOLS
                ADD     HL, DE          ; HL = BASE + 80 (TEXT OF COLUMN 79)
                LD      D, H
                LD      E, L            ; DE = LAST DESTINATION BYTE
                LD      A, (WBRUN)
                LD      C, A
                LD      B, 0
                OR      A
                SBC     HL, BC          ; HL = LAST SOURCE BYTE
                LD      A, (WBCNT)
                LD      C, A
                LD      B, 0
                LDDR

                ; ATTRIBUTE HALF, EXACTLY THE SAME SHIFT
                LD      HL, (WBBASE)
                LD      DE, TEXTCOLS + TEXTCOLS
                ADD     HL, DE          ; HL = BASE + 160 (ATTR OF COLUMN 79)
                LD      D, H
                LD      E, L
                LD      A, (WBRUN)
                LD      C, A
                LD      B, 0
                OR      A
                SBC     HL, BC
                LD      A, (WBCNT)
                LD      C, A
                LD      B, 0
                LDDR

.WNFILL         ; TEXT: COPY THE RUN IN, TRANSLATING TAB TO A SPACE
                LD      HL, (WBBASE)
                INC     HL
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = BASE + 1 + COLUMN
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, (WBSRC)
                LD      A, (WBRUN)
                LD      B, A
.WNCOPY         LD      A, (HL)
                CP      #09
                JR      NZ, .WNPUT
                LD      A, ' '
.WNPUT          LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .WNCOPY

                ; ATTRIBUTES: N CELLS OF THE CURRENT TYPING ATTRIBUTE
                LD      HL, (WBBASE)
                LD      DE, TEXTCOLS + 1
                ADD     HL, DE          ; HL = BASE + 81 (ATTR OF COLUMN 0)
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                ADD     HL, DE
                LD      A, (WBRUN)
                LD      B, A
                LD      A, (TYPATTR)
.WNATTR         LD      (HL), A
                INC     HL
                DJNZ    .WNATTR

                ; LENGTH, THE SAME TWO CASES WBINS DOCUMENTS:
                ;   COLUMN >= LENGTH -- NOTHING SHIFTED, THE LINE NOW REACHES
                ;                       COLUMN + N.
                ;   COLUMN <  LENGTH -- REAL CHARACTERS WERE PUSHED RIGHT, SO
                ;                       THE LINE IS N LONGER (CAPPED AT 80).
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                CP      (HL)
                JR      C, .WNGROW      ; COLUMN < LENGTH
                LD      C, A
                LD      A, (WBRUN)
                ADD     A, C
                LD      (HL), A
                RET

.WNGROW         LD      A, (HL)
                LD      C, A
                LD      A, (WBRUN)
                ADD     A, C
                CP      TEXTCOLS + 1
                JR      C, .WNSET
                LD      A, TEXTCOLS
.WNSET          LD      (HL), A
                RET


; --- SETCURY                   ----------------------------------------


; - SETCURY ----------------------------
; - RECOMPUTE THE VIEWPORT ROW FROM THE DOCUMENT POSITION
; - CURY = DOCLINE - TOPLINE IS AN INVARIANT. EVERY CHANGE TO EITHER SIDE
; - COMES BACK THROUGH HERE; NEVER ADJUST CURY BY HAND.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

SETCURY         LD      HL, (DOCLINE)
                LD      DE, (TOPLINE)
                OR      A
                SBC     HL, DE
                LD      A, L
                LD      (CURY), A
                RET


; --- EDTGLWRP                  ----------------------------------------


; - EDTGLWRP ---------------------------
; - TOGGLE WRAP MODE (WRAP_DEV <-> WRAP_TXT)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

EDTGLWRP        LD      A, (WRAPMODE)
                XOR     1
                LD      (WRAPMODE), A
                RET


; --- EDOVRCHR                  ----------------------------------------



; - EDOVRCHR ---------------------------
; - OVERWRITE CHARACTER AT CURSOR
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDOVRCHR        CALL    EDINSCHR        ; FOR NOW, ROUTE TO INSERT
                RET


; --- REFLOW                    ----------------------------------------


; - REFLOW -----------------------------
; - CASCADE PARAGRAPH REFLOW STARTING AT LINE HL
; - PULLS WORDS UPWARDS ACROSS SUBSEQUENT LINES UNTIL AN EMPTY LINE OR EOF
; - IN:  HL = START LINE NUMBER (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; -

REFLOW          LD      (RFLINE), HL

.RFLOOP         ; 1. CHECK IF NEXT LINE EXISTS (L + 1 < TOTLINES)
                LD      HL, (RFLINE)
                INC     HL              ; HL = L + 1
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; L + 1 >= TOTLINES: EOF REACHED, DONE!

                ; 2. LOAD LINE L + 1 INTO WORKBUF2
                CALL    LINEREAD        ; READS LINE L+1 INTO WORKBUF
                LD      A, (WORKBUF)
                OR      A
                JR      NZ, .NOTEMP

                ; LINE L+1 IS EMPTY (LEN == 0):
                ; DELETE THE EMPTY LINE AND STOP (PARAGRAPH BOUNDARY)
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      A, #FF
                LD      (MODIFIED), A
                RET

.NOTEMP         ; COPY LINE L+1 RECORD TO WORKBUF2
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 3. LOAD LINE L INTO WORKBUF
                LD      HL, (RFLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                CP      TEXTCOLS        ; 80
                JP      NC, .RFNEXT     ; LINE L IS FULL, ADVANCE TO L+1

                ; 4. CALCULATE AVAILABLE SPACE ON LINE L
                LD      E, A            ; E = LEN_A
                LD      A, TEXTCOLS     ; 80
                SUB     E               ; A = 80 - LEN_A
                LD      (RFSPACE), A
                XOR     A
                LD      (RFSEP), A

                ; DOES LINE L NEED A SEPARATOR SPACE?
                ; ONLY IF LEN_A > 0 AND LAST CHAR IS NOT ' '
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .CHECKAL

                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF
                ADD     HL, DE          ; HL = WORKBUF + LEN_A (LAST CHAR)
                LD      A, (HL)
                CP      ' '
                JR      Z, .CHECKAL

                ; NEED SEPARATOR SPACE
                LD      A, 1
                LD      (RFSEP), A
                LD      A, (RFSPACE)
                DEC     A
                JP      Z, .RFNEXT      ; ONLY 1 SPACE LEFT, CANNOT FIT ANY WORD
                LD      (RFSPACE), A

.CHECKAL        ; 5. CAN ENTIRE LINE L+1 FIT?
                LD      A, (WORKBUF2)   ; LEN_B
                LD      HL, RFSPACE
                CP      (HL)
                JP      Z, .RFALL       ; EXACT FIT
                JP      C, .RFALL       ; FITS ENTIRELY

                ; 6. PARTIAL FIT: FIND LONGEST WORD BOUNDARY <= RFSPACE
                ; SCAN WORKBUF2 BACKWARDS FROM (RFSPACE) DOWN TO 1
                LD      A, (RFSPACE)
                LD      B, A            ; B = OFFSET IN LINE B (1..RFSPACE)
.RFPART         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE          ; HL = WORKBUF2 + B
                LD      A, (HL)
                CP      ' '
                JR      Z, .RFFND       ; FOUND SPACE!
                DJNZ    .RFPART

                ; NO WORD BOUNDARY FOUND WITHIN RFSPACE: STOP REFLOW
                RET

.RFFND          ; B = INDEX IN LINE B WHERE SPACE WAS FOUND
                LD      A, B
                LD      (RFCNT), A

                ; APPEND SEPARATOR SPACE TO LINE L IF NEEDED
                LD      A, (RFSEP)
                OR      A
                JR      Z, .NOPSEP

                LD      A, (WORKBUF)    ; LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), ' '
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                LD      (HL), 0
                LD      A, (WORKBUF)
                INC     A
                LD      (WORKBUF), A

.NOPSEP         ; APPEND RFCNT BYTES FROM WORKBUF2 TO WORKBUF
                LD      A, (WORKBUF)    ; CURRENT LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF2 + 1 ; HL = SOURCE TEXT
                LD      A, (RFCNT)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE          ; DEST ATTR
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + TEXTCOLS
                LDIR

                ; UPDATE LINE L LENGTH: LEN_A + RFCNT
                LD      A, (WORKBUF)
                LD      HL, RFCNT
                ADD     A, (HL)
                LD      (WORKBUF), A

                CALL    RECBL80

                ; PERSIST UPDATED LINE L
                LD      HL, (RFLINE)
                CALL    LINEWRT

                ; 7. UPDATE LINE L+1 FROM WORKBUF2 (SHIFT REMAINDER LEFT)
                ; REMAINDER STARTS AFTER RFCNT IN WORKBUF2
                LD      A, (WORKBUF2)   ; OLD LEN_B
                LD      HL, RFCNT
                SUB     (HL)
                LD      B, A            ; B = INITIAL REMAINING CHARS
                LD      A, (RFCNT)
                INC     A               ; SKIP THE SPACE WE SPLIT AT
                LD      C, A            ; C = 1-BASED SOURCE OFFSET IN WORKBUF2

                ; SKIP ANY CONSECUTIVE LEADING SPACES IN THE REMAINDER
.SKPPRE         LD      A, B
                OR      A
                JR      Z, .REMZERO
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      NZ, .SKPDONE
                INC     C
                DEC     B
                JR      .SKPPRE

.SKPDONE        ; B = REMAINING CHAR COUNT (1..80)
                ; C = 1-BASED SOURCE OFFSET IN WORKBUF2
                ; CONSTRUCT SHORTENED LINE L+1 IN WORKBUF
                LD      A, B
                LD      (WORKBUF), A    ; NEW LENGTH

                ; COPY REMAINING TEXT FROM WORKBUF2 TO WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE          ; HL = WORKBUF2 + C
                LD      DE, WORKBUF + 1
                LD      C, B
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; COPY REMAINING ATTRIBUTES FROM WORKBUF2 TO WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2 + TEXTCOLS
                ADD     HL, DE          ; HL = WORKBUF2 + TEXTCOLS + C
                LD      DE, WORKBUF + 1 + TEXTCOLS
                LD      A, (WORKBUF)
                LD      C, A
                LD      B, 0
                LDIR

                CALL    RECBL80

                ; PERSIST SHORTENED LINE L+1
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEWRT

                LD      A, #FF
                LD      (MODIFIED), A

                ; ADVANCE RFLINE TO L + 1 AND CONTINUE CASCADE
                JP      .RFNEXT

.REMZERO        ; REMAINDER WAS EMPTY: DELETE LINE L+1
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      A, #FF
                LD      (MODIFIED), A
                JP      .RFLOOP

.RFALL          ; ENTIRE LINE L+1 FITS ON LINE L!
                LD      A, (RFSEP)
                OR      A
                JR      Z, .NOPSEP2

                LD      A, (WORKBUF)    ; LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), ' '
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                LD      (HL), 0
                LD      A, (WORKBUF)
                INC     A
                LD      (WORKBUF), A

.NOPSEP2        LD      A, (WORKBUF2)   ; LEN_B
                OR      A
                JR      Z, .DELL1

                LD      A, (WORKBUF)    ; CURRENT LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF2 + 1 ; HL = SOURCE TEXT
                LD      A, (WORKBUF2)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE          ; DEST ATTR
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + TEXTCOLS
                LDIR

                ; UPDATE LINE L LENGTH: LEN_A + LEN_B
                LD      A, (WORKBUF)
                LD      HL, WORKBUF2
                ADD     A, (HL)
                LD      (WORKBUF), A

.DELL1          CALL    RECBL80

                ; PERSIST UPDATED LINE L
                LD      HL, (RFLINE)
                CALL    LINEWRT

                ; DELETE LINE L+1 FROM DIRECTORY
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL

                ; DECREMENT TOTLINES
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                LD      A, #FF
                LD      (MODIFIED), A

                ; DO NOT INCREMENT RFLINE; REPEAT FOR SAME RFLINE
                JP      .RFLOOP

.RFNEXT         ; ADVANCE TO NEXT LINE (L = L + 1)
                LD      HL, (RFLINE)
                INC     HL
                LD      (RFLINE), HL
                JP      .RFLOOP

; --- RECBL80                   ----------------------------------------


; - RECBL80 ----------------------------
; - BLANK THE TAIL OF THE RECORD HELD IN WORKBUF: SPACES IN THE TEXT HALF
; - AND ZERO ATTRIBUTES, FROM THE LENGTH BYTE UP TO COLUMN 79.
; - IN:  WORKBUF HOLDS A LINE RECORD, (WORKBUF) = LENGTH
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

RECBL80         LD      A, (WORKBUF)
                CP      TEXTCOLS
                RET     NC              ; ALREADY 80 COLS

                LD      E, A
                LD      D, 0
                LD      A, TEXTCOLS
                SUB     E
                LD      B, A            ; B = 80 - LEN

                LD      HL, WORKBUF + 1
                ADD     HL, DE
                PUSH    BC
                PUSH    HL
.BLKTXT         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT
                POP     HL
                POP     BC

                LD      DE, TEXTCOLS
                ADD     HL, DE
.BLKATT         LD      (HL), 0
                INC     HL
                DJNZ    .BLKATT
                RET


; --- JOIN2L                    ----------------------------------------


; - JOIN2L -----------------------------
; - JOIN TWO ADJACENT LINES IN DEV MODE (LINE B APPENDED TO A, B DELETED)
; - IN:  HL = LINE A (TARGET LINE NUMBER)
; -      DE = LINE B (SOURCE TO DELETE)
; - OUT: CY = 0 : SUCCESS, JOINCOL = LEN A
; -      CY = 1 : FAILED (> TEXTCOLS)
; - CLOBBERS: ALL
; -

JOIN2L          LD      (JOINLA), HL
                LD      (JOINLB), DE

                ; READ LINE B (SOURCE) INTO WORKBUF2
                EX      DE, HL          ; HL = LINE B
                CALL    LINEREAD
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; READ LINE A (TARGET) INTO WORKBUF
                LD      HL, (JOINLA)
                CALL    LINEREAD

                ; SAVE ORIGINAL LENGTH OF LINE A
                LD      A, (WORKBUF)
                LD      (JOINCOL), A

                ; CHECK IF COMBINED LENGTH EXCEEDS 80 COLUMNS
                LD      B, A            ; B = LEN_A
                LD      A, (WORKBUF2)   ; A = LEN_B
                ADD     A, B            ; A = LEN_A + LEN_B
                CP      TEXTCOLS + 1
                JR      NC, .JNBIG      ; > 80: REJECT

                ; APPEND LINE B TEXT & ATTRS IF LEN_B > 0
                LD      A, (WORKBUF2)
                OR      A
                JR      Z, .JNDEL

                ; APPEND TEXT
                LD      A, (JOINCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST TEXT (WORKBUF + 1 + LEN_A)
                LD      HL, WORKBUF2 + 1 ; HL = SRC TEXT
                LD      A, (WORKBUF2)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (JOINCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + TEXTCOLS ; HL = SRC ATTR
                LDIR

                ; UPDATE LINE A LENGTH
                LD      A, (JOINCOL)
                LD      HL, WORKBUF2
                ADD     A, (HL)
                LD      (WORKBUF), A

                ; BLANK UNUSED TAIL CELLS UP TO 79
                CALL    RECBL80

                ; WRITE UPDATED LINE A BACK
                LD      HL, (JOINLA)
                CALL    LINEWRT

.JNDEL          ; DELETE LINE B FROM DIRECTORY
                LD      HL, (JOINLB)
                CALL    LINEDEL

                ; DECREMENT TOTAL LINE COUNT
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                LD      A, #FF
                LD      (MODIFIED), A
                OR      A               ; CLEAR CARRY (CY = 0: SUCCESS)
                RET

.JNBIG          SCF                     ; SET CARRY (CY = 1: FAILED)
                RET


; --- EDJNDEV                   ----------------------------------------


; - EDJNDEV ----------------------------
; - BACKSPACE AT COL 0 IN WRAP_DEV: JOIN CURRENT LINE INTO PREVIOUS LINE
; - IN:  NONE (DOCLINE > 0)
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDJNDEV         LD      HL, (DOCLINE)
                DEC     HL              ; LINE A = DOCLINE - 1
                LD      DE, (DOCLINE)   ; LINE B = DOCLINE
                CALL    JOIN2L
                RET     C               ; FAILED (> 80 COLS)

                ; POSITION CURSOR AT SEAM ON LINE A
                LD      A, (JOINCOL)
                LD      (CURX), A

                ; MOVE DOCLINE UP
                LD      HL, (DOCLINE)
                DEC     HL
                LD      (DOCLINE), HL

                ; IF AT TOP OF VIEWPORT (CURY == 0), SCROLL TOPLINE UP
                LD      A, (CURY)
                OR      A
                JR      NZ, .JNTOP
                LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL

.JNTOP          CALL    SETCURY
                JP      REDRAW


; --- EDDELDV                   ----------------------------------------


; - EDDELDV ----------------------------
; - DELETE AT EOL IN WRAP_DEV: PULL NEXT LINE UP INTO CURRENT LINE
; - IN:  NONE (DOCLINE + 1 < TOTLINES)
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELDV         LD      HL, (DOCLINE)   ; LINE A = DOCLINE
                LD      DE, (DOCLINE)
                INC     DE              ; LINE B = DOCLINE + 1
                CALL    JOIN2L
                RET     C               ; FAILED (> 80 COLS)

                ; CURSOR STAYS AT SEAM ON LINE A
                LD      A, (JOINCOL)
                LD      (CURX), A

                ; DOCLINE, TOPLINE, CURY DO NOT CHANGE
                JP      REDRAW


; --- EDDELBK                 ----------------------------------------


; - EDDELBK ----------------------------
; - DELETE CHARACTER BEFORE CURSOR (BACKSPACE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELBK         LD      A, (CURX)
                OR      A
                JR      Z, .ATCOL0

                ; IN-LINE BACKSPACE (CURX > 0)
                DEC     A
                LD      (CURX), A

                ; LOAD LINE RECORD
                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; SHIFT LEFT FROM CURX UP TO COL 78 (TEXT AND ATTRS)
                LD      A, (CURX)
                LD      B, A
.SHIFTLP        LD      A, B
                CP      79
                JR      Z, .BLANKLS
                LD      E, B
                LD      D, 0
                ; SHIFT TEXT
                LD      HL, WORKBUF + 2 ; SOURCE: WORKBUF + 1 + B + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL              ; DEST: WORKBUF + 1 + B
                LD      (HL), A
                ; SHIFT ATTRIBUTE
                LD      HL, WORKBUF + 1 + TEXTCOLS + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                INC     B
                JR      .SHIFTLP

.BLANKLS        LD      HL, WORKBUF + 80
                LD      (HL), ' '       ; BLANK LAST TEXT COL
                LD      HL, WORKBUF + 80 + TEXTCOLS
                LD      (HL), 0         ; BLANK LAST ATTR COL

                ; DECREASE LINE LENGTH IF > 0
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .DELWRT
                DEC     A
                LD      (WORKBUF), A

.DELWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDIFF         ; ONLY THE CELLS THAT CHANGED

                LD      A, #FF
                LD      (MODIFIED), A
                RET

.ATCOL0         ; BACKSPACE AT COLUMN 0
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT DOCLINE 0: TOP OF DOC, DO NOTHING

                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JP      NZ, EDJNDEV     ; IN WRAP_DEV: DEV LINE JOIN / LINE DELETE

                ; READ PREVIOUS LINE (DOCLINE - 1) TO FIND SEAM COLUMN
                DEC     HL
                CALL    LINEREAD
                LD      A, (WORKBUF)    ; FORMER LENGTH OF LINE L-1
                LD      (CURX), A       ; CURSOR SITS AT THE SEAM

                ; DOCLINE DECREMENTS TO LINE L-1
                LD      HL, (DOCLINE)
                DEC     HL
                LD      (DOCLINE), HL

                ; IF WE WERE AT THE TOP ROW OF VIEWPORT (CURY == 0), SCROLL TOPLINE UP
                LD      A, (CURY)
                OR      A
                JR      NZ, .NOTOP
                LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL

.NOTOP          CALL    SETCURY         ; RECOMPUTE CURY = DOCLINE - TOPLINE

                ; CASCADE REFLOW STARTING AT DOCLINE
                LD      HL, (DOCLINE)
                CALL    REFLOW

                JP      REDRAW          ; TAIL CALL: FULL REDRAW


; --- EDDELCHR                  ----------------------------------------


; - EDDELCHR ---------------------------
; - DELETE CHARACTER AT CURSOR (DEL KEY)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELCHR        LD      HL, (DOCLINE)
                CALL    LINEREAD

                LD      A, (WORKBUF)    ; LINE LENGTH
                LD      B, A
                LD      A, (CURX)
                CP      B
                JR      NC, .ATEOL      ; CURX >= LENGTH: AT OR PAST END OF LINE

                ; IN-LINE DELETE (CURX < LENGTH)
                LD      B, A
.DCHSHFT        LD      A, B
                CP      79
                JR      Z, .DCHLAST
                LD      E, B
                LD      D, 0
                ; SHIFT TEXT
                LD      HL, WORKBUF + 2
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                ; SHIFT ATTRIBUTE
                LD      HL, WORKBUF + 1 + TEXTCOLS + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                INC     B
                JR      .DCHSHFT

.DCHLAST        LD      HL, WORKBUF + 80
                LD      (HL), ' '
                LD      HL, WORKBUF + 80 + TEXTCOLS
                LD      (HL), 0

                LD      A, (WORKBUF)
                OR      A
                JR      Z, .DCHWRT
                DEC     A
                LD      (WORKBUF), A

.DCHWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDIFF         ; ONLY THE CELLS THAT CHANGED

                LD      A, #FF
                LD      (MODIFIED), A
                RET

.ATEOL          ; CURX >= LENGTH: AT OR PAST END OF LINE
                ; CHECK IF NEXT LINE EXISTS (DOCLINE + 1 < TOTLINES)
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; NO NEXT LINE: BOTTOM OF DOCUMENT

                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                JP      NZ, EDDELDV     ; IN WRAP_DEV: DEV LINE JOIN / LINE DELETE BELOW

                ; CLAMP CURX TO CURRENT LENGTH (THE JOIN SEAM)
                LD      A, (WORKBUF)
                LD      (CURX), A

                ; CASCADE REFLOW STARTING AT DOCLINE
                LD      HL, (DOCLINE)
                CALL    REFLOW

                JP      REDRAW          ; TAIL CALL


; --- EDNWLIN                 ----------------------------------------


; - EDNWLIN ----------------------------
; - INSERT LINE BREAK / NEWLINE AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDNWLIN         ; REFUSE IF THE LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; 1. RESERVE THE RECORD FOR THE TAIL FIRST. NEWREC IS THE ONLY
                ;    STEP HERE THAT CAN FAIL, AND EVERY STEP AFTER IT MUTATES
                ;    THE DOCUMENT. RESERVING IT IN THE MIDDLE MEANT THE HEAD
                ;    WAS ALREADY TRUNCATED AND WRITTEN BACK WHEN THE MAPPER RAN
                ;    OUT, AND THE TAIL WENT WITH IT.
                CALL    NEWREC
                RET     C               ; NO MAPPER MEMORY: LEAVE THE LINE ALONE
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 2. LOAD THE LINE THAT IS ABOUT TO BE SPLIT
                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; 3. TAIL -> WORKBUF2, HEAD TRUNCATED IN PLACE
                CALL    SPLITL

                ; 4. WRITE THE SHORTENED HEAD BACK
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 5. PUT THE TAIL IN THE RESERVED RECORD. IT LIVES IN THE
                ;    APPEND SEGMENT, AND LINEREAD / LINEWRT HAVE RE-BANKED
                ;    PAGE 2 SINCE NEWREC, SO BANK IT BACK.
                CALL    APPBANK
                LD      DE, (NROFF)
                LD      HL, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 6. OPEN A DIRECTORY SLOT AFTER THE CURRENT LINE AND FILL IT
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. ADVANCE TO NEW LINE
                XOR     A
                LD      (CURX), A

                LD      HL, (DOCLINE)
                INC     HL
                LD      (DOCLINE), HL

                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .NWATBOT

                ; NOT AT BOTTOM: CURY INCREMENTS
                INC     A
                LD      (CURY), A
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .NWDONE
                LD      A, (CURY)
                INC     A
                LD      B, A            ; B = SCREEN ROW OF NEW LINE (2..24)
                PUSH    BC
                CALL    SHIFTDN
                POP     BC

                ; RENDER SHORTENED HEAD (ROW B - 1)
                DEC     B
                CALL    RENDEROW

                ; RENDER NEW LINE (ROW B)
                INC     B
                CALL    RENDEROW
                JR      .NWDONE

.NWATBOT        ; AT BOTTOM OF SCREEN: THE VIEWPORT FOLLOWS THE NEW LINE. THE
                ; MOVE ITSELF IS BOOKKEEPING AND HAPPENS EVEN WHEN PAINTING IS
                ; HELD -- OTHERWISE THE DEFERRED REPAINT WOULD DRAW THE WRONG
                ; PART OF THE DOCUMENT.
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                LD      A, (RNDHOLD)
                OR      A
                JR      NZ, .NWDONE
                CALL    SCROLLDN

                ; RENDER SHORTENED HEAD (ROW 23)
                LD      B, 23
                CALL    RENDEROW

.NWDONE         LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- SPLITL                    ----------------------------------------


; - SPLITL -----------------------------
; - SPLIT WORKBUF AT THE CURSOR COLUMN
; - OUT: WORKBUF2 = THE TAIL AS A COMPLETE LINE RECORD
; -      WORKBUF  = TRUNCATED TO CURX CHARACTERS
; - CLOBBERS: ALL
; -

SPLITL          LD      A, (CURX)


; - SPLITLA ----------------------------
; - SPLIT WORKBUF AT AN EXPLICIT COLUMN
; - IN:  A = SPLIT COLUMN (0-80)
; - OUT: WORKBUF2 = THE TAIL AS A COMPLETE LINE RECORD
; -      WORKBUF  = TRUNCATED TO A CHARACTERS
; - CLOBBERS: ALL
; -

SPLITLA         LD      (SPLCOL), A
                LD      HL, WORKBUF2
                CALL    RECBLNK         ; BLANK RECORD: LEN 0, SPACES, ATTRS 0

                ; TAIL LENGTH = MAX(LEN - SPLIT COLUMN, 0)
                LD      A, (WORKBUF)
                LD      HL, SPLCOL
                SUB     (HL)
                JR      NC, .LENOK
                XOR     A               ; THE SPLIT SITS PAST THE END OF THE TEXT
.LENOK          LD      (WORKBUF2), A
                LD      B, A
                AND     A
                JR      Z, .TRUNC       ; NOTHING TO CARRY OVER

                LD      C, B
                LD      B, 0            ; BC = BYTES TO MOVE

                ; TEXT HALF
                LD      A, (SPLCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      DE, WORKBUF2 + 1
                PUSH    BC
                LDIR
                POP     BC

                ; ATTRIBUTE HALF
                LD      A, (SPLCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                LD      DE, WORKBUF2 + 1 + TEXTCOLS
                LDIR

.TRUNC          ; HEAD KEEPS SPLCOL CHARACTERS; BLANK WHAT IS LEFT OF IT
                LD      A, (SPLCOL)
                LD      (WORKBUF), A
                LD      E, A
                LD      D, 0
                LD      A, TEXTCOLS
                SUB     E
                RET     Z               ; THE SPLIT WAS AT COLUMN 80
                LD      B, A

                PUSH    BC
                PUSH    DE
                LD      HL, WORKBUF + 1
                ADD     HL, DE
.BLNKLP         LD      (HL), ' '
                INC     HL
                DJNZ    .BLNKLP
                POP     DE
                POP     BC

                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
.ZATTLP         LD      (HL), 0
                INC     HL
                DJNZ    .ZATTLP
                RET


; --- EDMOVCHR                  ----------------------------------------


; - EDMOVCHR ---------------------------
; - MOVE CURSOR LEFT OR RIGHT ONE CHAR
; - IN:  A = CRIGHT OR CLEFT
; - OUT: NONE
; - CLOBBERS: AF
; -

EDMOVCHR        CP      CRIGHT
                JR      Z, .RIGHT
                
                ; CLEFT:
                LD      A, (CURX)
                OR      A
                JR      Z, .LEFT0
                DEC     A
                LD      (CURX), A
                RET

.LEFT0          LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; WRAP_DEV: STAY AT COL 0
                ; WRAP_TXT: WRAP TO PREVIOUS LINE
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; ALREADY AT LINE 0, CANNOT WRAP UP
                DEC     HL
                CALL    LINELEN         ; A = PREV LINE LENGTH (0..80)
                CALL    GETMAXC
                LD      (CURX), A
                LD      A, CUP
                CALL    EDMOVROW
                RET
                
.RIGHT          LD      HL, (DOCLINE)
                CALL    LINELEN         ; A = LINE LENGTH (0..80)
                CALL    GETMAXC         ; A = MAX ALLOWED CURX (0..79)
                LD      B, A            ; B = MAX CURX
                LD      A, (CURX)
                CP      B
                JR      NC, .RGTWRAP    ; AT OR BEYOND MAX COLUMN
                INC     A
                CP      TEXTCOLS        ; 80
                RET     NC
                LD      (CURX), A
                RET

.RGTWRAP        LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; WRAP_DEV: STAY AT MAX COLUMN
                ; WRAP_TXT: WRAP TO NEXT LINE
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; AT LAST LINE, CANNOT WRAP DOWN
                XOR     A
                LD      (CURX), A
                LD      A, CDOWN
                CALL    EDMOVROW
                RET


; --- GETMAXC                   ----------------------------------------


; - GETMAXC ----------------------------
; - CALCULATE MAXIMUM ALLOWED CURX FOR LINE
; - IN:  A = LINE LENGTH (0..80)
; - OUT: A = MAX CURX (0..79)
; - CLOBBERS: B
; -

GETMAXC         LD      B, A
                LD      A, (KMAPID)
                CP      3               ; 3 = VI PROFILE
                JR      NZ, .NOTVI
                LD      A, (VIMODE)
                OR      A
                JR      NZ, .NOTVI      ; 1 = VI INSERT MODE -> CAN APPEND AT LEN
                ; VI NORMAL MODE: CANNOT ADVANCE PAST LAST CHAR (LEN - 1)
                LD      A, B
                OR      A
                RET     Z               ; EMPTY LINE -> COL 0
                DEC     A
                CP      TEXTCOLS
                RET     C
                LD      A, TEXTCOLS - 1
                RET
.NOTVI          LD      A, B
                CP      TEXTCOLS
                RET     C
                LD      A, TEXTCOLS - 1
                RET


; --- EDCLMPX                   ----------------------------------------


; - EDCLMPX ----------------------------
; - CLAMP CURX TO CURRENT DOCLINE LENGTH
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

EDCLMPX         LD      HL, (DOCLINE)
                CALL    LINELEN
                CALL    GETMAXC
                LD      B, A
                LD      A, (CURX)
                CP      B
                RET     C               ; CURX < MAX -> OK
                LD      A, B
                LD      (CURX), A
                RET


; --- EDMOVROW                  ----------------------------------------


; - EDMOVROW ---------------------------
; - MOVE CURSOR UP OR DOWN ONE ROW
; - IN:  A = CUP OR CDOWN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDMOVROW        CP      CDOWN
                JR      Z, .DOWN
                
                ; CUP:
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT TOP OF DOCUMENT
                DEC     HL
                LD      (DOCLINE), HL
                LD      A, (CURY)
                OR      A
                JR      Z, .SCRLUP
                DEC     A
                LD      (CURY), A
                RET
                
.SCRLUP         ; TOP ROW: THE MOVE SCROLLS. TAKE THE QUEUED REPEATS OF THE KEY
                ; (KEYRUN) AND SCROLL ONCE BY THE WHOLE COUNT. DOCLINE IS ALREADY
                ; ONE BACK, SO AT MOST DOCLINE MORE, CAPPED AT 200.
                LD      HL, (DOCLINE)
                LD      B, 200
                LD      A, H
                OR      A
                JR      NZ, .UPCAP
                LD      A, L
                CP      200
                JR      NC, .UPCAP
                LD      B, L
.UPCAP          LD      C, CUP
                CALL    KEYRUN          ; A = EXTRA ROWS
                LD      E, A
                LD      D, 0
                LD      HL, (DOCLINE)
                OR      A
                SBC     HL, DE
                LD      (DOCLINE), HL
                INC     E               ; E = ROWS IN ALL
                LD      HL, (TOPLINE)
                OR      A
                SBC     HL, DE
                LD      (TOPLINE), HL
                LD      A, E
                CP      SCRROWS
                JP      NC, REDRAW      ; A PAGE OR MORE: NOTHING ON SCREEN SURVIVES
                LD      C, A
                JP      SCRLUPN
                
.DOWN           ; CDOWN:
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; AT BOTTOM OF DOCUMENT
                LD      (DOCLINE), HL
                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .SCRLDN
                INC     A
                LD      (CURY), A
                RET
                
.SCRLDN         ; BOTTOM ROW: THE MOVE SCROLLS. SAME AS .SCRLUP, DOWNWARDS.
                ; DOCLINE IS ALREADY ONE ON, SO AT MOST TOTLINES - 1 - DOCLINE MORE.
                LD      HL, (TOTLINES)
                DEC     HL
                LD      DE, (DOCLINE)
                OR      A
                SBC     HL, DE
                LD      B, 200
                LD      A, H
                OR      A
                JR      NZ, .DNCAP
                LD      A, L
                CP      200
                JR      NC, .DNCAP
                LD      B, L
.DNCAP          LD      C, CDOWN
                CALL    KEYRUN          ; A = EXTRA ROWS
                LD      E, A
                LD      D, 0
                LD      HL, (DOCLINE)
                ADD     HL, DE
                LD      (DOCLINE), HL
                INC     E               ; E = ROWS IN ALL
                LD      HL, (TOPLINE)
                ADD     HL, DE
                LD      (TOPLINE), HL
                LD      A, E
                CP      SCRROWS
                JP      NC, REDRAW
                LD      C, A
                JP      SCRLDNN



; --- EDQUIT                    ----------------------------------------


; - EDQUIT -----------------------------
; - EXIT EDITOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDQUIT          JP      TERM

