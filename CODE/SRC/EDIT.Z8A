;                                       ****************************************
;                                       * EDIT OPERATIONS                      *
;                                       ****************************************
;
; ALL EDITING OPERATIONS WORK ON WORKBUF (CURRENT LINE LOADED BY LINEREAD).
; AFTER #EAC EDIT: LINEWRT TO PERSIST, PUTLINE TO RE-RENDER, DRWGUT.


; --- EDINSCHR                  ----------------------------------------


; - EDINSCHR ---------------------------
; - INSERT CHARACTER AT CURSOR POSITION
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDINSCHR        PUSH    AF
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                POP     AF

                LD      C, A            ; C = CHAR TO INSERT
                LD      A, (CURX)
                CP      TEXTCOLS        ; 80
                RET     NC              ; CURX >= 80, CANNOT INSERT

                ; COLUMN 79 STILL FREE? THEN SHIFT-AND-INSERT IS SAFE AND THE
                ; CURSOR COLUMN DOES NOT MATTER -- NOTHING FALLS OFF THE EDGE.
                LD      A, (WORKBUF + TEXTCOLS)
                CP      ' '
                JR      Z, .DOINS

                ; COLUMN 79 IS OCCUPIED: INSERTING WOULD PUSH TEXT OUT OF THE
                ; RECORD. WHAT HAPPENS NEXT IS THE WRAP MODE'S DECISION.
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; WRAP_DEV: CLAMP, NEVER LOSE CODE

                ; WRAP_TXT: A SPACE TYPED AT THE MARGIN IS JUST A LINE BREAK;
                ; ANYTHING ELSE PUSHES THE TRAILING WORD DOWN A LINE.
                LD      A, (CURX)
                CP      TEXTCOLS - 1
                JP      NZ, EDPSHWR
                LD      A, C
                CP      ' '
                JP      Z, EDNWLIN
                JP      EDPSHWR

.DOINS          ; ROOM EXISTS AT COLUMN 79: PLAIN INSERT ON THIS LINE
                LD      HL, WORKBUF
                LD      A, (CURX)
                CALL    WBINS           ; TEXT + ATTRS SHIFTED, LENGTH UPDATED

                ; WRITE LINE TO MAPPER
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; RE-RENDER CURRENT ROW
                LD      A, (CURY)
                INC     A
                LD      B, A            ; B = SCREEN ROW (1..24)
                CALL    RENDEROW

                ; ADVANCE CURSOR
                LD      A, (CURX)
                INC     A
                CP      TEXTCOLS
                JR      NC, .NOMOV
                LD      (CURX), A
.NOMOV          LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EDPSHWR                   ----------------------------------------


; - EDPSHWR ----------------------------
; - PUSH-WRAP: THE LINE IS FULL AND A CHARACTER HAS TO GO IN ANYWAY.
; - MOVE THE TRAILING WORD DOWN TO A NEW LINE, THEN INSERT THE CHARACTER
; - ON WHICHEVER HALF THE CURSOR ENDED UP ON.
; - ORDER IS THE WHOLE POINT: SPLIT, INSERT, PERSIST, ONLY THEN RENDER.
; - RENDERING EARLIER WOULD RUN LINEREAD OVER WORKBUF AND LOSE THE HEAD.
; - IN:  C = CHAR TO INSERT, WORKBUF = LINE (DOCLINE), CURX = COLUMN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDPSHWR         ; REFUSE IF THE LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; RESERVE THE RECORD FOR THE WORD THAT IS ABOUT TO MOVE DOWN
                ; BEFORE TOUCHING ANYTHING -- SAME REASON AS IN EDNWLIN. POP
                ; DOES NOT TOUCH THE FLAGS, SO NEWREC'S CARRY SURVIVES IT.
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                CALL    NEWREC
                POP     BC
                RET     C               ; NO MAPPER MEMORY: LEAVE THE LINE ALONE
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 1. SPLIT COLUMN = START OF THE TRAILING WORD
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      B, TEXTCOLS - 2 ; SCAN BACK FROM COLUMN 78
.PWSCAN         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .PWFND
                DEC     B
                LD      A, B
                INC     A               ; B WRAPPED PAST 0 (#FF) -> A = 0
                JR      NZ, .PWSCAN

                ; NO SPACE AT ALL: ONE LONG WORD, HARD BREAK AT THE LAST COLUMN
                LD      A, TEXTCOLS - 1
                JR      .PWSPL

.PWFND          LD      A, B
                INC     A               ; THE WORD STARTS ONE PAST THE SPACE

.PWSPL          POP     BC              ; RESTORE C (CHAR TO INSERT)
                LD      B, A            ; B = SPLIT COLUMN

                ; 2. DECIDE WHICH HALF KEEPS THE CURSOR **BEFORE** SPLITTING,
                ;    WHILE THE WHOLE LINE IS STILL COHERENT IN WORKBUF.
                LD      A, (CURX)
                CP      B
                JR      NC, .PWTAIL     ; CURX >= SPLIT: CURSOR RIDES THE WORD

                LD      (PWCOL), A      ; CURSOR STAYS ON THE HEAD, SAME COLUMN
                XOR     A
                LD      (PWTAIL), A
                JR      .PWDOSPL

.PWTAIL         SUB     B               ; COLUMN MEASURED INSIDE THE MOVED WORD
                LD      (PWCOL), A
                LD      A, #FF
                LD      (PWTAIL), A

.PWDOSPL        ; 3. SPLIT: HEAD KEEPS 0..SPLIT-1, TAIL GOES TO WORKBUF2
                PUSH    BC              ; SAVE C (CHAR TO INSERT)
                LD      A, B
                CALL    SPLITLA
                POP     BC              ; RESTORE C

                ; 4. INSERT WHILE BOTH HALVES ARE STILL IN RAM
                LD      HL, WORKBUF
                LD      A, (PWTAIL)
                OR      A
                JR      Z, .PWINS
                LD      HL, WORKBUF2
.PWINS          LD      A, (PWCOL)
                CALL    WBINS

                ; 5. PERSIST THE HEAD BEFORE ANYTHING CAN RENDER
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 6. PUT THE TAIL IN THE RECORD RESERVED AT THE TOP. LINEWRT
                ;    HAS RE-BANKED PAGE 2 SINCE NEWREC, SO BANK IT BACK.
                CALL    APPBANK
                LD      DE, (NROFF)
                LD      HL, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 7. OPEN A DIRECTORY SLOT AFTER THE CURRENT LINE AND FILL IT
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 8. CURSOR LANDS ONE PAST THE CHARACTER JUST TYPED
                LD      A, (PWCOL)
                INC     A
                CP      TEXTCOLS
                JR      C, .PWSETX
                LD      A, TEXTCOLS - 1
.PWSETX         LD      (CURX), A

                LD      A, (PWTAIL)
                OR      A
                JR      Z, .PWMOD
                LD      HL, (DOCLINE)   ; THE CURSOR FOLLOWED THE WORD DOWN
                INC     HL
                LD      (DOCLINE), HL

.PWMOD          LD      A, #FF
                LD      (MODIFIED), A

                ; 9. UPDATE THE DISPLAY. CURY STILL HOLDS THE HEAD'S ROW --
                ;    SETCURY RECOMPUTES IT FROM DOCLINE AND TOPLINE AT THE END.
                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .PWBOT

                INC     A
                INC     A
                LD      B, A            ; B = SCREEN ROW OF THE NEW LINE (2..24)
                PUSH    BC
                CALL    SHIFTDN
                POP     BC

                DEC     B
                CALL    RENDEROW        ; SHORTENED HEAD
                INC     B
                CALL    RENDEROW        ; THE WORD THAT MOVED DOWN
                CALL    DRWGUT
                JP      SETCURY

.PWBOT          ; AT THE BOTTOM THE NEW LINE ONLY FITS IF THE VIEW SCROLLS
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                CALL    SCROLLDN        ; RENDERS ROW 24 AND ITS LINE NUMBER

                LD      B, TXRLAST - 1  ; ROW 23 NOW HOLDS THE SHORTENED HEAD
                CALL    RENDEROW
                CALL    DRWGUT
                JP      SETCURY


; --- WBINS                     ----------------------------------------


; - WBINS ------------------------------
; - INSERT A CHARACTER INTO A LINE RECORD AT A COLUMN
; - TEXT AND ATTRIBUTES BOTH SHIFT RIGHT AND THE CELL AT COLUMN 79 FALLS
; - OFF, SO THE CALLER MUST HAVE MADE ROOM THERE FIRST. THE NEW CHARACTER
; - INHERITS THE ATTRIBUTE OF THE CELL IT DISPLACED (THE SHIFT LEAVES THAT
; - BYTE IN PLACE, SO IT COSTS NOTHING).
; - IN:  HL = RECORD BASE, A = COLUMN (0-79), C = CHAR CODE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

WBINS           LD      (WBBASE), HL
                LD      (WBCOL), A

                ; BYTES TO SHIFT RIGHT = 79 - COLUMN
                LD      E, A
                LD      A, TEXTCOLS - 1
                SUB     E
                JR      Z, .WBPUT       ; INSERTING AT COLUMN 79: NOTHING MOVES
                LD      (WBCNT), A

                ; TEXT HALF: COLUMNS COL..78 MOVE UP TO COL+1..79
                LD      DE, TEXTCOLS - 1
                ADD     HL, DE          ; HL = BASE + 79 (TEXT OF COLUMN 78)
                LD      D, H
                LD      E, L
                INC     DE              ; DE = BASE + 80 (TEXT OF COLUMN 79)
                LD      A, (WBCNT)
                PUSH    BC              ; SAVE C (CHAR)
                LD      C, A
                LD      B, 0
                LDDR
                POP     BC

                ; ATTRIBUTE HALF, EXACTLY THE SAME SHIFT
                LD      HL, (WBBASE)
                LD      DE, TEXTCOLS + TEXTCOLS - 1
                ADD     HL, DE          ; HL = BASE + 159 (ATTR OF COLUMN 78)
                LD      D, H
                LD      E, L
                INC     DE              ; DE = BASE + 160 (ATTR OF COLUMN 79)
                LD      A, (WBCNT)
                PUSH    BC
                LD      C, A
                LD      B, 0
                LDDR
                POP     BC

.WBPUT          ; PLACE THE CHARACTER AND ATTRIBUTE
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                LD      E, A
                LD      D, 0
                INC     HL
                ADD     HL, DE          ; HL = BASE + 1 + COLUMN
                LD      (HL), C
                LD      DE, TEXTCOLS
                ADD     HL, DE          ; HL = BASE + 1 + TEXTCOLS + COLUMN
                LD      A, (TYPATTR)
                LD      (HL), A

                ; LENGTH. TWO CASES, AND THEY ARE NOT THE SAME:
                ;   COLUMN >= LENGTH -- WRITING PAST THE END, NOTHING SHIFTED,
                ;                       SO THE LINE NOW REACHES COLUMN + 1.
                ;   COLUMN <  LENGTH -- A REAL CHARACTER WAS PUSHED RIGHT, SO
                ;                       THE LINE IS ONE LONGER (CAPPED AT 80).
                ; COMPARING COLUMN + 1 AGAINST THE LENGTH INSTEAD OF COLUMN
                ; MERGES THE TWO AND SILENTLY DROPS THE DISPLACED CHARACTER
                ; WHEN INSERTING ON THE LAST OCCUPIED COLUMN.
                LD      HL, (WBBASE)
                LD      A, (WBCOL)
                CP      (HL)
                JR      C, .WBGROW      ; COLUMN < LENGTH
                INC     A               ; COLUMN >= LENGTH
                LD      (HL), A
                RET

.WBGROW         LD      A, (HL)
                CP      TEXTCOLS
                RET     NC              ; ALREADY 80, CANNOT GROW
                INC     A
                LD      (HL), A
                RET


; --- SETCURY                   ----------------------------------------


; - SETCURY ----------------------------
; - RECOMPUTE THE VIEWPORT ROW FROM THE DOCUMENT POSITION
; - CURY = DOCLINE - TOPLINE IS AN INVARIANT. EVERY CHANGE TO EITHER SIDE
; - COMES BACK THROUGH HERE; NEVER ADJUST CURY BY HAND.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

SETCURY         LD      HL, (DOCLINE)
                LD      DE, (TOPLINE)
                OR      A
                SBC     HL, DE
                LD      A, L
                LD      (CURY), A
                RET


; --- EDTGLWRP                  ----------------------------------------


; - EDTGLWRP ---------------------------
; - TOGGLE WRAP MODE (WRAP_DEV <-> WRAP_TXT)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

EDTGLWRP        LD      A, (WRAPMODE)
                XOR     1
                LD      (WRAPMODE), A
                RET


; --- EDOVRCHR                  ----------------------------------------



; - EDOVRCHR ---------------------------
; - OVERWRITE CHARACTER AT CURSOR
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDOVRCHR        CALL    EDINSCHR        ; FOR NOW, ROUTE TO INSERT
                RET


; --- REFLOW                    ----------------------------------------


; - REFLOW -----------------------------
; - CASCADE PARAGRAPH REFLOW STARTING AT LINE HL
; - PULLS WORDS UPWARDS ACROSS SUBSEQUENT LINES UNTIL AN EMPTY LINE OR EOF
; - IN:  HL = START LINE NUMBER (0-BASED)
; - OUT: NONE
; - CLOBBERS: ALL
; -

REFLOW          LD      (RFLINE), HL

.RFLOOP         ; 1. CHECK IF NEXT LINE EXISTS (L + 1 < TOTLINES)
                LD      HL, (RFLINE)
                INC     HL              ; HL = L + 1
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; L + 1 >= TOTLINES: EOF REACHED, DONE!

                ; 2. LOAD LINE L + 1 INTO WORKBUF2
                CALL    LINEREAD        ; READS LINE L+1 INTO WORKBUF
                LD      A, (WORKBUF)
                OR      A
                JR      NZ, .NOTEMP

                ; LINE L+1 IS EMPTY (LEN == 0):
                ; DELETE THE EMPTY LINE AND STOP (PARAGRAPH BOUNDARY)
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      A, #FF
                LD      (MODIFIED), A
                RET

.NOTEMP         ; COPY LINE L+1 RECORD TO WORKBUF2
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 3. LOAD LINE L INTO WORKBUF
                LD      HL, (RFLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                CP      TEXTCOLS        ; 80
                JP      NC, .RFNEXT     ; LINE L IS FULL, ADVANCE TO L+1

                ; 4. CALCULATE AVAILABLE SPACE ON LINE L
                LD      E, A            ; E = LEN_A
                LD      A, TEXTCOLS     ; 80
                SUB     E               ; A = 80 - LEN_A
                LD      (RFSPACE), A
                XOR     A
                LD      (RFSEP), A

                ; DOES LINE L NEED A SEPARATOR SPACE?
                ; ONLY IF LEN_A > 0 AND LAST CHAR IS NOT ' '
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .CHECKAL

                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF
                ADD     HL, DE          ; HL = WORKBUF + LEN_A (LAST CHAR)
                LD      A, (HL)
                CP      ' '
                JR      Z, .CHECKAL

                ; NEED SEPARATOR SPACE
                LD      A, 1
                LD      (RFSEP), A
                LD      A, (RFSPACE)
                DEC     A
                JP      Z, .RFNEXT      ; ONLY 1 SPACE LEFT, CANNOT FIT ANY WORD
                LD      (RFSPACE), A

.CHECKAL        ; 5. CAN ENTIRE LINE L+1 FIT?
                LD      A, (WORKBUF2)   ; LEN_B
                LD      HL, RFSPACE
                CP      (HL)
                JP      Z, .RFALL       ; EXACT FIT
                JP      C, .RFALL       ; FITS ENTIRELY

                ; 6. PARTIAL FIT: FIND LONGEST WORD BOUNDARY <= RFSPACE
                ; SCAN WORKBUF2 BACKWARDS FROM (RFSPACE) DOWN TO 1
                LD      A, (RFSPACE)
                LD      B, A            ; B = OFFSET IN LINE B (1..RFSPACE)
.RFPART         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE          ; HL = WORKBUF2 + B
                LD      A, (HL)
                CP      ' '
                JR      Z, .RFFND       ; FOUND SPACE!
                DJNZ    .RFPART

                ; NO WORD BOUNDARY FOUND WITHIN RFSPACE: STOP REFLOW
                RET

.RFFND          ; B = INDEX IN LINE B WHERE SPACE WAS FOUND
                LD      A, B
                LD      (RFCNT), A

                ; APPEND SEPARATOR SPACE TO LINE L IF NEEDED
                LD      A, (RFSEP)
                OR      A
                JR      Z, .NOPSEP

                LD      A, (WORKBUF)    ; LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), ' '
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                LD      (HL), 0
                LD      A, (WORKBUF)
                INC     A
                LD      (WORKBUF), A

.NOPSEP         ; APPEND RFCNT BYTES FROM WORKBUF2 TO WORKBUF
                LD      A, (WORKBUF)    ; CURRENT LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF2 + 1 ; HL = SOURCE TEXT
                LD      A, (RFCNT)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE          ; DEST ATTR
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + TEXTCOLS
                LDIR

                ; UPDATE LINE L LENGTH: LEN_A + RFCNT
                LD      A, (WORKBUF)
                LD      HL, RFCNT
                ADD     A, (HL)
                LD      (WORKBUF), A

                CALL    .BLNK80

                ; PERSIST UPDATED LINE L
                LD      HL, (RFLINE)
                CALL    LINEWRT

                ; 7. UPDATE LINE L+1 FROM WORKBUF2 (SHIFT REMAINDER LEFT)
                ; REMAINDER STARTS AFTER RFCNT IN WORKBUF2
                LD      A, (WORKBUF2)   ; OLD LEN_B
                LD      HL, RFCNT
                SUB     (HL)
                LD      B, A            ; B = INITIAL REMAINING CHARS
                LD      A, (RFCNT)
                INC     A               ; SKIP THE SPACE WE SPLIT AT
                LD      C, A            ; C = 1-BASED SOURCE OFFSET IN WORKBUF2

                ; SKIP ANY CONSECUTIVE LEADING SPACES IN THE REMAINDER
.SKPPRE         LD      A, B
                OR      A
                JR      Z, .REMZERO
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      NZ, .SKPDONE
                INC     C
                DEC     B
                JR      .SKPPRE

.SKPDONE        ; B = REMAINING CHAR COUNT (1..80)
                ; C = 1-BASED SOURCE OFFSET IN WORKBUF2
                ; CONSTRUCT SHORTENED LINE L+1 IN WORKBUF
                LD      A, B
                LD      (WORKBUF), A    ; NEW LENGTH

                ; COPY REMAINING TEXT FROM WORKBUF2 TO WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2
                ADD     HL, DE          ; HL = WORKBUF2 + C
                LD      DE, WORKBUF + 1
                LD      C, B
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; COPY REMAINING ATTRIBUTES FROM WORKBUF2 TO WORKBUF
                LD      E, C
                LD      D, 0
                LD      HL, WORKBUF2 + TEXTCOLS
                ADD     HL, DE          ; HL = WORKBUF2 + TEXTCOLS + C
                LD      DE, WORKBUF + 1 + TEXTCOLS
                LD      A, (WORKBUF)
                LD      C, A
                LD      B, 0
                LDIR

                CALL    .BLNK80

                ; PERSIST SHORTENED LINE L+1
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEWRT

                LD      A, #FF
                LD      (MODIFIED), A

                ; ADVANCE RFLINE TO L + 1 AND CONTINUE CASCADE
                JP      .RFNEXT

.REMZERO        ; REMAINDER WAS EMPTY: DELETE LINE L+1
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      A, #FF
                LD      (MODIFIED), A
                JP      .RFLOOP

.RFALL          ; ENTIRE LINE L+1 FITS ON LINE L!
                LD      A, (RFSEP)
                OR      A
                JR      Z, .NOPSEP2

                LD      A, (WORKBUF)    ; LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), ' '
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                LD      (HL), 0
                LD      A, (WORKBUF)
                INC     A
                LD      (WORKBUF), A

.NOPSEP2        LD      A, (WORKBUF2)   ; LEN_B
                OR      A
                JR      Z, .DELL1

                LD      A, (WORKBUF)    ; CURRENT LEN_A
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; DEST TEXT
                EX      DE, HL          ; DE = DEST TEXT
                LD      HL, WORKBUF2 + 1 ; HL = SOURCE TEXT
                LD      A, (WORKBUF2)
                LD      C, A
                LD      B, 0
                PUSH    BC
                LDIR
                POP     BC

                ; APPEND ATTRIBUTES
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE          ; DEST ATTR
                EX      DE, HL          ; DE = DEST ATTR
                LD      HL, WORKBUF2 + 1 + TEXTCOLS
                LDIR

                ; UPDATE LINE L LENGTH: LEN_A + LEN_B
                LD      A, (WORKBUF)
                LD      HL, WORKBUF2
                ADD     A, (HL)
                LD      (WORKBUF), A

.DELL1          CALL    .BLNK80

                ; PERSIST UPDATED LINE L
                LD      HL, (RFLINE)
                CALL    LINEWRT

                ; DELETE LINE L+1 FROM DIRECTORY
                LD      HL, (RFLINE)
                INC     HL
                CALL    LINEDEL

                ; DECREMENT TOTLINES
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                LD      A, #FF
                LD      (MODIFIED), A

                ; DO NOT INCREMENT RFLINE; REPEAT FOR SAME RFLINE
                JP      .RFLOOP

.RFNEXT         ; ADVANCE TO NEXT LINE (L = L + 1)
                LD      HL, (RFLINE)
                INC     HL
                LD      (RFLINE), HL
                JP      .RFLOOP

.BLNK80         ; BLANK CELLS OF WORKBUF FROM (WORKBUF) UP TO 79
                LD      A, (WORKBUF)
                CP      TEXTCOLS
                RET     NC              ; ALREADY 80 COLS

                LD      E, A
                LD      D, 0
                LD      A, TEXTCOLS
                SUB     E
                LD      B, A            ; B = 80 - LEN

                LD      HL, WORKBUF + 1
                ADD     HL, DE
                PUSH    BC
                PUSH    HL
.BLKTXT         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT
                POP     HL
                POP     BC

                LD      DE, TEXTCOLS
                ADD     HL, DE
.BLKATT         LD      (HL), 0
                INC     HL
                DJNZ    .BLKATT
                RET


; --- EDDELBK                 ----------------------------------------


; - EDDELBK ----------------------------
; - DELETE CHARACTER BEFORE CURSOR (BACKSPACE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELBK         LD      A, (CURX)
                OR      A
                JR      Z, .ATCOL0

                ; IN-LINE BACKSPACE (CURX > 0)
                DEC     A
                LD      (CURX), A

                ; LOAD LINE RECORD
                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; SHIFT LEFT FROM CURX UP TO COL 78 (TEXT AND ATTRS)
                LD      A, (CURX)
                LD      B, A
.SHIFTLP        LD      A, B
                CP      79
                JR      Z, .BLANKLS
                LD      E, B
                LD      D, 0
                ; SHIFT TEXT
                LD      HL, WORKBUF + 2 ; SOURCE: WORKBUF + 1 + B + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL              ; DEST: WORKBUF + 1 + B
                LD      (HL), A
                ; SHIFT ATTRIBUTE
                LD      HL, WORKBUF + 1 + TEXTCOLS + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                INC     B
                JR      .SHIFTLP

.BLANKLS        LD      HL, WORKBUF + 80
                LD      (HL), ' '       ; BLANK LAST TEXT COL
                LD      HL, WORKBUF + 80 + TEXTCOLS
                LD      (HL), 0         ; BLANK LAST ATTR COL

                ; DECREASE LINE LENGTH IF > 0
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .DELWRT
                DEC     A
                LD      (WORKBUF), A

.DELWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW

                LD      A, #FF
                LD      (MODIFIED), A
                RET

.ATCOL0         ; BACKSPACE AT COLUMN 0
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; IN WRAP_DEV: DO NOTHING AT COL 0

                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT DOCLINE 0: TOP OF DOC, DO NOTHING

                ; READ PREVIOUS LINE (DOCLINE - 1) TO FIND SEAM COLUMN
                DEC     HL
                CALL    LINEREAD
                LD      A, (WORKBUF)    ; FORMER LENGTH OF LINE L-1
                LD      (CURX), A       ; CURSOR SITS AT THE SEAM

                ; DOCLINE DECREMENTS TO LINE L-1
                LD      HL, (DOCLINE)
                DEC     HL
                LD      (DOCLINE), HL

                ; IF WE WERE AT THE TOP ROW OF VIEWPORT (CURY == 0), SCROLL TOPLINE UP
                LD      A, (CURY)
                OR      A
                JR      NZ, .NOTOP
                LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL

.NOTOP          CALL    SETCURY         ; RECOMPUTE CURY = DOCLINE - TOPLINE

                ; CASCADE REFLOW STARTING AT DOCLINE
                LD      HL, (DOCLINE)
                CALL    REFLOW

                CALL    REDRAW          ; FULL REDRAW
                CALL    DRWGUT          ; REDRAW GUTTER LINE NUMBERS
                JP      DRWSCRL         ; TAIL CALL: RECOMPUTE SCROLLBAR


; --- EDDELCHR                  ----------------------------------------


; - EDDELCHR ---------------------------
; - DELETE CHARACTER AT CURSOR (DEL KEY)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELCHR        LD      HL, (DOCLINE)
                CALL    LINEREAD

                LD      A, (WORKBUF)    ; LINE LENGTH
                LD      B, A
                LD      A, (CURX)
                CP      B
                JR      NC, .ATEOL      ; CURX >= LENGTH: AT OR PAST END OF LINE

                ; IN-LINE DELETE (CURX < LENGTH)
                LD      B, A
.DCHSHFT        LD      A, B
                CP      79
                JR      Z, .DCHLAST
                LD      E, B
                LD      D, 0
                ; SHIFT TEXT
                LD      HL, WORKBUF + 2
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                ; SHIFT ATTRIBUTE
                LD      HL, WORKBUF + 1 + TEXTCOLS + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                INC     B
                JR      .DCHSHFT

.DCHLAST        LD      HL, WORKBUF + 80
                LD      (HL), ' '
                LD      HL, WORKBUF + 80 + TEXTCOLS
                LD      (HL), 0

                LD      A, (WORKBUF)
                OR      A
                JR      Z, .DCHWRT
                DEC     A
                LD      (WORKBUF), A

.DCHWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW

                LD      A, #FF
                LD      (MODIFIED), A
                RET

.ATEOL          ; CURX >= LENGTH: AT OR PAST END OF LINE
                LD      A, (WRAPMODE)
                CP      WRAP_TXT
                RET     NZ              ; IN WRAP_DEV: DO NOTHING PAST END OF LINE

                ; IN WRAP_TXT: CHECK IF NEXT LINE EXISTS (DOCLINE + 1 < TOTLINES)
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; NO NEXT LINE: BOTTOM OF DOCUMENT

                ; CLAMP CURX TO CURRENT LENGTH (THE JOIN SEAM)
                LD      A, (WORKBUF)
                LD      (CURX), A

                ; CASCADE REFLOW STARTING AT DOCLINE
                LD      HL, (DOCLINE)
                CALL    REFLOW

                CALL    REDRAW
                CALL    DRWGUT
                JP      DRWSCRL         ; TAIL CALL: RECOMPUTE SCROLLBAR


; --- EDNWLIN                 ----------------------------------------


; - EDNWLIN ----------------------------
; - INSERT LINE BREAK / NEWLINE AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDNWLIN         ; REFUSE IF THE LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                RET     NC

                ; 1. RESERVE THE RECORD FOR THE TAIL FIRST. NEWREC IS THE ONLY
                ;    STEP HERE THAT CAN FAIL, AND EVERY STEP AFTER IT MUTATES
                ;    THE DOCUMENT. RESERVING IT IN THE MIDDLE MEANT THE HEAD
                ;    WAS ALREADY TRUNCATED AND WRITTEN BACK WHEN THE MAPPER RAN
                ;    OUT, AND THE TAIL WENT WITH IT.
                CALL    NEWREC
                RET     C               ; NO MAPPER MEMORY: LEAVE THE LINE ALONE
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 2. LOAD THE LINE THAT IS ABOUT TO BE SPLIT
                LD      HL, (DOCLINE)
                CALL    LINEREAD

                ; 3. TAIL -> WORKBUF2, HEAD TRUNCATED IN PLACE
                CALL    SPLITL

                ; 4. WRITE THE SHORTENED HEAD BACK
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                ; 5. PUT THE TAIL IN THE RESERVED RECORD. IT LIVES IN THE
                ;    APPEND SEGMENT, AND LINEREAD / LINEWRT HAVE RE-BANKED
                ;    PAGE 2 SINCE NEWREC, SO BANK IT BACK.
                CALL    APPBANK
                LD      DE, (NROFF)
                LD      HL, TXPAGE
                ADD     HL, DE
                EX      DE, HL          ; DE = DESTINATION
                LD      HL, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 6. OPEN A DIRECTORY SLOT AFTER THE CURRENT LINE AND FILL IT
                LD      HL, (DOCLINE)
                INC     HL
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. ADVANCE TO NEW LINE
                XOR     A
                LD      (CURX), A

                LD      HL, (DOCLINE)
                INC     HL
                LD      (DOCLINE), HL

                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .NWATBOT

                ; NOT AT BOTTOM: CURY INCREMENTS
                INC     A
                LD      (CURY), A
                INC     A
                LD      B, A            ; B = SCREEN ROW OF NEW LINE (2..24)
                PUSH    BC
                CALL    SHIFTDN
                POP     BC

                ; RENDER SHORTENED HEAD (ROW B - 1)
                DEC     B
                CALL    RENDEROW

                ; RENDER NEW LINE (ROW B)
                INC     B
                CALL    RENDEROW
                CALL    DRWGUT
                JR      .NWDONE

.NWATBOT        ; AT BOTTOM OF SCREEN: SCROLL VIEWPORT DOWN
                LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                CALL    SCROLLDN

                ; RENDER SHORTENED HEAD (ROW 23)
                LD      B, 23
                CALL    RENDEROW
                CALL    DRWGUT

.NWDONE         LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- SPLITL                    ----------------------------------------


; - SPLITL -----------------------------
; - SPLIT WORKBUF AT THE CURSOR COLUMN
; - OUT: WORKBUF2 = THE TAIL AS A COMPLETE LINE RECORD
; -      WORKBUF  = TRUNCATED TO CURX CHARACTERS
; - CLOBBERS: ALL
; -

SPLITL          LD      A, (CURX)


; - SPLITLA ----------------------------
; - SPLIT WORKBUF AT AN EXPLICIT COLUMN
; - IN:  A = SPLIT COLUMN (0-80)
; - OUT: WORKBUF2 = THE TAIL AS A COMPLETE LINE RECORD
; -      WORKBUF  = TRUNCATED TO A CHARACTERS
; - CLOBBERS: ALL
; -

SPLITLA         LD      (SPLCOL), A
                LD      HL, WORKBUF2
                CALL    RECBLNK         ; BLANK RECORD: LEN 0, SPACES, ATTRS 0

                ; TAIL LENGTH = MAX(LEN - SPLIT COLUMN, 0)
                LD      A, (WORKBUF)
                LD      HL, SPLCOL
                SUB     (HL)
                JR      NC, .LENOK
                XOR     A               ; THE SPLIT SITS PAST THE END OF THE TEXT
.LENOK          LD      (WORKBUF2), A
                LD      B, A
                AND     A
                JR      Z, .TRUNC       ; NOTHING TO CARRY OVER

                LD      C, B
                LD      B, 0            ; BC = BYTES TO MOVE

                ; TEXT HALF
                LD      A, (SPLCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      DE, WORKBUF2 + 1
                PUSH    BC
                LDIR
                POP     BC

                ; ATTRIBUTE HALF
                LD      A, (SPLCOL)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
                LD      DE, WORKBUF2 + 1 + TEXTCOLS
                LDIR

.TRUNC          ; HEAD KEEPS SPLCOL CHARACTERS; BLANK WHAT IS LEFT OF IT
                LD      A, (SPLCOL)
                LD      (WORKBUF), A
                LD      E, A
                LD      D, 0
                LD      A, TEXTCOLS
                SUB     E
                RET     Z               ; THE SPLIT WAS AT COLUMN 80
                LD      B, A

                PUSH    BC
                PUSH    DE
                LD      HL, WORKBUF + 1
                ADD     HL, DE
.BLNKLP         LD      (HL), ' '
                INC     HL
                DJNZ    .BLNKLP
                POP     DE
                POP     BC

                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE
.ZATTLP         LD      (HL), 0
                INC     HL
                DJNZ    .ZATTLP
                RET


; --- EDMOVCHR                  ----------------------------------------


; - EDMOVCHR ---------------------------
; - MOVE CURSOR LEFT OR RIGHT ONE CHAR
; - IN:  A = CRIGHT OR CLEFT
; - OUT: NONE
; - CLOBBERS: AF
; -

EDMOVCHR        CP      CRIGHT
                JR      Z, .RIGHT
                
                ; CLEFT:
                LD      A, (CURX)
                OR      A
                RET     Z               ; AT COL 0
                DEC     A
                LD      (CURX), A
                RET
                
.RIGHT          LD      A, (CURX)
                INC     A
                CP      TEXTCOLS        ; 80
                RET     NC              ; CLAMP TO COL 79
                LD      (CURX), A
                RET


; --- EDMOVROW                  ----------------------------------------


; - EDMOVROW ---------------------------
; - MOVE CURSOR UP OR DOWN ONE ROW
; - IN:  A = CUP OR CDOWN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDMOVROW        CP      CDOWN
                JR      Z, .DOWN
                
                ; CUP:
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT TOP OF DOCUMENT
                DEC     HL
                LD      (DOCLINE), HL
                LD      A, (CURY)
                OR      A
                JR      Z, .SCRLUP
                DEC     A
                LD      (CURY), A
                RET
                
.SCRLUP         LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL
                CALL    SCROLLUP
                RET
                
.DOWN           ; CDOWN:
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; AT BOTTOM OF DOCUMENT
                LD      (DOCLINE), HL
                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .SCRLDN
                INC     A
                LD      (CURY), A
                RET
                
.SCRLDN         LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                CALL    SCROLLDN
                RET



; --- EDQUIT                    ----------------------------------------


; - EDQUIT -----------------------------
; - EXIT EDITOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDQUIT          JP      TERM

