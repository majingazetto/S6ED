;                                       ****************************************
;                                       * EDIT OPERATIONS                      *
;                                       ****************************************
;
; ALL EDITING OPERATIONS WORK ON WORKBUF (CURRENT LINE LOADED BY LINEREAD).
; AFTER #EAC EDIT: LINEWRT TO PERSIST, PUTLINE TO RE-RENDER, DRWGUT.


; --- EDINSCHR                 ----------------------------------------

; --- EDINSCHR                 ----------------------------------------


; - EDINSCHR ---------------------------
; - INSERT CHARACTER AT CURSOR POSITION
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDINSCHR        PUSH    AF
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                POP     AF
                
                LD      C, A            ; C = CHAR TO INSERT
                LD      A, (CURX)
                CP      TEXTCOLS        ; 80
                RET     NC              ; CURX >= 80, CANNOT INSERT
                
                ; SHIFT RIGHT FROM COL 79 DOWN TO CURX + 1
                LD      B, 79
.SHIFTRP        LD      A, B
                LD      HL, CURX
                CP      (HL)
                JR      Z, .SETCHR
                
                LD      E, B
                LD      D, 0
                LD      HL, WORKBUF
                ADD     HL, DE          ; HL = WORKBUF + B (PREV COL)
                LD      A, (HL)
                INC     HL              ; HL = WORKBUF + 1 + B (THIS COL)
                LD      (HL), A
                DEC     B
                JR      .SHIFTRP
                
.SETCHR         ; PUT CHAR C AT WORKBUF + 1 + CURX
                LD      A, (CURX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      (HL), C
                
                ; UPDATE LINE LENGTH IF NEEDED
                LD      A, (WORKBUF)
                CP      TEXTCOLS
                JR      NC, .LENOK
                INC     A
                LD      (WORKBUF), A
.LENOK          ; WRITE LINE TO MAPPER
                LD      HL, (DOCLINE)
                CALL    LINEWRT
                
                ; RE-RENDER CURRENT ROW
                LD      A, (CURY)
                INC     A
                LD      B, A            ; B = SCREEN ROW (1..24)
                CALL    RENDEROW
                
                ; ADVANCE CURSOR
                LD      A, (CURX)
                INC     A
                CP      TEXTCOLS
                JR      NC, .NOMOV
                LD      (CURX), A
.NOMOV          LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EDOVRCHR                  ----------------------------------------


; - EDOVRCHR ---------------------------
; - OVERWRITE CHARACTER AT CURSOR
; - IN:  A = CHAR CODE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDOVRCHR        CALL    EDINSCHR        ; FOR NOW, ROUTE TO INSERT
                RET


; --- EDDELBK                 ----------------------------------------


; - EDDELBK ----------------------------
; - DELETE CHARACTER BEFORE CURSOR (BACKSPACE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELBK         LD      A, (CURX)
                OR      A
                RET     Z               ; AT COL 0, CANNOT BACKSPACE
                DEC     A
                LD      (CURX), A
                
                ; LOAD LINE RECORD
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                
                ; SHIFT LEFT FROM CURX UP TO COL 78
                LD      A, (CURX)
                LD      B, A
.SHIFTLP        LD      A, B
                CP      79
                JR      Z, .BLANKLST
                LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 2 ; SOURCE: WORKBUF + 1 + B + 1
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL              ; DEST: WORKBUF + 1 + B
                LD      (HL), A
                INC     B
                JR      .SHIFTLP
                
.BLANKLST       LD      HL, WORKBUF + 80
                LD      (HL), ' '       ; BLANK LAST COL
                
                ; DECREASE LINE LENGTH IF > 0
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .DELWRT
                DEC     A
                LD      (WORKBUF), A
                
.DELWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT
                
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                
                LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EDDELCHR                  ----------------------------------------


; - EDDELCHR ---------------------------
; - DELETE CHARACTER AT CURSOR (DEL KEY)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDDELCHR        LD      HL, (DOCLINE)
                CALL    LINEREAD
                
                LD      A, (CURX)
                LD      B, A
.DCHSHFT        LD      A, B
                CP      79
                JR      Z, .DCHLAST
                LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 2
                ADD     HL, DE
                LD      A, (HL)
                DEC     HL
                LD      (HL), A
                INC     B
                JR      .DCHSHFT
                
.DCHLAST        LD      HL, WORKBUF + 80
                LD      (HL), ' '
                
                LD      A, (WORKBUF)
                OR      A
                JR      Z, .DCHWRT
                DEC     A
                LD      (WORKBUF), A
                
.DCHWRT         LD      HL, (DOCLINE)
                CALL    LINEWRT
                
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                
                LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- EDNWLIN                 ----------------------------------------


; - EDNWLIN ----------------------------
; - INSERT LINE BREAK / NEWLINE AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDNWLIN         XOR     A
                LD      (CURX), A       ; CURX = 0
                
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .JUSTMOV     ; IF DOCLINE + 1 < TOTLINES, JUST MOVE DOWN
                
                ; AT END OF DOCUMENT: APPEND NEW LINE RECORD
                CALL    SEGGET
                JP      C, ERRMEM
                LD      (TXSEG), A
                CALL    PUTP2
                XOR     A
                LD      (TXPAGE), A     ; LEN = 0
                LD      HL, TXPAGE + 1
                LD      (HL), ' '
                LD      DE, TXPAGE + 2
                LD      BC, 79
                LDIR
                LD      HL, TXPAGE + 81
                LD      (HL), 0
                LD      DE, TXPAGE + 82
                LD      BC, 79
                LDIR
                
                LD      HL, (TOTLINES)
                LD      A, (TXSEG)
                LD      DE, 0
                CALL    DIRWRITE
                
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL
                
.JUSTMOV        LD      A, CDOWN
                CALL    EDMOVROW
                RET


; --- EDMOVCHR                  ----------------------------------------


; - EDMOVCHR ---------------------------
; - MOVE CURSOR LEFT OR RIGHT ONE CHAR
; - IN:  A = CRIGHT OR CLEFT
; - OUT: NONE
; - CLOBBERS: AF
; -

EDMOVCHR        CP      CRIGHT
                JR      Z, .RIGHT
                
                ; CLEFT:
                LD      A, (CURX)
                OR      A
                RET     Z               ; AT COL 0
                DEC     A
                LD      (CURX), A
                RET
                
.RIGHT          LD      A, (CURX)
                INC     A
                CP      TEXTCOLS        ; 80
                RET     NC              ; CLAMP TO COL 79
                LD      (CURX), A
                RET


; --- EDMOVROW                  ----------------------------------------


; - EDMOVROW ---------------------------
; - MOVE CURSOR UP OR DOWN ONE ROW
; - IN:  A = CUP OR CDOWN
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDMOVROW        CP      CDOWN
                JR      Z, .DOWN
                
                ; CUP:
                LD      HL, (DOCLINE)
                LD      A, H
                OR      L
                RET     Z               ; AT TOP OF DOCUMENT
                DEC     HL
                LD      (DOCLINE), HL
                LD      A, (CURY)
                OR      A
                JR      Z, .SCRLUP
                DEC     A
                LD      (CURY), A
                RET
                
.SCRLUP         LD      HL, (TOPLINE)
                DEC     HL
                LD      (TOPLINE), HL
                CALL    REDRAW
                RET
                
.DOWN           ; CDOWN:
                LD      HL, (DOCLINE)
                INC     HL
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                RET     NC              ; AT BOTTOM OF DOCUMENT
                LD      (DOCLINE), HL
                LD      A, (CURY)
                CP      SCRROWS - 1     ; 23
                JR      Z, .SCRLDN
                INC     A
                LD      (CURY), A
                RET
                
.SCRLDN         LD      HL, (TOPLINE)
                INC     HL
                LD      (TOPLINE), HL
                CALL    REDRAW
                RET


; --- EDQUIT                    ----------------------------------------


; - EDQUIT -----------------------------
; - EXIT EDITOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

EDQUIT          JP      TERM

