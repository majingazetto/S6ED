;                                       ****************************************
;                                       * ACTION                               *
;                                       ****************************************
;
; ATOMIC ACTION IMPLEMENTATIONS AND ACTION VECTOR TABLE (ACTTBL).
; ALL ACTIONS OPERATE ON SYSTEM AND EDITOR STATE (DOCLINE, CURX, WORKBUF, ETC.)


; --- ACTTBL                    ----------------------------------------


ACTTBL          DEFW    ACTNONE         ; 0
                DEFW    ACTMVL          ; 1
                DEFW    ACTMVR          ; 2
                DEFW    ACTMVU          ; 3
                DEFW    ACTMVD          ; 4
                DEFW    ACTBOL          ; 5
                DEFW    ACTEOL          ; 6
                DEFW    ACTTOP          ; 7
                DEFW    ACTBOT          ; 8
                DEFW    ACTWLFT         ; 9
                DEFW    ACTWRGT         ; 10
                DEFW    ACTDWLFT        ; 11
                DEFW    ACTPGUP         ; 12
                DEFW    ACTPGDN         ; 13
                DEFW    ACTDELBK        ; 14
                DEFW    ACTDELFW        ; 15
                DEFW    ACTDELLN        ; 16
                DEFW    ACTNWLIN        ; 17
                DEFW    ACTOPNBL        ; 18
                DEFW    ACTOPNAB        ; 19
                DEFW    ACTTGLIN        ; 20
                DEFW    ACTTGLWR        ; 21
                DEFW    ACTSAVE         ; 22
                DEFW    ACTQUIT         ; 23
                DEFW    ACTHELP         ; 24
                DEFW    ACTCYCKM        ; 25
                DEFW    ACTVIINS        ; 26
                DEFW    ACTVIAPP        ; 27
                DEFW    ACTVINRM        ; 28
                DEFW    ACTVILED        ; 29
                DEFW    ACTSLML         ; 30
                DEFW    ACTSLMR         ; 31
                DEFW    ACTSLMU         ; 32
                DEFW    ACTSLMD         ; 33
                DEFW    ACTSLBOL        ; 34
                DEFW    ACTSLEOL        ; 35
                DEFW    ACTSLTOP        ; 36
                DEFW    ACTSLBOT        ; 37
                DEFW    ACTSLWLF        ; 38
                DEFW    ACTSLWRT        ; 39
                DEFW    ACTSLPGU        ; 40
                DEFW    ACTSLPGD        ; 41
                DEFW    ACTSELAL        ; 42
                DEFW    ACTDSEL         ; 43
                DEFW    ACTDLS          ; 44
                DEFW    ACTCOPY         ; 45
                DEFW    ACTCUT          ; 46
                DEFW    ACTPAST         ; 47
                DEFW    ACTTGLBD        ; 48
                DEFW    ACTTGLIT        ; 49
                DEFW    ACTCYCMK        ; 50


; --- ACTNONE                   ----------------------------------------


; - ACTNONE ----------------------------
; - NO OPERATION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

ACTNONE         RET


; --- CHKUNSEL                  ----------------------------------------


; - CHKUNSEL ---------------------------
; - CANCEL SELECTION IF SHIFT IS NOT HELD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CHKUNSEL        LD      A, (MODKEYS)
                AND     MODSHFT
                RET     NZ              ; SHIFT PRESSED: PRESERVE SELECTION
                LD      A, (SELACT)
                OR      A
                RET     Z               ; NO SELECTION ACTIVE
                JP      ACTDSEL


; --- ACTMVL                    ----------------------------------------


; - ACTMVL -----------------------------
; - MOVE CURSOR LEFT ONE COLUMN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVL          CALL    CHKUNSEL
                LD      A, CLEFT
                CALL    EDMOVCHR
                RET


; --- ACTMVR                    ----------------------------------------


; - ACTMVR -----------------------------
; - MOVE CURSOR RIGHT ONE COLUMN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVR          CALL    CHKUNSEL
                LD      A, CRIGHT
                CALL    EDMOVCHR
                RET


; --- ACTMVU                    ----------------------------------------


; - ACTMVU -----------------------------
; - MOVE CURSOR UP ONE ROW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVU          CALL    CHKUNSEL
                LD      A, CUP
                CALL    EDMOVROW
                RET


; --- ACTMVD                    ----------------------------------------


; - ACTMVD -----------------------------
; - MOVE CURSOR DOWN ONE ROW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVD          CALL    CHKUNSEL
                LD      A, CDOWN
                CALL    EDMOVROW
                RET


; --- ACTBOL                    ----------------------------------------


; - ACTBOL -----------------------------
; - MOVE CURSOR TO BEGINNING OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTBOL          CALL    CHKUNSEL
                XOR     A
                LD      (CURX), A
                RET


; --- ACTEOL                    ----------------------------------------


; - ACTEOL -----------------------------
; - MOVE CURSOR TO END OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTEOL          CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                CP      TEXTCOLS
                JR      C, .EOLSET
                LD      A, TEXTCOLS - 1
.EOLSET         LD      (CURX), A
                RET


; --- ACTTOP                    ----------------------------------------


; - ACTTOP -----------------------------
; - MOVE CURSOR TO TOP OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTOP          CALL    CHKUNSEL
                LD      HL, 0
                LD      (DOCLINE), HL
                LD      (TOPLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                CALL    REDRAW
                RET


; --- ACTBOT                    ----------------------------------------


; - ACTBOT -----------------------------
; - MOVE CURSOR TO BOTTOM OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTBOT          CALL    CHKUNSEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (DOCLINE), HL
                LD      DE, SCRROWS
                CALL    CMPHLDE
                JR      C, .SHRTDOC
                LD      HL, (TOTLINES)
                LD      DE, SCRROWS
                OR      A
                SBC     HL, DE
                LD      (TOPLINE), HL
                LD      A, SCRROWS - 1
                LD      (CURY), A
                JR      .REDBOT
.SHRTDOC        LD      HL, 0
                LD      (TOPLINE), HL
                LD      A, (DOCLINE)
                LD      (CURY), A
.REDBOT         XOR     A
                LD      (CURX), A
                CALL    REDRAW
                RET


; --- ACTWLFT                   ----------------------------------------


; - ACTWLFT ----------------------------
; - MOVE CURSOR TO START OF PREV WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTWLFT         CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (CURX)
                OR      A
                RET     Z
                DEC     A
                LD      B, A            ; B = SCAN COLUMN

                ; 1. SKIP SPACES TO THE LEFT
.WLSKSPC        LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      NZ, .WLSKPW
                LD      A, B
                OR      A
                JR      Z, .WLBOL
                DEC     B
                JR      .WLSKSPC

                ; 2. SCAN WORD CHARACTERS TO FIND START
.WLSKPW         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WLFND
                LD      A, B
                OR      A
                JR      Z, .WLBOL
                DEC     B
                JR      .WLSKPW

.WLFND          INC     B
                LD      A, B
                LD      (CURX), A
                RET

.WLBOL          XOR     A
                LD      (CURX), A
                RET


; --- ACTWRGT                   ----------------------------------------


; - ACTWRGT ----------------------------
; - MOVE CURSOR TO START OF NEXT WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTWRGT         CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                LD      C, A            ; C = LENGTH
                LD      A, (CURX)
                CP      C
                RET     NC
.WRSKNON        INC     A
                CP      C
                JR      NC, .WREOL
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WRSKSPC
                LD      A, E
                JR      .WRSKNON
.WRSKSPC        INC     E
                LD      A, E
                CP      C
                JR      NC, .WREOL
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WRSKSPC
                LD      A, E
                LD      (CURX), A
                RET
.WREOL          LD      A, C
                CP      TEXTCOLS
                JR      C, .WRSET
                LD      A, TEXTCOLS - 1
.WRSET          LD      (CURX), A
                RET


; --- ACTDWLFT                  ----------------------------------------


; - ACTDWLFT ---------------------------
; - DELETE ENTIRE PREVIOUS WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDWLFT        LD      A, (CURX)
                OR      A
                RET     Z
                LD      (DWFROM), A
                CALL    ACTWLFT
                LD      A, (CURX)
                LD      (DWTO), A
                LD      A, (DWFROM)
                LD      (CURX), A       ; RESTORE CURX
                LD      HL, DWTO
                SUB     (HL)            ; A = DWFROM - DWTO = K
                RET     Z               ; DELTA IS ZERO, NOTHING TO DELETE
                LD      (DWK), A

                ; 1. SHIFT TEXT (WORKBUF + 1)
                ; DEST = WORKBUF + 1 + DWTO
                ; SRC  = WORKBUF + 1 + DWFROM
                ; COUNT = TEXTCOLS - DWFROM
                LD      A, (DWTO)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST

                LD      A, (DWFROM)
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 1
                ADD     HL, BC          ; HL = SRC

                LD      A, (DWFROM)
                LD      C, A
                LD      A, TEXTCOLS     ; 80
                SUB     C               ; A = 80 - DWFROM
                JR      Z, .NOSHFTT
                LD      C, A
                LD      B, 0            ; BC = COUNT
                LDIR

.NOSHFTT        ; 2. SHIFT ATTRIBUTES (WORKBUF + 81)
                LD      A, (DWTO)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST

                LD      A, (DWFROM)
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 81
                ADD     HL, BC          ; HL = SRC

                LD      A, (DWFROM)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                JR      Z, .NOSHFTA
                LD      C, A
                LD      B, 0
                LDIR

.NOSHFTA        ; 3. CLEAR VACATED TAIL IN TEXT (K BYTES AT 80 - K)
                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C               ; A = 80 - K
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      B, C            ; B = K
.BLKTXT         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT

                ; 4. CLEAR VACATED TAIL IN ATTRS (K BYTES AT 80 - K)
                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                LD      B, C
.BLKATR         LD      (HL), 0
                INC     HL
                DJNZ    .BLKATR

                ; 5. UPDATE LINE LENGTH
                LD      HL, WORKBUF
                LD      E, (HL)         ; E = CURRENT LENGTH
                LD      A, (DWTO)
                LD      B, A            ; B = DWTO
                LD      A, (DWFROM)
                LD      C, A            ; C = DWFROM
                LD      A, E
                CP      B
                JR      C, .DONELEN     ; LEN < DWTO: UNCHANGED
                JR      Z, .DONELEN     ; LEN == DWTO: UNCHANGED
                CP      C
                JR      C, .SETTO       ; LEN < DWFROM: NEW LEN = DWTO
                JR      Z, .SETTO       ; LEN == DWFROM: NEW LEN = DWTO
                ; LEN > DWFROM: NEW LEN = LEN - K
                LD      A, (DWK)
                LD      D, A
                LD      A, E
                SUB     D               ; A = LEN - K
                LD      (HL), A
                JR      .DONELEN

.SETTO          LD      (HL), B

.DONELEN        ; 6. SET CURX TO DWTO
                LD      A, (DWTO)
                LD      (CURX), A

                ; 7. WRITE TO MAPPER & RENDER ROW ONCE
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW

                LD      A, #FF
                LD      (MODIFIED), A
                CALL    DRWSTAT
                RET


; --- ACTPGUP                   ----------------------------------------


; - ACTPGUP ----------------------------
; - SCROLL UP ONE PAGE (24 ROWS)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPGUP         CALL    CHKUNSEL
                LD      B, 200
                LD      C, CUP
                CALL    KEYRUN          ; QUEUED REPEATS: ONE REDRAW FOR THEM ALL
                INC     A
                LD      C, A            ; C = PAGES
                LD      B, 0            ; B = PAGES TURNED
.PAGE           LD      HL, (TOPLINE)
                LD      A, H
                OR      L
                JR      Z, .PGUTOP
                LD      DE, SCRROWS
                OR      A
                SBC     HL, DE
                JR      NC, .PGUSET
                LD      HL, 0
.PGUSET         LD      (TOPLINE), HL
                LD      HL, (DOCLINE)
                OR      A
                SBC     HL, DE
                JR      NC, .PGUDOC
                LD      HL, 0
.PGUDOC         LD      (DOCLINE), HL
                INC     B
                DEC     C
                JR      NZ, .PAGE
                CALL    SETCURY
                JP      REDRAW
.PGUTOP         XOR     A
                LD      (CURY), A
                LD      HL, 0
                LD      (DOCLINE), HL
                LD      A, B
                OR      A
                RET     Z               ; ALREADY ON THE FIRST PAGE: CURSOR ONLY
                JP      REDRAW


; --- ACTPGDN                   ----------------------------------------


; - ACTPGDN ----------------------------
; - SCROLL DOWN ONE PAGE (24 ROWS)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPGDN         CALL    CHKUNSEL
                LD      B, 200
                LD      C, CDOWN
                CALL    KEYRUN          ; QUEUED REPEATS: ONE REDRAW FOR THEM ALL
                INC     A
                LD      C, A            ; C = PAGES
.PAGE           LD      HL, (TOPLINE)
                LD      DE, SCRROWS
                ADD     HL, DE
                EX      DE, HL          ; DE = TARGET TOP
                LD      HL, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .PGDBOT
                JR      Z, .PGDBOT
                EX      DE, HL
                LD      (TOPLINE), HL
                LD      HL, (DOCLINE)
                LD      DE, SCRROWS
                ADD     HL, DE
                LD      (DOCLINE), HL
                DEC     C
                JR      NZ, .PAGE
                ; THE CURSOR MAY HAVE PASSED THE LAST LINE WHILE THE TOP DID NOT
                LD      HL, (TOTLINES)
                DEC     HL
                LD      DE, (DOCLINE)
                CALL    CMPHLDE
                JR      NC, .PGDCUR
                LD      (DOCLINE), HL
.PGDCUR         CALL    SETCURY
                JP      REDRAW
.PGDBOT         JP      ACTBOT


; --- ACTDELBK                  ----------------------------------------


; - ACTDELBK ---------------------------
; - DELETE CHARACTER BEFORE CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELBK        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTDLS
                CALL    EDDELBK
                CALL    DRWSTAT
                RET


; --- ACTDELFW                  ----------------------------------------


; - ACTDELFW ---------------------------
; - DELETE CHARACTER AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELFW        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTDLS
                CALL    EDDELCHR
                CALL    DRWSTAT
                RET


; --- ACTDELLN                  ----------------------------------------


; - ACTDELLN ---------------------------
; - DELETE ENTIRE CURRENT LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELLN        LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                RET     Z
                LD      DE, 1
                CALL    CMPHLDE
                JR      NZ, .DLMULT
                ; SINGLE LINE LEFT: CLEAR RECORD TO SPACES
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                XOR     A
                LD      (WORKBUF), A
                LD      HL, WORKBUF + 1
                LD      (HL), ' '
                LD      DE, WORKBUF + 2
                LD      BC, TEXTCOLS - 1
                LDIR
                LD      HL, (DOCLINE)
                CALL    LINEWRT
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                XOR     A
                LD      (CURX), A
                LD      A, #FF
                LD      (MODIFIED), A
                RET
.DLMULT         LD      HL, (DOCLINE)
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      HL, (DOCLINE)
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .DLOK
                DEC     HL
                LD      (DOCLINE), HL
.DLOK           CALL    SETCURY
                XOR     A
                LD      (CURX), A
                CALL    REDRAW
                LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- ACTNWLIN                  ----------------------------------------


; - ACTNWLIN ---------------------------
; - SPLIT LINE AND INSERT NEWLINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTNWLIN        CALL    EDNWLIN
                RET


; --- ACTOPNBL                  ----------------------------------------


; - ACTOPNBL ---------------------------
; - OPEN NEW EMPTY LINE BELOW (VI LOWERCASE 'O')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPNBL        CALL    ACTEOL
                CALL    EDNWLIN
                CALL    ACTVIINS
                RET


; --- ACTOPNAB                  ----------------------------------------


; - ACTOPNAB ---------------------------
; - OPEN NEW EMPTY LINE ABOVE (VI O)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPNAB        CALL    ACTBOL
                CALL    EDNWLIN
                LD      A, CUP
                CALL    EDMOVROW
                CALL    ACTVIINS
                RET


; --- ACTTGLIN                  ----------------------------------------


; - ACTTGLIN ---------------------------
; - TOGGLE INSERT / OVERWRITE MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTTGLIN        LD      A, (INSMODE)
                XOR     INS_MODE
                LD      (INSMODE), A
                CALL    DRWSTAT
                RET


; --- ACTTGLWR                  ----------------------------------------


; - ACTTGLWR ---------------------------
; - TOGGLE DEVELOPER / TEXT WRAP MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLWR        CALL    EDTGLWRP
                CALL    DRWSTAT
                RET


; --- ACTSAVE                   ----------------------------------------


; - ACTSAVE ----------------------------
; - SAVE DOCUMENT TO DISK
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSAVE         CALL    FILESAVE
                CALL    DRWSTAT
                RET


; --- ACTQUIT                   ----------------------------------------


; - ACTQUIT ----------------------------
; - EXIT EDITOR TO DOS
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTQUIT         LD      A, (SELACT)
                OR      A
                JR      Z, .DOQUIT
                JP      ACTDSEL
.DOQUIT         JP      TERM


; --- ACTHELP                   ----------------------------------------


; - ACTHELP ----------------------------
; - DISPLAY HELP SCREEN STUB
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

ACTHELP         RET


; --- ACTCYCKM                  ----------------------------------------


; - ACTCYCKM ---------------------------
; - CYCLE ACTIVE KEYMAP PROFILE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTCYCKM        CALL    KMAPCYC
                RET


; --- ACTVIINS                  ----------------------------------------


; - ACTVIINS ---------------------------
; - SWITCH VI TO INSERT MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIINS        LD      A, VIMINS
                LD      (VIMODE), A
                LD      HL, KMAPVII
                LD      (KMAPPTR), HL
                CALL    DRWSTAT
                RET


; --- ACTVIAPP                  ----------------------------------------


; - ACTVIAPP ---------------------------
; - ADVANCE AND SWITCH VI TO INSERT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIAPP        LD      A, CRIGHT
                CALL    EDMOVCHR
                CALL    ACTVIINS
                RET


; --- ACTVINRM                  ----------------------------------------


; - ACTVINRM ---------------------------
; - SWITCH VI TO NORMAL MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVINRM        LD      A, VIMNORM
                LD      (VIMODE), A
                LD      HL, KMAPVIN
                LD      (KMAPPTR), HL
                LD      A, (CURX)
                OR      A
                JR      Z, .VINORM0
                DEC     A
                LD      (CURX), A
.VINORM0        CALL    DRWSTAT
                RET


; --- ACTVILED                  ----------------------------------------


; - ACTVILED ---------------------------
; - SET VI DELETE LEADER PENDING
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTVILED        LD      A, 'd'
                LD      (VILEAD), A
                RET


; --- SELBEG                    ----------------------------------------


; - SELBEG -----------------------------
; - INITIALIZE SELECTION ANCHOR IF INACTIVE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

SELBEG          LD      A, (SELACT)
                OR      A
                RET     NZ              ; ALREADY ACTIVE
                LD      A, 1
                LD      (SELACT), A
                LD      A, (CURX)
                LD      (SELANCX), A
                LD      HL, (DOCLINE)
                LD      (SELANCL), HL
                RET


; --- SELPRE                    ----------------------------------------


; - SELPRE -----------------------------
; - UN-XOR CURRENTLY PAINTED SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPRE          LD      A, (SELDRAWN)
                OR      A
                RET     Z
                LD      HL, DRWSTRL
                LD      DE, SELSTRL
                LD      BC, 6
                LDIR
                CALL    SELPAIN         ; UN-XOR INVERT
                XOR     A
                LD      (SELDRAWN), A
                RET


; --- SELPOST                   ----------------------------------------


; - SELPOST ----------------------------
; - NORMALIZE AND XOR-PAINT NEW SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPOST         CALL    SELNORM
                LD      A, (SELDRAWN)
                OR      A
                JR      NZ, .UPDATE

                ; NOTHING PAINTED: PAINT THE NEW RANGE, IF IT IS NOT EMPTY
                CALL    SELEMPTY
                RET     Z
                CALL    SELPAIN
                JR      .RECORD

.UPDATE         ; SOMETHING PAINTED, AND STILL ON SCREEN: PAINT THE DIFFERENCE
                CALL    SELDIFF

.RECORD         LD      HL, SELSTRL
                LD      DE, DRWSTRL
                LD      BC, 6
                LDIR
                CALL    SELEMPTY
                LD      A, 1
                JR      NZ, .SETDRW
                XOR     A
.SETDRW         LD      (SELDRAWN), A
                JP      DRWSTAT


; - SELEMPTY ---------------------------
; - IS THE NORMALIZED SELECTION EMPTY (START == END)?
; - IN:  SELSTRL, SELSTRX, SELENDL, SELENDX
; - OUT: Z = EMPTY
; - CLOBBERS: AF, DE, HL
; -

SELEMPTY        LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                RET     NZ
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET


; --- SELNORM                   ----------------------------------------


; - SELNORM ----------------------------
; - NORMALIZE ANCHOR AND CURSOR TO START/END
; - IN:  NONE
; - OUT: SELSTRL, SELSTRX, SELENDL, SELENDX
; - CLOBBERS: AF, DE, HL
; -

SELNORM         LD      HL, (DOCLINE)
                LD      DE, (SELANCL)
                CALL    CMPHLDE
                JR      C, .NCURFST     ; DOCLINE < SELANCL
                JR      NZ, .NANCFST    ; DOCLINE > SELANCL
                LD      A, (CURX)
                LD      HL, SELANCX
                CP      (HL)
                JR      C, .NCURFST
.NANCFST        LD      HL, (SELANCL)
                LD      (SELSTRL), HL
                LD      A, (SELANCX)
                LD      (SELSTRX), A
                LD      HL, (DOCLINE)
                LD      (SELENDL), HL
                LD      A, (CURX)
                LD      (SELENDX), A
                RET

.NCURFST        LD      HL, (DOCLINE)
                LD      (SELSTRL), HL
                LD      A, (CURX)
                LD      (SELSTRX), A
                LD      HL, (SELANCL)
                LD      (SELENDL), HL
                LD      A, (SELANCX)
                LD      (SELENDX), A
                RET


; --- SELECTION PAINT          ----------------------------------------


; - SELEXT -----------------------------
; - COLUMN EXTENT OF A SELECTION RANGE ON ONE DOCUMENT LINE
; - IN:  HL = DOCUMENT LINE
; -      IX = RANGE BLOCK: STRL (2), STRX (1), ENDL (2), ENDX (1).
; -           SELSTRL.. AND DRWSTRL.. ARE BOTH LAID OUT THIS WAY.
; - OUT: CY = 1  THE LINE HAS NO SELECTED CELLS
; -      CY = 0  D = XA (FIRST COLUMN), E = XB (ONE PAST THE LAST), XB > XA.
; -              ON A LINE THAT IS NOT THE END LINE XB = MIN(LEN + 1, 80), SO
; -              THE LINE BREAK SHOWS AS ONE CELL AND AN EMPTY LINE AS ONE TOO.
; - CLOBBERS: AF, BC, DE, HL
; -

SELEXT          LD      E, (IX + 0)
                LD      D, (IX + 1)     ; DE = START LINE
                CALL    CMPHLDE
                RET     C               ; LINE < START
                LD      E, (IX + 3)
                LD      D, (IX + 4)     ; DE = END LINE
                PUSH    HL
                CALL    CMPHLDE
                POP     HL
                JR      Z, .INSIDE
                JR      C, .INSIDE
                SCF                     ; LINE > END
                RET

.INSIDE         ; XA = STRX ON THE START LINE, ELSE 0
                LD      E, (IX + 0)
                LD      D, (IX + 1)
                PUSH    HL
                CALL    CMPHLDE
                POP     HL
                LD      B, 0
                JR      NZ, .XASET
                LD      B, (IX + 2)
.XASET          ; XB = ENDX ON THE END LINE, ELSE MIN(LEN + 1, 80)
                LD      E, (IX + 3)
                LD      D, (IX + 4)
                PUSH    HL
                CALL    CMPHLDE
                POP     HL
                JR      NZ, .XBLEN
                LD      C, (IX + 5)
                JR      .XBSET
.XBLEN          PUSH    BC
                CALL    LINELEN         ; A = LENGTH
                POP     BC
                INC     A
                CP      TEXTCOLS
                JR      C, .XBCAP
                LD      A, TEXTCOLS
.XBCAP          LD      C, A
.XBSET          LD      A, C
                CP      B
                JR      Z, .NONE        ; XB == XA
                RET     C               ; XB < XA
                LD      D, B
                LD      E, C
                RET                     ; CY = 0 FROM THE CP
.NONE           SCF
                RET


; - SELXOR -----------------------------
; - XOR-INVERT COLUMNS XA..XB-1 OF ONE SCREEN ROW
; - IN:  B = SCREEN ROW (0..23), D = XA, E = XB (XB > XA)
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELXOR          LD      A, E
                SUB     D
                LD      L, A
                LD      H, 0
                LD      C, D            ; C = XA
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE          ; * 3
                ADD     HL, HL          ; NX = CELLS * 6
                LD      (VDP_NX), HL
                LD      L, C
                LD      H, 0
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                ADD     HL, HL          ; XA * 6
                LD      DE, TXORG_X
                ADD     HL, DE
                LD      (VDP_DX), HL
                LD      A, B
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; DY = (ROW + 1) * 8
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_HI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_XOR
                JP      LMMV


; - SELPAIN ----------------------------
; - XOR-INVERT THE VISIBLE PART OF THE SELECTION SELSTRL..SELENDL
; - IN:  SELSTRL, SELSTRX, SELENDL, SELENDX
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPAIN         LD      IX, SELSTRL
                LD      B, 0
.ROWLP          PUSH    BC
                LD      HL, (TOPLINE)
                LD      E, B
                LD      D, 0
                ADD     HL, DE
                CALL    SELEXT
                POP     BC
                JR      C, .NEXT
                PUSH    BC
                CALL    SELXOR
                POP     BC
.NEXT           INC     B
                LD      A, B
                CP      SCRROWS
                JR      C, .ROWLP
                RET


; - SELDIFF ----------------------------
; - REPAINT ONLY WHAT CHANGED BETWEEN THE PAINTED RANGE (DRWSTRL..) AND THE
; - NEW ONE (SELSTRL..). XOR IS ITS OWN INVERSE, SO A ROW WHOSE EXTENT IS THE
; - SAME IN BOTH IS LEFT ALONE; A ROW WHOSE EXTENT MOVED AT ONE END ONLY GETS
; - ONE XOR OVER THE DIFFERENCE; ANYTHING ELSE GETS THE OLD EXTENT UN-XORED
; - AND THE NEW ONE XORED. EXTENDING BY A CHARACTER OR A ROW IS THEREBY ONE
; - OR TWO COMMANDS INSTEAD OF TWICE THE WHOLE SELECTION.
; - VALID ONLY WHILE THE PAINTED RANGE IS STILL ON SCREEN AS PAINTED: NO
; - SCROLL, NO ROW REPAINTED SINCE. THE CALLERS THAT SKIP SELPRE GUARANTEE IT.
; - IN:  DRWSTRL.., SELSTRL.., TOPLINE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELDIFF         LD      B, 0
.ROWLP          PUSH    BC
                LD      HL, (TOPLINE)
                LD      E, B
                LD      D, 0
                ADD     HL, DE
                PUSH    HL

                ; OLD EXTENT INTO SELTMPXA / SELTMPXB (0 / 0 WHEN NONE)
                LD      IX, DRWSTRL
                CALL    SELEXT
                LD      A, 0
                JR      C, .OLDSET
                LD      A, E
                LD      (SELTMPXB), A
                LD      A, D
.OLDSET         LD      (SELTMPXA), A
                JR      NC, .NEWEXT
                LD      (SELTMPXB), A

.NEWEXT         ; NEW EXTENT INTO D / E (0 / 0 WHEN NONE)
                POP     HL
                LD      IX, SELSTRL
                CALL    SELEXT
                JR      NC, .COMPARE
                LD      D, 0
                LD      E, 0

.COMPARE        POP     BC              ; B = SCREEN ROW
                LD      A, (SELTMPXA)
                CP      D
                JR      NZ, .DIFFXA
                LD      A, (SELTMPXB)
                CP      E
                JR      Z, .NEXT        ; IDENTICAL, OR NONE IN BOTH
                ; SAME XA: ONE XOR OVER MIN(XB)..MAX(XB)
                JR      C, .XBGREW
                LD      D, E            ; OLD XB > NEW XB: NEW XB .. OLD XB
                LD      E, A
                JR      .ONEXOR
.XBGREW         LD      D, A            ; OLD XB .. NEW XB
                JR      .ONEXOR

.DIFFXA         LD      A, (SELTMPXB)
                CP      E
                JR      NZ, .BOTH
                ; SAME XB: ONE XOR OVER MIN(XA)..MAX(XA)
                LD      A, (SELTMPXA)
                CP      D
                JR      C, .XASHRK
                LD      E, A            ; OLD XA > NEW XA: NEW XA .. OLD XA
                JR      .ONEXOR
.XASHRK         LD      E, D            ; OLD XA .. NEW XA
                LD      D, A
.ONEXOR         PUSH    BC
                CALL    SELXOR
                POP     BC
                JR      .NEXT

.BOTH           ; UN-XOR THE OLD EXTENT, XOR THE NEW ONE, EACH IF IT EXISTS
                PUSH    BC
                PUSH    DE
                LD      A, (SELTMPXA)
                LD      D, A
                LD      A, (SELTMPXB)
                LD      E, A
                CP      D
                JR      Z, .NOOLD
                JR      C, .NOOLD
                CALL    SELXOR
.NOOLD          POP     DE
                POP     BC
                LD      A, E
                CP      D
                JR      Z, .NEXT
                JR      C, .NEXT
                PUSH    BC
                CALL    SELXOR
                POP     BC

.NEXT           INC     B
                LD      A, B
                CP      SCRROWS
                JP      C, .ROWLP
                RET


; --- ACTDSEL                   ----------------------------------------


; - ACTDSEL ----------------------------
; - CANCEL ACTIVE SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDSEL         LD      A, (SELACT)
                OR      A
                RET     Z
                CALL    SELPRE          ; UN-XOR IF DRAWN
                XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                CALL    DRWSTAT
                RET


; --- ACTSELAL                  ----------------------------------------


; - ACTSELAL ---------------------------
; - SELECT ENTIRE DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSELAL        CALL    SELPRE          ; UN-XOR EXISTING IF DRAWN
                LD      HL, 0
                LD      (SELANCL), HL
                XOR     A
                LD      (SELANCX), A
                LD      A, 1
                LD      (SELACT), A

                ; MOVE CURSOR TO END OF LAST LINE
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (DOCLINE), HL
                CALL    LINEREAD
                LD      A, (WORKBUF)
                LD      (CURX), A

                CALL    SETCURY
                CALL    REDRAW
                CALL    SELPOST
                RET


; --- ACTSLML                   ----------------------------------------


; - ACTSLML ----------------------------
; - EXTEND SELECTION ONE CHAR LEFT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLML         CALL    SELBEG
                CALL    ACTMVL          ; NO SCROLL, NO REPAINT: SELPOST DIFFS
                JP      SELPOST


; --- ACTSLMR                   ----------------------------------------


; - ACTSLMR ----------------------------
; - EXTEND SELECTION ONE CHAR RIGHT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMR         CALL    SELBEG
                CALL    ACTMVR          ; NO SCROLL, NO REPAINT: SELPOST DIFFS
                JP      SELPOST


; --- ACTSLMU                   ----------------------------------------


; - ACTSLMU ----------------------------
; - EXTEND SELECTION ONE ROW UP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMU         CALL    SELBEG
                LD      A, (CURY)
                OR      A
                CALL    Z, SELPRE       ; TOP ROW: THE MOVE SCROLLS, UN-XOR FIRST
                CALL    ACTMVU
                JP      SELPOST


; --- ACTSLMD                   ----------------------------------------


; - ACTSLMD ----------------------------
; - EXTEND SELECTION ONE ROW DOWN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMD         CALL    SELBEG
                LD      A, (CURY)
                CP      SCRROWS - 1
                CALL    Z, SELPRE       ; BOTTOM ROW: THE MOVE SCROLLS, UN-XOR FIRST
                CALL    ACTMVD
                JP      SELPOST


; --- ACTSLBOL                  ----------------------------------------


; - ACTSLBOL ---------------------------
; - EXTEND SELECTION TO BEGINNING OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLBOL        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTBOL
                JP      SELPOST


; --- ACTSLEOL                  ----------------------------------------


; - ACTSLEOL ---------------------------
; - EXTEND SELECTION TO END OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLEOL        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTEOL
                JP      SELPOST


; --- ACTSLTOP                  ----------------------------------------


; - ACTSLTOP ---------------------------
; - EXTEND SELECTION TO TOP OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLTOP        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTTOP
                JP      SELPOST


; --- ACTSLBOT                  ----------------------------------------


; - ACTSLBOT ---------------------------
; - EXTEND SELECTION TO BOTTOM OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLBOT        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTBOT
                JP      SELPOST


; --- ACTSLWLF                  ----------------------------------------


; - ACTSLWLF ---------------------------
; - EXTEND SELECTION TO PREV WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLWLF        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTWLFT
                JP      SELPOST


; --- ACTSLWRT                  ----------------------------------------


; - ACTSLWRT ---------------------------
; - EXTEND SELECTION TO NEXT WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLWRT        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTWRGT
                JP      SELPOST


; --- ACTSLPGU                  ----------------------------------------


; - ACTSLPGU ---------------------------
; - EXTEND SELECTION ONE PAGE UP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLPGU        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTPGUP
                JP      SELPOST


; --- ACTSLPGD                  ----------------------------------------


; - ACTSLPGD ---------------------------
; - EXTEND SELECTION ONE PAGE DOWN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLPGD        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTPGDN
                JP      SELPOST


; --- ACTDLS                    ----------------------------------------


; - ACTDLS -----------------------------
; - DELETE ACTIVE SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDLS          LD      A, (SELACT)
                OR      A
                RET     Z               ; NOTHING SELECTED
                CALL    SELPRE          ; UN-XOR VISIBLE OVERLAY
                CALL    SELNORM         ; NORMALIZE RANGE
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .DLSNEMP
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                JP      Z, .DLSCLR      ; EMPTY RANGE: JUST CLEAR AND EXIT

.DLSNEMP        ; CHECK SINGLE-LINE VS MULTI-LINE
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JP      NZ, .DLSMULT

                ; --- SINGLE LINE DELETION -----------------------------
                LD      HL, (SELSTRL)
                CALL    LINEREAD        ; READ LINE INTO WORKBUF

                LD      A, (SELSTRX)
                LD      B, A            ; B = STARTX
                LD      A, (SELENDX)
                LD      C, A            ; C = ENDX
                SUB     B               ; A = ENDX - STARTX = K
                JP      Z, .DLSCLR
                LD      (DWK), A        ; DWK = K

                ; 1. SHIFT TEXT
                LD      A, B
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST

                LD      A, C
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 1
                ADD     HL, BC          ; HL = SRC

                LD      A, (SELENDX)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C               ; A = 80 - ENDX
                JR      Z, .NOSHFT
                LD      C, A
                LD      B, 0
                LDIR

.NOSHFT         ; 2. SHIFT ATTRS
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                EX      DE, HL

                LD      A, (SELENDX)
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 81
                ADD     HL, BC

                LD      A, (SELENDX)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                JR      Z, .NOSHFTA
                LD      C, A
                LD      B, 0
                LDIR

.NOSHFTA        ; 3. BLANK VACATED TAIL
                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      B, C
.BLKTXT2        LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT2

                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                LD      B, C
.BLKATR2        LD      (HL), 0
                INC     HL
                DJNZ    .BLKATR2

                ; 4. UPDATE LENGTH
                LD      HL, WORKBUF
                LD      E, (HL)         ; CURRENT LENGTH
                LD      A, (SELSTRX)
                LD      B, A            ; B = STARTX
                LD      A, (SELENDX)
                LD      C, A            ; C = ENDX
                LD      A, E
                CP      B
                JR      C, .DLSSETC     ; LEN < STARTX: UNCHANGED
                JR      Z, .DLSSETC     ; LEN == STARTX: UNCHANGED
                CP      C
                JR      C, .DLSSETT     ; LEN < ENDX: LEN = STARTX
                JR      Z, .DLSSETT
                LD      A, (DWK)
                LD      D, A
                LD      A, E
                SUB     D
                LD      (HL), A
                JR      .DLSSETC
.DLSSETT        LD      (HL), B

.DLSSETC        ; 5. WRITE LINE TO MAPPER
                LD      HL, (SELSTRL)
                CALL    LINEWRT

                ; 6. SET CURSOR POSITION
                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                LD      (DOCLINE), HL
                CALL    SETCURY

                ; 7. RENDER ROW
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                JP      .DLSFIN

.DLSMULT        ; --- MULTI-LINE DELETION ------------------------------
                ; 1. READ END LINE INTO WORKBUF2
                LD      HL, (SELENDL)
                CALL    LINEREAD
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 2. READ START LINE INTO WORKBUF
                LD      HL, (SELSTRL)
                CALL    LINEREAD

                ; 3. SPLICE TAIL OF WORKBUF2 (FROM ENDX TO LEN2) ONTO WORKBUF AT STARTX
                LD      A, (WORKBUF2)   ; LEN2
                LD      HL, SELENDX
                CP      (HL)
                JR      C, .NOTAIL
                JR      Z, .NOTAIL
                SUB     (HL)            ; A = M
                LD      C, A            ; C = M
                LD      A, (SELSTRX)
                ADD     A, C
                CP      TEXTCOLS + 1
                JR      C, .NOTRUNC
                LD      A, TEXTCOLS
                LD      HL, SELSTRX
                SUB     (HL)
                LD      C, A            ; C = CLAMPED M
.NOTRUNC        ; COPY TEXT TAIL
                LD      A, (SELENDX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF2 + 1
                ADD     HL, DE          ; HL = SRC
                PUSH    HL              ; SAVE SRC
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST
                POP     HL              ; HL = SRC
                PUSH    BC              ; SAVE M IN C
                LD      B, 0
                LDIR

                ; COPY ATTR TAIL
                LD      A, (SELENDX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF2 + 81
                ADD     HL, DE          ; HL = SRC ATTR
                PUSH    HL              ; SAVE SRC ATTR
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST ATTR
                POP     HL              ; HL = SRC ATTR
                POP     BC              ; RESTORE M IN C
                PUSH    BC
                LD      B, 0
                LDIR
                POP     BC              ; C = M
                LD      A, (SELSTRX)
                ADD     A, C
                LD      (WORKBUF), A
                JR      .SAVESTR

.NOTAIL         LD      A, (SELSTRX)
                LD      (WORKBUF), A

.SAVESTR        ; CLEAR TAIL OF WORKBUF (FROM LEN TO 80)
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, TEXTCOLS
                SUB     E
                JR      Z, .NOTBLKT
                LD      B, A
.BLKTX3         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTX3

.NOTBLKT        LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                LD      A, TEXTCOLS
                SUB     E
                JR      Z, .WRTSTR
                LD      B, A
.BLKAT3         LD      (HL), 0
                INC     HL
                DJNZ    .BLKAT3

.WRTSTR         ; WRITE UPDATED START LINE TO MAPPER
                LD      HL, (SELSTRL)
                CALL    LINEWRT

                ; 4. DELETE INTERMEDIATE LINES AND END LINE
                LD      HL, (SELENDL)
                LD      DE, (SELSTRL)
                OR      A
                SBC     HL, DE          ; HL = COUNT TO DELETE
                LD      (SELTMPL), HL

.DELOOP         LD      HL, (SELTMPL)
                LD      A, H
                OR      L
                JR      Z, .DELDONE
                DEC     HL
                LD      (SELTMPL), HL

                LD      HL, (SELSTRL)
                INC     HL              ; LINE TO DELETE = SELSTRL + 1
                CALL    LINEDEL

                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                JR      .DELOOP

.DELDONE        ; 5. RE-POSITION CURSOR AT START
                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                LD      (DOCLINE), HL
                CALL    SETCURY
                CALL    REDRAW

.DLSFIN         XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    DRWSTAT
                RET

.DLSCLR         XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                CALL    DRWSTAT
                RET


; --- ACTCOPY                   ----------------------------------------


; - ACTCOPY ----------------------------
; - COPY ACTIVE SELECTION TO CLIPBUF
; - IN:  NONE
; - OUT: (CLIPLEN) = BYTES WRITTEN
; - CLOBBERS: ALL
; -

ACTCOPY         LD      A, (SELACT)
                OR      A
                RET     Z               ; NO SELECTION ACTIVE
                CALL    SELNORM

                ; VERIFY SELECTION IS NOT EMPTY
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .CPYINIT
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET     Z               ; EMPTY: NOTHING TO COPY

.CPYINIT        LD      HL, CLIPBUF
                LD      (CPYPTR), HL
                LD      HL, 0
                LD      (CPYCNT), HL
                LD      HL, (SELSTRL)
                LD      (SELTMPL), HL

.CPYLINE        ; CHECK IF TOTAL BYTES EXCEEDS CLIPMAX
                LD      HL, (CPYCNT)
                LD      DE, CLIPMAX
                CALL    CMPHLDE
                JP      NC, .CPYEXIT    ; CLIPBOARD FULL

                ; READ CURRENT LINE INTO WORKBUF
                LD      HL, (SELTMPL)
                CALL    LINEREAD

                ; DETERMINE XA FOR THIS LINE
                LD      HL, (SELTMPL)
                LD      DE, (SELSTRL)
                CALL    CMPHLDE
                JR      NZ, .CPYMIDL
                LD      A, (SELSTRX)
                JR      .CPYSETX
.CPYMIDL        XOR     A
.CPYSETX        LD      (SELTMPXA), A

                ; DETERMINE XB FOR THIS LINE
                LD      A, (WORKBUF)
                LD      (SELTMPXB), A   ; DEFAULT XB = LINE LENGTH
                LD      HL, (SELTMPL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .CPYNEND
                LD      A, (SELENDX)
                LD      (SELTMPXB), A
.CPYNEND        ; CLAMP XB TO LINE LENGTH
                LD      A, (WORKBUF)
                LD      HL, SELTMPXB
                CP      (HL)
                JR      NC, .CPYXBOK
                LD      (SELTMPXB), A

.CPYXBOK        ; CHECK IF XA < XB
                LD      A, (SELTMPXA)
                LD      HL, SELTMPXB
                CP      (HL)
                JR      NC, .CPYCHKN    ; NO CHARS ON THIS LINE

                ; K = XB - XA
                SUB     (HL)
                NEG                     ; A = K
                LD      C, A            ; C = K (1..80)

                ; CLAMP K TO REMAINING CLIPBOARD SPACE (CLIPMAX - CPYCNT)
                LD      HL, CLIPMAX
                LD      DE, (CPYCNT)
                OR      A
                SBC     HL, DE          ; HL = REMAINING
                LD      A, H
                OR      A
                JR      NZ, .CPYKOK     ; REMAINING > 255: K DEFINITELY FITS
                LD      A, C
                CP      L
                JR      C, .CPYKOK      ; K < REMAINING
                LD      C, L            ; CLAMP K = REMAINING
.CPYKOK         LD      A, C
                OR      A
                JR      Z, .CPYEXIT

                ; COPY K BYTES FROM WORKBUF + 1 + XA TO (CPYPTR)
                PUSH    BC              ; SAVE K IN C
                LD      A, (SELTMPXA)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE          ; HL = SRC
                LD      DE, (CPYPTR)    ; DE = DEST
                LD      B, 0            ; BC = K
                LDIR
                LD      (CPYPTR), DE    ; UPDATE WRITE POINTER
                POP     BC              ; RESTORE K IN C

                ; CPYCNT += K
                LD      HL, (CPYCNT)
                LD      B, 0
                ADD     HL, BC
                LD      (CPYCNT), HL

.CPYCHKN        ; IF SELTMPL == SELENDL, WE ARE FINISHED
                LD      HL, (SELTMPL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      Z, .CPYEXIT

                ; NOT LAST LINE: APPEND CRLF (#0D, #0A) IF AT LEAST 2 BYTES REMAIN
                LD      HL, CLIPMAX
                LD      DE, (CPYCNT)
                OR      A
                SBC     HL, DE
                LD      A, H
                OR      A
                JR      NZ, .CPYCRLF
                LD      A, L
                CP      2
                JR      C, .CPYEXIT     ; NO ROOM FOR CRLF

.CPYCRLF        LD      HL, (CPYPTR)
                LD      (HL), #0D
                INC     HL
                LD      (HL), #0A
                INC     HL
                LD      (CPYPTR), HL
                LD      HL, (CPYCNT)
                INC     HL
                INC     HL
                LD      (CPYCNT), HL

                ; ADVANCE TO NEXT LINE
                LD      HL, (SELTMPL)
                INC     HL
                LD      (SELTMPL), HL
                JP      .CPYLINE

.CPYEXIT        LD      HL, (CPYCNT)
                LD      (CLIPLEN), HL
                RET


; --- ACTCUT                     ----------------------------------------


; - ACTCUT -----------------------------
; - CUT ACTIVE SELECTION TO CLIPBUF
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTCUT          CALL    ACTCOPY
                LD      HL, (CLIPLEN)
                LD      A, H
                OR      L
                RET     Z               ; NOTHING COPIED
                JP      ACTDLS          ; DELETE SELECTION FROM DOCUMENT


; --- ACTPAST                   ----------------------------------------


; - ACTPAST ----------------------------
; - PASTE CLIPBUF AT CURRENT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPAST         LD      HL, (CLIPLEN)
                LD      A, H
                OR      L
                RET     Z               ; CLIPBOARD EMPTY

                ; IF ACTIVE SELECTION, DELETE IT FIRST -- IT PAINTS ITSELF,
                ; SO THE SNAPSHOT BELOW HAS TO COME AFTER IT
                LD      A, (SELACT)
                OR      A
                JR      Z, .PSTINIT
                CALL    ACTDLS

.PSTINIT        LD      A, (CURY)
                LD      (PSTROW), A
                LD      HL, (TOPLINE)
                LD      (PSTTOP), HL
                LD      HL, (TOTLINES)
                LD      (PSTTOT), HL

                LD      HL, (CLIPLEN)
                LD      (CPYCNT), HL
                LD      HL, CLIPBUF
                LD      (CLIPRD), HL

                LD      A, #FF
                LD      (RNDHOLD), A    ; ONE REPAINT, AT THE END

.PSTLP          LD      HL, (CPYCNT)
                LD      A, H
                OR      L
                JP      Z, .PSTDONE

                LD      HL, (CLIPRD)
                LD      A, (HL)
                CP      #0D
                JR      Z, .PSTCR
                CP      #0A
                JR      Z, .PSTLF
                CALL    PSTOK
                JR      C, .PSTRUN

                ; IGNORED CONTROL BYTE: DROP IT AND CARRY ON
                CALL    PSTADV
                JR      .PSTLP

.PSTCR          CALL    PSTADV
                CALL    PSTNL
                JP      C, .PSTDONE     ; NO ROOM FOR ANOTHER LINE: STOP HERE

                ; A CRLF PAIR IS ONE BREAK: SWALLOW A FOLLOWING LF
                LD      HL, (CPYCNT)
                LD      A, H
                OR      L
                JP      Z, .PSTDONE
                LD      HL, (CLIPRD)
                LD      A, (HL)
                CP      #0A
                JR      NZ, .PSTLP
                CALL    PSTADV
                JR      .PSTLP

.PSTLF          CALL    PSTADV
                CALL    PSTNL
                JR      C, .PSTDONE
                JR      .PSTLP

.PSTRUN         ; MEASURE THE RUN: CONSECUTIVE INSERTABLE BYTES, NEVER MORE
                ; THAN ONE LINE'S WORTH
                LD      HL, (CLIPRD)
                LD      DE, (CPYCNT)
                LD      B, 0
.PSTSCAN        LD      A, D
                OR      E
                JR      Z, .PSTGOT      ; CLIPBOARD EXHAUSTED
                LD      A, B
                CP      TEXTCOLS
                JR      Z, .PSTGOT
                LD      A, (HL)
                CALL    PSTOK
                JR      NC, .PSTGOT
                INC     HL
                DEC     DE
                INC     B
                JR      .PSTSCAN

.PSTGOT         LD      A, B
                LD      (PSTRUN), A
                LD      HL, (CLIPRD)
                CALL    EDINSRUN
                JR      C, .PSTSLOW     ; A NOW HOLDS THE ROOM, NOT THE RUN

                ; THE WHOLE RUN WENT IN: CONSUME IT
                LD      A, (PSTRUN)
                LD      C, A
                LD      B, 0
                LD      HL, (CLIPRD)
                ADD     HL, BC
                LD      (CLIPRD), HL
                LD      HL, (CPYCNT)
                OR      A
                SBC     HL, BC
                LD      (CPYCNT), HL
                JP      .PSTLP

.PSTSLOW        ; THE RUN OVERFLOWS THE LINE, AND A HOLDS HOW MUCH OF IT WOULD
                ; STILL GO IN. TAKE THAT MUCH AS A BATCH, THEN COME BACK ROUND
                ; FOR THE CHARACTER THAT WILL NOT FIT.
                OR      A
                JR      Z, .PSTONE      ; THE LINE IS ALREADY FULL
                LD      (PSTRUN), A
                LD      B, A
                LD      HL, (CLIPRD)
                CALL    EDINSRUN
                JR      C, .PSTONE      ; REFUSED AGAIN: FALL BACK
                LD      A, (PSTRUN)
                LD      C, A
                LD      B, 0
                LD      HL, (CLIPRD)
                ADD     HL, BC
                LD      (CLIPRD), HL
                LD      HL, (CPYCNT)
                OR      A
                SBC     HL, BC
                LD      (CPYCNT), HL
                JP      .PSTLP

.PSTONE         ; ONE CHARACTER THAT DOES NOT FIT. WHAT HAPPENS TO IT IS THE
                ; WRAP MODE'S DECISION -- CLAMP IN WRAP_DEV, PUSH THE TRAILING
                ; WORD DOWN IN WRAP_TXT -- AND ONLY EDINSCHR KNOWS THOSE RULES.
                ; AFTER A PUSH WRAP THE NEXT PASS FINDS A NEARLY EMPTY LINE AND
                ; USUALLY SWALLOWS THE REST OF THE RUN IN ONE GO.
                LD      HL, (CLIPRD)
                LD      A, (HL)
                CP      #09
                JR      NZ, .PSTSCHR
                LD      A, ' '
.PSTSCHR        CALL    EDINSCHR
                CALL    PSTADV
                JP      .PSTLP

.PSTDONE        XOR     A
                LD      (RNDHOLD), A
                CALL    SETCURY         ; CURY = DOCLINE - TOPLINE, ALWAYS

                ; DID THE VIEWPORT MOVE? THEN EVERY ROW SHOWS SOMETHING ELSE
                LD      HL, (TOPLINE)
                LD      DE, (PSTTOP)
                OR      A
                SBC     HL, DE
                JR      NZ, .PSTALL

                ; HOW MANY LINES APPEARED?
                LD      HL, (TOTLINES)
                LD      DE, (PSTTOT)
                OR      A
                SBC     HL, DE
                LD      A, H
                OR      A
                JR      NZ, .PSTALL     ; MORE THAN 255: NOT WORTH BEING CLEVER
                LD      A, L
                OR      A
                JR      NZ, .PSTMANY

                ; NOTHING MOVED: EXACTLY ONE ROW CHANGED. THE LINE NUMBERS AND
                ; THE SCROLLBAR THUMB CANNOT HAVE MOVED EITHER.
                LD      A, (PSTROW)
                INC     A
                LD      B, A
                CALL    RENDEROW
                JP      DRWSTAT

.PSTMANY        ; L = LINES ADDED. THE UNTOUCHED TAIL OF THE SCREEN SLIDES DOWN
                ; BY THAT MANY ROWS IN ONE BLIT, THEN THE NEW ROWS ARE PAINTED.
                LD      A, (PSTROW)
                INC     A               ; A = FIRST ROW THAT CHANGED (1..24)
                LD      B, A
                LD      C, L            ; C = ROWS ADDED
                ADD     A, C            ; A = LAST ROW TO PAINT
                CP      TXRLAST
                JR      NC, .PSTTAIL    ; REACHES THE BOTTOM: NOTHING SURVIVES

                PUSH    AF              ; SAVE THE LAST ROW TO PAINT
                INC     B               ; FIRST ROW THAT ONLY MOVES DOWN
                CALL    SHIFTDNN
                POP     AF
                LD      C, A
                LD      A, (PSTROW)
                INC     A
                LD      B, A
                JR      .PSTPLP

.PSTTAIL        LD      C, TXRLAST
                LD      A, (PSTROW)
                INC     A
                LD      B, A

.PSTPLP         PUSH    BC
                CALL    RENDEROW
                POP     BC
                LD      A, B
                CP      C
                JR      NC, .PSTBARS
                INC     B
                JR      .PSTPLP

.PSTALL         CALL    REDRAW

.PSTBARS        JP      DRWSTAT


; --- PSTOK                     ----------------------------------------


; - PSTOK ------------------------------
; - IS THIS CLIPBOARD BYTE ONE THE EDITOR CAN INSERT?
; - TAB COUNTS: WBINSN AND THE SLOW PATH BOTH TURN IT INTO A SPACE.
; - IN:  A = BYTE
; - OUT: CY = 1  INSERTABLE
; - CLOBBERS: F
; -

PSTOK           CP      #09
                JR      Z, .POYES       ; TAB
                CP      #20
                JR      C, .PONO        ; CONTROL CODE
                CP      #7F
                JR      Z, .PONO        ; DEL
                CP      #FF
                JR      Z, .PONO        ; SENTINEL
.POYES          SCF
                RET

.PONO           OR      A               ; CY = 0
                RET


; --- PSTADV                    ----------------------------------------


; - PSTADV -----------------------------
; - STEP THE CLIPBOARD READ CURSOR ON BY ONE BYTE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: HL
; -

PSTADV          LD      HL, (CLIPRD)
                INC     HL
                LD      (CLIPRD), HL
                LD      HL, (CPYCNT)
                DEC     HL
                LD      (CPYCNT), HL
                RET


; --- PSTNL                     ----------------------------------------


; - PSTNL ------------------------------
; - BREAK THE LINE DURING A PASTE
; - EDNWLIN REFUSES SILENTLY WHEN THE DIRECTORY IS FULL OR THE MAPPER HAS
; - NOTHING LEFT, SO CHECK THE LINE COUNT AND STOP THE PASTE RATHER THAN
; - PILING THE REST OF THE CLIPBOARD ONTO ONE LINE.
; - IN:  NONE
; - OUT: CY = 1  THE BREAK DID NOT HAPPEN
; - CLOBBERS: ALL
; -

PSTNL           LD      HL, (TOTLINES)
                PUSH    HL
                CALL    EDNWLIN
                POP     DE
                LD      HL, (TOTLINES)
                LD      A, H
                CP      D
                JR      NZ, .PNOK
                LD      A, L
                CP      E
                JR      NZ, .PNOK
                SCF                     ; UNCHANGED: REFUSED
                RET

.PNOK           OR      A               ; CY = 0
                RET


; --- ACTTGLBD                  ----------------------------------------


; - ACTTGLBD ---------------------------
; - TOGGLE BOLD ATTRIBUTE ON SELECTION OR TYPING STATE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLBD        LD      A, (MKUPMD)
                OR      A
                JR      Z, .RAWBD       ; MKUP_OFF: RAW ATTRIBUTE TOGGLE
                ; MARKUP MODE (MD OR LITE)
                LD      A, (SELACT)
                OR      A
                JR      NZ, .WRPBD
                LD      A, 1            ; 1 = BOLD
                JP      INSDELIM
.WRPBD          LD      A, 1            ; 1 = BOLD
                JP      WRAPSEL

.RAWBD          LD      A, (SELACT)
                OR      A
                JR      NZ, .SELBD
                ; NO SELECTION: TOGGLE TYPING ATTRIBUTE
                LD      A, (TYPATTR)
                XOR     ATRBOLD
                LD      (TYPATTR), A
                CALL    DRWSTAT
                RET
.SELBD          LD      A, ATRBOLD
                CALL    APPLSEL
                RET


; --- ACTTGLIT                  ----------------------------------------


; - ACTTGLIT ---------------------------
; - TOGGLE ITALIC ATTRIBUTE ON SELECTION OR TYPING STATE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLIT        LD      A, (MKUPMD)
                OR      A
                JR      Z, .RAWIT       ; MKUP_OFF: RAW ATTRIBUTE TOGGLE
                ; MARKUP MODE (MD OR LITE)
                LD      A, (SELACT)
                OR      A
                JR      NZ, .WRPIT
                LD      A, 2            ; 2 = ITALIC
                JP      INSDELIM
.WRPIT          LD      A, 2            ; 2 = ITALIC
                JP      WRAPSEL

.RAWIT          LD      A, (SELACT)
                OR      A
                JR      NZ, .SELIT
                ; NO SELECTION: TOGGLE TYPING ATTRIBUTE
                LD      A, (TYPATTR)
                XOR     ATRITAL
                LD      (TYPATTR), A
                CALL    DRWSTAT
                RET
.SELIT          LD      A, ATRITAL
                CALL    APPLSEL
                RET


; --- APPLSEL                   ----------------------------------------


; - APPLSEL ----------------------------
; - TOGGLE ATTRIBUTE BITS ACROSS ACTIVE SELECTION
; - IN:  A = ATTRIBUTE MASK TO TOGGLE (ATRBOLD OR ATRITAL)
; - OUT: NONE
; - CLOBBERS: ALL
; -

APPLSEL         LD      (STYLMASK), A
                CALL    SELNORM

                ; VERIFY SELECTION IS NOT EMPTY
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .APLINIT
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET     Z               ; EMPTY: NOTHING TO STYLE

.APLINIT        LD      HL, (SELSTRL)
                LD      (STYLLN), HL

.APLLINE        ; READ CURRENT LINE RECORD INTO WORKBUF
                LD      HL, (STYLLN)
                CALL    LINEREAD

                ; DETERMINE XA FOR THIS LINE
                LD      HL, (STYLLN)
                LD      DE, (SELSTRL)
                CALL    CMPHLDE
                JR      NZ, .APLMIDL
                LD      A, (SELSTRX)
                JR      .APLSETX
.APLMIDL        XOR     A
.APLSETX        LD      (STYLXA), A

                ; DETERMINE XB FOR THIS LINE
                LD      A, (WORKBUF)
                LD      (STYLXB), A     ; DEFAULT XB = LINE LENGTH
                LD      HL, (STYLLN)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .APLNEND
                LD      A, (SELENDX)
                LD      (STYLXB), A
.APLNEND        ; CLAMP XB TO LINE LENGTH
                LD      A, (WORKBUF)
                LD      HL, STYLXB
                CP      (HL)
                JR      NC, .APLXBOK
                LD      (STYLXB), A

.APLXBOK        ; CHECK IF XA < XB
                LD      A, (STYLXA)
                LD      HL, STYLXB
                CP      (HL)
                JR      NC, .APLCHKN    ; NO CHARS ON THIS LINE

                ; COUNT = XB - XA
                SUB     (HL)
                NEG                     ; A = COUNT
                LD      B, A            ; B = COUNT (1..80)

                LD      A, (STYLXA)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1 + TEXTCOLS
                ADD     HL, DE          ; HL = WORKBUF + 1 + TEXTCOLS + XA
                LD      A, (STYLMASK)
                LD      C, A            ; C = MASK TO TOGGLE

.APLCELL        LD      A, (HL)
                XOR     C
                LD      (HL), A
                INC     HL
                DJNZ    .APLCELL

                ; WRITE LINE BACK TO MAPPER
                LD      HL, (STYLLN)
                CALL    LINEWRT

                ; IF ON SCREEN, RE-RENDER ROW
                LD      HL, (STYLLN)
                LD      DE, (TOPLINE)
                OR      A
                SBC     HL, DE
                JR      C, .APLCHKN     ; L < TOPLINE: OFF SCREEN ABOVE
                LD      A, H
                OR      A
                JR      NZ, .APLCHKN    ; L - TOPLINE >= 256
                LD      A, L
                CP      SCRROWS         ; 24
                JR      NC, .APLCHKN    ; OFF SCREEN BELOW
                INC     A               ; SCREEN ROW = A + 1 (1..24)
                LD      B, A
                CALL    RENDEROW

.APLCHKN        ; CHECK IF LAST LINE
                LD      HL, (STYLLN)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      Z, .APLDONE

                ; NEXT LINE
                LD      HL, (STYLLN)
                INC     HL
                LD      (STYLLN), HL
                JP      .APLLINE

.APLDONE        ; REDRAW SELECTION XOR HIGHLIGHT OVER UPDATED ROWS
                CALL    SELPOST
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    DRWSTAT
                RET

