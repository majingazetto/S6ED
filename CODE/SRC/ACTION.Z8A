;                                       ****************************************
;                                       * ACTION                               *
;                                       ****************************************
;
; ATOMIC ACTION IMPLEMENTATIONS AND ACTION VECTOR TABLE (ACTTBL).
; ALL ACTIONS OPERATE ON SYSTEM AND EDITOR STATE (DOCLINE, CURX, WORKBUF, ETC.)


; --- ACTTBL                    ----------------------------------------


ACTTBL          DEFW    ACTNONE         ; 0
                DEFW    ACTMVL          ; 1
                DEFW    ACTMVR          ; 2
                DEFW    ACTMVU          ; 3
                DEFW    ACTMVD          ; 4
                DEFW    ACTBOL          ; 5
                DEFW    ACTEOL          ; 6
                DEFW    ACTTOP          ; 7
                DEFW    ACTBOT          ; 8
                DEFW    ACTWLFT         ; 9
                DEFW    ACTWRGT         ; 10
                DEFW    ACTDWLFT        ; 11
                DEFW    ACTPGUP         ; 12
                DEFW    ACTPGDN         ; 13
                DEFW    ACTDELBK        ; 14
                DEFW    ACTDELFW        ; 15
                DEFW    ACTDELLN        ; 16
                DEFW    ACTNWLIN        ; 17
                DEFW    ACTOPNBL        ; 18
                DEFW    ACTOPNAB        ; 19
                DEFW    ACTTGLIN        ; 20
                DEFW    ACTTGLWR        ; 21
                DEFW    ACTSAVE         ; 22
                DEFW    ACTQUIT         ; 23
                DEFW    ACTHELP         ; 24
                DEFW    ACTCYCKM        ; 25
                DEFW    ACTVIINS        ; 26
                DEFW    ACTVIAPP        ; 27
                DEFW    ACTVINRM        ; 28
                DEFW    ACTVILED        ; 29
                DEFW    ACTSLML         ; 30
                DEFW    ACTSLMR         ; 31
                DEFW    ACTSLMU         ; 32
                DEFW    ACTSLMD         ; 33
                DEFW    ACTSLBOL        ; 34
                DEFW    ACTSLEOL        ; 35
                DEFW    ACTSLTOP        ; 36
                DEFW    ACTSLBOT        ; 37
                DEFW    ACTSLWLF        ; 38
                DEFW    ACTSLWRT        ; 39
                DEFW    ACTSLPGU        ; 40
                DEFW    ACTSLPGD        ; 41
                DEFW    ACTSELAL        ; 42
                DEFW    ACTDSEL         ; 43
                DEFW    ACTDLS          ; 44


; --- ACTNONE                   ----------------------------------------


; - ACTNONE ----------------------------
; - NO OPERATION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

ACTNONE         RET


; --- CHKUNSEL                  ----------------------------------------


; - CHKUNSEL ---------------------------
; - CANCEL SELECTION IF SHIFT IS NOT HELD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

CHKUNSEL        LD      A, (MODKEYS)
                AND     MODSHFT
                RET     NZ              ; SHIFT PRESSED: PRESERVE SELECTION
                LD      A, (SELACT)
                OR      A
                RET     Z               ; NO SELECTION ACTIVE
                JP      ACTDSEL


; --- ACTMVL                    ----------------------------------------


; - ACTMVL -----------------------------
; - MOVE CURSOR LEFT ONE COLUMN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVL          CALL    CHKUNSEL
                LD      A, CLEFT
                CALL    EDMOVCHR
                RET


; --- ACTMVR                    ----------------------------------------


; - ACTMVR -----------------------------
; - MOVE CURSOR RIGHT ONE COLUMN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVR          CALL    CHKUNSEL
                LD      A, CRIGHT
                CALL    EDMOVCHR
                RET


; --- ACTMVU                    ----------------------------------------


; - ACTMVU -----------------------------
; - MOVE CURSOR UP ONE ROW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVU          CALL    CHKUNSEL
                LD      A, CUP
                CALL    EDMOVROW
                RET


; --- ACTMVD                    ----------------------------------------


; - ACTMVD -----------------------------
; - MOVE CURSOR DOWN ONE ROW
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTMVD          CALL    CHKUNSEL
                LD      A, CDOWN
                CALL    EDMOVROW
                RET


; --- ACTBOL                    ----------------------------------------


; - ACTBOL -----------------------------
; - MOVE CURSOR TO BEGINNING OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTBOL          CALL    CHKUNSEL
                XOR     A
                LD      (CURX), A
                RET


; --- ACTEOL                    ----------------------------------------


; - ACTEOL -----------------------------
; - MOVE CURSOR TO END OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTEOL          CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                CP      TEXTCOLS
                JR      C, .EOLSET
                LD      A, TEXTCOLS - 1
.EOLSET         LD      (CURX), A
                RET


; --- ACTTOP                    ----------------------------------------


; - ACTTOP -----------------------------
; - MOVE CURSOR TO TOP OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTOP          CALL    CHKUNSEL
                LD      HL, 0
                LD      (DOCLINE), HL
                LD      (TOPLINE), HL
                XOR     A
                LD      (CURX), A
                LD      (CURY), A
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL
                RET


; --- ACTBOT                    ----------------------------------------


; - ACTBOT -----------------------------
; - MOVE CURSOR TO BOTTOM OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTBOT          CALL    CHKUNSEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (DOCLINE), HL
                LD      DE, SCRROWS
                CALL    CMPHLDE
                JR      C, .SHORTDOC
                LD      HL, (TOTLINES)
                LD      DE, SCRROWS
                OR      A
                SBC     HL, DE
                LD      (TOPLINE), HL
                LD      A, SCRROWS - 1
                LD      (CURY), A
                JR      .REDBOT
.SHORTDOC       LD      HL, 0
                LD      (TOPLINE), HL
                LD      A, (DOCLINE)
                LD      (CURY), A
.REDBOT         XOR     A
                LD      (CURX), A
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL
                RET


; --- ACTWLFT                   ----------------------------------------


; - ACTWLFT ----------------------------
; - MOVE CURSOR TO START OF PREV WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTWLFT         CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (CURX)
                OR      A
                RET     Z
                DEC     A
                LD      B, A            ; B = SCAN COLUMN

                ; 1. SKIP SPACES TO THE LEFT
.WLSKPSPC       LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      NZ, .WLSKPW
                LD      A, B
                OR      A
                JR      Z, .WLBOL
                DEC     B
                JR      .WLSKPSPC

                ; 2. SCAN WORD CHARACTERS TO FIND START
.WLSKPW         LD      E, B
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WLFND
                LD      A, B
                OR      A
                JR      Z, .WLBOL
                DEC     B
                JR      .WLSKPW

.WLFND          INC     B
                LD      A, B
                LD      (CURX), A
                RET

.WLBOL          XOR     A
                LD      (CURX), A
                RET


; --- ACTWRGT                   ----------------------------------------


; - ACTWRGT ----------------------------
; - MOVE CURSOR TO START OF NEXT WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTWRGT         CALL    CHKUNSEL
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                LD      A, (WORKBUF)
                LD      C, A            ; C = LENGTH
                LD      A, (CURX)
                CP      C
                RET     NC
.WRSKPNON       INC     A
                CP      C
                JR      NC, .WREOL
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WRSKPSPC
                LD      A, E
                JR      .WRSKPNON
.WRSKPSPC       INC     E
                LD      A, E
                CP      C
                JR      NC, .WREOL
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)
                CP      ' '
                JR      Z, .WRSKPSPC
                LD      A, E
                LD      (CURX), A
                RET
.WREOL          LD      A, C
                CP      TEXTCOLS
                JR      C, .WRSET
                LD      A, TEXTCOLS - 1
.WRSET          LD      (CURX), A
                RET


; --- ACTDWLFT                  ----------------------------------------


; - ACTDWLFT ---------------------------
; - DELETE ENTIRE PREVIOUS WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDWLFT        LD      A, (CURX)
                OR      A
                RET     Z
                LD      (DWFROM), A
                CALL    ACTWLFT
                LD      A, (CURX)
                LD      (DWTO), A
                LD      A, (DWFROM)
                LD      (CURX), A       ; RESTORE CURX
                LD      HL, DWTO
                SUB     (HL)            ; A = DWFROM - DWTO = K
                RET     Z               ; DELTA IS ZERO, NOTHING TO DELETE
                LD      (DWK), A

                ; 1. SHIFT TEXT (WORKBUF + 1)
                ; DEST = WORKBUF + 1 + DWTO
                ; SRC  = WORKBUF + 1 + DWFROM
                ; COUNT = TEXTCOLS - DWFROM
                LD      A, (DWTO)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST

                LD      A, (DWFROM)
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 1
                ADD     HL, BC          ; HL = SRC

                LD      A, (DWFROM)
                LD      C, A
                LD      A, TEXTCOLS     ; 80
                SUB     C               ; A = 80 - DWFROM
                JR      Z, .NOSHFTT
                LD      C, A
                LD      B, 0            ; BC = COUNT
                LDIR

.NOSHFTT        ; 2. SHIFT ATTRIBUTES (WORKBUF + 81)
                LD      A, (DWTO)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST

                LD      A, (DWFROM)
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 81
                ADD     HL, BC          ; HL = SRC

                LD      A, (DWFROM)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                JR      Z, .NOSHFTA
                LD      C, A
                LD      B, 0
                LDIR

.NOSHFTA        ; 3. CLEAR VACATED TAIL IN TEXT (K BYTES AT 80 - K)
                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C               ; A = 80 - K
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      B, C            ; B = K
.BLKTXT         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT

                ; 4. CLEAR VACATED TAIL IN ATTRS (K BYTES AT 80 - K)
                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                LD      B, C
.BLKATR         LD      (HL), 0
                INC     HL
                DJNZ    .BLKATR

                ; 5. UPDATE LINE LENGTH
                LD      HL, WORKBUF
                LD      E, (HL)         ; E = CURRENT LENGTH
                LD      A, (DWTO)
                LD      B, A            ; B = DWTO
                LD      A, (DWFROM)
                LD      C, A            ; C = DWFROM
                LD      A, E
                CP      B
                JR      C, .DONELEN     ; LEN < DWTO: UNCHANGED
                JR      Z, .DONELEN     ; LEN == DWTO: UNCHANGED
                CP      C
                JR      C, .SETTO       ; LEN < DWFROM: NEW LEN = DWTO
                JR      Z, .SETTO       ; LEN == DWFROM: NEW LEN = DWTO
                ; LEN > DWFROM: NEW LEN = LEN - K
                LD      A, (DWK)
                LD      D, A
                LD      A, E
                SUB     D               ; A = LEN - K
                LD      (HL), A
                JR      .DONELEN

.SETTO          LD      (HL), B

.DONELEN        ; 6. SET CURX TO DWTO
                LD      A, (DWTO)
                LD      (CURX), A

                ; 7. WRITE TO MAPPER & RENDER ROW ONCE
                LD      HL, (DOCLINE)
                CALL    LINEWRT

                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW

                LD      A, #FF
                LD      (MODIFIED), A
                CALL    DRWSTAT
                RET


; --- ACTPGUP                   ----------------------------------------


; - ACTPGUP ----------------------------
; - SCROLL UP ONE PAGE (24 ROWS)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPGUP         CALL    CHKUNSEL
                LD      HL, (TOPLINE)
                LD      A, H
                OR      L
                JR      Z, .PGUTOP
                LD      DE, SCRROWS
                OR      A
                SBC     HL, DE
                JR      NC, .PGUSET
                LD      HL, 0
.PGUSET         LD      (TOPLINE), HL
                LD      HL, (DOCLINE)
                OR      A
                SBC     HL, DE
                JR      NC, .PGUDOC
                LD      HL, 0
.PGUDOC         LD      (DOCLINE), HL
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL
                RET
.PGUTOP         XOR     A
                LD      (CURY), A
                LD      HL, 0
                LD      (DOCLINE), HL
                RET


; --- ACTPGDN                   ----------------------------------------


; - ACTPGDN ----------------------------
; - SCROLL DOWN ONE PAGE (24 ROWS)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTPGDN         CALL    CHKUNSEL
                LD      HL, (TOPLINE)
                LD      DE, SCRROWS
                ADD     HL, DE
                EX      DE, HL          ; DE = TARGET TOP
                LD      HL, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .PGDBOT
                JR      Z, .PGDBOT
                EX      DE, HL
                LD      (TOPLINE), HL
                LD      HL, (DOCLINE)
                LD      DE, SCRROWS
                ADD     HL, DE
                LD      (DOCLINE), HL
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL
                RET
.PGDBOT         JP      ACTBOT


; --- ACTDELBK                  ----------------------------------------


; - ACTDELBK ---------------------------
; - DELETE CHARACTER BEFORE CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELBK        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTDLS
                CALL    EDDELBK
                RET


; --- ACTDELFW                  ----------------------------------------


; - ACTDELFW ---------------------------
; - DELETE CHARACTER AT CURSOR
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELFW        LD      A, (SELACT)
                OR      A
                JP      NZ, ACTDLS
                CALL    EDDELCHR
                RET


; --- ACTDELLN                  ----------------------------------------


; - ACTDELLN ---------------------------
; - DELETE ENTIRE CURRENT LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDELLN        LD      HL, (TOTLINES)
                LD      A, H
                OR      L
                RET     Z
                LD      DE, 1
                CALL    CMPHLDE
                JR      NZ, .DLMULT
                ; SINGLE LINE LEFT: CLEAR RECORD TO SPACES
                LD      HL, (DOCLINE)
                CALL    LINEREAD
                XOR     A
                LD      (WORKBUF), A
                LD      HL, WORKBUF + 1
                LD      (HL), ' '
                LD      DE, WORKBUF + 2
                LD      BC, TEXTCOLS - 1
                LDIR
                LD      HL, (DOCLINE)
                CALL    LINEWRT
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                XOR     A
                LD      (CURX), A
                LD      A, #FF
                LD      (MODIFIED), A
                RET
.DLMULT         LD      HL, (DOCLINE)
                CALL    LINEDEL
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                LD      HL, (DOCLINE)
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .DLOK
                DEC     HL
                LD      (DOCLINE), HL
.DLOK           CALL    SETCURY
                XOR     A
                LD      (CURX), A
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL
                LD      A, #FF
                LD      (MODIFIED), A
                RET


; --- ACTNWLIN                  ----------------------------------------


; - ACTNWLIN ---------------------------
; - SPLIT LINE AND INSERT NEWLINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTNWLIN        CALL    EDNWLIN
                RET


; --- ACTOPNBL                  ----------------------------------------


; - ACTOPNBL ---------------------------
; - OPEN NEW EMPTY LINE BELOW (VI LOWERCASE 'O')
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPNBL        CALL    ACTEOL
                CALL    EDNWLIN
                CALL    ACTVIINS
                RET


; --- ACTOPNAB                  ----------------------------------------


; - ACTOPNAB ---------------------------
; - OPEN NEW EMPTY LINE ABOVE (VI O)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTOPNAB        CALL    ACTBOL
                CALL    EDNWLIN
                LD      A, CUP
                CALL    EDMOVROW
                CALL    ACTVIINS
                RET


; --- ACTTGLIN                  ----------------------------------------


; - ACTTGLIN ---------------------------
; - TOGGLE INSERT / OVERWRITE MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTTGLIN        LD      A, (INSMODE)
                XOR     INS_MODE
                LD      (INSMODE), A
                CALL    DRWSTAT
                RET


; --- ACTTGLWR                  ----------------------------------------


; - ACTTGLWR ---------------------------
; - TOGGLE DEVELOPER / TEXT WRAP MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTTGLWR        CALL    EDTGLWRP
                CALL    DRWSTAT
                RET


; --- ACTSAVE                   ----------------------------------------


; - ACTSAVE ----------------------------
; - SAVE DOCUMENT TO DISK
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSAVE         CALL    FILESAVE
                CALL    DRWSTAT
                RET


; --- ACTQUIT                   ----------------------------------------


; - ACTQUIT ----------------------------
; - EXIT EDITOR TO DOS
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTQUIT         LD      A, (SELACT)
                OR      A
                JR      Z, .DOQUIT
                JP      ACTDSEL
.DOQUIT         JP      TERM


; --- ACTHELP                   ----------------------------------------


; - ACTHELP ----------------------------
; - DISPLAY HELP SCREEN STUB
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: NONE
; -

ACTHELP         RET


; --- ACTCYCKM                  ----------------------------------------


; - ACTCYCKM ---------------------------
; - CYCLE ACTIVE KEYMAP PROFILE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTCYCKM        CALL    KMAPCYC
                RET


; --- ACTVIINS                  ----------------------------------------


; - ACTVIINS ---------------------------
; - SWITCH VI TO INSERT MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIINS        LD      A, VIMINS
                LD      (VIMODE), A
                LD      HL, KMAPVII
                LD      (KMAPPTR), HL
                CALL    DRWSTAT
                RET


; --- ACTVIAPP                  ----------------------------------------


; - ACTVIAPP ---------------------------
; - ADVANCE AND SWITCH VI TO INSERT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVIAPP        LD      A, CRIGHT
                CALL    EDMOVCHR
                CALL    ACTVIINS
                RET


; --- ACTVINRM                  ----------------------------------------


; - ACTVINRM ---------------------------
; - SWITCH VI TO NORMAL MODE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTVINRM        LD      A, VIMNORM
                LD      (VIMODE), A
                LD      HL, KMAPVIN
                LD      (KMAPPTR), HL
                LD      A, (CURX)
                OR      A
                JR      Z, .VINORM0
                DEC     A
                LD      (CURX), A
.VINORM0        CALL    DRWSTAT
                RET


; --- ACTVILED                  ----------------------------------------


; - ACTVILED ---------------------------
; - SET VI DELETE LEADER PENDING
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

ACTVILED        LD      A, 'd'
                LD      (VILEAD), A
                RET


; --- SELBEG                    ----------------------------------------


; - SELBEG -----------------------------
; - INITIALIZE SELECTION ANCHOR IF INACTIVE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

SELBEG          LD      A, (SELACT)
                OR      A
                RET     NZ              ; ALREADY ACTIVE
                LD      A, 1
                LD      (SELACT), A
                LD      A, (CURX)
                LD      (SELANCX), A
                LD      HL, (DOCLINE)
                LD      (SELANCL), HL
                RET


; --- SELPRE                    ----------------------------------------


; - SELPRE -----------------------------
; - UN-XOR CURRENTLY PAINTED SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPRE          LD      A, (SELDRAWN)
                OR      A
                RET     Z
                LD      HL, DRWSTRL
                LD      DE, SELSTRL
                LD      BC, 6
                LDIR
                CALL    SELPAIN         ; UN-XOR INVERT
                XOR     A
                LD      (SELDRAWN), A
                RET


; --- SELPOST                   ----------------------------------------


; - SELPOST ----------------------------
; - NORMALIZE AND XOR-PAINT NEW SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPOST         CALL    SELNORM
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .PNTNEW
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                RET     Z               ; EMPTY: DO NOT PAINT
.PNTNEW         CALL    SELPAIN         ; XOR INVERT
                LD      HL, SELSTRL
                LD      DE, DRWSTRL
                LD      BC, 6
                LDIR
                LD      A, 1
                LD      (SELDRAWN), A
                CALL    DRWSTAT
                RET


; --- SELNORM                   ----------------------------------------


; - SELNORM ----------------------------
; - NORMALIZE ANCHOR AND CURSOR TO START/END
; - IN:  NONE
; - OUT: SELSTRL, SELSTRX, SELENDL, SELENDX
; - CLOBBERS: AF, DE, HL
; -

SELNORM         LD      HL, (DOCLINE)
                LD      DE, (SELANCL)
                CALL    CMPHLDE
                JR      C, .NCURFST     ; DOCLINE < SELANCL
                JR      NZ, .NANCFST    ; DOCLINE > SELANCL
                LD      A, (CURX)
                LD      HL, SELANCX
                CP      (HL)
                JR      C, .NCURFST
.NANCFST        LD      HL, (SELANCL)
                LD      (SELSTRL), HL
                LD      A, (SELANCX)
                LD      (SELSTRX), A
                LD      HL, (DOCLINE)
                LD      (SELENDL), HL
                LD      A, (CURX)
                LD      (SELENDX), A
                RET

.NCURFST        LD      HL, (DOCLINE)
                LD      (SELSTRL), HL
                LD      A, (CURX)
                LD      (SELSTRX), A
                LD      HL, (SELANCL)
                LD      (SELENDL), HL
                LD      A, (SELANCX)
                LD      (SELENDX), A
                RET


; --- SELPAIN                   ----------------------------------------


; - SELPAIN ----------------------------
; - XOR-INVERT VISIBLE ROWS IN SELSTRL..SELENDL
; - IN:  SELSTRL, SELSTRX, SELENDL, SELENDX
; - OUT: NONE
; - CLOBBERS: ALL
; -

SELPAIN         LD      B, 0            ; B = SCREEN ROW INDEX (0..23)
.ROWLP          PUSH    BC
                ; CALC DOC LINE L = TOPLINE + B
                LD      HL, (TOPLINE)
                LD      E, B
                LD      D, 0
                ADD     HL, DE          ; HL = L
                LD      (SELTMPL), HL

                ; 1. CHECK IF L < SELSTRL
                LD      DE, (SELSTRL)
                CALL    CMPHLDE
                JP      C, .NEXTROW     ; L < START: OUTSIDE

                ; 2. CHECK IF L > SELENDL
                LD      HL, (SELTMPL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .NOTEQ
                JR      .CHKCOLS        ; L == END
.NOTEQ          JP      NC, .DONEPAIN   ; L > END: PAST SELECTION, STOP

.CHKCOLS        ; L IS WITHIN SELECTION [SELSTRL, SELENDL]
                ; DETERMINE XA
                LD      HL, (SELTMPL)
                LD      DE, (SELSTRL)
                CALL    CMPHLDE
                JR      NZ, .NOTSTRT
                ; L == START: XA = SELSTRX
                LD      A, (SELSTRX)
                JR      .SETXA
.NOTSTRT        ; L > START: XA = 0
                XOR     A
.SETXA          LD      (SELTMPXA), A

                ; DETERMINE XB
                LD      HL, (SELTMPL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .NOTEND
                ; L == END: XB = SELENDX
                LD      A, (SELENDX)
                JR      .SETXB
.NOTEND         ; L < END: XB = MIN(LINE_LEN + 1, 80)
                LD      HL, (SELTMPL)
                CALL    DIRREAD         ; A = SEG, DE = OFFSET
                LD      C, A
                LD      A, (TXSEG)
                CP      C
                JR      Z, .HAVSEG
                LD      A, C
                LD      (TXSEG), A
                CALL    PUTP2
.HAVSEG         LD      HL, TXPAGE
                ADD     HL, DE
                LD      A, (HL)         ; A = LINE LEN
                OR      A
                JR      NZ, .NONEMP
                LD      A, 1            ; EMPTY LINE: 1 CHAR BLOCK
                JR      .SETXB
.NONEMP         INC     A               ; INCLUDE TRAILING CHAR
                CP      TEXTCOLS
                JR      C, .SETXB
                LD      A, TEXTCOLS
.SETXB          LD      (SELTMPXB), A

                ; CHECK IF XA < XB
                LD      A, (SELTMPXA)
                LD      HL, SELTMPXB
                CP      (HL)
                JP      NC, .NEXTROW    ; XA >= XB: NOTHING ON THIS ROW

                ; ISSUE LMMV | VDP_XOR
                POP     BC
                PUSH    BC              ; B = ROW (0..23)
                LD      A, (SELTMPXA)
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                LD      D, H
                LD      E, L
                ADD     HL, HL          ; * 4
                ADD     HL, DE          ; * 6
                LD      DE, GUTL_PX
                ADD     HL, DE
                LD      (VDP_DX), HL

                ; DY = (B + 1) * 8
                POP     BC
                PUSH    BC
                LD      A, B
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL

                ; NX = (XB - XA) * 6
                LD      A, (SELTMPXB)
                LD      HL, SELTMPXA
                SUB     (HL)            ; A = XB - XA
                LD      L, A
                LD      H, 0
                ADD     HL, HL
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                LD      (VDP_NX), HL

                ; NY = 8
                LD      HL, CELLH
                LD      (VDP_NY), HL

                ; CLR = COL_HI (3)
                LD      A, COL_HI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_XOR
                CALL    LMMV

.NEXTROW        POP     BC
                INC     B
                LD      A, B
                CP      SCRROWS         ; 24
                JP      C, .ROWLP
                RET

.DONEPAIN       POP     BC
                RET


; --- ACTDSEL                   ----------------------------------------


; - ACTDSEL ----------------------------
; - CANCEL ACTIVE SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDSEL         LD      A, (SELACT)
                OR      A
                RET     Z
                CALL    SELPRE          ; UN-XOR IF DRAWN
                XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                CALL    DRWSTAT
                RET


; --- ACTSELAL                  ----------------------------------------


; - ACTSELAL ---------------------------
; - SELECT ENTIRE DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSELAL        CALL    SELPRE          ; UN-XOR EXISTING IF DRAWN
                LD      HL, 0
                LD      (SELANCL), HL
                XOR     A
                LD      (SELANCX), A
                LD      A, 1
                LD      (SELACT), A

                ; MOVE CURSOR TO END OF LAST LINE
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (DOCLINE), HL
                CALL    LINEREAD
                LD      A, (WORKBUF)
                LD      (CURX), A

                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL
                CALL    SELPOST
                RET


; --- ACTSLML                   ----------------------------------------


; - ACTSLML ----------------------------
; - EXTEND SELECTION ONE CHAR LEFT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLML         CALL    SELBEG
                CALL    SELPRE
                CALL    ACTMVL
                JP      SELPOST


; --- ACTSLMR                   ----------------------------------------


; - ACTSLMR ----------------------------
; - EXTEND SELECTION ONE CHAR RIGHT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMR         CALL    SELBEG
                CALL    SELPRE
                CALL    ACTMVR
                JP      SELPOST


; --- ACTSLMU                   ----------------------------------------


; - ACTSLMU ----------------------------
; - EXTEND SELECTION ONE ROW UP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMU         CALL    SELBEG
                CALL    SELPRE
                CALL    ACTMVU
                JP      SELPOST


; --- ACTSLMD                   ----------------------------------------


; - ACTSLMD ----------------------------
; - EXTEND SELECTION ONE ROW DOWN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLMD         CALL    SELBEG
                CALL    SELPRE
                CALL    ACTMVD
                JP      SELPOST


; --- ACTSLBOL                  ----------------------------------------


; - ACTSLBOL ---------------------------
; - EXTEND SELECTION TO BEGINNING OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLBOL        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTBOL
                JP      SELPOST


; --- ACTSLEOL                  ----------------------------------------


; - ACTSLEOL ---------------------------
; - EXTEND SELECTION TO END OF LINE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLEOL        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTEOL
                JP      SELPOST


; --- ACTSLTOP                  ----------------------------------------


; - ACTSLTOP ---------------------------
; - EXTEND SELECTION TO TOP OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLTOP        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTTOP
                JP      SELPOST


; --- ACTSLBOT                  ----------------------------------------


; - ACTSLBOT ---------------------------
; - EXTEND SELECTION TO BOTTOM OF DOCUMENT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLBOT        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTBOT
                JP      SELPOST


; --- ACTSLWLF                  ----------------------------------------


; - ACTSLWLF ---------------------------
; - EXTEND SELECTION TO PREV WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLWLF        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTWLFT
                JP      SELPOST


; --- ACTSLWRT                  ----------------------------------------


; - ACTSLWRT ---------------------------
; - EXTEND SELECTION TO NEXT WORD
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLWRT        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTWRGT
                JP      SELPOST


; --- ACTSLPGU                  ----------------------------------------


; - ACTSLPGU ---------------------------
; - EXTEND SELECTION ONE PAGE UP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLPGU        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTPGUP
                JP      SELPOST


; --- ACTSLPGD                  ----------------------------------------


; - ACTSLPGD ---------------------------
; - EXTEND SELECTION ONE PAGE DOWN
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTSLPGD        CALL    SELBEG
                CALL    SELPRE
                CALL    ACTPGDN
                JP      SELPOST


; --- ACTDLS                    ----------------------------------------


; - ACTDLS -----------------------------
; - DELETE ACTIVE SELECTION
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTDLS          LD      A, (SELACT)
                OR      A
                RET     Z               ; NOTHING SELECTED
                CALL    SELPRE          ; UN-XOR VISIBLE OVERLAY
                CALL    SELNORM         ; NORMALIZE RANGE
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NZ, .DLSNOTEM
                LD      A, (SELSTRX)
                LD      HL, SELENDX
                CP      (HL)
                JP      Z, .DLSCLR      ; EMPTY RANGE: JUST CLEAR AND EXIT

.DLSNOTEM       ; CHECK SINGLE-LINE VS MULTI-LINE
                LD      HL, (SELSTRL)
                LD      DE, (SELENDL)
                CALL    CMPHLDE
                JP      NZ, .DLSMULT

                ; --- SINGLE LINE DELETION -----------------------------
                LD      HL, (SELSTRL)
                CALL    LINEREAD        ; READ LINE INTO WORKBUF

                LD      A, (SELSTRX)
                LD      B, A            ; B = STARTX
                LD      A, (SELENDX)
                LD      C, A            ; C = ENDX
                SUB     B               ; A = ENDX - STARTX = K
                JP      Z, .DLSCLR
                LD      (DWK), A        ; DWK = K

                ; 1. SHIFT TEXT
                LD      A, B
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST

                LD      A, C
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 1
                ADD     HL, BC          ; HL = SRC

                LD      A, (SELENDX)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C               ; A = 80 - ENDX
                JR      Z, .NOSHFT
                LD      C, A
                LD      B, 0
                LDIR

.NOSHFT         ; 2. SHIFT ATTRS
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                EX      DE, HL

                LD      A, (SELENDX)
                LD      L, A
                LD      H, 0
                LD      BC, WORKBUF + 81
                ADD     HL, BC

                LD      A, (SELENDX)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                JR      Z, .NOSHFTA
                LD      C, A
                LD      B, 0
                LDIR

.NOSHFTA        ; 3. BLANK VACATED TAIL
                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      B, C
.BLKTXT2        LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTXT2

                LD      A, (DWK)
                LD      C, A
                LD      A, TEXTCOLS
                SUB     C
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                LD      B, C
.BLKATR2        LD      (HL), 0
                INC     HL
                DJNZ    .BLKATR2

                ; 4. UPDATE LENGTH
                LD      HL, WORKBUF
                LD      E, (HL)         ; CURRENT LENGTH
                LD      A, (SELSTRX)
                LD      B, A            ; B = STARTX
                LD      A, (SELENDX)
                LD      C, A            ; C = ENDX
                LD      A, E
                CP      B
                JR      C, .DLSSETC     ; LEN < STARTX: UNCHANGED
                JR      Z, .DLSSETC     ; LEN == STARTX: UNCHANGED
                CP      C
                JR      C, .DLSSETT     ; LEN < ENDX: LEN = STARTX
                JR      Z, .DLSSETT
                LD      A, (DWK)
                LD      D, A
                LD      A, E
                SUB     D
                LD      (HL), A
                JR      .DLSSETC
.DLSSETT        LD      (HL), B

.DLSSETC        ; 5. WRITE LINE TO MAPPER
                LD      HL, (SELSTRL)
                CALL    LINEWRT

                ; 6. SET CURSOR POSITION
                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                LD      (DOCLINE), HL
                CALL    SETCURY

                ; 7. RENDER ROW
                LD      A, (CURY)
                INC     A
                LD      B, A
                CALL    RENDEROW
                JP      .DLSFIN

.DLSMULT        ; --- MULTI-LINE DELETION ------------------------------
                ; 1. READ END LINE INTO WORKBUF2
                LD      HL, (SELENDL)
                CALL    LINEREAD
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR

                ; 2. READ START LINE INTO WORKBUF
                LD      HL, (SELSTRL)
                CALL    LINEREAD

                ; 3. SPLICE TAIL OF WORKBUF2 (FROM ENDX TO LEN2) ONTO WORKBUF AT STARTX
                LD      A, (WORKBUF2)   ; LEN2
                LD      HL, SELENDX
                CP      (HL)
                JR      C, .NOTAIL
                JR      Z, .NOTAIL
                SUB     (HL)            ; A = M
                LD      C, A            ; C = M
                LD      A, (SELSTRX)
                ADD     A, C
                CP      TEXTCOLS + 1
                JR      C, .NOTRUNC
                LD      A, TEXTCOLS
                LD      HL, SELSTRX
                SUB     (HL)
                LD      C, A            ; C = CLAMPED M
.NOTRUNC        ; COPY TEXT TAIL
                LD      A, (SELENDX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF2 + 1
                ADD     HL, DE          ; HL = SRC
                PUSH    HL              ; SAVE SRC
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST
                POP     HL              ; HL = SRC
                PUSH    BC              ; SAVE M IN C
                LD      B, 0
                LDIR

                ; COPY ATTR TAIL
                LD      A, (SELENDX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF2 + 81
                ADD     HL, DE          ; HL = SRC ATTR
                PUSH    HL              ; SAVE SRC ATTR
                LD      A, (SELSTRX)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                EX      DE, HL          ; DE = DEST ATTR
                POP     HL              ; HL = SRC ATTR
                POP     BC              ; RESTORE M IN C
                PUSH    BC
                LD      B, 0
                LDIR
                POP     BC              ; C = M
                LD      A, (SELSTRX)
                ADD     A, C
                LD      (WORKBUF), A
                JR      .SAVESTR

.NOTAIL         LD      A, (SELSTRX)
                LD      (WORKBUF), A

.SAVESTR        ; CLEAR TAIL OF WORKBUF (FROM LEN TO 80)
                LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, TEXTCOLS
                SUB     E
                JR      Z, .NOTBLKT
                LD      B, A
.BLKTX3         LD      (HL), ' '
                INC     HL
                DJNZ    .BLKTX3

.NOTBLKT        LD      A, (WORKBUF)
                LD      E, A
                LD      D, 0
                LD      HL, WORKBUF + 81
                ADD     HL, DE
                LD      A, TEXTCOLS
                SUB     E
                JR      Z, .WRTSTR
                LD      B, A
.BLKAT3         LD      (HL), 0
                INC     HL
                DJNZ    .BLKAT3

.WRTSTR         ; WRITE UPDATED START LINE TO MAPPER
                LD      HL, (SELSTRL)
                CALL    LINEWRT

                ; 4. DELETE INTERMEDIATE LINES AND END LINE
                LD      HL, (SELENDL)
                LD      DE, (SELSTRL)
                OR      A
                SBC     HL, DE          ; HL = COUNT TO DELETE
                LD      (SELTMPL), HL

.DELOOP         LD      HL, (SELTMPL)
                LD      A, H
                OR      L
                JR      Z, .DELDONE
                DEC     HL
                LD      (SELTMPL), HL

                LD      HL, (SELSTRL)
                INC     HL              ; LINE TO DELETE = SELSTRL + 1
                CALL    LINEDEL

                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL
                JR      .DELOOP

.DELDONE        ; 5. RE-POSITION CURSOR AT START
                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                LD      (DOCLINE), HL
                CALL    SETCURY
                CALL    REDRAW
                CALL    DRWGUT
                CALL    DRWSCRL

.DLSFIN         XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                LD      A, #FF
                LD      (MODIFIED), A
                CALL    DRWSTAT
                RET

.DLSCLR         XOR     A
                LD      (SELACT), A
                LD      (SELDRAWN), A
                CALL    DRWSTAT
                RET
