;                                       ****************************************
;                                       * UI — STATUS BAR / GUTTERS / CURSOR  *
;                                       ****************************************


; --- DRWSTAT                   ----------------------------------------


; - DRWSTAT ----------------------------
; - DRAW / REFRESH THE STATUS BAR (ROW 25)
; - BUILDS THE TEXT (BLDSTAT) AND REPAINTS ONLY THE CELLS THAT DIFFER FROM
; - WHAT IS ON SCREEN (STATPRV), TWO COMMANDS EACH. A CURSOR MOVE THAT
; - CHANGES ONE DIGIT COSTS ~1 MS INSTEAD OF THE ~31 MS OF A FULL REBUILD,
; - WHICH IS WHAT LETS MAINLOOP CALL THIS AFTER EVERY KEY.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWSTAT         CALL    BLDSTAT         ; STATBUF = THE TEXT THE BAR SHOULD SHOW
                LD      A, (STATPRV)
                OR      A
                JR      Z, .FULL        ; NEVER PAINTED: FILL AND WRITE IT ALL

                ; DIFF AGAINST STATPRV, CELL BY CELL. DE = NEW TEXT (ASCIIZ),
                ; HL = OLD CELLS (80, SPACE PADDED), C = COLUMN, B = PAST THE END
                LD      DE, STATBUF
                LD      HL, STATPRV
                LD      BC, 0
.DLOOP          LD      A, B
                OR      A
                LD      A, ' '
                JR      NZ, .HAVE       ; PAST THE TERMINATOR: SPACES
                LD      A, (DE)
                OR      A
                JR      NZ, .HAVE
                INC     B               ; THE TERMINATOR: SPACES FROM HERE ON
                LD      A, ' '
.HAVE           CP      (HL)
                JR      Z, .SAME
                LD      (HL), A         ; THE CACHE FOLLOWS THE SCREEN
                PUSH    BC
                PUSH    DE
                PUSH    HL
                CALL    STATCEL
                POP     HL
                POP     DE
                POP     BC
.SAME           INC     HL
                INC     DE
                INC     C
                LD      A, C
                CP      TEXTCOLS
                JR      NZ, .DLOOP
                RET

.FULL           LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      HL, STBROW * CELLH ; DY = 200
                LD      (VDP_DY), HL
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 12
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                LD      HL, STATBUF
                LD      DE, STBTX_X
                LD      BC, STBTX_Y
                CALL    BLTSTR

                ; CACHE = STATBUF, SPACE PADDED TO 80 CELLS
                LD      HL, STATBUF
                LD      DE, STATPRV
                LD      BC, TEXTCOLS * 256 ; B = 80, C = 0 (PAST THE END FLAG)
.CLOOP          LD      A, C
                OR      A
                LD      A, ' '
                JR      NZ, .CPUT
                LD      A, (HL)
                OR      A
                JR      NZ, .CPUT
                INC     C
                LD      A, ' '
.CPUT           LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .CLOOP
                RET


; - STATCEL ----------------------------
; - REPAINT ONE STATUS BAR CELL: UI BACKGROUND, THEN THE GLYPH ON TOP
; - IN:  A = CHARACTER, C = COLUMN (0..79)
; - OUT: NONE
; - CLOBBERS: ALL
; -

STATCEL         PUSH    AF
                LD      L, C
                LD      H, 0
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                ADD     HL, HL          ; COLUMN * 6
                LD      DE, STBTX_X
                ADD     HL, DE
                LD      (VDP_DX), HL
                PUSH    HL
                LD      HL, STBTX_Y
                LD      (VDP_DY), HL
                LD      HL, CELLW
                LD      (VDP_NX), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV
                POP     HL              ; DX
                POP     AF
                CP      ' '
                RET     Z
                LD      DE, STBTX_Y
                JP      BLTCHTR         ; A = CHAR, HL = DX, DE = DY


; - BLDSTAT ----------------------------
; - BUILD DYNAMIC STATUS BAR TEXT IN STATBUF (80 COLS)
; - LEFT CHANNEL (COLS 0..42): SYSTEM/VI MESSAGES, ROM FALLBACK, FILENAME
; - RIGHT CHANNEL (COLS 43..79): COMPACT FLAGS, VI MODE, LN/COL TELEMETRY
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLDSTAT         ; 1. PRE-FILL STATBUF WITH 80 SPACES, FOLLOWED BY NULL TERMINATOR
                LD      HL, STATBUF
                LD      (HL), ' '
                LD      DE, STATBUF + 1
                LD      BC, TEXTCOLS - 1
                LDIR
                XOR     A
                LD      (STATBUF + TEXTCOLS), A ; NULL TERMINATOR AT 80

                ; 2. LEFT CHANNEL: COLS 0..42 (MAX 43 CHARACTERS)
                LD      DE, STATBUF
                LD      A, (STATMSG)
                OR      A
                JR      Z, .NOSTMSG
                LD      HL, STATMSG
                LD      B, 43
                CALL    .CPYMAX
                JR      .DOLEFT

.NOSTMSG        LD      A, (LOADERR)
                OR      A
                JR      Z, .CHKROM
                LD      HL, .STROOM     ; "[FILE TOO LARGE]"
                LD      B, 43
                CALL    .CPYMAX
                JR      .DOLEFT

.CHKROM         ; FALLBACK FONT INDICATOR FOR B3 MUTATION TEST
                ; MUST PRESERVE EXACT PATTERN:
                ;   LD HL, .STRROM
                ;   JR Z, .PUTFNT
                ;   LD HL, .STRNOFN
                LD      B, 43
                LD      A, (FNTOK)
                OR      A
                LD      HL, .STRROM
                JR      Z, .PUTFNT
                LD      HL, .STRNOFN
.PUTFNT         CALL    .CPYMAX

.DOLEFT         ; 3. RIGHT CHANNEL AT FIXED OFFSET 43 (COLS 43..79)
                LD      DE, STATBUF + 43

                ; A. COMPACT FLAGS: [W|A|M|I] (9 CHARS, COLS 43..51)
                LD      A, '['
                LD      (DE), A
                INC     DE

                ; WRAP MODE: 'D' (DEV) OR 'T' (TXT)
                LD      A, 'D'
                LD      HL, WRAPMODE
                BIT     0, (HL)
                JR      Z, .PUTWRP
                LD      A, 'T'
.PUTWRP         LD      (DE), A
                INC     DE
                LD      A, '|'
                LD      (DE), A
                INC     DE

                ; AUTOALIGN: 'A' (ON/DEV) OR '-' (OFF)
                LD      A, '-'
                LD      HL, AUTOALGN
                LD      C, (HL)
                DEC     C
                JP      M, .PUTALN
                LD      A, 'A'
.PUTALN         LD      (DE), A
                INC     DE
                LD      A, '|'
                LD      (DE), A
                INC     DE

                ; MARKUP: 'M' (MD), 'L' (LITE), '-' (OFF)
                LD      A, (MKUPMD)
                CP      MKUP_MD
                LD      A, 'M'
                JR      Z, .PUTMK
                LD      A, (MKUPMD)
                CP      MKUP_LIT
                LD      A, 'L'
                JR      Z, .PUTMK
                LD      A, '-'
.PUTMK          LD      (DE), A
                INC     DE
                LD      A, '|'
                LD      (DE), A
                INC     DE

                ; INSERT MODE: 'I' (INSERT) OR 'O' (OVERWRITE)
                LD      A, (INSMODE)
                OR      A
                LD      A, 'O'
                JR      Z, .PUTINS
                LD      A, 'I'
.PUTINS         LD      (DE), A
                INC     DE
                LD      A, ']'
                LD      (DE), A
                INC     DE

                ; B. MODIFIED INDICATOR: '* ' OR '  ' (2 CHARS, COLS 52..53)
                LD      A, (MODIFIED)
                OR      A
                LD      A, '*'
                JR      NZ, .PUTMOD
                LD      A, ' '
.PUTMOD         LD      (DE), A
                INC     DE
                LD      A, ' '
                LD      (DE), A
                INC     DE

                ; C. VI MODE / SELECTION: 4 CHARS (COLS 54..57)
                LD      A, (KMAPID)
                CP      KMVI
                JR      NZ, .NOTVI
                LD      A, (SELACT)
                OR      A
                LD      HL, .STRVIV     ; "[V] "
                JR      NZ, .PUTVI
                LD      A, (VIMODE)
                CP      VIMNORM
                LD      HL, .STRVIN     ; "[N] "
                JR      Z, .PUTVI
                LD      HL, .STRVII     ; "[I] "
.PUTVI          CALL    .CPY4
                JR      .DONEVI

.NOTVI          LD      A, (SELACT)
                OR      A
                LD      HL, .STRSEL     ; "[S] "
                JR      NZ, .PUTNVI
                LD      HL, .STRSP4     ; "    "
.PUTNVI         CALL    .CPY4
.DONEVI

                ; D. CURSOR POSITION: 22 CHARS (COLS 58..79)
                LD      HL, .STRLN      ; "Ln "
                CALL    .CPY3
                LD      HL, (DOCLINE)
                INC     HL
                LD      B, 5
                CALL    .CPYNUM
                LD      A, '/'
                LD      (DE), A
                INC     DE
                LD      HL, (TOTLINES)
                LD      B, 5
                CALL    .CPYNUM
                LD      HL, .STRCOL     ; " Col "
                CALL    .CPY5
                LD      A, (CURX)
                INC     A
                LD      L, A
                LD      H, 0
                LD      B, 3
                CALL    .CPYNUM
                RET

.CPY5           LDI
.CPY4           LDI
.CPY3           LDI
                LDI
                LDI
                RET

.CPYMAX         LD      A, B
                OR      A
                RET     Z
                LD      A, (HL)
                OR      A
                RET     Z
                LD      (DE), A
                INC     HL
                INC     DE
                DEC     B
                JR      .CPYMAX

                ; HL = VALUE, B = WIDTH: APPEND THE LOW B DIGITS, ZERO PADDED.
                ; B2D16 RIGHT-ALIGNS AT B2DEND WITH SPACES FOR LEADING ZEROS.
.CPYNUM         PUSH    DE
                PUSH    BC
                CALL    B2D16
                POP     BC
                POP     DE
                LD      HL, B2DEND
                LD      A, L
                SUB     B
                LD      L, A
                JR      NC, .CPYNUM2
                DEC     H
.CPYNUM2        LD      A, (HL)
                CP      ' '
                JR      NZ, .CPYNUM3
                LD      A, '0'
.CPYNUM3        LD      (DE), A
                INC     HL
                INC     DE
                DJNZ    .CPYNUM2
                RET

.STRROM         DEFM    "[ROM] ", 0
.STRNOFN        DEFB    0
.STRVIN         DEFM    "[N] "
.STRVII         DEFM    "[I] "
.STRVIV         DEFM    "[V] "
.STRSEL         DEFM    "[S] "
.STRSP4         DEFM    "    "
.STRLN          DEFM    "Ln "
.STRCOL         DEFM    " Col "
.STROOM         DEFM    "[FILE TOO LARGE]", 0


; --- DRWMENU               ----------------------------------------


; - DRWMENU ----------------------------
; - DRAW MENU BAR (ROW 0, ALWAYS VISIBLE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWMENU         LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL
                LD      (VDP_DX), HL
                LD      (VDP_DY), HL    ; DY = 0
                LD      HL, 512
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8
                LD      (VDP_NY), HL
                LD      A, CLR_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMV

                ; PRINT MENU TEXT
                LD      HL, MNUTEXT
                LD      DE, 6           ; DX = 6
                LD      BC, 0           ; DY = 0
                CALL    BLTSTR
                CALL    DRWFNAM
                JP      UPDMCLK

MNUTEXT         DEFM    "S6ED | File  Edit  View  Options  Help", 0


; --- DRWFNAM                   ----------------------------------------


; - DRWFNAM ----------------------------
; - DRAW CURRENT FILENAME IN ROW 0
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

DRWFNAM         ; 1. CLEAR FILENAME REGION IN ROW 0
                ; DX = 236, DY = 0, NX = 234 (IF SHOWCLK) OR 270 (IF NO CLK), NY = 8
                LD      HL, 236
                LD      (VDP_DX), HL
                LD      HL, 0
                LD      (VDP_DY), HL
                LD      HL, 234         ; 236 + 234 = 470
                LD      A, (SHOWCLK)
                OR      A
                JR      NZ, .CLRNX
                LD      HL, 270         ; 236 + 270 = 506
.CLRNX          LD      (VDP_NX), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; 2. CHECK IF FILENAME IS PRESENT
                LD      A, (FILENAME)
                OR      A
                RET     Z               ; NO FILENAME

                ; 3. COMPUTE LENGTH OF FILENAME (CAPPED AT 30)
                LD      HL, FILENAME
                LD      B, 0
.LNLEN          LD      A, (HL)
                OR      A
                JR      Z, .LENDON
                INC     HL
                INC     B
                LD      A, B
                CP      30
                JR      NZ, .LNLEN
.LENDON         ; B = NUMBER OF CHARS (1..30)
                ; WIDTH IN PIXELS = B * 6
                LD      L, B
                LD      H, 0
                LD      D, H
                LD      E, L
                ADD     HL, HL
                ADD     HL, DE
                ADD     HL, HL          ; HL = B * 6

                ; END X: 470 (IF SHOWCLK) OR 506 (IF NO CLK)
                LD      DE, 470
                LD      A, (SHOWCLK)
                OR      A
                JR      NZ, .HAVEND
                LD      DE, 506
.HAVEND         ; START X = END X - WIDTH = DE - HL
                EX      DE, HL
                OR      A
                SBC     HL, DE          ; HL = START X

                ; PRINT FILENAME AT (DX = HL, DY = 0)
                EX      DE, HL          ; DE = START X
                LD      HL, FILENAME
                LD      BC, 0           ; DY = 0
                JP      BLTSTR


; --- CHKCLK                    ----------------------------------------


; - CHKCLK -----------------------------
; - TEST IF CLOCK / COLON NEEDS REDRAW (CALLED IN MAINLOOP & .DRAWCUR)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

CHKCLK          LD      A, (SHOWCLK)
                OR      A
                RET     Z

                LD      A, (WINACTV)
                OR      A
                RET     NZ

                ; JIFFY IS A 16-BIT FRAME COUNTER. SUBTRACTING THE STAMP AS
                ; A WORD KEEPS THE ELAPSED COUNT EXACT ACROSS ITS WRAP AND
                ; ACROSS STALLS LONGER THAN 256 FRAMES -- AN 8-BIT DIFFERENCE
                ; WRAPS DURING A LONG FILE SAVE AND SWALLOWS A TOGGLE.
                LD      HL, (JIFFY)
                LD      DE, (CLKJIF)
                OR      A
                SBC     HL, DE          ; HL = FRAMES SINCE THE LAST TOGGLE
                LD      A, (CLKHZ)
                LD      E, A
                LD      D, 0
                OR      A
                SBC     HL, DE
                RET     C               ; LESS THAN ONE SECOND

                ; 1 SECOND ELAPSED: RESTAMP
                LD      HL, (JIFFY)
                LD      (CLKJIF), HL

                ; TOGGLE COLON PHASE (0 = ON, 1 = OFF)
                LD      A, (CLKPH)
                XOR     1
                LD      (CLKPH), A

                JP      UPDMCLK


; --- UPDMCLK                   ----------------------------------------


; - UPDMCLK ----------------------------
; - UPDATE MENU BAR CLOCK IN ROW 0 VIA RTC
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

UPDMCLK         LD      A, (SHOWCLK)
                OR      A
                RET     Z               ; CLOCK DISABLED IN CONFIG

                LD      C, _GTIME       ; #2C
                CALL    DOS             ; H = HOURS (0..23), L = MINUTES (0..59), D = SECONDS (0..59)
                LD      A, (CLKMIN)
                CP      L
                JR      NZ, .MINCHG     ; MINUTE CHANGED (OR FIRST DRAW)

                ; MINUTE IS THE SAME: UPDATE ONLY COLON CELL (DX = 488, DY = 0)
                ; CLEAR 6X8 BOX AT DX = 488, DY = 0 (COLOR 2: COL_UI).
                ; LMMV, NOT HMMV -- SEE THE NOTE AT THE .MINCHG CLEAR BELOW.
                LD      HL, 488
                LD      (VDP_DX), HL
                LD      HL, 0
                LD      (VDP_DY), HL
                LD      HL, CELLW
                LD      (VDP_NX), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; CHECK COLON PHASE SET BY CHKCLK (0 = ON, 1 = OFF)
                LD      A, (CLKPH)
                OR      A
                RET     NZ              ; 1: OFF (LEAVE ERASED/BLANK)

                ; 0: ON (DRAW COLON GLYPH)
                LD      A, ':'
                LD      HL, 488
                LD      DE, 0
                JP      BLTCHTR

.MINCHG         ; MINUTE CHANGED: FULL REDRAW OF "HH:MM"
                LD      A, L
                LD      (CLKMIN), A     ; UPDATE CACHED MINUTE
                PUSH    HL              ; H = HOURS, L = MINUTES

                ; FORMAT "HH:MM", 0 INTO CLKBUF
                LD      A, H            ; H = HOURS (0..23)
                CALL    DECDIG2
                LD      A, D
                LD      (CLKBUF), A
                LD      A, E
                LD      (CLKBUF + 1), A

                LD      A, (CLKPH)
                OR      A
                LD      A, ':'
                JR      Z, .SETCOL
                LD      A, ' '
.SETCOL         LD      (CLKBUF + 2), A

                POP     HL              ; RESTORE L = MINUTES
                LD      A, L
                CALL    DECDIG2
                LD      A, D
                LD      (CLKBUF + 3), A
                LD      A, E
                LD      (CLKBUF + 4), A
                XOR     A
                LD      (CLKBUF + 5), A

                ; CLEAR 30X8 BOX AT DX = 476, DY = 0 (COLOR 2: COL_UI).
                ;
                ; LMMV, NOT HMMV. HMMV WORKS IN BYTE UNITS AND SCREEN 6 PACKS
                ; 4 PIXELS PER BYTE, SO NX = 30 IS TRUNCATED TO 28 AND PIXELS
                ; 504-505 -- COLUMN 4 OF THE LAST MINUTE DIGIT -- ARE NEVER
                ; CLEARED. MEASURED: A '7' DRAWN OVER A '6' KEPT THE RIGHT
                ; STROKE OF THE '6' AT ROWS 3-5, AND THE RESIDUE ACCUMULATED
                ; FROM DIGIT TO DIGIT. ROUNDING NX UP TO 32 WOULD FIX THIS BOX
                ; BUT NOT THE COLON CELL ABOVE, WHERE 6 -> 8 WOULD ERASE THE
                ; FIRST TWO PIXEL COLUMNS OF THE MINUTES. LMMV IS DOT-EXACT.
                ; HMMV IS ONLY SAFE WHERE DX AND NX ARE BOTH MULTIPLES OF 4,
                ; AS IN RENDEROW, WHICH ROUNDS ITS RUN LENGTH UP EXPLICITLY.
                LD      HL, 476
                LD      (VDP_DX), HL
                LD      HL, 0
                LD      (VDP_DY), HL
                LD      HL, 5 * CELLW   ; 5 GLYPHS
                LD      (VDP_NX), HL
                LD      HL, CELLH
                LD      (VDP_NY), HL
                LD      A, COL_UI
                LD      (VDP_CLR), A
                XOR     A
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_IMP
                CALL    LMMV

                ; BLIT STRING "HH:MM" WITH TIMP TRANSPARENCY
                LD      HL, CLKBUF
                LD      DE, 476
                LD      BC, 0
                JP      BLTSTR


; --- DECDIG2                   ----------------------------------------


; - DECDIG2 ----------------------------
; - CONVERT 8-BIT INT (0..59) TO 2 ASCII DIGITS
; - IN:  A = VALUE (0..59)
; - OUT: D = TENS ASCII, E = UNITS ASCII
; - CLOBBERS: A, D, E
; -

DECDIG2         LD      D, '0'
.DECLP          CP      10
                JR      C, .DECDON
                SUB     10
                INC     D
                JR      .DECLP
.DECDON         ADD     A, '0'
                LD      E, A
                RET


; --- BLTCHTR                  ----------------------------------------


; - BLTCHTR ----------------------------
; - BLIT CHARACTER WITH TIMP TRANSPARENCY
; - IN:  A  = ASCII CHAR
; -      HL = DX
; -      DE = DY
; - OUT: NONE
; - CLOBBERS: NONE
; -

BLTCHTR         PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                LD      (VDP_DX), HL
                EX      DE, HL
                LD      (VDP_DY), HL

                ; CALC FONT SX/SY
                LD      B, A            ; B = CHAR
                AND     %00011111       ; CHAR & 31
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                ADD     HL, HL          ; * 4
                ADD     HL, HL          ; * 8
                LD      (VDP_SX), HL

                LD      A, B
                SRL     A
                SRL     A
                SRL     A
                SRL     A
                SRL     A               ; CHAR >> 5 (0..7)
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; * 8
                LD      L, A
                LD      H, 0
                LD      DE, FNORM_SY    ; 256
                ADD     HL, DE
                LD      (VDP_SY), HL

                LD      HL, 6           ; NX = 6
                LD      (VDP_NX), HL
                LD      HL, 8           ; NY = 8
                LD      (VDP_NY), HL
                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMM | VDP_TIMP
                CALL    LMMM

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; - BLTSTR -----------------------------
; - BLIT ASCIIZ STRING WITH TIMP
; - IN:  HL = POINTER TO ASCIIZ STRING
; -      DE = DX
; -      BC = DY
; - OUT: NONE
; - CLOBBERS: ALL
; -

BLTSTR          LD      A, (HL)
                OR      A
                RET     Z
                PUSH    HL
                PUSH    DE
                PUSH    BC
                EX      DE, HL          ; HL = DX
                LD      D, B
                LD      E, C            ; DE = DY
                CALL    BLTCHTR
                POP     BC
                POP     DE
                POP     HL
                INC     HL
                LD      A, 6
                ADD     A, E
                LD      E, A
                JR      NC, BLTSTR
                INC     D
                JR      BLTSTR


; --- DRWCUR                ----------------------------------------


; - DRWCUR -----------------------------
; - TOGGLE CURSOR XOR OVERLAY AT (CURX, CURY)
; - IN:  NONE (USES CURX, CURY)
; - OUT: NONE
; - CLOBBERS: NONE
; -

DRWCUR          PUSH    AF
                PUSH    BC
                PUSH    DE
                PUSH    HL

                ; DX = TXORG_X + CURX * 6
                LD      A, (CURX)
                LD      L, A
                LD      H, 0
                ADD     HL, HL          ; * 2
                LD      D, H
                LD      E, L
                ADD     HL, HL          ; * 4
                ADD     HL, DE          ; * 6
                LD      DE, TXORG_X
                ADD     HL, DE
                LD      (VDP_DX), HL

                ; DY = (CURY + 1) * 8
                LD      A, (CURY)
                INC     A
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      L, A
                LD      H, 0
                LD      (VDP_DY), HL

                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_SY), HL

                LD      HL, CELLW       ; NX = 6
                LD      (VDP_NX), HL
                LD      HL, CELLH       ; NY = 8
                LD      (VDP_NY), HL

                LD      A, COL_FG       ; CLR = 1 (INVERSE VIDEO)
                LD      (VDP_CLR), A

                XOR     A
                LD      (VDP_ARG), A

                LD      HL, VDPCMBLK
                LD      A, VDP_LMMV | VDP_XOR
                CALL    LMMV

                POP     HL
                POP     DE
                POP     BC
                POP     AF
                RET


; --- MODAL DIALOG INPUT        ----------------------------------------


; - WINPOLL ----------------------------
; - POLL KEYBOARD AND CLOCK FOR MODAL DIALOGS
; - IN:  NONE
; - OUT: Z  = NO KEY PRESSED
; -      NZ = KEY PRESSED (A = ASCII CODE)
; - CLOBBERS: ALL
; -

WINPOLL         CALL    CHKCLK
                LD      IX, CHSNS
                CALL    BIOSCALL
                RET     Z
                LD      IX, CHGET
                JP      BIOSCALL


; - WINKIL -----------------------------
; - FLUSH KEYBOARD BUFFER VIA BIOS KILBUF
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

WINKIL          LD      IX, KILBUF
                JP      BIOSCALL


