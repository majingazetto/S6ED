;                                       ****************************************
;                                       * VARS                                 *
;                                       ****************************************

VARS


; --- SYSTEM                    ----------------------------------------


DOS2            DEFB    0               ; FF = DOS2/NEXTOR PRESENT, 00 = DOS1
UNAPISET        DEFB    0               ; BDOS.Z8A UNAPI FLAG (UNUSED IN S6ED)
MAPRDY          DEFB    0               ; FF = MAPPER MANAGER FOUND
SCRRDY          DEFB    0               ; FF = SCREEN 6 INITIALIZED
SAVESP          DEFW    0               ; ORIGINAL STACK POINTER
DEFSEG1         DEFB    0               ; ORIGINAL PAGE 1 MAPPER SEGMENT
DEFSEG2         DEFB    0               ; ORIGINAL PAGE 2 MAPPER SEGMENT
SAVSCRMD        DEFB    0               ; ORIGINAL SCREEN MODE (SCRMOD)
SAVL40          DEFB    0               ; ORIGINAL SCREEN 0 WIDTH (LINL40)
SAVLLEN         DEFB    0               ; ORIGINAL CURRENT WIDTH (LINLEN)
SAVFORC         DEFB    0               ; ORIGINAL FOREGROUND COLOR (FORCLR)
SAVBAKC         DEFB    0               ; ORIGINAL BACKGROUND COLOR (BAKCLR)
SAVBDRC         DEFB    0               ; ORIGINAL BORDER COLOR (BDRCLR)


; --- MAPPER JUMP TABLE ENTRIES ----------------------------------------

                ; FILLED AT INIT BY MAPINIT (EXTBIO → HOKVLD CHECK)
MALLSEG      DEFW    0               ; ALL_SEG ENTRY ADDRESS
MFRESEG      DEFW    0               ; FRE_SEG ENTRY ADDRESS
MPUTP1       DEFW    0               ; PUT_P1  ENTRY ADDRESS (RESTORE ONLY)
MGETP1       DEFW    0               ; GET_P1  ENTRY ADDRESS
MPUTP2       DEFW    0               ; PUT_P2  ENTRY ADDRESS (PAGE 2: TEXT)
MGETP2       DEFW    0               ; GET_P2  ENTRY ADDRESS


; --- SEGMENTS                  ----------------------------------------

TXSEG           DEFB    0               ; SEGMENT NUMBER BANKED AT PAGE 2 (TEXT)
TXSEG0          DEFB    0               ; FIRST TEXT SEGMENT (RECORD 0 LIVES HERE)
APPSEG          DEFB    0               ; SEGMENT THE APPEND CURSOR WRITES INTO
DIRSEG          DEFB    0               ; DIRECTORY SEGMENT (ALWAYS SEGTBL ENTRY 0)
FTRSEG          DEFB    0               ; FEATURE SEGMENT (ALWAYS SEGTBL ENTRY 1)
VIDSEG          DEFB    0               ; S2: VIDEO SHADOW SEGMENT (SEGTBL ENTRY 1)
VDPDATA         DEFB    0               ; VDP DATA PORT (DERIVED FROM #0006)
VDPCTRL         DEFB    0               ; VDP CONTROL PORT (DATA + 1)
HOMESEG         DEFB    0               ; FEATURE SEGMENT CURRENTLY EXECUTING
SEGSP           DEFB    0               ; INTER-SEGMENT CALL STACK POINTER (0..8)
SEGSTK          DEFS    8               ; 4-DEEP STACK OF {TXSEG, HOMESEG} PAIRS
DATHAND         DEFB    0               ; S6ED.DAT FILE HANDLE
DATHDR          DEFS    16              ; S6ED.DAT FILE HEADER BUFFER (16 BYTES)
DATBLK          DEFS    8               ; S6ED.DAT CURRENT BLOCK DESCRIPTOR (8 BYTES)
DATTBL          DEFS    DATMAX * 8      ; S6ED.DAT DESCRIPTOR TABLE (DATMAX BLOCKS)
DATSIZE         DEFW    0               ; S6ED.DAT FILE SIZE (LOW 16 BITS)
DATSZH          DEFB    0               ; FILE SIZE HIGH WORDS OR'ED (0 = < 64 KB)
DATCNT          DEFB    0               ; DATLOAD: BLOCKS LEFT TO LOAD
DATPTR          DEFW    0               ; DATLOAD: NEXT DESCRIPTOR IN DATTBL
DATSEG          DEFB    0               ; DATLOAD: TARGET SEGMENT OF THE BLOCK

                ; BOOT SEGMENT ACCOUNTING (SEGRESV, MAPPER.Z8A). SEGAVL COUNTS
                ; THE SEGMENTS LEFT BEYOND THE TWO RESERVED, SEGLNS IS THE
                ; RESULTING TEXT CEILING IN LINES, SEGMSG THE COMPOSED REPORT.
SEGAVL          DEFB    0               ; SPARE SEGMENTS BEYOND DIRSEG + FTRSEG
SEGTOT          DEFB    0               ; TOTAL MAPPER SEGMENTS DETECTED (EXTBIO)
SEGLNS          DEFW    0               ; TEXT CEILING: (SEGAVL + 1) * LINEPSEG
SWTVERB         DEFB    0               ; /V SWITCH: #FF = VERBOSE BOOT INFO
SEGMSG          DEFS    64              ; BOOT REPORT LINE BUFFER

                ; HEAD OF THE FREE RECORD LIST. RECORDS ARE FIXED SIZE, SO A
                ; DELETED ONE IS A REUSABLE SLOT; THE LINK TO THE NEXT LIVES
                ; IN THE FIRST 3 BYTES OF THE FREED RECORD ITSELF, WHICH
                ; COSTS NO RAM AND CANNOT OVERFLOW. BUFRESET SETS FREEHD BACK
                ; TO FREENIL -- IT MUST, BECAUSE SEGTRIM HAS JUST HANDED THE
                ; GROWN SEGMENTS BACK AND ANY LINK INTO THEM IS NOW DANGLING.
FREEHD          DEFB    FREENIL         ; SEGMENT OF THE FIRST FREE RECORD
FREEOF          DEFW    0               ; OFFSET OF THE FIRST FREE RECORD

                ; EVERY SEGMENT CLAIMED THROUGH SEGGET IS RECORDED HERE SO THE
                ; EDITOR CAN HAND THEM ALL BACK ON EXIT. THE TWO SEGMENTS THE
                ; EDITOR STARTS WITH ARE NOT IN HERE: DEFSEG1 AND DEFSEG2 ARE
                ; THE TPA'S OWN, NEVER ALLOCATED AND NEVER RETURNED.
                ; ENTRIES 0 AND 1 ARE SPECIAL: SEGRESV CLAIMS DIRSEG AND
                ; FTRSEG FIRST, BEFORE ANY TEXT SEGMENT, SO SEGTBL[0] IS THE
                ; DIRECTORY SEGMENT AND SEGTBL[1] THE FEATURE SEGMENT. SEGTRIM
                ; MUST NEVER FREE THEM -- ITS FLOOR IS TWO. EVERYTHING ABOVE
                ; IS A TEXT SEGMENT GROWN ON DEMAND AND DROPPED BY SEGTRIM.

SEGTBL          DEFS    MAXSEGS
SEGCNT          DEFB    0               ; ENTRIES USED IN SEGTBL


; --- CURSOR / VIEWPORT         ----------------------------------------


CURX            DEFB    0               ; CURSOR COLUMN (0-79, DOC SPACE)
CURY            DEFB    0              ; CURSOR ROW    (0-23, VIEWPORT)

TOPLINE         DEFW    0               ; FIRST VISIBLE DOCUMENT LINE (0-BASED)
DOCLINE         DEFW    0               ; CURSOR DOCUMENT LINE (= TOPLINE + CURY)
TOTLINES        DEFW    1               ; TOTAL LINES IN DOCUMENT


; --- EDITOR STATE              ----------------------------------------


MODIFIED        DEFB    0               ; FF = BUFFER MODIFIED SINCE LAST SAVE
INSMODE         DEFB    INS_MODE        ; INSERT (FF) OR OVERWRITE (00)
WRAPMODE        DEFB    0               ; 0 = WRAP_DEV, 1 = WRAP_TXT
AUTOALGN        DEFB    ALGN_OFF        ; ALGN_OFF / ALGN_ON / ALGN_DEV (CFG)
ALGNTMP         DEFB    0               ; ACTNWLIN: TARGET COLUMN ACROSS EDNWLIN
TYPATTR         DEFB    0               ; ACTIVE TYPING ATTRIBUTE (ATRBOLD, ATRITAL)
MKUPMD          DEFB    0               ; 0=OFF, 1=MD, 2=LITE
SHOWCLK         DEFB    1               ; 0=OFF, 1=SHOW CLOCK IN MENU ROW
TABWIDTH        DEFB    4               ; TAB WIDTH (2, 4, 8)
SAVEEOL         DEFB    0               ; 0=DOS (CRLF), 1=UNIX (LF)
AUTOLOD         DEFB    1               ; 1=AUTO-DETECT EOL ON LOAD, 0=FIXED BY CFG
EOLARED         DEFB    0               ; 1=EOL FORMAT ALREADY DETECTED ON LOAD
PALDIRT         DEFB    0               ; FF = PALETTE MODIFIED BY CFG
CLKHZ           DEFB    60              ; VDP INTERRUPT FREQUENCY (50 OR 60)
CLKJIF          DEFW    0               ; JIFFY STAMP OF THE LAST COLON TOGGLE
CLKPH           DEFB    0               ; COLON BLINK PHASE (0=VISIBLE, 1=INVISIBLE)
CLKMIN          DEFB    #FF             ; CACHED MINUTE FOR CLOCK (#FF=NEEDS DRAW)
CLKBUF          DEFS    6               ; "HH:MM", 0

                ; NON-ZERO WHILE A BATCH EDIT IS RUNNING. EDINSCHR, EDNWLIN
                ; AND EDPSHWR THEN DO ALL THEIR BOOKKEEPING -- CURX, CURY,
                ; DOCLINE, TOPLINE, TOTLINES -- AND SKIP ONLY THE PAINTING,
                ; WHICH THE CALLER DOES ONCE WHEN IT IS DONE.
RNDHOLD         DEFB    0               ; FF = DEFER ALL PAINTING
BLNKPH          DEFB    0               ; CURSOR BLINK PHASE (POLLED FROM JIFFY)
BLNKCNT         DEFB    0               ; BLINK TICK COUNTER

KMAPID          DEFB    0               ; 0=STD, 1=WS, 2=EMACS, 3=VI
KMAPPTR         DEFW    0               ; POINTER TO ACTIVE KEYMAP TABLE
VIMODE          DEFB    0               ; 0=NORMAL, 1=INSERT
VILEAD          DEFB    0               ; VI LEADER KEY PENDING
MODKEYS         DEFB    0               ; LAST READ MODIFIERS BYTE
DEADST          DEFB    0               ; DEAD KEY STATE (0=NONE, 1=ACUTE, 2=DIAERESIS)
LASTGRP         DEFB    0               ; LAST MATRIX GRAPH ACCENT KEY PRESSED
GRPTIM          DEFB    0               ; JIFFY TIMESTAMP FOR GRAPH REPEAT
LASTDED         DEFB    0               ; LAST DEAD KEY MATRIX STATE (FOR EDGE DETECT)
DWK             DEFB    0               ; WORD DELETE: COUNT K

DWTO            DEFB    0               ; WORD DELETE: DEST COLUMN
DWFROM          DEFB    0               ; WORD DELETE: SOURCE COLUMN
SELACT          DEFB    0               ; 0=INACTIVE, 1=SELECTION ACTIVE
SELDRAWN        DEFB    0               ; 0=NOT PAINTED, 1=XOR OVERLAY PAINTED
SELANCL         DEFW    0               ; ANCHOR DOCUMENT LINE
SELANCX         DEFB    0               ; ANCHOR COLUMN
                ; TWO SELECTION RANGE RECORDS, EACH SIX CONTIGUOUS BYTES IN
                ; THIS EXACT ORDER: STRL (2), STRX (1), ENDL (2), ENDX (1).
                ; SELEXT WALKS THEM BY IX + 0 .. IX + 5 AND SELPRE / SELPOST
                ; COPY THEM WITH LDIR BC, 6, SO THE LAYOUT IS LOAD BEARING AND
                ; THE ASSERTS BELOW FAIL THE BUILD IF ANYONE REORDERS IT.
                ; NOTHING ELSE MAY LIVE INSIDE EITHER RECORD: DRWSTRL USED TO
                ; BE A LONE DEFW AND THE FOUR BYTES BEHIND IT WERE SELTMPL /
                ; SELTMPXA / SELTMPXB, WHICH SELDIFF WRITES INSIDE ITS OWN ROW
                ; LOOP -- IT CORRUPTED THE PAINTED RANGE AS IT READ IT.

SELSTRL         DEFW    0               ; NORMALIZED START LINE
SELSTRX         DEFB    0               ; NORMALIZED START COL
SELENDL         DEFW    0               ; NORMALIZED END LINE
SELENDX         DEFB    0               ; NORMALIZED END COL
DRWSTRL         DEFW    0               ; PAINTED START LINE
DRWSTRX         DEFB    0               ; PAINTED START COL
DRWENDL         DEFW    0               ; PAINTED END LINE
DRWENDX         DEFB    0               ; PAINTED END COL

                ASSERT  SELSTRX == SELSTRL + 2
                ASSERT  SELENDL == SELSTRL + 3
                ASSERT  SELENDX == SELSTRL + 5
                ASSERT  DRWSTRX == DRWSTRL + 2
                ASSERT  DRWENDL == DRWSTRL + 3
                ASSERT  DRWENDX == DRWSTRL + 5

SELTMPL         DEFW    0               ; TEMP LINE VAR
SELTMPXA        DEFB    0               ; TEMP COL XA
SELTMPXB        DEFB    0               ; TEMP COL XB
CLIPLEN         DEFW    0               ; BYTES CURRENTLY IN CLIPBOARD
CLIPRD          DEFW    0               ; CLIPBOARD READ POINTER
CPYCNT          DEFW    0               ; CLIPBOARD TEMP COUNTER
CPYPTR          DEFW    0               ; CLIPBOARD WRITE POINTER

                ; PASTE STATE. THE SNAPSHOT IS TAKEN ONCE THE OLD SELECTION IS
                ; GONE AND IS WHAT THE SINGLE REPAINT AT THE END IS DECIDED
                ; FROM: HOW FAR THE VIEWPORT MOVED AND HOW MANY LINES APPEARED.

PSTROW          DEFB    0               ; CURY WHEN THE PASTE STARTED
PSTTOP          DEFW    0               ; TOPLINE WHEN THE PASTE STARTED
PSTTOT          DEFW    0               ; TOTLINES WHEN THE PASTE STARTED
PSTRUN          DEFB    0               ; LENGTH OF THE RUN BEING INSERTED
CLIPBUF         DEFS    CLIPMAX, 0      ; CLIPBOARD BUFFER IN PAGE 0 RAM


; --- MODAL TEXT INPUT          ----------------------------------------


                ; WINEDIT'S WORK AREA. SHARED BY EVERY DIALOG WITH A FIELD,
                ; SO IT IS NOT IFDEF'D: BOTH TARGETS RUN THE SAME WIDGET
                ; CONTRACT OVER THEIR OWN DRAWING PRIMITIVES.
INPBUF          DEFS    INPMAX + 1, 0   ; FIELD CONTENTS, ASCIIZ
INPLEN          DEFB    0               ; CHARACTERS IN INPBUF (0..INPMAX)
                ; GEOMETRY OF THE ACTIVE FIELD. THEY ARE IN RAM AND NOT IN
                ; REGISTERS BECAUSE WINEDIT RUNS A KEY LOOP AND WINPOLL
                ; CLOBBERS EVERYTHING. EIGHT BITS EACH SERVES BOTH TARGETS:
                ; A CELL COORDINATE ON S2, A RELATIVE PIXEL ON S6 (0..199).
EDROW           DEFB    0               ; FIELD ROW
EDCOL           DEFB    0               ; FIELD COLUMN
EDWID           DEFB    0               ; FIELD WIDTH IN CHARACTERS


; --- SEARCH & REPLACE          ----------------------------------------


SRCHPAT         DEFS    SRCHMAX + 1, 0  ; SEARCH PATTERN (ASCIIZ)
SRCHLEN         DEFB    0               ; LENGTH OF SEARCH PATTERN (0..SRCHMAX)
RPLCPAT         DEFS    SRCHMAX + 1, 0  ; REPLACE PATTERN (ASCIIZ)
RPLCLEN         DEFB    0               ; LENGTH OF REPLACE PATTERN (0..SRCHMAX)
SRCHOPT         DEFB    0               ; BIT 0: CASE SENSITIVE (1=YES, 0=NO)
SRCHDIR         DEFB    0               ; 0 = FORWARD, 1 = BACKWARD
SRCHLST         DEFW    0               ; LAST MATCH DOCLINE
SRCHCOL         DEFB    0               ; LAST MATCH CURX
FNDFOC          DEFB    0               ; FIND DIALOG ACTIVE FOCUS (0..6)
FNDROW          DEFB    0               ; FIND DIALOG FIELD ROW
FNDLEN          DEFB    0               ; FIND DIALOG FIELD LENGTH
FNDACT          DEFB    0               ; FIND DIALOG FIELD ACTIVE (1=YES, 0=NO)
FNDCOL          DEFB    0               ; FIND DIALOG FIELD COLOR
FNDBUF          DEFW    0               ; FIND DIALOG BUFFER POINTER
RPLCNT          DEFW    0               ; REPLACE ALL COUNTER


; --- FILE                      ----------------------------------------


FILENAME        DEFS    40, 0           ; CURRENT FILENAME (ASCIIZ)
FILEHAND        DEFB    0               ; OPEN FILE HANDLE
SAVHAND         DEFB    0               ; FILESAVE: HANDLE OF THE FILE BEING WRITTEN
WASCR           DEFB    0               ; 1 = LAST CHAR PROCESSED WAS CR
LOADERR         DEFB    0               ; 1 = FILELOAD FAILED DUE TO CAPACITY/OOM

                ; APPEND CURSOR AND CURRENT LINE LENGTH, BOTH DRIVEN BY THE
                ; LOADER AND BY BUFRESET. THEY LIVED INSIDE FILEIO.Z8A, WHICH
                ; PUT MUTABLE STATE IN THE EMITTED IMAGE: IT WORKED ONLY
                ; BECAUSE BEING BELOW OUTEND THEY CARRIED THEIR OWN DEFW / DEFB
                ; INITIALISERS IN THE .COM, AND IT IS THE ONE SHAPE A MODULE
                ; CANNOT KEEP WHEN IT MOVES INTO A PAGE-2 SEGMENT.
LINEOFF         DEFW    0               ; OFFSET OF THE NEXT FREE LINE RECORD
CURLLEN         DEFB    0               ; LENGTH OF THE LINE BEING BUILT
FCB             DEFS    SIZEFCB         ; FCB FOR DOS1 I/O
PARMTMP         DEFS    40              ; CHKFILE: TEMP COPY OF ONE PARAM
PARBUF          DEFS    128             ; EXTPARM RAW OUTPUT BUFFER


; --- WORK BUFFER               ----------------------------------------

                ; WORKBUF (#C000), WORKBUF2 (#C200), AND PREVBUF (#C400)
                ; RESIDE IN PAGE 3 UNBANKED RAM (DEFINED IN CONST_CORE.Z8A)
                ; WITH WORKSIZ = 512 BYTES (1 LEN + 255 TEXT + 255 ATTR + 1).
                ; THIS FREES 483 BYTES IN PAGE 1 TPA RAM AND ALLOWS LONG LINES
                ; UP TO MAXCOLS (255) COLUMNS WITHOUT OVERFLOWING.

                ; RENDIFF: THE LAST ROW IT PAINTED, AS PAINTED (LENGTH, TEXT AND
                ; SCANNED ATTRIBUTES), WITH ITS SCREEN ROW AND DOCUMENT LINE.
                ; PREVROW 0 MEANS NOTHING CACHED; RENDEROW CLEARS IT.
PREVROW         DEFB    0
PREVLIN         DEFW    0

                ; SCRATCH FOR THE SPLIT / INSERT HELPERS. SPLCOL IS THE COLUMN
                ; SPLITLA CUTS AT; PWCOL / PWTAIL SAY WHERE THE CURSOR LANDED
                ; AFTER A PUSH-WRAP (PWTAIL = FF WHEN IT FOLLOWED THE WORD
                ; DOWN); WBBASE / WBCOL / WBCNT BELONG TO WBINS. NRSEG / NROFF
                ; HOLD THE RECORD EDNWLIN AND EDPSHWR RESERVE UP FRONT, BEFORE
                ; THEY START MUTATING THE DOCUMENT.

SPLCOL          DEFB    0               ; SPLITLA: SPLIT COLUMN
PWCOL           DEFB    0               ; EDPSHWR: INSERT COLUMN AFTER THE SPLIT
PWTAIL          DEFB    0               ; EDPSHWR: FF = CURSOR MOVED TO THE TAIL
WBBASE          DEFW    0               ; WBINS: RECORD BASE ADDRESS
WBCOL           DEFB    0               ; WBINS: INSERT COLUMN
WBCNT           DEFB    0               ; WBINS: BYTES TO SHIFT RIGHT
NRSEG           DEFB    0               ; SEGMENT OF THE RESERVED RECORD
NROFF           DEFW    0               ; OFFSET OF THE RESERVED RECORD
WBSRC           DEFW    0               ; WBINSN: SOURCE OF THE RUN
WBRUN           DEFB    0               ; WBINSN: CHARACTERS IN THE RUN
JOINLA          DEFW    0               ; EDJOIN: TARGET LINE NUMBER (LINE A)
JOINLB          DEFW    0               ; EDJOIN: SOURCE LINE NUMBER (LINE B)
JOINCOL         DEFB    0               ; EDJOIN: JOIN SEAM COLUMN (FORMER LEN OF LINE A)
RFLINE          DEFW    0               ; REFLOW: RECEIVER LINE NUMBER (L)
RFSPACE         DEFB    0               ; REFLOW: AVAILABLE SPACE ON RECEIVER
RFSEP           DEFB    0               ; REFLOW: 1 = SEPARATOR SPACE NEEDED
RFCNT           DEFB    0               ; REFLOW: BYTES TO TRANSFER
STYLMASK        DEFB    0               ; APPLSEL: ATTRIBUTE MASK TO TOGGLE
STYLLN          DEFW    0               ; APPLSEL: CURRENT LINE ITERATOR
STYLXA          DEFB    0               ; APPLSEL: START COLUMN
STYLXB          DEFB    0               ; APPLSEL: END COLUMN
CMPSEG          DEFB    0               ; COMPACTION: SEGMENT NUMBER
CMPEND          DEFW    0               ; COMPACTION: SCAN BOUND
CMPSRC          DEFW    0               ; COMPACTION: SOURCE OFFSET
CMPDST          DEFW    0               ; COMPACTION: DESTINATION OFFSET
CMPRSZ          DEFW    0               ; COMPACTION: RECORD SIZE
FILEBUF         DEFS    256             ; TEMPORARY BUFFER FOR DISK READS



; --- FONT SOURCE               ----------------------------------------

                ; FONTINIT STREAMS THE CHARSET A GLYPH ROW AT A TIME THROUGH
                ; FILEBUF, FROM S6ED.FNT OR FROM THE BIOS ROM, SO NOTHING HERE
                ; STAGES IT. THE 2,048-BYTE FONTRAM THE ROM PATH USED TO NEED
                ; IS GONE WITH IT.

FNTOK           DEFB    0               ; #FF = S6ED.FNT IN USE, 0 = ROM CHARSET
FNTHAND         DEFB    0               ; HANDLE OF S6ED.FNT WHILE IT IS OPEN
FNTROMD         DEFB    0               ; #FF ONCE THE ROM CHARSET IS STAGED
FNTCGA          DEFW    0               ; ROM CHARSET BASE, RESOLVED BY FNTROMI


; --- GENERIC / UTIL            ----------------------------------------

                ; B2D CONVERSION BUFFERS (FROM GENERIC.Z8A)
B2DINV          DEFS    8
B2DBUF          DEFS    20
B2DEND          DEFS    1

                ; FUNCTION KEYS SAVE BUFFER: THE TWO BYTES SETFNKY OVERWRITES PER KEY
FNKBUF          DEFS    20

                ; STATUS BAR TEXT BUFFER, AND THE 80 CELLS AS THEY ARE ON SCREEN
                ; (SPACE PADDED). STATPRV+0 = 0 MEANS THE BAR WAS NEVER PAINTED.
                ; STATBUF NEEDS TEXTCOLS + 1: BLDSTAT WRITES ITS NUL TERMINATOR
                ; AT STATBUF + TEXTCOLS, AND WITH EXACTLY TEXTCOLS BYTES THAT
                ; NUL LANDS ON STATPRV+0 -- SO EVERY DRWSTAT SAW "NEVER
                ; PAINTED", TOOK THE FULL-REPAINT PATH (HMMV + 80 BLITS,
                ; ~45 MS PER KEYPRESS) AND THE CELL DIFF NEVER RAN.
STATBUF         DEFS    TEXTCOLS + 1
STATPRV         DEFS    80
STATMSG         DEFS    44, 0           ; EPHEMERAL STATUS MESSAGE (ASCIIZ)

                ; RENDEROW: END COLUMN (EXCLUSIVE) OF THE BLANK RUN BEING FILLED
RUNEND          DEFS    1


; --- WINDOW SYSTEM             ----------------------------------------


WINX            DEFW    0               ; WINDOW X IN PIXELS
WINY            DEFW    0               ; WINDOW Y IN PIXELS
WINW            DEFW    0               ; WINDOW WIDTH IN PIXELS
WINH            DEFW    0               ; WINDOW HEIGHT IN PIXELS
WINCLIPX        DEFW    0               ; WINSTR: GLYPHS MUST END AT/BEFORE THIS
                                        ;   DX (WINX+WINW-1, SET BY WINOPEN);
                                        ;   0 = NO CLIPPING
WINACTV         DEFB    0               ; 1 = MODAL WINDOW ACTIVE, 0 = INACTIVE

                ; DROP SHADOW, SET BY THE CFG KEY SHADOW=. BOTH DEFAULT TO
                ; ZERO, WHICH INIT ALREADY WRITES AND WHICH MEANS "AS BEFORE":
                ; ON S2ED THE THEME'S VCOLSHDW, ON S6ED CLR_BG.
                IFDEF   S2ED
SHDWOFF         DEFB    0               ; NON-ZERO: NO DROP SHADOW AT ALL
                ELSE
SHDWCLR         DEFB    0               ; PACKED FILL BYTE FOR THE SHADOW BARS
                ENDIF
WINVAR          DEFB    0               ; WINSTR: FONT VARIANT TEMP
WINOP           DEFB    0               ; WINSTR: VDP LOGOP TEMP
WINBST          DEFB    0               ; WINBTS: BUTTON STYLE (0=NORMAL, 1=SELECTED)
WINSEL          DEFB    0               ; MODAL DIALOG: SELECTED OPTION INDEX
WINRES          DEFB    0               ; MODAL DIALOG RESULT (0=CANCEL, 1=CONFIRM)
MNUID           DEFB    0               ; ACTIVE MENU ID (0=FILE, 1=EDIT, 2=VIEW, 3=OPT, 4=HELP)
MNUSEL          DEFB    0               ; ACTIVE MENU ITEM INDEX
MNUTMPY         DEFB    0               ; MENU TEMP REL Y
MNUTMPP         DEFW    0               ; MENU TEMP STRING POINTER
MNUITMC         DEFB    0               ; ACTIVE MENU ITEM COUNT
MNUPTY          DEFW    0               ; ACTIVE MENU YTBL POINTER
MNUPTS          DEFW    0               ; ACTIVE MENU STBL POINTER

                ; S2ED WINDOW GEOMETRY, IN CELL UNITS (32 CELLS X 24 ROWS).
                ; S6ED USES THE PIXEL VARIABLES ABOVE INSTEAD. S2ED ONLY:
                ; DECLARING THEM FOR BOTH WOULD SHIFT UNDOBAS AND BREAK THE
                ; S6ED.COM BYTE-IDENTITY GUARD.
                IFDEF   S2ED
WINR            DEFB    0               ; WINDOW TOP ROW (0..23)
WINC            DEFB    0               ; WINDOW LEFT CELL (0..31)
WINNR           DEFB    0               ; WINDOW HEIGHT IN ROWS
WINNC           DEFB    0               ; WINDOW WIDTH IN CELLS
WINCLIM         DEFB    0               ; WINPUTS: RIGHT TEXT CLIP, EXCLUSIVE
                                        ;   CHAR COLUMN (SET BY WINOPEN, 0=64)
                ENDIF


; --- UNDO STATE                ----------------------------------------


UNDOPTR         DEFW    0               ; POINTER TO MOST RECENT UNDO TRANSACTION (0 = NONE)
UNDOBOT         DEFW    0               ; POINTER TO OLDEST TRANSACTION (CIRCULAR TAIL)
UNDONXT         DEFW    0               ; POINTER WHERE NEXT TRANSACTION WILL BE WRITTEN
REDOPTR         DEFW    0               ; POINTER TO REDO TRANSACTION (0 = NONE)
UNDOTYP         DEFB    0               ; 1 = COALESCING TEXT INPUT IN PROGRESS
UNDOLIN         DEFW    0               ; DOCLINE OF ACTIVE COALESCED TRANSACTION
UNDOHLD         DEFB    0               ; NON-ZERO: SUPPRESS UNDO RECORDING (REDO ACTIVE)


; --- VDP COMMAND BLOCK          ----------------------------------------

                ; STANDARD 15-BYTE BLOCK FOR R#32 TO R#46

VDPCMBLK      DEFS    15
VDP_SX          EQU     VDPCMBLK + 0  ; WORD
VDP_SY          EQU     VDPCMBLK + 2  ; WORD
VDP_DX          EQU     VDPCMBLK + 4  ; WORD
VDP_DY          EQU     VDPCMBLK + 6  ; WORD
VDP_NX          EQU     VDPCMBLK + 8  ; WORD
VDP_NY          EQU     VDPCMBLK + 10 ; WORD
VDP_CLR         EQU     VDPCMBLK + 12 ; BYTE
VDP_ARG         EQU     VDPCMBLK + 13 ; BYTE
VDP_CMD         EQU     VDPCMBLK + 14 ; BYTE

; --- S2ED THEME COLORS         ----------------------------------------
;
; TMS9918 COLOR TABLE BYTES (FG << 4 | BG). INIT ZEROES THEM;
; THMLOAD FILLS THE DEFAULT THEME BEFORE CFGRUN. S2ED ONLY: S6ED
; REPROGRAMS THE V9938 PALETTE INSTEAD, AND DECLARING THESE THERE
; WOULD SHIFT UNDOBAS AND BREAK THE S6ED.COM BYTE-IDENTITY GUARD.
                ; ONE CONTIGUOUS BLOCK: A THEME IS AN LDIR OF VCOLNUM BYTES
                ; FROM A TABLE IN S2/VDP.Z8A, AND THE TEST HARNESS READS THE
                ; WHOLE SPAN FROM VCOLTXT. THE TABLES ARE IN THIS ORDER --
                ; APPEND, NEVER INSERT.
                ;
                ; A ROLE WITHOUT A READER IS NOT A FEATURE: VCOLMARK SPENT
                ; TWO SPRINTS BEING LOADED FROM EVERY THEME AND READ BY
                ; NOBODY. VCOLUNDR IS THE SAME AND IS KEPT DELIBERATELY --
                ; COMCELL READS IT, NOTHING STAMPS ATRUNDR YET.
                IFDEF   S2ED
VCOLTXT         DEFB    0               ; DOCUMENT: NORMAL TEXT (FG|BG)
VCOLUI          DEFB    0               ; CHROME: MENU BAR (ROW 0)
VCOLBOLD        DEFB    0               ; DOCUMENT: BOLD TEXT
VCOLITAL        DEFB    0               ; DOCUMENT: ITALIC TEXT
VCOLUNDR        DEFB    0               ; DOCUMENT: CODE / UNDERLINE (RESERVED)
VCOLMARK        DEFB    0               ; DOCUMENT: MARKUP DELIMITERS (RESERVED)
VCOLBG          DEFB    0               ; GLOBAL: BORDER (TMS9918 INDEX, NOT FG|BG)
VCOLSTAT        DEFB    0               ; CHROME: STATUS BAR (ROW 23)
VCOLWIN         DEFB    0               ; CHROME: WINDOW BODY
VCOLHI          DEFB    0               ; CHROME: ACCENT -- TITLE BAR, BUTTONS
VCOLBSEL        DEFB    0               ; CHROME: FOCUSED BUTTON / SELECTED ITEM
VCOLSHDW        DEFB    0               ; CHROME: WINDOW DROP SHADOW
                ENDIF

ENDVARS


; --- TPA ALLOCATIONS           ----------------------------------------
;
; EVERYTHING BELOW ENDVARS IS PLAIN TPA RAM: NOT EMITTED INTO THE .COM,
; NOT ZEROED BY INIT, AND NOT PART OF ANY MAPPER SEGMENT. THE BLOCK IS A
; CHAIN -- EACH BUFFER STARTS WHERE THE PREVIOUS ONE ENDS -- SO A NEW
; ALLOCATION NEVER NEEDS A FIXED ADDRESS AND CANNOT LAND ON TOP OF ONE
; THAT ONLY THE OTHER TARGET DECLARES. THIS IS THE LESSON THE FEATURE
; CONTAINER TAUGHT: THERE, TARGET-SPECIFIC CODE AT A FIXED ADDRESS LOOKS
; LIKE FREE SPACE TO THE TARGET THAT DOES NOT DECLARE IT. ADD A BUFFER BY
; EXTENDING THE CHAIN, NEVER BY NAMING AN ADDRESS.
;
; PAGE 1 IS SAFE FOR DATA: THE DISK ROM BANKS OVER IT DURING DISK CODE AND
; DOS 2 BANKS OUR RAM BACK BEFORE RETURNING. WHAT IS NOT SAFE IS AN
; INTERRUPT HOOK POINTING HERE -- A HOOK MUST SIT IN PAGE 3 OR BE ENTERED
; INTER-SLOT THROUGH RST #30. SEE THE H.TIMI ENTRY IN CLAUDE.MD.

UNDOBAS         EQU     ENDVARS         ; DYNAMIC BASE OF UNDO RING BUFFER IN TPA
UNDOTOP         EQU     UNDOBAS + UNDOSIZ

                IFDEF   S2ED
                ; 4X8 FONTS (HIGH AND LOW NIBBLE) IN TPA RAM.
                ; FONT4H AND FONT4L SIT IN TPA RAM, CHAINED OFF UNDOTOP.
                ; WSVBUF LIVES IN PAGE 3 (#C000) SO IT DOES NOT COMPETE FOR
                ; PAGE 1 TPA RAM.
FONT4H          EQU     ((UNDOTOP + 255) / 256) * 256 ; 256-BYTE ALIGNED PAGE
FONT4L          EQU     FONT4H + FNTLEN              ; 256-BYTE ALIGNED (2048 B LATER)
TPATOP          EQU     FONT4L + FNTLEN
                ASSERT  LOW(FONT4H) == 0, "FONT4H MUST BE 256-BYTE ALIGNED"
                ASSERT  LOW(FONT4L) == 0, "FONT4L MUST BE 256-BYTE ALIGNED"
                ELSE
TPATOP          EQU     UNDOTOP
                ENDIF

TPAFREE         EQU     TXPAGE - TPATOP ; TPA BYTES LEFT BELOW PAGE 2
                ASSERT  TPATOP <= TXPAGE, "TPA ALLOCATIONS OVERFLOW PAGE 2"


                ; NOTHING MAY BE DECLARED BELOW THIS POINT. THE BUILD EXPECTS
                ; ENDVARS TO CLOSE THE VARIABLE BLOCK, AND INIT ZEROES EXACTLY
                ; VARS .. ENDVARS -- A VARIABLE HERE WOULD SIT OUTSIDE THAT
                ; ZEROING AND START AS GARBAGE FROM THE PREVIOUS PROGRAM.
