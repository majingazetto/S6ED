;                                       ****************************************
;                                       * SCROLL ENGINE                        *
;                                       ****************************************


; --- SCROLLDN                  ----------------------------------------


; - SCROLLDN ---------------------------
; - SCROLL TEXT AREA UP (SHOW NEXT LINE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SCROLLDN        ; MOVE 504X184 PX AREA (ROWS 2..24 -> ROWS 1..23)
                ; THE RECTANGLE STARTS AT X 0, SO THE LINE NUMBERS TRAVEL WITH
                ; THE TEXT AND ONLY ROW 24 NEEDS A NUMBER DRAWN.
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_DX), HL
                LD      HL, TXORG_Y + CELLH   ; ROW 2 (SOURCE AT 16PX)
                LD      (VDP_SY), HL
                LD      HL, TXORG_Y           ; ROW 1 (TARGET AT 8PX)
                LD      (VDP_DY), HL

                LD      HL, SCRLWPX     ; 504
                LD      (VDP_NX), HL
                LD      HL, 184         ; 23 ROWS * 8PX = 184PX
                LD      (VDP_NY), HL

                XOR     A               ; ARG = 0 (TOP-TO-BOTTOM)
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMM

                ; RENDER NEW BOTTOM ROW 24 AND ITS LINE NUMBER
                LD      B, TXRLAST      ; ROW 24
                CALL    RENDEROW
                LD      B, TXRLAST
                CALL    DRWLN1

                JP      DRWSCRL         ; TAIL CALL: REPAINTS ONLY IF IT MOVED


; --- SCROLLUP                  ----------------------------------------


; - SCROLLUP ---------------------------
; - SCROLL TEXT AREA DOWN (PREV LINE)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

SCROLLUP        ; MOVE 504X184 PX AREA (ROWS 1..23 -> ROWS 2..24)
                ; AS DY > SY, USE DIY=1 (ARG=#08) WITH BOTTOM SCANLINE ANCHORS.
                ; X 0 FOR THE SAME REASON AS SCROLLDN: THE NUMBERS TRAVEL TOO.
                LD      HL, 0
                LD      (VDP_SX), HL
                LD      (VDP_DX), HL
                LD      HL, TXORG_Y + 184 - 1 ; 8 + 183 = 191 (BOTTOM OF ROWS 1..23)
                LD      (VDP_SY), HL
                LD      HL, TXORG_Y + 8 + 184 - 1 ; 16 + 183 = 199 (BOTTOM OF ROWS 2..24)
                LD      (VDP_DY), HL

                LD      HL, SCRLWPX     ; 504
                LD      (VDP_NX), HL
                LD      HL, 184         ; 23 ROWS * 8PX = 184PX
                LD      (VDP_NY), HL

                LD      A, VDP_DIY      ; #08 (BOTTOM-TO-TOP)
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                CALL    HMMM

                ; RENDER NEW TOP ROW 1 AND ITS LINE NUMBER
                LD      B, TXRFIRST     ; ROW 1
                CALL    RENDEROW
                LD      B, TXRFIRST
                CALL    DRWLN1

                JP      DRWSCRL         ; TAIL CALL: REPAINTS ONLY IF IT MOVED


; --- SHIFTDN                   ----------------------------------------


; - SHIFTDN ----------------------------
; - SHIFT SCREEN ROWS BELOW ROW B DOWN ONE ROW
; - THE ONE-ROW ENTRY POINT OF SHIFTDNN, WHICH FOLLOWS IT.
; - IN:  B = SCREEN ROW OF NEW LINE (1..23)
; - OUT: NONE
; - CLOBBERS: ALL
; -

SHIFTDN         LD      C, 1            ; ONE ROW: FALL INTO THE GENERAL CASE


; - SHIFTDNN ---------------------------
; - SHIFT SCREEN ROWS BELOW ROW B DOWN BY C ROWS
; - ROWS B..(24-C) MOVE TO (B+C)..24, IN ONE HMMM. INSERTING SEVERAL LINES
; - AT ONCE COSTS THE SAME SINGLE BLIT AS INSERTING ONE.
; - IN:  B = FIRST ROW THAT MOVES (1..24), C = ROWS TO SHIFT BY (1..23)
; - OUT: NONE
; - CLOBBERS: ALL
; -

SHIFTDNN        ; NUMBER OF ROWS TO MOVE = 25 - C - B
                LD      A, 25
                SUB     C
                SUB     B
                RET     Z               ; NO ROWS BELOW TO SHIFT
                RET     C

                ; NY = ROWS * 8 PIXELS
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; * 8
                LD      L, A
                LD      H, 0
                LD      (VDP_NY), HL

                LD      HL, TXORG_X     ; 24
                LD      (VDP_SX), HL
                LD      (VDP_DX), HL

                ; SY = BOTTOM OF ROW 24 - C, DY = BOTTOM OF ROW 24
                LD      A, 25
                SUB     C
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; (25 - C) * 8
                DEC     A
                LD      L, A
                LD      H, 0
                LD      (VDP_SY), HL
                LD      HL, 199         ; BOTTOM OF ROW 24
                LD      (VDP_DY), HL

                LD      HL, TXAREAPX    ; 480
                LD      (VDP_NX), HL

                LD      A, VDP_DIY      ; #08 (BOTTOM-TO-TOP)
                LD      (VDP_ARG), A
                LD      HL, VDPCMBLK
                JP      HMMM

