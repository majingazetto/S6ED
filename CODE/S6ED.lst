 49+  0737              ; - CALCVRAM ---------------------------
 50+  0737              ; - CALC VRAM ADDRESS FOR CHAR C, LINE B
 51+  0737              ; - IN:  A = CHAR (0..255), B = LINE (0..7)
 52+  0737              ; - OUT: HL = VRAM BYTE ADDRESS (#7000..#8FFF)
 53+  0737              ; - CLOBBERS: AF
