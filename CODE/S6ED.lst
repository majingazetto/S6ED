205+  0521 09           .LOOP           ADD     HL,BC
206+  0522 EB                           EX      DE,HL
207+  0523 01 00 00                     LD      BC,0
208+  0526 ED 4A                        ADC     HL,BC
209+  0528 EB                           EX      DE,HL
210+  0529 D9                           EXX
211+  052A 23                           INC     HL
212+  052B 7E                           LD      A,(HL)
213+  052C A7                           AND     A
214+  052D 28 31                        JR      Z,.END
215+  052F FE 20                        CP      ' '
216+  0531 28 2D                        JR      Z,.END
217+  0533 D9                           EXX
218+  0534 D6 30                        SUB     '0'
