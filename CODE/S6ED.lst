 72+  047D
 73+  047D              ; --- STRING                           ----------------------------------------
 74+  047D
 75+  047D
 76+  047D              ; COMBINED ROUTINE FOR CONVERSION OF DIFFERENT SIZED BINARY NUMBERS INTO
 77+  047D              ; DIRECTLY PRINTABLE ASCII(Z)-STRING
 78+  047D              ; INPUT VALUE IN REGISTERS, NUMBER SIZE AND -RELATED TO THAT- REGISTERS TO FILL
 79+  047D              ; IS SELECTED BY CALLING THE CORRECT ENTRY:
 80+  047D              ;
 81+  047D              ;  ENTRY  INPUTREGISTER(S)  DECIMAL VALUE 0 TO:
 82+  047D              ;   B2D8             A                    255  (3 DIGITS)
 83+  047D              ;   B2D16           HL                  65535   5   "
 84+  047D              ;   B2D24         E:HL               16777215   8   "
 85+  047D              ;   B2D32        DE:HL             4294967295  10   "
 86+  047D              ;   B2D48     BC:DE:HL        281474976710655  15   "
 87+  047D              ;   B2D64  IX:BC:DE:HL   18446744073709551615  20   "
 88+  047D              ;
 89+  047D              ; THE RESULTING STRING IS PLACED INTO A SMALL BUFFER ATTACHED TO THIS ROUTINE,
 90+  047D              ; THIS BUFFER NEEDS NO INITIALIZATION AND CAN BE MODIFIED AS DESIRED.
 91+  047D              ; THE NUMBER IS ALIGNED TO THE RIGHT, AND LEADING 0'S ARE REPLACED WITH SPACES.
 92+  047D              ; ON EXIT HL POINTS TO THE FIRST DIGIT, (B)C = NUMBER OF DECIMALS
 93+  047D              ; THIS WAY ANY RE-ALIGNMENT / POSTPROCESSING IS MADE EASY.
 94+  047D              ; CHANGES: AF,BC,DE,HL,IX
 95+  047D              ; P.S. SOME EXAMPLES BELOW
 96+  047D
 97+  047D              ; BY ALWIN HENSELER
 98+  047D
 99+  047D
100+  047D 26 00        B2D8            LD      H,0
101+  047F 6F                           LD      L,A
102+  0480 1E 00        B2D16           LD      E,0
103+  0482 16 00        B2D24           LD      D,0
104+  0484 01 00 00     B2D32           LD      BC,0
105+  0487 DD 21 00 00  B2D48           LD      IX,0            ; ZERO ALL NON-USED BITS
106+  048B 22 44 1E     B2D64           LD      (B2DINV),HL
107+  048E ED 53 46 1E                  LD      (B2DINV + 2),DE
108+  0492 ED 43 48 1E                  LD      (B2DINV + 4),BC
109+  0496 DD 22 4A 1E                  LD      (B2DINV + 6),IX ; PLACE FULL 64-BIT INPUT VALUE IN BUFFER
110+  049A 21 4C 1E                     LD      HL,B2DBUF
111+  049D 11 4D 1E                     LD      DE,B2DBUF + 1
112+  04A0 36 20                        LD      (HL)," "
113+  04A2              B2DFILC         EQU     $ - 1           ; ADDRESS OF FILL-CHARACTER
114+  04A2 01 12 00                     LD      BC,18
115+  04A5 ED B0                        LDIR                    ; FILL 1ST 19 BYTES OF BUFFER WITH SPACES
116+  04A7 ED 43 5F 1E                  LD      (B2DEND-1),BC   ; SET BCD VALUE TO "0" & PLACE TERMINATING 0
117+  04AB 1E 01                        LD      E,1             ; NO. OF BYTES IN BCD VALUE
118+  04AD 21 4C 1E                     LD      HL,B2DINV + 8   ; (ADDRESS MSB INPUT)+1
119+  04B0 01 09 09                     LD      BC,#0909
120+  04B3 AF                           XOR     A
121+  04B4 05           B2DSKP0         DEC     B
122+  04B5 28 29                        JR      Z,B2DSIZ        ; ALL 0: CONTINUE WITH POSTPROCESSING
123+  04B7 2B                           DEC     HL
124+  04B8 B6                           OR      (HL)            ; FIND FIRST BYTE <>0
125+  04B9 28 F9                        JR      Z,B2DSKP0
126+  04BB 0D           B2DFND1         DEC     C
127+  04BC 17                           RLA
128+  04BD 30 FC                        JR      NC,B2DFND1      ; DETERMINE NO. OF MOST SIGNIFICANT 1-BIT
129+  04BF 1F                           RRA
130+  04C0 57                           LD      D,A             ; BYTE FROM BINARY INPUT VALUE
131+  04C1 E5           B2DLUS2         PUSH    HL
132+  04C2 C5                           PUSH    BC
133+  04C3 21 5F 1E     B2DLUS1         LD      HL,B2DEND - 1   ; ADDRESS LSB OF BCD VALUE
134+  04C6 43                           LD      B,E             ; CURRENT LENGTH OF BCD VALUE IN BYTES
135+  04C7 CB 12                        RL      D               ; HIGHEST BIT FROM INPUT VALUE -> CARRY
136+  04C9 7E           B2DLUS0         LD      A,(HL)
137+  04CA 8F                           ADC     A,A
138+  04CB 27                           DAA
139+  04CC 77                           LD      (HL),A          ; DOUBLE 1 BCD BYTE FROM INTERMEDIATE RESULT
140+  04CD 2B                           DEC     HL
141+  04CE 10 F9                        DJNZ    B2DLUS0         ; AND GO ON TO DOUBLE ENTIRE BCD VALUE (+CARRY!)
142+  04D0 30 03                        JR      NC,B2DNXT
143+  04D2 1C                           INC     E               ; CARRY AT MSB -> BCD VALUE GREW 1 BYTE LARGER
144+  04D3 36 01                        LD      (HL),1          ; INITIALIZE NEW MSB OF BCD VALUE
145+  04D5 0D           B2DNXT          DEC     C
146+  04D6 20 EB                        JR      NZ,B2DLUS1      ; REPEAT FOR REMAINING BITS FROM 1 INPUT BYTE
147+  04D8 C1                           POP     BC              ; NO. OF REMAINING BYTES IN INPUT VALUE
148+  04D9 0E 08                        LD      C,8             ; RESET BIT-COUNTER
149+  04DB E1                           POP     HL              ; POINTER TO BYTE FROM INPUT VALUE
150+  04DC 2B                           DEC     HL
151+  04DD 56                           LD      D,(HL)          ; GET NEXT GROUP OF 8 BITS
152+  04DE 10 E1                        DJNZ    B2DLUS2         ; AND REPEAT UNTIL LAST BYTE FROM INPUT VALUE
153+  04E0 21 60 1E     B2DSIZ          LD      HL,B2DEND       ; ADDRESS OF TERMINATING 0
154+  04E3 4B                           LD      C,E             ; SIZE OF BCD VALUE IN BYTES
155+  04E4 B7                           OR      A
156+  04E5 ED 42                        SBC     HL,BC           ; CALCULATE ADDRESS OF MSB BCD
157+  04E7 54                           LD      D,H
158+  04E8 5D                           LD      E,L
159+  04E9 ED 42                        SBC     HL,BC
160+  04EB EB                           EX      DE,HL           ; HL=ADDRESS BCD VALUE, DE=START OF DECIMAL VALUE
161+  04EC 41                           LD      B,C             ; NO. OF BYTES BCD
162+  04ED CB 21                        SLA     C               ; NO. OF BYTES DECIMAL (POSSIBLY 1 TOO HIGH)
163+  04EF 3E 30                        LD      A,'0'
164+  04F1 ED 6F                        RLD                     ; SHIFT BITS 4-7 OF (HL) INTO BIT 0-3 OF A
165+  04F3 FE 30                        CP      '0'             ; (HL) WAS > #9?
166+  04F5 20 06                        JR      NZ,B2DEXPH      ; IF YES, START WITH RECORDING HIGH DIGIT
167+  04F7 0D                           DEC     C               ; CORRECT NUMBER OF DECIMALS
168+  04F8 13                           INC     DE              ; CORRECT START ADDRESS
169+  04F9 18 04                        JR      B2DEXPL         ; CONTINUE WITH CONVERTING LOW DIGIT
170+  04FB ED 6F        B2DEXP          RLD                     ; SHIFT HIGH DIGIT (HL) INTO LOW DIGIT OF A
171+  04FD 12           B2DEXPH         LD      (DE),A          ; RECORD RESULTING ASCII-CODE
172+  04FE 13                           INC     DE
173+  04FF ED 6F        B2DEXPL         RLD
174+  0501 12                           LD      (DE),A
175+  0502 13                           INC     DE
176+  0503 23                           INC     HL              ; NEXT BCD-BYTE
177+  0504 10 F5                        DJNZ    B2DEXP          ; AND GO ON TO CONVERT #EAC BCD-BYTE INTO 2 ASCII
178+  0506 ED 42                        SBC     HL,BC           ; RETURN WITH HL POINTING TO 1ST DECIMAL
179+  0508 C9                           RET
180+  0509
181+  0509
182+  0509              ; - STR2INTZ ---------
