 14+  0000              ; --- SCREEN LAYOUT             ----------------------------------------
 15+  0000
 16+  0000
 17+  0000                              ; CHARACTER GRID
 18+  0000              SCRCOLS         EQU     80              ; TEXT AREA COLUMNS
 19+  0000              SCRROWS         EQU     24              ; TEXT AREA ROWS (ROWS 1-24)
 20+  0000              CELLW           EQU     6               ; CELL WIDTH IN PIXELS
 21+  0000              CELLH           EQU     8               ; CELL HEIGHT IN PIXELS
 22+  0000
 23+  0000                              ; PIXEL LAYOUT
 24+  0000              GUTL_PX         EQU     24              ; LEFT GUTTER WIDTH (4 CHARS × 6PX)
 25+  0000              GUTR_PX         EQU     8               ; RIGHT GUTTER WIDTH (SCROLLBAR)
 26+  0000              TXAREAPX       EQU     480             ; TEXT AREA WIDTH (80 × 6PX)
 27+  0000              TXORG_X         EQU     GUTL_PX         ; TEXT AREA X ORIGIN
 28+  0000              TXORG_Y         EQU     CELLH           ; TEXT AREA Y ORIGIN (SKIP MENU ROW 0)
 29+  0000              SCRTOTY      EQU     212             ; TOTAL SCREEN HEIGHT IN PIXELS
 30+  0000
 31+  0000                              ; ROWS (IN CHARACTER UNITS)
 32+  0000              MNUROW          EQU     0               ; MENU BAR ROW
 33+  0000              TXRFIRST    EQU     1               ; FIRST TEXT ROW
 34+  0000              TXRLAST     EQU     24              ; LAST TEXT ROW
 35+  0000              STBROW          EQU     25              ; STATUS BAR ROW
 36+  0000
 37+  0000
 38+  0000              ; --- VRAM MAP                  ----------------------------------------
 39+  0000
 40+  0000
 41+  0000              VR_DISP         EQU     #00000          ; DISPLAY BITMAP (128 B/LINE × 212 LINES)
 42+  0000              VR_SAT          EQU     #06A00          ; SPRITE ATTRIBUTE TABLE
 43+  0000              VR_SGT          EQU     #06C00          ; SPRITE GENERATOR TABLE
 44+  0000
 45+  0000              VR_FNORM        EQU     #07000          ; FONT: NORMAL        (256 × 16 BYTES)
 46+  0000              VR_FBOLD        EQU     #08000          ; FONT: BOLD
 47+  0000              VR_FITAL        EQU     #09000          ; FONT: ITALIC
 48+  0000              VR_FBI          EQU     #0A000          ; FONT: BOLD+ITALIC
 49+  0000
 50+  0000                              ; FONT TABLE GEOMETRY (ALL TABLES IDENTICAL STRUCTURE)
 51+  0000                              ;   32 GLYPHS PER ROW → 8 ROWS (256 TOTAL)
 52+  0000                              ;   GLYPH N: SX = (N % 32) * 6,  SY = TABLE_SY + (N / 32) * 8
 53+  0000                              ;   TABLE_SY = (VR_FXXX - VR_DISP) / 128
 54+  0000              FNORM_SY        EQU     (VR_FNORM - VR_DISP) / 128     ; = 56
 55+  0000              FBOLD_SY        EQU     (VR_FBOLD - VR_DISP) / 128     ; = 64
 56+  0000              FITAL_SY        EQU     (VR_FITAL - VR_DISP) / 128     ; = 72
 57+  0000              FBI_SY          EQU     (VR_FBI   - VR_DISP) / 128     ; = 80
 58+  0000
 59+  0000
 60+  0000              ; --- PALETTE                   ----------------------------------------
 61+  0000
 62+  0000
 63+  0000                              ; COLOR INDICES (SCREEN 6, 4 COLORS)
 64+  0000              COL_BG          EQU     0               ; BACKGROUND
 65+  0000              COL_FG          EQU     1               ; NORMAL TEXT / FOREGROUND
 66+  0000              COL_UI          EQU     2               ; UI CHROME (GUTTERS, MENU, STATUS)
 67+  0000              COL_HI          EQU     3               ; CURSOR / HIGHLIGHT / ACCENT
 68+  0000
 69+  0000                              ; BYTE PATTERNS (SCREEN 6, 4 PIXELS PER BYTE FOR HMMV)
 70+  0000              CLR_BG          EQU     #00             ; 4 PIXELS OF COLOR 0 (%00000000)
 71+  0000              CLR_FG          EQU     #55             ; 4 PIXELS OF COLOR 1 (%01010101)
 72+  0000              CLR_UI          EQU     #AA             ; 4 PIXELS OF COLOR 2 (%10101010)
 73+  0000              CLR_HI          EQU     #FF             ; 4 PIXELS OF COLOR 3 (%11111111)
 74+  0000
 75+  0000
