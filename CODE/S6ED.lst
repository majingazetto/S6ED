130+  0000                              ; CMR (R#46) COMMAND CODES
131+  0000              VDP_HMMC        EQU     #F0             ; CPU → VRAM (BYTE-TRANSFER)
132+  0000              VDP_YMMM        EQU     #E0             ; VRAM → VRAM (Y ONLY, SAME X)
133+  0000              VDP_HMMM        EQU     #D0             ; VRAM → VRAM (BYTE-TRANSFER)
134+  0000              VDP_HMMV        EQU     #C0             ; FILL BYTES
135+  0000              VDP_LMMC        EQU     #B0             ; CPU → VRAM (DOT-TRANSFER)
