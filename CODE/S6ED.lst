 81+  0000              ATRITAL       EQU     #02             ; BIT 1
 82+  0000              ATRUNDR       EQU     #04             ; BIT 2
 83+  0000              ATRINV        EQU     #08             ; BIT 3  (INVERSE VIDEO)
 84+  0000              ATRFMSK   EQU     #03             ; BITS 0-1 → FONT VARIANT INDEX
 85+  0000
 86+  0000
