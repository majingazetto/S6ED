  5+  070E              ; BUNDLED 6X8 CHARSET (256 GLYPHS X 8 BYTES, 1BPP).
  6+  070E              ; EXPANDS INTO VRAM FONT TABLE AT VR_FNORM (FNORM_SY = 224).
  7+  070E              ; GLYPH N: SX = (N & 31) * 8, SY = FNORM_SY + (N >> 5) * 8.
  8+  070E
  9+  070E
 10+  070E              ; --- FONTINIT                  ----------------------------------------
 11+  070E
 12+  070E
 13+  070E              ; - FONTINIT ---------------------------
 14+  070E              ; - EXPAND BUNDLED CHARSET TO VRAM
 15+  070E              ; - IN:  NONE
 16+  070E              ; - OUT: NONE
 17+  070E              ; - CLOBBERS: ALL
 18+  070E              ; -
 19+  070E
 20+  070E 11 7A 07     FONTINIT        LD      DE, FONT_DATA   ; SOURCE 1BPP BYTES
 21+  0711 0E 00                        LD      C, 0            ; CHAR 0..255
 22+  0713 06 00        .CHARLP         LD      B, 0            ; LINE 0..7
 23+  0715 C5           .LINELP         PUSH    BC
 24+  0716 D5                           PUSH    DE
 25+  0717 79                           LD      A, C
 26+  0718 CD 37 07                     CALL    CALCVRAM        ; HL = VRAM ADDRESS
 27+  071B CD 8C 06                     CALL    SETWRT          ; SET VRAM POINTER
 28+  071E D1                           POP     DE
